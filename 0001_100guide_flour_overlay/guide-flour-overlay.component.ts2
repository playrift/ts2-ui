import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { GuideAnim, GuideModel, GuideOverlay, Layout } from './guide-flour-overlay.constants';

const timerHost = createRef('0001_100guide_flour_overlay_timer_host');

const content = createRef('100guide_flour_overlay_content');

export function GuideFlourOverlay(): Component {
  useInterval(() => overlayRelayout(timerHost, content, GuideOverlay.DODGE, Anchor.RIGHT, Anchor.BOTTOM, 0), timerHost);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x="right" y="bottom" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <layer hide x="right" y={{ bottom: Layout.LAYER_BOTTOM }} w={Layout.LAYER_W} h={326}>
            <model
              x={73}
              y={284}
              w={Layout.MODEL_W}
              h={Layout.MODEL_H}
              model={GuideModel.QUESTION}
              anim={GuideAnim.QUESTION}
              zoom={656}
            />
          </layer>

          <layer hide x="right" y={{ bottom: Layout.LAYER_BOTTOM }} w={Layout.LAYER_W} h={338}>
            <model
              x={73}
              y={296}
              w={Layout.MODEL_W}
              h={Layout.MODEL_H}
              model={GuideModel.FLOUR_4}
              anim={GuideAnim.FLOUR}
              pitch={147}
              zoom={656}
            />
          </layer>

          <layer x="right" y={{ bottom: Layout.LAYER_BOTTOM }} w={Layout.LAYER_W} h={329}>
            <model
              x={73}
              y={287}
              w={Layout.MODEL_W}
              h={Layout.MODEL_H}
              model={GuideModel.FLOUR_2}
              anim={GuideAnim.FLOUR}
              pitch={147}
              zoom={656}
            />
          </layer>

          <layer hide x="right" y={{ bottom: Layout.LAYER_BOTTOM }} w={Layout.LAYER_W} h={333}>
            <model
              x={73}
              y={291}
              w={Layout.MODEL_W}
              h={Layout.MODEL_H}
              model={GuideModel.FLOUR_PLAIN}
              pitch={207}
              zoom={528}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
