import { predictServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import {
  Caption,
  Panel,
  TicketArt,
  TicketColors,
  TicketFonts,
  TicketSounds,
  TicketVarbits,
} from './rangingguild-ticketexchange.constants';

export function QuantityButton({
  offset,
  verb,
  quantity,
  caption,
  selected,
}: {
  offset: Int;
  verb: String;
  quantity: Int;
  caption: Int;
  selected: Int;
}): Component {
  return (
    <layer
      x={{ center: offset }}
      y={{ center: Panel.BUTTON_Y }}
      w={Panel.BUTTON}
      h={Panel.BUTTON}
      options={[verb]}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(TicketSounds.SELECT);
        predictServerState(TicketVarbits.QUANTITY, quantity);
      }}
    >
      {selected === quantity ? <ButtonBackgroundPressed /> : <ButtonBackground />}
      {caption === Caption.ICON ? (
        <sprite x="center" y="center" w={32} h={32} sprite={TicketArt.VALUE_ICON} />
      ) : (
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={caption > Caption.ANY ? stringOf(caption) : 'X'}
          font={TicketFonts.BUTTON}
          shadow
          align="center"
          valign="middle"
          color={selected === quantity ? TicketColors.CAPTION_LIT : TicketColors.CAPTION}
          hover={{ color: TicketColors.CAPTION_LIT }}
        />
      )}
    </layer>
  );
}
