import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { Fade, Grid, Quantity, TicketSets } from './rangingguild-ticketexchange.constants';

function verbFor(selected: Int): String {
  if (selected === Quantity.ONE) {
    return 'Buy 1';
  }
  if (selected === Quantity.FIVE) {
    return 'Buy 5';
  }
  if (selected === Quantity.X) {
    return 'Buy X';
  }
  return 'Value';
}

export function TicketSlot({
  ticket,
  index,
  stride,
  selected,
}: {
  ticket: ItemName;
  index: Int;
  stride: Int;
  selected: Int;
}): Component {
  if (ticket === -1) {
    return (
      <sprite
        hide
        x={(index % Grid.COLUMNS) * stride}
        y={(index / Grid.COLUMNS) * stride}
        w={Grid.SLOT_W}
        h={Grid.SLOT_H}
        outline={Grid.OUTLINE}
        shadowColor={Grid.SHADOW}
      />
    );
  }

  const setSize: Int = Math.max(1, TicketSets.get(ticket as Item) ?? 1);

  return (
    <sprite
      x={(index % Grid.COLUMNS) * stride}
      y={(index / Grid.COLUMNS) * stride}
      w={Grid.SLOT_W}
      h={Grid.SLOT_H}
      outline={Grid.OUTLINE}
      shadowColor={Grid.SHADOW}
      item={ticket}
      itemCount={setSize}
      optionSubject={
        setSize > 1
          ? `<col=ff9040>${itemName(ticket as Item)} set</col>`
          : `<col=ff9040>${itemName(ticket as Item)}</col>`
      }
      options={[
        verbFor(selected),
        selected === Quantity.VALUE ? '' : 'Value',
        selected === Quantity.ONE ? '' : 'Buy 1',
        selected === Quantity.FIVE ? '' : 'Buy 5',
        selected === Quantity.X ? '' : 'Buy X',
        '',
        '',
        '',
        '',
        'Examine',
      ]}
      onOptionSelect={(event) => {
        flashFor(event.self, Fade.PRESSED, Fade.REST);
      }}
    />
  );
}
