import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { textLineCount } from '../lib/lib.engine';
import { DeathkeepLeft } from './deathkeep-left.component';
import { DeathkeepRight } from './deathkeep-right.component';
import { DeathkeepColors, DeathkeepFonts, DeathkeepSprites, INFO_TEXT, Layout } from './deathkeep.constants';

export function Deathkeep(): Component {
  const infoLines: Int = textLineCount(
    INFO_TEXT,
    Layout.WIDTH - Layout.CONTENTS_INSET_W - Layout.INFO_TEXT_INSET,
    DeathkeepFonts.INFO,
  );
  let topHeight: Int = 0;
  let paneInset: Int = 0;
  if (INFO_TEXT.length > 0) {
    topHeight = Layout.INFO_PAD + infoLines * Layout.INFO_LINE_H;
    paneInset = topHeight + Layout.INFO_GAP;
  }

  return (
    <>
      <SteelBorderEntrypoint title="Items Kept on Death" />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENTS_BOTTOM }}
        w={{ fill: Layout.CONTENTS_INSET_W }}
        h={{ fill: Layout.CONTENTS_INSET_H }}
      >
        <layer x="center" y={0} w="fill" h={topHeight}>
          {INFO_TEXT.length > 0 && (
            <>
              <sprite
                x="center"
                y="center"
                w={{ fill: 2 }}
                h={{ fill: 2 }}
                sprite={DeathkeepSprites.INFO_BACKING}
                tiling
              />
              <ThinBoxEntrypoint />
              <text
                x="center"
                y="center"
                w={{ fill: Layout.INFO_TEXT_INSET }}
                h="fill"
                text={INFO_TEXT}
                font={DeathkeepFonts.INFO}
                color={DeathkeepColors.LABEL}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}
        </layer>

        <layer x={0} y="bottom" w={{ fill: Layout.LEFT_INSET_W }} h={{ fill: paneInset }}>
          <DeathkeepLeft />
          <ThinBoxEntrypoint />
        </layer>

        <layer x="right" y="bottom" w={Layout.RIGHT_W} h={{ fill: paneInset }}>
          <DeathkeepRight />
        </layer>
      </layer>
    </>
  );
}
