import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { AgilityArenaOverlay, LampColor, Layout, OUTLINE, WASH } from './agilityarena-overlay.constants';
import { agilityArenaOverlay } from './agilityarena-overlay.helpers';

const content = createRef('agilityarena_overlay_content1');

const redLamp = createRef('agilityarena_overlay_red0');

const greenLamp = createRef('agilityarena_overlay_green1');

export function AgilityArenaOverlay_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, AgilityArenaOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect
            ref={redLamp}
            x={{ right: Layout.LAMP_RIGHT }}
            y={Layout.RED_Y}
            w={Layout.LAMP_W}
            h={Layout.LAMP_H}
            color={LampColor.RED_DIM}
            fill
            transparency={WASH}
          />

          <rect
            ref={greenLamp}
            x={{ right: Layout.LAMP_RIGHT }}
            y={Layout.GREEN_Y}
            w={Layout.LAMP_W}
            h={Layout.LAMP_H}
            color={LampColor.GREEN_DIM}
            fill
            transparency={WASH}
          />

          <rect
            x={{ right: Layout.RING_RIGHT }}
            y={Layout.TOP_RING_Y}
            w={Layout.RING_W}
            h={Layout.RING_H}
            color={OUTLINE}
            transparency={WASH}
            onTimer={() => agilityArenaOverlay(redLamp, greenLamp)}
          />

          <rect
            x={{ right: Layout.RING_RIGHT }}
            y={Layout.BOTTOM_RING_Y}
            w={Layout.RING_W}
            h={Layout.RING_H}
            color={OUTLINE}
            transparency={WASH}
          />
        </layer>
      </layer>
    </layer>
  );
}
