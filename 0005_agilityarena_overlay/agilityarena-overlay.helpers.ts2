import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { LampColor } from './agilityarena-overlay.constants';

export function agilityArenaOverlay(red: ComponentId, green: ComponentId): void {
  if (useServerState(Varbits.AGILITYARENA_TAGGEDLASTPILLAR) === 1) {
    red.color = LampColor.RED_DIM;
    green.color = LampColor.GREEN_LIT;
  } else {
    red.color = LampColor.RED_LIT;
    green.color = LampColor.GREEN_DIM;
  }
}
