import { useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { SilverColors, SilverFonts, TitleLayout } from './silver-crafting.constants';

export function JewelleryTitle({ mould, title, hint }: { mould: ItemName; title: String; hint: String }): Component {
  const inv = useInventory(Inventories.INV);
  const missing: Boolean = inv.total(mould as Item) <= 0 ? true : false;

  return (
    <layer w="fill" h="fill">
      {missing ? (
        <>
          <sprite
            x={TitleLayout.ICON_X}
            y="center"
            w={TitleLayout.ICON_W}
            h={TitleLayout.ICON_H}
            outline={1}
            shadowColor={SilverColors.ICON_SHADOW}
            item={mould}
            itemCount={1}
            itemCountMode="never"
          />
          <text
            x="right"
            y={0}
            w={{ fill: TitleLayout.TEXT_INSET }}
            h={TitleLayout.HEADING_H}
            font={SilverFonts.HEADING}
            color={SilverColors.LABEL}
            shadow
            align="left"
            valign="bottom"
            text={title}
          />
          <text
            x="right"
            y="bottom"
            w={{ fill: TitleLayout.TEXT_INSET }}
            h={{ fill: TitleLayout.HEADING_H }}
            font={SilverFonts.CAPTION}
            color={SilverColors.LABEL}
            shadow
            align="left"
            valign="top"
            text={hint}
          />
        </>
      ) : null}
    </layer>
  );
}
