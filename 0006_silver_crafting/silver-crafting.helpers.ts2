import { CS2 } from 'ts2';

import { Fonts } from '../lib/game/fonts';
import { itemName, membersWorld, textLineCount, textWidth } from '../lib/lib.engine';

export function captionFont(label: String, width: Int): Font {
  if (textWidth(label, width, Fonts.P12_FULL) <= width && textLineCount(label, width, Fonts.P12_FULL) <= 1) {
    return Fonts.P12_FULL;
  }
  return Fonts.P11_FULL;
}

export function silverAvailable(gemHeld: Int, crafting: Int, level: Int, product: ItemName): Boolean {
  if (gemHeld > 0 && crafting >= level && (membersWorld() || CS2.item_members(product as Item) === 0)) {
    return true;
  }
  return false;
}

export function jewelleryHint(product: ItemName, level: Int): String {
  if (membersWorld() === false && CS2.item_members(product as Item) === 1) {
    return '';
  }
  return `Level ${stringOf(level)}`;
}

export function miscellaneousHint(product: ItemName, mould: ItemName, level: Int, hasMould: Boolean): String {
  if (membersWorld() === false && CS2.item_members(product as Item) === 1) {
    return '';
  }
  if (hasMould) {
    return `Level ${stringOf(level)}`;
  }
  return itemName(mould as Item);
}
