import { CS2, Engine, useRerenderOn, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { ChannelColor, ChannelFonts, Layout } from './chatchannel-current.constants';
import { CHANNEL_KIND_DEFAULT, ChannelKindNames } from './tables.data';

export function ChannelHeader(): Component {
  useRerenderOn(Engine.CLAN);

  const blocked: Int = useServerState(Varbits.CHATCHANNEL_BLOCKED);
  let members: Int = CS2.friendschat_chat_count_get();
  if (blocked === 1) {
    members = 0;
  }

  let name: String = `<col=808080>${ChannelKindNames.get(0) ?? CHANNEL_KIND_DEFAULT}</col>`;
  let owner: String = '<col=808080>Not in channel</col>';
  if (members > 0) {
    name = CS2.friendschat_chat_display_name_get();
    owner = `<col=ffb83f>${CS2.friendschat_chat_owner_name_get()}</col>`;
  }

  return (
    <>
      <text
        x="center"
        y={0}
        w="fill"
        h={Layout.NAME_H}
        text={name}
        font={ChannelFonts.TITLE}
        color={ChannelColor.CAPTION}
        align="center"
        valign="bottom"
        shadow
      />
      <text
        x={0}
        y={Layout.OWNER_Y}
        w={{ fill: Layout.OWNER_INSET }}
        h={Layout.OWNER_H}
        text={owner}
        font={ChannelFonts.SMALL}
        color={ChannelColor.CAPTION}
        align="center"
        valign="middle"
        shadow
      />
    </>
  );
}
