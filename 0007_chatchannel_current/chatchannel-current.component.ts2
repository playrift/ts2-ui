import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ChannelColor, ChannelSort, Layout } from './chatchannel-current.constants';
import { ChannelButtons } from './channel-buttons.component';
import { ChannelHeader } from './channel-header.component';
import { ChannelPane } from './channel-pane.component';
import { SortButton } from './sort-button.component';

export function ChatchannelCurrent(): Component {
  return (
    <>
      <ChannelHeader />

      <layer x="center" y={Layout.FRAME_Y} w={{ fill: Layout.FRAME_INSET }} h={{ fill: Layout.FRAME_DROP }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.PLATE_INSET }}
          h={{ fill: Layout.PLATE_INSET }}
          fill
          color={ChannelColor.PLATE}
          transparency={Layout.PLATE_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.INNER_INSET }} h={{ fill: Layout.INNER_INSET }}>
          <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
            <layer x={Layout.SORT_RANK_X} y="center" w={Layout.SORT_RANK_W} h={{ fill: Layout.HEADER_DROP }}>
              <SortButton first={ChannelSort.RANK_ASC} second={ChannelSort.RANK_DESC} idle={ChannelSort.RANK_ASC} />
            </layer>
            <layer x={Layout.SORT_NAME_X} y="center" w={Layout.SORT_NAME_W} h={{ fill: Layout.HEADER_DROP }}>
              <SortButton first={ChannelSort.NAME_ASC} second={ChannelSort.NAME_DESC} idle={ChannelSort.NAME_ASC} />
            </layer>
            <layer x={Layout.SORT_RECENT_X} y="center" w={Layout.SORT_RECENT_W} h={{ fill: Layout.HEADER_DROP }}>
              <SortButton
                first={ChannelSort.RECENT_ASC}
                second={ChannelSort.RECENT_DESC}
                idle={ChannelSort.RECENT_DESC}
              />
            </layer>
            <layer
              x={{ right: Layout.SORT_WORLD_RIGHT }}
              y="center"
              w={Layout.SORT_WORLD_W}
              h={{ fill: Layout.HEADER_DROP }}
            >
              <SortButton first={ChannelSort.WORLD_ASC} second={ChannelSort.WORLD_DESC} idle={ChannelSort.WORLD_ASC} />
            </layer>
            <layer
              x={{ right: Layout.SORT_LEGACY_RIGHT }}
              y="center"
              w={Layout.SORT_LEGACY_W}
              h={{ fill: Layout.HEADER_DROP }}
            >
              <SortButton first={ChannelSort.LEGACY} second={ChannelSort.LEGACY_REVERSED} idle={ChannelSort.LEGACY} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>

          <ChannelPane />

          <ThinBoxEntrypoint />
        </layer>

        <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
      </layer>

      <ChannelButtons />

      <layer x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} />
    </>
  );
}
