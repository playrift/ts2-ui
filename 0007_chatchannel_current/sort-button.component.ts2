import { useRef } from 'ts2';

import { ChannelSprites, Layout, SortArrow } from './chatchannel-current.constants';
import { chooseSort, currentSort, sortArrowHover, sortArrowLeave } from './chatchannel-current.state';

export function SortButton({ first, second, idle }: { first: Int; second: Int; idle: Int }): Component {
  const arrow = useRef();
  const sort: Int = currentSort();

  let reversed: Int = 0;
  let owned: Int = 0;
  if (sort === second) {
    reversed = 1;
    owned = 1;
  } else if (sort === first) {
    owned = 1;
  }

  const rest: Int = owned === 1 ? SortArrow.ACTIVE : SortArrow.IDLE;
  const lit: Int = owned === 1 ? SortArrow.ACTIVE_HOVER : SortArrow.IDLE_HOVER;

  let next: Int = idle;
  if (sort === second) {
    next = first;
  } else if (sort === first) {
    next = second;
  }

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => sortArrowHover(arrow, lit)}
      onMouseLeave={() => sortArrowLeave(arrow, rest)}
      onClick={() => chooseSort(next)}
    >
      <sprite
        ref={arrow}
        x="center"
        y="center"
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        sprite={reversed === 1 ? ChannelSprites.SORT_REVERSED : ChannelSprites.SORT_DEFAULT}
        transparency={rest}
      />
    </layer>
  );
}
