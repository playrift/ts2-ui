import {
  Bearings,
  Camera,
  Captions,
  IslandMapArt,
  IslandMapColors,
  IslandMapFonts,
  IslandMapModel,
  Layout,
} from './ahoy-islandmap.constants';

export function AhoyIslandMap(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.BACKING_W} h={Layout.BACKING_H} fill color={IslandMapColors.BACKING} />

      <model
        x={Layout.PAPER_X}
        y={Layout.PAPER_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={IslandMapModel.PAPER}
        zoom={Camera.PAPER.ZOOM}
        pitch={Camera.PAPER.PITCH}
        yaw={Camera.PAPER.YAW}
      />

      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={IslandMapModel.MAP}
        zoom={Camera.MAP.ZOOM}
        pitch={Camera.MAP.PITCH}
        yaw={Camera.MAP.YAW}
      />

      <text
        x={Layout.EAST_8_X}
        y={Layout.EAST_8_Y}
        w={Layout.EAST_8_W}
        h={Layout.BEARING_H}
        text={Bearings.EAST_8}
        font={IslandMapFonts.BEARING}
        color={IslandMapColors.BEARING}
        shadow
      />

      <text
        x={Layout.SOUTH_6_X}
        y={Layout.SOUTH_6_Y}
        w={Layout.SOUTH_6_W}
        h={Layout.BEARING_H}
        text={Bearings.SOUTH_6}
        font={IslandMapFonts.BEARING}
        color={IslandMapColors.BEARING}
        shadow
      />

      <text
        x={Layout.NORTH_2_X}
        y={Layout.NORTH_2_Y}
        w={Layout.NORTH_2_W}
        h={Layout.BEARING_H}
        text={Bearings.NORTH_2}
        font={IslandMapFonts.BEARING}
        color={IslandMapColors.BEARING}
        shadow
        align="center"
      />

      <text
        x={Layout.EAST_4_X}
        y={Layout.EAST_4_Y}
        w={Layout.EAST_4_W}
        h={Layout.BEARING_H}
        text={Bearings.EAST_4}
        font={IslandMapFonts.BEARING}
        color={IslandMapColors.BEARING}
        shadow
      />

      <text
        x={Layout.SOUTH_22_X}
        y={Layout.SOUTH_22_Y}
        w={Layout.SOUTH_22_W}
        h={Layout.BEARING_H}
        text={Bearings.SOUTH_22}
        font={IslandMapFonts.BEARING}
        color={IslandMapColors.BEARING}
        shadow
      />

      <text
        x={Layout.START_X}
        y={Layout.START_Y}
        w={Layout.START_W}
        h={Layout.START_H}
        text={Captions.START}
        font={IslandMapFonts.CAPTION}
        color={IslandMapColors.CAPTION}
        align="center"
      />

      <text
        x={Layout.ISLAND_X}
        y={Layout.ISLAND_Y}
        w={Layout.ISLAND_W}
        h={Layout.ISLAND_H}
        text={Captions.ISLAND}
        font={IslandMapFonts.CAPTION}
        color={IslandMapColors.CAPTION}
        align="center"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={IslandMapArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={IslandMapArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
