import {
  Camera,
  Layout,
  RuneDrawArt,
  RuneDrawColors,
  RuneDrawFonts,
  RuneDrawModel,
  RuneDrawText,
  Slots,
} from './ahoy-runedraw.constants';

export function AhoyRuneDraw(): Component {
  return (
    <>
      <model
        x={Layout.PAPER_X}
        y={Layout.PAPER_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RuneDrawModel.PAPER}
        zoom={Camera.PAPER.ZOOM}
        pitch={Camera.PAPER.PITCH}
        yaw={Camera.PAPER.YAW}
      />

      <model
        x={Layout.BOARD_X}
        y={Layout.BOARD_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RuneDrawModel.BOARD}
        zoom={Camera.BOARD.ZOOM}
        pitch={Camera.BOARD.PITCH}
        yaw={Camera.BOARD.YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={RuneDrawText.TITLE}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.TITLE}
        shadow
        align="center"
      />

      <text
        x={Layout.YOUR_SCORE_X}
        y={Layout.YOUR_SCORE_Y}
        w={Layout.YOUR_SCORE_W}
        h={Layout.YOUR_SCORE_H}
        text={RuneDrawText.YOUR_SCORE}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.LABEL}
        shadow
      />

      <text
        x={Layout.OPPONENT_SCORE_X}
        y={Layout.OPPONENT_SCORE_Y}
        w={Layout.OPPONENT_SCORE_W}
        h={Layout.OPPONENT_SCORE_H}
        text={RuneDrawText.OPPONENT_SCORE}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.LABEL}
        shadow
      />

      {Slots.map((slot) => (
        <model
          x={slot.x}
          y={slot.y}
          w={Layout.SLOT_W}
          h={Layout.SLOT_H}
          model={RuneDrawModel.RUNE}
          zoom={Camera.RUNE.ZOOM}
          pitch={Camera.RUNE.PITCH}
          yaw={Camera.RUNE.YAW}
        />
      ))}

      <text
        x={Layout.DEATH_L_X}
        y={Layout.DEATH_L_Y}
        w={Layout.DEATH_W}
        h={Layout.DEATH_H}
        text={RuneDrawText.DEATH}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.DEATH}
        align="center"
        valign="middle"
      />

      <text
        x={Layout.TOTAL_L_X}
        y={Layout.TOTAL_L_Y}
        w={Layout.TOTAL_W}
        h={Layout.TOTAL_H}
        text={RuneDrawText.PLACEHOLDER}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <text
        x={Layout.DEATH_R_X}
        y={Layout.DEATH_R_Y}
        w={Layout.DEATH_W}
        h={Layout.DEATH_H}
        text={RuneDrawText.DEATH}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.DEATH}
        align="center"
        valign="middle"
      />

      <text
        x={Layout.TOTAL_R_X}
        y={Layout.TOTAL_R_Y}
        w={Layout.TOTAL_W}
        h={Layout.TOTAL_H}
        text={RuneDrawText.PLACEHOLDER}
        font={RuneDrawFonts.LABEL}
        color={RuneDrawColors.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer x={Layout.DRAW_LAYER_X} y={Layout.DRAW_LAYER_Y} w={Layout.DRAW_LAYER_W} h={Layout.DRAW_LAYER_H}>
        <text
          x={0}
          y={0}
          w={Layout.DRAW_LAYER_W}
          h={Layout.DRAW_LAYER_H}
          text={RuneDrawText.DRAW}
          font={RuneDrawFonts.LABEL}
          color={RuneDrawColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <layer x={Layout.HOLD_LAYER_X} y={Layout.HOLD_LAYER_Y} w={Layout.HOLD_LAYER_W} h={Layout.HOLD_LAYER_H}>
        <text
          x={0}
          y={0}
          w={Layout.HOLD_LAYER_W}
          h={Layout.HOLD_LAYER_H}
          text={RuneDrawText.HOLD}
          font={RuneDrawFonts.LABEL}
          color={RuneDrawColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={RuneDrawArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={RuneDrawArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
