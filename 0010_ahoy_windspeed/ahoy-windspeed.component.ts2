import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { AhoyWindspeed, BACKING_WASH, Layout, WindspeedColor, WindspeedFonts } from './ahoy-windspeed.constants';

const content = createRef('ahoy_windspeed_content1');

export function AhoyWindspeed_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, content, AhoyWindspeed.DODGE, Anchor.RIGHT, Anchor.TOP, 0)}
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect
            x={{ right: Layout.BACKING_RIGHT }}
            y={Layout.BACKING_Y}
            w={Layout.BACKING_W}
            h={Layout.BACKING_H}
            color={WindspeedColor.BACKING}
            fill
            transparency={BACKING_WASH}
          />

          <text
            x={{ right: Layout.LABEL_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={WindspeedFonts.LABEL}
            text="Windspeed:"
            align="right"
            shadow
            color={WindspeedColor.LABEL}
          />

          <text
            x={{ right: Layout.VALUE_RIGHT }}
            y={Layout.VALUE_Y}
            w={Layout.VALUE_W}
            h={Layout.VALUE_H}
            font={WindspeedFonts.VALUE}
            text=""
            shadow
            color={WindspeedColor.VALUE}
          />
        </layer>
      </layer>
    </layer>
  );
}
