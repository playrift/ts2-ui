import { Sprites } from '../lib/game/sprites';

export function ButtonFace({ pressed }: { pressed: Boolean }): Component {
  if (pressed) {
    return (
      <layer w="fill" h="fill">
        <sprite x="left" y="top" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NW_RED} />
        <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NC_RED} tiling />
        <sprite x="right" y="top" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NE_RED} />
        <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CW_RED} tiling />
        <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CC_RED} tiling />
        <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CE_RED} tiling />
        <sprite x="left" y="bottom" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SW_RED} />
        <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SC_RED} tiling />
        <sprite x="right" y="bottom" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SE_RED} />
      </layer>
    );
  }
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NW_GREY} />
      <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NC_GREY} tiling />
      <sprite x="right" y="top" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_NE_GREY} />
      <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CW_GREY} tiling />
      <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CC_GREY} tiling />
      <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_CE_GREY} tiling />
      <sprite x="left" y="bottom" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SW_GREY} />
      <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SC_GREY} tiling />
      <sprite x="right" y="bottom" w={6} h={6} sprite={Sprites.MISCGRAPHICS_BUTTONTILE_SE_GREY} />
    </layer>
  );
}
