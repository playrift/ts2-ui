import { useState } from 'ts2';
import { BankBottomBar } from './bankmain-bottom.component';
import { BankItems } from './bankmain-items.component';
import { BankLeftColumn } from './bankmain-left-column.component';
import { BankTabs } from './bankmain-tabs.component';
import { BankView, bankView } from './bankmain.state';

export function BankItemsColumn(): Component {
  const [view] = useState(bankView);

  return (
    <layer x="center" y={{ bottom: 5 }} w={{ fill: 10 }} h={{ fill: 40 }} hide={view === BankView.ITEMS ? false : true}>
      <layer x="center" y={0} w={478} h={40}>
        <BankTabs />
      </layer>

      <BankItems />

      <layer x={{ right: 1 }} y={{ bottom: 39 }} w={{ fill: 53 }} h={{ fill: 81 }} hide noClickThrough>
        <layer x="center" y="center" w="fill" h="fill" />
        <layer x={{ right: 16 }} y="bottom" w={{ fill: 16 }} h="fill" />
        <layer x="right" y="bottom" w={16} h="fill" />
      </layer>

      <BankBottomBar />

      <BankLeftColumn />
    </layer>
  );
}
