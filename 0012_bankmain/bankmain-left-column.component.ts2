import { useRef, useServerState } from 'ts2';
import { setTransparency } from '../lib/lib.components';
import { Bar, BankColors, BankSprites, BankVars } from './bankmain.constants';

export function BankLeftColumn(): Component {
  const showIncinerator: Int = useServerState(BankVars.SHOW_INCINERATOR);
  const incineratorGlyph = useRef();

  return (
    <>
      <line
        x={6}
        y={{ bottom: 42 }}
        w={28}
        color={BankColors.RULE}
        lineWidth={1}
        hide={showIncinerator === 1 ? false : true}
      />

      <layer x={2} y={{ bottom: showIncinerator === 1 ? 82 : 45 }} w={36} h={36} hide />

      <layer x={0} y={{ bottom: showIncinerator === 1 ? 80 : 43 }} w={40} h={104} hide>
        <layer x={0} y="bottom" w="fill" h="fill" />
        <layer x={2} y={{ bottom: 2 }} w={36} h={26} />
        <layer x={2} y={{ bottom: 29 }} w={36} h={36} hide noClickThrough />
        <layer x={2} y={{ bottom: 66 }} w={36} h={36} hide />
      </layer>

      <layer
        x={2}
        y={{ bottom: 45 }}
        w={36}
        h={36}
        hide={showIncinerator === 1 ? false : true}
        dragTarget
        onMouseRepeat={() => setTransparency(incineratorGlyph, Bar.HOVER_TRANSPARENCY)}
        onMouseLeave={() => setTransparency(incineratorGlyph, 0)}
      >
        <sprite x={0} y={0} w={36} h={36} sprite={BankSprites.BUTTON_OFF} />
        <sprite ref={incineratorGlyph} x={4} y={4} w={28} h={28} sprite={BankSprites.INCINERATOR} />
      </layer>

      <layer x="center" y="center" w="fill" h="fill" hide noClickThrough>
        <sprite x="center" y="center" w="fill" h="fill" sprite={BankSprites.BACKING} tiling transparency={100} />
      </layer>
    </>
  );
}
