import { itemName } from '../lib/lib.engine';
import { isPlaceholder } from './bankmain.helpers';
import { BankColors, BankItems, Grid } from './bankmain.constants';

export function BankSlot({
  item,
  count,
  charged,
  x,
  y,
  hidden,
  primary,
  one,
  requested,
  placeholder,
}: {
  item: Item;
  count: Int;
  charged: Boolean;
  x: Int;
  y: Int;
  hidden: Boolean;
  primary: String;
  one: String;
  requested: String;
  placeholder: String;
}): Component {
  if (item === -1) {
    return (
      <sprite
        x={x}
        y={y}
        w={Grid.W}
        h={Grid.H}
        hide={hidden}
        item={BankItems.BLANK}
        itemCount={1}
        outline={1}
        shadowColor={BankColors.SLOT_SHADOW}
        transparency={255}
        dragDeadZone={Grid.DRAG_DEAD}
        dragDeadTime={Grid.DRAG_DEAD}
      />
    );
  }

  if (item === BankItems.FILLER) {
    return (
      <sprite
        x={x}
        y={y}
        w={Grid.W}
        h={Grid.H}
        hide={hidden}
        item={item}
        itemCount={-1}
        outline={1}
        shadowColor={BankColors.SLOT_SHADOW}
        transparency={0}
        dragDeadZone={Grid.DRAG_DEAD}
        dragDeadTime={Grid.DRAG_DEAD}
        options={['', '', '', '', '', '', 'Clear', 'Clear-All']}
        optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      />
    );
  }

  if (isPlaceholder(item)) {
    return (
      <sprite
        x={x}
        y={y}
        w={Grid.W}
        h={Grid.H}
        hide={hidden}
        item={item}
        itemCount={0}
        outline={1}
        shadowColor={BankColors.SLOT_SHADOW}
        transparency={120}
        dragDeadZone={Grid.DRAG_DEAD}
        dragDeadTime={Grid.DRAG_DEAD}
        options={['', '', '', '', '', '', '', 'Release']}
        optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      />
    );
  }

  return (
    <sprite
      x={x}
      y={y}
      w={Grid.W}
      h={Grid.H}
      hide={hidden}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={BankColors.SLOT_SHADOW}
      transparency={0}
      dragDeadZone={Grid.DRAG_DEAD}
      dragDeadTime={Grid.DRAG_DEAD}
      options={[
        primary,
        one,
        'Withdraw-5',
        'Withdraw-10',
        requested,
        'Withdraw-X',
        'Withdraw-All',
        'Withdraw-All-but-1',
        charged ? 'Configure-Charges' : '',
        placeholder,
      ]}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
    />
  );
}
