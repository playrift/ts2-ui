import { predictServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { BankSounds, BankVars } from './bankmain.constants';

export function switchTab(option: Int, tab: Int, current: Int): void {
  if (option !== 1) {
    return;
  }
  if (tab !== current) {
    playSound(BankSounds.SELECT);
  }
  predictServerState(BankVars.CURRENT_TAB, tab);
}
