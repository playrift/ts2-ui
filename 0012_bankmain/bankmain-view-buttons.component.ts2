import { useRef, useState } from 'ts2';
import { setTransparency } from '../lib/lib.components';
import { bankWornmode } from '../lib/game/varcs';
import { Bar, BankSprites } from './bankmain.constants';
import { BankView, bankView } from './bankmain.state';

export function BankViewButtons(): Component {
  const [view, setView] = useState(bankView);
  const [wornMode, setWornMode] = useState(bankWornmode);
  const wornGlyph = useRef();

  return (
    <>
      <layer
        x={34}
        y={7}
        w={21}
        h={21}
        options={[view === BankView.MENU ? 'Hide menu' : 'Show menu']}
        onOptionSelect={(event) => {
          if (event.option !== 1) {
            return;
          }
          setWornMode(0);
          setView(view === BankView.MENU ? BankView.ITEMS : BankView.MENU);
        }}
      >
        <sprite x={0} y={0} w={21} h={21} sprite={BankSprites.MENU} hover={{ sprite: BankSprites.MENU_HOVER }} />
      </layer>

      <layer
        x={{ right: 7 }}
        y={37}
        w={36}
        h={36}
        hide={view === BankView.MENU ? true : false}
        options={[view === BankView.WORN ? 'Hide worn items' : 'Show worn items']}
        onMouseRepeat={() => setTransparency(wornGlyph, Bar.HOVER_TRANSPARENCY)}
        onMouseLeave={() => setTransparency(wornGlyph, 0)}
        onOptionSelect={(event) => {
          if (event.option !== 1) {
            return;
          }
          setWornMode(view === BankView.WORN ? 0 : 1);
          setView(view === BankView.WORN ? BankView.ITEMS : BankView.WORN);
        }}
      >
        <sprite
          x={0}
          y={0}
          w={36}
          h={36}
          sprite={view === BankView.WORN ? BankSprites.BUTTON_ON : BankSprites.BUTTON_OFF}
        />
        <sprite
          ref={wornGlyph}
          x={4}
          y={4}
          w={28}
          h={28}
          sprite={BankSprites.WORN}
          tiling={view === BankView.WORN ? false : true}
        />
      </layer>
    </>
  );
}
