import { useState, useUniverse } from 'ts2';
import { SteelBorder } from '../lib/steel-border.component';
import { BankHeader } from './bankmain-header.component';
import { BankItemsColumn } from './bankmain-items-column.component';
import { BankViewButtons } from './bankmain-view-buttons.component';
import { BankColors, Frame } from './bankmain.constants';
import { BankView, bankView } from './bankmain.state';

export function BankMain(): Component {
  const universe = useUniverse();
  const [view] = useState(bankView);

  const clamped: Boolean = universe.height > Frame.CLAMP_ABOVE ? true : false;

  return (
    <layer
      x="center"
      y={clamped ? { bottom: (universe.height - Frame.MAX_H) / 2 } : { bottom: Frame.SHORT_OFFSET }}
      w={Frame.W}
      h={clamped ? Frame.MAX_H : { fill: Frame.INSET }}
    >
      <layer x="center" y="center" w="fill" h="fill">
        <SteelBorder title="" titleColor={BankColors.LABEL} flags={0} />
      </layer>

      <BankHeader />

      <BankItemsColumn />

      <layer
        x="center"
        y={{ bottom: 5 }}
        w={{ fill: 10 }}
        h={{ fill: 40 }}
        hide={view === BankView.MENU ? false : true}
      />

      <layer
        x="center"
        y={{ bottom: 5 }}
        w={{ fill: 10 }}
        h={{ fill: 40 }}
        hide={view === BankView.WORN ? false : true}
      />

      <BankViewButtons />

      <layer x="center" y={{ bottom: 0 }} w={488} h={{ fill: 30 }} hide />
      <layer x="center" y="center" w="fill" h="fill" />
    </layer>
  );
}
