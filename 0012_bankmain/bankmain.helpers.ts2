import { CS2, useState } from 'ts2';
import { meslayerinput, meslayermode } from '../lib/game/varcs';
import { MESLAYER_SEARCH, SEARCH_MAX } from './bankmain.constants';

export function bankmainSearching(): Boolean {
  const [mode] = useState(meslayermode);
  const [input] = useState(meslayerinput);
  if (mode === MESLAYER_SEARCH) {
    return true;
  }
  if (mode <= 0 && CS2.string_length(input) > 0) {
    return true;
  }
  return false;
}

export function bankmainFilterString(): String {
  const [input] = useState(meslayerinput);
  const lowered: String = CS2.lowercase(input);
  if (CS2.string_length(lowered) <= SEARCH_MAX) {
    return lowered;
  }
  return CS2.substring(lowered, 0, SEARCH_MAX);
}

export function bankmainFilterItem(item: Item, searching: Boolean, filter: String): Boolean {
  if (!searching) {
    return true;
  }
  if (item === -1) {
    return false;
  }
  if (CS2.string_length(filter) === 0) {
    return true;
  }
  if (CS2.string_indexof_string(CS2.lowercase(CS2.item_name(item)), filter, 0) === -1) {
    return false;
  }
  return true;
}

export function sectionHeight(placed: Int): Int {
  if (placed <= 0) {
    return 0;
  }
  return ((placed + 7) / 8) * 36;
}

export function defaultQuantityLabel(quantityType: Int, requested: Int): String {
  if (quantityType === 1) {
    return '5';
  }
  if (quantityType === 2) {
    return '10';
  }
  if (quantityType === 3) {
    return `${requested > 1 ? requested : 1}`;
  }
  if (quantityType === 4) {
    return 'All';
  }
  return '1';
}

export function isPlaceholder(item: Item): Boolean {
  return CS2.item_unplaceholder(item as Int) === (item as Int) ? false : true;
}
