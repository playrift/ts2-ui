import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { CorpBeastColor, CorpBeastDodge, CorpBeastFont, Layout } from './corp-beast.constants';
import { corpBeastDamage } from './corp-beast.helpers';

const damage = createRef('corp_beast_damage');

export function CorpBeast_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, damage, CorpBeastDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <text
          ref={damage}
          x={Layout.TEXT_X}
          y={Layout.TEXT_Y}
          w={Layout.TEXT_W}
          h={Layout.TEXT_H}
          font={CorpBeastFont.LABEL}
          shadow
          color={CorpBeastColor.DAMAGE}
          onTimer={(event) => corpBeastDamage(event.component)}
        />
      </layer>
    </layer>
  );
}
