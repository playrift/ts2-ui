import { createRef, useInterval, useWatch } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { CorpBeastColor, CorpBeastDodge, CorpBeastFont, CorpBeastVarbits, Layout } from './corp-beast.constants';
import { corpBeastDamage } from './corp-beast.helpers';

const timerHost = createRef('0013_corp_beast_timer_host');

const damage = createRef('corp_beast_damage');

export function CorpBeast_(): Component {
  useInterval(() => overlayRelayout(timerHost, damage, CorpBeastDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  useWatch(CorpBeastVarbits.DAMAGE, (event) => corpBeastDamage(event.component), damage);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <text
          ref={damage}
          x={Layout.TEXT_X}
          y={Layout.TEXT_Y}
          w={Layout.TEXT_W}
          h={Layout.TEXT_H}
          font={CorpBeastFont.LABEL}
          shadow
          color={CorpBeastColor.DAMAGE}
          onLoad={(event) => corpBeastDamage(event.component)}
        />
      </layer>
    </layer>
  );
}
