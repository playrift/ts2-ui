import { CS2, useServerState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { CorpBeastVarbits, LOTS_AT } from './corp-beast.constants';

export function corpBeastDamage(label: ComponentId): void {
  const damage: Int = useServerState(CorpBeastVarbits.DAMAGE);
  if (damage >= LOTS_AT) {
    CS2.if_text_set('Damage: Lots!', label);
    return;
  }
  CS2.if_text_set(`Damage: ${groupDigits(damage, ',')}`, label);
}
