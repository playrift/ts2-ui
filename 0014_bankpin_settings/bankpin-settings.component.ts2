import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { textColourSwapper } from './bankpin-settings.helpers';
import { Layout, PinArt, PinColor, PinFont, PinText, StatusRows } from './bankpin-settings.constants';

export function BankpinSettings(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.screen.W} h={Layout.screen.H} hide>
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorderEntrypoint title={PinText.TITLE} />
        </layer>

        <sprite x={Layout.keys.X} y={Layout.keys.Y} w={Layout.keys.W} h={Layout.keys.H} sprite={PinArt.KEYS} />

        <layer x={Layout.status.X} y={Layout.status.Y} w={Layout.status.W} h={Layout.status.H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={PinArt.TILE_BROWN} tiling />

          {StatusRows.map((row) => (
            <>
              <text
                x="center"
                y={row.captionY}
                w="fill"
                h={Layout.caption.H}
                text={row.caption}
                font={PinFont.LABEL}
                color={PinColor.CAPTION}
                shadow
                align="center"
                valign="bottom"
              />
              <text
                x="center"
                y={row.valueY}
                w="fill"
                h={Layout.value.H}
                font={PinFont.VALUE}
                color={PinColor.VALUE}
                shadow
                align="center"
                valign="middle"
              />
            </>
          ))}

          <SteelFrameEntrypoint />
        </layer>

        <layer
          x={{ right: Layout.messages.INSET_X }}
          y={{ bottom: Layout.messages.INSET_Y }}
          w={Layout.messages.W}
          h={{ fill: Layout.messages.FILL_H }}
        >
          <rect x="center" y="center" w="fill" h="fill" fill />
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.messagesHeading.H}
            text={PinText.MESSAGES}
            font={PinFont.LABEL}
            color={PinColor.HEADING}
            shadow
            align="center"
            valign="middle"
          />
          <text
            x="center"
            y={{ bottom: Layout.messagesBody.INSET_Y }}
            w={{ fill: Layout.messagesBody.FILL_W }}
            h={{ fill: Layout.messagesBody.FILL_H }}
            font={PinFont.BODY}
            color={PinColor.MESSAGE}
            align="center"
            valign="middle"
          />

          <SteelFrameEntrypoint />
        </layer>

        <text
          x={Layout.instructions.X}
          y={{ bottom: Layout.instructions.INSET_Y }}
          w={{ fill: Layout.instructions.FILL_W }}
          h={{ fill: Layout.instructions.FILL_H }}
          text={PinText.INSTRUCTIONS}
          font={PinFont.BODY}
          color={PinColor.BUTTON}
          shadow
          valign="bottom"
        />

        <layer
          x={Layout.buttons.X}
          y={{ bottom: Layout.buttons.INSET_Y }}
          w={{ fill: Layout.buttons.FILL_W }}
          h={Layout.buttons.H}
        >
          <sprite x="center" y="center" w="fill" h="fill" sprite={PinArt.TILE_RED} tiling />

          <layer x="center" y="center" w="fill" h="fill" hide>
            <text
              x="center"
              y={10}
              w="fill"
              h={Layout.tallButton.H}
              text={PinText.SET_PIN}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
            <text
              x="center"
              y={{ bottom: 10 }}
              w="fill"
              h={Layout.tallButton.H}
              text={PinText.CHANGE_DELAY}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
          </layer>

          <layer x="center" y="center" w="fill" h="fill" hide>
            <text
              x="center"
              y={8}
              w="fill"
              h={Layout.shortButton.H}
              text={PinText.CHANGE_PIN}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
            <text
              x="center"
              y={26}
              w="fill"
              h={Layout.shortButton.H}
              text={PinText.DELETE_PIN}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
            <text
              x="center"
              y={{ bottom: 26 }}
              w="fill"
              h={Layout.shortButton.H}
              text={PinText.CHANGE_DELAY}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
            <text
              x="center"
              y={{ bottom: 8 }}
              w="fill"
              h={Layout.shortButton.H}
              text={PinText.CHANGE_LOGOUT}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
          </layer>

          <layer x="center" y="center" w="fill" h="fill" hide>
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={PinText.CANCEL_PENDING}
              font={PinFont.LABEL}
              color={PinColor.BUTTON}
              shadow
              align="center"
              valign="middle"
              continueOp
              onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
              onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
            />
          </layer>

          <SteelFrameEntrypoint />
        </layer>
      </layer>

      <layer x="center" y="center" w={Layout.screen.W} h={Layout.screen.H} hide>
        <rect x="center" y="center" w="fill" h="fill" fill />

        <text
          x="center"
          y={Layout.pending.Y}
          w="fill"
          h={Layout.pending.H}
          font={PinFont.LABEL}
          color={PinColor.VALUE}
          shadow
          align="center"
        />

        <layer x="center" y={Layout.pendingButton.FIRST_Y} w="fill" h={Layout.pendingButton.H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={PinArt.TILE_RED} tiling />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            font={PinFont.LABEL}
            color={PinColor.BUTTON}
            shadow
            align="center"
            valign="middle"
            continueOp
            onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
            onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
          />

          <SteelFrameEntrypoint />
        </layer>

        <layer x="center" y={Layout.pendingButton.SECOND_Y} w="fill" h={Layout.pendingButton.H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={PinArt.TILE_RED} tiling />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            font={PinFont.LABEL}
            color={PinColor.BUTTON}
            shadow
            align="center"
            valign="middle"
            continueOp
            onMouseEnter={(event) => textColourSwapper(event.component, PinColor.BUTTON_HOVER)}
            onMouseLeave={(event) => textColourSwapper(event.component, PinColor.BUTTON)}
          />

          <SteelFrameEntrypoint />
        </layer>

        <SteelFrameEntrypoint />
      </layer>
    </>
