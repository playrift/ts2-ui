import { CS2, predictServerState, stopTimer, useInventory, useServerState, useState } from 'ts2';

import { prepotDeviceLoadoutsUiActiveDevice } from '../lib/game/varcs';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { PotionByItem, PotionFamilies } from './bankside-potions.data';
import { potionStoreDoses } from './bankside-potionstore.helpers';
import {
  BanksideInventories,
  BanksideVarbits,
  HoverFade,
  Prepot,
  prepotLoadoutContents0,
  prepotLoadoutContents1,
  prepotLoadoutContents2,
  prepotLoadoutContents3,
} from './bankside.constants';
import { potionSettable } from './bankside.helpers';

export function vialHover(entering: Boolean, target: ComponentId, rest: Int): void {
  if (entering) {
    const settleAt: Int = clientClock() + HoverFade.CYCLES;
    if (rest >= HoverFade.VIAL_THRESHOLD) {
      target.transparency = rest - HoverFade.VIAL_DOWN;
    } else {
      target.transparency = rest + HoverFade.VIAL_UP;
    }
    target.onTimer = () => {
      if (clientClock() < settleAt) {
        return;
      }
      target.transparency = rest;
      stopTimer(target);
    };
    return;
  }
  target.transparency = rest;
  target.onTimer = null;
}

export function vialHoverUnlessMobile(target: ComponentId, rest: Int): void {
  if (onMobile()) {
    return;
  }
  vialHover(true, target, rest);
}

export function familyDoseItem(family: Int, dose: Int): ItemName {
  const row = PotionFamilies.at(family);
  if (row !== null) {
    if (dose === 1) {
      return row.dose1;
    }
    if (dose === 2) {
      return row.dose2;
    }
    if (dose === 3) {
      return row.dose3;
    }
    if (dose === 4) {
      return row.dose4;
    }
    return -1;
  }
  return 0;
}

export function potionFamily(item: Item): Int {
  const row = PotionByItem.get(item);
  return row === null ? -1 : row.family;
}

export function potionMaxDose(family: Int): Int {
  const row = PotionFamilies.at(family);
  return row === null ? -1 : row.maxDose;
}

export function potionLoadable(item: Item): Boolean {
  if (!potionSettable(item)) {
    return false;
  }
  if (potionFamily(item) === -1) {
    return false;
  }
  return true;
}

export function prepotLoadoutPotion(loadout: Int, slot: Int): Int {
  if (loadout === 0) {
    if (slot === 0) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_0_SLOT_0_POTION);
    }
    if (slot === 1) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_0_SLOT_1_POTION);
    }
    if (slot === 2) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_0_SLOT_2_POTION);
    }
    if (slot === 3) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_0_SLOT_3_POTION);
    }
    if (slot === 4) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_0_SLOT_4_POTION);
    }
  }
  if (loadout === 1) {
    if (slot === 0) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_1_SLOT_0_POTION);
    }
    if (slot === 1) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_1_SLOT_1_POTION);
    }
    if (slot === 2) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_1_SLOT_2_POTION);
    }
    if (slot === 3) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_1_SLOT_3_POTION);
    }
    if (slot === 4) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_1_SLOT_4_POTION);
    }
  }
  if (loadout === 2) {
    if (slot === 0) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_2_SLOT_0_POTION);
    }
    if (slot === 1) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_2_SLOT_1_POTION);
    }
    if (slot === 2) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_2_SLOT_2_POTION);
    }
    if (slot === 3) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_2_SLOT_3_POTION);
    }
    if (slot === 4) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_2_SLOT_4_POTION);
    }
  }
  if (loadout === 3) {
    if (slot === 0) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_3_SLOT_0_POTION);
    }
    if (slot === 1) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_3_SLOT_1_POTION);
    }
    if (slot === 2) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_3_SLOT_2_POTION);
    }
    if (slot === 3) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_3_SLOT_3_POTION);
    }
    if (slot === 4) {
      return useServerState(Varps.PREPOT_DEVICE_LOADOUT_3_SLOT_4_POTION);
    }
  }
  return -1;
}

