import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { BanksideSprites } from './bankside.constants';

export function BanksideScrollbar({ content }: { content: Ref }): Component {
  return (
    <ScrollbarVertical
      content={content}
      track={BanksideSprites.BAR_TRACK}
      capTopSprite={BanksideSprites.BAR_CAP_TOP}
      thumbSprite={BanksideSprites.BAR_THUMB}
      capBottomSprite={BanksideSprites.BAR_CAP_BOTTOM}
      arrowUp={BanksideSprites.BAR_ARROW_UP}
      arrowDown={BanksideSprites.BAR_ARROW_DOWN}
    />
  );
}
