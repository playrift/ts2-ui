import { setTransparency } from '../lib/lib.components';
import { graphicSwapper, opsound } from '../lib/lib.helpers';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { LootingBagView, SecondInventoryView } from './bankside-bag.component';
import { ItemsView } from './bankside-items.component';
import { PrepotContents, PrepotLoadoutRows } from './bankside-prepot.component';
import { RuneNamePicker, RunePicker, RunePouchLoadouts, RunePouchTop } from './bankside-runepouch.component';
import {
  BanksideColor,
  BanksideFonts,
  BanksideSprites,
  Chrome,
  Panel,
  Pouch,
  Prepot,
  Wash,
  banksideRef,
  itemsContainer,
  lootingBagContainer,
  prepotContainer,
  prepotLoadouts,
  runepouchContainer,
  runepouchLoadoutContainer,
  runepouchNameSelectContainer,
  runepouchNameSelectList,
  runepouchSelectBackdrop,
  runepouchSelectContainer,
  runepouchSelectList,
  runepouchTop,
  secondInvContainer,
} from './bankside.constants';
import { banksideInit, closeRunePickers, dismissView } from './bankside.helpers';
import { BanksideScrollbar } from './bankside-scrollbar.component';

export function Bankside(): Component {
  return (
    <>
      <layer static ref={itemsContainer} x={0} y={0} w={Panel.W} h={Panel.H} hide onLoad={() => banksideInit()}>
        <ItemsView />
      </layer>

      <layer static ref={lootingBagContainer} x="center" y="center" w="fill" h="fill" hide>
        <sprite
          x={Chrome.BUTTON_X}
          y={0}
          w={Chrome.BUTTON_W}
          h={Chrome.BUTTON_H}
          sprite={BanksideSprites.ICON_DEPOSIT_LOOT}
          options={['Deposit loot']}
          onMouseEnter={(event) => setTransparency(event.self, Chrome.BUTTON_HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Chrome.BUTTON_REST)}
          onOptionSelect={(event) => opsound(event.option, -1)}
        />
        <text
          x="center"
          y={0}
          w="fill"
          h={Chrome.CAPTION_H}
          text="Bank your loot"
          font={BanksideFonts.CAPTION}
          color={BanksideColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <sprite
          x={{ right: Chrome.CLOSE_INSET }}
          y={Chrome.CLOSE_INSET}
          w={Chrome.CLOSE}
          h={Chrome.CLOSE}
          sprite={BanksideSprites.CLOSE}
          options={['Dismiss']}
          onMouseEnter={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE)}
          onOptionSelect={(event) => dismissView(event.option)}
        />
        <layer x="center" y={Chrome.BOX_Y} w={{ fill: Chrome.BAG_BOX_INSET_W }} h={{ fill: Chrome.BOX_INSET_H }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Chrome.TILE_INSET }}
            h={{ fill: Chrome.TILE_INSET }}
            sprite={BanksideSprites.BACKING_LIGHT}
            tiling
          />
          <layer x="center" y="center" w={{ fill: Chrome.INNER_INSET }} h={{ fill: Chrome.INNER_INSET }}>
            <LootingBagView />
          </layer>
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer static ref={secondInvContainer} x="center" y="center" w="fill" h="fill" hide>
        <sprite
          x={Chrome.BUTTON_X}
          y={0}
          w={Chrome.BUTTON_W}
          h={Chrome.BUTTON_H}
          sprite={BanksideSprites.ICON_DEPOSIT_SECOND}
          options={['Deposit loot']}
          onMouseEnter={(event) => setTransparency(event.self, Chrome.BUTTON_HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Chrome.BUTTON_REST)}
          onOptionSelect={(event) => opsound(event.option, -1)}
        />
        <text
          x="center"
          y={0}
          w="fill"
          h={Chrome.CAPTION_H}
          text="Bank your items"
          font={BanksideFonts.CAPTION}
          color={BanksideColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <sprite
          x={{ right: Chrome.CLOSE_INSET }}
          y={Chrome.CLOSE_INSET}
          w={Chrome.CLOSE}
          h={Chrome.CLOSE}
          sprite={BanksideSprites.CLOSE}
          options={['Dismiss']}
          onMouseEnter={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE)}
          onOptionSelect={(event) => dismissView(event.option)}
        />
        <layer x="center" y={Chrome.BOX_Y} w={{ fill: Chrome.BAG_BOX_INSET_W }} h={{ fill: Chrome.BOX_INSET_H }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Chrome.TILE_INSET }}
            h={{ fill: Chrome.TILE_INSET }}
            sprite={BanksideSprites.BACKING_LIGHT}
            tiling
          />
          <layer x="center" y="center" w={{ fill: Chrome.INNER_INSET }} h={{ fill: Chrome.INNER_INSET }}>
            <SecondInventoryView />
          </layer>
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer static ref={runepouchContainer} x="center" y="center" w="fill" h="fill">
        <sprite
          x={Chrome.BUTTON_X}
          y={0}
          w={Chrome.BUTTON_W}
          h={Chrome.BUTTON_H}
          sprite={BanksideSprites.ICON_DEPOSIT_INV}
          options={['Deposit runes']}
          onMouseEnter={(event) => setTransparency(event.self, Chrome.BUTTON_HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Chrome.BUTTON_REST)}
          onOptionSelect={(event) => opsound(event.option, -1)}
        />
        <text
          x="center"
          y={0}
          w="fill"
          h={Chrome.CAPTION_H}
          text="Rune Pouch"
          font={BanksideFonts.CAPTION}
          color={BanksideColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <sprite
          x={{ right: Chrome.CLOSE_INSET }}
          y={Chrome.CLOSE_INSET}
          w={Chrome.CLOSE}
          h={Chrome.CLOSE}
          sprite={BanksideSprites.CLOSE}
          options={['Dismiss']}
          onMouseEnter={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE)}
          onClick={() => closeRunePickers()}
          onOptionSelect={(event) => dismissView(event.option)}
        />
        <layer x="center" y={Chrome.BOX_Y} w="fill" h={{ fill: Chrome.BOX_INSET_H }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Chrome.TILE_INSET }}
            h={{ fill: Chrome.TILE_INSET }}
            sprite={BanksideSprites.BACKING_LIGHT}
            tiling
          />
          <layer x="center" y="center" w={{ fill: Chrome.INNER_INSET }} h={{ fill: Chrome.INNER_INSET }}>
            <layer static ref={runepouchTop} x="center" y={0} w="fill" h={{ fill: Pouch.TOP_INSET_H }}>
              <RunePouchTop />
            </layer>
            <layer
              static
              ref={runepouchLoadoutContainer}
              x={0}
              y={Pouch.LIST_Y}
              w={{ fill: Pouch.BAR_W }}
              h={{ fill: Pouch.LIST_Y }}
            >
              <RunePouchLoadouts />
            </layer>
            <layer x={{ right: 0 }} y={Pouch.LIST_Y} w={Pouch.BAR_W} h={{ fill: Pouch.LIST_Y }}>
              <BanksideScrollbar content={runepouchLoadoutContainer} />
            </layer>
            <layer static ref={runepouchSelectContainer} x={0} y={0} w={Pouch.PICKER_W} h={Pouch.PICKER_H} hide>
              <sprite
                x="center"
                y="center"
                w="fill"
                h="fill"
                sprite={BanksideSprites.BACKING_DARK}
                tiling
                noClickThrough
              />
              <layer static ref={runepouchSelectList} x={0} y="center" w={{ fill: Pouch.BAR_W }} h="fill">
                <sprite
                  static
                  ref={runepouchSelectBackdrop}
                  x="center"
                  y="center"
                  w="fill"
                  h="fill"
                  sprite={BanksideSprites.BACKING}
                  tiling
                  transparency={Wash.CLEAR}
                />
                <RunePicker />
              </layer>
              <layer x={{ right: 0 }} y="center" w={Pouch.BAR_W} h="fill">
                <BanksideScrollbar content={runepouchSelectList} />
              </layer>
            </layer>
            <layer static ref={runepouchNameSelectContainer} x={0} y={0} w={Pouch.PICKER_W} h={Pouch.PICKER_H} hide>
              <sprite
                x="center"
                y="center"
                w="fill"
                h="fill"
                sprite={BanksideSprites.BACKING_DARK}
                tiling
                noClickThrough
              />
              <layer static ref={runepouchNameSelectList} x={0} y="center" w={{ fill: Pouch.BAR_W }} h="fill">
                <RuneNamePicker />
              </layer>
              <layer x={{ right: 0 }} y="center" w={Pouch.BAR_W} h="fill">
                <BanksideScrollbar content={runepouchNameSelectList} />
              </layer>
            </layer>
          </layer>
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill" hide noClickThrough />

      <layer static ref={prepotContainer} x="center" y="center" w="fill" h="fill" hide>
        <sprite
          x={Chrome.BUTTON_X}
          y={0}
          w={Chrome.BUTTON_W}
          h={Chrome.BUTTON_H}
          sprite={BanksideSprites.ICON_DEPOSIT_INV}
          options={['Deposit potions']}
          onMouseEnter={(event) => setTransparency(event.self, Chrome.BUTTON_HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Chrome.BUTTON_REST)}
          onOptionSelect={(event) => opsound(event.option, -1)}
        />
        <sprite
          x={{ right: Chrome.FILL_RIGHT }}
          y={0}
          w={Chrome.BUTTON_W}
          h={Chrome.BUTTON_H}
          sprite={BanksideSprites.ICON_FILL}
          options={['Fill potions']}
          onMouseEnter={(event) => setTransparency(event.self, Chrome.BUTTON_HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Chrome.BUTTON_REST)}
          onOptionSelect={(event) => opsound(event.option, -1)}
        />
        <text
          x="center"
          y={0}
          w="fill"
          h={Chrome.CAPTION_H}
          text="Potions"
          font={BanksideFonts.CAPTION}
          color={BanksideColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <sprite
          x={{ right: Chrome.CLOSE_INSET }}
          y={Chrome.CLOSE_INSET}
          w={Chrome.CLOSE}
          h={Chrome.CLOSE}
          sprite={BanksideSprites.CLOSE}
          options={['Dismiss']}
          onMouseEnter={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.self, BanksideSprites.CLOSE)}
          onOptionSelect={(event) => dismissView(event.option)}
        />
        <layer x="center" y={Chrome.BOX_Y} w="fill" h={{ fill: Chrome.BOX_INSET_H }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Chrome.TILE_INSET }}
            h={{ fill: Chrome.TILE_INSET }}
            sprite={BanksideSprites.BACKING_LIGHT}
            tiling
          />
          <layer x="center" y="center" w={{ fill: Chrome.INNER_INSET }} h={{ fill: Chrome.INNER_INSET }}>
            <layer x="center" y={0} w="fill" h={Prepot.CONTENTS_H}>
              <rect x="center" y="center" w="fill" h="fill" fill color={BanksideColor.BLACK} transparency={220} />
            </layer>
            <layer x="center" y={0} w="fill" h={Prepot.CONTENTS_H}>
              <PrepotContents />
            </layer>
            <text
              x={0}
              y={{ bottom: Prepot.LABEL_BOTTOM }}
              w="fill"
              h={Prepot.LABEL_H}
              text="Load-outs:"
              font={BanksideFonts.BODY}
              color={BanksideColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
            <layer
              static
              ref={prepotLoadouts}
              x={0}
              y={Prepot.LIST_Y}
              w={{ fill: Prepot.BAR_W }}
              h={{ fill: Prepot.LIST_Y }}
              scrollHeight={Prepot.SCROLL_EXTENT}
            >
              <PrepotLoadoutRows />
            </layer>
            <layer x={{ right: 0 }} y={Prepot.LIST_Y} w={Prepot.BAR_W} h={{ fill: Prepot.LIST_Y }}>
              <BanksideScrollbar content={prepotLoadouts} />
            </layer>
          </layer>
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>
    </>
  );
}
