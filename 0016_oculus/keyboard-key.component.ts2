import { useUniverse } from 'ts2';

import { KeyRow, OculusArt, OculusColor, OculusFonts } from './oculus.constants';

export function KeyboardKey({ label }: { label: String }): Component {
  const cap = useUniverse();
  const capWidth: Int = cap.width;

  return (
    <layer w="fill" h="fill">
      {capWidth <= KeyRow.CAP ? (
        <sprite x="center" y="center" w="fill" h="fill" sprite={OculusArt.KEY_SQUARE} />
      ) : (
        <>
          <sprite x={0} y="center" w={KeyRow.CAP_END_W} h="fill" sprite={OculusArt.KEY_LEFT} />
          <sprite x="center" y="center" w={{ fill: KeyRow.CAP_ENDS_W }} h="fill" sprite={OculusArt.KEY_MIDDLE} />
          <sprite x="right" y="center" w={KeyRow.CAP_END_W} h="fill" sprite={OculusArt.KEY_RIGHT} />
        </>
      )}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={OculusFonts.CAP}
        color={OculusColor.CAP_TEXT}
        align="center"
        valign="middle"
        shadow={false}
      />
    </layer>
  );
}
