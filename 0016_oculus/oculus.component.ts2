import { OculusControls } from './controls-panel.component';
import { cameraZoom } from './oculus.camera';
import { OculusSpeedKeys } from './speed-keys.component';

export function Oculus(): Component {
  return (
    <layer w="fill" h="fill" noClickThrough onScrollWheel={(event) => cameraZoom(event.mouseY)}>
      <layer w="fill" h="fill" contentType="worldView" />
      <layer w="fill" h="fill" />
      <OculusControls />
      <OculusSpeedKeys />
    </layer>
  );
}
