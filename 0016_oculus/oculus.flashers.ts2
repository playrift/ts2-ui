import { CS2 } from 'ts2';

import { rgbToHex } from '../0259_area_task/area-task.helpers';
import { clientClock, scaled } from '../lib/lib.engine';
import { Flash } from './oculus.constants';

export function oculusFlashColour(): Int {
  let phase: Int = clientClock() % Flash.PERIOD;
  if (phase > Flash.HALF) {
    phase = Flash.PERIOD - phase;
  }
  const level: Int = scaled(CS2.invpow(phase * Flash.CHANNEL_MAX, 2), CS2.invpow(Flash.PEAK, 2), Flash.CHANNEL_MAX);
  return rgbToHex(Flash.CHANNEL_MAX, level, level);
}
