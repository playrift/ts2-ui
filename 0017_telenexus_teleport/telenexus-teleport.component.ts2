import { useServerState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { chatDefaultStopInput } from '../0608_fossil_mushtrees/chatdefault-input';
import {
  Layout,
  NexusModel,
  TeleportSprites,
  TeleportVarbits,
  teleportListRef,
  teleportScrollingRef,
} from './telenexus-teleport.constants';
import { ScryHint, TeleportModes } from './teleport-mode.component';
import { TeleportRows } from './teleport-rows.component';

export function TelenexusTeleport(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <StoneBorderEntrypoint title="Portal Nexus" />
      </layer>

      <layer
        x="center"
        y={Layout.CONTENTS_Y}
        w={{ fill: Layout.CONTENTS_W_INSET }}
        h={{ fill: Layout.CONTENTS_H_INSET }}
        onLoad={() => telenexusTeleportInit()}
      >
        <NexusPortalModel />

        <ScryHint />

        <layer x={{ right: Layout.BOX_RIGHT }} y={{ bottom: Layout.BOX_BOTTOM }} w={Layout.BOX_W} h={Layout.BOX_H}>
          <layer x="center" y="center" w={{ fill: Layout.MODES_W_INSET }} h={{ fill: Layout.MODES_H_INSET }}>
            <TeleportModes />
          </layer>
          <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
        </layer>

        <layer
          static
          ref={teleportListRef}
          x={Layout.LIST_X}
          y={Layout.LIST_Y}
          w={{ fill: Layout.LIST_W_INSET }}
          h={{ fill: Layout.LIST_H_INSET }}
        >
          <layer w={1} h={1} />
          <layer w={1} h={1} />
          <rect w="fill" h="fill" color={0} />

          <layer
            static
            ref={teleportScrollingRef}
            x={Layout.PANE_INSET}
            y={Layout.PANE_INSET}
            w={{ fill: Layout.PANE_W_INSET }}
            h={{ fill: Layout.PANE_H_INSET }}
          >
            <TeleportRows />
          </layer>

          <layer
            x={{ right: Layout.PANE_INSET }}
            y={Layout.PANE_INSET}
            w={Layout.BAR_W}
            h={{ fill: Layout.PANE_H_INSET }}
          >
            <ScrollbarVertical
              content={teleportScrollingRef}
              track={TeleportSprites.TRACK}
              capTopSprite={TeleportSprites.CAP_TOP}
              thumbSprite={TeleportSprites.THUMB}
              capBottomSprite={TeleportSprites.CAP_BOTTOM}
              arrowUp={TeleportSprites.ARROW_UP}
              arrowDown={TeleportSprites.ARROW_DOWN}
            />
          </layer>
        </layer>
      </layer>
    </>
  );
}

export function telenexusTeleportInit(): void {
  if (onMobile()) {
    return;
  }
  chatDefaultStopInput();
}

function NexusPortalModel(): Component {
  const id: Int = useServerState(TeleportVarbits.NEXUS_ID);
  return (
    <model
      x={{ right: Layout.MODEL_RIGHT }}
      y={0}
      w="32.45%"
      h={{ fill: Layout.MODEL_H_INSET }}
      model={id === 2 ? NexusModel.GILDED : id === 3 ? NexusModel.CRYSTAL : NexusModel.MARBLE}
      zoom={Layout.MODEL_ZOOM}
      offsetY={Layout.MODEL_OFFSET_Y}
    />
  );
}
