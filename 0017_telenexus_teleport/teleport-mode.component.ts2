import { predictServerState, useServerState, useState } from 'ts2';

import { textDevice } from '../lib/lib.helpers';
import {
  Layout,
  SCRY_HINT,
  SCRY_MODE,
  TELEPORT_MODE,
  TeleportColor,
  TeleportFonts,
  TeleportSprites,
  TeleportVarbits,
} from './telenexus-teleport.constants';

export function TeleportModes(): Component {
  const scry: Int = useServerState(TeleportVarbits.SCRY_MODE);
  return (
    <>
      <ModeRow lit={scry === 0} label={TELEPORT_MODE} bottom={0} mode={0} />
      <ModeRow lit={scry === 1} label={SCRY_MODE} bottom={1} mode={1} />
    </>
  );
}

function ModeRow({ lit, label, bottom, mode }: { lit: Boolean; label: String; bottom: Int; mode: Int }): Component {
  const [hovered, setHovered] = useState(0);
  const radio: Sprite =
    hovered === 1
      ? lit
        ? TeleportSprites.RADIO_ON_HOVER
        : TeleportSprites.RADIO_OFF_HOVER
      : lit
        ? TeleportSprites.RADIO_ON
        : TeleportSprites.RADIO_OFF;
  return (
    <>
      {bottom === 1 ? (
        <sprite
          x={Layout.RADIO_X}
          y={{ bottom: Layout.RADIO_BOTTOM }}
          w={Layout.RADIO}
          h={Layout.RADIO}
          sprite={radio}
        />
      ) : (
        <sprite x={Layout.RADIO_X} y={Layout.RADIO_TOP} w={Layout.RADIO} h={Layout.RADIO} sprite={radio} />
      )}
      {bottom === 1 ? (
        <text
          x={Layout.MODE_X}
          y={{ bottom: Layout.MODE_Y }}
          w={{ fill: Layout.MODE_W_INSET }}
          h={Layout.MODE_H}
          text={label}
          font={TeleportFonts.LABEL}
          color={hovered === 1 ? TeleportColor.HOT : TeleportColor.LABEL}
          align="center"
          valign="middle"
          shadow
          onOptionSelect={() => predictServerState(TeleportVarbits.SCRY_MODE, mode)}
          onMouseEnter={() => {
            setHovered(1);
          }}
          onMouseLeave={() => {
            setHovered(0);
          }}
        />
      ) : (
        <text
          x={Layout.MODE_X}
          y={Layout.MODE_Y}
          w={{ fill: Layout.MODE_W_INSET }}
          h={Layout.MODE_H}
          text={label}
          font={TeleportFonts.LABEL}
          color={hovered === 1 ? TeleportColor.HOT : TeleportColor.LABEL}
          align="center"
          valign="middle"
          shadow
          onOptionSelect={() => predictServerState(TeleportVarbits.SCRY_MODE, mode)}
          onMouseEnter={() => {
            setHovered(1);
          }}
          onMouseLeave={() => {
            setHovered(0);
          }}
        />
      )}
    </>
  );
}

export function ScryHint(): Component {
  const scry: Int = useServerState(TeleportVarbits.SCRY_MODE);
  return (
    <text
      x={Layout.HINT_X}
      y={Layout.HINT_Y}
      w={Layout.HINT_W}
      h={Layout.HINT_H}
      text={scry === 1 ? `${textDevice('Click', 'Tap')}${SCRY_HINT}` : ''}
      font={TeleportFonts.LABEL}
      color={TeleportColor.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}
