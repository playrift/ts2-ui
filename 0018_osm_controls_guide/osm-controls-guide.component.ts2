import { predictServerState, useServerState } from 'ts2';

import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { closeInterface } from '../lib/lib.helpers';
import { GuideArt, GuideColors, GuideFonts, GuidePage, GuidePages, GuideSounds } from './osm-controls-guide.constants';
import { playSound } from '../lib/lib.engine';

const turn = (to: Int): void => {
  playSound(GuideSounds.CLICK);
  predictServerState(GuidePage, to);
};

export function OsmControlsGuide(): Component {
  const page = useServerState(GuidePage);

  return (
    <layer x="center" y="center" w={480} h={300}>
      <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={GuideArt.BACKING} tiling />

      <layer x="center" y="center" w={{ fill: 20 }} h={{ fill: 20 }}>
        {page === 1 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x={{ center: -5 }} y="center" w={317} h={47} sprite={GuideArt.TAP_AND_PRESS} />
            <text
              x={30}
              y={180}
              w={150}
              h={20}
              text="Tap gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
            <text
              right={25}
              y={180}
              w={150}
              h={20}
              text="Press gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page === 2 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x="center" y={5} w={369} h={214} sprite={GuideArt.TAP_INTERACT} />
            <text
              x="center"
              y={240}
              w="fill"
              h={20}
              text="Interacting with an NPC: Tap gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page === 3 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x="center" y={5} w={316} h={214} sprite={GuideArt.PRESS_INTERACT} />
            <text
              x="center"
              y={240}
              w="fill"
              h={20}
              text="Interacting with an NPC: Press gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page === 4 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x="center" y={0} w={328} h={266} sprite={GuideArt.DRAG_CAMERA} />
            <text
              x="center"
              bottom={0}
              w="fill"
              h={20}
              text="Camera movement: Drag gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page === 5 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x="center" y={30} w={344} h={195} sprite={GuideArt.PRESS_MINIMISE} />
            <text
              x="center"
              y={235}
              w="fill"
              h={20}
              text="Minimise world map: Press gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page === 6 && (
          <layer x="center" y="center" w="fill" h="fill">
            <sprite x={{ center: -27 }} y={100} w={137} h={67} sprite={GuideArt.PRESS_FNMODE} />
            <text
              x="center"
              y={170}
              w="fill"
              h={60}
              text="The function mode button is located in the<br>bottom left corner.<br><br>Function mode options: Press gesture"
              font={GuideFonts.CAPTION}
              color={GuideColors.CAPTION}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        )}

        {page >= GuidePages.FIRST && page <= GuidePages.LAST && (
          <sprite
            right={20}
            bottom={25}
            w={43}
            h={29}
            sprite={GuideArt.NEXT}
            options={['Next']}
            onOptionSelect={() => {
              turn(Math.min(GuidePages.LAST, page + 1));
            }}
          />
        )}
        {page > GuidePages.FIRST && page <= GuidePages.LAST && (
          <sprite
            x={20}
            bottom={25}
            w={43}
            h={29}
            sprite={GuideArt.PREVIOUS}
            options={['Previous']}
            onOptionSelect={() => {
              turn(Math.max(GuidePages.FIRST, page - 1));
            }}
          />
        )}

        <sprite
          right={0}
          y={0}
          w={26}
          h={23}
          sprite={GuideArt.CLOSE}
          hover={{ sprite: GuideArt.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
        />
      </layer>

      <SteelFrame backdrop={false} />
    </layer>
  );
}
