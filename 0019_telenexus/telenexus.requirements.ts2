      if (lunarDiplomacyDone()) {
        text = `${text}<col=0dc10d>`;
      } else {
        text = `${text}<col=ff0000>`;
        met = false;
      }
      text = `${text}Completed Lunar Diplomacy. </col>`;
      return [met, text];
    }
    case 456: {
      if (useServerState(Varps.ELENAQUEST) >= 30) {
        text = `${text}<col=0dc10d>`;
