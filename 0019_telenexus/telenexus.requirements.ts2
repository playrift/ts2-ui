import { CS2, useInventory, useServerState } from 'ts2';

import { Relic } from '../lib/league-relics.data';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { leagueRelicActive } from '../lib/lib.magic';
import { Quest, questComplete } from '../lib/lib.quests';

import { SkillNames, TelenexusInventories, TelenexusTeleport } from './telenexus.constants';

export function teleportRequirements(row: TelenexusTeleport): [Boolean, String] {
  let text: String = '';
  let met: Boolean = true;

  const arceuus: Int = useServerState(Varbits.ARCEUUS_SPELLBOOK_UNLOCKED) === 0 ? 0 : 1;

  const skill: Skill = row.skill ?? -1;
  const level: Int = row.level ?? -1;
  if (skill !== -1) {
    if (CS2.stat_base(skill) >= level) {
      text = `${text}<col=0dc10d>`;
    } else {
      text = `${text}<col=ff0000>`;
      met = false;
    }
    text = `${text}Level ${level} ${SkillNames.get(skill) ?? 'Skill'}. </col>`;
  }

  if ((row.hasUnlockRequirement ?? -1) === 1) {
    if (skill !== -1) {
      text = `${text}<br>`;
    }
    const [unlocked, unlockText] = unlockLine(row.structId, arceuus);
    if (unlocked === false) {
      met = false;
    }
    text = `${text}${unlockText}`;
  }

  let shortfall: String = '';
  const cost1: ItemName = row.cost1Item ?? -1;
  if (cost1 !== -1 && affordable(cost1) < (row.cost1Count ?? -1)) {
    met = false;
    shortfall = '<br><col=ff0000>Can not afford cost. ';
  }
  const cost2: ItemName = row.cost2Item ?? -1;
  if (cost2 !== -1 && affordable(cost2) < (row.cost2Count ?? -1)) {
    met = false;
    shortfall = '<br><col=ff0000>Can not afford cost. ';
  }
  const cost3: ItemName = row.cost3Item ?? -1;
  if (cost3 !== -1 && affordable(cost3) < (row.cost3Count ?? -1)) {
    met = false;
    shortfall = '<br><col=ff0000>Can not afford cost. ';
  }
  const cost4: ItemName = row.cost4Item ?? -1;
  if (cost4 !== -1 && affordable(cost4) < (row.cost4Count ?? -1)) {
    met = false;
    shortfall = '<br><col=ff0000>Can not afford cost. ';
  }

  return [met, `${text}${shortfall}`];
}

export function affordable(item: ItemName): Int {
  const backpack = useInventory(TelenexusInventories.BACKPACK);
  const promised = useInventory(TelenexusInventories.COST);
  return backpack.total(item as Item) - promised.total(item as Item);
}

export function desertTreasureDone(): Boolean {
  if (useServerState(Varbits.DESERTTREASURE) >= 15) {
    return true;
  }
  if (leagueRelicActive(Relic.GRIMOIRE) === 1) {
    return true;
  }
  return false;
}

export function lunarDiplomacyDone(): Boolean {
  if (useServerState(Varbits.LUNAR_QUEST_MAIN) >= 190) {
    return true;
  }
  if (leagueRelicActive(Relic.GRIMOIRE) === 1) {
    return true;
  }
  return false;
}

function unlockLine(structId: Int, arceuus: Int): [Boolean, String] {
