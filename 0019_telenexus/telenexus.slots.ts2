export function slotCapacity(): Int {
  const id: Int = useServerState(TelenexusVarbits.NEXUS_ID);
  if (id === 2) {
    return NexusCapacity.GILDED;
  }
  if (id === 3) {
    return NexusCapacity.CRYSTAL;
  }
  return NexusCapacity.MARBLE;
}

export function claimSlot(teleport: Int): Int {
  const id: Int = useServerState(TelenexusVarbits.NEXUS_ID);
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    if (slotValue(slot) === 0) {
      if (slot <= 4 || (slot <= 8 && id > 1) || (slot > 8 && id > 2)) {
        writeSlot(slot, teleport);
        return slot;
      }
    }
    slot = slot + 1;
  }
  return -1;
}

export function setSlot(slot: Int, value: Int): void {
  const held: Int = slotValue(slot);
  const leftClick: Int = useServerState(TelenexusVarbits.LEFT_CLICK_TEMP);
  if (leftClick === held || leftClick === held + SCRY_OFFSET) {
    predictServerState(TelenexusVarbits.LEFT_CLICK_TEMP, value);
  }
  writeSlot(slot, value);
}

export function removeTeleport(teleport: Int): void {
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    if (slotValue(slot) === teleport) {
      writeSlot(slot, 0);
    }
    slot = slot + 1;
  }
  if (useServerState(TelenexusVarbits.LEFT_CLICK_TEMP) === teleport) {
    predictServerState(TelenexusVarbits.LEFT_CLICK_TEMP, 0);
  }
}

export function slotsFull(): Int {
  let filled: Int = 0;
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    if (slotValue(slot) > 0) {
      filled = filled + 1;
    }
    slot = slot + 1;
  }
  return filled;
}

export function isSlotted(teleport: Int): Boolean {
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    if (slotValue(slot) === teleport) {
      return true;
    }
    slot = slot + 1;
  }
  return false;
}

export function slotsMatchSaved(): Boolean {
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    if (slotValue(slot) !== savedSlotValue(slot)) {
      return false;
    }
    slot = slot + 1;
  }
  return true;
}

export function slotSumsMatch(): Boolean {
  let temp: Int = 0;
  let saved: Int = 0;
  let slot: Int = 1;
  while (slot <= NexusCapacity.VARBIT_SLOTS) {
    temp = temp + slotValue(slot);
    saved = saved + savedSlotValue(slot);
    slot = slot + 1;
  }
  return temp === saved;
}
