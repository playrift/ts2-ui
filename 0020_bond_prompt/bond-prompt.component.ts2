import { BondButton } from './bond-button.component';
import { BondColors, BondFonts, Layout } from './bond-prompt.constants';

export function BondPrompt(): Component {
  return (
    <layer x={{ center: 1 }} y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <model x={11} y={{ center: 2 }} w={64} h={64} zoom={400} />
      <model x={{ right: 11 }} y={{ center: 2 }} w={64} h={64} zoom={400} />

      <text
        x="center"
        y={13}
        w={{ fill: 20 }}
        h={13}
        font={BondFonts.MESSAGE}
        color={BondColors.LABEL}
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y={33}
        w={350}
        h={35}
        font={BondFonts.MESSAGE}
        color={BondColors.LABEL}
        align="center"
        valign="middle"
      />

      <CloseLine />

      <BondButton offset={-Layout.BUTTON_SPREAD} label="Open Store" />
      <BondButton offset={Layout.BUTTON_SPREAD} label="Bond Pouch" />
    </layer>
  );
}

function CloseLine(): Component {
  return (
    <text
      x="center"
      y="bottom"
      w={50}
      h={24}
      text="Close"
      font={BondFonts.CLOSE}
      color={BondColors.LABEL}
      align="center"
      valign="middle"
      options={['Close']}
      onMouseRepeat={(event) => {
        event.self.color = BondColors.CLOSE_HOVER;
      }}
      onMouseLeave={(event) => {
        event.self.color = BondColors.CLOSE_REST;
      }}
    />
  );
}
