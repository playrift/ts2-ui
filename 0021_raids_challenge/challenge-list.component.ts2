import { useRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { Challenge, ChallengeBar, ChallengeColors, ChallengeFonts, Row } from './raids-challenge.constants';
import { RaidsChallengeBrackets } from './raids-challenge.data';

export function ChallengeStripes(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {RaidsChallengeBrackets.map((label, index) =>
        index % 2 === 0 ? (
          <rect
            x={0}
            y={index * Row.H}
            w="fill"
            h={Row.H}
            fill
            color={ChallengeColors.WASH}
            transparency={ChallengeColors.STRIPE_FADE}
          />
        ) : (
          <rect x={0} y={0} w={0} h={0} />
        ),
      )}
    </layer>
  );
}

export function ChallengeRows(): Component {
  const highlight = useRef();

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <rect
        ref={highlight}
        x={0}
        y={0}
        w="fill"
        h={Row.H}
        fill
        color={ChallengeColors.WASH}
        transparency={ChallengeColors.HIGHLIGHT_FADE}
      />
      {RaidsChallengeBrackets.map((label, index) => (
        <text
          x={Row.TEXT_X}
          y={index * Row.H}
          w={{ fill: Row.TEXT_X }}
          h={Row.H}
          font={ChallengeFonts.BODY}
          color={ChallengeColors.LABEL}
          align="center"
          valign="middle"
          text={label}
          options={[Row.OP]}
          onOptionSelect={() => {
            highlight.y = index * Row.H;
          }}
        />
      ))}
    </layer>
  );
}

export function ChallengeList(): Component {
  const pane = useRef();

  return (
    <>
      <layer
        ref={pane}
        x={0}
        y="bottom"
        w={Challenge.PANE_W}
        h={{ fill: Challenge.PANE_INSET_H }}
        scrollHeight={RaidsChallengeBrackets.length * Row.H}
      >
        <layer x={0} y={0} w={Challenge.LIST_W} h="fill">
          <ChallengeStripes />
        </layer>
        <layer x={0} y={0} w={Challenge.LIST_W} h="fill">
          <ChallengeRows />
        </layer>
      </layer>

      <layer x={Challenge.BAR_X} y="bottom" w={Challenge.BAR_W} h={{ fill: Challenge.PANE_INSET_H }}>
        <ScrollbarVertical
          content={pane}
          track={ChallengeBar.TRACK}
          capTopSprite={ChallengeBar.CAP_TOP}
          thumbSprite={ChallengeBar.THUMB}
          capBottomSprite={ChallengeBar.CAP_BOTTOM}
          arrowUp={ChallengeBar.ARROW_UP}
          arrowDown={ChallengeBar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
