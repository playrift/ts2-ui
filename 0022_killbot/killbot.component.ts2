import { Camera, KillbotAnims, KillbotModels, Layout } from './killbot.constants';

export function Killbot(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Layout.UNIVERSE_INSET }} h={{ fill: Layout.UNIVERSE_INSET }}>
      <layer x="center" y="center" w="fill" h="fill" />

      <model
        x={Layout.MOURNER_X}
        y={{ center: Layout.MOURNER_CENTER_Y }}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={KillbotModels.MOURNER}
        anim={KillbotAnims.MOURNER}
        zoom={Camera.MOURNER_ZOOM}
        pitch={Camera.MOURNER_PITCH}
        yaw={Camera.MOURNER_YAW}
      />

      <model
        x={Layout.FIRE_X}
        y={{ bottom: Layout.FIRE_BOTTOM }}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={KillbotModels.FIRE}
        anim={KillbotAnims.FIRE}
        zoom={Camera.FIRE_ZOOM}
        offsetY={Camera.FIRE_OFFSET_Y}
      />

      <layer
        x={{ right: Layout.ITEMS_RIGHT }}
        y={{ bottom: Layout.ITEMS_BOTTOM }}
        w={{ fill: Layout.ITEMS_FILL_W }}
        h={{ fill: Layout.ITEMS_FILL_H }}
      />
    </layer>
  );
}
