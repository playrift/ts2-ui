import { useRef } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { opsound } from '../lib/lib.helpers';
import { ChestHighlight, ChestModels, ChestOpSound, ChestSprites } from './tob-chests.constants';

export function TobChests(): Component {
  const bankIcon = useRef();
  const inventoryIcon = useRef();
  const discardIcon = useRef();

  return (
    <>
      <SteelBorderEntrypoint title="Theatre of Blood" />

      <layer x="center" y={39} w={{ fill: 18 }} h={{ fill: 49 }}>
        <model
          x={0}
          y="center"
          w={125}
          h={170}
          model={ChestModels.CHEST_LEFT}
          zoom={700}
          pitch={512}
          yaw={826}
          offsetX={-10}
          offsetY={5}
        />

        <model
          x={0}
          y="center"
          w={125}
          h={170}
          model={ChestModels.CHEST_RIGHT}
          zoom={600}
          pitch={512}
          yaw={451}
          offsetX={20}
          offsetY={32}
        />

        <model
          x="right"
          y={0}
          w={130}
          h={130}
          model={ChestModels.PLINTH}
          zoom={1300}
          pitch={135}
          yaw={267}
          offsetX={-20}
          offsetY={209}
        />

        <sprite
          x={{ right: 40 }}
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Bank-all']}
          onMouseEnter={() => setTransparency(bankIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(bankIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.BANK)}
        />
        <sprite ref={bankIcon} x={{ right: 43 }} y={{ bottom: 7 }} w={29} h={22} sprite={ChestSprites.BANK_ICON} />

        <sprite
          x="right"
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['Take-all']}
          onMouseEnter={() => setTransparency(inventoryIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(inventoryIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.INVENTORY)}
        />
        <sprite
          ref={inventoryIcon}
          x={{ right: 5 }}
          y={{ bottom: 7 }}
          w={29}
          h={22}
          sprite={ChestSprites.INVENTORY_ICON}
        />

        <sprite
          x={0}
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Discard-all']}
          onMouseEnter={() => setTransparency(discardIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(discardIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.DISCARD)}
        />
        <sprite ref={discardIcon} x={3} y={{ bottom: 7 }} w={29} h={22} sprite={ChestSprites.DISCARD_ICON} />

        <layer x={4} y={14} w={92} h={119} />
      </layer>
    </>
  );
}
