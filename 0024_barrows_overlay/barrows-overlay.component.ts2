import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  AHRIM,
  AHRIM_X,
  AHRIM_Y,
  BarrowsColor,
  BarrowsFonts,
  BarrowsModel,
  BarrowsOverlay,
  BarrowsSprites,
  DHAROK,
  DHAROK_X,
  DHAROK_Y,
  GUTHAN,
  GUTHAN_X,
  GUTHAN_Y,
  KARIL,
  KARIL_X,
  KARIL_Y,
  Layout,
  TORAG,
  TORAG_X,
  TORAG_Y,
  VERAC,
  VERAC_X,
  VERAC_Y,
} from './barrows-overlay.constants';
import { barrowsBrother, barrowsOverlayTick, modelTransparentInit } from './barrows-overlay.helpers';
import {
  ahrimModel,
  ahrimTick,
  brothers,
  content,
  dharokModel,
  dharokTick,
  guthanModel,
  guthanTick,
  hud,
  karilModel,
  karilTick,
  killcount,
  tooltipHost,
  toragModel,
  toragTick,
  veracModel,
  veracTick,
} from './barrows-overlay.refs';
import { hideBarrowsTooltip, showBarrowsTooltip } from './barrows-overlay.state';
import { BarrowsTooltip } from './barrows-tooltip.component';

const timerHost1 = createRef('0024_barrows_overlay_timer_host1');

const timerHost2 = createRef('0024_barrows_overlay_timer_host2');

const timerHost9 = createRef('0024_barrows_overlay_timer_host9');

const timerHost10 = createRef('0024_barrows_overlay_timer_host10');

const timerHost11 = createRef('0024_barrows_overlay_timer_host11');

const timerHost12 = createRef('0024_barrows_overlay_timer_host12');

const timerHost13 = createRef('0024_barrows_overlay_timer_host13');

const timerHost14 = createRef('0024_barrows_overlay_timer_host14');

export function BarrowsOverlay_(): Component {
  useInterval(
    () =>
      barrowsOverlayTick(
        hud,
        brothers,
        killcount,
        ahrimModel,
        dharokModel,
        guthanModel,
        karilModel,
        toragModel,
        veracModel,
      ),
    timerHost1,
  );
  useInterval(
    () => overlayRelayout(timerHost2, content, BarrowsOverlay.DODGE, Anchor.CENTRE, Anchor.CENTRE, 0),
    timerHost2,
  );
  useInterval(() => modelTransparentInit(ahrimModel), ahrimModel);
  useInterval(() => modelTransparentInit(dharokModel), dharokModel);
  useInterval(() => modelTransparentInit(guthanModel), guthanModel);
  useInterval(() => modelTransparentInit(karilModel), karilModel);
  useInterval(() => modelTransparentInit(toragModel), toragModel);
  useInterval(() => modelTransparentInit(veracModel), veracModel);
  useInterval(() => barrowsBrother(timerHost9, ahrimTick, 0), timerHost9);
  useInterval(() => barrowsBrother(timerHost10, dharokTick, 1), timerHost10);
  useInterval(() => barrowsBrother(timerHost11, guthanTick, 2), timerHost11);
  useInterval(() => barrowsBrother(timerHost12, karilTick, 3), timerHost12);
  useInterval(() => barrowsBrother(timerHost13, toragTick, 4), timerHost13);
  useInterval(() => barrowsBrother(timerHost14, veracTick, 5), timerHost14);

  return (
    <layer w="fill" h="fill" ref={timerHost1}>
      <layer x="center" y="center" w="fill" h="fill" ref={timerHost2}>
        <layer ref={content} w="fill" h="fill">
          <layer ref={hud} w="fill" h="fill">
            <model
              ref={ahrimModel}
              x={AHRIM_X}
              y={AHRIM_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              model={BarrowsModel.AHRIM}
              zoom={Layout.MODEL_ZOOM}
            />
            <model
              ref={dharokModel}
              x={DHAROK_X}
              y={{ bottom: DHAROK_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
            />
            <model
              ref={guthanModel}
              x={{ right: GUTHAN_X }}
              y={GUTHAN_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
            />
            <model
              ref={karilModel}
              x={{ right: KARIL_X }}
              y={{ bottom: KARIL_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
            />
            <model
              ref={toragModel}
              x={{ right: TORAG_X }}
              y={TORAG_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
            />
            <model
              ref={veracModel}
              x={VERAC_X}
              y={{ bottom: VERAC_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
            />
          </layer>

          <layer
            ref={brothers}
            x={{ right: Layout.BROTHERS_X }}
            y={{ bottom: Layout.BROTHERS_Y }}
            w={Layout.BROTHERS_W}
            h={Layout.BROTHERS_H}
          >
            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={AHRIM}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost9}
            />
            <sprite ref={ahrimTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={DHAROK}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost10}
            />
            <sprite ref={dharokTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={GUTHAN}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost11}
            />
            <sprite ref={guthanTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={KARIL}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost12}
            />
            <sprite ref={karilTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={TORAG}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost13}
            />
            <sprite ref={toragTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={VERAC}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              ref={timerHost14}
            />
            <sprite ref={veracTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />
          </layer>

          <text
            ref={killcount}
            x={{ right: Layout.KILLCOUNT_X }}
            y={{ bottom: Layout.KILLCOUNT_Y }}
            w={Layout.KILLCOUNT_W}
            h={Layout.KILLCOUNT_H}
            font={BarrowsFonts.LABEL}
            align="right"
            valign="top"
            shadow
            color={BarrowsColor.REST}
            onMouseRepeat={() => showBarrowsTooltip()}
            onMouseLeave={() => hideBarrowsTooltip()}
          />
        </layer>
      </layer>

      <layer ref={tooltipHost} x={0} y={0} w="fill" h="fill">
        <BarrowsTooltip />
      </layer>
    </layer>
  );
}
