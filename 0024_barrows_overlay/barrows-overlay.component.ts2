import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  AHRIM,
  AHRIM_X,
  AHRIM_Y,
  BarrowsColor,
  BarrowsFonts,
  BarrowsModel,
  BarrowsOverlay,
  BarrowsSprites,
  DHAROK,
  DHAROK_X,
  DHAROK_Y,
  GUTHAN,
  GUTHAN_X,
  GUTHAN_Y,
  KARIL,
  KARIL_X,
  KARIL_Y,
  Layout,
  TORAG,
  TORAG_X,
  TORAG_Y,
  VERAC,
  VERAC_X,
  VERAC_Y,
} from './barrows-overlay.constants';
import { barrowsBrother, barrowsOverlayTick, modelTransparentInit } from './barrows-overlay.helpers';
import {
  ahrimModel,
  ahrimTick,
  brothers,
  content,
  dharokModel,
  dharokTick,
  guthanModel,
  guthanTick,
  hud,
  karilModel,
  karilTick,
  killcount,
  tooltipHost,
  toragModel,
  toragTick,
  veracModel,
  veracTick,
} from './barrows-overlay.refs';
import { hideBarrowsTooltip, showBarrowsTooltip } from './barrows-overlay.state';
import { BarrowsTooltip } from './barrows-tooltip.component';

export function BarrowsOverlay_(): Component {
  return (
    <layer
      w="fill"
      h="fill"
      onTimer={() =>
        barrowsOverlayTick(
          hud,
          brothers,
          killcount,
          ahrimModel,
          dharokModel,
          guthanModel,
          karilModel,
          toragModel,
          veracModel,
        )
      }
    >
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, BarrowsOverlay.DODGE, Anchor.CENTRE, Anchor.CENTRE, 0)
        }
      >
        <layer ref={content} w="fill" h="fill">
          <layer ref={hud} w="fill" h="fill">
            <model
              ref={ahrimModel}
              x={AHRIM_X}
              y={AHRIM_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              model={BarrowsModel.AHRIM}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
            <model
              ref={dharokModel}
              x={DHAROK_X}
              y={{ bottom: DHAROK_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
            <model
              ref={guthanModel}
              x={{ right: GUTHAN_X }}
              y={GUTHAN_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
            <model
              ref={karilModel}
              x={{ right: KARIL_X }}
              y={{ bottom: KARIL_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
            <model
              ref={toragModel}
              x={{ right: TORAG_X }}
              y={TORAG_Y}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
            <model
              ref={veracModel}
              x={VERAC_X}
              y={{ bottom: VERAC_Y }}
              w={Layout.MODEL}
              h={Layout.MODEL}
              zoom={Layout.MODEL_ZOOM}
              onTimer={(event) => modelTransparentInit(event.component)}
            />
          </layer>

          <layer
            ref={brothers}
            x={{ right: Layout.BROTHERS_X }}
            y={{ bottom: Layout.BROTHERS_Y }}
            w={Layout.BROTHERS_W}
            h={Layout.BROTHERS_H}
          >
            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={AHRIM}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, ahrimTick, 0)}
            />
            <sprite ref={ahrimTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={DHAROK}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, dharokTick, 1)}
            />
            <sprite ref={dharokTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={GUTHAN}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, guthanTick, 2)}
            />
            <sprite ref={guthanTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={KARIL}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, karilTick, 3)}
            />
            <sprite ref={karilTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={TORAG}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, toragTick, 4)}
            />
            <sprite ref={toragTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />

            <text
              w={{ fill: Layout.LABEL_INSET }}
              h={Layout.ROW_H}
              text={VERAC}
              font={BarrowsFonts.LABEL}
              align="left"
              valign="middle"
              shadow
              onTimer={(event) => barrowsBrother(event.component, veracTick, 5)}
            />
            <sprite ref={veracTick} w={Layout.TICK} h={Layout.TICK} sprite={BarrowsSprites.TICK} hide />
          </layer>

          <text
            ref={killcount}
            x={{ right: Layout.KILLCOUNT_X }}
            y={{ bottom: Layout.KILLCOUNT_Y }}
            w={Layout.KILLCOUNT_W}
            h={Layout.KILLCOUNT_H}
            font={BarrowsFonts.LABEL}
            align="right"
            valign="top"
            shadow
            color={BarrowsColor.REST}
            onMouseRepeat={() => showBarrowsTooltip()}
            onMouseLeave={() => hideBarrowsTooltip()}
          />
        </layer>
      </layer>

      <layer ref={tooltipHost} x={0} y={0} w="fill" h="fill">
        <BarrowsTooltip />
      </layer>
    </layer>
  );
}
