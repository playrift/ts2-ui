import { CS2, createRef, useDerived, useServerState } from 'ts2';

import { hasBit } from '../lib/lib.engine';
import { toplevelComponents } from '../lib/lib.helpers';
import { Anchor, mobileGameframe, overlayInit } from '../lib/lib.overlay';
import {
  AHRIM,
  AHRIM_X,
  AHRIM_Y,
  BarrowsFonts,
  BarrowsModel,
  BarrowsOverlay,
  BarrowsSprites,
  BarrowsVarbits,
  BarrowsVarps,
  DHAROK,
  DHAROK_X,
  DHAROK_Y,
  GUTHAN,
  GUTHAN_X,
  GUTHAN_Y,
  KARIL,
  KARIL_X,
  KARIL_Y,
  Layout,
  TORAG,
  TORAG_X,
  TORAG_Y,
  VERAC,
  VERAC_X,
  VERAC_Y,
} from './barrows-overlay.constants';
import {
  barrowsColour,
  barrowsZone,
  barrowsZoom,
  brothersOffset,
  brothersTop,
  gameframeInset,
  killcountRight,
  killcountTop,
  laidOut,
  rewardText,
  widestBrotherName,
  Zone,
} from './barrows-overlay.helpers';
import { content, tooltipHost } from './barrows-overlay.refs';
import { hideBarrowsTooltip, showBarrowsTooltip } from './barrows-overlay.state';
import { BarrowsTooltip } from './barrows-tooltip.component';

const timerHost2 = createRef('0024_barrows_overlay_timer_host2');

export function BarrowsOverlay_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        ref={timerHost2}
        onLoad={() => overlayInit(timerHost2, content, BarrowsOverlay.DODGE, Anchor.CENTRE, Anchor.CENTRE, 0)}
      >
        <layer ref={content} w="fill" h="fill">
          <BarrowsPlate />
        </layer>
      </layer>

      <layer ref={tooltipHost} x={0} y={0} w="fill" h="fill">
        <BarrowsTooltip />
      </layer>
    </layer>
  );
}

function heightOf(component: ComponentId): Int {
  return CS2.if_height_get(component);
}

function BarrowsPlate(): Component {
  const frame: Int = useDerived(() => toplevelComponents());
  const zone: Int = useDerived(() => barrowsZone());
  const kills: Int = useServerState(BarrowsVarps.KILLS);
  const minimapClosed: Int = useServerState(BarrowsVarbits.MINIMAP_TOGGLE);
  const gravestone: Int = useServerState(BarrowsVarbits.GRAVESTONE_DURATION);
  const brothersKilled: Int =
    useServerState(BarrowsVarbits.KILLED_AHRIM) +
    useServerState(BarrowsVarbits.KILLED_DHAROK) +
    useServerState(BarrowsVarbits.KILLED_GUTHAN) +
    useServerState(BarrowsVarbits.KILLED_KARIL) +
    useServerState(BarrowsVarbits.KILLED_TORAG) +
    useServerState(BarrowsVarbits.KILLED_VERAC);
  const monstersKilled: Int = useServerState(BarrowsVarbits.KILLED_MONSTER);

  const placed: Boolean = laidOut(frame);
  const framed: Boolean = gameframeInset(frame) > 0;
  const mobile: Boolean = mobileGameframe(frame);

  const hudHidden: Boolean = placed && zone !== Zone.TUNNELS;
  const listHidden: Boolean = placed && zone === Zone.AWAY;

  const colour: Int = barrowsColour(frame);
  const labelColour: Int = placed ? colour : 0;
  const labelRight: Boolean = placed && !framed;
  const tickRight: Boolean = placed && framed;
  const rowStep: Int = placed ? Layout.ROW_H : 0;

  const zoom: Int = placed ? barrowsZoom(heightOf(content)) : Layout.MODEL_ZOOM;

  const kRight: Int = killcountRight(frame, minimapClosed);
  const kTop: Int = killcountTop(frame);
  const bOffset: Int = brothersOffset(frame, minimapClosed);
  const bTop: Int = brothersTop(frame);

  return (
    <>
      <layer w="fill" h="fill" hide={hudHidden}>
        <model
          x={AHRIM_X}
          y={AHRIM_Y}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={BarrowsModel.AHRIM}
          zoom={zoom}
          transparent
          hide={placed}
        />
        <model
          x={DHAROK_X}
          y={{ bottom: DHAROK_Y }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          zoom={zoom}
          transparent
          hide={placed}
        />
        <model
          x={{ right: GUTHAN_X }}
          y={GUTHAN_Y}
          w={Layout.MODEL}
          h={Layout.MODEL}
          zoom={zoom}
          transparent
          hide={placed}
        />
        <model
          x={{ right: KARIL_X }}
          y={{ bottom: KARIL_Y }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          zoom={zoom}
          transparent
          hide={placed}
        />
        <model
          x={{ right: TORAG_X }}
          y={TORAG_Y}
          w={Layout.MODEL}
          h={Layout.MODEL}
          zoom={zoom}
          transparent
          hide={placed}
        />
        <model
          x={VERAC_X}
          y={{ bottom: VERAC_Y }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          zoom={zoom}
          transparent
          hide={placed}
        />
      </layer>

      <layer
        x={framed ? (mobile ? { right: bOffset } : bOffset) : { right: Layout.BROTHERS_X }}
        y={framed ? bTop : { bottom: Layout.BROTHERS_Y }}
        w={widestBrotherName() + Layout.BROTHERS_PAD}
        h={Layout.BROTHERS_FITTED_H}
        hide={listHidden}
      >
        <text
          x={labelRight ? { right: 0 } : 0}
          y={0}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={AHRIM}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={0}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 0)}
        />

        <text
          x={labelRight ? { right: 0 } : 0}
          y={rowStep}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={DHAROK}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={rowStep}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 1)}
        />

        <text
          x={labelRight ? { right: 0 } : 0}
          y={rowStep * 2}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={GUTHAN}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={rowStep * 2}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 2)}
        />

        <text
          x={labelRight ? { right: 0 } : 0}
          y={rowStep * 3}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={KARIL}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={rowStep * 3}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 3)}
        />

        <text
          x={labelRight ? { right: 0 } : 0}
          y={rowStep * 4}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={TORAG}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={rowStep * 4}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 4)}
        />

        <text
          x={labelRight ? { right: 0 } : 0}
          y={rowStep * 5}
          w={{ fill: Layout.LABEL_INSET }}
          h={Layout.ROW_H}
          text={VERAC}
          font={BarrowsFonts.LABEL}
          color={labelColour}
          align="left"
          valign="middle"
          shadow
        />
        <sprite
          x={tickRight ? { right: 0 } : 0}
          y={rowStep * 5}
          w={Layout.TICK}
          h={Layout.TICK}
          sprite={BarrowsSprites.TICK}
          hide={!hasBit(kills, 5)}
        />
      </layer>

      <text
        x={{ right: kRight }}
        y={framed ? kTop : { bottom: Layout.KILLCOUNT_Y }}
        w={Layout.KILLCOUNT_W}
        h={Layout.KILLCOUNT_H}
        font={BarrowsFonts.LABEL}
        align="right"
        valign="top"
        shadow
        color={colour}
        text={rewardText(gravestone, frame, brothersKilled, monstersKilled)}
        hide={listHidden}
        onMouseRepeat={() => showBarrowsTooltip()}
        onMouseLeave={() => hideBarrowsTooltip()}
      />
    </>
  );
}
