import { CS2 } from 'ts2';

import { OverlayInsetRight } from '../lib/lib.overlay.data';
import { ToplevelComponents } from '../lib/lib.constants';
import { playerCoord, textWidth } from '../lib/lib.engine';
import { coordInBox } from '../lib/lib.helpers';
import { mobileGameframe } from '../lib/lib.overlay';
import {
  AHRIM,
  BarrowsColor,
  BarrowsFonts,
  Crypt,
  DHAROK,
  Framed,
  GUTHAN,
  KARIL,
  Layout,
  REWARD_MAX,
  TORAG,
  VERAC,
  Zoom,
} from './barrows-overlay.constants';

function nameWidth(name: String): Int {
  return textWidth(name, Layout.NAME_WRAP, BarrowsFonts.LABEL);
}

export function widestBrotherName(): Int {
  let widest: Int = nameWidth(AHRIM);
  let next: Int = nameWidth(DHAROK);
  if (next > widest) {
    widest = next;
  }
  next = nameWidth(GUTHAN);
  if (next > widest) {
    widest = next;
  }
  next = nameWidth(KARIL);
  if (next > widest) {
    widest = next;
  }
  next = nameWidth(TORAG);
  if (next > widest) {
    widest = next;
  }
  next = nameWidth(VERAC);
  if (next > widest) {
    widest = next;
  }
  return widest;
}

export function gameframeInset(frame: Int): Int {
  return OverlayInsetRight.get(frame) ?? 0;
}

export enum Zone {
  TUNNELS = 0,
  MOUNDS = 1,
  AWAY = 2,
}

export function barrowsZone(): Int {
  if (
    coordInBox(
      tileOf(Crypt.TUNNEL_MIN_X, Crypt.TUNNEL_MIN_Z, Crypt.TUNNEL_MIN_PLANE),
      tileOf(Crypt.TUNNEL_MAX_X, Crypt.TUNNEL_MAX_Z, Crypt.TUNNEL_MAX_PLANE),
      playerCoord(),
    )
  ) {
    return Zone.TUNNELS;
  }
  if (
    coordInBox(
      tileOf(Crypt.MOUNDS_MIN_X, Crypt.MOUNDS_MIN_Z, Crypt.PLANE),
      tileOf(Crypt.MOUNDS_MAX_X, Crypt.MOUNDS_MAX_Z, Crypt.PLANE),
      playerCoord(),
    )
  ) {
    return Zone.MOUNDS;
  }
  return Zone.AWAY;
}

export function killcountRight(frame: Int, minimapClosed: Int): Int {
  if (gameframeInset(frame) <= 0) {
    return Layout.KILLCOUNT_X;
  }
  if (mobileGameframe(frame)) {
    return minimapClosed === 0 ? Framed.MOBILE_KILLCOUNT_RIGHT_OPEN : Framed.MOBILE_KILLCOUNT_RIGHT_CLOSED;
  }
  return Framed.KILLCOUNT_RIGHT;
}

export function killcountTop(frame: Int): Int {
  return mobileGameframe(frame) ? Framed.MOBILE_KILLCOUNT_TOP : Framed.KILLCOUNT_TOP;
}

export function brothersOffset(frame: Int, minimapClosed: Int): Int {
  if (mobileGameframe(frame)) {
    return minimapClosed === 0 ? Framed.MOBILE_BROTHERS_OPEN : Framed.MOBILE_BROTHERS_CLOSED;
  }
  return Framed.BROTHERS_LEFT;
}

export function brothersTop(frame: Int): Int {
  return mobileGameframe(frame) ? Framed.MOBILE_BROTHERS_TOP : Framed.BROTHERS_TOP;
}

export function barrowsColour(frame: Int): Int {
  return gameframeInset(frame) > 0 ? BarrowsColor.FRAMED : BarrowsColor.REST;
}

export function barrowsZoom(height: Int): Int {
  let clamped: Int = height;
  if (clamped < Zoom.MIN_HEIGHT) {
    clamped = Zoom.MIN_HEIGHT;
  } else if (clamped > Zoom.MAX_HEIGHT) {
    clamped = Zoom.MAX_HEIGHT;
  }
  return (
    Zoom.BASE -
    CS2.interpolate(
      0,
      Math.sqrt(clamped - Zoom.MIN_HEIGHT),
      0,
      Math.sqrt(Zoom.MAX_HEIGHT - Zoom.MIN_HEIGHT),
      Zoom.RANGE,
    )
  );
}

export function rewardText(gravestone: Int, frame: Int, brothersKilled: Int, monstersKilled: Int): string {
  if (gravestone > 0 && gameframeInset(frame) <= 0) {
    return '';
  }
  const score: Int = monstersKilled + brothersKilled * 2;
  return `Rewards potential: ${stringOf(CS2.interpolate(0, 100, 0, REWARD_MAX, score))}%`;
}

export function killcountX(frame: Int, minimapClosed: Int, contentWidth: Int): Int {
  return contentWidth - Layout.KILLCOUNT_W - killcountRight(frame, minimapClosed);
}

export function killcountY(frame: Int, contentHeight: Int): Int {
  if (gameframeInset(frame) > 0) {
    return killcountTop(frame);
  }
  return contentHeight - Layout.KILLCOUNT_H - Layout.KILLCOUNT_Y;
}

export function laidOut(frame: Int): Boolean {
  return frame !== ToplevelComponents.NONE;
}
