import { useState } from 'ts2';

import { tooltipBuilt, tooltipTime } from '../lib/game/varcs';
import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { Tip, Tooltip } from './barrows-overlay.constants';

function dwellElapsed(): Boolean {
  const [until, setUntil] = useState(tooltipTime);
  if (until < clientClock() + Tooltip.DWELL) {
    if (until < clientClock()) {
      setUntil(clientClock() + 2);
    } else {
      setUntil(until + 2);
    }
    return false;
  }
  setUntil(clientClock() + Tooltip.DWELL + 10);
  return true;
}

export function showBarrowsTooltip(): void {
  const [built, setTip] = useState(tooltipBuilt);
  if (onMobile()) {
    return;
  }
  if (!dwellElapsed()) {
    return;
  }
  if (built === Tip.NONE) {
    setTip(Tip.REWARDS);
  }
}

export function hideBarrowsTooltip(): void {
  const [, setTip] = useState(tooltipBuilt);
  setTip(Tip.NONE);
}
