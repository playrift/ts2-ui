import { CS2, useServerState, useState, useUniverse } from 'ts2';

import { tooltipBuilt } from '../lib/game/varcs';
import { textLineCount, textWidth } from '../lib/lib.engine';
import { toplevelComponents } from '../lib/lib.helpers';
import {
  BarrowsFonts,
  BarrowsVarbits,
  Layout,
  Tip,
  Tooltip,
  TOOLTIP_TEXT,
  TooltipColor,
} from './barrows-overlay.constants';
import { killcountX, killcountY } from './barrows-overlay.helpers';
import { content } from './barrows-overlay.refs';

function widthOf(component: ComponentId): Int {
  return CS2.if_width_get(component);
}

function heightOf(component: ComponentId): Int {
  return CS2.if_height_get(component);
}

export function BarrowsTooltip(): Component {
  const [tip] = useState(tooltipBuilt);
  if (tip < Tip.REWARDS) {
    return null;
  }

  const parent = useUniverse();
  const wrap: Int = Math.min(Tooltip.WRAP, parent.width) - Tooltip.PAD;
  const boxW: Int = Tooltip.PAD + textWidth(TOOLTIP_TEXT, wrap, BarrowsFonts.LABEL);
  const boxH: Int = Tooltip.PAD + Tooltip.LINE * textLineCount(TOOLTIP_TEXT, wrap, BarrowsFonts.LABEL);

  const frame: Int = toplevelComponents();
  const minimapClosed: Int = useServerState(BarrowsVarbits.MINIMAP_TOGGLE);
  const anchorX: Int = killcountX(frame, minimapClosed, widthOf(content));
  const anchorY: Int = killcountY(frame, heightOf(content));
  const below: Int = anchorY + Layout.KILLCOUNT_H + Tooltip.GAP;

  return (
    <layer
      x={Math.min(anchorX + Tooltip.GAP, parent.width - boxW)}
      y={below > parent.height - boxH ? anchorY - boxH - Tooltip.GAP : below}
      w={boxW}
      h={boxH}
    >
      <rect x="center" y="center" w="fill" h="fill" color={TooltipColor.FILL} fill />
      <rect x="center" y="center" w="fill" h="fill" color={TooltipColor.INK} />
      <text
        x="center"
        y="center"
        w={{ fill: Tooltip.PAD }}
        h="fill"
        text={TOOLTIP_TEXT}
        align="left"
        valign="middle"
        font={BarrowsFonts.LABEL}
        color={TooltipColor.INK}
      />
    </layer>
  );
}
