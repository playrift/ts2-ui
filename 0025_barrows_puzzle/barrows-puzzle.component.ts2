import { useRef } from 'ts2';

import { opsound } from '../lib/lib.helpers';
import { GLOW_RINGS, PuzzleColors, PuzzleFonts, PuzzleGlow, PuzzleModels } from './barrows-puzzle.constants';

export function BarrowsPuzzle(): Component {
  const highlightLeft = useRef();
  const highlightMiddle = useRef();
  const highlightRight = useRef();

  return (
    <layer x="center" y="center" w={512} h={334}>
      <layer x="center" y="center" w="fill" h="fill">
        {GLOW_RINGS.map((ring) => (
          <rect
            x="center"
            y="center"
            w={{ fill: ring * PuzzleGlow.RING_GAP }}
            h={{ fill: ring * PuzzleGlow.RING_GAP }}
            color={PuzzleColors.GLOW}
            fill={false}
            transparency={PuzzleGlow.BASE + (7 - ring) * PuzzleGlow.FADE_STEP}
          />
        ))}
        <rect
          x="center"
          y="center"
          w={{ fill: PuzzleGlow.PLATE_INSET }}
          h={{ fill: PuzzleGlow.PLATE_INSET }}
          color={PuzzleColors.GLOW}
          fill
          transparency={PuzzleGlow.BASE}
        />
      </layer>

      <layer x="center" y={66} w={355} h={93}>
        <model x={0} y="center" w={93} h={93} zoom={500} pitch={512} />
        <text x={0} y={0} w={93} h="fill" text="1." font={PuzzleFonts.LABEL} color={PuzzleColors.LABEL} shadow />
        <model x={93} y="center" w={93} h={93} zoom={500} pitch={512} />
        <text x={93} y={0} w={93} h="fill" text="2." font={PuzzleFonts.LABEL} color={PuzzleColors.LABEL} shadow />
        <model x={186} y="center" w={93} h={93} zoom={500} pitch={512} />
        <text x={186} y={0} w={93} h="fill" text="3." font={PuzzleFonts.LABEL} color={PuzzleColors.LABEL} shadow />
        <model
          right={0}
          y="center"
          w={76}
          h={93}
          model={PuzzleModels.UNKNOWN_SHAPE}
          zoom={1299}
          pitch={524}
          yaw={19}
          offsetY={20}
        />
        <text x={279} y={0} w={76} h="fill" text="4." font={PuzzleFonts.LABEL} color={PuzzleColors.LABEL} shadow />
      </layer>

      <text
        x="center"
        y={{ center: 25 }}
        w="fill"
        h={25}
        text="Which is the next shape in the above sequence?"
        font={PuzzleFonts.LABEL}
        color={PuzzleColors.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer
        x={70}
        bottom={25}
        w={95}
        h={95}
        options={['Select']}
        onOptionSelect={(event) => {
          opsound(event.option, 2);
        }}
        onMouseOver={() => {
          highlightLeft.hide = false;
        }}
        onMouseLeave={() => {
          highlightLeft.hide = true;
        }}
      >
        <model x="center" y="center" w={93} h={93} zoom={500} pitch={512} />
        <rect
          ref={highlightLeft}
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={PuzzleColors.GLOW}
          fill={false}
          transparency={PuzzleGlow.BASE}
          hide
        />
      </layer>

      <layer
        x="center"
        bottom={25}
        w={95}
        h={95}
        options={['Select']}
        onOptionSelect={(event) => {
          opsound(event.option, 2);
        }}
        onMouseOver={() => {
          highlightMiddle.hide = false;
        }}
        onMouseLeave={() => {
          highlightMiddle.hide = true;
        }}
      >
        <model x="center" y="center" w={93} h={93} zoom={500} pitch={512} />
        <rect
          ref={highlightMiddle}
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={PuzzleColors.GLOW}
          fill={false}
          transparency={PuzzleGlow.BASE}
          hide
        />
      </layer>

      <layer
        right={70}
        bottom={25}
        w={95}
        h={95}
        options={['Select']}
        onOptionSelect={(event) => {
          opsound(event.option, 2);
        }}
        onMouseOver={() => {
          highlightRight.hide = false;
        }}
        onMouseLeave={() => {
          highlightRight.hide = true;
        }}
      >
        <model x="center" y="center" w={93} h={93} zoom={500} pitch={512} />
        <rect
          ref={highlightRight}
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={PuzzleColors.GLOW}
          fill={false}
          transparency={PuzzleGlow.BASE}
          hide
        />
      </layer>
    </layer>
  );
}
