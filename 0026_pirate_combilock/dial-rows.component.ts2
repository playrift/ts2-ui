import { createRef, useInterval, useServerState } from 'ts2';

import { spinner } from '../0850_pog_spirit_tree_alone/pog-spirit-tree-alone.helpers';
import { Layout, PirateVarbits } from './pirate-combilock.constants';
import { dialFace, spinStep } from './pirate-combilock.helpers';

const timerHost1 = createRef('0026_pirate_combilock_timer_host1');

const timerHost2 = createRef('0026_pirate_combilock_timer_host2');

const timerHost3 = createRef('0026_pirate_combilock_timer_host3');

const timerHost4 = createRef('0026_pirate_combilock_timer_host4');

const timerHost5 = createRef('0026_pirate_combilock_timer_host5');

const timerHost6 = createRef('0026_pirate_combilock_timer_host6');

const timerHost7 = createRef('0026_pirate_combilock_timer_host7');

const timerHost8 = createRef('0026_pirate_combilock_timer_host8');

const timerHost9 = createRef('0026_pirate_combilock_timer_host9');

export function DialTopRow(): Component {
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost1), timerHost1);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost2), timerHost2);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost3), timerHost3);

  const left: Int = useServerState(PirateVarbits.LEFT);
  const centre: Int = useServerState(PirateVarbits.CENTRE);
  const right: Int = useServerState(PirateVarbits.RIGHT);
  return (
    <>
      <model
        x={64}
        y={60}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((left + 3) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_TOP}
        ref={timerHost1}
      />
      <model
        x={151}
        y={60}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((centre + 3) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_TOP}
        ref={timerHost2}
      />
      <model
        x={238}
        y={60}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((right + 3) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_TOP}
        ref={timerHost3}
      />
    </>
  );
}

export function DialMiddleRow(): Component {
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost4), timerHost4);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost5), timerHost5);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost6), timerHost6);

  const left: Int = useServerState(PirateVarbits.LEFT);
  const centre: Int = useServerState(PirateVarbits.CENTRE);
  const right: Int = useServerState(PirateVarbits.RIGHT);
  return (
    <>
      <model
        x={60}
        y={143}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace(left)}
        zoom={Layout.DIAL_ZOOM}
        ref={timerHost4}
      />
      <model
        x={151}
        y={143}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace(centre)}
        zoom={Layout.DIAL_ZOOM}
        ref={timerHost5}
      />
      <model
        x={242}
        y={143}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace(right)}
        zoom={Layout.DIAL_ZOOM}
        ref={timerHost6}
      />
    </>
  );
}

export function DialBottomRow(): Component {
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost7), timerHost7);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost8), timerHost8);
  useInterval(() => spinner(spinStep(), spinStep(), 0, timerHost9), timerHost9);

  const left: Int = useServerState(PirateVarbits.LEFT);
  const centre: Int = useServerState(PirateVarbits.CENTRE);
  const right: Int = useServerState(PirateVarbits.RIGHT);
  return (
    <>
      <model
        x={64}
        y={229}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((left + 1) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_BOTTOM}
        ref={timerHost7}
      />
      <model
        x={150}
        y={230}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((centre + 1) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_BOTTOM}
        ref={timerHost8}
      />
      <model
        x={239}
        y={230}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={dialFace((right + 1) % 4)}
        zoom={Layout.DIAL_ZOOM}
        pitch={Layout.DIAL_PITCH_BOTTOM}
        ref={timerHost9}
      />
    </>
  );
}
