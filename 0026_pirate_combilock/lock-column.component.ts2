import { predictServerState, useRef, useServerState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import {
  ColumnSubjects,
  Layout,
  PirateColors,
  PirateModels,
  PirateSounds,
  PirateVarbits,
} from './pirate-combilock.constants';

export function LeftColumn(): Component {
  const step: Int = useServerState(PirateVarbits.LEFT);
  const arrows = useRef();
  const desktop: Boolean = onMobile() ? false : true;
  return (
    <>
      <model
        ref={arrows}
        x={60}
        y={139}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={PirateModels.ARROWS}
        zoom={Layout.CHEST_ZOOM}
      />
      <rect
        x={47}
        y={3}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        fill
        color={PirateColors.HIT_BOX}
        transparency={Layout.HIT_OPACITY}
        options={['Rotate']}
        optionSubject={ColumnSubjects.LEFT}
        onOptionSelect={(event) => {
          if (event.option === 1) {
            playSound(PirateSounds.TURN);
            predictServerState(PirateVarbits.LEFT, (step + 1) % 4);
          }
        }}
        onMouseEnter={
          desktop
            ? () => {
                arrows.model = PirateModels.ARROWS_HOVER;
              }
            : undefined
        }
        onMouseLeave={
          desktop
            ? () => {
                arrows.model = PirateModels.ARROWS;
              }
            : undefined
        }
      />
      <rect
        x={46}
        y={289}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        fill
        color={PirateColors.HIT_BOX}
        transparency={Layout.HIT_OPACITY}
        options={['Rotate']}
        optionSubject={ColumnSubjects.LEFT}
        onOptionSelect={(event) => {
          if (event.option === 1) {
            playSound(PirateSounds.TURN);
            predictServerState(PirateVarbits.LEFT, (step + 3) % 4);
          }
        }}
        onMouseEnter={
          desktop
            ? () => {
                arrows.model = PirateModels.ARROWS_HOVER;
              }
            : undefined
        }
        onMouseLeave={
          desktop
            ? () => {
                arrows.model = PirateModels.ARROWS;
              }
            : undefined
        }
      />
    </>
  );
}

