import { CS2 } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { Layout, PirateSounds } from './pirate-combilock.constants';
import { DialFaces } from './dial-faces.data';

export function dialFace(position: Int): Model {
  return DialFaces.at(position) ?? DialFaces.at(0);
}

export function unlockChime(option: Int): void {
  if (option === 1) {
    playSound(PirateSounds.UNLOCK);
  }
}

export function spinStep(): Int {
  return Layout.SPIN_BASE + CS2.randominc(Layout.SPIN_SPREAD);
}
