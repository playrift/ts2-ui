import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { Layout, PirateColors } from './pirate-combilock.constants';
import { unlockChime } from './pirate-combilock.helpers';

export function UnlockPlate(): Component {
  const desktop: Boolean = onMobile() ? false : true;
  return (
    <rect
      x={Layout.UNLOCK_X}
      y={Layout.UNLOCK_Y}
      w={Layout.UNLOCK_W}
      h={Layout.UNLOCK_H}
      fill
      color={PirateColors.HIT_BOX}
      transparency={Layout.UNLOCK_REST_OPACITY}
      options={['Unlock']}
      onOptionSelect={(event) => unlockChime(event.option)}
      onMouseEnter={desktop ? (event) => setTransparency(event.component, Layout.UNLOCK_HOVER_OPACITY) : undefined}
      onMouseLeave={desktop ? (event) => setTransparency(event.component, Layout.UNLOCK_REST_OPACITY) : undefined}
    />
  );
}
