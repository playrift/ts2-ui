import { useRef, useState } from 'ts2';

import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { clientClock, playSound } from '../lib/lib.engine';
import { HIGHLIGHT_COLOR, Highlight, PRESS_CYCLES, PillorySounds, SELECT_OP } from './pillory.constants';

export function PilloryButton(): Component {
  const highlight = useRef();

  const [pressedUntil, setPressedUntil] = useState(0);

  return (
    <layer
      w="fill"
      h="fill"
      options={['Select']}
      onMouseRepeat={() => {
        if (pressedUntil === 0) {
          ccSetTrans(highlight, Highlight.HOVER);
        }
      }}
      onMouseLeave={() => {
        if (pressedUntil === 0) {
          ccSetTrans(highlight, Highlight.IDLE);
        }
      }}
      onOptionSelect={(event) => {
        if (event.option !== SELECT_OP) {
          return;
        }
        playSound(PillorySounds.CLICK);
        highlight.transparency = Highlight.PRESSED;
        setPressedUntil(clientClock() + PRESS_CYCLES);
      }}
      onTimer={() => {
        if (pressedUntil !== 0 && clientClock() >= pressedUntil) {
          highlight.transparency = Highlight.IDLE;
          setPressedUntil(0);
        }
      }}
    >
      <rect
        ref={highlight}
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={HIGHLIGHT_COLOR}
        transparency={Highlight.IDLE}
      />
    </layer>
  );
}
