import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, PillorySprites } from './pillory.constants';

export function PilloryCloseButton(): Component {
  return (
    <sprite
      x={{ right: Layout.close.right }}
      y={Layout.close.y}
      w={Layout.close.w}
      h={Layout.close.h}
      sprite={PillorySprites.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={(event) => graphicSwapperUnlessMobile(event.self, PillorySprites.CLOSE_HOVER)}
      onMouseLeave={(event) => graphicSwapperUnlessMobile(event.self, PillorySprites.CLOSE)}
    />
  );
}
