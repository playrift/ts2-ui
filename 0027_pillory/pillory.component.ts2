import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { PilloryButton } from './pillory-button.component';
import { PilloryCloseButton } from './pillory-close-button.component';
import {
  BACKDROP_COLOR,
  BACKDROP_TRANSPARENCY,
  BUTTONS,
  FLASHES,
  FLASH_ROW,
  Layout,
  LOCKS,
  LOCK_ROW,
  PilloryAnims,
  PilloryModels,
} from './pillory.constants';

export function Pillory(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={BACKDROP_COLOR} transparency={BACKDROP_TRANSPARENCY} />

      <model x={115} y={191} w={32} h={33} model={PilloryModels.MODEL_9748} zoom={415} yaw={5} offsetY={-2} />

      <model x={95} y={98} w={32} h={32} model={PilloryModels.MODEL_13394} zoom={358} pitch={528} />

      {BUTTONS.map((button) => (
        <model
          x={button.keyX}
          y={Layout.key.y}
          w={Layout.key.w}
          h={Layout.key.h}
          model={button.key}
          anim={PilloryAnims.KEY}
          zoom={Layout.key.zoom}
          pitch={Layout.key.pitch}
        />
      ))}

      {BUTTONS.map((button) => (
        <layer x={button.x} y={Layout.button.y} w={Layout.button.w} h={Layout.button.h}>
          <PilloryButton />
        </layer>
      ))}

      {LOCKS.map((lock) => (
        <model
          x={lock.x}
          y={LOCK_ROW.y}
          w={lock.w}
          h={lock.h}
          model={PilloryModels.LOCK}
          anim={PilloryAnims.LOCK}
          zoom={LOCK_ROW.zoom}
          pitch={LOCK_ROW.pitch}
          yaw={LOCK_ROW.yaw}
        />
      ))}

      {FLASHES.map((flash) => (
        <model
          x={flash.x}
          y={flash.y}
          w={FLASH_ROW.w}
          h={FLASH_ROW.h}
          model={PilloryModels.FLASH}
          anim={PilloryAnims.FLASH}
          zoom={FLASH_ROW.zoom}
          pitch={FLASH_ROW.pitch}
        />
      ))}

      <PilloryCloseButton />

      <ThinBoxEntrypoint />
    </>
  );
}
