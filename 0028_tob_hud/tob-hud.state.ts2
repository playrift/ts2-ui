import { CS2, useServerState, useSkill, useSkillBase, useState } from 'ts2';

import { inInstance } from '../0077_quickprayer/quickprayer.helpers';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { coordInBox, onMobile } from '../lib/lib.helpers';
import { playerCoord } from '../lib/lib.engine';
import { Varbits } from '../lib/game/varbits';
import {
  tobClientLastprogress,
  tobClientName0,
  tobClientName1,
  tobClientName2,
  tobClientName3,
  tobClientName4,
} from '../lib/game/varcs';
import { Health, Layout, LobbyZone, PartyStatus, Progress, TobHudDodge, WaveProgress } from './tob-hud.constants';

export declare const TobHudSkills: {
  readonly HITPOINTS: SkillRef<3>;
};

export enum Slot {
  S0 = 0,
  S1 = 1,
  S2 = 2,
  S3 = 3,
  S4 = 4,
}

export function inTobLobby(): Int {
  if (
    coordInBox(
      tileOf(LobbyZone.MIN_X, LobbyZone.MIN_Z, LobbyZone.MIN_PLANE),
      tileOf(LobbyZone.MAX_X, LobbyZone.MAX_Z, LobbyZone.MAX_PLANE),
      playerCoord(),
    )
  ) {
    return 1;
  }
  return 0;
}

export function inTobRaid(): Int {
  if (inInstance()) {
    return 1;
  }
  return 0;
}

export function slotHealth(slot: Slot): Int {
  switch (slot) {
    case Slot.S0:
      return useServerState(Varbits.TOB_CLIENT_P0);
    case Slot.S1:
      return useServerState(Varbits.TOB_CLIENT_P1);
    case Slot.S2:
      return useServerState(Varbits.TOB_CLIENT_P2);
    case Slot.S3:
      return useServerState(Varbits.TOB_CLIENT_P3);
    case Slot.S4:
      return useServerState(Varbits.TOB_CLIENT_P4);
  }
  return Health.EMPTY;
}

export function isMyself(slot: Slot): Boolean {
  if (slot === useServerState(Varbits.TOB_CLIENT_PARTYSLOT) - 1) {
    return true;
  }
  return false;
}

export function partyName(raw: String): String {
  if (raw.length <= 0) {
    return '-';
  }
  if (CS2.compare(raw, 'null') === 0) {
    return '-';
  }
  return raw;
}

export function name0(): String {
  const [n] = useState(tobClientName0);
  return n;
}
export function name1(): String {
  const [n] = useState(tobClientName1);
  return n;
}
export function name2(): String {
  const [n] = useState(tobClientName2);
  return n;
}
export function name3(): String {
  const [n] = useState(tobClientName3);
  return n;
}
export function name4(): String {
  const [n] = useState(tobClientName4);
  return n;
}

export function myOrbHeight(): Int {
  const current: Int = useSkill(TobHudSkills.HITPOINTS);
  let height: Int = Math.min(
    Layout.ORB,
    CS2.scale(current, Math.max(1, useSkillBase(TobHudSkills.HITPOINTS)), Layout.ORB),
  );
  if (current > 0) {
    height = Math.max(1, height);
  }
  return height;
}

export function waveTenths(): Int {
  return CS2.scale(
    useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_VAL),
    Math.max(useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_MAX), 1),
    Progress.PERCENT_SCALE,
  );
}

export function waveProportion(): Int {
  return CS2.scale(
    useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_VAL),
    Math.max(1, useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_MAX)),
    Progress.PROPORTION,
  );
}

export function wavePercentText(tenths: Int): String {
  return `${stringOf(tenths / 10)}.${stringOf(tenths % 10)}%`;
}

export function stepWaveProgress(target: Int): void {
  const [shown, setShown] = useState(tobClientLastprogress);
  if (shown === -1) {
    setShown(target);
    return;
  }
  if (shown < target) {
    setShown(shown + Math.max(1, CS2.scale(Progress.EASE_NUM, Progress.EASE_DEN, target - shown)));
    return;
  }
  if (shown > target) {
    setShown(shown - Math.max(1, CS2.scale(Progress.EASE_NUM, Progress.EASE_DEN, shown - target)));
  }
}

export function resetWaveProgress(): void {
  const [, setShown] = useState(tobClientLastprogress);
  setShown(-1);
}

function widthOf(component: ComponentId): Int {
  return CS2.if_width_get(component);
}

export function tobHudStatusTick(dodger: ComponentId, column: ComponentId): void {
  overlayRelayout(dodger, column, TobHudDodge.LEFT, Anchor.LEFT, Anchor.TOP, 1);
  if (inTobRaid() === 0) {
    return;
  }
  if (useServerState(Varbits.TOB_CLIENT_PARTYSTATUS) !== PartyStatus.READY) {
    return;
  }
  if (useServerState(Varbits.TOB_CLIENT_PARTYSLOT) === 0) {
    column.height = Layout.COLUMN_H_FULL;
    return;
  }
  column.height = Layout.COLUMN_H_SHORT;
}

export function tobHudMiddleTick(dodger: ComponentId, strip: ComponentId, hud: ComponentId): void {
  overlayRelayout(dodger, strip, TobHudDodge.MIDDLE, Anchor.CENTRE, Anchor.TOP, 0);
  if (inTobRaid() === 0) {
    return;
  }
  if (useServerState(Varbits.TOB_CLIENT_PARTYSTATUS) !== PartyStatus.READY) {
    return;
  }
  if (useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_TYPE) === WaveProgress.NONE) {
    return;
  }
  const hudWidth: Int = widthOf(hud);
  const share: Int = CS2.scale(Progress.SHARE_NUM, Progress.SHARE_DEN, hudWidth);
  let reserve: Int = Progress.RESERVE;
  if (onMobile()) {
    reserve = Progress.RESERVE_MOBILE;
  }
  if (share <= hudWidth - reserve) {
    strip.width = share;
    return;
  }
  strip.width = hudWidth - reserve;
}
