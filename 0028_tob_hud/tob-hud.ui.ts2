import { Layout, tobHudRef, tooltipHostRef } from './tob-hud.constants';
import { TobHudSafezone, TobHudScreenFlash } from './tob-hud.component';
import { TobHudTooltip } from './tob-hud-tooltip.component';

export const tobHudUi = (): UI => (
  <ui ref={tobHudRef} x="center" y="center">
    <TobHudScreenFlash />
    <TobHudSafezone />
    <TobHudTooltipAnchor />
  </ui>
);

function TobHudTooltipAnchor(): Component {
  return (
    <layer ref={tooltipHostRef} x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP}>
      <TobHudTooltip />
    </layer>
  );
}
