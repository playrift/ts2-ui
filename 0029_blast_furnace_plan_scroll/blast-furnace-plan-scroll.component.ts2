import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Labels,
  Layout,
  PlanAnim,
  PlanCamera,
  PlanColor,
  PlanFonts,
  PlanModel,
  PlanOverlay,
  Title,
} from './blast-furnace-plan-scroll.constants';

const contents = createRef('blast_furnace_plan_scroll_contents');

export function BlastFurnacePlanScroll(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, contents, PlanOverlay.DODGE, Anchor.LEFT, Anchor.TOP, 0)}
      >
        <layer ref={contents} x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <model
            x={219}
            y={136}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={PlanModel.MACHINERY}
            pitch={PlanCamera.PITCH}
            yaw={PlanCamera.YAW}
            zoom={PlanCamera.MACHINERY_ZOOM}
          />

          <model
            x={360}
            y={170}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={PlanModel.X_MARK}
            anim={PlanAnim.X_MARK}
            pitch={PlanCamera.PITCH}
            yaw={PlanCamera.YAW}
            zoom={PlanCamera.X_ZOOM}
          />

          <text
            x={Title.X}
            y={Title.Y}
            w={Title.W}
            h={Title.H}
            text={Title.TEXT}
            font={PlanFonts.TITLE}
            color={PlanColor.TITLE}
            align="center"
            valign="top"
          />

          {Labels.map((label) => (
            <text
              x={label.x}
              y={label.y}
              w={label.w}
              h={label.h}
              text={label.text}
              font={PlanFonts.LABEL}
              color={PlanColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          ))}

          <model
            x={301}
            y={114}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={PlanModel.X_MARK}
            anim={PlanAnim.X_MARK}
            pitch={PlanCamera.PITCH}
            yaw={PlanCamera.YAW}
            zoom={PlanCamera.X_ZOOM}
          />

          <model
            x={362}
            y={226}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={PlanModel.X_MARK}
            anim={PlanAnim.X_MARK}
            pitch={PlanCamera.PITCH}
            yaw={PlanCamera.YAW}
            zoom={PlanCamera.X_ZOOM}
          />

          <model
            x={258}
            y={263}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={PlanModel.X_MARK}
            anim={PlanAnim.X_MARK}
            pitch={PlanCamera.PITCH}
            yaw={PlanCamera.YAW}
            zoom={PlanCamera.X_ZOOM}
          />
        </layer>
      </layer>
    </layer>
  );
}
