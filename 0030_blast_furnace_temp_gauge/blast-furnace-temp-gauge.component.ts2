import {
  GaugeCamera,
  GaugeColor,
  GaugeFonts,
  GaugeModel,
  GaugeSprites,
  Layout,
  TITLE_TEXT,
} from './blast-furnace-temp-gauge.constants';

export function BlastFurnaceTempGauge(): Component {
  return (
    <>
      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={TITLE_TEXT}
        font={GaugeFonts.TITLE}
        color={GaugeColor.TITLE}
        shadow
        align="center"
        valign="top"
      />

      <model
        x={Layout.FUEL_X}
        y={Layout.FUEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={GaugeModel.FUEL_FLAG}
        zoom={GaugeCamera.FUEL_FLAG_ZOOM}
      />

      <model
        x={Layout.BROKEN_X}
        y={Layout.BROKEN_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={GaugeModel.BROKEN_FLAG}
        zoom={GaugeCamera.BROKEN_FLAG_ZOOM}
      />

      <model
        x={Layout.NEEDLE_X}
        y={Layout.NEEDLE_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={GaugeModel.NEEDLE}
        zoom={GaugeCamera.NEEDLE_ZOOM}
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={GaugeSprites.CLOSE} />

      <layer hide x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_W} h={Layout.HOVER_H}>
        <sprite
          x={Layout.HOVER_SPRITE_X}
          y={Layout.HOVER_SPRITE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={GaugeSprites.CLOSE_PRESSED}
        />
      </layer>
    </>
  );
}
