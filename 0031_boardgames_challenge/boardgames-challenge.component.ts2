import { useRef, useServerState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { FramedButton } from '../0032_boardgames_draughts/framed-button.component';
import {
  ChallengeArt,
  ChallengeColors,
  ChallengeFonts,
  ChallengeVarbits,
  HOVER_TRANSPARENCY,
} from './boardgames-challenge.constants';

export function showSelection(first: Ref, second: Ref, third: Ref, fourth: Ref, game: Int): void {
  first.sprite = ChallengeArt.UNSELECTED;
  second.sprite = ChallengeArt.UNSELECTED;
  third.sprite = ChallengeArt.UNSELECTED;
  fourth.sprite = ChallengeArt.UNSELECTED;
  if (game === 0) {
    first.sprite = ChallengeArt.SELECTED;
  }
  if (game === 1) {
    second.sprite = ChallengeArt.SELECTED;
  }
  if (game === 2) {
    third.sprite = ChallengeArt.SELECTED;
  }
  if (game === 3) {
    fourth.sprite = ChallengeArt.SELECTED;
  }
}

function fadeUnlessMobile(icon: Ref, transparency: Int): void {
  if (!onMobile()) {
    setTransparency(icon, transparency);
  }
}

export function BoardgamesChallenge(): Component {
  const game: Int = useServerState(ChallengeVarbits.GAME);

  const draughts = useRef();
  const runelink = useRef();
  const runesquares = useRef();
  const runeversi = useRef();

  return (
    <layer x="center" y="center" w={342} h={228} spellTarget>
      <SteelBorderEntrypoint title="Challenge: Select Game" />

      <layer x="center" y="center" w="fill" h="fill">
        <layer x={12} y={39} w={229} h={179}>
          <layer
            y={21}
            w="fill"
            h={35}
            options={['Select']}
            optionSubject="<col=ff9040>Draughts</col>"
            onOptionSelect={() => {
              showSelection(draughts, runelink, runesquares, runeversi, 0);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(draughts, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(draughts, 0);
            }}
          >
            <sprite
              ref={draughts}
              x={10}
              y="center"
              w={17}
              h={17}
              sprite={game === 0 ? ChallengeArt.SELECTED : ChallengeArt.UNSELECTED}
            />
            <text
              x={32}
              y="center"
              w={80}
              h={17}
              text="Draughts"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.HEADING}
            />
            <text
              x={117}
              y="center"
              w={107}
              h={17}
              text="9999 vs 9999"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.MUTED}
            />
          </layer>

          <layer
            y={62}
            w="fill"
            h={35}
            options={['Select']}
            optionSubject="<col=ff9040>Runelink</col>"
            onOptionSelect={() => {
              showSelection(draughts, runelink, runesquares, runeversi, 1);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(runelink, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(runelink, 0);
            }}
          >
            <sprite
              ref={runelink}
              x={10}
              y="center"
              w={17}
              h={17}
              sprite={game === 1 ? ChallengeArt.SELECTED : ChallengeArt.UNSELECTED}
            />
            <text
              x={32}
              y="center"
              w={80}
              h={17}
              text="Runelink"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.HEADING}
            />
            <text
              x={117}
              y="center"
              w={107}
              h={17}
              text="9999 vs 9999"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.MUTED}
            />
          </layer>

          <layer
            y={103}
            w="fill"
            h={35}
            options={['Select']}
            optionSubject="<col=ff9040>Runesquares</col>"
            onOptionSelect={() => {
              showSelection(draughts, runelink, runesquares, runeversi, 2);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(runesquares, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(runesquares, 0);
            }}
          >
            <sprite
              ref={runesquares}
              x={10}
              y="center"
              w={17}
              h={17}
              sprite={game === 2 ? ChallengeArt.SELECTED : ChallengeArt.UNSELECTED}
            />
            <text
              x={32}
              y="center"
              w={80}
              h={17}
              text="Runesquares"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.HEADING}
            />
            <text
              x={117}
              y="center"
              w={107}
              h={17}
              text="9999 vs 9999"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.MUTED}
            />
          </layer>

          <layer
            y={144}
            w="fill"
            h={35}
            options={['Select']}
            optionSubject="<col=ff9040>Runeversi</col>"
            onOptionSelect={() => {
              showSelection(draughts, runelink, runesquares, runeversi, 3);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(runeversi, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(runeversi, 0);
            }}
          >
            <sprite
              ref={runeversi}
              x={10}
              y="center"
              w={17}
              h={17}
              sprite={game === 3 ? ChallengeArt.SELECTED : ChallengeArt.UNSELECTED}
            />
            <text
              x={32}
              y="center"
              w={80}
              h={17}
              text="Runeversi"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.HEADING}
            />
            <text
              x={117}
              y="center"
              w={107}
              h={17}
              text="9999 vs 9999"
              shadow
              font={ChallengeFonts.NAME}
              color={ChallengeColors.MUTED}
            />
          </layer>

          <text
            x={32}
            y={0}
            w={50}
            h={17}
            text="Game:"
            shadow
            font={ChallengeFonts.NAME}
            color={ChallengeColors.HEADING}
          />
          <text
            x={117}
