import { closeInterface } from '../lib/lib.helpers';
import { DraughtsArt, DraughtsColors, DraughtsFonts, DraughtsModels } from './draughts.constants';
import { FramedButton } from './framed-button.component';
import { SteelFrame } from './steel-frame.component';

export function Draughts(): Component {
  return (
    <layer x={12} y={20} w={488} h={300}>
      <SteelFrame backdrop />

      <layer w="fill" h="fill">
        <text
          x={9}
          y={9}
          w={176}
          h={17}
          text="Draughts"
          align="center"
          valign="middle"
          shadow
          font={DraughtsFonts.TITLE}
          color={DraughtsColors.HEADING}
        />

        <layer x={0} y={0} w={488} h={300}>
          <sprite x={171} y={6} w={36} h={288} sprite={DraughtsArt.DIVIDER_V} tiling />
          <sprite x={5} y={14} w={181} h={36} sprite={DraughtsArt.DIVIDER_H} tiling />
        </layer>

        <layer x={8} y={37} w={163} h={56}>
          <model x={0} y={0} w={20} h={20} model={DraughtsModels.PLAYER_ONE} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={1}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={DraughtsFonts.NAME}
            color={DraughtsColors.HEADING}
          />
          <text
            x={80}
            y={18}
            w={14}
            h={14}
            text="vs"
            align="left"
            valign="top"
            shadow
            font={DraughtsFonts.SMALL}
            color={DraughtsColors.MUTED}
          />
          <model x={0} y={30} w={20} h={20} model={DraughtsModels.PLAYER_TWO} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={31}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={DraughtsFonts.NAME}
            color={DraughtsColors.HEADING}
          />
        </layer>

        <layer
          x={13}
          y={{ bottom: 14 }}
          w={78}
          h={42}
          options={['Resign']}
          onOptionSelect={() => {
            closeInterface();
          }}
        >
          <FramedButton label="Resign" color={DraughtsColors.DANGER} hoverColor={DraughtsColors.DANGER_HOVER} />
        </layer>
        <layer x={13} y={{ bottom: 62 }} w={78} h={43} options={['Offer your opponent a draw']}>
          <FramedButton label="Offer draw" color={DraughtsColors.CAUTION} hoverColor={DraughtsColors.CAUTION_HOVER} />
        </layer>

        <model x={123} y={269} w={32} h={32} model={DraughtsModels.PIECE_LIGHT} zoom={2048} />
        <text
          x={26}
          y={107}
          w={44}
          h={31}
          text="Turn:"
          align="right"
          valign="middle"
          shadow
          font={DraughtsFonts.NAME}
          color={DraughtsColors.HEADING}
        />
        <text
          x={73}
          y={107}
          w={111}
          h={31}
          text="A very long name"
          align="left"
          valign="middle"
          shadow
          font={DraughtsFonts.NAME}
          color={DraughtsColors.MUTED}
        />
        <model x={320} y={134} w={32} h={32} model={DraughtsModels.PIECE_DARK} zoom={400} pitch={512} />

        <rect x={207} y={21} w={258} h={258} color={0x000000} />
        <model x={208} y={22} w={32} h={32} model={DraughtsModels.BOARD} zoom={768} pitch={512} anim={1356} />
        <layer x={208} y={22} w={256} h={256} />

        <text
          x={11}
          y={110}
          w={169}
          h={21}
          text=""
          align="center"
          valign="middle"
          shadow
          font={DraughtsFonts.NAME}
          color={DraughtsColors.MUTED}
        />
        <text
          x={11}
          y={140}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={DraughtsFonts.SMALL}
          color={DraughtsColors.MUTED}
        />
        <text
          x={11}
          y={165}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={DraughtsFonts.SMALL}
          color={DraughtsColors.MUTED}
