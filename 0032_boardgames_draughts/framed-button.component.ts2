import { useRef } from 'ts2';
import { DraughtsFonts } from './draughts.constants';
import { SteelFrame } from './steel-frame.component';

export function FramedButton({ label, color, hoverColor }: { label: String; color: Int; hoverColor: Int }): Component {
  const text = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      onMouseEnter={() => {
        text.color = hoverColor;
      }}
      onMouseLeave={() => {
        text.color = color;
      }}
    >
      <rect x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} color={0x000000} fill />

      <SteelFrame backdrop={false} />

      <text
        ref={text}
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        align="center"
        valign="middle"
        shadow
        font={DraughtsFonts.SMALL}
        color={color}
      />
    </layer>
  );
}
