import { useRef, useServerState, predictServerState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { FramedButton } from '../0032_boardgames_draughts/framed-button.component';
import {
  HOVER_TRANSPARENCY,
  OptionsArt,
  OptionsColors,
  OptionsFonts,
  OptionsLayout,
  OptionsVarbits,
  RANKED_SUBJECT,
  RuneModels,
  RuneSubjects,
  TimeChoices,
  TimeSubjects,
} from './boardgames-options.constants';

export function showRune(
  fire: Ref,
  water: Ref,
  earth: Ref,
  air: Ref,
  mind: Ref,
  body: Ref,
  nature: Ref,
  chaos: Ref,
  law: Ref,
  cosmic: Ref,
  blood: Ref,
  soul: Ref,
  chosen: Int,
): void {
  fire.sprite = OptionsArt.UNSELECTED;
  water.sprite = OptionsArt.UNSELECTED;
  earth.sprite = OptionsArt.UNSELECTED;
  air.sprite = OptionsArt.UNSELECTED;
  mind.sprite = OptionsArt.UNSELECTED;
  body.sprite = OptionsArt.UNSELECTED;
  nature.sprite = OptionsArt.UNSELECTED;
  chaos.sprite = OptionsArt.UNSELECTED;
  law.sprite = OptionsArt.UNSELECTED;
  cosmic.sprite = OptionsArt.UNSELECTED;
  blood.sprite = OptionsArt.UNSELECTED;
  soul.sprite = OptionsArt.UNSELECTED;

  if (chosen === 1) {
    fire.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 2) {
    water.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 3) {
    earth.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 4) {
    air.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 5) {
    mind.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 6) {
    body.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 7) {
    nature.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 8) {
    chaos.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 9) {
    law.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 10) {
    cosmic.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 11) {
    blood.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 12) {
    soul.sprite = OptionsArt.SELECTED;
  }
}

export function showTime(fifteen: Ref, thirty: Ref, minute: Ref, twoMinutes: Ref, chosen: Int): void {
  fifteen.sprite = OptionsArt.UNSELECTED;
  thirty.sprite = OptionsArt.UNSELECTED;
  minute.sprite = OptionsArt.UNSELECTED;
  twoMinutes.sprite = OptionsArt.UNSELECTED;

  if (chosen === 0) {
    fifteen.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 1) {
    thirty.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 2) {
    minute.sprite = OptionsArt.SELECTED;
  }
  if (chosen === 3) {
    twoMinutes.sprite = OptionsArt.SELECTED;
  }
}

function fadeUnlessMobile(icon: Ref, transparency: Int): void {
  if (!onMobile()) {
    setTransparency(icon, transparency);
  }
}

