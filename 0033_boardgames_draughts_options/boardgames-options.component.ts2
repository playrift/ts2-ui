              ref={blood}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 11 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
