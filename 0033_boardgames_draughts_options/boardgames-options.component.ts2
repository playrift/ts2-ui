            />
          </layer>

          <layer
            x={OptionsLayout.COL_2}
            y={OptionsLayout.ROW_3}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.SOUL : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(12);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(soul, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(soul, 0);
            }}
          >
