import { predictServerState, useRef, useServerState, useState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { FramedButton } from '../0032_boardgames_draughts/framed-button.component';
import {
  HOVER_TRANSPARENCY,
  OptionsArt,
  OptionsColors,
  OptionsFonts,
  OptionsLayout,
  OptionsVarbits,
  OptionsVarps,
  RANKED_SUBJECT,
  RuneModels,
  RuneSubjects,
  TimeChoices,
  TimeSubjects,
} from './boardgames-options.constants';

function fadeUnlessMobile(icon: Ref, transparency: Int): void {
  if (!onMobile()) {
    setTransparency(icon, transparency);
  }
}

export function BoardgamesOptions({ title, subjects = false }: { title: String; subjects?: Boolean }): Component {
  const piece: Int = useServerState(OptionsVarbits.PIECE);
  const time: Int = useServerState(OptionsVarbits.TIME);
  const ranked: Int = useServerState(OptionsVarbits.RANKED);

  const selections: Int = useServerState(OptionsVarps.SELECTIONS);
  const rankedVarp: Int = useServerState(OptionsVarps.RANKED);

  const [piecePick, setPiecePick] = useState(-1);
  const [timePick, setTimePick] = useState(-1);
  const [pickedAt355, setPickedAt355] = useState(-1);
  const [pickedAt356, setPickedAt356] = useState(-1);

  const standing: Boolean = pickedAt355 === selections && pickedAt356 === rankedVarp;
  const pieceShown: Int = standing && piecePick !== -1 ? piecePick : piece;
  const timeShown: Int = standing && timePick !== -1 ? timePick : time;

  const fire = useRef();
  const water = useRef();
  const earth = useRef();
  const air = useRef();
  const mind = useRef();
  const body = useRef();
  const nature = useRef();
  const chaos = useRef();
  const law = useRef();
  const cosmic = useRef();
  const blood = useRef();
  const soul = useRef();
  const fifteen = useRef();
  const thirty = useRef();
  const minute = useRef();
  const twoMinutes = useRef();
  const rankedBox = useRef();

  return (
    <layer x="center" y="center" w={342} h={228} spellTarget>
      <SteelBorderEntrypoint title={title} />

      <layer x="center" y="center" w="fill" h="fill">
        <layer x={12} y={39} w={192} h={179}>
          <layer
            x={OptionsLayout.COL_0}
            y={OptionsLayout.ROW_0}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.FIRE : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(1);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(fire, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(fire, 0);
            }}
          >
            <sprite
              ref={fire}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 1 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.FIRE}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
            />
          </layer>

          <layer
            x={OptionsLayout.COL_0}
            y={OptionsLayout.ROW_1}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.WATER : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(2);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(water, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(water, 0);
            }}
          >
            <sprite
              ref={water}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 2 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.WATER}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
            />
          </layer>

          <layer
            x={OptionsLayout.COL_0}
            y={OptionsLayout.ROW_2}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.EARTH : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(3);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(earth, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(earth, 0);
            }}
          >
            <sprite
              ref={earth}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 3 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.EARTH}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
            />
          </layer>

          <layer
            x={OptionsLayout.COL_0}
            y={OptionsLayout.ROW_3}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.AIR : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(4);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(air, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(air, 0);
            }}
          >
            <sprite
              ref={air}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 4 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.AIR}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
