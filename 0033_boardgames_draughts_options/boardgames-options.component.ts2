          <layer
            x={OptionsLayout.COL_2}
            y={OptionsLayout.ROW_0}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.LAW : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(9);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(law, HOVER_TRANSPARENCY);
            }}
