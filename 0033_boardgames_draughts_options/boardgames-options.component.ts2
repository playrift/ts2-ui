              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 10 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H_SHORT}
              model={RuneModels.COSMIC}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
            />
          </layer>

          <layer
            x={OptionsLayout.COL_2}
            y={OptionsLayout.ROW_2}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.BLOOD : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(11);
              setPickedAt355(selections);
