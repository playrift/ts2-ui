          <layer
            x={OptionsLayout.COL_1}
            y={OptionsLayout.ROW_2}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.NATURE : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(7);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(nature, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(nature, 0);
            }}
          >
            <sprite
              ref={nature}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 7 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.NATURE}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
