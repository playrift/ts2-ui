            const keep: Boolean = standing;
            predictServerState(OptionsVarbits.RANKED, 1 - ranked);
            if (keep) {
              setPickedAt356(rankedVarp);
            }
          }}
          onMouseRepeat={() => {
            fadeUnlessMobile(rankedBox, HOVER_TRANSPARENCY);
