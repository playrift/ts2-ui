            <sprite
              ref={law}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 9 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
            />
            <model
              x="right"
              y="center"
              w={OptionsLayout.MODEL_W}
              h={OptionsLayout.MODEL_H}
              model={RuneModels.LAW}
              zoom={OptionsLayout.MODEL_ZOOM}
              pitch={OptionsLayout.MODEL_PITCH}
              yaw={OptionsLayout.MODEL_YAW}
            />
          </layer>

          <layer
            x={OptionsLayout.COL_2}
            y={OptionsLayout.ROW_1}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.COSMIC : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(10);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(cosmic, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
