          <layer
            x={OptionsLayout.COL_1}
            y={OptionsLayout.ROW_3}
            w={OptionsLayout.CELL_W}
            h={OptionsLayout.CELL_H}
            options={['Select']}
            optionSubject={subjects ? RuneSubjects.CHAOS : ''}
            onOptionSelect={() => {
              if (!standing) {
                setTimePick(-1);
              }
              setPiecePick(8);
              setPickedAt355(selections);
              setPickedAt356(rankedVarp);
            }}
            onMouseRepeat={() => {
              fadeUnlessMobile(chaos, HOVER_TRANSPARENCY);
            }}
            onMouseLeave={() => {
              fadeUnlessMobile(chaos, 0);
            }}
          >
            <sprite
              ref={chaos}
              x={{ center: OptionsLayout.RADIO_DX }}
              y="center"
              w={OptionsLayout.RADIO}
              h={OptionsLayout.RADIO}
              sprite={pieceShown === 8 ? OptionsArt.SELECTED : OptionsArt.UNSELECTED}
