import { createRef, useInterval, useWatch } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Camera,
  DraughtsOverlay,
  DraughtsOverlayFonts,
  DraughtsOverlayModel,
  LABEL,
  Layout,
  DraughtsOverlayVarps,
} from './draughts-overlay.constants';
import { draughtsRank } from './draughts-overlay.helpers';

const timerHost = createRef('0034_boardgames_draughts_overlay_timer_host');

const content = createRef('boardgames_draughts_overlay_content');

const rank = createRef('boardgames_draughts_overlay_rank');

export function DraughtsOverlay_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, DraughtsOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0), timerHost);

  useWatch(DraughtsOverlayVarps.RANK, (event) => draughtsRank(event.component), rank);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={DraughtsOverlayModel.BOARD}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />

          <text
            x="right"
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={DraughtsOverlayFonts.TITLE}
            text="Draughts"
            align="center"
            shadow
            color={LABEL}
          />

          <text
            x="right"
            y={Layout.RANK_Y}
            w={Layout.RANK_W}
            h={Layout.RANK_H}
            font={DraughtsOverlayFonts.RANK}
            text=""
            align="center"
            shadow
            color={LABEL}
            ref={rank}
            onLoad={(event) => draughtsRank(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
