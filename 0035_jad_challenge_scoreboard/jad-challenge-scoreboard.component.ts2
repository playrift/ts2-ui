import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Layout,
  ScoreboardArt,
  ScoreboardColors,
  ScoreboardFonts,
  ScoreboardModels,
} from './jad-challenge-scoreboard.constants';

export function JadChallengeScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={ScoreboardModels.BOARD}
        zoom={Layout.MODEL_ZOOM}
      />

      <layer
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_BOX}
        h={Layout.CLOSE_BOX}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.FACE_X}
          y={Layout.FACE_Y}
          w={Layout.FACE_W}
          h={Layout.FACE_H}
          sprite={ScoreboardArt.CLOSE}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, ScoreboardArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, ScoreboardArt.CLOSE)}
        />
      </layer>

      <layer
        x={{ center: Layout.SCROLLBAR_DX }}
        y={{ center: Layout.SCROLLBAR_DY }}
        w={Layout.SCROLLBAR_W}
        h={Layout.SCROLLBAR_H}
      />

      <layer
        x={{ center: Layout.CONTENT_DX }}
        y={{ center: Layout.CONTENT_DY }}
        w={Layout.CONTENT_W}
        h={Layout.CONTENT_H}
      >
        <text
          x={{ center: Layout.BODY_DX }}
          y={Layout.BODY_Y}
          w={{ fill: Layout.BODY_INSET_W }}
          h={Layout.BODY_H}
          font={ScoreboardFonts.BODY}
          color={ScoreboardColors.BODY}
          align="center"
          shadow
          lineHeight={Layout.BODY_LINE_HEIGHT}
        />
      </layer>
    </>
  );
}
