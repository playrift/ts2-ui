import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Camera,
  LABEL,
  Layout,
  RunelinkOverlay,
  RunelinkOverlayFonts,
  RunelinkOverlayModel,
} from './runelink-overlay.constants';
import { runelinkRank } from './runelink-overlay.helpers';

const content = createRef('boardgames_runelink_overlay_content');

export function RunelinkOverlay_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, RunelinkOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={RunelinkOverlayModel.BOARD}
            zoom={Camera.ZOOM}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={RunelinkOverlayFonts.TITLE}
            text="Runelink"
            align="center"
            shadow
            color={LABEL}
          />

          <text
            x={{ right: Layout.RANK_RIGHT }}
            y={Layout.RANK_Y}
            w={Layout.RANK_W}
            h={Layout.RANK_H}
            font={RunelinkOverlayFonts.RANK}
            text=""
            align="center"
            shadow
            color={LABEL}
            onTimer={(event) => runelinkRank(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
