import { useServerState } from 'ts2';

import {
  Board,
  RUNESQUARES_HORIZONTAL_HITS,
  RUNESQUARES_HORIZONTAL_LINES,
  RUNESQUARES_VERTICAL_HITS,
  RUNESQUARES_VERTICAL_LINES,
  RunesquaresColors,
} from './runesquares.constants';

export function RunesquaresGrid(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer x={0} y={0} w="fill" h="fill">
        {RUNESQUARES_VERTICAL_LINES.map((line) => (
          <rect
            x={line.x}
            y={line.y}
            w={Board.RULE}
            h={Board.SEGMENT}
            fill
            color={useServerState(line.bit) === 1 ? RunesquaresColors.LATTICE : RunesquaresColors.LINE}
            options={[useServerState(line.bit) === 1 ? '' : 'Draw line']}
          />
        ))}
        {RUNESQUARES_HORIZONTAL_LINES.map((line) => (
          <rect
            x={line.x}
            y={line.y}
            w={Board.SEGMENT}
            h={Board.RULE}
            fill
            color={useServerState(line.bit) === 1 ? RunesquaresColors.LATTICE : RunesquaresColors.LINE}
            options={[useServerState(line.bit) === 1 ? '' : 'Draw line']}
          />
        ))}
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        {RUNESQUARES_VERTICAL_HITS.map((hit) => (
          <rect
            x={{ center: hit.dx }}
            y={hit.y}
            w={Board.HIT_SHORT}
            h={Board.HIT_LONG}
            color={RunesquaresColors.LINE}
            fill
            transparency={255}
            noClickThrough
            options={[useServerState(hit.bit) === 1 ? '' : 'Draw line']}
          />
        ))}
        {RUNESQUARES_HORIZONTAL_HITS.map((hit) => (
          <rect
            x={hit.x}
            y={{ center: hit.dy }}
            w={Board.HIT_LONG}
            h={Board.HIT_SHORT}
            color={RunesquaresColors.LINE}
            fill
            transparency={255}
            noClickThrough
            options={[useServerState(hit.bit) === 1 ? '' : 'Draw line']}
          />
        ))}
      </layer>
    </layer>
  );
}
