import { closeInterface } from '../lib/lib.helpers';
import { FramedButton } from '../0032_boardgames_draughts/framed-button.component';
import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { RunesquaresGrid } from './runesquares-grid.component';
import {
  Board,
  RUNESQUARES_DOTS,
  RunesquaresArt,
  RunesquaresColors,
  RunesquaresFonts,
  RunesquaresModels,
} from './runesquares.constants';

export function Runesquares(): Component {
  return (
    <layer x={12} y={20} w={488} h={300}>
      <SteelFrame backdrop />

      <layer w="fill" h="fill">
        <text
          x={9}
          y={9}
          w={176}
          h={17}
          text="Runesquares"
          align="center"
          valign="middle"
          shadow
          font={RunesquaresFonts.TITLE}
          color={RunesquaresColors.HEADING}
        />

        <layer x={0} y={0} w={488} h={300}>
          <sprite x={171} y={6} w={36} h={288} sprite={RunesquaresArt.DIVIDER_V} tiling />
          <sprite x={5} y={14} w={181} h={36} sprite={RunesquaresArt.DIVIDER_H} tiling />
        </layer>

        <layer x={8} y={37} w={163} h={56}>
          <model x={0} y={0} w={20} h={20} model={RunesquaresModels.PLAYER_ONE} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={1}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={RunesquaresFonts.NAME}
            color={RunesquaresColors.HEADING}
          />
          <text
            x={80}
            y={18}
            w={14}
            h={14}
            text="vs"
            align="left"
            valign="top"
            shadow
            font={RunesquaresFonts.SMALL}
            color={RunesquaresColors.MUTED}
          />
          <model x={0} y={30} w={20} h={20} model={RunesquaresModels.PLAYER_TWO} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={31}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={RunesquaresFonts.NAME}
            color={RunesquaresColors.HEADING}
          />
        </layer>

        <layer
          x={13}
          y={{ bottom: 14 }}
          w={78}
          h={42}
          options={['Resign']}
          onOptionSelect={() => {
            closeInterface();
          }}
        >
          <FramedButton label="Resign" color={RunesquaresColors.DANGER} hoverColor={RunesquaresColors.DANGER_HOVER} />
        </layer>
        <layer x={13} y={{ bottom: 62 }} w={78} h={43} options={['Offer your opponent a draw']}>
          <FramedButton
            label="Offer draw"
            color={RunesquaresColors.CAUTION}
            hoverColor={RunesquaresColors.CAUTION_HOVER}
          />
        </layer>
        <layer
          x={13}
          y={{ bottom: 14 }}
          w={78}
          h={42}
          hide
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
        >
          <sprite x={0} y={0} w={16} h={16} sprite={RunesquaresArt.TICK} />
          <FramedButton label="Close" color={RunesquaresColors.DANGER} hoverColor={RunesquaresColors.DANGER_HOVER} />
        </layer>

        <model x={123} y={269} w={32} h={32} model={RunesquaresModels.PIECE_LIGHT} zoom={2048} />
        <text
          x={26}
          y={107}
          w={44}
          h={31}
          text="Turn:"
          align="right"
          valign="middle"
          shadow
          font={RunesquaresFonts.NAME}
          color={RunesquaresColors.HEADING}
        />
        <text
          x={73}
          y={107}
          w={111}
          h={31}
          text="A very long name"
          align="left"
          valign="middle"
          shadow
          font={RunesquaresFonts.NAME}
          color={RunesquaresColors.MUTED}
        />
        <text
          x={11}
          y={110}
          w={169}
          h={21}
          text=""
          hide
          align="center"
          valign="middle"
          shadow
          font={RunesquaresFonts.NAME}
          color={RunesquaresColors.MUTED}
        />
        <text
          x={11}
          y={140}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={RunesquaresFonts.SMALL}
          color={RunesquaresColors.MUTED}
        />
        <text
          x={11}
          y={165}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={RunesquaresFonts.SMALL}
          color={RunesquaresColors.MUTED}
        />

        <layer x={Board.X} y={Board.Y} w={Board.SIZE} h={Board.SIZE}>
          <layer x={0} y={0} w={Board.SIZE} h={Board.SIZE}>
            <rect x={2} y={0} w={272} h={Board.RULE} color={RunesquaresColors.LATTICE} fill />
            <rect x={0} y={272} w={272} h={Board.RULE} color={RunesquaresColors.LATTICE} fill />
            <rect x={0} y={0} w={Board.RULE} h={272} color={RunesquaresColors.LATTICE} fill />
            <rect x={272} y={2} w={Board.RULE} h={272} color={RunesquaresColors.LATTICE} fill />
          </layer>

          <RunesquaresGrid />

          <layer x={0} y={0} w={Board.SIZE} h={Board.SIZE}>
            {RUNESQUARES_DOTS.map((dot) => (
              <rect x={dot.x} y={dot.y} w={Board.RULE} h={Board.RULE} color={RunesquaresColors.LATTICE} fill />
            ))}
          </layer>

          <layer x="center" y="center" w={{ fill: Board.INSET }} h={{ fill: Board.INSET }} />
        </layer>
      </layer>
    </layer>
  );
}
