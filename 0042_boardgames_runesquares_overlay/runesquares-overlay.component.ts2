import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Camera,
  LABEL,
  Layout,
  RunesquaresOverlay,
  RunesquaresOverlayFonts,
  RunesquaresOverlayModel,
} from './runesquares-overlay.constants';
import { runesquaresRank } from './runesquares-overlay.helpers';

const content = createRef('boardgames_runesquares_overlay_content');

export function RunesquaresOverlay_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, RunesquaresOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={RunesquaresOverlayModel.BOARD}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={RunesquaresOverlayFonts.TITLE}
            text="Runesquares"
            align="right"
            shadow
            color={LABEL}
          />

          <text
            x={{ right: Layout.RANK_RIGHT }}
            y={Layout.RANK_Y}
            w={Layout.RANK_W}
            h={Layout.RANK_H}
            font={RunesquaresOverlayFonts.RANK}
            text=""
            align="center"
            shadow
            color={LABEL}
            onTimer={(event) => runesquaresRank(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
