import { Camera, StarAnims, StarColors, StarModels } from './star-telescope-meteor.constants';

export function StarTelescopeMeteor(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={StarColors.BACKDROP} fill />

      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={StarModels.METEOR}
        anim={StarAnims.METEOR}
        zoom={Camera.METEOR_ZOOM}
        offsetX={Camera.METEOR_OFFSET_X}
        offsetY={Camera.METEOR_OFFSET_Y}
      />

      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={StarModels.TELESCOPE}
        zoom={Camera.TELESCOPE_ZOOM}
        pitch={Camera.TELESCOPE_PITCH}
      />
    </layer>
  );
}
