import { useInventory, useServerState } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Varbits } from '../lib/game/varbits';
import { Board, RUNEVERSI_SQUARES, RuneversiColors } from './runeversi.constants';

export function RuneversiSquares(): Component {
  const spectating: Int = useServerState(Varbits.BOARDGAMES_VIEWING);
  const board = useInventory(Inventories.BOARDGAMES_BOARDINV);

  return (
    <layer x={0} y={0} w="fill" h="fill">
      {RUNEVERSI_SQUARES.map((square, slot) => (
        <rect
          x={square.x}
          y={square.y}
          w={Board.CELL}
          h={Board.CELL}
          color={RuneversiColors.SQUARE}
          options={[spectating === 1 ? 'Draw line' : board[slot] === -1 ? 'Play piece' : '']}
        />
      ))}
    </layer>
  );
}
