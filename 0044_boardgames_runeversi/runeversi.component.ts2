import { closeInterface } from '../lib/lib.helpers';
import { FramedButton } from '../0032_boardgames_draughts/framed-button.component';
import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { RuneversiSquares } from './runeversi-squares.component';
import {
  Board,
  RUNEVERSI_TILES,
  RuneversiArt,
  RuneversiColors,
  RuneversiFonts,
  RuneversiModels,
  TileCamera,
} from './runeversi.constants';

export function Runeversi(): Component {
  return (
    <layer x={12} y={20} w={488} h={300}>
      <SteelFrame backdrop />

      <layer w="fill" h="fill">
        <text
          x={9}
          y={9}
          w={176}
          h={17}
          text="Runeversi"
          align="center"
          valign="middle"
          shadow
          font={RuneversiFonts.TITLE}
          color={RuneversiColors.HEADING}
        />

        <layer x={0} y={0} w={488} h={300}>
          <sprite x={171} y={6} w={36} h={288} sprite={RuneversiArt.DIVIDER_V} tiling />
          <sprite x={5} y={14} w={181} h={36} sprite={RuneversiArt.DIVIDER_H} tiling />
        </layer>

        <layer x={8} y={37} w={163} h={56}>
          <model x={0} y={0} w={20} h={20} model={RuneversiModels.PLAYER_ONE} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={1}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={RuneversiFonts.NAME}
            color={RuneversiColors.HEADING}
          />
          <text
            x={80}
            y={18}
            w={14}
            h={14}
            text="vs"
            align="left"
            valign="top"
            shadow
            font={RuneversiFonts.SMALL}
            color={RuneversiColors.MUTED}
          />
          <model x={0} y={30} w={20} h={20} model={RuneversiModels.PLAYER_TWO} zoom={1024} pitch={512} yaw={1024} />
          <text
            x="right"
            y={31}
            w={140}
            h={25}
            text="Insert a very long name here!"
            align="left"
            valign="middle"
            shadow
            font={RuneversiFonts.NAME}
            color={RuneversiColors.HEADING}
          />
        </layer>

        <layer
          x={13}
          y={{ bottom: 14 }}
          w={78}
          h={42}
          options={['Resign']}
          onOptionSelect={() => {
            closeInterface();
          }}
        >
          <FramedButton label="Resign" color={RuneversiColors.DANGER} hoverColor={RuneversiColors.DANGER_HOVER} />
        </layer>
        <layer x={13} y={{ bottom: 62 }} w={78} h={43} options={['Offer your opponent a draw']}>
          <FramedButton label="Offer draw" color={RuneversiColors.CAUTION} hoverColor={RuneversiColors.CAUTION_HOVER} />
        </layer>
        <layer
          x={13}
          y={{ bottom: 14 }}
          w={78}
          h={42}
          hide
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
        >
          <sprite x={0} y={0} w={16} h={16} sprite={RuneversiArt.TICK} />
          <FramedButton label="Close" color={RuneversiColors.DANGER} hoverColor={RuneversiColors.DANGER_HOVER} />
        </layer>

        <model x={123} y={269} w={32} h={32} model={RuneversiModels.PIECE_LIGHT} zoom={2048} />
        <text
          x={26}
          y={107}
          w={44}
          h={31}
          text="Turn:"
          align="right"
          valign="middle"
          shadow
          font={RuneversiFonts.NAME}
          color={RuneversiColors.HEADING}
        />
        <text
          x={73}
          y={107}
          w={111}
          h={31}
          text="A very long name"
          align="left"
          valign="middle"
          shadow
          font={RuneversiFonts.NAME}
          color={RuneversiColors.MUTED}
        />

        <layer x={Board.X} y={Board.Y} w={Board.SIZE} h={Board.SIZE}>
          {RUNEVERSI_TILES.map((tile) => (
            <model
              x={tile.x}
              y={tile.y}
              w={Board.CELL}
              h={Board.CELL}
              model={RuneversiModels.TILE}
              zoom={TileCamera.ZOOM}
              pitch={TileCamera.PITCH}
            />
          ))}
          <RuneversiSquares />
        </layer>

        <layer x={Board.X} y={Board.Y} w={Board.SIZE} h={Board.SIZE} />

        <text
          x={11}
          y={110}
          w={169}
          h={21}
          text=""
          hide
          align="center"
          valign="middle"
          shadow
          font={RuneversiFonts.NAME}
          color={RuneversiColors.MUTED}
        />
        <text
          x={11}
          y={140}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={RuneversiFonts.SMALL}
          color={RuneversiColors.MUTED}
        />
        <text
          x={11}
          y={165}
          w={169}
          h={11}
          text="Blah blah blah blah blah blah blah!"
          align="center"
          valign="top"
          shadow
          font={RuneversiFonts.SMALL}
          color={RuneversiColors.MUTED}
        />
      </layer>
    </layer>
  );
}
