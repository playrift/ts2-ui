import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Camera,
  LABEL,
  Layout,
  RuneversiOverlay,
  RuneversiOverlayFonts,
  RuneversiOverlayModel,
} from './runeversi-overlay.constants';
import { runeversiRank } from './runeversi-overlay.helpers';

const content = createRef('boardgames_runeversi_overlay_content');

export function RuneversiOverlay_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, RuneversiOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={RuneversiOverlayModel.BOARD}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={RuneversiOverlayFonts.TITLE}
            text="Runeversi"
            align="center"
            shadow
            color={LABEL}
          />

          <text
            x={{ right: Layout.RANK_RIGHT }}
            y={Layout.RANK_Y}
            w={Layout.RANK_W}
            h={Layout.RANK_H}
            font={RuneversiOverlayFonts.RANK}
            text=""
            align="center"
            shadow
            color={LABEL}
            onTimer={(event) => runeversiRank(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
