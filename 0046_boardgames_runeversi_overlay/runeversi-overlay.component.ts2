import { createRef, useInterval, useWatch } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Camera,
  LABEL,
  Layout,
  RuneversiOverlay,
  RuneversiOverlayFonts,
  RuneversiOverlayModel,
  RuneversiOverlayVarps,
} from './runeversi-overlay.constants';
import { runeversiRank } from './runeversi-overlay.helpers';

const timerHost = createRef('0046_boardgames_runeversi_overlay_timer_host');

const content = createRef('boardgames_runeversi_overlay_content');

const rank = createRef('boardgames_runeversi_overlay_rank');

export function RuneversiOverlay_(): Component {
  useInterval(
    () => overlayRelayout(timerHost, content, RuneversiOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0),
    timerHost,
  );

  useWatch(RuneversiOverlayVarps.RANK, (event) => runeversiRank(event.component), rank);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={RuneversiOverlayModel.BOARD}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={RuneversiOverlayFonts.TITLE}
            text="Runeversi"
            align="center"
            shadow
            color={LABEL}
          />

          <text
            x={{ right: Layout.RANK_RIGHT }}
            y={Layout.RANK_Y}
            w={Layout.RANK_W}
            h={Layout.RANK_H}
            font={RuneversiOverlayFonts.RANK}
            text=""
            align="center"
            shadow
            color={LABEL}
            ref={rank}
            onLoad={(event) => runeversiRank(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
