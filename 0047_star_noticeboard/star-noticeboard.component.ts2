import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  ROW_Y,
  StarNoticeboardArt,
  StarNoticeboardColor,
  StarNoticeboardFont,
  StarNoticeboardModel,
} from './star-noticeboard.constants';

export function StarNoticeboard(): Component {
  return (
    <>
      <model
        x="center"
        y={Layout.BOARD_Y}
        w={Layout.BOARD_W}
        h={Layout.BOARD_H}
        model={StarNoticeboardModel.BOARD}
        zoom={Camera.ZOOM}
        offsetY={Camera.OFFSET_Y}
      />

      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <text
          x={Layout.FINDER_HEADER_X}
          y={Layout.HEADER_Y}
          w={Layout.FINDER_HEADER_W}
          h={Layout.HEADER_H}
          text="Discovered by:"
          font={StarNoticeboardFont.HEADER}
          color={StarNoticeboardColor.INK}
          shadow
        />

        <text
          x={Layout.LANDING_HEADER_X}
          y={Layout.HEADER_Y}
          w={Layout.LANDING_HEADER_W}
          h={Layout.HEADER_H}
          text="Landing time:"
          font={StarNoticeboardFont.HEADER}
          color={StarNoticeboardColor.INK}
          shadow
        />

        {ROW_Y.map((y) => (
          <text
            x={Layout.TIME_X}
            y={y}
            w={Layout.TIME_W}
            h={Layout.ROW_H}
            font={StarNoticeboardFont.ROW}
            color={StarNoticeboardColor.INK}
            shadow
          />
        ))}

        {ROW_Y.map((y) => (
          <text
            x={Layout.FINDER_X}
            y={y}
            w={Layout.FINDER_W}
            h={Layout.ROW_H}
            font={StarNoticeboardFont.ROW}
            color={StarNoticeboardColor.INK}
            shadow
          />
        ))}

        <text
          x="center"
          y={Layout.COUNT_Y}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={StarNoticeboardFont.ROW}
          color={StarNoticeboardColor.INK}
          align="center"
          shadow
        />
      </layer>

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={StarNoticeboardArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, StarNoticeboardArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, StarNoticeboardArt.CLOSE)}
      />
    </>
  );
}
