import { BobAnims, BobCamera, BobModel, BobSprites, Layout } from './bob-locator-amulet.constants';

export function BobLocatorAmulet(): Component {
  return (
    <>
      <model
        x={Layout.FACE_X}
        y={Layout.FACE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.HEAD}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
      />

      <model
        x={Layout.FACE_X}
        y={Layout.FACE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.NOSE_LIGHTS}
        anim={BobAnims.NOSE}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
      />

      <model
        x={Layout.R_EYE_X}
        y={Layout.R_EYE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.EYE}
        anim={BobAnims.EYES}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH_R_EYE}
      />

      <model
        x={Layout.L_EYE_X}
        y={Layout.L_EYE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.EYE}
        anim={BobAnims.EYES}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
        yaw={BobCamera.YAW_L_EYE}
      />

      <model
        x={Layout.FACE_X}
        y={Layout.FACE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.MOUTH}
        anim={BobAnims.EYES}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
      />

      <sprite x={Layout.L_WHISKER_X} y={Layout.WHISKER_Y} w={Layout.WHISKER_W} h={Layout.WHISKER_H} />
      <sprite x={Layout.R_WHISKER_X} y={Layout.WHISKER_Y} w={Layout.WHISKER_W} h={Layout.WHISKER_H} />

      <model
        x={Layout.FACE_X}
        y={Layout.FACE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.R_WHISKER}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
      />
      <model
        x={Layout.FACE_X}
        y={Layout.FACE_Y}
        w={Layout.FACE_SIZE}
        h={Layout.FACE_SIZE}
        model={BobModel.L_WHISKER}
        zoom={BobCamera.ZOOM}
        pitch={BobCamera.PITCH}
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={BobSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={BobSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
