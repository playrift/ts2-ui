import { CookingFrame } from './cooking-frame.component';
import { CreateButton } from './create-button.component';
import { CuisineGrid } from './cuisine-grid.component';
import { IngredientPane } from './ingredient-pane.component';
import { GnomeColors, Grid, Strip } from './aluft-cooking.constants';

export function AluftCooking(): Component {
  return (
    <>
      <CookingFrame />

      <layer w="fill" h="fill">
        <layer x="center" y={Grid.Y} w={Grid.W} h={Grid.H}>
          <CuisineGrid />
        </layer>

        <layer x="center" y={Grid.Y} w={Grid.W} h={Grid.H} />

        <layer x="center" y={Strip.BAND_Y} w={{ fill: Strip.BAND_INSET }} h={Strip.BAND_H}>
          <layer x={Strip.MOUNT_X} y="center" w={Strip.MOUNT_W} h={Strip.MOUNT_H}>
            <rect x="center" y="center" w={Strip.BACKDROP_W} h={Strip.BACKDROP_H} fill color={GnomeColors.BACKDROP} />

            <rect x="center" y="center" w={Strip.EDGE_W} h={Strip.EDGE_H} color={GnomeColors.STRIP_EDGE} />

            <IngredientPane />
          </layer>

          <CreateButton
            x={{ right: Strip.BUTTON_RIGHT }}
            y="center"
            w={Strip.BUTTON_W}
            h={Strip.BUTTON_H}
            options={['Create']}
          />
        </layer>
      </layer>
    </>
  );
}
