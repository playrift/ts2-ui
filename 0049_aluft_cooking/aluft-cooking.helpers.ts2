import { CS2, useInventory } from 'ts2';
import { CuisineParams, GnomeInventories, Skills } from './aluft-cooking.constants';

export function cuisineTitle(type: Int): String {
  switch (type) {
    case 0:
      return 'Gnome Cocktails';
    case 1:
      return 'Gnome Battas';
    case 2:
      return 'Gnome Crunchies';
    case 3:
      return 'Gnome Bowls';
  }
  return '';
}

export function cuisineCheckInv(row: Row): Boolean {
  const inv = useInventory(GnomeInventories.INV);

  if (CS2.stat(Skills.COOKING) < row.int(CuisineParams.LEVEL)) {
    return false;
  }

  let met: Boolean = false;

  let item: Item = row.int(CuisineParams.ITEM_1) as Item;
  if (item !== -1 && inv.total(item) >= row.int(CuisineParams.QTY_1)) {
    met = true;
  } else {
    return false;
  }

  item = row.int(CuisineParams.ITEM_2) as Item;
  if (item !== -1 && inv.total(item) >= row.int(CuisineParams.QTY_2)) {
    met = true;
  } else {
    return false;
  }

  item = row.int(CuisineParams.ITEM_3) as Item;
  if (item !== -1 && inv.total(item) >= row.int(CuisineParams.QTY_3)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  item = row.int(CuisineParams.ITEM_4) as Item;
  if (item !== -1 && inv.total(item) >= row.int(CuisineParams.QTY_4)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  item = row.int(CuisineParams.ITEM_5) as Item;
  if (item !== -1 && inv.total(item) >= row.int(CuisineParams.QTY_5)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  return met;
}

