import { CS2, useInventory } from 'ts2';
import { type CuisineRow, GnomeInventories, Skills } from './aluft-cooking.constants';

export function cuisineTitle(type: Int): String {
  switch (type) {
    case 0:
      return 'Gnome Cocktails';
    case 1:
      return 'Gnome Battas';
    case 2:
      return 'Gnome Crunchies';
    case 3:
      return 'Gnome Bowls';
  }
  return '';
}

export function cuisineCheckInv(row: CuisineRow): Boolean {
  const inv = useInventory(GnomeInventories.INV);

  if (CS2.stat(Skills.COOKING) < row.level) {
    return false;
  }

  let met: Boolean = false;

  let item: Item = row.item1;
  if (item !== -1 && inv.total(item) >= row.qty1) {
    met = true;
  } else {
    return false;
  }

  item = row.item2;
  if (item !== -1 && inv.total(item) >= row.qty2) {
    met = true;
  } else {
    return false;
  }

  item = row.item3 ?? -1;
  if (item !== -1 && inv.total(item) >= (row.qty3 ?? -1)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  item = row.item4 ?? -1;
  if (item !== -1 && inv.total(item) >= (row.qty4 ?? -1)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  item = row.item5 ?? -1;
  if (item !== -1 && inv.total(item) >= (row.qty5 ?? -1)) {
    met = true;
  } else if (item !== -1) {
    return false;
  }

  return met;
}

