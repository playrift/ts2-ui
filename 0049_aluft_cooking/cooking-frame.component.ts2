import { useServerState } from 'ts2';
import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { cuisineTitle } from './aluft-cooking.helpers';
import { GnomeVarbits } from './aluft-cooking.constants';

export function CookingFrame(): Component {
  const type: Int = useServerState(GnomeVarbits.COOKING_TYPE);
  return <SteelBorder title={cuisineTitle(type)} titleColor={SteelborderColor.TITLE} flags={0} />;
}
