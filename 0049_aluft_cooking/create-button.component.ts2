import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { GnomeColors, GnomeFonts, LINE_HEIGHT } from './aluft-cooking.constants';

export function CreateButton(): Component {
  const [hovered, setHovered] = useState(0);

  return (
    <layer onMouseEnter={() => setHovered(1)} onMouseLeave={() => setHovered(0)}>
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text="Create"
        font={GnomeFonts.LABEL}
        color={GnomeColors.ORANGE}
        shadow
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />
    </layer>
  );
}
