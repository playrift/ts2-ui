import { useServerState } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { CuisineCell } from './cuisine-cell.component';
import { cuisineCheckInv } from './aluft-cooking.helpers';
import { Battas, Bowls, Cocktails, Crunchies, CuisineParams, GnomeVarbits } from './aluft-cooking.constants';

export function CuisineGrid(): Component {
  const type: Int = useServerState(GnomeVarbits.COOKING_TYPE);

  if (type > 3) {
    closeInterface();
    return null;
  }

  return (
    <layer w="fill" h="fill">
      {type === 0 && (
        <>
          {Cocktails.map((row, index) => (
            <CuisineCell
              index={index}
              name={row.text(CuisineParams.NAME)}
              cuisineId={row.int(CuisineParams.CUISINE_ID)}
              product={row.int(CuisineParams.PRODUCT) as Item}
              locked={row.int(CuisineParams.LOCKED_PRODUCT) as Item}
              canMake={cuisineCheckInv(row)}
            />
          ))}
        </>
      )}

      {type === 1 && (
        <>
          {Battas.map((row, index) => (
            <CuisineCell
              index={index}
              name={row.text(CuisineParams.NAME)}
              cuisineId={row.int(CuisineParams.CUISINE_ID)}
              product={row.int(CuisineParams.PRODUCT) as Item}
              locked={row.int(CuisineParams.LOCKED_PRODUCT) as Item}
              canMake={cuisineCheckInv(row)}
            />
          ))}
        </>
      )}

      {type === 2 && (
        <>
          {Crunchies.map((row, index) => (
            <CuisineCell
              index={index}
              name={row.text(CuisineParams.NAME)}
              cuisineId={row.int(CuisineParams.CUISINE_ID)}
              product={row.int(CuisineParams.PRODUCT) as Item}
              locked={row.int(CuisineParams.LOCKED_PRODUCT) as Item}
              canMake={cuisineCheckInv(row)}
            />
          ))}
        </>
      )}

      {type === 3 && (
        <>
          {Bowls.map((row, index) => (
            <CuisineCell
              index={index}
              name={row.text(CuisineParams.NAME)}
              cuisineId={row.int(CuisineParams.CUISINE_ID)}
              product={row.int(CuisineParams.PRODUCT) as Item}
              locked={row.int(CuisineParams.LOCKED_PRODUCT) as Item}
              canMake={cuisineCheckInv(row)}
            />
          ))}
        </>
      )}
    </layer>
  );
}
