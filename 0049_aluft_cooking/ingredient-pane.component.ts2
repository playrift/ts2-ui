import { useServerState } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { RecipeIngredients } from './recipe-ingredients.component';
import {
  Battas,
  Bowls,
  Cocktails,
  Crunchies,
  CuisineParams,
  CuisineRows,
  GnomeVarbits,
} from './aluft-cooking.constants';

export function IngredientPane(): Component {
  const type: Int = useServerState(GnomeVarbits.COOKING_TYPE);
  const chosen: Int = useServerState(GnomeVarbits.CHOSEN_CUISINE);

  return (
    <layer w="fill" h="fill">
      {type === 0 && <CocktailIngredients chosen={chosen} />}
      {type === 1 && <BattaIngredients chosen={chosen} />}
      {type === 2 && <CrunchyIngredients chosen={chosen} />}
      {type === 3 && <BowlIngredients chosen={chosen} />}
    </layer>
  );
}

export function CocktailIngredients({ chosen }: { chosen: Int }): Component {
  let found: Int = -1;
  let key: Int = 0;
  while (key < CuisineRows.COCKTAILS) {
    if (Cocktails.at(key).int(CuisineParams.CUISINE_ID) === chosen) {
      found = key;
      key = CuisineRows.COCKTAILS;
    }
    key = key + 1;
  }
  if (found < 0) {
    closeInterface();
    return null;
  }
  return <RecipeIngredients row={Cocktails.at(found)} />;
}

