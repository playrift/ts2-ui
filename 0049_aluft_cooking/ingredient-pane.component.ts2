import { useServerState } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { RecipeIngredients } from './recipe-ingredients.component';
import { type CuisineRow, GnomeVarbits, Recipes } from './aluft-cooking.constants';

export function IngredientPane(): Component {
  const type: Int = useServerState(GnomeVarbits.COOKING_TYPE);
  const chosen: Int = useServerState(GnomeVarbits.CHOSEN_CUISINE);

  return (
    <layer w="fill" h="fill">
      {type < 4 && <ChosenRecipe type={type} chosen={chosen} />}
    </layer>
  );
}

function ChosenRecipe({ type, chosen }: { type: Int; chosen: Int }): Component {
  const row: CuisineRow | null = Recipes.at(chosen);

  const cuisine: Int = row === null ? -1 : row.cuisine;

  if (row === null || cuisine !== type) {
    closeInterface();
    return null;
  }

  return <RecipeIngredients row={row} />;
}
