import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { dummyItemFor } from './aluft-cooking.helpers';
import { Detail, GnomeColors, GnomeFonts, GnomeInventories, LINE_HEIGHT } from './aluft-cooking.constants';

export function IngredientSlot({
  item,
  need,
  column,
  pad,
}: {
  item: Item;
  need: Int;
  column: Int;
  pad: Int;
}): Component {
  if (item === -1) {
    return null;
  }

  const inv = useInventory(GnomeInventories.INV);
  const held: Int = inv.total(item);
  const left: Int = Detail.COLUMN * column + pad;

  return (
    <>
      <model
        x={left + Detail.SLOT_X}
        y={Detail.SLOT_Y}
        w={Detail.SLOT_W}
        h={Detail.SLOT_H}
        item={held >= need ? item : dummyItemFor(item)}
        itemCount={1}
      />

      <text
        x={left}
        y={Detail.COUNT_Y}
        w={Detail.COLUMN}
        h={Detail.COUNT_H}
        text={
          held >= need
            ? `<col=00ff00>${stringOf(held)}/${stringOf(need)}`
            : `<col=9f9f9f>${stringOf(held)}/${stringOf(need)}`
        }
        font={GnomeFonts.LABEL}
        shadow
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />

      <text
        x={left}
        y={Detail.NAME_Y}
        w={Detail.COLUMN}
        h={Detail.NAME_H}
        text={itemName(item)}
        font={GnomeFonts.LABEL}
        color={GnomeColors.ORANGE}
        shadow
        align="center"
        valign="top"
        lineHeight={LINE_HEIGHT}
      />
    </>
  );
}
