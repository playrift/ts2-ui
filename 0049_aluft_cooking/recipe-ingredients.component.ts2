import { CS2 } from 'ts2';
import { textWidth } from '../lib/lib.engine';
import { IngredientSlot } from './ingredient-slot.component';
import { type CuisineRow, Detail, GnomeColors, GnomeFonts, LINE_HEIGHT, Skills } from './aluft-cooking.constants';

export function RecipeIngredients({ row }: { row: CuisineRow }): Component {
  const name: String = row.name;
  const level: String = `Level ${stringOf(row.level)}`;

  const pad: Int = Detail.HALF_COLUMN * (5 - row.ingredientCount);

  return (
    <>
      <text
        x={Detail.HEADER_INSET}
        y={Detail.HEADER_Y}
        w={textWidth(name, Detail.WIDTH, GnomeFonts.LABEL)}
        h={Detail.HEADER_H}
        text={name}
        font={GnomeFonts.LABEL}
        color={GnomeColors.ORANGE}
        shadow
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />

      <text
        x={{ right: Detail.HEADER_INSET }}
        y={Detail.HEADER_Y}
        w={textWidth(level, Detail.WIDTH, GnomeFonts.LABEL)}
        h={Detail.HEADER_H}
        text={level}
        font={GnomeFonts.LABEL}
        shadow
        color={CS2.stat(Skills.COOKING) < row.level ? GnomeColors.GREY : GnomeColors.GREEN}
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />

      <IngredientSlot column={0} pad={pad} item={row.item1} need={row.qty1} />
      <IngredientSlot column={1} pad={pad} item={row.item2} need={row.qty2} />
      <IngredientSlot column={2} pad={pad} item={row.item3 ?? -1} need={row.qty3 ?? -1} />
      <IngredientSlot column={3} pad={pad} item={row.item4 ?? -1} need={row.qty4 ?? -1} />
      <IngredientSlot column={4} pad={pad} item={row.item5 ?? -1} need={row.qty5 ?? -1} />
    </>
  );
}
