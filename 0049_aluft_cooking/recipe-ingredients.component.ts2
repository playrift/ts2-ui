import { CS2 } from 'ts2';
import { textWidth } from '../lib/lib.engine';
import { IngredientSlot } from './ingredient-slot.component';
import { CuisineParams, Detail, GnomeColors, GnomeFonts, LINE_HEIGHT, Skills } from './aluft-cooking.constants';

export function RecipeIngredients({ row }: { row: Row }): Component {
  const name: String = row.text(CuisineParams.NAME);
  const level: String = `Level ${stringOf(row.int(CuisineParams.LEVEL))}`;

  const pad: Int = Detail.HALF_COLUMN * (5 - row.int(CuisineParams.INGREDIENT_COUNT));

  return (
    <>
      <text
        x={Detail.HEADER_INSET}
        y={Detail.HEADER_Y}
        w={textWidth(name, Detail.WIDTH, GnomeFonts.LABEL)}
        h={Detail.HEADER_H}
        text={name}
        font={GnomeFonts.LABEL}
        color={GnomeColors.ORANGE}
        shadow
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />

      <text
        x={{ right: Detail.HEADER_INSET }}
        y={Detail.HEADER_Y}
        w={textWidth(level, Detail.WIDTH, GnomeFonts.LABEL)}
        h={Detail.HEADER_H}
        text={level}
        font={GnomeFonts.LABEL}
        shadow
        color={CS2.stat(Skills.COOKING) < row.int(CuisineParams.LEVEL) ? GnomeColors.GREY : GnomeColors.GREEN}
        align="center"
        valign="middle"
        lineHeight={LINE_HEIGHT}
      />

      <IngredientSlot
        column={0}
        pad={pad}
        item={row.int(CuisineParams.ITEM_1) as Item}
        need={row.int(CuisineParams.QTY_1)}
      />
      <IngredientSlot
        column={1}
        pad={pad}
        item={row.int(CuisineParams.ITEM_2) as Item}
        need={row.int(CuisineParams.QTY_2)}
      />
      <IngredientSlot
        column={2}
        pad={pad}
        item={row.int(CuisineParams.ITEM_3) as Item}
        need={row.int(CuisineParams.QTY_3)}
      />
      <IngredientSlot
        column={3}
        pad={pad}
        item={row.int(CuisineParams.ITEM_4) as Item}
        need={row.int(CuisineParams.QTY_4)}
      />
      <IngredientSlot
        column={4}
        pad={pad}
        item={row.int(CuisineParams.ITEM_5) as Item}
        need={row.int(CuisineParams.QTY_5)}
      />
    </>
  );
}
