function TobPartydetailsPlate({
  label,
  value,
  subject,
  table = false,
}: {
  label: String;
  value: Int;
  subject: String;
  table?: Boolean;
}): Component {
  const [built] = useState(boardBuilt);
  if (built === 0) {
    return null;
  }
  const text: String = table ? plateMode(label, value) : plateNumber(label, value);
  return (
    <layer w="fill" h="fill">
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={text}
        font={TobPartydetailsFonts.ROW}
        color={TobPartydetailsColor.PLATE}
        align="center"
        valign="middle"
        shadow
        options={[Copy.SET]}
        optionSubject={subject}
        onMouseRepeat={(event) => plateHovered(event.self)}
        onMouseLeave={(event) => plateRested(event.self)}
      />
    </layer>
  );
}

