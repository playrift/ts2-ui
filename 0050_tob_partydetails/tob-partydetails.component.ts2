}

export function TobPartydetailsBack(): Component {
  return (
    <layer ref={backRef} x={Layout.BACK_X} y={Layout.BACK_Y} w={Layout.BACK} h={Layout.BACK} hide options={[Copy.BACK]}>
      <TobPartydetailsBackButton />
    </layer>
  );
}

function TobPartydetailsBackButton(): Component {
  return (
    <sprite
      x="center"
      y="center"
      w={Layout.BACK}
      h={Layout.BACK}
      sprite={TobPartydetailsSprites.BACK}
      onMouseRepeat={(event) => backButtonLit(event.component)}
      onMouseLeave={(event) => backButtonRest(event.component)}
    />
  );
}

function backButtonLit(target: ComponentId): void {
  if (!onMobile()) {
    target.sprite = TobPartydetailsSprites.BACK_LIT;
  }
}

function backButtonRest(target: ComponentId): void {
  target.sprite = TobPartydetailsSprites.BACK;
}

function rowHovered(target: ComponentId): void {
  target.transparency = Layout.ROW_TRANSPARENCY_HOVER;
}

function rowRested(target: ComponentId, wash: Int): void {
  target.transparency = wash;
}

function plateHovered(target: ComponentId): void {
  target.color = TobPartydetailsColor.PLATE_HOVER;
}

function plateRested(target: ComponentId): void {
  target.color = TobPartydetailsColor.PLATE;
}

function TobPartydetailsActionButton(): Component {
  const [built] = useState(boardBuilt);
  if (built === 0) {
    return null;
  }
  return (
    <layer w="fill" h="fill">
      <BoardButton label={actionLabel()} />
    </layer>
  );
}

function actionLabel(): String {
  if (BoardPacket.role === PartyRole.LEADER) {
    return Copy.DISBAND;
  }
  if (BoardPacket.role === PartyRole.MEMBER) {
    return Copy.LEAVE;
  }
  if (BoardPacket.role === PartyRole.APPLICANT) {
    return Copy.WITHDRAW;
  }
  if (BoardPacket.role === PartyRole.BLOCKED) {
    return Copy.APPLY_DISABLED;
  }
  return Copy.APPLY;
}

function TobPartydetailsUnblockButton(): Component {
  const [built] = useState(boardBuilt);
  if (built === 0 || BoardPacket.role !== PartyRole.LEADER) {
    return null;
  }
  return (
    <layer w="fill" h="fill">
      <BoardButton label={Copy.UNBLOCK} />
    </layer>
  );
}

function TobPartydetailsMembers(): Component {
  const [built] = useState(boardBuilt);
  if (built === 0) {
    return null;
  }
  return (
    <layer w="fill" h="fill">
      {MemberPackets.map((line, index) => (
        <TobPartydetailsMemberRow line={line} index={index} />
      ))}
    </layer>
  );
}

function TobPartydetailsMemberRow({ line, index }: { line: String; index: Int }): Component {
  const name: String = pipeHead(line);
  const rest0: String = pipeTail(line);
  const combat: String = pipeHead(rest0);
  const rest1: String = pipeTail(rest0);
  const attack: String = pipeHead(rest1);
  const rest2: String = pipeTail(rest1);
  const strength: String = pipeHead(rest2);
  const rest3: String = pipeTail(rest2);
  const ranged: String = pipeHead(rest3);
  const rest4: String = pipeTail(rest3);
  const magic: String = pipeHead(rest4);
  const rest5: String = pipeTail(rest4);
  const defence: String = pipeHead(rest5);
  const rest6: String = pipeTail(rest5);
  const hitpoints: String = pipeHead(rest6);
  const rest7: String = pipeTail(rest6);
  const prayer: String = pipeHead(rest7);
  const rest8: String = pipeTail(rest7);
  const runs: String = pipeHead(rest8);

  const top: Int = index * Layout.ROW_H + Layout.ROW_TOP;
  const wash: Int = rowTransparency(index);
  const ink: Int = rowColor(name);

  return (
    <>
      {BoardPacket.role === PartyRole.LEADER ? (
        <rect
          x="center"
          y={top}
          w="fill"
          h={Layout.ROW_H}
          fill
          color={TobPartydetailsColor.ROW_BACK}
          transparency={wash}
          options={['', '', '', '', '', '', '', '', '', index === 0 ? Copy.QUIT_PARTY : Copy.KICK]}
          optionSubject={rowSubject(name)}
          onMouseRepeat={(event) => rowHovered(event.self)}
          onMouseLeave={(event) => rowRested(event.self, wash)}
        />
      ) : (
        <rect
          x="center"
          y={top}
          w="fill"
          h={Layout.ROW_H}
          fill
          color={TobPartydetailsColor.ROW_BACK}
          transparency={wash}
        />
      )}
      <RowCell x={RowColumns.NAME.x} w={RowColumns.NAME.w} y={top} field={name} ink={ink} />
      <RowCell x={RowColumns.COMBAT.x} w={RowColumns.COMBAT.w} y={top} field={combat} ink={ink} />
      <RowCell x={RowColumns.ATTACK.x} w={RowColumns.ATTACK.w} y={top} field={attack} ink={ink} />
      <RowCell x={RowColumns.STRENGTH.x} w={RowColumns.STRENGTH.w} y={top} field={strength} ink={ink} />
      <RowCell x={RowColumns.RANGED.x} w={RowColumns.RANGED.w} y={top} field={ranged} ink={ink} />
      <RowCell x={RowColumns.MAGIC.x} w={RowColumns.MAGIC.w} y={top} field={magic} ink={ink} />
      <RowCell x={RowColumns.DEFENCE.x} w={RowColumns.DEFENCE.w} y={top} field={defence} ink={ink} />
      <RowCell x={RowColumns.HITPOINTS.x} w={RowColumns.HITPOINTS.w} y={top} field={hitpoints} ink={ink} />
      <RowCell x={RowColumns.PRAYER.x} w={RowColumns.PRAYER.w} y={top} field={prayer} ink={ink} />
      <RowCell x={RowColumns.RUNS.x} w={RowColumns.RUNS.w} y={top} field={runs} ink={ink} />
    </>
  );
}

function TobPartydetailsApplicants(): Component {
  const [built] = useState(boardBuilt);
  if (built === 0) {
    return null;
  }
  return (
    <layer w="fill" h="fill">
      {ApplicantPackets.map((line, index) => (
        <TobPartydetailsApplicantRow line={line} index={index} />
      ))}
    </layer>
  );
}

function TobPartydetailsApplicantRow({ line, index }: { line: String; index: Int }): Component {
  const name: String = pipeHead(line);
  const rest0: String = pipeTail(line);
  const combat: String = pipeHead(rest0);
  const rest1: String = pipeTail(rest0);
  const attack: String = pipeHead(rest1);
  const rest2: String = pipeTail(rest1);
  const strength: String = pipeHead(rest2);
  const rest3: String = pipeTail(rest2);
  const ranged: String = pipeHead(rest3);
  const rest4: String = pipeTail(rest3);
  const magic: String = pipeHead(rest4);
  const rest5: String = pipeTail(rest4);
  const defence: String = pipeHead(rest5);
  const rest6: String = pipeTail(rest5);
  const hitpoints: String = pipeHead(rest6);
  const rest7: String = pipeTail(rest6);
  const prayer: String = pipeHead(rest7);
  const rest8: String = pipeTail(rest7);
  const runs: String = pipeHead(rest8);

  const top: Int = index * Layout.ROW_H;
  const wash: Int = rowTransparency(index);
  const ink: Int = rowColor(name);

  return (
    <>
      {BoardPacket.role === PartyRole.LEADER ? (
        <rect
          x="center"
          y={top}
          w="fill"
          h={Layout.ROW_H}
          fill
          color={TobPartydetailsColor.ROW_BACK}
          transparency={wash}
          options={[Copy.ACCEPT, '', '', '', '', '', '', '', '', Copy.REJECT]}
          optionSubject={rowSubject(name)}
          onMouseRepeat={(event) => rowHovered(event.self)}
          onMouseLeave={(event) => rowRested(event.self, wash)}
        />
      ) : (
        <rect
          x="center"
          y={top}
          w="fill"
          h={Layout.ROW_H}
          fill
          color={TobPartydetailsColor.ROW_BACK}
          transparency={wash}
        />
      )}
      <ApplicantCell x={RowColumns.NAME.x} w={RowColumns.NAME.w} y={top} field={name} ink={ink} />
      <ApplicantCell x={RowColumns.COMBAT.x} w={RowColumns.COMBAT.w} y={top} field={combat} ink={ink} />
      <ApplicantCell x={RowColumns.ATTACK.x} w={RowColumns.ATTACK.w} y={top} field={attack} ink={ink} />
      <ApplicantCell x={RowColumns.STRENGTH.x} w={RowColumns.STRENGTH.w} y={top} field={strength} ink={ink} />
      <ApplicantCell x={RowColumns.RANGED.x} w={RowColumns.RANGED.w} y={top} field={ranged} ink={ink} />
      <ApplicantCell x={RowColumns.MAGIC.x} w={RowColumns.MAGIC.w} y={top} field={magic} ink={ink} />
      <ApplicantCell x={RowColumns.DEFENCE.x} w={RowColumns.DEFENCE.w} y={top} field={defence} ink={ink} />
      <ApplicantCell x={RowColumns.HITPOINTS.x} w={RowColumns.HITPOINTS.w} y={top} field={hitpoints} ink={ink} />
      <ApplicantCell x={RowColumns.PRAYER.x} w={RowColumns.PRAYER.w} y={top} field={prayer} ink={ink} />
      <ApplicantCell x={RowColumns.RUNS.x} w={RowColumns.RUNS.w} y={top} field={runs} ink={ink} />
    </>
  );
}

function RowCell({ x, y, w, field, ink }: { x: Int; y: Int; w: Int; field: String; ink: Int }): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={Layout.ROW_H}
      text={cellText(field)}
      font={TobPartydetailsFonts.ROW}
      color={cellColor(field, ink)}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function ApplicantCell({ x, y, w, field, ink }: { x: Int; y: Int; w: Int; field: String; ink: Int }): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={Layout.ROW_H}
      text={field}
      font={TobPartydetailsFonts.ROW}
      color={ink}
      align="center"
      valign="middle"
      shadow
    />
  );
}

export function TobPartydetailsTooltip(): Component {
  const [key] = useState(tipIndex);
  const tip: TobPartydetailsTip | null = TobPartydetailsTips.at(key);

  const hostW: Int = universeRef.width;
  const hostH: Int = universeRef.height;
  const rootX: Int = universeRef.x;
  const rootY: Int = universeRef.y;

  let text: String = '';
  let anchorX: Int = 0;
  let anchorY: Int = 0;
  let anchorH: Int = 0;
  let wrap: Int = Tooltip.WRAP;
  if (tooltipUp() && key >= 0 && tip !== null) {
    text = tip.text;
    anchorX = tip.x + rootX;
    anchorY = tip.y + rootY;
    anchorH = tip.h;
    wrap = tip.wrap;
  }
  let measure: Int = wrap;
  if (measure > hostW) {
    measure = hostW;
  }
  measure = measure - TooltipBox.padX;
  const boxW: Int = TooltipBox.padX + textWidth(text, measure, TooltipBox.font);
  const boxH: Int = TooltipBox.padY + TooltipBox.line * textLineCount(text, measure, TooltipBox.font);

  let x: Int = anchorX + TooltipBox.nudge;
  if (x > hostW - boxW) {
    x = hostW - boxW;
  }
  let y: Int = anchorY + anchorH + TooltipBox.nudge;
  if (y > hostH - boxH) {
    y = anchorY - boxH - TooltipBox.nudge;
  }

  let shown: Boolean = false;
  if (text.length > 0) {
    shown = true;
  }

  return (
    <layer
      ref={tooltipRef}
      x={shown ? x : 0}
      y={shown ? y : 0}
      w={shown ? boxW : Layout.TOOLTIP}
      h={shown ? boxH : Layout.TOOLTIP}
    >
      {shown && <rect x="center" y="center" w="fill" h="fill" fill color={TooltipBox.fill} />}
      {shown && <rect x="center" y="center" w="fill" h="fill" color={TooltipBox.ink} />}
      {shown && (
        <text
          x="center"
          y={{ bottom: 0 }}
          w={{ fill: TooltipBox.padX }}
          h={{ fill: 1 }}
          text={text}
          align="left"
          valign="top"
          lineHeight={0}
          font={TooltipBox.font}
          color={TooltipBox.ink}
        />
      )}
    </layer>
  );
}
