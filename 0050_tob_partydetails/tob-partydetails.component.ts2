function TobPartydetailsTimerWipe(): Component {
  const [startedAt] = useState(refreshStartedAt);
  const [seen, setSeen] = useState(0);

  let remaining: Int = AutoRefresh.CYCLES;
  let ticking: Boolean = false;
  if (startedAt !== -1) {
    remaining = AutoRefresh.CYCLES - (seen - startedAt);
    if (remaining < 0) {
      remaining = 0;
    }
    if (remaining > AutoRefresh.CYCLES) {
      remaining = AutoRefresh.CYCLES;
    }
    if (remaining > 0) {
      ticking = true;
    }
  }
  useInterval(ticking ? () => setSeen(clientClock()) : undefined);

  return (
    <layer ref={timerRef} x={0} y="center" w={(Layout.DIAL_W * remaining) / AutoRefresh.CYCLES} h="fill">
      <DialModels lit />
    </layer>
  );
}

function TobPartydetailsLoading(): Component {
  const [built] = useState(boardBuilt);
  if (built === 1) {
