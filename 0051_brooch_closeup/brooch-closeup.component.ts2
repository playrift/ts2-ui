import {
  BackingTiles,
  BottomEdge,
  BroochArt,
  BroochColors,
  BroochFonts,
  BroochModel,
  BroochText,
  Layout,
  LeftEdge,
  RightEdge,
  TopBandLower,
  TopBandUpper,
} from './brooch-closeup.constants';

export function BroochCloseup(): Component {
  return (
    <>
      {BackingTiles.map((tile) => (
        <sprite x={tile.x} y={tile.y} w={Layout.TILE_W} h={Layout.TILE_H} sprite={BroochArt.BACKING} />
      ))}

      <sprite
        x={Layout.CORNER_TL_X}
        y={Layout.CORNER_TL_Y}
        w={Layout.CORNER_W}
        h={Layout.CORNER_H}
        sprite={BroochArt.CORNER_TOP_LEFT}
      />

      {LeftEdge.map((piece) => (
        <sprite x={Layout.LEFT_EDGE_X} y={piece.y} w={Layout.BAR} h={Layout.BAR} sprite={BroochArt.EDGE_VERTICAL} />
      ))}

      {RightEdge.map((piece) => (
        <sprite x={Layout.RIGHT_EDGE_X} y={piece.y} w={Layout.BAR} h={Layout.BAR} sprite={BroochArt.BAR_VERTICAL} />
      ))}

      {BottomEdge.map((piece) => (
        <sprite x={piece.x} y={Layout.BOTTOM_EDGE_Y} w={Layout.BAR} h={Layout.BAR} sprite={BroochArt.EDGE_HORIZONTAL} />
      ))}

      {TopBandUpper.map((piece) => (
        <sprite x={piece.x} y={Layout.TOP_UPPER_Y} w={Layout.BAR} h={Layout.BAR} sprite={BroochArt.BAR_HORIZONTAL} />
      ))}

      <sprite
        x={Layout.STRAY_67_X}
        y={Layout.TOP_LOWER_Y}
        w={Layout.BAR}
        h={Layout.BAR}
        sprite={BroochArt.BAR_HORIZONTAL}
      />

      <sprite
        x={Layout.STRAY_68_X}
        y={Layout.TOP_UPPER_Y}
        w={Layout.BAR}
        h={Layout.BAR}
        sprite={BroochArt.BAR_HORIZONTAL}
      />

      <sprite
        x={Layout.STRAY_69_X}
        y={Layout.BOTTOM_EDGE_Y}
        w={Layout.BAR}
        h={Layout.BAR}
        sprite={BroochArt.EDGE_HORIZONTAL}
      />

      <sprite
        x={Layout.CORNER_BL_X}
        y={Layout.CORNER_BL_Y}
        w={Layout.CORNER_W}
        h={Layout.CORNER_H}
        sprite={BroochArt.CORNER_BOTTOM_LEFT}
      />

      <sprite
        x={Layout.CORNER_TR_X}
        y={Layout.CORNER_TR_Y}
        w={Layout.CORNER_W}
        h={Layout.CORNER_H}
        sprite={BroochArt.CORNER_TOP_RIGHT}
      />

      <sprite
        x={Layout.STRAY_72_X}
        y={Layout.TOP_UPPER_Y}
        w={Layout.BAR}
        h={Layout.BAR}
        sprite={BroochArt.BAR_HORIZONTAL}
      />

      <sprite
        x={Layout.CORNER_BR_X}
        y={Layout.CORNER_BR_Y}
        w={Layout.CORNER_W}
        h={Layout.CORNER_H}
        sprite={BroochArt.CORNER_BOTTOM_RIGHT}
      />

      <sprite
        x={Layout.STRAY_74_X}
        y={Layout.BOTTOM_EDGE_Y}
        w={Layout.BAR}
        h={Layout.BAR}
        sprite={BroochArt.EDGE_HORIZONTAL}
      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={BroochModel.BROOCH}
        zoom={BroochModel.ZOOM}
        pitch={BroochModel.PITCH}
        yaw={BroochModel.YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={BroochText.TITLE}
        font={BroochFonts.TITLE}
        color={BroochColors.TITLE}
        align="center"
        shadow
      />

      {TopBandLower.map((piece) => (
        <sprite x={piece.x} y={Layout.TOP_LOWER_Y} w={Layout.BAR} h={Layout.BAR} sprite={BroochArt.BAR_HORIZONTAL} />
      ))}

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={BroochArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={BroochArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
