import { BoardAlpha, BoardColor } from './poh-board.constants';
import { BoardRows } from './poh-board.data';

export function BoardStripes({ rowHeight }: { rowHeight: Int }): Component {
  return (
    <layer w="fill" h="fill">
      {BoardRows.map((row) => (
        <rect
          x={0}
          y={row * rowHeight}
          w="fill"
          h={rowHeight}
          fill
          color={row % 2 === 1 ? BoardColor.STRIPE_ODD : BoardColor.STRIPE_EVEN}
          transparency={row % 2 === 1 ? BoardAlpha.STRIPE_ODD : BoardAlpha.STRIPE_EVEN}
        />
      ))}
    </layer>
  );
}

export function BoardTextColumn(): Component {
  return (
    <layer w="fill" h="fill">
      {BoardRows.map(() => (
        <text hide font={-1} />
      ))}
    </layer>
  );
}

export function BoardSpriteColumn(): Component {
  return (
    <layer w="fill" h="fill">
      {BoardRows.map(() => (
        <sprite hide />
      ))}
    </layer>
  );
}
