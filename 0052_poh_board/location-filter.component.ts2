import { predictServerState, useRef, useServerState } from 'ts2';

import { BoardColor, BoardFonts, BoardVarbits, CheckBox, Copy, Layout } from './poh-board.constants';

export function toggleBoardFilter(): void {
  const on: Int = useServerState(BoardVarbits.FILTERED);
  predictServerState(BoardVarbits.FILTERED, on === 1 ? 0 : 1);
}

export function LocationFilter(): Component {
  const box = useRef();
  const on: Int = useServerState(BoardVarbits.FILTERED);
  const rest: Sprite = on === 1 ? CheckBox.ON : CheckBox.OFF;
  const lit: Sprite = on === 1 ? CheckBox.ON_HOVER : CheckBox.OFF_HOVER;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        box.sprite = lit;
      }}
      onMouseLeave={() => {
        box.sprite = rest;
      }}
      onClick={() => toggleBoardFilter()}
    >
      <sprite ref={box} x={Layout.CHECK_X} y="center" w={Layout.CHECK_W} h={Layout.CHECK_H} sprite={rest} />
      <text
        x={Layout.FILTER_LABEL_X}
        y="center"
        w={Layout.FILTER_LABEL_W}
        h="fill"
        text={Copy.FILTER}
        font={BoardFonts.BODY}
        color={BoardColor.LABEL}
        align="left"
        valign="middle"
        shadow
      />
    </layer>
  );
}
