import { useRef } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { BoardSpriteColumn, BoardStripes, BoardTextColumn } from './board-columns.component';
import { BoardStoneButton } from './board-text-button.component';
import { LocationFilter } from './location-filter.component';
import {
  BOARD_TITLE,
  BoardBar,
  BoardColor,
  BoardFonts,
  BoardSprites,
  Copy,
  Layout,
  RowHeight,
} from './poh-board.constants';

export function PohBoard(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <StoneBorderEntrypoint title={BOARD_TITLE} />

        <BoardBody x="center" y={Layout.BODY_Y} w={{ fill: Layout.BODY_W_INSET }} h={{ fill: Layout.BODY_H_INSET }} />
      </layer>

      <layer x={0} y={0} w="fill" h="fill" />
    </>
  );
}

function BoardBody(): Component {
  const rowHeight: Int = onMobile() ? RowHeight.MOBILE : RowHeight.DESKTOP;
  const paneInset: Int = Layout.FOOTER_H + rowHeight;
  const pane = useRef();

  return (
    <layer w="fill" h="fill">
      <layer x={0} y={0} w="fill" h={rowHeight}>
        <line
          x={0}
          y={{ bottom: Layout.HEADER_RULE_BOTTOM }}
          w="fill"
          lineWidth={Layout.RULE_WIDTH}
          color={BoardColor.RULE}
        />
      </layer>

      <layer ref={pane} x={0} y={rowHeight} w={{ fill: Layout.PANE_W_INSET }} h={{ fill: paneInset }}>
        <BoardStripes rowHeight={rowHeight} />
        <BoardTextColumn />
        <BoardTextColumn />
        <layer x={0} y={0} w="fill" h="fill" />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardSpriteColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
        <BoardTextColumn />
      </layer>

      <layer x="right" y={rowHeight} w={Layout.BAR_W} h={{ fill: paneInset }}>
        <ScrollbarVertical
          content={pane}
          track={BoardBar.TRACK}
          capTopSprite={BoardBar.CAP_TOP}
          thumbSprite={BoardBar.THUMB}
          capBottomSprite={BoardBar.CAP_BOTTOM}
          arrowUp={BoardBar.ARROW_UP}
          arrowDown={BoardBar.ARROW_DOWN}
        />
      </layer>

      <layer x={0} y={rowHeight} w={{ fill: Layout.PANE_W_INSET }} h={{ fill: paneInset }} />

      <layer x={0} y="bottom" w="fill" h={Layout.FOOTER_H}>
        <layer
          x={Layout.ADD_X}
          y="center"
          w={Layout.ADD_W}
          h={{ fill: Layout.ADD_H_INSET }}
          options={[Copy.ADD_REMOVE]}
        >
          <BoardStoneButton />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={Copy.ADD_REMOVE}
            font={BoardFonts.BODY}
            color={BoardColor.LABEL}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <model
          x={Layout.MODEL_X}
          y={0}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={Layout.MODEL_ID}
          zoom={Layout.MODEL_ZOOM}
          offsetY={Layout.MODEL_OFFSET_Y}
        />

        <LocationFilter x={Layout.FILTER_X} y="center" w={Layout.FILTER_W} h={{ fill: Layout.FILTER_H_INSET }} />

        <layer
          x={{ right: Layout.REFRESH_RIGHT }}
          y="center"
          w={Layout.REFRESH_W}
          h={{ fill: Layout.REFRESH_H_INSET }}
          options={[Copy.REFRESH]}
        >
          <layer x={0} y={0} w={Layout.REFRESH_BUTTON_W} h={Layout.REFRESH_BUTTON_H}>
            <BoardStoneButton />
          </layer>
          <sprite
            x={Layout.REFRESH_ICON_X}
            y="center"
            w={Layout.REFRESH_ICON_W}
            h={Layout.REFRESH_ICON_H}
            sprite={BoardSprites.REFRESH}
          />
          <text
            x={Layout.REFRESH_LABEL_X}
            y={0}
            w={Layout.REFRESH_LABEL_W}
            h="fill"
            text={Copy.REFRESH}
            font={BoardFonts.BODY}
            color={BoardColor.LABEL}
            align="left"
            valign="middle"
            shadow
          />
        </layer>

        <line x={0} y={0} w="fill" lineWidth={Layout.RULE_WIDTH} color={BoardColor.RULE} />
      </layer>

      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        text={Copy.LOADING}
        font={BoardFonts.PLACEHOLDER}
        color={BoardColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
