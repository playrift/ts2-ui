import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Blurb,
  BurghArt,
  BurghColor,
  BurghFont,
  BurghModel,
  BurghText,
  Camera,
  CanifisHi,
  HollowsHi,
  Layout,
  Map,
  Places,
  Route1Caption,
  Route2Caption,
  SwampHi,
  TempleHi,
} from './burgh-map.constants';

export function BurghMap(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.stage.W} h={Layout.stage.H} fill color={BurghColor.GROUND} transparency={1} />

      <model
        x={Map.MORTTON.X}
        y={Map.MORTTON.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.MORTTON}
        zoom={Camera.BUILDING.ZOOM}
        pitch={Camera.BUILDING.PITCH}
        yaw={Camera.BUILDING.YAW}
      />
      <model
        x={Map.TEMPLE.X}
        y={Map.TEMPLE.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.TEMPLE}
        zoom={Camera.BUILDING.ZOOM}
        pitch={Camera.BUILDING.PITCH}
        yaw={Camera.BUILDING.YAW}
      />
      <model
        x={Map.SWAMP.X}
        y={Map.SWAMP.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.SWAMP}
        zoom={Camera.SWAMP.ZOOM}
        pitch={Camera.SWAMP.PITCH}
      />
      <model
        x={Map.CANIFIS.X}
        y={Map.CANIFIS.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.CANIFIS}
        zoom={Camera.TOWN.ZOOM}
        pitch={Camera.TOWN.PITCH}
        yaw={Camera.TOWN.YAW}
      />
      <model
        x={Map.HOLLOWS.X}
        y={Map.HOLLOWS.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.HOLLOWS}
        zoom={Camera.BUILDING.ZOOM}
        pitch={Camera.BUILDING.PITCH}
        yaw={Camera.BUILDING.YAW}
      />

      {Places.map((place) => (
        <text
          x={place.x}
          y={place.y}
          w={place.w}
          h={place.h}
          text={place.text}
          font={BurghFont.LABEL}
          color={BurghColor.PLACE}
          align={place.align}
        />
      ))}

      <model
        x={Map.BURGH_FAR.X}
        y={Map.BURGH_FAR.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.BURGH_FAR}
        zoom={Camera.BUILDING.ZOOM}
        pitch={Camera.BUILDING.PITCH}
        yaw={Camera.BUILDING.YAW}
      />
      <model
        x={Map.BURGH_NEAR.X}
        y={Map.BURGH_NEAR.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.BURGH_NEAR}
        zoom={Camera.BUILDING.ZOOM}
        pitch={Camera.BUILDING.PITCH}
        yaw={Camera.BUILDING.YAW}
      />
      <model
        x={Map.GRAVEYARD.X}
        y={Map.GRAVEYARD.Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BurghModel.GRAVEYARD}
        zoom={Camera.GRAVEYARD.ZOOM}
        pitch={Camera.GRAVEYARD.PITCH}
      />

      <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H} hide options={['Deselect']} />

      <layer x={Layout.close.X} y={Layout.close.Y} w={Layout.close.W} h={Layout.close.H}>
        <sprite
          x={Layout.closeFace.X}
          y={Layout.closeFace.Y}
          w={Layout.closeFace.W}
          h={Layout.closeFace.H}
          sprite={BurghArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapper(event.component, BurghArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.component, BurghArt.CLOSE)}
        />
      </layer>

      <layer x={Layout.route1.X} y={Layout.route1.Y} w={Layout.route1.W} h={Layout.route1.H} options={['Select']}>
        <model
          x="center"
          y={0}
          w="fill"
          h="fill"
          model={BurghModel.PLATE}
          zoom={Layout.plateCamera.ZOOM}
          pitch={Layout.plateCamera.PITCH}
          yaw={Layout.plateCamera.YAW}
        />
        <text
          x={0}
          y={Layout.routeLabel.Y}
          w="fill"
          h="fill"
          text={BurghText.ROUTE_1}
          font={BurghFont.LABEL}
          color={BurghColor.PLATE_INK}
          align="center"
        />
      </layer>

      <layer x={Layout.route2.X} y={Layout.route2.Y} w={Layout.route2.W} h={Layout.route2.H} options={['Select']}>
        <model
          x={0}
          y={0}
          w="fill"
          h="fill"
          model={BurghModel.PLATE}
          zoom={Layout.plateCamera.ZOOM}
          pitch={Layout.plateCamera.PITCH}
          yaw={Layout.plateCamera.YAW}
        />
        <text
          x={0}
          y={Layout.routeLabel.Y}
          w="fill"
          h="fill"
          text={BurghText.ROUTE_2}
          font={BurghFont.LABEL}
          color={BurghColor.PLATE_INK}
          align="center"
        />
      </layer>

      <layer x={Layout.overlay.X} y={Layout.overlay.Y} w={Layout.overlay.W} h={Layout.overlay.H} hide>
        <model
          x={TempleHi.X}
          y={TempleHi.Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurghModel.TEMPLE_HI}
          zoom={Camera.BUILDING.ZOOM}
          pitch={Camera.BUILDING.PITCH}
          yaw={Camera.BUILDING.YAW}
        />
        <model
          x={CanifisHi.X}
          y={CanifisHi.Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurghModel.CANIFIS_HI}
          zoom={Camera.TOWN.ZOOM}
          pitch={Camera.TOWN.PITCH}
          yaw={Camera.TOWN.YAW}
        />
        <text
          x={Route1Caption.X}
          y={Route1Caption.Y}
          w={Route1Caption.W}
          h={Route1Caption.H}
          text={BurghText.ROUTE_1}
          font={BurghFont.LABEL}
          color={BurghColor.WHITE}
          align="center"
        />
        <text
          x={Blurb.X}
          y={Blurb.Y}
          w={Blurb.W}
          h={Blurb.H}
          text={BurghText.BLURB_1}
          font={BurghFont.LABEL}
          color={BurghColor.PLATE_INK}
        />
      </layer>

      <layer x={Layout.overlay.X} y={Layout.overlay.Y} w={Layout.overlay.W} h={Layout.overlay.H} hide>
        <model
          x={TempleHi.X}
          y={TempleHi.Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurghModel.TEMPLE_HI}
          zoom={Camera.BUILDING.ZOOM}
          pitch={Camera.BUILDING.PITCH}
          yaw={Camera.BUILDING.YAW}
        />
        <model
          x={SwampHi.X}
          y={SwampHi.Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurghModel.SWAMP_HI}
          zoom={Camera.SWAMP.ZOOM}
          pitch={Camera.SWAMP.PITCH}
        />
        <model
          x={HollowsHi.X}
          y={HollowsHi.Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurghModel.HOLLOWS_HI}
          zoom={Camera.BUILDING.ZOOM}
          pitch={Camera.BUILDING.PITCH}
          yaw={Camera.BUILDING.YAW}
        />
        <text
          x={Route2Caption.X}
          y={Route2Caption.Y}
          w={Route2Caption.W}
          h={Route2Caption.H}
          text={BurghText.ROUTE_2}
          font={BurghFont.LABEL}
          color={BurghColor.WHITE}
          align="center"
        />
        <text
          x={Blurb.X}
          y={Blurb.Y}
          w={Blurb.W}
          h={Blurb.H}
          text={BurghText.BLURB_2}
          font={BurghFont.LABEL}
          color={BurghColor.PLATE_INK}
        />
      </layer>

      <model
        x={Layout.prompt.X}
        y={Layout.prompt.Y}
        w={Layout.prompt.W}
        h={Layout.prompt.H}
        model={BurghModel.PLATE}
        zoom={Layout.promptCamera.ZOOM}
        pitch={Layout.promptCamera.PITCH}
        yaw={Layout.promptCamera.YAW}
      />

      <layer x={Layout.prompt.X} y={Layout.prompt.Y} w={Layout.prompt.W} h={Layout.prompt.H}>
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          text={BurghText.CHOOSE}
          font={BurghFont.LABEL}
          color={BurghColor.PLATE_INK}
          align="center"
          valign="middle"
        />
      </layer>

      <layer x={Layout.prompt.X} y={Layout.prompt.Y} w={Layout.prompt.W} h={Layout.prompt.H} hide options={['Travel']}>
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          text={BurghText.TRAVEL}
          font={BurghFont.LABEL}
          color={BurghColor.WHITE}
          align="center"
          valign="middle"
        />
      </layer>
      <layer x={Layout.prompt.X} y={Layout.prompt.Y} w={Layout.prompt.W} h={Layout.prompt.H} hide options={['Travel']}>
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          text={BurghText.TRAVEL}
          font={BurghFont.LABEL}
          color={BurghColor.WHITE}
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}
