import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CatapultModels, MODEL_PITCH } from './castlewars-catapult.constants';

export function CatapultValueBox({ x, y, glyph }: { x: Int; y: Int; glyph: Model }): Component {
  return (
    <layer x={x} y={y} w={56} h={72}>
      <model x="center" y="center" w={32} h={32} model={CatapultModels.VALUE_PLATE} pitch={MODEL_PITCH} zoom={1077} />
      <model x="center" y="center" w={32} h={32} model={glyph} pitch={MODEL_PITCH} zoom={1209} />
      <SteelFrame backdrop={false} />
    </layer>
  );
}
