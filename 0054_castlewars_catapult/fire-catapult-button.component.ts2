import { useState } from 'ts2';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { CatapultColors, CatapultFonts } from './castlewars-catapult.constants';

export function FireCatapultButton(): Component {
  const [hovered, setHovered] = useState(0);

  return (
    <layer
      w="fill"
      h="fill"
      options={['Fire!']}
      onMouseEnter={() => {
        setHovered(1);
      }}
      onMouseLeave={() => {
        setHovered(0);
      }}
    >
      {hovered !== 0 ? (
        <StoneButtonPressedFilled>
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            text="Fire Catapult"
            align="center"
            valign="middle"
            shadow
            font={CatapultFonts.TITLE}
            color={CatapultColors.GOLD}
          />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonOutFilled>
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            text="Fire Catapult"
            align="center"
            valign="middle"
            shadow
            font={CatapultFonts.TITLE}
            color={CatapultColors.GOLD}
          />
        </StoneButtonOutFilled>
      )}
    </layer>
  );
}
