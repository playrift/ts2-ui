import { closeInterface, graphicSwapper } from '../lib/lib.helpers';

import { ScoreArt, ScoreBanner, ScoreColor, ScoreFonts, ScoreLayout } from './castlewars-score.constants';

export function CastlewarsScore(): Component {
  return (
    <layer x={0} y={0} w={ScoreLayout.PANEL_W} h={ScoreLayout.PANEL_H}>
      <text
        x={0}
        y={0}
        w={ScoreLayout.PANEL_W}
        h={ScoreLayout.TITLE_H}
        font={ScoreFonts.LINE}
        color={ScoreColor.TITLE}
        align="center"
        valign="middle"
        text="Total Wins This Season!"
      />

      <layer x={0} y={0} w={ScoreLayout.PANEL_W} h={ScoreLayout.PANEL_H}>
        <sprite
          x={ScoreLayout.SWORD_LEFT_X}
          y={ScoreLayout.SWORD_Y}
          w={ScoreLayout.SWORD_W}
          h={ScoreLayout.SWORD_H}
          sprite={ScoreArt.SWORD_LEFT}
        />
        <sprite
          x={ScoreLayout.SWORD_RIGHT_X}
          y={ScoreLayout.SWORD_Y}
          w={ScoreLayout.SWORD_W}
          h={ScoreLayout.SWORD_H}
          sprite={ScoreArt.SWORD_RIGHT}
        />
      </layer>

      <layer x={0} y={0} w={ScoreLayout.PANEL_W} h={ScoreLayout.PANEL_H}>
        <text
          x="center"
          y={ScoreLayout.SARADOMIN_TEXT_Y}
          w={ScoreLayout.SCORE_W}
          h={ScoreLayout.SCORE_H}
          font={ScoreFonts.LINE}
          color={ScoreColor.LINE}
          align="center"
          valign="middle"
          text="Saradomin: 0"
        />
        <model
          x={ScoreLayout.BANNER_LEFT_X}
          y={ScoreLayout.SARADOMIN_BANNER_Y}
          w={ScoreBanner.W}
          h={ScoreBanner.H}
          model={ScoreBanner.SARADOMIN}
          zoom={ScoreBanner.ZOOM}
        />
        <model
          x={ScoreLayout.BANNER_RIGHT_X}
          y={ScoreLayout.SARADOMIN_BANNER_Y}
          w={ScoreBanner.W}
          h={ScoreBanner.H}
          model={ScoreBanner.SARADOMIN}
          zoom={ScoreBanner.ZOOM}
        />
      </layer>

      <layer x={0} y={0} w={ScoreLayout.PANEL_W} h={ScoreLayout.PANEL_H}>
        <text
          x="center"
          y={ScoreLayout.ZAMORAK_TEXT_Y}
          w={ScoreLayout.SCORE_W}
          h={ScoreLayout.SCORE_H}
          font={ScoreFonts.LINE}
          color={ScoreColor.LINE}
          align="center"
          valign="middle"
          text="Zamorak: 0"
        />
        <model
          x={ScoreLayout.BANNER_LEFT_X}
          y={ScoreLayout.ZAMORAK_BANNER_Y}
          w={ScoreBanner.W}
          h={ScoreBanner.H}
          model={ScoreBanner.ZAMORAK}
          zoom={ScoreBanner.ZOOM}
        />
        <model
          x={ScoreLayout.BANNER_RIGHT_X}
          y={ScoreLayout.ZAMORAK_BANNER_Y}
          w={ScoreBanner.W}
          h={ScoreBanner.H}
          model={ScoreBanner.ZAMORAK}
          zoom={ScoreBanner.ZOOM}
        />
      </layer>

      <sprite
        x={ScoreLayout.CLOSE_X}
        y={ScoreLayout.CLOSE_Y}
        w={ScoreLayout.CLOSE_W}
        h={ScoreLayout.CLOSE_H}
        sprite={ScoreArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, ScoreArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, ScoreArt.CLOSE);
        }}
      />
    </layer>
  );
}
