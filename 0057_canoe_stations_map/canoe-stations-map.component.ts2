      <sprite x={Layout.COM_60_X} y={Layout.COM_60_Y} w={Layout.COM_60_W} h={Layout.COM_60_H} sprite={CanoeArt.CLOSE} />
      <layer
        x={Layout.CANOE_STATIONS_CLOSE_BUTTON_X}
        y={Layout.CANOE_STATIONS_CLOSE_BUTTON_Y}
        w={Layout.CANOE_STATIONS_CLOSE_BUTTON_W}
        h={Layout.CANOE_STATIONS_CLOSE_BUTTON_H}
        hide
      >
        <sprite
          x={Layout.CANOE_STATIONS_CLOSE_X}
          y={Layout.CANOE_STATIONS_CLOSE_Y}
          w={Layout.CANOE_STATIONS_CLOSE_W}
          h={Layout.CANOE_STATIONS_CLOSE_H}
          sprite={CanoeArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
