import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  CastlewarsColor,
  CastlewarsDodge,
  CastlewarsFonts,
  CastlewarsModels,
  CastlewarsSideways,
  Plate,
  PlateRows,
  Scoreboard,
  Timer,
} from './castlewars-status-overlay.constants';
import { castlewarsOverlaySaradomin } from './castlewars-status-overlay-saradomin.helpers';

const timerHost1 = createRef('0058_castlewars_status_overlay_saradomin_timer_host1');

const timerHost2 = createRef('0058_castlewars_status_overlay_saradomin_timer_host2');

const timerHost3 = createRef('0058_castlewars_status_overlay_saradomin_timer_host3');

const timerHost4 = createRef('0058_castlewars_status_overlay_saradomin_timer_host4');

const plate = createRef('castlewars_status_overlay_saradomin_plate');
const scoreboard = createRef('castlewars_status_overlay_saradomin_scoreboard');

const mainDoor = createRef('castlewars_status_overlay_saradomin_maindoor0');
const sideDoor = createRef('castlewars_status_overlay_saradomin_sidedoor1');
const tunnel1 = createRef('castlewars_status_overlay_saradomin_tunnel12');
const tunnel2 = createRef('castlewars_status_overlay_saradomin_tunnel23');
const catapult = createRef('castlewars_status_overlay_saradomin_catapult4');
const barricades = createRef('castlewars_status_overlay_saradomin_barricades5');
const saradominFlag = createRef('castlewars_status_overlay_saradomin_saradominflag6');
const zamorakFlag = createRef('castlewars_status_overlay_saradomin_zamorakflag7');
const saradominScore = createRef('castlewars_status_overlay_saradomin_saradominscore8');
const zamorakScore = createRef('castlewars_status_overlay_saradomin_zamorakscore9');
const timer = createRef('castlewars_status_overlay_saradomin_timer10');

export function CastlewarsStatusOverlaySaradomin(): Component {
  useInterval(
    () =>
      overlayRelayout(timerHost1, plate, CastlewarsDodge.PLATE, Anchor.LEFT, Anchor.TOP, CastlewarsSideways.ALLOWED),
    timerHost1,
  );
  useInterval(
    () =>
      overlayRelayout(
        timerHost2,
        scoreboard,
        CastlewarsDodge.SCOREBOARD,
        Anchor.LEFT,
        Anchor.TOP,
        CastlewarsSideways.ALLOWED,
      ),
    timerHost2,
  );
  useInterval(
    () =>
      castlewarsOverlaySaradomin(
        mainDoor,
        sideDoor,
        tunnel1,
        tunnel2,
        catapult,
        barricades,
        saradominFlag,
        zamorakFlag,
        saradominScore,
        zamorakScore,
        timer,
      ),
    timerHost3,
  );
  useInterval(
    () =>
      overlayRelayout(timerHost4, timer, CastlewarsDodge.TIMER, Anchor.RIGHT, Anchor.BOTTOM, CastlewarsSideways.FIXED),
    timerHost4,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill">
        <layer w="fill" h="fill" ref={timerHost1}>
          <layer ref={plate} x={Plate.X} y={Plate.Y} w={Plate.W} h={Plate.H}>
            <model
              x={PlateRows.MAIN_DOOR.ICON_X}
              y={PlateRows.MAIN_DOOR.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.MAIN_DOOR}
              zoom={PlateRows.MAIN_DOOR.ZOOM}
              pitch={Plate.PITCH}
            />
            <text
              ref={mainDoor}
              x={Plate.LABEL_X}
              y={PlateRows.MAIN_DOOR.LABEL_Y}
              w={PlateRows.MAIN_DOOR.LABEL_W}
              h={PlateRows.MAIN_DOOR.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />

            <model
              x={PlateRows.SIDE_DOOR.ICON_X}
              y={PlateRows.SIDE_DOOR.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.SIDE_DOOR}
              zoom={PlateRows.SIDE_DOOR.ZOOM}
              pitch={Plate.PITCH}
            />
            <text
              ref={sideDoor}
              x={Plate.LABEL_X}
              y={PlateRows.SIDE_DOOR.LABEL_Y}
              w={PlateRows.SIDE_DOOR.LABEL_W}
              h={PlateRows.SIDE_DOOR.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />

            <model
              x={PlateRows.TUNNEL_1.ICON_X}
              y={PlateRows.TUNNEL_1.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.TUNNEL}
              zoom={PlateRows.TUNNEL_1.ZOOM}
              pitch={Plate.PITCH}
            />
            <text
              ref={tunnel1}
              x={Plate.LABEL_X}
              y={PlateRows.TUNNEL_1.LABEL_Y}
              w={PlateRows.TUNNEL_1.LABEL_W}
              h={PlateRows.TUNNEL_1.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />

            <model
              x={PlateRows.TUNNEL_2.ICON_X}
              y={PlateRows.TUNNEL_2.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.TUNNEL}
              zoom={PlateRows.TUNNEL_2.ZOOM}
              pitch={Plate.PITCH}
            />
            <text
              ref={tunnel2}
              x={Plate.LABEL_X}
              y={PlateRows.TUNNEL_2.LABEL_Y}
              w={PlateRows.TUNNEL_2.LABEL_W}
              h={PlateRows.TUNNEL_2.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />

            <model
              x={PlateRows.CATAPULT.ICON_X}
              y={PlateRows.CATAPULT.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.CATAPULT}
              zoom={PlateRows.CATAPULT.ZOOM}
              pitch={Plate.PITCH}
            />
            <text
              ref={catapult}
              x={Plate.LABEL_X}
              y={PlateRows.CATAPULT.LABEL_Y}
              w={PlateRows.CATAPULT.LABEL_W}
              h={PlateRows.CATAPULT.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />

            <model
              x={PlateRows.BARRICADES.ICON_X}
              y={PlateRows.BARRICADES.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.BARRICADE}
              zoom={PlateRows.BARRICADES.ZOOM}
              pitch={PlateRows.BARRICADES.PITCH}
              yaw={PlateRows.BARRICADES.YAW}
              offsetY={PlateRows.BARRICADES.OFFSET_Y}
            />
            <text
              ref={barricades}
              x={Plate.LABEL_X}
              y={PlateRows.BARRICADES.LABEL_Y}
              w={PlateRows.BARRICADES.LABEL_W}
              h={PlateRows.BARRICADES.LABEL_H}
              font={CastlewarsFonts.LABEL}
              valign="bottom"
              color={CastlewarsColor.STATUS}
            />
          </layer>
        </layer>

        <layer w="fill" h="fill" ref={timerHost2}>
          <layer ref={scoreboard} x={0} y={0} w={Scoreboard.W} h={Scoreboard.H}>
            <layer x="center" y={Scoreboard.BAR_Y} w={Scoreboard.BAR_W} h={Scoreboard.BAR_H} ref={timerHost3}>
              <text
                ref={zamorakScore}
                x={0}
                y="center"
                w="50%"
                h="fill"
                font={CastlewarsFonts.LABEL}
                align="center"
                shadow
                color={CastlewarsColor.PLAIN}
              />
              <text
                ref={saradominScore}
                x="right"
                y="center"
                w="50%"
                h="fill"
                font={CastlewarsFonts.LABEL}
                align="center"
                shadow
                color={CastlewarsColor.PLAIN}
              />
            </layer>

            <model
              x={Scoreboard.SARADOMIN_BANNER_X}
              y={Scoreboard.BANNER_Y}
              w={Scoreboard.BANNER_W}
              h={Scoreboard.BANNER_H}
              model={CastlewarsModels.SARADOMIN_BANNER}
              zoom={Scoreboard.BANNER_ZOOM}
              yaw={Scoreboard.SARADOMIN_BANNER_YAW}
            />
            <model
              x={Scoreboard.ZAMORAK_BANNER_X}
              y={Scoreboard.BANNER_Y}
              w={Scoreboard.BANNER_W}
              h={Scoreboard.BANNER_H}
              model={CastlewarsModels.ZAMORAK_BANNER}
              zoom={Scoreboard.BANNER_ZOOM}
              yaw={Scoreboard.ZAMORAK_BANNER_YAW}
            />

            <text
              ref={saradominFlag}
              x={Scoreboard.SARADOMIN_FLAG_X}
              y={Scoreboard.FLAG_Y}
              w={Scoreboard.FLAG_W}
              h={Scoreboard.FLAG_H}
              font={CastlewarsFonts.LABEL}
              align="center"
              valign="middle"
              color={CastlewarsColor.STATUS}
            />
            <text
              x={Scoreboard.DASH_X}
              y={Scoreboard.FLAG_Y}
              w={Scoreboard.DASH_W}
              h={Scoreboard.FLAG_H}
              text="-"
              font={CastlewarsFonts.LABEL}
              align="center"
              valign="middle"
              shadow
              color={CastlewarsColor.PLAIN}
            />
            <text
              ref={zamorakFlag}
              x={Scoreboard.ZAMORAK_FLAG_X}
              y={Scoreboard.FLAG_Y}
              w={Scoreboard.FLAG_W}
              h={Scoreboard.FLAG_H}
              font={CastlewarsFonts.LABEL}
              align="center"
              valign="middle"
              color={CastlewarsColor.STATUS}
            />

            <text
              x="center"
              y={Scoreboard.MESSAGE_Y}
              w="fill"
              h={Scoreboard.MESSAGE_H}
              font={CastlewarsFonts.BANNER}
              align="center"
              valign="bottom"
              shadow
              color={CastlewarsColor.BANNER}
            />
          </layer>
        </layer>

        <layer x={0} y={0} w={Timer.DODGER_W} h={Timer.DODGER_H} ref={timerHost4}>
          <text
            ref={timer}
            x={{ right: Timer.RIGHT }}
            y={{ bottom: Timer.BOTTOM }}
            w={Timer.W}
            h={Timer.H}
            font={CastlewarsFonts.LABEL}
            align="center"
            color={CastlewarsColor.PLAIN}
          />
        </layer>
      </layer>
    </layer>
  );
}
