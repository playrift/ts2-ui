import { createRef, onMounted, onUpdated, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import {
  CastlewarsColor,
  CastlewarsDodge,
  CastlewarsFonts,
  CastlewarsModels,
  CastlewarsSideways,
  Plate,
  PlateRows,
  Scoreboard,
  Timer,
} from './castlewars-status-overlay.constants';
import {
  barricadesLabel,
  catapultLabel,
  flagLabel,
  mainDoorLabel,
  sideDoorLabel,
  tunnelLabel,
} from './castlewars-status-overlay-saradomin.helpers';

const timerHost1 = createRef('0058_castlewars_status_overlay_saradomin_timer_host1');

const timerHost2 = createRef('0058_castlewars_status_overlay_saradomin_timer_host2');

const timerHost4 = createRef('0058_castlewars_status_overlay_saradomin_timer_host4');

const plate = createRef('castlewars_status_overlay_saradomin_plate');
const scoreboard = createRef('castlewars_status_overlay_saradomin_scoreboard');

const timer = createRef('castlewars_status_overlay_saradomin_timer10');

export function CastlewarsStatusOverlaySaradomin(): Component {
  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill">
        <layer
          w="fill"
          h="fill"
          ref={timerHost1}
          onLoad={() =>
            overlayInit(timerHost1, plate, CastlewarsDodge.PLATE, Anchor.LEFT, Anchor.TOP, CastlewarsSideways.ALLOWED)
          }
        >
          <layer ref={plate} x={Plate.X} y={Plate.Y} w={Plate.W} h={Plate.H}>
            <model
              x={PlateRows.MAIN_DOOR.ICON_X}
              y={PlateRows.MAIN_DOOR.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.MAIN_DOOR}
              zoom={PlateRows.MAIN_DOOR.ZOOM}
              pitch={Plate.PITCH}
            />

            <model
              x={PlateRows.SIDE_DOOR.ICON_X}
              y={PlateRows.SIDE_DOOR.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.SIDE_DOOR}
              zoom={PlateRows.SIDE_DOOR.ZOOM}
              pitch={Plate.PITCH}
            />

            <model
              x={PlateRows.TUNNEL_1.ICON_X}
              y={PlateRows.TUNNEL_1.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.TUNNEL}
              zoom={PlateRows.TUNNEL_1.ZOOM}
              pitch={Plate.PITCH}
            />

            <model
              x={PlateRows.TUNNEL_2.ICON_X}
              y={PlateRows.TUNNEL_2.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.TUNNEL}
              zoom={PlateRows.TUNNEL_2.ZOOM}
              pitch={Plate.PITCH}
            />

            <model
              x={PlateRows.CATAPULT.ICON_X}
              y={PlateRows.CATAPULT.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.CATAPULT}
              zoom={PlateRows.CATAPULT.ZOOM}
              pitch={Plate.PITCH}
            />

            <model
              x={PlateRows.BARRICADES.ICON_X}
              y={PlateRows.BARRICADES.ICON_Y}
              w={Plate.ICON_W}
              h={Plate.ICON_H}
              model={CastlewarsModels.BARRICADE}
              zoom={PlateRows.BARRICADES.ZOOM}
              pitch={PlateRows.BARRICADES.PITCH}
              yaw={PlateRows.BARRICADES.YAW}
              offsetY={PlateRows.BARRICADES.OFFSET_Y}
            />

            <PlateLabels />
          </layer>
        </layer>

        <layer
          w="fill"
          h="fill"
          ref={timerHost2}
          onLoad={() =>
            overlayInit(
              timerHost2,
              scoreboard,
              CastlewarsDodge.SCOREBOARD,
              Anchor.LEFT,
              Anchor.TOP,
              CastlewarsSideways.ALLOWED,
            )
          }
        >
          <layer ref={scoreboard} x={0} y={0} w={Scoreboard.W} h={Scoreboard.H}>
            <model
              x={Scoreboard.SARADOMIN_BANNER_X}
              y={Scoreboard.BANNER_Y}
              w={Scoreboard.BANNER_W}
              h={Scoreboard.BANNER_H}
              model={CastlewarsModels.SARADOMIN_BANNER}
              zoom={Scoreboard.BANNER_ZOOM}
              yaw={Scoreboard.SARADOMIN_BANNER_YAW}
            />
            <model
              x={Scoreboard.ZAMORAK_BANNER_X}
              y={Scoreboard.BANNER_Y}
              w={Scoreboard.BANNER_W}
              h={Scoreboard.BANNER_H}
              model={CastlewarsModels.ZAMORAK_BANNER}
              zoom={Scoreboard.BANNER_ZOOM}
              yaw={Scoreboard.ZAMORAK_BANNER_YAW}
            />

            <text
              x={Scoreboard.DASH_X}
              y={Scoreboard.FLAG_Y}
              w={Scoreboard.DASH_W}
              h={Scoreboard.FLAG_H}
              text="-"
              font={CastlewarsFonts.LABEL}
              align="center"
              valign="middle"
              shadow
              color={CastlewarsColor.PLAIN}
            />

            <text
              x="center"
              y={Scoreboard.MESSAGE_Y}
              w="fill"
              h={Scoreboard.MESSAGE_H}
              font={CastlewarsFonts.BANNER}
              align="center"
              valign="bottom"
              shadow
              color={CastlewarsColor.BANNER}
            />

            <ScoreboardLabels />
          </layer>
        </layer>

        <layer
          x={0}
          y={0}
          w={Timer.DODGER_W}
          h={Timer.DODGER_H}
          ref={timerHost4}
          onLoad={() =>
            overlayInit(timerHost4, timer, CastlewarsDodge.TIMER, Anchor.RIGHT, Anchor.BOTTOM, CastlewarsSideways.FIXED)
          }
        >
          <text
            static
            ref={timer}
            x={{ right: Timer.RIGHT }}
            y={{ bottom: Timer.BOTTOM }}
            w={Timer.W}
            h={Timer.H}
            font={CastlewarsFonts.LABEL}
            align="center"
            color={CastlewarsColor.PLAIN}
          />
        </layer>
      </layer>
    </layer>
  );
}

function PlateLabels(): Component {
  const mainDoorHealth: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_MAINDOOR);
  const sideDoorUnlocked: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_SIDEDOOR);
  const tunnel1Cleared: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_TUNNEL1);
  const tunnel2Cleared: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_TUNNEL2);
  const catapultDestroyed: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_CATAPULT);
  const worldClient: Int = useServerState(Varbits.CASTLEWARS_WORLD_CLIENT);
  const barricadesInside: Int = useServerState(Varbits.CASTLEWARS_BARRICADES_INSIDE);
  const barricadesOutside: Int = useServerState(Varbits.CASTLEWARS_BARRICADES_OUTSIDE);

  return (
    <>
      <text
        x={Plate.LABEL_X}
        y={PlateRows.MAIN_DOOR.LABEL_Y}
        w={PlateRows.MAIN_DOOR.LABEL_W}
        h={PlateRows.MAIN_DOOR.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={mainDoorLabel(mainDoorHealth)}
      />
      <text
        x={Plate.LABEL_X}
        y={PlateRows.SIDE_DOOR.LABEL_Y}
        w={PlateRows.SIDE_DOOR.LABEL_W}
        h={PlateRows.SIDE_DOOR.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={sideDoorLabel(sideDoorUnlocked)}
      />
      <text
        x={Plate.LABEL_X}
        y={PlateRows.TUNNEL_1.LABEL_Y}
        w={PlateRows.TUNNEL_1.LABEL_W}
        h={PlateRows.TUNNEL_1.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={tunnelLabel(tunnel1Cleared)}
      />
      <text
        x={Plate.LABEL_X}
        y={PlateRows.TUNNEL_2.LABEL_Y}
        w={PlateRows.TUNNEL_2.LABEL_W}
        h={PlateRows.TUNNEL_2.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={tunnelLabel(tunnel2Cleared)}
      />
      <text
        x={Plate.LABEL_X}
        y={PlateRows.CATAPULT.LABEL_Y}
        w={PlateRows.CATAPULT.LABEL_W}
        h={PlateRows.CATAPULT.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={catapultLabel(catapultDestroyed)}
      />
      <text
        x={Plate.LABEL_X}
        y={PlateRows.BARRICADES.LABEL_Y}
        w={PlateRows.BARRICADES.LABEL_W}
        h={PlateRows.BARRICADES.LABEL_H}
        font={CastlewarsFonts.LABEL}
        valign="bottom"
        color={CastlewarsColor.STATUS}
        text={barricadesLabel(worldClient, barricadesInside, barricadesOutside)}
      />
    </>
  );
}

function ScoreboardLabels(): Component {
  const saradominFlagState: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_FLAG);
  const zamorakFlagState: Int = useServerState(Varbits.CASTLEWARS_ZAMORAK_FLAG);
  const saradominScore: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_SCORE);
  const zamorakScore: Int = useServerState(Varbits.CASTLEWARS_ZAMORAK_SCORE);
  const minutes: string = `${stringOf(useServerState(Varps.CASTLEWARS_TIMER))} Min`;

  onMounted(() => (timer.props = { text: minutes }));
  onUpdated(() => (timer.props = { text: minutes }));

  return (
    <>
      <layer x="center" y={Scoreboard.BAR_Y} w={Scoreboard.BAR_W} h={Scoreboard.BAR_H}>
        <text
          x={0}
          y="center"
          w="50%"
          h="fill"
          font={CastlewarsFonts.LABEL}
          align="center"
          shadow
          color={CastlewarsColor.PLAIN}
          text={`Zamorak = ${stringOf(zamorakScore)}`}
        />
        <text
          x="right"
          y="center"
          w="50%"
          h="fill"
          font={CastlewarsFonts.LABEL}
          align="center"
          shadow
          color={CastlewarsColor.PLAIN}
          text={`${stringOf(saradominScore)} = Saradomin`}
        />
      </layer>
      <text
        x={Scoreboard.SARADOMIN_FLAG_X}
        y={Scoreboard.FLAG_Y}
        w={Scoreboard.FLAG_W}
        h={Scoreboard.FLAG_H}
        font={CastlewarsFonts.LABEL}
        align="center"
        valign="middle"
        color={CastlewarsColor.STATUS}
        text={flagLabel(saradominFlagState)}
      />
      <text
        x={Scoreboard.ZAMORAK_FLAG_X}
        y={Scoreboard.FLAG_Y}
        w={Scoreboard.FLAG_W}
        h={Scoreboard.FLAG_H}
        font={CastlewarsFonts.LABEL}
        align="center"
        valign="middle"
        color={CastlewarsColor.STATUS}
        text={flagLabel(zamorakFlagState)}
      />
    </>
  );
}
