export function mainDoorLabel(health: Int): string {
  if (health > 0) {
    return `Health ${stringOf(health)}%`;
  }
  return `<col=ff0000>Health ${stringOf(health)}%</col>`;
}

export function sideDoorLabel(unlocked: Int): string {
  return unlocked === 1 ? '<col=ff0000>Unlocked</col>' : 'Locked';
}

export function tunnelLabel(cleared: Int): string {
  return cleared === 1 ? '<col=ff0000>Cleared</col>' : 'Collapsed';
}

export function catapultLabel(destroyed: Int): string {
  return destroyed === 1 ? '<col=ff0000>Destroyed</col>' : 'Operational';
}

export function barricadesLabel(worldClient: Int, inside: Int, outside: Int): string {
  if (worldClient === 1) {
    return `${stringOf(inside)}/10 Inside<br>${stringOf(outside)}/7 Outside`;
  }
  return `${stringOf(inside)}/10 Barricades`;
}

export function flagLabel(state: Int): string {
  if (state === 0) {
    return 'Safe';
  } else if (state === 1) {
    return '<col=ff0000>Taken</col>';
  } else if (state === 2) {
    return '<col=ffff00>Dropped</col>';
  }
  return '';
}
