import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

export function castlewarsOverlaySaradomin(
  mainDoor: ComponentId,
  sideDoor: ComponentId,
  tunnel1: ComponentId,
  tunnel2: ComponentId,
  catapult: ComponentId,
  barricades: ComponentId,
  saradominFlag: ComponentId,
  zamorakFlag: ComponentId,
  saradominScore: ComponentId,
  zamorakScore: ComponentId,
  timer: ComponentId,
): void {
  const doorHealth: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_MAINDOOR);
  if (doorHealth > 0) {
    mainDoor.text = `Health ${stringOf(doorHealth)}%`;
  } else {
    mainDoor.text = `<col=ff0000>Health ${stringOf(doorHealth)}%</col>`;
  }

  if (useServerState(Varbits.CASTLEWARS_SARADOMIN_SIDEDOOR) === 1) {
    sideDoor.text = '<col=ff0000>Unlocked</col>';
  } else {
    sideDoor.text = 'Locked';
  }

  if (useServerState(Varbits.CASTLEWARS_SARADOMIN_TUNNEL1) === 1) {
    tunnel1.text = '<col=ff0000>Cleared</col>';
  } else {
    tunnel1.text = 'Collapsed';
  }

  if (useServerState(Varbits.CASTLEWARS_SARADOMIN_TUNNEL2) === 1) {
    tunnel2.text = '<col=ff0000>Cleared</col>';
  } else {
    tunnel2.text = 'Collapsed';
  }

  if (useServerState(Varbits.CASTLEWARS_SARADOMIN_CATAPULT) === 1) {
    catapult.text = '<col=ff0000>Destroyed</col>';
  } else {
    catapult.text = 'Operational';
  }

  const inside: Int = useServerState(Varbits.CASTLEWARS_BARRICADES_INSIDE);
  if (useServerState(Varbits.CASTLEWARS_WORLD_CLIENT) === 1) {
    const outside: Int = useServerState(Varbits.CASTLEWARS_BARRICADES_OUTSIDE);
    barricades.text = `${stringOf(inside)}/10 Inside<br>${stringOf(outside)}/7 Outside`;
  } else {
    barricades.text = `${stringOf(inside)}/10 Barricades`;
  }

  const saradomin: Int = useServerState(Varbits.CASTLEWARS_SARADOMIN_FLAG);
  if (saradomin === 0) {
    saradominFlag.text = 'Safe';
  } else if (saradomin === 1) {
    saradominFlag.text = '<col=ff0000>Taken</col>';
  } else if (saradomin === 2) {
    saradominFlag.text = '<col=ffff00>Dropped</col>';
  } else {
    saradominFlag.text = '';
  }

  const zamorak: Int = useServerState(Varbits.CASTLEWARS_ZAMORAK_FLAG);
  if (zamorak === 0) {
    zamorakFlag.text = 'Safe';
  } else if (zamorak === 1) {
    zamorakFlag.text = '<col=ff0000>Taken</col>';
  } else if (zamorak === 2) {
    zamorakFlag.text = '<col=ffff00>Dropped</col>';
  } else {
    zamorakFlag.text = '';
  }

  saradominScore.text = `${stringOf(useServerState(Varbits.CASTLEWARS_SARADOMIN_SCORE))} = Saradomin`;
  zamorakScore.text = `Zamorak = ${stringOf(useServerState(Varbits.CASTLEWARS_ZAMORAK_SCORE))}`;

  timer.text = `${stringOf(useServerState(Varps.CASTLEWARS_TIMER))} Min`;
}
