import { CS2, createRef, useState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { dialogueMayAdvance } from '../lib/lib.dialogue';
import { Fonts } from '../lib/game/fonts';
import { onMobile } from '../lib/lib.helpers';

const LABEL = Fonts.Q8_FULL;

enum ChatColors {
  NAME = 0x800000,
  CONTINUE = 0x0000ff,
  CONTINUE_HOVER = 0xffffff,
  BODY = 0x000000,
}

enum AdvanceKey {
  SPACE = 83,
}

const ADVANCE_DEBOUNCE = 20;

enum DialogueGate {
  NO_TOPLEVEL = -1,
  CHATBOX = 162,
}

const continueLine = createRef('chat_both_continue');

function advanceFeedback(line: ComponentId): void {
  if (CS2.if_text_get(line).length === 0) {
    return;
  }
  CS2.if_resume_pausebutton(line);
  line.text = 'Please wait...';
  line.color = ChatColors.CONTINUE;
}

export function ChatBoth(): Component {
  return (
    <layer x={{ center: 1 }} y="center" w={506} h={129}>
      <layer x={{ center: -1 }} y={{ center: 1 }} w={481} h={110}>
        <model x={35} y={43} w={32} h={32} zoom={796} pitch={40} yaw={1882} />
        <model x={415} y={43} w={32} h={32} zoom={796} pitch={40} yaw={166} />

        <layer x="center" y="center" w={479} h={96}>
          <text x={{ center: 1 }} y={0} w={289} h={17} font={LABEL} color={ChatColors.NAME} align="center" />
          <text
            ref={continueLine}
            x={{ center: 1 }}
            y={80}
            w={289}
            h={17}
            font={LABEL}
            color={ChatColors.CONTINUE}
            align="center"
            continueOp
            hover={{ color: ChatColors.CONTINUE_HOVER }}
          />
          <text
            x={{ center: 1 }}
            y={16}
            w={289}
            h={67}
            font={LABEL}
            color={ChatColors.BODY}
            align="center"
            valign="middle"
            lineHeight={16}
          />
        </layer>
      </layer>

      <ChatBothAdvance />
    </layer>
  );
}

export function ChatBothAdvance(): Component {
  const [deadline, setDeadline] = useState(0);

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        onKey={(event) => {
          if (clientClock() < deadline) {
            return;
          }
          if (dialogueMayAdvance(DialogueGate.NO_TOPLEVEL, DialogueGate.CHATBOX) === false) {
            return;
          }
          if (event.keyCode !== AdvanceKey.SPACE) {
            return;
          }
          advanceFeedback(continueLine);
          setDeadline(clientClock() + ADVANCE_DEBOUNCE);
        }}
        onClick={() => {
          if (clientClock() < deadline) {
            return;
          }
          advanceFeedback(continueLine);
          setDeadline(clientClock() + ADVANCE_DEBOUNCE);
        }}
      />
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      onKey={(event) => {
        if (clientClock() < deadline) {
          return;
        }
        if (dialogueMayAdvance(DialogueGate.NO_TOPLEVEL, DialogueGate.CHATBOX) === false) {
          return;
        }
        if (event.keyCode !== AdvanceKey.SPACE) {
          return;
        }
        advanceFeedback(continueLine);
        setDeadline(clientClock() + ADVANCE_DEBOUNCE);
      }}
    />
  );
}
