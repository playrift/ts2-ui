import { Fonts } from '../lib/game/fonts';

const LABEL = Fonts.Q8_FULL;

enum ChatColors {
  NAME = 0x800000,
  CONTINUE = 0x0000ff,
  CONTINUE_HOVER = 0xffffff,
  BODY = 0x000000,
}

export function ChatBoth(): Component {
  return (
    <layer x={{ center: 1 }} y="center" w={506} h={129}>
      <layer x={{ center: -1 }} y={{ center: 1 }} w={481} h={110}>
        <model x={35} y={43} w={32} h={32} zoom={796} pitch={40} yaw={1882} />
        <model x={415} y={43} w={32} h={32} zoom={796} pitch={40} yaw={166} />

        <layer x="center" y="center" w={479} h={96}>
          <text x={{ center: 1 }} y={0} w={289} h={17} font={LABEL} color={ChatColors.NAME} align="center" />
          <text
            x={{ center: 1 }}
            y={80}
            w={289}
            h={17}
            font={LABEL}
            color={ChatColors.CONTINUE}
            align="center"
            continueOp
            hover={{ color: ChatColors.CONTINUE_HOVER }}
          />
          <text
            x={{ center: 1 }}
            y={16}
            w={289}
            h={67}
            font={LABEL}
            color={ChatColors.BODY}
            align="center"
            valign="middle"
            lineHeight={16}
          />
        </layer>
      </layer>
    </layer>
  );
}
