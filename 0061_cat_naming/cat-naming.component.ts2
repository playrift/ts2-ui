import {
  ARROW_H,
  ARROW_W,
  Arrows,
  Camera,
  CatArt,
  CatColor,
  CatFonts,
  CatModel,
  CatText,
  Dials,
  EYE_PITCH,
  EYE_YAW,
  Eyes,
  Layout,
  LETTER_H,
  LETTER_W,
  MODEL_SIZE,
} from './cat-naming.constants';

export function CatNaming(): Component {
  return (
    <>
      <model
        x={Layout.KITTEN_X}
        y={Layout.KITTEN_Y}
        w={MODEL_SIZE}
        h={MODEL_SIZE}
        model={CatModel.KITTEN}
        zoom={Camera.KITTEN.ZOOM}
        pitch={Camera.KITTEN.PITCH}
      />

      <rect x={Layout.BEZEL_X} y={Layout.BEZEL_Y} w={Layout.BEZEL_W} h={Layout.BEZEL_H} fill color={CatColor.BEZEL} />

      <rect x={Layout.FIELD_X} y={Layout.FIELD_Y} w={Layout.FIELD_W} h={Layout.FIELD_H} fill color={CatColor.FIELD} />

      <layer x={Layout.CL1_X} y={Layout.CL1_Y} w={Layout.CL1_W} h={Layout.CL1_H} />

      {Dials.map((dial) => (
        <model
          x={dial.modelX}
          y={dial.modelY}
          w={MODEL_SIZE}
          h={MODEL_SIZE}
          model={CatModel.DIAL}
          zoom={Camera.DIAL.ZOOM}
          pitch={Camera.DIAL.PITCH}
        />
      ))}

      {Dials.map((dial) => (
        <text
          x={dial.letterX}
          y={dial.letterY}
          w={LETTER_W}
          h={LETTER_H}
          text={CatText.DIAL}
          font={CatFonts.BODY}
          color={CatColor.DIAL}
          align="center"
        />
      ))}

      <model
        x={Layout.BANNER_X}
        y={Layout.BANNER_Y}
        w={MODEL_SIZE}
        h={MODEL_SIZE}
        model={CatModel.BANNER}
        zoom={Camera.BANNER.ZOOM}
        pitch={Camera.BANNER.PITCH}
        yaw={Camera.BANNER.YAW}
      />

      {Arrows.map((arrow) => (
        <sprite
          x={arrow.x}
          y={arrow.y}
          w={ARROW_W}
          h={ARROW_H}
          sprite={arrow.left ? CatArt.ARROW_LEFT : CatArt.ARROW_RIGHT}
        />
      ))}

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={CatArt.CLOSE} />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={CatText.TITLE}
        font={CatFonts.BODY}
        color={CatColor.GOLD}
        align="center"
        shadow
      />

      <rect
        x={Layout.ENTER_PLATE_X}
        y={Layout.ENTER_PLATE_Y}
        w={Layout.ENTER_PLATE_W}
        h={Layout.ENTER_PLATE_H}
        fill
        color={CatColor.FIELD}
      />

      <text
        x={Layout.ENTER_X}
        y={Layout.ENTER_Y}
        w={Layout.ENTER_W}
        h={Layout.ENTER_H}
        text={CatText.ENTER}
        font={CatFonts.BODY}
        color={CatColor.GOLD}
        align="center"
      />

      <model
        x={Layout.HEAD_LEFT_X}
        y={Layout.HEAD_LEFT_Y}
        w={Layout.HEAD_LEFT_W}
        h={Layout.HEAD_LEFT_H}
        model={CatModel.HEAD_LEFT}
        zoom={Camera.HEAD_LEFT.ZOOM}
        pitch={Camera.HEAD_LEFT.PITCH}
        yaw={Camera.HEAD_LEFT.YAW}
      />

      <model
        x={Layout.HEAD_RIGHT_X}
        y={Layout.HEAD_RIGHT_Y}
        w={Layout.HEAD_RIGHT_W}
        h={Layout.HEAD_RIGHT_H}
        model={CatModel.HEAD_RIGHT}
        zoom={Camera.HEAD_RIGHT.ZOOM}
        pitch={Camera.HEAD_RIGHT.PITCH}
        yaw={Camera.HEAD_RIGHT.YAW}
      />

      {Eyes.map((eye) => (
        <model
          x={eye.x}
          y={eye.y}
          w={MODEL_SIZE}
          h={MODEL_SIZE}
          model={CatModel.EYE}
          zoom={eye.zoom}
          pitch={EYE_PITCH}
          yaw={EYE_YAW}
        />
      ))}

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_LIT_X}
          y={Layout.CLOSE_LIT_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CatArt.CLOSE_LIT}
        />
      </layer>
    </>
  );
}
