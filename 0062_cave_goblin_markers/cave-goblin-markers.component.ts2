import { Camera, Layout, MarkerModel, MarkerSprites } from './cave-goblin-markers.constants';

export function CaveGoblinMarkers(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.BACKGROUND_X}
        y={Layout.BACKGROUND_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MarkerModel.BACKGROUND}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <model
        x={Layout.SYMBOL_X}
        y={Layout.SYMBOL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MarkerModel.SYMBOL}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MarkerSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={MarkerSprites.CLOSE_OVER}
        />
      </layer>
    </layer>
  );
}
