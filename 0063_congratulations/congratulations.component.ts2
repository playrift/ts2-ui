import { closeInterface } from '../lib/lib.helpers';
import { Colors, Fonts, Models, Sprites } from './congratulations.constants';

export function Congratulations(): Component {
  return (
    <>
      <model x="center" y={{ center: -20 }} w={32} h={28} model={Models.TOP_ORNAMENT} zoom={604} pitch={400} />

      <text
        x="center"
        y={95}
        w={176}
        h={17}
        text="Congratulations!"
        font={Fonts.TITLE}
        color={Colors.TITLE}
        shadow
        align="center"
      />

      <text x="center" y={117} w={320} h={20} font={Fonts.BODY} color={Colors.BODY} align="center" />

      <model x={75} y={155} w={105} h={105} zoom={300} />

      <model x={355} y={205} w={32} h={32} model={Models.CORNER_DECORATION} zoom={273} pitch={500} yaw={138} />

      <text
        x="center"
        y={140}
        w={180}
        h={15}
        text="You are awarded:"
        font={Fonts.BODY}
        color={Colors.AWARDED}
        align="center"
      />

      <text x="center" y={157} w={170} h={15} font={Fonts.BODY} color={Colors.BODY} align="center" />
      <text x="center" y={172} w={170} h={15} font={Fonts.BODY} color={Colors.BODY} align="center" />

      <sprite
        right={90}
        y={84}
        w={26}
        h={23}
        sprite={Sprites.CLOSE}
        hover={{ sprite: Sprites.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />
    </>
  );
}
