import { CloseButton } from '../0735_league_3_fragments/close-button.component';
import { RankSprites } from './league-rank.constants';
import { RankFrame } from './rank-frame.component';
import { RankProgressBar } from './rank-progress-bar.component';
import { RankLadder } from './rank-ladder.component';

export function LeagueRank(): Component {
  return (
    <layer x="center" y="center" w={300} h={314}>
      <RankFrame />

      <layer x={9} y={39} w={{ fill: 18 }} h={33}>
        <RankProgressBar />
      </layer>

      <sprite x="center" y={61} w={{ fill: 10 }} h={36} sprite={RankSprites.DIVIDER} tiling />

      <layer x="center" y={82} w={{ fill: 12 }} h={226}>
        <RankLadder />
      </layer>

      <CloseButton />

      <layer x={7} y={7} w={21} h={21} />
      <layer w="fill" h="fill" hide noClickThrough />
      <layer x={0} y={29} w={80} h={70} />
    </layer>
  );
}
