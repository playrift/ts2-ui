import { NoLadder } from './ladders.data';
import { scaled } from '../lib/lib.engine';
import { League, RankColors, RankLayout } from './league-rank.constants';
import { Leagues } from './leagues.data';

export function leagueAccent(league: Int): Int {
  if (league < League.ONE || league > League.FIVE) {
    return RankColors.TITLE_FALLBACK;
  }
  const style = Leagues.get(league as League);
  if (style === null) {
    return RankColors.TITLE_FALLBACK;
  }
  return style.accent;
}

export function leagueLadder(league: Int): List<Int> {
  const style = Leagues.get(league as League);
  if (style === null) {
    return NoLadder;
  }
  return style.thresholds;
}

export function nextRankThreshold(points: Int, thresholds: List<Int>): Int {
  if (points < thresholds.at(0)) {
    return thresholds.at(0);
  }
  if (points < thresholds.at(1)) {
    return thresholds.at(1);
  }
  if (points < thresholds.at(2)) {
    return thresholds.at(2);
  }
  if (points < thresholds.at(3)) {
    return thresholds.at(3);
  }
  if (points < thresholds.at(4)) {
    return thresholds.at(4);
  }
  if (points < thresholds.at(5)) {
    return thresholds.at(5);
  }
  if (points < thresholds.at(6)) {
    return thresholds.at(6);
  }
  return -1;
}

export function markerAt(threshold: Int, top: Int, span: Int): Int {
  const at: Int = scaled(threshold, top, span);
  if (at <= 2) {
    return 0;
  }
  if (at >= span) {
    return RankLayout.BAR_W;
  }
  return at + 2;
}
