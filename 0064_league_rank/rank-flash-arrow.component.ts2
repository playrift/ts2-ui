import { useRef, useState } from 'ts2';

import { scaled } from '../lib/lib.engine';
import { Flash, RankSprites } from './league-rank.constants';

export function RankFlashArrow(): Component {
  const arrow = useRef();
  const [fade, setFade] = useState(0);
  const [rising, setRising] = useState(1);

  return (
    <sprite
      ref={arrow}
      w="fill"
      h="fill"
      sprite={RankSprites.FLASH_ARROW}
      onTimer={() => {
        const step: Int = rising === 1 ? fade + 1 : fade - 1;
        setFade(step);
        if (step === Flash.STEPS || step === 0) {
          setRising(1 - rising);
        }
        arrow.transparency = scaled(step, Flash.STEPS, Flash.MAX);
      }}
    />
  );
}
