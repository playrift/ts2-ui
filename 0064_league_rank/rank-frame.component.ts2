import { onMounted, useServerState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { SteelBorder } from '../lib/steel-border.component';
import { RankSounds, RankVarbits } from './league-rank.constants';
import { leagueAccent } from './league-rank.helpers';

export function RankFrame(): Component {
  const league: Int = useServerState(RankVarbits.LEAGUE);

  onMounted(() => {
    playSound(RankSounds.OPEN);
  });

  return (
    <layer w="fill" h="fill">
      <SteelBorder title="League Ranks" flags={1} titleColor={leagueAccent(league)} />
    </layer>
  );
}
