import { useServerState } from 'ts2';

import { League, RankLayout, RankRows, RankVarbits, RankVarps } from './league-rank.constants';
import { Leagues, type LeagueStyle } from './leagues.data';
import { RankRung } from './rank-rung.component';

export function RankLadder(): Component {
  const league: Int = useServerState(RankVarbits.LEAGUE);
  const points: Int = useServerState(RankVarps.POINTS);
  const style: LeagueStyle | null = Leagues.get(league as League);
  if (style === null) {
    return null;
  }

  if (style.thresholds === -1) {
    return null;
  }

  return (
    <>
      {RankRows.map((row) => (
        <layer x={0} bottom={row * RankLayout.ROW_H} w="fill" h={RankLayout.ROW_H}>
          <RankRung
            index={row}
            points={points}
            thresholds={style.thresholds as unknown as List<Int>}
            icons={style.icons as unknown as List<ItemName>}
            font={style.font as Font}
            shadow={style.shadow}
            textColor={style.textColour}
          />
        </layer>
      ))}
    </>
  );
}
