import { useServerState } from 'ts2';

import { Leagues, RankLayout, RankParams, RankRows, RankVarbits, RankVarps } from './league-rank.constants';
import { RankRung } from './rank-rung.component';

export function RankLadder(): Component {
  const league: Int = useServerState(RankVarbits.LEAGUE);
  const points: Int = useServerState(RankVarps.POINTS);
  const style: Row = Leagues.get(league);
  const ladder: Int = style.int(RankParams.THRESHOLDS);

  if (ladder === -1) {
    return null;
  }

  const thresholds: List<Int> = ladder as unknown as List<Int>;
  const icons: List<ItemName> = style.int(RankParams.ICONS) as unknown as List<ItemName>;
  const font: Font = style.int(RankParams.FONT) as Font;
  const shadow: Boolean = style.int(RankParams.SHADOW) === 1 ? true : false;
  const textColor: Int = style.int(RankParams.TEXT_COLOUR);

  return (
    <>
      {RankRows.map((row) => (
        <layer x={0} bottom={row * RankLayout.ROW_H} w="fill" h={RankLayout.ROW_H}>
          <RankRung
            index={row}
            points={points}
            thresholds={thresholds}
            icons={icons}
            font={font}
            shadow={shadow}
            textColor={textColor}
          />
        </layer>
      ))}
    </>
  );
}
