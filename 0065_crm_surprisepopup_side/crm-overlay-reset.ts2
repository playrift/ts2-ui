import { CS2, useState } from 'ts2';
import { crmOverlayActive } from '../lib/game/varcs';

export function releaseCrmOverlaySlot(slot: Int): void {
  const [active, setActive] = useState(crmOverlayActive);
  setActive(CS2.bit_clear(active, slot));
}

export enum CrmOverlaySlots {
  SIDE = 1,
  MAIN = 2,
}
