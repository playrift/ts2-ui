import { onMounted, useRef } from 'ts2';
import { onMobile, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { CrmOverlaySlots, releaseCrmOverlaySlot } from '../0065_crm_surprisepopup_side/crm-overlay-reset';
import { CloseSprites, CrmColors, Dimmer, Layout } from './crm-surprisepopup-main.constants';

export function CrmSurprisePopupMain(): Component {
  onMounted(() => {
    releaseCrmOverlaySlot(CrmOverlaySlots.MAIN);
  });

  const icon = useRef();

  return (
    <layer x="center" y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <layer x="center" y="center" w="fill" h="fill" />

      <rect x="center" y="center" w="fill" h="fill" hide fill color={CrmColors.DIM} transparency={Dimmer.IDLE} />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_HIT}
        h={Layout.CLOSE_HIT}
        hide
        noClickThrough
        onMouseEnter={() => {
          graphicSwapperUnlessMobile(icon, CloseSprites.OVER);
        }}
        onMouseLeave={() => {
          graphicSwapperUnlessMobile(icon, CloseSprites.OUT);
        }}
      >
        <sprite
          ref={icon}
          x="center"
          y="center"
          w={Layout.CLOSE_WIDTH}
          h={Layout.CLOSE_HEIGHT}
          sprite={CloseSprites.OUT}
        />
      </layer>
    </layer>
  );
}
