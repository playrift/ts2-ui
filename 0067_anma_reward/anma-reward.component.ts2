import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { opsound } from '../lib/lib.helpers';
import { OP_SOUND_MASK, PressableStoneSkin } from './pressable-stone-skin.component';
import { AvaModel, Layout, ModelView, RewardColor, RewardFont } from './anma-reward.constants';

export function AnmaReward(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Ava's Devices" />

      <layer
        x={Layout.BUTTON_X}
        y={Layout.ROW0_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        options={['Buy-1', 'Buy-5', 'Buy-X', 'Buy-All']}
        optionSubject="<col=ff9040>Attractor</col>"
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <PressableStoneSkin w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        <model
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          model={AvaModel.ATTRACTOR}
          zoom={ModelView.ZOOM}
          pitch={ModelView.PITCH}
          yaw={ModelView.YAW}
          offsetX={ModelView.OFFSET_X}
        />
      </layer>

      <text
        x={Layout.TEXT_X}
        y={Layout.ROW0_Y}
        w={Layout.TEXT_W}
        h={Layout.TITLE_H}
        text="Ava's Attractor"
        font={RewardFont.TITLE}
        color={RewardColor.TITLE}
        shadow
      />
      <text
        x={Layout.TEXT_X}
        y={Layout.BODY0_Y}
        w={Layout.TEXT_W}
        h={Layout.BODY_H}
        font={RewardFont.BODY}
        color={RewardColor.BODY}
        shadow
        valign="middle"
      />

      <layer
        x={Layout.BUTTON_X}
        y={Layout.ROW1_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        options={['Buy-1', 'Buy-5', 'Buy-X', 'Buy-All']}
        optionSubject="<col=ff9040>Accumulator</col>"
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <PressableStoneSkin w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        <model
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          model={AvaModel.ACCUMULATOR}
          zoom={ModelView.ZOOM}
          pitch={ModelView.PITCH}
          yaw={ModelView.YAW}
          offsetX={ModelView.OFFSET_X}
        />
      </layer>

      <text
        x={Layout.TEXT_X}
        y={Layout.ROW1_Y}
        w={Layout.TEXT_W}
        h={Layout.TITLE_H}
        text="Ava's Accumulator"
        font={RewardFont.TITLE}
        color={RewardColor.TITLE}
        shadow
      />
      <text
        x={Layout.TEXT_X}
        y={Layout.BODY1_Y}
        w={Layout.TEXT_W}
        h={Layout.BODY_H}
        font={RewardFont.BODY}
        color={RewardColor.BODY}
        shadow
        valign="middle"
      />

      <layer
        x={Layout.BUTTON_X}
        y={Layout.ROW2_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        options={['Buy-1', 'Buy-5', 'Buy-X', 'Buy-All']}
        optionSubject="<col=ff9040>Assembler</col>"
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <PressableStoneSkin />
        <model
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          model={AvaModel.ASSEMBLER}
          zoom={ModelView.ZOOM}
          pitch={ModelView.PITCH}
          yaw={ModelView.YAW}
          offsetX={ModelView.OFFSET_X}
        />
      </layer>

      <text
        x={Layout.TEXT_X}
        y={Layout.ROW2_Y}
        w={Layout.TEXT_W}
        h={Layout.TITLE_H}
        text="Ava's Assembler"
        font={RewardFont.TITLE}
        color={RewardColor.TITLE}
        shadow
      />
      <text
        x={Layout.TEXT_X}
        y={Layout.BODY2_Y}
        w={Layout.TEXT_W}
        h={Layout.BODY_H}
        font={RewardFont.BODY}
        color={RewardColor.BODY}
        shadow
        valign="middle"
      />
    </>
  );
}
