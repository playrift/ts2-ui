import { useRef } from 'ts2';
import { BUTTON_CORNER, Sprites } from './slayer-partner.constants';

export function PartnerButtonFrame(): Component {
  const back = useRef();
  const topLeft = useRef();
  const topRight = useRef();
  const bottomLeft = useRef();
  const bottomRight = useRef();
  const left = useRef();
  const top = useRef();
  const right = useRef();
  const bottom = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      onMouseOver={() => {
        back.sprite = Sprites.BUTTON_BACK_IN;
        topLeft.sprite = Sprites.BUTTON_IN_TL;
        topRight.sprite = Sprites.BUTTON_IN_TR;
        bottomLeft.sprite = Sprites.BUTTON_IN_BL;
        bottomRight.sprite = Sprites.BUTTON_IN_BR;
        left.sprite = Sprites.BUTTON_IN_LEFT;
        top.sprite = Sprites.BUTTON_IN_TOP;
        right.sprite = Sprites.BUTTON_IN_RIGHT;
        bottom.sprite = Sprites.BUTTON_IN_BOTTOM;
      }}
      onMouseLeave={() => {
        back.sprite = Sprites.BUTTON_BACK_OUT;
        topLeft.sprite = Sprites.BUTTON_OUT_TL;
        topRight.sprite = Sprites.BUTTON_OUT_TR;
        bottomLeft.sprite = Sprites.BUTTON_OUT_BL;
        bottomRight.sprite = Sprites.BUTTON_OUT_BR;
        left.sprite = Sprites.BUTTON_OUT_LEFT;
        top.sprite = Sprites.BUTTON_OUT_TOP;
        right.sprite = Sprites.BUTTON_OUT_RIGHT;
        bottom.sprite = Sprites.BUTTON_OUT_BOTTOM;
      }}
    >
      <sprite
        ref={back}
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        sprite={Sprites.BUTTON_BACK_OUT}
        tiling
      />

      <sprite
        ref={topLeft}
        x="left"
        y="top"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_TL}
        tiling
      />
      <sprite
        ref={topRight}
        x="right"
        y="top"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_TR}
        tiling
      />
      <sprite
        ref={bottomLeft}
        x="left"
        y="bottom"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_BL}
        tiling
      />
      <sprite
        ref={bottomRight}
        x="right"
        y="bottom"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_BR}
        tiling
      />

      <sprite
        ref={left}
        x="left"
        y={BUTTON_CORNER}
        w={BUTTON_CORNER}
        h={{ fill: BUTTON_CORNER * 2 }}
        sprite={Sprites.BUTTON_OUT_LEFT}
        tiling
      />
      <sprite
        ref={top}
        x={BUTTON_CORNER}
        y="top"
        w={{ fill: BUTTON_CORNER * 2 }}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_TOP}
        tiling
      />
      <sprite
        ref={right}
        x="right"
        y={BUTTON_CORNER}
        w={BUTTON_CORNER}
        h={{ fill: BUTTON_CORNER * 2 }}
        sprite={Sprites.BUTTON_OUT_RIGHT}
        tiling
      />
      <sprite
        ref={bottom}
        x={BUTTON_CORNER}
        y="bottom"
        w={{ fill: BUTTON_CORNER * 2 }}
        h={BUTTON_CORNER}
        sprite={Sprites.BUTTON_OUT_BOTTOM}
        tiling
      />
    </layer>
  );
}
