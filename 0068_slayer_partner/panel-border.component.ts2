import { CS2 } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { Colors, Fonts, Sprites } from './slayer-partner.constants';

export function PanelBorder({ title }: { title: String }): Component {
  const isMobile = CS2.on_mobile();

  return (
    <layer w="fill" h="fill">
      <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={Sprites.BORDER_BACKING} tiling />

      <text
        x="center"
        y={6}
        w={{ fill: 12 }}
        h={24}
        text={title}
        font={Fonts.TITLE}
        color={Colors.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      <sprite x="left" y="top" w={25} h={30} sprite={Sprites.BORDER_CORNER_TL} tiling />
      <sprite x="right" y="top" w={25} h={30} sprite={Sprites.BORDER_CORNER_TR} tiling />
      <sprite x="left" y="bottom" w={25} h={30} sprite={Sprites.BORDER_CORNER_BL} tiling />
      <sprite x="right" y="bottom" w={25} h={30} sprite={Sprites.BORDER_CORNER_BR} tiling />

      <sprite x={-15} y="center" w={36} h={{ fill: 60 }} sprite={Sprites.BORDER_EDGE_LEFT} tiling />
      <sprite x={{ right: -15 }} y="center" w={36} h={{ fill: 60 }} sprite={Sprites.BORDER_EDGE_RIGHT} tiling />
      <sprite x="center" y={-15} w={{ fill: 50 }} h={36} sprite={Sprites.BORDER_EDGE_TOP} tiling />
      <sprite x="center" y={{ bottom: -15 }} w={{ fill: 50 }} h={36} sprite={Sprites.BORDER_EDGE_BOTTOM} tiling />

      <sprite x="center" y={14} w={{ fill: 10 }} h={26} sprite={Sprites.BORDER_DIVIDER} tiling />

      {isMobile ? (
        <sprite
          x={{ right: 1 }}
          y={1}
          w={33}
          h={33}
          sprite={Sprites.CLOSE_MOBILE}
          tiling
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />
      ) : (
        <sprite
          x={{ right: 3 }}
          y={6}
          w={26}
          h={23}
          sprite={Sprites.CLOSE_BASE}
          tiling
          hover={{ sprite: Sprites.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />
      )}
    </layer>
  );
}
