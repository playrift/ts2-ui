import { useState } from 'ts2';
import { BUTTON_CORNER, Sprites } from './slayer-partner.constants';

export function PartnerButtonFrame(): Component {
  const [pressed, setPressed] = useState(0);

  return (
    <layer
      w="fill"
      h="fill"
      onMouseEnter={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
    >
      <sprite
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        sprite={pressed !== 0 ? Sprites.BUTTON_BACK_IN : Sprites.BUTTON_BACK_OUT}
        tiling
      />

      <sprite
        x="left"
        y="top"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_TL : Sprites.BUTTON_OUT_TL}
        tiling
      />
      <sprite
        x="right"
        y="top"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_TR : Sprites.BUTTON_OUT_TR}
        tiling
      />
      <sprite
        x="left"
        y="bottom"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_BL : Sprites.BUTTON_OUT_BL}
        tiling
      />
      <sprite
        x="right"
        y="bottom"
        w={BUTTON_CORNER}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_BR : Sprites.BUTTON_OUT_BR}
        tiling
      />

      <sprite
        x="left"
        y={BUTTON_CORNER}
        w={BUTTON_CORNER}
        h={{ fill: BUTTON_CORNER * 2 }}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_LEFT : Sprites.BUTTON_OUT_LEFT}
        tiling
      />
      <sprite
        x={BUTTON_CORNER}
        y="top"
        w={{ fill: BUTTON_CORNER * 2 }}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_TOP : Sprites.BUTTON_OUT_TOP}
        tiling
      />
      <sprite
        x="right"
        y={BUTTON_CORNER}
        w={BUTTON_CORNER}
        h={{ fill: BUTTON_CORNER * 2 }}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_RIGHT : Sprites.BUTTON_OUT_RIGHT}
        tiling
      />
      <sprite
        x={BUTTON_CORNER}
        y="bottom"
        w={{ fill: BUTTON_CORNER * 2 }}
        h={BUTTON_CORNER}
        sprite={pressed !== 0 ? Sprites.BUTTON_IN_BOTTOM : Sprites.BUTTON_OUT_BOTTOM}
        tiling
      />
    </layer>
  );
}
