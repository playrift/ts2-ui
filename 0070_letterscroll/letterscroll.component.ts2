import { useRef } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import {
  LetterArt,
  LetterBar,
  LetterCamera,
  LetterFonts,
  LetterModel,
  Layout,
  LineTops,
} from './letterscroll.constants';

export function Letterscroll(): Component {
  const page = useRef();

  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={LetterModel.SCROLL}
        pitch={LetterCamera.PITCH}
        zoom={LetterCamera.ZOOM}
      />

      <layer
        ref={page}
        x={Layout.PAGE_X}
        y={Layout.PAGE_Y}
        w={Layout.PAGE_W}
        h={Layout.PAGE_H}
        scrollHeight={Layout.PAGE_SCROLL_H}
      >
        {LineTops.map((top) => (
          <text x={Layout.LINE_X} y={top} w={{ fill: Layout.LINE_W_INSET }} h={Layout.LINE_H} font={LetterFonts.LINE} />
        ))}
      </layer>

      <layer x={Layout.BAR_X} y={Layout.BAR_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
        <ScrollbarVertical
          content={page}
          track={LetterBar.TRACK}
          capTopSprite={LetterBar.CAP_TOP}
          thumbSprite={LetterBar.THUMB}
          capBottomSprite={LetterBar.CAP_BOTTOM}
          arrowUp={LetterBar.ARROW_UP}
          arrowDown={LetterBar.ARROW_DOWN}
        />
      </layer>

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={LetterArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, LetterArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, LetterArt.CLOSE)}
      />
    </>
  );
}
