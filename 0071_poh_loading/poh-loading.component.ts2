import { LoadingArt, LoadingColors, LoadingFonts, LoadingLayout } from './poh-loading.constants';

export function PohLoading(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill" noClickThrough>
      <rect x="center" y="center" w="fill" h="fill" fill color={LoadingColors.BACKDROP} />

      <text
        x="center"
        y={{ center: LoadingLayout.CAPTION_CENTER_OFFSET }}
        w="fill"
        h={LoadingLayout.CAPTION_H}
        text="There's no place like home..."
        font={LoadingFonts.CAPTION}
        color={LoadingColors.CAPTION}
        align="center"
        shadow
      />

      <sprite x="center" y="center" w={LoadingLayout.PHOTO_W} h={LoadingLayout.PHOTO_H} sprite={LoadingArt.HOUSE} />

      <rect
        x="center"
        y="center"
        w={LoadingLayout.FRAME_W}
        h={LoadingLayout.FRAME_H}
        color={LoadingColors.FRAME_OUTER}
      />

      <rect
        x="center"
        y="center"
        w={LoadingLayout.PHOTO_W}
        h={LoadingLayout.PHOTO_H}
        color={LoadingColors.FRAME_INNER}
      />
    </layer>
  );
}
