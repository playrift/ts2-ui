import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, SAIL_MODEL, SailArt, sailingMenuRef } from './sailing-menu.constants';
import { SailingCrossLayer } from './sailing-crosses.component';

export const sailingMenuUi = (): UI => (
  <ui ref={sailingMenuRef} x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
    <model
      x="center"
      y={{ center: Layout.MODEL_DY }}
      w={Layout.MODEL_WH}
      h={Layout.MODEL_WH}
      model={SAIL_MODEL}
      zoom={Layout.MODEL_ZOOM}
      pitch={Layout.MODEL_PITCH}
      offsetY={Layout.MODEL_OFFSET_Y}
    />
    <sprite
      x={{ right: Layout.CLOSE_INSET }}
      y={Layout.CLOSE_INSET}
      w={Layout.CLOSE_W}
      h={Layout.CLOSE_H}
      sprite={SailArt.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={(event) => graphicSwapper(event.component, SailArt.CLOSE_HOVER)}
      onMouseLeave={(event) => graphicSwapper(event.component, SailArt.CLOSE)}
    />
    <SailingCrossLayer />
  </ui>
);
