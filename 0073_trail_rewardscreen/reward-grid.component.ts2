import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { Colors, Grid, TrailReward } from './trail-rewardscreen.constants';

export function RewardGrid(): Component {
  const rewards = useInventory(TrailReward.INV);

  return (
    <layer w="fill" h="fill">
      {rewards.map(
        (item, slot) =>
          item !== -1 && (
            <sprite
              x={slot % Grid.COLUMNS === 0 ? 'left' : slot % Grid.COLUMNS === 1 ? 'center' : 'right'}
              y={(slot / Grid.COLUMNS) * Grid.ROW_PITCH}
              w={Grid.SLOT_WIDTH}
              h={Grid.SLOT_HEIGHT}
              item={item}
              itemCount={rewards.count(slot)}
              outline={1}
              shadowColor={Colors.SLOT_SHADOW}
              options={['', '', '', '', '', '', '', '', '', 'Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
            />
          ),
      )}
    </layer>
  );
}
