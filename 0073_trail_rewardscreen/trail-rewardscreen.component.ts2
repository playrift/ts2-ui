import { closeInterface } from '../lib/lib.helpers';
import { RewardGrid } from './reward-grid.component';
import { Grid, Panel, TrailArt, TrailModels } from './trail-rewardscreen.constants';

export function TrailRewardScreen(): Component {
  return (
    <>
      <layer x="center" y="center" w={Panel.WIDTH} h={Panel.HEIGHT}>
        <model x={232} y={158} w={32} h={32} model={TrailModels.CASKET} zoom={640} pitch={512} />

        <RewardGrid x={240} y={88} w={Grid.BOX_WIDTH} h={Grid.BOX_HEIGHT} />
      </layer>

      <model x={174} y={212} w={32} h={32} model={TrailModels.ORNAMENT} zoom={914} pitch={104} yaw={761} />

      <sprite
        x={{ right: 13 }}
        y={13}
        w={26}
        h={23}
        sprite={TrailArt.CLOSE}
        hover={{ sprite: TrailArt.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />
    </>
  );
}
