import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { RAFFLE_UNAVAILABLE, RaffleColor, RaffleFade, RaffleFonts, RaffleLayout } from './gim-raffle.constants';

export function GimRaffle(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={RaffleColor.SCRIM} fill transparency={RaffleFade.SCRIM} />

      <layer x="center" y="center" w={RaffleLayout.WINDOW_W} h={RaffleLayout.WINDOW_H}>
        <layer w="fill" h="fill" />

        <layer
          x={RaffleLayout.BODY_X}
          y={RaffleLayout.BODY_Y}
          w={{ fill: RaffleLayout.BODY_W_INSET }}
          h={RaffleLayout.BODY_H}
        >
          <layer
            x="right"
            y={RaffleLayout.RIGHT_Y}
            w={{ fill: RaffleLayout.RIGHT_W_INSET }}
            h={{ fill: RaffleLayout.RIGHT_H_INSET }}
          >
            <rect
              x={{ right: RaffleLayout.SHEET_RIGHT }}
              y={RaffleLayout.SHEET_Y}
              w={{ fill: RaffleLayout.SHEET_W_INSET }}
              h={{ fill: RaffleLayout.SHEET_H_INSET }}
              color={RaffleColor.SHEET}
              fill
              transparency={RaffleFade.SHEET}
            />

            <layer
              x={{ right: RaffleLayout.SHEET_RIGHT }}
              y={RaffleLayout.SHEET_Y}
              w={{ fill: RaffleLayout.SHEET_W_INSET }}
              h={{ fill: RaffleLayout.SHEET_H_INSET }}
            >
              <text
                x="center"
                y="center"
                w={{ fill: RaffleLayout.MESSAGE_INSET }}
                h={{ fill: RaffleLayout.MESSAGE_INSET }}
                text={RAFFLE_UNAVAILABLE}
                font={RaffleFonts.MESSAGE}
                color={RaffleColor.MESSAGE}
                align="center"
                valign="middle"
                lineHeight={RaffleLayout.MESSAGE_LINE_HEIGHT}
                shadow
              />

              <text
                w={RaffleLayout.BADGE_W}
                h={RaffleLayout.BADGE_H}
                font={RaffleFonts.BADGE}
                color={RaffleColor.BADGE}
                shadow
                hide
              />
            </layer>

            <layer
              x={{ right: RaffleLayout.STRIP_RIGHT }}
              y="center"
              w={RaffleLayout.STRIP_W}
              h={{ fill: RaffleLayout.STRIP_H_INSET }}
            />

            <ThinBoxEntrypoint />
          </layer>

          <layer
            x={RaffleLayout.LEFT_X}
            y={RaffleLayout.LEFT_Y}
            w={RaffleLayout.LEFT_W}
            h={{ fill: RaffleLayout.LEFT_H_INSET }}
          >
            <ThinBoxEntrypoint />
          </layer>

          <layer
            x={RaffleLayout.LEFT_X}
            y={RaffleLayout.LEFT_Y}
            w={RaffleLayout.LEFT_W}
            h={{ fill: RaffleLayout.LEFT_H_INSET }}
          >
            <layer w="fill" h="fill" />
            <layer w="fill" h="fill" />
          </layer>

          <layer
            x={{ center: -RaffleLayout.BUTTON_DX }}
            y={{ bottom: RaffleLayout.BUTTON_BOTTOM }}
            w={RaffleLayout.BUTTON_W}
            h={RaffleLayout.BUTTON_H}
            options={['*']}
          />
          <layer
            x={{ center: RaffleLayout.BUTTON_DX }}
            y={{ bottom: RaffleLayout.BUTTON_BOTTOM }}
            w={RaffleLayout.BUTTON_W}
            h={RaffleLayout.BUTTON_H}
            options={['*']}
          />
        </layer>
      </layer>
    </>
  );
}
