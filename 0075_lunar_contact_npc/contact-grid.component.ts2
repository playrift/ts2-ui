import { useRef, useServerState, useSkillBase } from 'ts2';

import { ContactTile } from './contact-tile.component';
import {
  ContactColors,
  ContactFonts,
  ContactLayout,
  ContactModels,
  ContactNames,
  ContactOffsetY,
  ContactSkills,
  ContactVarbits,
  ContactVarps,
  ContactYaw,
} from './lunar-contact-npc.constants';
import { amyContractOption, textColourSwapper } from './lunar-contact-npc.helpers';

export function ContactGrid(): Component {
  const cooking: Int = useSkillBase(ContactSkills.COOKING);
  const fishing: Int = useSkillBase(ContactSkills.FISHING);

  const handSand: Int = useServerState(ContactVarbits.HANDSAND_QUEST);
  const miscQuest: Int = useServerState(ContactVarps.MISC_QUEST);
  const abyssal: Int = useServerState(ContactVarps.ABYSSAL_MINIQUEST);
  const dreamProg: Int = useServerState(ContactVarbits.DREAM_PROG);
  const wgs: Int = useServerState(ContactVarbits.WGS);
  const zeahVisited: Int = useServerState(ContactVarbits.ZEAH_PLAYERHASVISITED);
  const mm2Master: Int = useServerState(ContactVarbits.MM2_SLAYER_MASTER);
  const watsonSpoken: Int = useServerState(ContactVarbits.TRAIL_WATSON_SPOKEN);
  const barcrawl: Int = useServerState(ContactVarps.BARCRAWL);
  const scorpcatcher: Int = useServerState(ContactVarps.SCORPCATCHER);
  const porcine: Int = useServerState(ContactVarbits.PORCINE);
  const wgsHero: Int = useServerState(ContactVarbits.WGS_HERO_PART_1_VIS);
  const contractDiscussed: Int = useServerState(ContactVarbits.CON_CONTRACT_DISCUSSED);
  const contractTier: Int = useServerState(ContactVarps.IF1);

  const amyCaption = useRef();

  const barbGuardModel: Model =
    barcrawl !== 2 && scorpcatcher < 6 ? ContactModels.BARB_GUARD_LOCKED : ContactModels.BARB_GUARD;
  const cyrisusModel: Model = dreamProg < 16 || wgs > 660 ? ContactModels.CYRISUS_LOCKED : ContactModels.CYRISUS;

  return (
    <layer w="fill" h="fill">
      <ContactTile
        x={ContactLayout.COL_0}
        y={ContactLayout.ROW_0}
        label={ContactNames.HONEST_JIMMY}
        option={ContactNames.HONEST_JIMMY}
        model={cooking < 40 ? ContactModels.JIMMY_LOCKED : ContactModels.JIMMY}
        yaw={ContactYaw.COL_0}
      />
      <ContactTile
        x={ContactLayout.COL_1}
        y={ContactLayout.ROW_0}
        label={ContactNames.BERT}
        option={ContactNames.BERT}
        model={handSand < 160 ? ContactModels.BERT_LOCKED : ContactModels.BERT}
        yaw={ContactYaw.COL_1}
      />
      <ContactTile
        x={ContactLayout.COL_2}
        y={ContactLayout.ROW_0}
        label={ContactNames.GHRIM}
        option={ContactNames.GHRIM}
        model={miscQuest < 100 ? ContactModels.GHRIM_LOCKED : ContactModels.GHRIM}
        yaw={ContactYaw.COL_2}
      />
      <ContactTile
        x={ContactLayout.COL_3}
        y={ContactLayout.ROW_0}
        label={ContactNames.DARK_MAGE}
        option={ContactNames.DARK_MAGE}
        model={abyssal < 4 ? ContactModels.DARK_MAGE_LOCKED : ContactModels.DARK_MAGE}
        yaw={ContactYaw.COL_3}
      />
      <ContactTile
        x={ContactLayout.COL_4}
        y={ContactLayout.ROW_0}
        label={ContactNames.LANTHUS}
        option={ContactNames.LANTHUS}
        model={ContactModels.LANTHUS}
        yaw={ContactYaw.COL_4}
      />
      <ContactTile
        x={ContactLayout.COL_6}
        y={ContactLayout.ROW_0}
        label={wgsHero !== 0 ? ContactNames.AYA : ContactNames.TURAEL}
        option={wgsHero !== 0 ? ContactNames.AYA : ContactNames.TURAEL}
        model={wgsHero !== 0 ? ContactModels.AYA : ContactModels.TURAEL}
        yaw={ContactYaw.COL_6}
      />
      <ContactTile
        x={ContactLayout.COL_0}
        y={ContactLayout.ROW_1}
        label={wgsHero === 1 ? ContactNames.ACHTRYN : ContactNames.MAZCHNA}
        option={wgsHero === 1 ? ContactNames.ACHTRYN : ContactNames.MAZCHNA}
        model={wgsHero === 1 ? ContactModels.ACHTRYN : ContactModels.MAZCHNA}
        yaw={ContactYaw.COL_0}
      />
      <ContactTile
        x={ContactLayout.COL_1}
        y={ContactLayout.ROW_1}
        label={ContactNames.VANNAKA}
        option={ContactNames.VANNAKA}
        model={ContactModels.VANNAKA}
        yaw={ContactYaw.COL_1}
      />
      <ContactTile
        x={ContactLayout.COL_2}
        y={ContactLayout.ROW_1}
        label={ContactNames.CHAELDAR}
        option={ContactNames.CHAELDAR}
        model={ContactModels.CHAELDAR}
        yaw={ContactYaw.COL_2}
      />
      <ContactTile
        x={ContactLayout.COL_3}
        y={ContactLayout.ROW_1}
        label={mm2Master === 1 ? ContactNames.STEVE : ContactNames.NIEVE}
        option={mm2Master === 1 ? ContactNames.STEVE : ContactNames.NIEVE}
        model={mm2Master === 1 ? ContactModels.STEVE : ContactModels.NIEVE}
        yaw={ContactYaw.COL_3}
      />
      <ContactTile
        x={ContactLayout.COL_4}
        y={ContactLayout.ROW_1}
        label={wgsHero !== 0 ? ContactNames.KURADAL : ContactNames.DURADEL}
        option={wgsHero !== 0 ? ContactNames.KURADAL : ContactNames.DURADEL}
        model={wgsHero !== 0 ? ContactModels.KURADAL : ContactModels.DURADEL}
        yaw={ContactYaw.COL_4}
      />
      <ContactTile
        x={ContactLayout.COL_5}
        y={ContactLayout.ROW_1}
        label={ContactNames.KRYSTILIA}
        option={ContactNames.KRYSTILIA}
        model={ContactModels.KRYSTILIA}
        yaw={ContactYaw.COL_5}
      />
      <ContactTile
        x={ContactLayout.COL_0}
        y={ContactLayout.ROW_2}
        label={ContactNames.MURPHY}
        option={ContactNames.MURPHY}
        model={fishing < 15 ? ContactModels.MURPHY_LOCKED : ContactModels.MURPHY}
        yaw={ContactYaw.COL_0}
      />
      <ContactTile
        x={ContactLayout.COL_1}
        y={ContactLayout.ROW_2}
        label={ContactNames.CYRISUS}
        option={ContactNames.CYRISUS}
        model={cyrisusModel}
        yaw={ContactYaw.COL_1}
      />
      <ContactTile
        x={ContactLayout.COL_2}
        y={ContactLayout.ROW_2}
        label={ContactNames.SMOGGY}
        option={ContactNames.SMOGGY}
        model={zeahVisited === 0 ? ContactModels.SMOGGY_LOCKED : ContactModels.SMOGGY}
        yaw={ContactYaw.COL_2}
      />
      <ContactTile
        x={ContactLayout.COL_3}
        y={ContactLayout.ROW_2}
        label={ContactNames.GINEA_LABEL}
        option={ContactNames.GINEA_OP}
        model={ContactModels.GINEA}
        yaw={ContactYaw.COL_3}
      />
      <ContactTile
        x={ContactLayout.COL_4}
        y={ContactLayout.ROW_2}
        label={ContactNames.WATSON}
        option={ContactNames.WATSON}
        model={watsonSpoken === 0 ? ContactModels.WATSON_LOCKED : ContactModels.WATSON}
        yaw={ContactYaw.COL_4}
        offsetY={ContactOffsetY.WATSON}
      />
      <ContactTile
        x={ContactLayout.COL_5}
        y={ContactLayout.ROW_2}
        label={ContactNames.BARBARIAN_GUARD}
        option={ContactNames.BARBARIAN_GUARD}
        model={barbGuardModel}
        yaw={ContactYaw.COL_5}
      />
      <ContactTile
        x={ContactLayout.COL_0}
        y={ContactLayout.ROW_3}
        label={ContactNames.RANDOM}
        option={ContactNames.RANDOM}
        model={dreamProg < 28 ? ContactModels.RANDOM_LOCKED : ContactModels.RANDOM}
        yaw={ContactYaw.COL_3}
        modelH={ContactLayout.RANDOM_MODEL_H}
        offsetY={ContactOffsetY.RANDOM}
        captionHover={1}
      />
      <layer
        x={ContactLayout.COL_6}
        y={ContactLayout.ROW_2}
        w={ContactLayout.TILE_W}
        h={ContactLayout.TILE_H}
        options={[ContactNames.AMY, amyContractOption(contractDiscussed, contractTier)]}
        onMouseEnter={() => textColourSwapper(amyCaption, ContactColors.CAPTION_HOVER)}
        onMouseLeave={() => textColourSwapper(amyCaption, ContactColors.CAPTION)}
      >
        <model
          x={0}
          y={0}
          w={ContactLayout.TILE_W}
          h={ContactLayout.TILE_H}
          model={contractDiscussed === 0 ? ContactModels.AMY_LOCKED : ContactModels.AMY}
          zoom={ContactLayout.ZOOM}
          yaw={ContactYaw.COL_6}
        />
        <text
          ref={amyCaption}
          x={0}
          y="bottom"
          w={ContactLayout.TILE_W}
          h={ContactLayout.CAPTION_H}
          text={ContactNames.AMY}
          font={ContactFonts.CAPTION}
          color={ContactColors.CAPTION}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
      <ContactTile
        x={ContactLayout.COL_6}
        y={ContactLayout.ROW_1}
        label={ContactNames.KONAR}
        option={ContactNames.KONAR}
        model={ContactModels.KONAR}
        yaw={ContactYaw.COL_6}
        zoom={ContactLayout.ZOOM_KONAR}
        offsetY={ContactOffsetY.KONAR}
      />
      <ContactTile
        x={ContactLayout.COL_5}
        y={ContactLayout.ROW_0}
        label={ContactNames.SPRIA}
        option={ContactNames.SPRIA}
        model={porcine < 40 ? ContactModels.SPRIA_LOCKED : ContactModels.SPRIA}
        yaw={ContactYaw.COL_5}
      />
    </layer>
  );
}
