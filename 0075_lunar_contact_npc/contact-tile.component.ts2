import { useRef } from 'ts2';

import { ContactColors, ContactFonts, ContactLayout } from './lunar-contact-npc.constants';
import { textColourSwapper } from './lunar-contact-npc.helpers';

export function ContactTile({
  label,
  option,
  model,
  yaw,
  zoom = 1200,
  offsetY = 0,
  modelH = 125,
  captionHover = 0,
}: {
  label: String;
  option: String;
  model: Model;
  yaw: Int;
  zoom?: Int;
  offsetY?: Int;
  modelH?: Int;
  captionHover?: Int;
}): Component {
  const caption = useRef();

  return (
    <layer
      w={ContactLayout.TILE_W}
      h={ContactLayout.TILE_H}
      options={[option]}
      onMouseEnter={() => textColourSwapper(caption, ContactColors.CAPTION_HOVER)}
      onMouseLeave={() => textColourSwapper(caption, ContactColors.CAPTION)}
    >
      <model x={0} y={0} w={ContactLayout.TILE_W} h={modelH} model={model} zoom={zoom} yaw={yaw} offsetY={offsetY} />

      <text
        ref={caption}
        x={0}
        y="bottom"
        w={ContactLayout.TILE_W}
        h={ContactLayout.CAPTION_H}
        text={label}
        font={ContactFonts.CAPTION}
        color={ContactColors.CAPTION}
        align="center"
        valign="middle"
        shadow
        onMouseEnter={
          captionHover === 1 ? (event) => textColourSwapper(event.component, ContactColors.CAPTION_HOVER) : undefined
        }
        onMouseLeave={
          captionHover === 1 ? (event) => textColourSwapper(event.component, ContactColors.CAPTION) : undefined
        }
      />
    </layer>
  );
}
