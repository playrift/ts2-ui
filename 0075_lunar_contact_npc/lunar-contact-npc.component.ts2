import { createRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ContactGrid } from './contact-grid.component';
import { ContactLayout, ContactNames, ContactScrollbar } from './lunar-contact-npc.constants';

const contactPane = createRef('lunar_contact_pane');

export function LunarContactNpc(): Component {
  return (
    <layer x="center" y="center" w={ContactLayout.PANEL_W} h={ContactLayout.PANEL_H}>
      <SteelBorderEntrypoint title={ContactNames.TITLE} />

      <layer
        static
        ref={contactPane}
        x={ContactLayout.PANE_X}
        y={ContactLayout.PANE_Y}
        w={ContactLayout.PANE_W}
        h={ContactLayout.PANE_H}
        scrollHeight={ContactLayout.PANE_EXTENT}
      >
        <ContactGrid x="center" y={0} w="fill" h={ContactLayout.CONTENT_H} />
      </layer>

      <layer
        x={{ right: ContactLayout.BAR_RIGHT }}
        y={ContactLayout.PANE_Y}
        w={ContactLayout.BAR_W}
        h={ContactLayout.PANE_H}
      >
        <ScrollbarVertical
          content={contactPane}
          track={ContactScrollbar.TRACK}
          capTopSprite={ContactScrollbar.CAP_TOP}
          thumbSprite={ContactScrollbar.THUMB}
          capBottomSprite={ContactScrollbar.CAP_BOTTOM}
          arrowUp={ContactScrollbar.ARROW_UP}
          arrowDown={ContactScrollbar.ARROW_DOWN}
        />
      </layer>
    </layer>
  );
}
