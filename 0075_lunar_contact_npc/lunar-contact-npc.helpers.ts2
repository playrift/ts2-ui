import { ContactNames } from './lunar-contact-npc.constants';

export function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function amyContractOption(discussed: Int, tier: Int): String {
  if (discussed === 0) {
    return ContactNames.CONTRACT_NONE;
  }
  if (tier === 1) {
    return ContactNames.CONTRACT_BEGINNER;
  }
  if (tier === 2) {
    return ContactNames.CONTRACT_NOVICE;
  }
  if (tier === 3) {
    return ContactNames.CONTRACT_ADEPT;
  }
  if (tier === 4) {
    return ContactNames.CONTRACT_EXPERT;
  }
  return ContactNames.CONTRACT_NONE;
}
