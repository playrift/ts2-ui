import { useState } from 'ts2';

import { setTransparency } from '../lib/lib.components';
import {
  ActivityNames,
  GroupingColor,
  GroupingFonts,
  GroupingSprites,
  GroupingText,
  Layout,
  Transparency,
} from './grouping.constants';
import { dropdownOpen } from './grouping.refs';
import { toggleDropdown } from './grouping.state';
import { currentActivity } from './grouping-buttons.component';

export function SelectorBackdrop(): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      font={GroupingFonts.TITLE}
      color={GroupingColor.LABEL}
      align="center"
      valign="top"
      shadow
      onClick={() => closeDropdownFromBackdrop()}
    />
  );
}

function closeDropdownFromBackdrop(): void {
  const [open] = useState(dropdownOpen);
  if (open === 1) {
    toggleDropdown(0);
  }
}

export function SelectorHoverPlate(): Component {
  const [open] = useState(dropdownOpen);

  let hidden: Boolean = false;
  if (open === 1) {
    hidden = true;
  }

  return (
    <rect
      x={0}
      y={0}
      w="fill"
      h={Layout.SELECTOR_H}
      fill
      color={GroupingColor.MEMBER}
      transparency={Transparency.INVISIBLE}
      hide={hidden}
      onMouseEnter={(event) => setTransparency(event.self, Transparency.HOVERED)}
      onMouseLeave={(event) => setTransparency(event.self, Transparency.INVISIBLE)}
      onClick={() => openDropdownFromPlate()}
    />
  );
}

function openDropdownFromPlate(): void {
  const [open] = useState(dropdownOpen);
  if (open === 0) {
    toggleDropdown(1);
  }
}

export function SelectorLabel(): Component {
  const activity: Int = currentActivity();

  let label: String = GroupingText.NO_ACTIVITY;
  if (activity !== 0) {
    label = ActivityNames.get(activity) ?? GroupingText.NO_ACTIVITY;
  }

  return (
    <text
      x={Layout.SELECTOR_TEXT_X}
      y="center"
      w={{ fill: Layout.SELECTOR_TEXT_INSET }}
      h={Layout.SELECTOR_TEXT_H}
      text={label}
      font={GroupingFonts.BODY}
      color={GroupingColor.LABEL}
      align="left"
      valign="middle"
      shadow
    />
  );
}

export function SelectorArrow(): Component {
  const [open] = useState(dropdownOpen);

  return (
    <sprite
      x={{ right: Layout.ARROW_INSET }}
      y={Layout.ARROW_INSET}
      w={Layout.ARROW}
      h={Layout.ARROW}
      sprite={open === 1 ? GroupingSprites.ARROW_UP : GroupingSprites.ARROW_DOWN}
    />
  );
}
