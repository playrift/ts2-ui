import { graphicSwapper, opsound } from '../lib/lib.helpers';
import { GroupingColor, GroupingFonts, GroupingSprites, Layout, Transparency } from './grouping.constants';
import { SelectorArrow, SelectorBackdrop, SelectorHoverPlate, SelectorLabel } from './activity-selector.component';
import { ActivityDropdown } from './dropdown.component';
import { HopButton, JoinLeaveButton, TeleportButton } from './grouping-buttons.component';
import { PlayerListBox } from './player-list.component';

export function Grouping(): Component {
  return (
    <>
      <text
        x={Layout.TITLE_X}
        y={0}
        w={{ fill: Layout.TITLE_INSET }}
        h={Layout.TITLE_H}
        text="Grouping"
        font={GroupingFonts.TITLE}
        color={GroupingColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <layer
        x={{ right: Layout.BUTTON_RIGHT }}
        y={0}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        optionSubject="<col=ff9040>PvP Arena</col> options"
        options={['Open']}
        onOptionSelect={(event) => opsound(event.option, 2)}
      >
        <sprite
          x="center"
          y={Layout.BUTTON_SKIN_Y}
          w={Layout.BUTTON_SKIN_W}
          h={Layout.BUTTON_SKIN_H}
          sprite={GroupingSprites.BUTTON}
          onMouseEnter={(event) => graphicSwapper(event.component, GroupingSprites.BUTTON_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.component, GroupingSprites.BUTTON)}
        />
        <text
          x="center"
          y="center"
          w="fill"
          h={Layout.BUTTON_H}
          text="PvP Arena"
          font={GroupingFonts.BUTTON}
          color={GroupingColor.LABEL}
          align="center"
          valign="middle"
          shadow
        />
      </layer>

      <SelectorBackdrop />

      <layer x="center" y={Layout.SELECTOR_Y} w={{ fill: Layout.SELECTOR_INSET }} h={Layout.SELECTOR_H}>
        <sprite x="center" y="center" w="fill" h="fill" sprite={GroupingSprites.BACKING} tiling />
        <SelectorHoverPlate />
        <rect x={0} y={0} w="fill" h={Layout.SELECTOR_H} color={GroupingColor.OUTLINE_OUTER} />
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.SELECTOR_INNER_INSET }}
          h={Layout.SELECTOR_INNER_H}
          color={GroupingColor.OUTLINE_INNER}
          transparency={Transparency.INNER_OUTLINE}
        />
        <SelectorLabel />
        <SelectorArrow />
      </layer>

      <layer x="center" y={Layout.LIST_BOX_Y} w={{ fill: Layout.LIST_BOX_INSET }} h={{ fill: Layout.LIST_BOX_DROP }}>
        <PlayerListBox />
      </layer>

      <layer x="center" y={Layout.LIST_BOX_Y} w={{ fill: Layout.LIST_BOX_INSET }} h={Layout.DROPDOWN_H}>
        <ActivityDropdown />
      </layer>

      <text
        x={0}
        y={Layout.SUGGESTED_LABEL_Y}
        w={{ fill: Layout.SUGGESTED_LABEL_INSET }}
        h={Layout.SUGGESTED_LABEL_H}
        text="Suggested world:"
        font={GroupingFonts.BUTTON}
        color={GroupingColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <layer x={Layout.HOP_X} y={{ bottom: Layout.HOP_BOTTOM }} w={{ fill: Layout.HOP_INSET }} h={Layout.HOP_H}>
        <HopButton />
      </layer>

      <layer
        x={{ right: Layout.BUTTON_RIGHT }}
        y={{ bottom: Layout.JOIN_BOTTOM }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
      >
        <JoinLeaveButton />
      </layer>

      <layer
        x={{ right: Layout.BUTTON_RIGHT }}
        y={{ bottom: Layout.TELEPORT_BOTTOM }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
      >
        <TeleportButton />
      </layer>
    </>
  );
}
