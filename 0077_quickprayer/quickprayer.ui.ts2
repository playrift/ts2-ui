import { createRef } from 'ts2';
import { QuickPrayer } from './quickprayer.component';
import { Layout } from './quickprayer.constants';

const quickPrayerRef = createRef('quickprayer');

export const quickPrayerUi = (): UI => (
  <ui ref={quickPrayerRef} w={Layout.root.w} h={Layout.root.h}>
    <QuickPrayer />
  </ui>
);
