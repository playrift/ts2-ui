import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { DiangoArt, DiangoBackdrop, DiangoColor, DiangoFonts, DiangoLayout } from './rareitems-diango.constants';

export function RareitemsDiango(): Component {
  return (
    <>
      <model
        x={DiangoBackdrop.X}
        y={DiangoBackdrop.Y}
        w={DiangoBackdrop.W}
        h={DiangoBackdrop.H}
        model={DiangoBackdrop.MODEL}
        zoom={DiangoBackdrop.ZOOM}
        pitch={DiangoBackdrop.PITCH}
      />

      <text
        x={DiangoLayout.TITLE_X}
        y={DiangoLayout.TITLE_Y}
        w={DiangoLayout.TITLE_W}
        h={DiangoLayout.TITLE_H}
        font={DiangoFonts.TITLE}
        color={DiangoColor.TITLE}
        valign="middle"
        shadow
      />

      <sprite
        x={DiangoLayout.CLOSE_X}
        y={DiangoLayout.CLOSE_Y}
        w={DiangoLayout.CLOSE_W}
        h={DiangoLayout.CLOSE_H}
        sprite={DiangoArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, DiangoArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, DiangoArt.CLOSE)}
      />

      <layer x={DiangoLayout.LIST_X} y={DiangoLayout.LIST_Y} w={DiangoLayout.LIST_W} h={DiangoLayout.LIST_H} />

      <layer x={DiangoLayout.BAR_X} y={DiangoLayout.BAR_Y} w={DiangoLayout.BAR_W} h={DiangoLayout.BAR_H} />
    </>
  );
}
