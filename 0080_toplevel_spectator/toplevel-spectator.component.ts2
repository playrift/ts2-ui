import {
  CS2,
  Engine,
  onMounted,
  onUpdated,
  useOnResize,
  useRerenderOn,
  useServerState,
  useState,
  useUniverse,
} from 'ts2';

import { cameraZoom } from '../0016_oculus/oculus.camera';
import { EhcHooks } from '../0548_toplevel/toplevel.component';
import { Resize } from '../0548_toplevel/toplevel.constants';
import { desktopFov } from '../0548_toplevel/toplevel.helpers';
import { applyClientSettings, applySavedZoom, touchBuffBarDodgers } from '../0601_toplevel_osm/toplevel-osm.helpers';
import { Varbits } from '../lib/game/varbits';
import { toplevelMainmodalBgColour, toplevelMainmodalBgTrans } from '../lib/game/varcs';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import {
  buffBarRef,
  chatContainerRef,
  ehcListenerRef,
  floaterRef,
  gameframeRef,
  helperContentRef,
  helperDodgerRef,
  helperRef,
  hiddenRef,
  hpbarHudRef,
  hudContainerBackRef,
  hudContainerFrontRef,
  maincrmRef,
  mainmodalBackgroundsRef,
  mainmodalRef,
  mouseoverRef,
  notificationsRef,
  orbsRef,
  overlayAtmosphereRef,
  overlayHudRef,
  pmContainerRef,
  popoutRef,
  pvpIconsRef,
  side0Ref,
  side10Ref,
  side11Ref,
  side12Ref,
  side13Ref,
  side1Ref,
  side2Ref,
  side3Ref,
  side4Ref,
  side5Ref,
  side6Ref,
  side7Ref,
  side8Ref,
  side9Ref,
  sidecrmRef,
  sidemodalRef,
  statBoostsHudRef,
  uiHighlightsRef,
  viewportRef,
  viewportTrackerBackRef,
  viewportTrackerFrontRef,
  xpDropsRef,
  zeahRef,
} from './toplevel-spectator.constants';
import { spectatorHelperInit, spectatorToplevelInit } from './toplevel-spectator.helpers';

export function ToplevelSpectator(): Component {
  return (
    <>
      <layer static ref={gameframeRef} x={0} y={0} w="fill" h="fill" onLoad={() => spectatorToplevelInit()}>
        <layer static ref={viewportRef} x={0} y={0} w="fill" h="fill" contentType="worldView" />
        <layer static ref={viewportTrackerBackRef} x="center" y="center" w="fill" h="fill">
          <layer
            static
            ref={overlayAtmosphereRef}
            x="center"
            y="center"
            w="fill"
            h="fill"
            onScrollWheel={(event) => cameraZoom(event.mouseY)}
          />
          <layer static ref={hudContainerBackRef} x="center" y={0} w={{ fill: 215 }} h={{ fill: 165 }}>
            <layer static ref={hpbarHudRef} x="center" y="center" w="fill" h="fill" />
            <layer static ref={overlayHudRef} x="center" y="center" w="fill" h="fill" />
          </layer>
          <layer static ref={pvpIconsRef} x="center" y="center" w="fill" h="fill" />
        </layer>
        <layer static ref={viewportTrackerFrontRef} x="center" y="center" w="fill" h="fill">
          <layer static ref={mainmodalBackgroundsRef} x="center" y="center" w="fill" h="fill">
            <ModalBackdrop />
          </layer>
          <layer static ref={hudContainerFrontRef} x="center" y={0} w={{ fill: 215 }} h={{ fill: 165 }}>
            <layer static ref={mainmodalRef} x="center" y="center" w={Resize.MODAL_W} h={Resize.MODAL_H} />
            <layer static ref={floaterRef} x="center" y="center" w="fill" h="fill" />
          </layer>
        </layer>
        <layer static ref={hiddenRef} x={0} y={0} w={1} h={1}>
          <layer static ref={zeahRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={pmContainerRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={helperRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={helperDodgerRef} x={0} y={0} w={1} h={1} hide onLoad={() => spectatorHelperInit()} />
          <layer static ref={helperContentRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={xpDropsRef} x={0} y={0} w="fill" h="fill" hide />
          <layer static ref={orbsRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={maincrmRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={chatContainerRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={sidemodalRef} x={0} y={0} w={1} h={1} hide contentType={1354} />
          <layer static ref={side0Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side1Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side2Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side3Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side4Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side5Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side6Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side7Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side8Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side9Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side10Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side11Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side12Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={side13Ref} x={0} y={0} w={1} h={1} hide />
          <layer static ref={sidecrmRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={statBoostsHudRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={buffBarRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={notificationsRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={ehcListenerRef} x={0} y={0} w={1} h={1} hide>
            <EhcHooks />
          </layer>
          <layer static ref={mouseoverRef} x={0} y={0} w={1} h={1} hide />
          <layer static ref={uiHighlightsRef} x={0} y={0} w={1} h={1} />
        </layer>
      </layer>

      <layer static ref={popoutRef} x="right" y={0} w={300} h="fill" />

      <layer x={0} y={0} w="fill" h="fill">
        <SpectatorLayout />
      </layer>
    </>
  );
}

function SpectatorLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const buffBarHidden: Int = useServerState(Varbits.BUFF_BAR_HIDDEN);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  const [bgTrans] = useState(toplevelMainmodalBgTrans);
  const mobile: Boolean = onMobile();

  desktopFov(fovClamp, ToplevelComponents.SPECTATOR);
  const [viewW, viewH] = CS2.viewport_effective_size_get();

  let inCutscene: Boolean = false;
  if (cutscene !== 0) {
    inCutscene = true;
  }
  let buffBarShown: Boolean = false;
  if (buffBarHidden === 0 && cutscene === 0) {
    buffBarShown = true;
  }
  const sideModalUp: Boolean = CS2.if_sub_has(sidemodalRef);
  let modalMode: Int = 0;
  if (!mobile && CS2.if_sub_has(mainmodalRef)) {
    modalMode = bgTrans;
  }
  let xpDropsInset: Int = 0;
  if (mobile) {
    xpDropsInset = minimapToggle === 0 ? Resize.MOBILE_MINIMAP : Resize.MOBILE_MINIMAP_COLLAPSED;
  }

  onMounted(() => placeSpectator(viewW, viewH, inCutscene, buffBarShown, sideModalUp, modalMode, xpDropsInset));
  onUpdated(() => placeSpectator(viewW, viewH, inCutscene, buffBarShown, sideModalUp, modalMode, xpDropsInset));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeSpectator(
  viewW: Int,
  viewH: Int,
  inCutscene: Boolean,
  buffBarShown: Boolean,
  sideModalUp: Boolean,
  modalMode: Int,
  xpDropsInset: Int,
): void {
  viewportTrackerBackRef.props = { w: viewW, h: viewH };
  viewportTrackerFrontRef.props = { w: viewW, h: viewH };
  hudContainerBackRef.props = { x: 0, y: 0, w: 'fill', h: 'fill' };
  hudContainerFrontRef.props = { x: 0, y: 0, w: 'fill', h: 'fill' };
  if (modalMode === Resize.MODAL_TALL) {
    mainmodalRef.props = { w: Resize.MODAL_W, h: 'fill' };
  } else if (modalMode === Resize.MODAL_FILL) {
    mainmodalRef.props = { w: 'fill', h: 'fill' };
  } else {
    mainmodalRef.props = { w: Resize.MODAL_W, h: Resize.MODAL_H };
  }
  xpDropsRef.props = { w: { fill: xpDropsInset }, h: 'fill' };
  notificationsRef.props = { x: 'center', y: 10, w: 178, h: 100 };
  buffBarRef.props = { hide: !buffBarShown };
  pmContainerRef.props = { hide: inCutscene };
  statBoostsHudRef.props = { hide: inCutscene };
  helperRef.props = { hide: inCutscene };
  hpbarHudRef.props = { hide: inCutscene };
  mouseoverRef.props = { hide: inCutscene };
  sidecrmRef.props = { hide: sideModalUp };
  applyClientSettings();
  applySavedZoom();
  touchBuffBarDodgers();
}

function ModalBackdrop(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const [colour] = useState(toplevelMainmodalBgColour);
  const [trans] = useState(toplevelMainmodalBgTrans);
  const mobile: Boolean = onMobile();
  const modalOpen: Boolean = CS2.if_sub_has(mainmodalRef);
  const [boxW, boxH] = CS2.viewport_effective_size_get();

  let fourRects: Boolean = false;
  if (!mobile && colour > -1 && trans > -1 && modalOpen) {
    fourRects = true;
  }
  let oneRect: Boolean = false;
  if (mobile && trans === 0 && modalOpen) {
    oneRect = true;
  }
  const leftW: Int = (boxW - Resize.MODAL_W) / 2;
  const topH: Int = (boxH - Resize.MODAL_H) / 2;
  const rightW: Int = boxW - (leftW + Resize.MODAL_W);
  const bottomH: Int = boxH - (topH + Resize.MODAL_H);

  return (
    <>
      {fourRects && (
        <>
          <rect x={0} y={0} w="fill" h={topH} color={colour} fill transparency={trans} />
          <rect x={0} y="bottom" w="fill" h={bottomH} color={colour} fill transparency={trans} />
          <rect x={0} y={topH} w={leftW} h={Resize.MODAL_H} color={colour} fill transparency={trans} />
          <rect x="right" y={topH} w={rightW} h={Resize.MODAL_H} color={colour} fill transparency={trans} />
        </>
      )}
      {oneRect && <rect x="center" y="center" w="fill" h="fill" color={colour} fill transparency={0} />}
    </>
  );
}
