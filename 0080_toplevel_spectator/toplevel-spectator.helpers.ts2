import { desktopToplevelInit } from '../0548_toplevel/toplevel.helpers';
import { HelperFlags } from '../0548_toplevel/toplevel.constants';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { helperContentRef, helperDodgerRef } from './toplevel-spectator.constants';

export function spectatorToplevelInit(): void {
  desktopToplevelInit(ToplevelComponents.SPECTATOR, false);
}

export function spectatorHelperInit(): void {
  if (onMobile()) {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.MOBILE, Anchor.LEFT, Anchor.TOP, 1);
  } else {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.DESKTOP, Anchor.LEFT, Anchor.TOP, 1);
  }
}
