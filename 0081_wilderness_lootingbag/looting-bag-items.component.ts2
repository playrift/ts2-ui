import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { BagColors, BagFonts, Grid, LootingBagInventories } from './wilderness-lootingbag.constants';

export function LootingBagItems(): Component {
  const bag = useInventory(LootingBagInventories.BAG);
  const slots: Int = bag.size;

  let occupied: Int = 0;
  let slot: Int = 0;
  while (slot < slots) {
    if (bag[slot] !== -1) {
      occupied = occupied + 1;
    }
    slot = slot + 1;
  }

  return (
    <layer w="fill" h="fill">
      {bag.map(
        (item, index) =>
          item !== -1 && (
            <sprite
              x={(index % Grid.COLUMNS) * Grid.STRIDE_X}
              y={(index / Grid.COLUMNS) * Grid.CELL_H}
              w={Grid.CELL_W}
              h={Grid.CELL_H}
              item={item}
              itemCount={bag.count(index)}
              outline={Grid.OUTLINE}
              shadowColor={BagColors.ITEM_SHADOW}
              options={['', '', '', '', '', '', '', '', '', 'Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}`}
            />
          ),
      )}

      {occupied === 0 && (
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          text="The bag is empty."
          font={BagFonts.EMPTY}
          color={BagColors.ORANGE}
          shadow
          align="center"
          valign="middle"
        />
      )}
    </layer>
  );
}
