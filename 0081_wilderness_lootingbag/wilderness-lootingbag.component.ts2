import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { LootingBagItems } from './looting-bag-items.component';
import { BagColors, BagFonts, BagSprites, CloseSprites, Layout } from './wilderness-lootingbag.constants';

export function WildernessLootingBag(): Component {
  return (
    <>
      <text
        w="fill"
        h={Layout.TITLE_H}
        font={BagFonts.TITLE}
        color={BagColors.ORANGE}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        x={{ right: Layout.CLOSE.right }}
        y={Layout.CLOSE.y}
        w={Layout.CLOSE.w}
        h={Layout.CLOSE.h}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />

      <layer x={Layout.BOX.x} y={Layout.BOX.y} w={Layout.BOX.w} h={Layout.BOX.h}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKING_INSET }}
          h={{ fill: Layout.BACKING_INSET }}
          sprite={BagSprites.BACKING}
          tiling
        />

        <layer x="center" y="center" w={{ fill: Layout.ITEMS_INSET }} h={{ fill: Layout.ITEMS_INSET }}>
          <LootingBagItems />
        </layer>

        <ThinStoneBoxEntrypoint />
      </layer>

      <text
        x="center"
        y={{ bottom: 0 }}
        w="fill"
        h={{ fill: Layout.FOOTER_FILL }}
        font={BagFonts.FOOTER}
        color={BagColors.ORANGE}
        shadow
        align="center"
        valign="middle"
      />

      <layer x={0} y={0} w={Layout.TOOLTIP.w} h={Layout.TOOLTIP.h} />
    </>
  );
}
