import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { Panel, TITLE } from './castlewars-trade.constants';
import { TradeGrid } from './trade-grid.component';

export function CastlewarsTrade(): Component {
  return (
    <>
      <layer x={0} y={0} w={Panel.WIDTH} h={Panel.HEIGHT}>
        <SteelBorderEntrypoint title={TITLE} />
      </layer>

      <TradeGrid x={Panel.GRID_X} y={Panel.GRID_Y} w={Panel.GRID_W} h={Panel.GRID_H} />
    </>
