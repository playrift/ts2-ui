import { CastlewarsTradeStock } from './castlewars-trade.constants';
import { TradeSlot, tradeSlotShown } from './trade-slot.component';

export function TradeGrid(): Component {
  return (
    <layer w="fill" h="fill">
      {CastlewarsTradeStock.scan(
        (item, index, position) => tradeSlotShown(item) === 1 && <TradeSlot item={item} position={position} />,
        (item) => tradeSlotShown(item),
      )}
    </layer>
  );
}
