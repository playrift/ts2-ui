import { CS2 } from 'ts2';
import { itemName, membersWorld } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { Fade, Grid } from './castlewars-trade.constants';

export function tradeSlotShown(item: ItemName): Int {
  if (membersWorld()) {
    return 1;
  }
  if (CS2.item_members(item as Item) === 1) {
    return 0;
  }
  return 1;
}

export function TradeSlot({ item, position }: { item: ItemName; position: Int }): Component {
  return (
    <sprite
      x={(position % Grid.COLUMNS) * Grid.COLUMN_PITCH}
      y={(position / Grid.COLUMNS) * Grid.ROW_PITCH}
      w={Grid.SLOT_W}
      h={Grid.SLOT_H}
      item={item}
      itemCount={Grid.COUNT}
      outline={Grid.OUTLINE}
      shadowColor={Grid.SHADOW}
      optionSubject={`<col=ff9040>${itemName(item as Item)}`}
      options={['Value', 'Buy', '', '', '', '', '', '', '', 'Examine']}
      onOptionSelect={(event) => {
        flashFor(event.self, Fade.PRESSED, Fade.REST);
      }}
    />
  );
}
