import { CS2, useState } from 'ts2';

import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { membersWorld } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { EquipmentColor, EquipmentFonts, SET_BONUS_LABEL, STAT_BONUS_LABEL } from './equipment.constants';
import { setBonusPane, statPane } from './equipment.refs';

function setHidden(target: ComponentId, hidden: Boolean): void {
  target.hide = hidden;
}

export function toggleBonusPane(mode: Int): void {
  if (mode === 1) {
    setHidden(statPane, true);
    setHidden(setBonusPane, false);
  } else {
    setHidden(statPane, false);
    setHidden(setBonusPane, true);
  }
}

export function BonusToggle({ mode }: { mode: Int }): Component {
  const [hovered, setHovered] = useState(0);
  const mobile: Boolean = onMobile();

  if (!membersWorld()) {
    return null;
  }

  const label: String = mode === 1 ? SET_BONUS_LABEL : STAT_BONUS_LABEL;

  const ink: Int = hovered === 1 ? EquipmentColor.TOGGLE_IN : EquipmentColor.TOGGLE_OUT;

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onOptionSelect={() => toggleBonusPane(mode)}
      onMouseEnter={mobile ? undefined : () => setHovered(1)}
      onMouseLeave={mobile ? undefined : () => setHovered(0)}
    >
      {hovered === 1 ? (
        <StoneButtonPressedFilled>
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={label}
            font={EquipmentFonts.BUTTON}
            color={ink}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonOutFilled>
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={label}
            font={EquipmentFonts.BUTTON}
            color={ink}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonOutFilled>
      )}
    </layer>
  );
}
