import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { BonusToggle } from './bonus-toggle.component';
import { EquipSlot } from './equip-slot.component';
import {
  EQUIPMENT_TITLE,
  EquipSlot as Slot,
  EquipmentColor,
  EquipmentFonts,
  EquipmentLayout,
  EquipmentSprites,
  SET_EFFECT_HEADING,
  SlotBackgroundSprites,
} from './equipment.constants';
import { setBonusPane, statPane } from './equipment.refs';
import { QuiverSlot } from './quiver-slot.component';
import { RunWeight } from './run-weight.component';
import { SetBonusPane } from './set-bonus-pane.component';
import { StatTable } from './stat-table.component';
import { StatTooltip } from './stat-tooltip.component';

export function EquipmentStats(): Component {
  return (
    <>
      <layer
        x={EquipmentLayout.FRAME_X}
        y={EquipmentLayout.FRAME_Y}
        w={EquipmentLayout.FRAME_W}
        h={EquipmentLayout.FRAME_H}
      >
        <sprite w={EquipmentLayout.FRAME_W} h={EquipmentLayout.FRAME_H} sprite={EquipmentSprites.BACKDROP} tiling />

        <SteelBorderEntrypoint title={EQUIPMENT_TITLE} />

        <model
          x={EquipmentLayout.DOLL_X}
          y={EquipmentLayout.DOLL_Y}
          w={EquipmentLayout.DOLL_W}
          h={EquipmentLayout.DOLL_H}
          contentType={328}
          zoom={EquipmentLayout.DOLL_ZOOM}
        />

        <sprite x={71} y={97} w={36} h={124} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={15} y={176} w={36} h={45} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={127} y={176} w={36} h={45} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={50} y={139} w={78} h={36} sprite={SlotBackgroundSprites.WIDE} tiling />
        <sprite x={65} y={100} w={48} h={36} sprite={SlotBackgroundSprites.WIDE} tiling />

        <layer x={71} y={62} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.HEAD} />
        </layer>
        <layer x={30} y={101} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.CAPE} />
        </layer>
        <layer x={71} y={101} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.AMULET} />
        </layer>
        <layer x={15} y={140} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.WEAPON} />
        </layer>
        <layer x={71} y={140} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.BODY} />
        </layer>
        <layer x={127} y={140} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.SHIELD} />
        </layer>
        <layer x={71} y={180} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.LEGS} />
        </layer>
        <layer x={15} y={220} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.HANDS} />
        </layer>
        <layer x={71} y={220} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.FEET} />
        </layer>
        <layer x={127} y={220} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.RING} />
        </layer>
        <layer x={112} y={101} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <EquipSlot slot={Slot.AMMO} />
        </layer>

        <layer x={112} y={62} w={EquipmentLayout.SLOT} h={EquipmentLayout.SLOT}>
          <QuiverSlot />
        </layer>

        <layer ref={statPane} w={EquipmentLayout.STATS_W} h={EquipmentLayout.STATS_H}>
          <StatTable />
        </layer>

        <layer
          x={EquipmentLayout.TOGGLE_X}
          y={EquipmentLayout.TOGGLE_Y}
          w={EquipmentLayout.TOGGLE_W}
          h={EquipmentLayout.TOGGLE_H}
        >
          <BonusToggle mode={1} />
        </layer>

        <layer ref={setBonusPane} w={EquipmentLayout.SET_W} h={EquipmentLayout.SET_H} hide>
          <text
            x={335}
            y={38}
            w={155}
            h={15}
            text={SET_EFFECT_HEADING}
            font={EquipmentFonts.HEADING}
            color={EquipmentColor.LABEL}
            shadow
          />
          <SetBonusPane />
          <layer
            x={EquipmentLayout.TOGGLE_X}
            y={EquipmentLayout.TOGGLE_Y}
            w={EquipmentLayout.TOGGLE_W}
            h={EquipmentLayout.TOGGLE_H}
          >
            <BonusToggle mode={0} />
          </layer>
        </layer>

        <sprite
          x={EquipmentLayout.WEIGHT_ICON_X}
          y={EquipmentLayout.WEIGHT_ICON_Y}
          w={EquipmentLayout.WEIGHT_ICON_W}
          h={EquipmentLayout.WEIGHT_ICON_H}
          sprite={EquipmentSprites.WEIGHT}
        />
        <RunWeight />
      </layer>

      <StatTooltip />
    </>
  );
