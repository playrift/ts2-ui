import { EquipmentColor, EquipmentFonts, EquipmentLayout, WEIGHT_SUFFIX } from './equipment.constants';
import { runWeight } from './equipment.helpers';

export function RunWeight(): Component {
  const weight: Int = runWeight();
  return (
    <text
      x={EquipmentLayout.WEIGHT_TEXT_X}
      y={EquipmentLayout.WEIGHT_TEXT_Y}
      w={EquipmentLayout.WEIGHT_TEXT_W}
      h={EquipmentLayout.WEIGHT_TEXT_H}
      text={`${stringOf(weight)}${WEIGHT_SUFFIX}`}
      font={EquipmentFonts.BODY}
      color={EquipmentColor.WEIGHT}
      shadow
      valign="middle"
    />
  );
}
