import { useRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { textLineCount } from '../lib/lib.engine';
import { EquipmentColor, EquipmentFonts, EquipmentLayout, SetBonusScrollbar, SetPane } from './equipment.constants';
import { setBonusText } from './set-bonus';

export function SetBonusPane(): Component {
  const pane = useRef();
  const text: String = setBonusText();

  const fullExtent: Int = textLineCount(text, SetPane.MEASURE, EquipmentFonts.BODY) * SetPane.LINE + SetPane.EXTENT_PAD;
  let scrolls: Boolean = false;
  if (fullExtent > EquipmentLayout.SET_PANE_H) {
    scrolls = true;
  }
  const narrowExtent: Int =
    textLineCount(text, SetPane.MEASURE_SCROLLED, EquipmentFonts.BODY) * SetPane.LINE + SetPane.EXTENT_PAD;

  const width: Int = scrolls ? SetPane.MEASURE_SCROLLED : SetPane.MEASURE;
  const extent: Int = scrolls ? narrowExtent : fullExtent;
  let barHidden: Boolean = true;
  if (scrolls) {
    barHidden = false;
  }

  return (
    <>
      <layer
        ref={pane}
        x={EquipmentLayout.SET_PANE_X}
        y={{ bottom: EquipmentLayout.SET_PANE_BOTTOM }}
        w={width}
        h={EquipmentLayout.SET_PANE_H}
        scrollHeight={extent}
        scrollY={0}
      >
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={text}
          font={EquipmentFonts.BODY}
          color={EquipmentColor.SET_TEXT}
          shadow
          align="left"
          valign="top"
          lineHeight={0}
        />
      </layer>

      <layer
        x={{ right: EquipmentLayout.SET_BAR_RIGHT }}
        y={{ bottom: EquipmentLayout.SET_BAR_BOTTOM }}
        w={EquipmentLayout.SET_BAR_W}
        h={EquipmentLayout.SET_BAR_H}
        hide={barHidden}
      >
        {scrolls && (
          <ScrollbarVertical
            content={pane}
            track={SetBonusScrollbar.TRACK}
            capTopSprite={SetBonusScrollbar.CAP_TOP}
            thumbSprite={SetBonusScrollbar.THUMB}
            capBottomSprite={SetBonusScrollbar.CAP_BOTTOM}
            arrowUp={SetBonusScrollbar.ARROW_UP}
            arrowDown={SetBonusScrollbar.ARROW_DOWN}
          />
        )}
      </layer>
    </>
  );
}
