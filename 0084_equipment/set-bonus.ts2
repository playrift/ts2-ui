  const bloodbarkGloves: Int = useServerState(SetVarbits.WORN_ITEMS_BLOODBARK_GLOVES);
  const zealotHead: Int = useServerState(SetVarbits.WORN_ITEMS_ZEALOT_HEAD);
  const zealotBody: Int = useServerState(SetVarbits.WORN_ITEMS_ZEALOT_BODY);
  const zealotLegs: Int = useServerState(SetVarbits.WORN_ITEMS_ZEALOT_LEGS);
  const zealotBoots: Int = useServerState(SetVarbits.WORN_ITEMS_ZEALOT_BOOTS);
  const rcHead: Int = useServerState(SetVarbits.WORN_ITEMS_RC_HEAD);
  const rcBody: Int = useServerState(SetVarbits.WORN_ITEMS_RC_BODY);
  const rcLegs: Int = useServerState(SetVarbits.WORN_ITEMS_RC_LEGS);
  const rcBoots: Int = useServerState(SetVarbits.WORN_ITEMS_RC_BOOTS);

  let text: String = SetBonusTexts.get(setText) ?? '';
  let plain: Int = 1;
  if (inquisitorsArmour > 0 && inquisitorsArmour < 3) {
    plain = 0;
    if (inquisitorsMace === 0) {
      if (inquisitorsArmour === 1) {
        text = `${text}<col=ffffff>Inquisitor's armour:<br><br>Each individual piece of Inquisitor's armour boosts damage and accuracy by 0.5% when using the crush attack style. This is boosted to 2.5% if an Inquisitor's mace is equipped.<br><br>Current bonus: 0.5%<br>`;
      } else {
        text = `${text}<col=ffffff>Inquisitor's armour:<br><br>Each individual piece of Inquisitor's armour boosts damage and accuracy by 0.5% when using the crush attack style. This is boosted to 2.5% if an Inquisitor's mace is equipped.<br><br>Current bonus: 1%<br>`;
      }
    } else if (inquisitorsArmour === 1) {
      text = `${text}<col=ffffff>Inquisitor's armour:<br><br>Each individual piece of Inquisitor's armour boosts damage and accuracy by 2.5% when using the crush attack style since an Inquisitor's mace is equipped.<br><br>Current bonus: 2.5%<br>`;
    } else {
      text = `${text}<col=ffffff>Inquisitor's armour:<br><br>Each individual piece of Inquisitor's armour boosts damage and accuracy by 2.5% when using the crush attack style, since an Inquisitor's mace is equipped.<br><br>Current bonus: 5%<br>`;
    }
    text = `${text}<br>`;
  }
  if (swampbarkSet > 0 && swampbarkSet < 5) {
    plain = 0;
    text = `${text}<col=ffffff>Swampbark Armour: <br><br>When wearing the Swampbark Helm, Body, or Legs, the duration of Bind, Snare and Entangle spells is increased by 1.2 seconds.<br>This is cumulative for each piece worn.</col><br><br>`;
  }
  if (bloodbarkSet > 0 && bloodbarkSet < 5) {
    plain = 0;
    text = `${text}<col=ffffff>Bloodbark Armour: <br><br>When wearing a piece of Bloodbark armour, the amount of health restored by Blood spells is increased by 2.0%.<br>This is cumulative for each piece worn.</col><br><br>`;
  }
  if (padosRobesSet > 0 && padosRobesSet < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Zealot's prayer robes:<br><br>When wearing a piece of the Zealot's prayer robes, you have a 1.25% chance of saving ensouled heads when reanimating them, bones when burying or offering them, and bonemeal & slime at the Ectofuntus. This works alongside the Wilderness altar's bone saving effect.<br>This is cumulative for each piece worn.</col><br><br>`;
  }
  if (gracefulSet > 0 && gracefulSet < 6) {
    plain = 0;
    text = `${text}<col=ffffff>Graceful Outfit:<br><br>The Graceful Outfit increases your run restoration rate.<br>`;
    if (gracefulHood === 1) {
      text = `${text}Graceful Hood:  +3%<br>`;
    }
    if (gracefulTorso === 1) {
      text = `${text}Graceful Torso:  +4%<br>`;
    }
    if (gracefulLegs === 1) {
      text = `${text}Graceful Legs:  +4%<br>`;
    }
    if (gracefulGloves === 1) {
      text = `${text}Graceful Gloves:  +3%<br>`;
    }
    if (gracefulBoots === 1) {
      text = `${text}Graceful Boots:  +3%<br>`;
    }
    if (gracefulCape === 1) {
      text = `${text}Graceful Cape:  +3%<br>`;
    }
    text = `${text}<br>`;
  }
  if (crystalArmour > 0 && crystalArmour < 6) {
    plain = 0;
    text = `${text}<col=ffffff>Ranged Crystal Weaponry Accuracy Bonus:</col><br><br>`;
    if (crystalHelm === 1) {
      text = `${text}Crystal Helm: +5%<br>`;
    }
    if (crystalChest === 1) {
      text = `${text}Crystal Body:  +15%<br>`;
    }
    if (crystalLegs === 1) {
      text = `${text}Crystal Legs:  +10%<br>`;
    }
    text = `${text}<br><col=ffffff>Ranged Crystal Weaponry Damage Bonus:</col><br><br>`;
    if (crystalHelm === 1) {
      text = `${text}Crystal Helm: +2.5%<br>`;
    }
    if (crystalChest === 1) {
      text = `${text}Crystal Body:  +7.5%<br>`;
    }
    if (crystalLegs === 1) {
      text = `${text}Crystal Legs:  +5%<br>`;
    }
    text = `${text}<br>`;
  }
  if (zarytexbow === 1) {
    plain = 0;
    text = `${text}<col=ffffff>Zaryte Crossbow:</col><br><br>`;
    text = `${text}You have the Zaryte Crossbow equipped. Special bolt effects are increased by 10%.<br>`;
    text = `${text}<br>`;
  }
  if (kerispartisansun === 1) {
    plain = 0;
    text = `${text}<col=ffffff>Keris Partisan of the Sun:</col><br><br>`;
    text = `${text}While within the Tombs of Amascut:<br><br>- You have 25% increased accuracy against creatures below 25% health<br><br>- Killing a creature with the partisan restores 12 hitpoints at the cost of 5 prayer points.<br>    - This effect can overheal up to 20% above your hitpoints.<br>`;
    text = `${text}<br>`;
  }
  if (dizanasQuiverCharged === 1) {
    plain = 0;
    text = `${text}<col=ffffff>Dizana's Sunfire:</col><br><br>`;
    text = `${text}Dizana's Quiver ranged attack is increased by 10 and ranged strength is increased by 1.<br><col=ffffff>Only applies when using arrows and bolts.<br>`;
    text = `${text}<br>`;
  }
  if (rcOutfit > 0 && rcOutfit < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Raiments of the Eye - Bonus runes crafted </col><br><br>`;
    if (rcOutfitHat === 1) {
      text = `${text}Hood of the Eye: +10%<br>`;
    }
    if (rcOutfitTop === 1) {
      text = `${text}Robe Top of the Eye: +10%<br>`;
    }
    if (rcOutfitLegs === 1) {
      text = `${text}Robe Bottoms of the Eye: +10%<br>`;
    }
    if (rcOutfitBoots === 1) {
      text = `${text}Boots of the Eye: +10%<br>`;
    }
    text = `${text}<br>This bonus stacks additively not multiplicatively with other similar effects.<br>`;
    text = `${text}<br>`;
  }
  if (smithingUniform > 0 && smithingUniform < 8) {
    plain = 0;
    text = `${text}<col=ffffff>Smiths Uniform chance to smith faster bonus:</col><br><br>`;
    if (smithingUniformTop === 1) {
      text = `${text}Smiths Tunic: +20%<br>`;
    }
    if (smithingUniformLegs === 1) {
      text = `${text}Smiths Trousers: +20%<br>`;
    }
    if (smithingUniformBoots === 1) {
      text = `${text}Smiths Boots: +20%<br>`;
    }
    if (smithingUniformGloves === 1) {
      text = `${text}Smiths Gloves: +20%<br>`;
    }
    text = `${text}<br>`;
  }
  if (virtusset > 0 && virtusset < 3) {
    plain = 0;
    text = `${text}<col=ffffff>Virtus Robes:</col><br><br>`;
    if (virtusMask === 1) {
      text = `${text}Virtus mask: +2% Magic damage and an additional 3% ancient magic damage<br>`;
    }
    if (virtusTop === 1) {
      text = `${text}Virtus robe top: +2% Magic damage and an additional 3% ancient magic damage<br>`;
    }
    if (virtusLegs === 1) {
      text = `${text}Virtus robe bottom: +2% Magic damage and 3% an additional ancient magic damage<br>`;
    }
    text = `${text}<br>`;
  }
  if (trawlerBonus > 0 && trawlerBonus < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Angler outfit fishing XP increase:</col><br><br>`;
    if (trawlerBonusHead === 1) {
      text = `${text}Angler hat: +0.4%<br>`;
    }
    if (trawlerBonusTop === 1) {
      text = `${text}Angler top: +0.8%<br>`;
    }
    if (trawlerBonusLegs === 1) {
      text = `${text}Angler waders: +0.6%<br>`;
    }
    if (trawlerBonusBoots === 1) {
      text = `${text}Angler Boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (spiritAngler > 0 && spiritAngler < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Spirit Angler outfit fishing XP increase:</col><br><br>`;
    if (spiritAnglerHead === 1) {
      text = `${text}Spirit Angler headband: +0.4%<br>`;
    }
    if (spiritAnglerTop === 1) {
      text = `${text}Spirit Angler top: +0.8%<br>`;
    }
    if (spiritAnglerLegs === 1) {
      text = `${text}Spirit Angler waders: +0.6%<br>`;
    }
    if (spiritAnglerBoots === 1) {
      text = `${text}Spirit Angler boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (lumberjackFullOutfit > 0 && lumberjackFullOutfit < 20) {
    plain = 0;
    text = `${text}<col=ffffff>Lumberjack outfit woodcutting XP increase:</col><br><br>`;
    if (lumberjackHead === 1) {
      text = `${text}Lumberjack hat headband: +0.4%<br>`;
    }
    if (lumberjackBody === 1) {
      text = `${text}Lumberjack body: +0.8%<br>`;
    }
    if (lumberjackLegs === 1) {
      text = `${text}Lumberjack legs: +0.6%<br>`;
    }
    if (lumberjackBoots === 1) {
      text = `${text}Lumberjack boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (prospectorSet > 0 && prospectorSet < 20) {
    plain = 0;
    text = `${text}<col=ffffff>Prospector outfit mining XP increase:</col><br><br>`;
    if (prospectorHead === 1) {
      text = `${text}Prospector helmet: +0.4%<br>`;
    }
    if (prospectorBody === 1) {
      text = `${text}Prospector jacket: +0.8%<br>`;
    }
    if (prospectorLegs === 1) {
      text = `${text}Prospector legs: +0.6%<br>`;
    }
    if (prospectorBoots === 1) {
      text = `${text}Prospector boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (farmingSet > 0 && farmingSet < 20) {
    plain = 0;
    text = `${text}<col=ffffff>Farmer's outfit farming XP increase:</col><br><br>`;
    if (farmingHead === 1) {
      text = `${text}Farmer's strawhat: +0.4%<br>`;
    }
    if (farmingBody === 1) {
      text = `${text}Farmer's top: +0.8%<br>`;
    }
    if (farmingLegs === 1) {
      text = `${text}Farmer's legs: +0.6%<br>`;
    }
    if (farmingBoots === 1) {
      text = `${text}Farmer's boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (pyromancerSet > 0 && pyromancerSet < 20) {
    plain = 0;
    text = `${text}<col=ffffff>Pyromancer outfit firemaking XP increase:</col><br><br>`;
    if (pyromancerHead === 1) {
      text = `${text}Pyromancer hood: +0.4%<br>`;
    }
    if (pyromancerBody === 1) {
      text = `${text}Pyromancer garb: +0.8%<br>`;
    }
    if (pyromancerLegs === 1) {
      text = `${text}Pyromancer robe: +0.6%<br>`;
    }
    if (pyromancerBoots === 1) {
      text = `${text}Pyromancer boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (shayzienAcidSection()) {
    plain = 0;
    text = `${text}<col=ffffff>Shayzien armour reduces the damage of the acid splash attack used by Lizardman Shamans:</col><br><br>`;
    if (shayzienHead > 0) {
      text = `${text}Shayzien helm: ${stringOf(scaled(shayzienHead, 5, 20))}% damage reduction<br>`;
    }
    if (slayerHelmet > 0) {
      text = `${text}Slayer helm: 20% damage reduction<br>`;
    }
    if (shayzienBody > 0) {
      text = `${text}Shayzien body: ${stringOf(scaled(shayzienBody, 5, 20))}% damage reduction<br>`;
    }
    if (shayzienLegs > 0) {
      text = `${text}Shayzien greaves: ${stringOf(scaled(shayzienLegs, 5, 20))}% damage reduction<br>`;
    }
    if (shayzienBoots > 0) {
      text = `${text}Shayzien boots: ${stringOf(scaled(shayzienBoots, 5, 20))}% damage reduction<br>`;
    }
    if (shayzienGloves > 0) {
      text = `${text}Shayzien gloves: ${stringOf(scaled(shayzienGloves, 5, 20))}% damage reduction<br>`;
    }
    text = `${text}<br>`;
  }
  if (rogueSet > 0 && rogueSet < 5) {
    plain = 0;
    text = `${text}<col=ffffff>Rogue kit double loot from standard pickpocketing:</col><br><br>`;
    if (rogueHead > 0) {
      text = `${text}Rogue mask: 15% chance<br>`;
    }
    if (rogueBody > 0) {
      text = `${text}Rogue top: 15% chance<br>`;
    }
    if (rogueLegs > 0) {
      text = `${text}Rogue trousers: 15% chance<br>`;
    }
    if (rogueBoots > 0) {
      text = `${text}Rogue boots: 15% chance<br>`;
    }
    if (rogueGloves > 0) {
      text = `${text}Rogue gloves: 15% chance<br>`;
    }
    text = `${text}<br>`;
  }
  if (carpenterSet > 0 && carpenterSet < 5) {
    plain = 0;
    text = `${text}<col=ffffff>Carpenter's outfit construction XP increase:</col><br><br>`;
    if (carpenterHead === 1) {
      text = `${text}Carpenter's helmet: +0.4%<br>`;
    }
    if (carpenterBody === 1) {
      text = `${text}Carpenter's shirt: +0.8%<br>`;
    }
    if (carpenterLegs === 1) {
      text = `${text}Carpenter's trousers: +0.6%<br>`;
    }
    if (carpenterBoots === 1) {
      text = `${text}Carpenter's boots: +0.2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (swampbarkSet > 0 && swampbarkSet < 3) {
    plain = 0;
    text = `${text}<col=ffffff>Swampbark increases the duration of Bind, Snare and Entangle spells:</col><br><br>`;
    if (swampbarkHead === 1) {
      text = `${text}Swampbark helm: +1.2 seconds<br>`;
    }
    if (swampbarkBody === 1) {
      text = `${text}Swampbark body: +1.2 seconds<br>`;
    }
    if (swampbarkLegs === 1) {
      text = `${text}Swampbark legs: +1.2 seconds<br>`;
    }
    text = `${text}<br>`;
  }
  if (bloodbarkSet > 0 && bloodbarkSet < 5) {
    plain = 0;
    text = `${text}<col=ffffff>Bloodbark increases the amount healed by Blood spells:</col><br><br>`;
    if (bloodbarkHead === 1) {
      text = `${text}Bloodbark helm: +2%<br>`;
    }
    if (bloodbarkBody === 1) {
      text = `${text}Bloodbark body: +2%<br>`;
    }
    if (bloodbarkLegs === 1) {
      text = `${text}Bloodbark legs: +2%<br>`;
    }
    if (bloodbarkBoots === 1) {
      text = `${text}Bloodbark boots: +2%<br>`;
    }
    if (bloodbarkGloves === 1) {
      text = `${text}Bloodbark gloves: +2%<br>`;
    }
    text = `${text}<br>`;
  }
  if (padosRobesSet > 0 && padosRobesSet < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Zealot's robes prayer XP increase:</col><br><br>`;
    if (zealotHead === 1) {
      text = `${text}Zealot's helm: +1.25%<br>`;
    }
    if (zealotBody === 1) {
      text = `${text}Zealot's robe top: +1.25%<br>`;
    }
    if (zealotLegs === 1) {
      text = `${text}Zealot's robe bottom: +1.25%<br>`;
    }
    if (zealotBoots === 1) {
      text = `${text}Zealot's boots: +1.25%<br>`;
    }
    text = `${text}<br>`;
  }
  if (rcOutfit > 0 && rcOutfit < 4) {
    plain = 0;
    text = `${text}<col=ffffff>Raiments of the Eye bonus runes:</col><br><br>`;
    if (rcHead === 1) {
      text = `${text}Hat of the eye: +10%<br>`;
    }
    if (rcBody === 1) {
      text = `${text}Robe top of the eye: +10%<br>`;
    }
    if (rcLegs === 1) {
      text = `${text}Robe bottoms of the eye: +10%<br>`;
    }
    if (rcBoots === 1) {
      text = `${text}Boots of the eye: +10%<br>`;
    }
    text = `${text}<br>`;
  }
  if (plain === 1 && setText === 0) {
    text = `When wearing gear that gives a set bonus, you'll be able to view it here.<br>`;
  }
  return text;
}
