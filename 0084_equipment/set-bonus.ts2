  const carpenterHead: Int = useServerState(SetVarbits.WORN_ITEMS_CARPENTER_HEAD);
  const carpenterBody: Int = useServerState(SetVarbits.WORN_ITEMS_CARPENTER_BODY);
  const carpenterLegs: Int = useServerState(SetVarbits.WORN_ITEMS_CARPENTER_LEGS);
  const carpenterBoots: Int = useServerState(SetVarbits.WORN_ITEMS_CARPENTER_BOOTS);
