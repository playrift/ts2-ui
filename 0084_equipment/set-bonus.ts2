export function shayzienAcidSection(): Boolean {
  const kourendHard: Int = useServerState(SetVarbits.KOUREND_HARD_REWARD);
  const slayerHelmBonus: Int = useServerState(SetVarbits.KOUREND_SLAYER_HELM_BONUS);
  const slayerHelmet: Int = useServerState(SetVarbits.WORN_ITEMS_SLAYER_HELMET);
  const shayzienSet: Int = useServerState(SetVarbits.WORN_ITEMS_SHAYZIEN_SET);
  if (kourendHard > 0 && slayerHelmBonus > 0 && slayerHelmet > 0) {
    if (shayzienSet > 0 && shayzienSet < 20) {
      return true;
    }
    return false;
  }
  if (shayzienSet > 0 && shayzienSet < 25) {
    return true;
  }
  return false;
}

