export const QuiverObjs = mapOf<Item, Int>([
  [28830, 1],
  [28902, 1],
  [28906, 1],
  [28947, 1],
  [28949, 1],
  [28951, 1],
  [28953, 1],
  [28955, 1],
  [28957, 1],
]);

export function isQuiverObj(item: Item): Boolean {
  if ((QuiverObjs.get(item) ?? -1) > 0) {
    return true;
  }
  return false;
}
