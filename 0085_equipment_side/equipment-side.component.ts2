import { useInventory, useState, useUniverse } from 'ts2';

import {
  InterfaceInvSlot,
  interfaceInvGapX,
  interfaceInvGapY,
  interfaceInvOp,
  interfaceInvSlotX,
  interfaceInvSlotY,
} from '../lib/interface-inv.component';
import {
  interfaceInvColumns,
  interfaceInvDragMode,
  interfaceInvOps,
  interfaceInvRows,
  interfaceInvShown,
} from '../lib/interface-inv.state';
import { EquipmentSideInventories } from './equipment-side.constants';

export function EquipmentSide(): Component {
  const root = useUniverse();
  const carried = useInventory(EquipmentSideInventories.CARRIED);

  const [shown] = useState(interfaceInvShown);
  const [columns] = useState(interfaceInvColumns);
  const [rows] = useState(interfaceInvRows);
  const [dragMode] = useState(interfaceInvDragMode);
  const [ops] = useState(interfaceInvOps);

  const gapX: Int = interfaceInvGapX(root.width, columns);
  const gapY: Int = interfaceInvGapY(root.height, rows);

  return (
    <layer w="fill" h="fill">
      {carried.map((item, slot) => (
        <InterfaceInvSlot
          item={shown === 1 ? item : -1}
          count={carried.count(slot)}
          x={interfaceInvSlotX(slot, columns, gapX)}
          y={interfaceInvSlotY(slot, columns, gapY)}
          dragMode={dragMode}
          op1={interfaceInvOp(ops, 1)}
          op2={interfaceInvOp(ops, 2)}
          op3={interfaceInvOp(ops, 3)}
          op4={interfaceInvOp(ops, 4)}
          op5={interfaceInvOp(ops, 5)}
        />
      ))}
    </layer>
  );
}
