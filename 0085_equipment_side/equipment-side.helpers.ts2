import { interfaceInvInit } from '../lib/interface-inv.component';

export function equipmentSideInit(
  host: Int,
  inv: Int,
  columns: Int,
  rows: Int,
  dragMode: Int,
  dragHost: Int,
  op1: String,
  op2: String,
  op3: String,
  op4: String,
  op5: String,
): void {
  interfaceInvInit(host, inv, columns, rows, dragMode, dragHost, op1, op2, op3, op4, op5);
}
