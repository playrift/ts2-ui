import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ClanwarsDodge, ClanwarsSideways, Layout } from './clanwars-hud.constants';
import { ClanwarsCountdown } from './clanwars-countdown.component';
import { ClanwarsInfo } from './clanwars-info.component';
import { countdownBox, infoBox } from './clanwars-hud.refs';

export function ClanwarsHud(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(
            event.component,
            infoBox,
            ClanwarsDodge.INFO,
            Anchor.RIGHT,
            Anchor.TOP,
            ClanwarsSideways.FIXED,
          )
        }
      >
        <layer ref={infoBox} x={{ right: Layout.INFO_RIGHT }} y={Layout.INFO_Y} w={Layout.INFO_W} h={Layout.INFO_H}>
          <ClanwarsInfo />
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(
            event.component,
            countdownBox,
            ClanwarsDodge.COUNTDOWN,
            Anchor.CENTRE,
            Anchor.TOP,
            ClanwarsSideways.FIXED,
          )
        }
      >
        <layer ref={countdownBox} x="center" y={Layout.COUNTDOWN_Y} w={Layout.COUNTDOWN_W} h={Layout.COUNTDOWN_H}>
          <ClanwarsCountdown />
        </layer>
      </layer>
    </layer>
  );
}
