import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { GameoverArt, GameoverColor, GameoverFonts, GameoverModel, Layout } from './clanwars-gameover.constants';

export function ClanwarsGameover(): Component {
  return (
    <>
      <model
        x={0}
        y={0}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={GameoverModel.BACKDROP}
        zoom={Layout.BACKDROP_ZOOM}
        pitch={Layout.BACKDROP_PITCH}
        yaw={Layout.BACKDROP_YAW}
      />

      <model x={0} y={0} w={Layout.MODEL_W} h={Layout.MODEL_H} zoom={Layout.DECOR_ZOOM} />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        font={GameoverFonts.TITLE}
        color={GameoverColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x={Layout.MESSAGE_X}
        y={Layout.MESSAGE_Y}
        w={Layout.MESSAGE_W}
        h={Layout.MESSAGE_H}
        font={GameoverFonts.MESSAGE}
        color={GameoverColor.LABEL}
        align="center"
        valign="middle"
        shadow
        lineHeight={Layout.MESSAGE_LINE_H}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={GameoverArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, GameoverArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, GameoverArt.CLOSE)}
      />
    </>
  );
}
