              w={{ fill: Layout.wideList.insetW }}
              h={{ fill: Layout.wideList.insetH }}
            >
              <OptionRows set={OptionSet.STRAGGLERS} pane={stragglersList} />
            </layer>
          </layer>

          <layer x={Layout.panes.misc.x} y="bottom" w={{ fill: Layout.panes.misc.insetW }} h={Layout.panes.misc.h}>
            <PaneFrame title={ClanWarsOptionSets.at(OptionSet.MISC).title} />
            <layer
