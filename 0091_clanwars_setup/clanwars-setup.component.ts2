              y={SmallBoxes.melee.y}
              w={SmallBoxes.melee.w}
              h={SmallBoxes.melee.h}
              box={SmallBox.MELEE}
              set={OptionSet.MELEE}
              title={ClanWarsOptionSets.at(OptionSet.MELEE).title}
              icon={ClanWarsOptionSets.at(OptionSet.MELEE).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.ranging.x}
              y={SmallBoxes.ranging.y}
              w={SmallBoxes.ranging.w}
              h={SmallBoxes.ranging.h}
              box={SmallBox.RANGING}
              set={OptionSet.RANGING}
              title={ClanWarsOptionSets.at(OptionSet.RANGING).title}
              icon={ClanWarsOptionSets.at(OptionSet.RANGING).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.magic.x}
              y={SmallBoxes.magic.y}
              w={SmallBoxes.magic.w}
              h={SmallBoxes.magic.h}
              box={SmallBox.MAGIC}
              set={OptionSet.MAGIC}
              title={ClanWarsOptionSets.at(OptionSet.MAGIC).title}
              icon={ClanWarsOptionSets.at(OptionSet.MAGIC).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.food.x}
              y={SmallBoxes.food.y}
              w={SmallBoxes.food.w}
              h={SmallBoxes.food.h}
              box={SmallBox.FOOD}
              set={OptionSet.FOOD}
              title={ClanWarsOptionSets.at(OptionSet.FOOD).title}
              icon={ClanWarsOptionSets.at(OptionSet.FOOD).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.drinks.x}
              y={SmallBoxes.drinks.y}
              w={SmallBoxes.drinks.w}
              h={SmallBoxes.drinks.h}
              box={SmallBox.DRINKS}
              set={OptionSet.DRINKS}
              title={ClanWarsOptionSets.at(OptionSet.DRINKS).title}
              icon={ClanWarsOptionSets.at(OptionSet.DRINKS).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.prayer.x}
              y={SmallBoxes.prayer.y}
              w={SmallBoxes.prayer.w}
              h={SmallBoxes.prayer.h}
              box={SmallBox.PRAYER}
              set={OptionSet.PRAYER}
              title={ClanWarsOptionSets.at(OptionSet.PRAYER).title}
              icon={ClanWarsOptionSets.at(OptionSet.PRAYER).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.special.x}
              y={SmallBoxes.special.y}
              w={SmallBoxes.special.w}
              h={SmallBoxes.special.h}
              box={SmallBox.SPECIAL}
              set={OptionSet.SPECIAL}
              title={ClanWarsOptionSets.at(OptionSet.SPECIAL).title}
              icon={ClanWarsOptionSets.at(OptionSet.SPECIAL).icon}
            />
            <SmallBoxControl
              x={{ right: 4 }}
              y={SmallBoxes.teamCap.y}
              w={SmallBoxes.teamCap.w}
              h={SmallBoxes.teamCap.h}
              box={SmallBox.TEAM_CAP}
              set={OptionSet.TEAM_CAP}
              title={ClanWarsOptionSets.at(OptionSet.TEAM_CAP).title}
              icon={ClanWarsOptionSets.at(OptionSet.TEAM_CAP).icon}
            />
            <SmallBoxControl
              x={SmallBoxes.leaving.x}
              y={{ bottom: 4 }}
              w={SmallBoxes.leaving.w}
              h={SmallBoxes.leaving.h}
              box={SmallBox.LEAVING}
              set={OptionSet.LEAVING}
              title={ClanWarsOptionSets.at(OptionSet.LEAVING).title}
              icon={ClanWarsOptionSets.at(OptionSet.LEAVING).icon}
            />
            <SmallBoxControl
              x={{ right: 4 }}
              y={{ bottom: 4 }}
              w={SmallBoxes.rejoin.w}
              h={SmallBoxes.rejoin.h}
              box={SmallBox.REJOIN}
              set={OptionSet.REJOIN}
              title={ClanWarsOptionSets.at(OptionSet.REJOIN).title}
              icon={ClanWarsOptionSets.at(OptionSet.REJOIN).icon}
            />
            <ThinBoxEntrypoint />
          </layer>

          <layer x="right" y="bottom" w={Layout.corner.w} h={{ fill: Layout.corner.insetH }}>
            <AcceptCorner />
          </layer>
        </layer>
      </layer>

      <SmallBoxPopup />

      <layer w="fill" h="fill">
