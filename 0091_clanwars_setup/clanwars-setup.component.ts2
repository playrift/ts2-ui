import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { AcceptCorner } from './accept-corner.component';
import { ClanWarsTooltip } from './clanwars-setup-tooltip.component';
import {
  ClanWarsBar,
  ClanWarsColor,
  ClanWarsFonts,
  ClanWarsOptionSets,
  Layout,
  OptionSet,
  SmallBox,
  SmallBoxes,
  arenaList,
  gameEndList,
  miscList,
  stragglersList,
} from './clanwars-setup.constants';
import { OptionRows } from './option-rows.component';
import { PaneFrame } from './pane-frame.component';
import { SmallBoxControl } from './small-box.component';
import { SmallBoxPopup } from './small-box-popup.component';
import { ToggleRows } from './toggle-rows.component';

export function ClanWarsSetup(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.panel.w} h={Layout.panel.h}>
        <SteelBorderEntrypoint title="" />

        <text
          x="center"
          y={Layout.title.y}
          w={{ fill: Layout.title.drop }}
          h={Layout.title.h}
          text=""
          font={ClanWarsFonts.TITLE}
          color={ClanWarsColor.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x="center"
          y={{ bottom: Layout.body.bottom }}
          w={{ fill: Layout.body.insetW }}
          h={{ fill: Layout.body.insetH }}
        >
          <layer
            x={Layout.panes.gameEnd.x}
            y={Layout.panes.gameEnd.y}
            w={{ fill: Layout.panes.gameEnd.insetW }}
            h={Layout.panes.gameEnd.h}
          >
            <PaneFrame title={ClanWarsOptionSets.at(OptionSet.GAME_END).title} />
            <layer
              ref={gameEndList}
              x={Layout.list.x}
              y={{ bottom: Layout.list.bottom }}
              w={{ fill: Layout.list.insetW }}
              h={{ fill: Layout.list.insetH }}
              scrollHeight={ClanWarsOptionSets.at(OptionSet.GAME_END).count * Layout.row.h}
            >
              <OptionRows
                set={OptionSet.GAME_END}
                pane={gameEndList}
                x={0}
                y={0}
                w="fill"
                h={ClanWarsOptionSets.at(OptionSet.GAME_END).count * Layout.row.h}
              />
            </layer>
            <layer
              x={{ right: Layout.bar.right }}
              y={{ bottom: Layout.bar.bottom }}
              w={Layout.bar.w}
              h={{ fill: Layout.bar.insetH }}
            >
              <ScrollbarVertical
                content={gameEndList}
                track={ClanWarsBar.TRACK}
                capTopSprite={ClanWarsBar.CAP_TOP}
                thumbSprite={ClanWarsBar.THUMB}
                capBottomSprite={ClanWarsBar.CAP_BOTTOM}
                arrowUp={ClanWarsBar.ARROW_UP}
                arrowDown={ClanWarsBar.ARROW_DOWN}
              />
            </layer>
          </layer>

          <layer
            x={Layout.panes.arena.x}
            y={Layout.panes.arena.y}
            w={{ fill: Layout.panes.arena.insetW }}
            h={{ fill: Layout.panes.arena.insetH }}
          >
            <PaneFrame title={ClanWarsOptionSets.at(OptionSet.ARENA).title} />
            <layer
              ref={arenaList}
              x={Layout.list.x}
              y={{ bottom: Layout.list.bottom }}
              w={{ fill: Layout.list.insetW }}
              h={{ fill: Layout.list.insetH }}
              scrollHeight={ClanWarsOptionSets.at(OptionSet.ARENA).count * Layout.row.h}
            >
              <OptionRows
                set={OptionSet.ARENA}
                pane={arenaList}
                x={0}
                y={0}
                w="fill"
                h={ClanWarsOptionSets.at(OptionSet.ARENA).count * Layout.row.h}
              />
            </layer>
            <layer
              x={{ right: Layout.bar.right }}
              y={{ bottom: Layout.bar.bottom }}
              w={Layout.bar.w}
              h={{ fill: Layout.bar.insetH }}
            >
              <ScrollbarVertical
                content={arenaList}
                track={ClanWarsBar.TRACK}
                capTopSprite={ClanWarsBar.CAP_TOP}
                thumbSprite={ClanWarsBar.THUMB}
                capBottomSprite={ClanWarsBar.CAP_BOTTOM}
                arrowUp={ClanWarsBar.ARROW_UP}
                arrowDown={ClanWarsBar.ARROW_DOWN}
              />
            </layer>
          </layer>

          <layer
            x={{ right: Layout.panes.stragglers.right }}
            y="bottom"
            w={Layout.panes.stragglers.w}
            h={{ fill: Layout.panes.stragglers.insetH }}
          >
            <PaneFrame title={ClanWarsOptionSets.at(OptionSet.STRAGGLERS).title} />
            <layer
