export enum OptionSet {
  GAME_END = 0,
  MELEE = 1,
  RANGING = 2,
  MAGIC = 3,
  PRAYER = 4,
  FOOD = 5,
  DRINKS = 6,
  SPECIAL = 7,
  STRAGGLERS = 8,
  ARENA = 9,
  MISC = 10,
  LEAVING = 11,
  REJOIN = 12,
  TEAM_CAP = 13,
}

export function optionKey(set: OptionSet, index: Int): Int {
  return set * 64 + index;
}

export enum SmallBox {
  MELEE = 0,
  RANGING = 1,
  MAGIC = 2,
  FOOD = 3,
  DRINKS = 4,
  PRAYER = 5,
  SPECIAL = 6,
  TEAM_CAP = 7,
  LEAVING = 8,
  REJOIN = 9,
}

