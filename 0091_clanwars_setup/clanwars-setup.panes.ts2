    case SmallBox.PRAYER:
      return SmallBoxes.originY + SmallBoxes.prayer.y;
    case SmallBox.SPECIAL:
      return SmallBoxes.originY + SmallBoxes.special.y;
    case SmallBox.TEAM_CAP:
      return SmallBoxes.originY + SmallBoxes.teamCap.y;
    case SmallBox.LEAVING:
      return SmallBoxes.originY + SmallBoxes.leaving.y;
    case SmallBox.REJOIN:
      return SmallBoxes.originY + SmallBoxes.rejoin.y;
