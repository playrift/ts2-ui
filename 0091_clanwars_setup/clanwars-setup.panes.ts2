import { ClanWarsOptionSets, Layout, OptionSet, SmallBox, SmallBoxes } from './clanwars-setup.constants';

export function paneOriginX(set: Int): Int {
  switch (set) {
    case OptionSet.GAME_END:
      return Layout.list.x;
    case OptionSet.ARENA:
      return Layout.list.x;
    case OptionSet.STRAGGLERS:
      return 174;
    case OptionSet.MISC:
      return Layout.list.x;
  }
  return 0;
}

export function paneOriginY(set: Int): Int {
  switch (set) {
    case OptionSet.GAME_END:
      return Layout.frame.listY;
    case OptionSet.ARENA:
      return 111;
    case OptionSet.STRAGGLERS:
      return 234;
    case OptionSet.MISC:
      return 197;
  }
  return 0;
}

export function revealSelected(set: Int, selected: Int, pane: Ref): void {
  if (set === OptionSet.STRAGGLERS) {
    return;
  }
  const top: Int = selected * Layout.row.h;
  const scrolled: Int = pane.scrollY;
  if (top < scrolled) {
    pane.scrollY = top;
    return;
  }
  const height: Int = pane.height;
  if (top + Layout.row.h > scrolled + height) {
    pane.scrollY = top + Layout.row.h - height;
  }
}

export function smallBoxSet(box: Int): Int {
  switch (box) {
    case SmallBox.MELEE:
      return OptionSet.MELEE;
    case SmallBox.RANGING:
      return OptionSet.RANGING;
    case SmallBox.MAGIC:
      return OptionSet.MAGIC;
    case SmallBox.FOOD:
      return OptionSet.FOOD;
    case SmallBox.DRINKS:
      return OptionSet.DRINKS;
    case SmallBox.PRAYER:
      return OptionSet.PRAYER;
    case SmallBox.SPECIAL:
      return OptionSet.SPECIAL;
    case SmallBox.TEAM_CAP:
      return OptionSet.TEAM_CAP;
    case SmallBox.LEAVING:
      return OptionSet.LEAVING;
    case SmallBox.REJOIN:
      return OptionSet.REJOIN;
  }
  return OptionSet.MELEE;
}

export function smallBoxLeft(box: Int): Int {
  switch (box) {
    case SmallBox.MELEE:
      return SmallBoxes.originX + SmallBoxes.melee.x;
    case SmallBox.RANGING:
      return SmallBoxes.originX + SmallBoxes.ranging.x;
    case SmallBox.MAGIC:
      return SmallBoxes.originX + SmallBoxes.magic.x;
    case SmallBox.FOOD:
      return SmallBoxes.originX + SmallBoxes.food.x;
    case SmallBox.DRINKS:
      return SmallBoxes.originX + SmallBoxes.drinks.x;
    case SmallBox.PRAYER:
      return SmallBoxes.originX + SmallBoxes.prayer.x;
    case SmallBox.SPECIAL:
      return SmallBoxes.originX + SmallBoxes.special.x;
    case SmallBox.TEAM_CAP:
      return SmallBoxes.originX + SmallBoxes.teamCap.x;
    case SmallBox.LEAVING:
      return SmallBoxes.originX + SmallBoxes.leaving.x;
    case SmallBox.REJOIN:
      return SmallBoxes.originX + SmallBoxes.rejoin.x;
  }
  return 0;
}

