import { ClanWarsColor, ClanWarsSprites, ClanWarsWash } from './clanwars-setup.constants';

export function dropdownStripWash(lit: Int, hovered: Int): Int {
  if (lit === 1) {
    return ClanWarsWash.CLEAR;
  }
  if (hovered === 1) {
    return ClanWarsWash.CONTROL_HOVER;
  }
  return ClanWarsWash.OPAQUE;
}

export function dropdownChevronWash(lit: Int, hovered: Int): Int {
  if (lit !== 1 && hovered === 1) {
    return ClanWarsWash.ARROW_HOVER;
  }
  return ClanWarsWash.OPAQUE;
}

export function dropdownChevronSprite(lit: Int): Sprite {
  if (lit === 1) {
    return ClanWarsSprites.ARROW_UP;
  }
  return ClanWarsSprites.ARROW_DOWN;
}

export function dropdownValueColor(lit: Int, hovered: Int): Int {
  if (lit === 1 || hovered === 1) {
    return ClanWarsColor.LABEL_HOT;
  }
  return ClanWarsColor.LABEL;
}
