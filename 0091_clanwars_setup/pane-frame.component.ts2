import { ClanWarsColor, ClanWarsFonts, ClanWarsSprites, Layout } from './clanwars-setup.constants';

export function PaneFrame({ title }: { title: String }): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <sprite x={0} y={0} w="fill" h="fill" sprite={ClanWarsSprites.BACKING} tiling />

      <rect x={0} y={0} w="fill" h="fill" fill={false} color={ClanWarsColor.EDGE} />

      <rect x={0} y={0} w="fill" h={Layout.frame.capH} fill={false} color={ClanWarsColor.EDGE} />

      <rect
        x={Layout.frame.innerY}
        y={Layout.frame.innerY}
        w={{ fill: Layout.frame.innerInset }}
        h={Layout.frame.innerH}
        fill={false}
        color={ClanWarsColor.INNER}
      />

      <rect
        x={Layout.frame.innerY}
        y={Layout.frame.capH}
        w={{ fill: Layout.frame.innerInset }}
        h={{ fill: Layout.frame.listY }}
        fill={false}
        color={ClanWarsColor.INNER}
      />

      <text
        x={0}
        y={0}
        w="fill"
        h={Layout.frame.capH}
        text={title}
        font={ClanWarsFonts.TITLE}
        color={ClanWarsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
