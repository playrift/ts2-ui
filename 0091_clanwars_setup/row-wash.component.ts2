import { useState } from 'ts2';

import { ClanWarsColor, ClanWarsWash } from './clanwars-setup.constants';
import { chooseOption, hideClanWarsTooltip, showRowTooltip, toggleMiscOption } from './clanwars-setup.state';

export function ClanWarsRowWash({
  rowKey,
  label,
  pane,
  chosen,
  toggle,
}: {
  rowKey: Int;
  label: String;
  pane: Ref;
  chosen: Int;
  toggle: Int;
}): Component {
  const [hovered, setHovered] = useState(0);

  return (
    <rect
      x={0}
      y={0}
      w="fill"
      h="fill"
      fill
      color={ClanWarsColor.WASH}
      transparency={hovered === 1 ? ClanWarsWash.ROW_HOVER : ClanWarsWash.CLEAR}
      options={[label]}
      onMouseEnter={() => setHovered(1)}
      onMouseRepeat={() => showRowTooltip(rowKey, pane)}
      onMouseLeave={() => {
        setHovered(0);
        hideClanWarsTooltip();
      }}
      onOptionSelect={chosen === 1 ? null : () => chooseRow(rowKey, toggle)}
    />
  );
}

function chooseRow(rowKey: Int, toggle: Int): void {
  if (toggle === 1) {
    toggleMiscOption(rowKey);
    return;
  }
  chooseOption(rowKey);
}
