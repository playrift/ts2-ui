import { useState, useUniverse } from 'ts2';

import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { onMobile } from '../lib/lib.helpers';
import {
  ClanWarsColor,
  ClanWarsFonts,
  ClanWarsSprites,
  ClanWarsWash,
  Layout,
  SmallBox,
} from './clanwars-setup.constants';
import { ClanWarsOptions } from './clanwars-setup.data';
import {
  smallBoxCount,
  smallBoxHeight,
  smallBoxLeft,
  smallBoxSet,
  smallBoxTop,
  smallBoxWidth,
} from './clanwars-setup.panes';
import {
  chooseDropdownOption,
  dismissDropdown,
  hoverEntry,
  hoveredEntry,
  openSmallBox,
  unhoverEntry,
} from './clanwars-setup.state';

function SmallBoxEntries({ box, rowHeight, hovered }: { box: SmallBox; rowHeight: Int; hovered: Int }): Component {
  const set: Int = smallBoxSet(box);

  return (
    <>
      <rect
        x={0}
        y={hovered * rowHeight}
        w="fill"
        h={rowHeight}
        fill
        color={ClanWarsColor.WASH}
        transparency={ClanWarsWash.ENTRY_HOVER}
        hide={hovered === -1 ? true : false}
      />

      {ClanWarsOptions.filter((row) => row.set === set).map((row, key, index) => (
        <text
          x="center"
          y={index * rowHeight}
          w="fill"
          h={rowHeight}
          text={row.label}
          font={ClanWarsFonts.VALUE}
          color={hovered === index ? ClanWarsColor.LABEL_HOT : ClanWarsColor.ENTRY}
          align="center"
          valign="middle"
          shadow
          options={['Select']}
          onMouseRepeat={() => hoverEntry(index)}
          onMouseLeave={() => unhoverEntry()}
          onOptionSelect={() => chooseDropdownOption(key)}
        />
      ))}
    </>
  );
}

export function SmallBoxPopup(): Component {
  const [open] = useState(openSmallBox);
  if (open < 0) {
    return null;
  }

  const [hovered] = useState(hoveredEntry);

  const universe = useUniverse();
  const rootW: Int = universe.width;
  const rootH: Int = universe.height;

  const rowHeight: Int = onMobile() ? Layout.popup.mobileRowH : Layout.popup.rowH;

  const boxX: Int = (rootW - Layout.panel.w) / 2 + Layout.bodyX + smallBoxLeft(open);
  const boxY: Int = (rootH - Layout.panel.h) / 2 + Layout.bodyY + smallBoxTop(open) + smallBoxHeight(open);
  const boxW: Int = smallBoxWidth(open);
  const boxH: Int = Layout.popup.padding + smallBoxCount(open) * rowHeight;

  return (
    <layer x="center" y="center" w="fill" h="fill" noClickThrough onClick={() => dismissDropdown()}>
      <layer x={boxX} y={boxY} w={boxW} h={boxH} noClickThrough>
        <sprite x="center" y="center" w="fill" h="fill" sprite={ClanWarsSprites.STRIP} tiling />

        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.MELEE ? false : true}
        >
          {open === SmallBox.MELEE && <SmallBoxEntries box={SmallBox.MELEE} rowHeight={rowHeight} hovered={hovered} />}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.RANGING ? false : true}
        >
          {open === SmallBox.RANGING && (
            <SmallBoxEntries box={SmallBox.RANGING} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.MAGIC ? false : true}
        >
          {open === SmallBox.MAGIC && <SmallBoxEntries box={SmallBox.MAGIC} rowHeight={rowHeight} hovered={hovered} />}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.FOOD ? false : true}
        >
          {open === SmallBox.FOOD && <SmallBoxEntries box={SmallBox.FOOD} rowHeight={rowHeight} hovered={hovered} />}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.DRINKS ? false : true}
        >
          {open === SmallBox.DRINKS && (
            <SmallBoxEntries box={SmallBox.DRINKS} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.PRAYER ? false : true}
        >
          {open === SmallBox.PRAYER && (
            <SmallBoxEntries box={SmallBox.PRAYER} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.SPECIAL ? false : true}
        >
          {open === SmallBox.SPECIAL && (
            <SmallBoxEntries box={SmallBox.SPECIAL} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.TEAM_CAP ? false : true}
        >
          {open === SmallBox.TEAM_CAP && (
            <SmallBoxEntries box={SmallBox.TEAM_CAP} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.LEAVING ? false : true}
        >
          {open === SmallBox.LEAVING && (
            <SmallBoxEntries box={SmallBox.LEAVING} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.popup.paneInset }}
          h={{ fill: Layout.popup.paneInset }}
          hide={open === SmallBox.REJOIN ? false : true}
        >
          {open === SmallBox.REJOIN && (
            <SmallBoxEntries box={SmallBox.REJOIN} rowHeight={rowHeight} hovered={hovered} />
          )}
        </layer>

        <ThinBoxEntrypoint />
      </layer>
    </layer>
  );
}
