import { useDerived, useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { dropdownChevronSprite, dropdownChevronWash, dropdownStripWash, dropdownValueColor } from './dropdown-control';
import { ClanWarsColor, ClanWarsFonts, ClanWarsSprites, Layout, OptionSet, SmallBox } from './clanwars-setup.constants';
import { optionLabel, optionSetting } from './clanwars-setup.helpers';
import { hideClanWarsTooltip, openSmallBox, openDropdown, showBoxTooltip } from './clanwars-setup.state';

export function SmallBoxControl({
  box,
  set,
  title,
  icon,
}: {
  box: SmallBox;
  set: OptionSet;
  title: String;
  icon: Sprite;
}): Component {
  const setting: Int = useDerived(() => optionSetting(set));
  const label: String = optionLabel(set, setting);

  const [open] = useState(openSmallBox);
  let lit: Int = 0;
  if (open === box) {
    lit = 1;
  }
  const [hovered, setHovered] = useState(0);
  const stripWash: Int = dropdownStripWash(lit, hovered);
  const chevronWash: Int = dropdownChevronWash(lit, hovered);
  const chevronSprite: Sprite = dropdownChevronSprite(lit);
  const valueColor: Int = dropdownValueColor(lit, hovered);

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => showBoxTooltip(box)} onMouseLeave={() => hideClanWarsTooltip()}>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={Layout.box.stripH}
        sprite={ClanWarsSprites.STRIP}
        tiling
        transparency={stripWash}
        onMouseEnter={
          lit === 1
            ? null
            : () => {
                if (!onMobile()) {
                  setHovered(1);
                }
              }
        }
        onMouseLeave={lit === 1 ? null : () => setHovered(0)}
        onClick={() => {
          openDropdown(box);
          setHovered(0);
        }}
      />

      <rect x="center" y="bottom" w="fill" h={Layout.box.stripH} fill={false} color={ClanWarsColor.EDGE} />

      <rect
        x="center"
        y={{ bottom: Layout.box.innerBottom }}
        w={{ fill: Layout.box.innerInset }}
        h={Layout.box.innerH}
        fill={false}
        color={ClanWarsColor.INNER}
      />

      <sprite
        x={{ right: Layout.box.chevronRight }}
        y={{ bottom: Layout.box.chevronBottom }}
        w={Layout.box.chevron}
        h={Layout.box.chevron}
        sprite={chevronSprite}
        transparency={chevronWash}
      />

      <text
        x={Layout.box.valueX}
        y={{ bottom: Layout.box.valueBottom }}
        w={{ fill: Layout.box.valueInset }}
        h={Layout.box.valueH}
        text={label}
        font={ClanWarsFonts.VALUE}
        color={valueColor}
        align="center"
        valign="middle"
        shadow
      />

      <sprite x="center" y={0} w="fill" h={{ fill: Layout.box.stripH }} sprite={ClanWarsSprites.BACKING} tiling />

      <sprite x={Layout.box.iconX} y={Layout.box.iconY} w={Layout.box.icon} h={Layout.box.icon} sprite={icon} />

      <text
        x="right"
        y={0}
        w={{ fill: Layout.box.captionInset }}
        h={{ fill: Layout.box.stripH }}
        text={title}
        font={ClanWarsFonts.TITLE}
        color={ClanWarsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
