import { useDerived, useRef, useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { paintDropdownControl } from '../0764_pvp_arena_board_options/dropdown-control';
import {
  ClanWarsColor,
  ClanWarsFonts,
  ClanWarsSprites,
  ClanWarsWash,
  Layout,
  OptionSet,
  SmallBox,
} from './clanwars-setup.constants';
import { optionLabel, optionSetting } from './clanwars-setup.helpers';
import { hideClanWarsTooltip, openSmallBox, openDropdown, showBoxTooltip } from './clanwars-setup.state';

export function SmallBoxControl({
  box,
  set,
  title,
  icon,
}: {
  box: SmallBox;
  set: OptionSet;
  title: String;
  icon: Sprite;
}): Component {
  const strip = useRef();
  const chevron = useRef();
  const value = useRef();

  const setting: Int = useDerived(() => optionSetting(set));
  const label: String = optionLabel(set, setting);

  const [open] = useState(openSmallBox);
  let lit: Int = 0;
  if (open === box) {
    lit = 1;
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => showBoxTooltip(box)} onMouseLeave={() => hideClanWarsTooltip()}>
      <sprite
        ref={strip}
        x="center"
        y="bottom"
        w="fill"
        h={Layout.box.stripH}
        sprite={ClanWarsSprites.STRIP}
        tiling
        transparency={lit === 1 ? ClanWarsWash.CLEAR : ClanWarsWash.OPAQUE}
        onMouseEnter={() => {
          if (lit !== 1 && !onMobile()) {
            paintDropdownControl(strip, chevron, value, true);
          }
        }}
        onMouseLeave={() => {
          if (lit !== 1) {
            paintDropdownControl(strip, chevron, value, false);
          }
        }}
        onClick={() => openDropdown(box)}
      />

      <rect x="center" y="bottom" w="fill" h={Layout.box.stripH} fill={false} color={ClanWarsColor.EDGE} />

      <rect
        x="center"
        y={{ bottom: Layout.box.innerBottom }}
        w={{ fill: Layout.box.innerInset }}
        h={Layout.box.innerH}
        fill={false}
        color={ClanWarsColor.INNER}
      />

      <sprite
        ref={chevron}
        x={{ right: Layout.box.chevronRight }}
        y={{ bottom: Layout.box.chevronBottom }}
        w={Layout.box.chevron}
        h={Layout.box.chevron}
        sprite={lit === 1 ? ClanWarsSprites.ARROW_UP : ClanWarsSprites.ARROW_DOWN}
        transparency={ClanWarsWash.OPAQUE}
      />

      <text
        ref={value}
        x={Layout.box.valueX}
        y={{ bottom: Layout.box.valueBottom }}
        w={{ fill: Layout.box.valueInset }}
        h={Layout.box.valueH}
        text={label}
        font={ClanWarsFonts.VALUE}
        color={lit === 1 ? ClanWarsColor.LABEL_HOT : ClanWarsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <sprite x="center" y={0} w="fill" h={{ fill: Layout.box.stripH }} sprite={ClanWarsSprites.BACKING} tiling />

      <sprite x={Layout.box.iconX} y={Layout.box.iconY} w={Layout.box.icon} h={Layout.box.icon} sprite={icon} />

      <text
        x="right"
        y={0}
        w={{ fill: Layout.box.captionInset }}
        h={{ fill: Layout.box.stripH }}
        text={title}
        font={ClanWarsFonts.TITLE}
        color={ClanWarsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
