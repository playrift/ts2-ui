import { ccSetTrans } from '../0332_thormac/cc-settrans';
import {
  ClanWarsColor,
  ClanWarsFonts,
  ClanWarsSprites,
  ClanWarsWash,
  Layout,
  OptionSet,
} from './clanwars-setup.constants';
import { ClanWarsOptions } from './clanwars-setup.data';
import { miscToggled } from './clanwars-setup.helpers';
import { clanWarsRowLeave, showRowTooltip, toggleMiscOption } from './clanwars-setup.state';

export function ToggleRows({ pane }: { pane: Ref }): Component {
  return (
    <layer w="fill" h="fill">
      {ClanWarsOptions.filter((row) => row.set === OptionSet.MISC).map((row, key, index) => (
        <>
          <rect
            x={0}
            y={index * Layout.row.h}
            w="fill"
            h={Layout.row.h}
            fill
            color={ClanWarsColor.WASH}
            transparency={ClanWarsWash.CLEAR}
            options={[row.label]}
            onMouseEnter={(event) => ccSetTrans(event.self, ClanWarsWash.ROW_HOVER)}
            onMouseRepeat={() => showRowTooltip(key, pane)}
            onMouseLeave={(event) => clanWarsRowLeave(event.self)}
            onOptionSelect={() => toggleMiscOption(key)}
          />

          <sprite
            x={0}
            y={index * Layout.row.h}
            w={Layout.row.iconW}
            h={Layout.row.iconW}
            sprite={miscToggled(row.bit) ? ClanWarsSprites.RADIO_ON : ClanWarsSprites.CHECK_OFF}
          />

          <text
            x={Layout.row.iconW}
            y={index * Layout.row.h + Layout.row.textDrop}
            w={{ fill: Layout.row.iconW }}
            h={Layout.row.textH}
            text={row.label}
            font={ClanWarsFonts.ROW}
            color={miscToggled(row.bit) ? ClanWarsColor.SELECTED : ClanWarsColor.LABEL}
            align="left"
            valign="middle"
            shadow
          />
        </>
      ))}
    </layer>
  );
}
