import { ClanWarsColor, ClanWarsFonts, ClanWarsSprites, Layout, OptionSet } from './clanwars-setup.constants';
import { ClanWarsOptions } from './clanwars-setup.data';
import { miscToggled } from './clanwars-setup.helpers';
import { ClanWarsRowWash } from './row-wash.component';

export function ToggleRows({ pane }: { pane: Ref }): Component {
  return (
    <layer w="fill" h="fill">
      {ClanWarsOptions.filter((row) => row.set === OptionSet.MISC).map((row, key, index) => (
        <>
          <ClanWarsRowWash
            x={0}
            y={index * Layout.row.h}
            w="fill"
            h={Layout.row.h}
            rowKey={key}
            label={row.label}
            pane={pane}
            chosen={0}
            toggle={1}
          />

          <sprite
            x={0}
            y={index * Layout.row.h}
            w={Layout.row.iconW}
            h={Layout.row.iconW}
            sprite={miscToggled(row.bit) ? ClanWarsSprites.RADIO_ON : ClanWarsSprites.CHECK_OFF}
          />

          <text
            x={Layout.row.iconW}
            y={index * Layout.row.h + Layout.row.textDrop}
            w={{ fill: Layout.row.iconW }}
            h={Layout.row.textH}
            text={row.label}
            font={ClanWarsFonts.ROW}
            color={miscToggled(row.bit) ? ClanWarsColor.SELECTED : ClanWarsColor.LABEL}
            align="left"
            valign="middle"
            shadow
          />
        </>
      ))}
    </layer>
  );
}
