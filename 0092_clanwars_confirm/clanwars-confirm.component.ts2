import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ConfirmColor, ConfirmFonts, Layout, Text } from './clanwars-confirm.constants';

export function ClanwarsConfirm(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <SteelBorderEntrypoint title={Text.FRAME_TITLE} />

      <text
        x="center"
        y={Layout.TITLE_Y}
        w={{ fill: Layout.TITLE_INSET }}
        h={Layout.TITLE_H}
        font={ConfirmFonts.TITLE}
        color={ConfirmColor.TITLE}
        align="center"
        valign="middle"
        shadow
      />

      <layer
        x={Layout.DISPLAY_X}
        y={Layout.DISPLAY_Y}
        w={{ fill: Layout.DISPLAY_W_INSET }}
        h={{ fill: Layout.DISPLAY_H_INSET }}
      />

      <layer
        x={{ right: Layout.SCROLLBAR_RIGHT }}
        y={Layout.SCROLLBAR_Y}
        w={Layout.SCROLLBAR_W}
        h={{ fill: Layout.SCROLLBAR_H_INSET }}
      />

      <text
        x="center"
        y={{ bottom: Layout.FOOT_BOTTOM }}
        w={Layout.FOOT_W}
        h={Layout.FOOT_H}
        font={ConfirmFonts.HINT}
        color={ConfirmColor.HINT}
        align="center"
        valign="middle"
        shadow
        text={Text.HINT}
      />

      <layer
        x="center"
        y={{ bottom: Layout.FOOT_BOTTOM }}
        w={Layout.FOOT_W}
        h={Layout.FOOT_H}
        hide
        options={['Okay']}
      />
    </layer>
  );
}
