import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ClanWarsArt, Layout, Wash } from './clanwars-view.constants';

export function ClanWarsView(): Component {
  return (
    <>
      <sprite
        x={0}
        y={0}
        w={Layout.BACK_W}
        h={Layout.BACK_H}
        sprite={ClanWarsArt.BACKDROP}
        tiling
        transparency={Wash.BACKDROP}
      />

      <sprite
        x={Layout.INNER_X}
        y={Layout.INNER_Y}
        w={Layout.INNER_W}
        h={Layout.INNER_H}
        sprite={ClanWarsArt.BACKDROP}
        tiling
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ClanWarsArt.CLOSE_REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, ClanWarsArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, ClanWarsArt.CLOSE_REST)}
      />

      <layer x={Layout.CENTRAL_X} y={Layout.CENTRAL_Y} w={Layout.ORB_W} h={Layout.ORB_H} options={['View']} />

      <layer x={Layout.SW_X} y={Layout.SW_Y} w={Layout.ORB_W} h={Layout.ORB_H} options={['View']} />

      <layer x={Layout.SE_X} y={Layout.SE_Y} w={Layout.ORB_W} h={Layout.ORB_H} options={['View']} />

      <layer x={Layout.NW_X} y={Layout.NW_Y} w={Layout.ORB_W} h={Layout.ORB_H} options={['View']} />

      <layer x={Layout.NE_X} y={Layout.NE_Y} w={Layout.ORB_W} h={Layout.ORB_H} options={['View']} />
    </>
  );
}
