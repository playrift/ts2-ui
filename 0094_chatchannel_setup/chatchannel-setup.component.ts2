import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import {
  ChatChannelColor,
  ChatChannelFonts,
  ChatChannelScrollbar,
  ChatChannelSort,
  ChatChannelSprites,
  FriendRowLayout,
  Layout,
} from './chatchannel-setup.constants';
import { friendList, tooltipHost } from './chatchannel-setup.refs';
import { FriendRows } from './friend-list.component';
import { Instructions } from './instructions.component';
import { SettingRowPlate } from './setting-row.component';
import { SortButton } from './sort-button.component';

export function ChatchannelSetup(): Component {
  return (
    <>
      <rect
        x={{ center: Layout.PLATE_INSET }}
        y={{ center: Layout.PLATE_INSET }}
        w={Layout.PLATE_W}
        h={Layout.PLATE_H}
        fill
        color={ChatChannelColor.BACKDROP}
        transparency={Layout.PLATE_TRANSPARENCY}
      />

      <layer x="center" y="center" w={Layout.PLATE_W} h={Layout.PLATE_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <StoneBorderEntrypoint title="Chat-channel Setup" />
        </layer>

        <sprite
          x={Layout.DIVIDER_TOP_X}
          y={{ bottom: Layout.DIVIDER_TOP_Y }}
          w={Layout.DIVIDER_TOP_W}
          h={{ fill: Layout.DIVIDER_TOP_DROP }}
          sprite={ChatChannelSprites.DIVIDER_FILL}
          tiling
        />
        <sprite
          x={Layout.DIVIDER_MID_X}
          y={Layout.DIVIDER_MID_Y}
          w={Layout.DIVIDER_PIECE}
          h={Layout.DIVIDER_PIECE}
          sprite={ChatChannelSprites.DIVIDER_MID}
        />
        <sprite
          x={Layout.DIVIDER_END_X}
          y="bottom"
          w={Layout.DIVIDER_PIECE}
          h={Layout.DIVIDER_PIECE}
          sprite={ChatChannelSprites.DIVIDER_END}
        />

        <layer x={Layout.LEFT_X} y={{ bottom: Layout.LEFT_Y }} w={Layout.LEFT_W} h={{ fill: Layout.LEFT_DROP }}>
          <Instructions />

          <layer x="center" y={0} w="fill" h={Layout.BUTTON_H}>
            <SettingRowPlate />
          </layer>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.VALUE_H}
            font={ChatChannelFonts.BODY}
            color={ChatChannelColor.VALUE}
            align="center"
            valign="bottom"
            shadow
            options={['Set prefix', 'Disable']}
          />
          <text
            x="center"
            y={Layout.CAPTION_Y}
            w="fill"
            h={Layout.CAPTION_H}
            text="Channel name:"
            font={ChatChannelFonts.CAPTION}
            color={ChatChannelColor.CAPTION}
            align="center"
            valign="top"
            shadow
          />

          <layer x="center" y={Layout.ROW_PITCH} w="fill" h={Layout.BUTTON_H}>
            <SettingRowPlate />
          </layer>
          <text
            x="center"
            y={Layout.ROW_PITCH}
            w="fill"
            h={Layout.VALUE_H}
            font={ChatChannelFonts.BODY}
            color={ChatChannelColor.VALUE}
            align="center"
            valign="bottom"
            shadow
            options={[
              'Anyone',
              'Any friends',
              'Recruit+',
              'Corporal+',
              'Sergeant+',
              'Lieutenant+',
              'Captain+',
              'General+',
              'Only me',
            ]}
          />
          <text
            x="center"
            y={Layout.ROW_PITCH + Layout.CAPTION_Y}
            w="fill"
            h={Layout.CAPTION_H}
            text="Who can enter chat?"
            font={ChatChannelFonts.CAPTION}
            color={ChatChannelColor.CAPTION}
            align="center"
            valign="top"
            shadow
          />

          <layer x="center" y={Layout.ROW_PITCH * 2} w="fill" h={Layout.BUTTON_H}>
            <SettingRowPlate />
          </layer>
          <text
            x="center"
            y={Layout.ROW_PITCH * 2}
            w="fill"
            h={Layout.VALUE_H}
            font={ChatChannelFonts.BODY}
            color={ChatChannelColor.VALUE}
            align="center"
            valign="bottom"
            shadow
            options={[
              'Anyone',
              'Any friends',
              'Recruit+',
              'Corporal+',
              'Sergeant+',
              'Lieutenant+',
              'Captain+',
              'General+',
              'Only me',
            ]}
          />
          <text
            x="center"
            y={Layout.ROW_PITCH * 2 + Layout.CAPTION_Y}
            w="fill"
            h={Layout.CAPTION_H}
            text="Who can talk on chat?"
            font={ChatChannelFonts.CAPTION}
            color={ChatChannelColor.CAPTION}
            align="center"
            valign="top"
            shadow
          />

          <layer x="center" y={Layout.ROW_PITCH * 3} w="fill" h={Layout.BUTTON_H}>
            <SettingRowPlate />
          </layer>
          <text
            x="center"
            y={Layout.ROW_PITCH * 3}
            w="fill"
            h={Layout.VALUE_H}
            font={ChatChannelFonts.BODY}
            color={ChatChannelColor.VALUE}
            align="center"
            valign="bottom"
            shadow
            options={['', '', '', 'Corporal+', 'Sergeant+', 'Lieutenant+', 'Captain+', 'General+', 'Only me']}
          />
          <text
            x="center"
            y={Layout.ROW_PITCH * 3 + Layout.CAPTION_Y}
            w="fill"
            h={Layout.CAPTION_H}
            text="Who can kick on chat?"
            font={ChatChannelFonts.CAPTION}
            color={ChatChannelColor.CAPTION}
            align="center"
            valign="top"
            shadow
          />
        </layer>

        <layer
          x={{ right: Layout.RIGHT_X }}
          y={{ bottom: Layout.RIGHT_Y }}
          w={{ fill: Layout.RIGHT_INSET }}
          h={{ fill: Layout.RIGHT_DROP }}
        >
          <sprite x="center" y="center" w="fill" h="fill" sprite={ChatChannelSprites.LIST_BACKING} tiling />

          <layer x={{ right: 0 }} y={{ bottom: 0 }} w={{ fill: Layout.INNER_INSET }} h="fill">
            <ThinStoneBoxEntrypoint />
          </layer>

          <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
            <layer x={Layout.SORT_NAME_X} y="center" w={Layout.SORT_NAME_W} h={{ fill: Layout.HEADER_DROP }}>
              <SortButton first={ChatChannelSort.NAME_ASC} second={ChatChannelSort.NAME_DESC} />
            </layer>

            <layer
              x={{ right: Layout.SORT_RANK_RIGHT }}
              y="center"
              w={{ fill: Layout.SORT_RANK_INSET }}
              h={{ fill: Layout.HEADER_DROP }}
            >
              <SortButton first={ChatChannelSort.RANK_ASC} second={ChatChannelSort.RANK_DESC} />
            </layer>

            <layer
              x={{ right: Layout.SORT_LEGACY_RIGHT }}
              y="center"
              w={Layout.SORT_LEGACY_W}
              h={{ fill: Layout.HEADER_DROP }}
            >
              <SortButton first={ChatChannelSort.LEGACY} second={ChatChannelSort.LEGACY_REVERSED} />
            </layer>

            <ThinStoneBoxEntrypoint />
          </layer>

          <layer
            static
            ref={friendList}
            x={Layout.LIST_X}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={{ fill: Layout.LIST_INSET }}
            h={{ fill: Layout.LIST_DROP }}
            scrollHeight={Layout.LIST_SCROLL_HEIGHT}
          >
            <FriendRows h={FriendRowLayout.MAX_FRIENDS * FriendRowLayout.HEIGHT_MOBILE} />
          </layer>

          <layer
            x={{ right: Layout.BAR_RIGHT }}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={Layout.BAR_W}
            h={{ fill: Layout.LIST_DROP }}
          >
            <ScrollbarVertical
              content={friendList}
              track={ChatChannelScrollbar.TRACK}
              capTopSprite={ChatChannelScrollbar.CAP_TOP}
              thumbSprite={ChatChannelScrollbar.THUMB}
              capBottomSprite={ChatChannelScrollbar.CAP_BOTTOM}
              arrowUp={ChatChannelScrollbar.ARROW_UP}
              arrowDown={ChatChannelScrollbar.ARROW_DOWN}
            />
          </layer>

          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w={Layout.TOOLTIP_HOST} h={Layout.TOOLTIP_HOST} />
    </>
  );
}
