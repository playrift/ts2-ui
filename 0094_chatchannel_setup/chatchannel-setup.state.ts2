import { CS2, useState } from 'ts2';

import { chatchannelSetupSort } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { ChatChannelSort, RankBySlot, RankTitles } from './chatchannel-setup.constants';

export function currentSort(): Int {
  const [stored] = useState(chatchannelSetupSort);
  switch (stored) {
    case ChatChannelSort.LEGACY:
    case ChatChannelSort.LEGACY_REVERSED:
    case ChatChannelSort.NAME_ASC:
    case ChatChannelSort.NAME_DESC:
    case ChatChannelSort.RANK_ASC:
    case ChatChannelSort.RANK_DESC:
      return stored;
  }
  return ChatChannelSort.LEGACY;
}

export function chooseSort(sort: Int): void {
  playSound(Sounds.CLICK);
  const [, setSort] = useState(chatchannelSetupSort);
  setSort(sort);
}

export function sortArrowHover(arrow: Ref, transparency: Int): void {
  arrow.transparency = transparency;
}

export function setFriendRank(label: Ref, subject: String, option: Int): void {
  const rank: Int = RankBySlot.get(option) ?? -1;
  CS2.friend_rank_set(CS2.tags_remove(subject), rank);
  label.text = RankTitles.get(rank) ?? '';
}
