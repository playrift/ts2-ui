import { textDevice } from '../lib/lib.helpers';
import { ChatChannelColor, ChatChannelFonts, Layout } from './chatchannel-setup.constants';

export function Instructions(): Component {
  return (
    <text
      x="center"
      y={{ bottom: 0 }}
      w="fill"
      h={{ fill: Layout.INSTRUCTIONS_DROP }}
      text={`${textDevice('Right-click', 'Long press')} on white text to change options.`}
      font={ChatChannelFonts.BODY}
      color={ChatChannelColor.INSTRUCTIONS}
      align="center"
      valign="middle"
      shadow
    />
  );
}
