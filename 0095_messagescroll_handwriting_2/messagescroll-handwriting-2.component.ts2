import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  HandwritingArt,
  HandwritingColors,
  HandwritingFonts,
  HandwritingModel,
  Layout,
} from './messagescroll-handwriting-2.constants';

export function MessageScrollHandwriting2(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={HandwritingModel.QUILL}
        zoom={HandwritingModel.ZOOM}
        pitch={HandwritingModel.PITCH}
      />

      <text
        x={Layout.LINE_X}
        y={Layout.LINE1_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE2_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE3_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE4_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE5_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE6_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE7_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE8_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE9_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE10_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE11_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />
      <text
        x={Layout.LINE_X}
        y={Layout.LINE12_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        font={HandwritingFonts.LINE}
        color={HandwritingColors.INK}
        align="center"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={HandwritingArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, HandwritingArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, HandwritingArt.CLOSE)}
      />
    </>
  );
