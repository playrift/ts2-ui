import {
  Camera,
  DiceArt,
  DiceColor,
  DiceFonts,
  DiceModel,
  DiceText,
  GOLD_ZOOM,
  GoldPiles,
  Layout,
} from './death-dice.constants';

export function DeathDice(): Component {
  return (
    <>
      <model
        x={Layout.TABLE_X}
        y={Layout.TABLE_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={DiceModel.TABLE}
        zoom={Camera.TABLE.ZOOM}
        pitch={Camera.TABLE.PITCH}
      />

      <model
        x={Layout.HAROLD_DIE_2_X}
        y={Layout.HAROLD_DIE_2_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={DiceModel.DIE}
        zoom={Camera.HAROLD_DIE_2.ZOOM}
        pitch={Camera.HAROLD_DIE_2.PITCH}
        yaw={Camera.HAROLD_DIE_2.YAW}
      />

      <model
        x={Layout.HAROLD_DIE_1_X}
        y={Layout.HAROLD_DIE_1_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={DiceModel.DIE}
        zoom={Camera.HAROLD_DIE_1.ZOOM}
        pitch={Camera.HAROLD_DIE_1.PITCH}
        yaw={Camera.HAROLD_DIE_1.YAW}
      />

      <model
        x={Layout.PLAYER_DIE_1_X}
        y={Layout.PLAYER_DIE_1_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.PLAYER_DIE_1_H}
        model={DiceModel.DIE}
        zoom={Camera.PLAYER_DIE_1.ZOOM}
        pitch={Camera.PLAYER_DIE_1.PITCH}
        yaw={Camera.PLAYER_DIE_1.YAW}
      />

      <model
        x={Layout.PLAYER_DIE_2_X}
        y={Layout.PLAYER_DIE_2_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={DiceModel.DIE}
        zoom={Camera.PLAYER_DIE_2.ZOOM}
        pitch={Camera.PLAYER_DIE_2.PITCH}
        yaw={Camera.PLAYER_DIE_2.YAW}
      />

      <text
        x={Layout.HAROLD_X}
        y={Layout.HAROLD_Y}
        w={Layout.HAROLD_W}
        h={Layout.HAROLD_H}
        text={DiceText.HAROLD}
        font={DiceFonts.BODY}
        color={DiceColor.INK}
        align="center"
      />

      <text
        x={Layout.PLAYER_X}
        y={Layout.PLAYER_Y}
        w={Layout.PLAYER_W}
        h={Layout.PLAYER_H}
        text={DiceText.PLAYER}
        font={DiceFonts.BODY}
        color={DiceColor.INK}
        align="center"
      />

      {GoldPiles.map((pile) => (
        <model
          x={Layout.HAROLD_GOLD_X}
          y={Layout.HAROLD_GOLD_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          zoom={GOLD_ZOOM}
          pitch={pile.pitch}
          yaw={pile.yaw}
        />
      ))}

      {GoldPiles.map((pile) => (
        <model
          x={Layout.PLAYER_GOLD_X}
          y={Layout.PLAYER_GOLD_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          zoom={GOLD_ZOOM}
          pitch={pile.pitch}
          yaw={pile.yaw}
        />
      ))}

      <layer x={Layout.ROLL_LAYER_X} y={Layout.ROLL_LAYER_Y} w={Layout.ROLL_LAYER_W} h={Layout.ROLL_LAYER_H} hide>
        <text
          x={Layout.ROLL_X}
          y={Layout.ROLL_Y}
          w={Layout.ROLL_W}
          h={Layout.ROLL_H}
          text={DiceText.ROLL}
          font={DiceFonts.BODY}
          color={DiceColor.INK}
          align="center"
        />
      </layer>

      <layer
        x={Layout.CONTINUE_LAYER_X}
        y={Layout.CONTINUE_LAYER_Y}
        w={Layout.CONTINUE_LAYER_W}
        h={Layout.CONTINUE_LAYER_H}
        hide
      >
        <text
          x={Layout.CONTINUE_X}
          y={Layout.CONTINUE_Y}
          w={Layout.CONTINUE_W}
          h={Layout.CONTINUE_H}
          text={DiceText.CONTINUE}
          font={DiceFonts.BODY}
          color={DiceColor.INK}
          align="center"
        />
      </layer>

      <text
        x={Layout.HAROLD_STAKE_X}
        y={Layout.HAROLD_STAKE_Y}
        w={Layout.STAKE_W}
        h={Layout.STAKE_H}
        text={DiceText.STAKE}
        font={DiceFonts.BODY}
        color={DiceColor.INK}
        align="center"
      />

      <text
        x={Layout.PLAYER_STAKE_X}
        y={Layout.PLAYER_STAKE_Y}
        w={Layout.STAKE_W}
        h={Layout.STAKE_H}
        text={DiceText.STAKE}
        font={DiceFonts.BODY}
        color={DiceColor.INK}
        align="center"
      />

      <text
        x={Layout.RESULT_X}
        y={Layout.RESULT_Y}
        w={Layout.RESULT_W}
        h={Layout.RESULT_H}
        text={DiceText.RESULT}
        font={DiceFonts.BODY}
        color={DiceColor.RESULT}
        align="center"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={DiceArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_LIT_X}
          y={Layout.CLOSE_LIT_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={DiceArt.CLOSE_LIT}
        />
      </layer>
    </>
  );
}
