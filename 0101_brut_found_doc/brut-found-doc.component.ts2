import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { BrutArt, BrutColor, BrutFont, BrutModel, Camera, Layout } from './brut-found-doc.constants';

export function BrutFoundDoc(): Component {
  return (
    <>
      <model
        x={Layout.backing.x}
        y={Layout.backing.y}
        w={Layout.backing.w}
        h={Layout.backing.h}
        model={BrutModel.BACKING}
        zoom={Camera.ZOOM}
        pitch={Camera.BACKING_PITCH}
      />

      <text
        x={Layout.text.x}
        y={Layout.text.y}
        w={Layout.text.w}
        h={Layout.text.h}
        font={BrutFont.BODY}
        color={BrutColor.INK}
        shadow
        align="center"
        lineHeight={Layout.text.lineHeight}
      />

      <model
        x={Layout.scroll.x}
        y={Layout.scroll.y}
        w={Layout.scroll.w}
        h={Layout.scroll.h}
        model={BrutModel.SCROLL}
        zoom={Camera.ZOOM}
        pitch={Camera.SCROLL_PITCH}
      />

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={BrutArt.CLOSE}
        options={['Close']}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, BrutArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, BrutArt.CLOSE)}
      />
    </>
  );
}
