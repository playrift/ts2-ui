import { createRef } from 'ts2';
import { closeInterface, opsound } from '../lib/lib.helpers';
import { hideSwapperUnlessMobile, modelSwapperUnlessMobile } from './pattern-next.helpers';
import { Layout, Palette, PatternFonts, PatternModel, SELECT_OP_MASK } from './pattern-next.constants';

const highlight1 = createRef('pattern_next_highlight1');
const highlight2 = createRef('pattern_next_highlight2');
const highlight3 = createRef('pattern_next_highlight3');
const highlight4 = createRef('pattern_next_highlight4');

export function PatternNext(): Component {
  return (
    <layer w={Layout.ROOT_W} h="fill" x="center" y="center">
      <rect x={11} y={327} w={486} h={4} color={Palette.RULE} fill transparency={64} />
      <rect x={493} y={312} w={4} h={15} color={Palette.RULE} fill transparency={64} />
      <rect x={484} y={6} w={4} h={305} color={Palette.RULE} fill transparency={64} />

      <model x={221} y={175} w={Layout.CLOSE} h={Layout.CLOSE} model={PatternModel.DEVICE} zoom={356} />

      <model
        x={432}
        y={31}
        w={Layout.CLOSE}
        h={Layout.CLOSE}
        model={PatternModel.CLOSE}
        zoom={Layout.CLOSE_ZOOM}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => modelSwapperUnlessMobile(event.component, PatternModel.CLOSE_HOVER)}
        onMouseLeave={(event) => modelSwapperUnlessMobile(event.component, PatternModel.CLOSE)}
      />

      <model
        x={115}
        y={Layout.CELL_Y}
        w={Layout.SEPARATOR_W}
        h={Layout.SEPARATOR_H}
        model={PatternModel.SEPARATOR}
        zoom={Layout.SEPARATOR_ZOOM}
        pitch={Layout.SEPARATOR_ANGLE}
        yaw={Layout.SEPARATOR_ANGLE}
      />
      <model
        x={215}
        y={Layout.CELL_Y}
        w={Layout.SEPARATOR_W}
        h={Layout.SEPARATOR_H}
        model={PatternModel.SEPARATOR}
        zoom={Layout.SEPARATOR_ZOOM}
        pitch={Layout.SEPARATOR_ANGLE}
        yaw={Layout.SEPARATOR_ANGLE}
      />
      <model
        x={315}
        y={Layout.CELL_Y}
        w={Layout.SEPARATOR_W}
        h={Layout.SEPARATOR_H}
        model={PatternModel.SEPARATOR}
        zoom={Layout.SEPARATOR_ZOOM}
        pitch={Layout.SEPARATOR_ANGLE}
        yaw={Layout.SEPARATOR_ANGLE}
      />

      <text
        x={380}
        y={55}
        w={75}
        h={60}
        font={PatternFonts.QUESTION}
        color={Palette.TEXT}
        shadow
        align="center"
        text="?"
      />

      <model x={80} y={Layout.CELL_Y} w={Layout.CELL} h={Layout.CELL} zoom={Layout.CELL_ZOOM} />
      <model x={180} y={Layout.CELL_Y} w={Layout.CELL} h={Layout.CELL} zoom={Layout.CELL_ZOOM} />
      <model x={280} y={Layout.CELL_Y} w={Layout.CELL} h={Layout.CELL} zoom={Layout.CELL_ZOOM} />

      <text
        x={32}
        y={142}
        w={437}
        h={34}
        font={PatternFonts.PROMPT}
        color={Palette.TEXT}
        shadow
        align="center"
        text="What comes next?"
      />

      <rect
        ref={highlight1}
        x={69}
        y={Layout.ANSWER_Y}
        w={Layout.HIGHLIGHT}
        h={Layout.HIGHLIGHT}
        color={Palette.HIGHLIGHT}
        fill
        transparency={Layout.HIGHLIGHT_OPACITY}
        hide
      />
      <model
        x={69}
        y={Layout.ANSWER_Y}
        w={Layout.ANSWER_W}
        h={Layout.ANSWER_H}
        zoom={Layout.CELL_ZOOM}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, SELECT_OP_MASK)}
        onMouseEnter={() => hideSwapperUnlessMobile(false, highlight1)}
        onMouseLeave={() => hideSwapperUnlessMobile(true, highlight1)}
      />

      <rect
        ref={highlight2}
        x={165}
        y={Layout.ANSWER_Y}
        w={Layout.HIGHLIGHT}
        h={Layout.HIGHLIGHT}
        color={Palette.HIGHLIGHT}
        fill
        transparency={Layout.HIGHLIGHT_OPACITY}
        hide
      />
      <model
        x={165}
        y={Layout.ANSWER_Y}
        w={Layout.ANSWER_W}
        h={Layout.ANSWER_H}
        zoom={Layout.CELL_ZOOM}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, SELECT_OP_MASK)}
        onMouseEnter={() => hideSwapperUnlessMobile(false, highlight2)}
        onMouseLeave={() => hideSwapperUnlessMobile(true, highlight2)}
      />

      <rect
        ref={highlight3}
        x={261}
        y={Layout.ANSWER_Y}
        w={Layout.HIGHLIGHT}
        h={Layout.HIGHLIGHT}
        color={Palette.HIGHLIGHT}
        fill
        transparency={Layout.HIGHLIGHT_OPACITY}
        hide
      />
      <model
        x={261}
        y={Layout.ANSWER_Y}
        w={Layout.ANSWER_W}
        h={Layout.ANSWER_H}
        zoom={Layout.CELL_ZOOM}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, SELECT_OP_MASK)}
        onMouseEnter={() => hideSwapperUnlessMobile(false, highlight3)}
        onMouseLeave={() => hideSwapperUnlessMobile(true, highlight3)}
      />

      <rect
        ref={highlight4}
        x={357}
        y={Layout.ANSWER_Y}
        w={Layout.HIGHLIGHT}
        h={Layout.HIGHLIGHT}
        color={Palette.HIGHLIGHT}
        fill
        transparency={Layout.HIGHLIGHT_OPACITY}
        hide
      />
      <model
        x={357}
        y={Layout.ANSWER_Y}
        w={Layout.ANSWER_W}
        h={Layout.ANSWER_H}
        zoom={144}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, SELECT_OP_MASK)}
        onMouseEnter={() => hideSwapperUnlessMobile(false, highlight4)}
        onMouseLeave={() => hideSwapperUnlessMobile(true, highlight4)}
      />
    </layer>
  );
}
