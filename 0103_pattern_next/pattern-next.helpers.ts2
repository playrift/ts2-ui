import { onMobile } from '../lib/lib.helpers';

export function hideSwapperUnlessMobile(hidden: Boolean, component: ComponentId): void {
  if (!onMobile()) {
    component.hide = hidden;
  }
}

export function modelSwapperUnlessMobile(component: ComponentId, model: Model): void {
  if (!onMobile()) {
    component.model = model;
  }
}
