import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { textColourSwapper } from './qip-obs-starchart.helpers';
import {
  Camera,
  GridColumns,
  GridRows,
  Layout,
  SkyBands,
  StarchartAnim,
  StarchartArt,
  StarchartColor,
  StarchartFont,
  StarchartModel,
  StarchartText,
  Zodiac,
} from './qip-obs-starchart.constants';

export function QipObsStarchart(): Component {
  return (
    <>
      <rect
        x={Layout.SHADE_X}
        y={Layout.SHADE_Y}
        w={Layout.SHADE_W}
        h={Layout.SHADE_H}
        fill
        color={StarchartColor.SHADE}
        transparency={160}
      />

      <sprite
        x={Layout.BACKING_X}
        y={Layout.BACKING_Y}
        w={Layout.BACKING_W}
        h={Layout.BACKING_H}
        sprite={StarchartArt.BACKING}
      />

      <sprite
        x={Layout.LEFT_X}
        y={Layout.LEFT_Y}
        w={Layout.LEFT_W}
        h={Layout.LEFT_H}
        sprite={StarchartArt.LEFT}
        tiling
      />
      <sprite
        x={Layout.SPLITTER_CAP_X}
        y={Layout.SPLITTER_CAP_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.SPLITTER_CAP}
      />
      <sprite
        x={Layout.TEE_LEFT_X}
        y={Layout.TEE_LEFT_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.TEE_LEFT}
      />
      <sprite
        x={Layout.CORNER_TL_X}
        y={Layout.CORNER_TL_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.CORNER_TL}
      />
      <sprite
        x={Layout.DIVIDER_A_X}
        y={Layout.DIVIDER_A_Y}
        w={Layout.DIVIDER_A_W}
        h={Layout.DIVIDER_A_H}
        sprite={StarchartArt.DIVIDER}
        tiling
      />
      <sprite
        x={Layout.DIVIDER_B_X}
        y={Layout.DIVIDER_B_Y}
        w={Layout.DIVIDER_B_W}
        h={Layout.DIVIDER_B_H}
        sprite={StarchartArt.DIVIDER}
        tiling
      />
      <sprite
        x={Layout.TEE_RIGHT_X}
        y={Layout.TEE_RIGHT_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.TEE_RIGHT}
      />
      <sprite
        x={Layout.CORNER_TR_X}
        y={Layout.CORNER_TR_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.CORNER_TR}
      />
      <sprite x={Layout.TOP_X} y={Layout.TOP_Y} w={Layout.TOP_W} h={Layout.TOP_H} sprite={StarchartArt.TOP} tiling />
      <sprite
        x={Layout.CORNER_BL_X}
        y={Layout.CORNER_BL_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.CORNER_BL}
      />
      <sprite
        x={Layout.SPLITTER_X}
        y={Layout.SPLITTER_Y}
        w={Layout.SPLITTER_W}
        h={Layout.SPLITTER_H}
        sprite={StarchartArt.SPLITTER}
        tiling
      />
      <sprite
        x={Layout.TEE_BOTTOM_X}
        y={Layout.TEE_BOTTOM_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.TEE_BOTTOM}
      />
      <sprite
        x={Layout.BOTTOM_A_X}
        y={Layout.BOTTOM_A_Y}
        w={Layout.BOTTOM_A_W}
        h={Layout.BOTTOM_A_H}
        sprite={StarchartArt.BOTTOM}
        tiling
      />
      <sprite
        x={Layout.BOTTOM_B_X}
        y={Layout.BOTTOM_B_Y}
        w={Layout.BOTTOM_B_W}
        h={Layout.BOTTOM_B_H}
        sprite={StarchartArt.BOTTOM}
        tiling
      />
      <sprite
        x={Layout.CORNER_BR_X}
        y={Layout.CORNER_BR_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={StarchartArt.CORNER_BR}
      />
      <sprite
        x={Layout.RIGHT_X}
        y={Layout.RIGHT_Y}
        w={Layout.RIGHT_W}
        h={Layout.RIGHT_H}
        sprite={StarchartArt.RIGHT}
        tiling
      />

      <rect
        x={Layout.CHART_X}
        y={Layout.CHART_Y}
        w={Layout.CHART_W}
        h={Layout.CHART_H}
        fill
        color={StarchartColor.SHADE}
        transparency={160}
      />

      {Zodiac.map((sign) => (
        <text
          x={Layout.LIST_X}
          y={sign.y}
          w={Layout.LIST_W}
          h={Layout.LIST_H}
          text={sign.name}
          font={StarchartFont.LIST}
          color={StarchartColor.LABEL}
          shadow
          options={['View']}
          onMouseEnter={(event) => {
            textColourSwapper(event.component, StarchartColor.LABEL_HOVER);
          }}
          onMouseLeave={(event) => {
            textColourSwapper(event.component, StarchartColor.LABEL);
          }}
        />
      ))}

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={StarchartText.TITLE}
        font={StarchartFont.TITLE}
        color={StarchartColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      {SkyBands.map((band) => (
        <rect x={Layout.BAND_X} y={band.y} w={Layout.BAND_W} h={band.h} fill color={band.color} />
      ))}

      <rect
        x={Layout.AXIS_V_X}
        y={Layout.AXIS_V_Y}
        w={Layout.AXIS_V_W}
        h={Layout.AXIS_V_H}
        fill
        color={StarchartColor.GRID}
      />
      <rect
        x={Layout.AXIS_H_X}
        y={Layout.AXIS_H_Y}
        w={Layout.AXIS_H_W}
        h={Layout.AXIS_H_H}
        fill
        color={StarchartColor.GRID}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_SIZE}
        h={Layout.CLOSE_SIZE}
        sprite={StarchartArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, StarchartArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, StarchartArt.CLOSE);
        }}
      />

      {GridColumns.map((column) => (
        <line
          x={column}
          y={Layout.GRID_V_Y}
          w={0}
          h={Layout.GRID_V_H}
          color={StarchartColor.GRID}
          lineWidth={Layout.GRID_WIDTH}
        />
      ))}

      {GridRows.map((row) => (
        <line
          x={Layout.GRID_H_X}
          y={row}
          w={Layout.GRID_H_W}
          h={0}
          color={StarchartColor.GRID}
          lineWidth={Layout.GRID_WIDTH}
        />
      ))}

      <model
        x={Layout.STARS_X}
        y={Layout.STARS_Y}
        w={Layout.STARS_SIZE}
        h={Layout.STARS_SIZE}
        model={StarchartModel.STARS}
        anim={StarchartAnim.TWINKLE}
        zoom={Camera.STARS.ZOOM}
        pitch={Camera.STARS.PITCH}
      />

      <rect
        x={Layout.PLATE_X}
        y={Layout.PLATE_Y}
        w={Layout.PLATE_W}
        h={Layout.PLATE_H}
        fill
        color={StarchartColor.PLATE}
        transparency={100}
      />
      <text
        x={Layout.NAME_X}
        y={Layout.NAME_Y}
        w={Layout.NAME_W}
        h={Layout.NAME_H}
        text={StarchartText.CHART_NAME}
        font={StarchartFont.PLATE}
        color={StarchartColor.PLATE_TEXT}
        shadow
        valign="middle"
      />
    </>
  );
}
