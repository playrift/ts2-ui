import { CS2, sessionState, stopTimer, useRef, useState } from 'ts2';

import { clientClock, itemName, playSound } from '../lib/lib.engine';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import {
  CAPTION,
  CHOOSE_OP,
  Grid,
  Layout,
  MIN_RUNES,
  PAYMENT_MODE,
  Press,
  RuneCells,
  TITLE,
  ZmiColors,
  ZmiFonts,
  ZmiSounds,
} from './zmi-bank-payment.constants';
import { runeTotal } from './zmi-bank-payment.helpers';

const hoveredCell = sessionState(-1);

export function pressRune(index: Int, item: ItemName, mode: Int, cell: ComponentId, icon: ComponentId): void {
  playSound(ZmiSounds.CLICK);
  cell.onMouseEnter = null;
  cell.onMouseLeave = null;
  icon.hide = true;
  const unhideAt: Int = clientClock() + Press.UNHIDE_AFTER;
  const redrawAt: Int = clientClock() + Press.REDRAW_AFTER;
  cell.onTimer = () => selectionReset(unhideAt, redrawAt, index, item, mode, cell, icon);
}

function selectionReset(
  unhideAt: Int,
  redrawAt: Int,
  index: Int,
  item: ItemName,
  mode: Int,
  cell: ComponentId,
  icon: ComponentId,
): void {
  if (clientClock() < unhideAt) {
    return;
  }
  icon.hide = false;
  if (clientClock() < redrawAt) {
    return;
  }
  const [, setHovered] = useState(hoveredCell);
  setHovered(-1);
  let live: Boolean = false;
  if (mode === 0) {
    live = true;
  } else if (runeTotal(item) >= MIN_RUNES) {
    live = true;
  }
  if (live) {
    cell.onMouseEnter = () => hoverRune(index);
    cell.onMouseLeave = () => hoverRune(-1);
  }
  stopTimer(cell);
}

export function hoverRune(index: Int): void {
  const [, setHovered] = useState(hoveredCell);
  setHovered(index);
}

export function RuneCell({
  item,
  index,
  x,
  y,
  mode,
}: {
  item: ItemName;
  index: Int;
  x: Int;
  y: Int;
  mode: Int;
}): Component {
  const held: Int = runeTotal(item);
  let live: Boolean = false;
  if (mode === 0) {
    live = true;
  } else if (held >= MIN_RUNES) {
    live = true;
  }

  const [hovered] = useState(hoveredCell);

  const icon = useRef();

  return (
    <layer
      x={x}
      y={y}
      w={Grid.CELL}
      h={Grid.CELL}
      options={[CHOOSE_OP]}
      optionSubject={`<col=ff9040>${itemName(item as Item)}</col>`}
      onMouseEnter={live ? () => hoverRune(index) : undefined}
      onMouseLeave={live ? () => hoverRune(-1) : undefined}
      onOptionSelect={(event) => {
        pressRune(index, item, mode, event.self, icon);
        CS2.if_resume_pausebutton(event.component);
      }}
    >
      {!live ? <StoneButtonFilled /> : hovered === index ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <sprite
        ref={icon}
        x={{ center: Grid.ICON_DX }}
        y="center"
        w={Grid.ICON_W}
        h={Grid.ICON_H}
        item={item}
        itemCount={held}
        itemCountMode="always"
        outline={Grid.OUTLINE}
        shadowColor={Grid.SHADOW}
        transparency={live ? 0 : Grid.DISABLED_FADE}
      />
    </layer>
  );
}

export function PaymentGrid(): Component {
  return (
    <layer
      x="center"
      y={{ bottom: Layout.GRID_BOTTOM }}
      w={{ fill: Layout.GRID_INSET_W }}
      h={{ fill: Layout.GRID_INSET_H }}
    >
      {RuneCells.map((cell) => (
        <RuneCell item={cell.item} index={cell.index} x={cell.x} y={cell.y} mode={PAYMENT_MODE} />
      ))}
    </layer>
  );
}

export function ZmiBankPayment(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={TITLE} />

      <PaymentGrid />

      <layer y={{ bottom: Layout.CAPTION_BOTTOM }} w="fill" h={Layout.CAPTION_H}>
        <text
          w="fill"
          h="fill"
          text={CAPTION}
          font={ZmiFonts.CAPTION}
          color={ZmiColors.CAPTION}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}
