import { playSound } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { RewardSounds } from './agilityarena-rewards.constants';

export function gateSound(): void {
  playSound(RewardSounds.SELECT);
}

export function priceCaption(label: String, price: Int): String {
  if (price === 1) {
    return `${label}<br>1 ticket`;
  }
  return `${label}<br>${groupDigits(price, ',')} tickets`;
}

export function buyOp(price: Int): String {
  if (price === 1) {
    return 'Buy for 1 ticket';
  }
  return `Buy for ${groupDigits(price, ',')} tickets`;
}
