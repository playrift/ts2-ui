import { useState } from 'ts2';
import { ButtonBackground } from '../0370_house-options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { DISMISS_LABEL, RewardColor, RewardFonts } from './agilityarena-rewards.constants';
import { gateSound } from './agilityarena-rewards.helpers';
import { gracefulOpen } from './agilityarena-rewards.state';

export function GracefulCancel(): Component {
  const [hovered, setHovered] = useState(0);
  const [, setOpen] = useState(gracefulOpen);

  return (
    <layer
      w="fill"
      h="fill"
      options={[DISMISS_LABEL]}
      onMouseRepeat={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => {
        gateSound();
        setOpen(0);
      }}
    >
      {hovered === 1 ? <ButtonBackgroundPressed /> : <ButtonBackground />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={DISMISS_LABEL}
        font={RewardFonts.DISMISS}
        align="center"
        valign="middle"
        shadow
        color={hovered === 1 ? RewardColor.HOVER : RewardColor.REST}
      />
    </layer>
  );
}
