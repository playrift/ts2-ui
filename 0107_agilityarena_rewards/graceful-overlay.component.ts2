import { useServerState, useState } from 'ts2';
import { textWidth } from '../lib/lib.engine';
import { ThinStoneBox } from '../lib/thin-stone-box.component';
import {
  DISMISS_LABEL,
  Layout,
  Prices,
  RewardArt,
  RewardFonts,
  RewardItems,
  RewardVarbits,
} from './agilityarena-rewards.constants';
import { GracefulCancel } from './graceful-cancel.component';
import { GracefulPieceButton } from './graceful-piece-button.component';
import { gracefulOpen } from './agilityarena-rewards.state';

export function GracefulOverlay(): Component {
  const [open] = useState(gracefulOpen);
  const recoloured: Int = useServerState(RewardVarbits.HAD_RECOLOURED);

  return (
    <layer hide={open === 1 && recoloured === 1 ? false : true} noClickThrough x="center" y="center" w="fill" h="fill">
      <sprite x="center" y="center" w="fill" h="fill" sprite={RewardArt.SUBPANEL_BACKDROP} tiling />

      <GracefulPieceButton
        x={Layout.PIECE_X0}
        y={Layout.PIECE_Y0}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Hood"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_HOOD}
        owned={RewardItems.GRACEFUL_HOOD}
      />
      <GracefulPieceButton
        x={Layout.PIECE_X1}
        y={Layout.PIECE_Y0}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Top"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_TOP}
        owned={RewardItems.GRACEFUL_TOP}
      />
      <GracefulPieceButton
        x={Layout.PIECE_X2}
        y={Layout.PIECE_Y0}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Legs"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_LEGS}
        owned={RewardItems.GRACEFUL_LEGS}
      />
      <GracefulPieceButton
        x={Layout.PIECE_X0}
        y={Layout.PIECE_Y1}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Cape"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_CAPE}
        owned={RewardItems.GRACEFUL_CAPE}
      />
      <GracefulPieceButton
        x={Layout.PIECE_X1}
        y={Layout.PIECE_Y1}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Gloves"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_GLOVES}
        owned={RewardItems.GRACEFUL_GLOVES}
      />
      <GracefulPieceButton
        x={Layout.PIECE_X2}
        y={Layout.PIECE_Y1}
        w={Layout.PIECE}
        h={Layout.PIECE}
        label="Boots"
        price={Prices.RECOLOUR_PIECE}
        icon={RewardItems.RECOLOUR_BOOTS}
        owned={RewardItems.GRACEFUL_BOOTS}
      />

      <GracefulPieceButton
        x={{ right: Layout.SET_RIGHT }}
        y={Layout.SET_Y}
        w={{ fill: Layout.SET_INSET }}
        h={Layout.SET_H}
        label="Whole set"
        price={Prices.RECOLOUR_SET}
      />

      <GracefulCancel
        x="center"
        y={{ bottom: Layout.DISMISS_BOTTOM }}
        w={Layout.DISMISS_PAD + textWidth(DISMISS_LABEL, Layout.DISMISS_MEASURE, RewardFonts.DISMISS)}
        h={Layout.DISMISS_H}
      />

      <ThinStoneBox />
    </layer>
  );
}
