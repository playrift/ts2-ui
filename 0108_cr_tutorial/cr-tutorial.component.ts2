import { textLineCount } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { SteelBorder } from '../lib/steel-border.component';
import { TutorialButton } from './tutorial-button.component';
import {
  TutorialArt,
  TutorialColors,
  TutorialFonts,
  TutorialFrameFlags,
  TutorialFrameText,
  TutorialLayout,
  TutorialText,
} from './cr-tutorial.constants';

export function CrTutorial(): Component {
  const mobile: Boolean = onMobile();

  const bodyLines: Int = textLineCount(TutorialText.BODY, TutorialLayout.MEASURE_WIDTH, TutorialFonts.BODY);
  const bodyHeight: Int = TutorialLayout.LINE * bodyLines;

  const hint: String = mobile ? TutorialText.HINT_MOBILE : TutorialText.HINT_DESKTOP;
  const hintLines: Int = textLineCount(hint, TutorialLayout.MEASURE_WIDTH, TutorialFonts.BODY);
  const hintHeight: Int = TutorialLayout.LINE * hintLines;

  const bodyY: Int = TutorialLayout.FIRST_Y + TutorialLayout.LINE + TutorialLayout.PAD;
  const hintY: Int = bodyY + bodyHeight + TutorialLayout.PAD;
  const iconY: Int = hintY + hintHeight + TutorialLayout.PAD;

  return (
    <layer x="center" y="center" w={TutorialLayout.PANEL_WIDTH} h={TutorialLayout.PANEL_HEIGHT}>
      <layer x="center" y="center" w="fill" h="fill">
        <sprite x="center" y="center" w="fill" h="fill" sprite={TutorialArt.BACKDROP} />
        <SteelBorder
          title={TutorialFrameText.TITLE}
          titleColor={TutorialColors.BODY}
          flags={TutorialFrameFlags.NO_CLOSE_BUTTON}
        />
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <layer
          x="center"
          y={TutorialLayout.TEXT_Y}
          w={{ fill: TutorialLayout.TEXT_W_INSET }}
          h={{ fill: TutorialLayout.TEXT_H_INSET }}
        >
          <text
            x="center"
            y={TutorialLayout.FIRST_Y}
            w={{ fill: 2 * TutorialLayout.PAD }}
            h={TutorialLayout.LINE}
            text={TutorialText.HEADING}
            font={TutorialFonts.BODY}
            color={TutorialColors.BODY}
            align="left"
            valign="top"
            lineHeight={TutorialLayout.LINE}
            shadow
          />

          <text
            x="center"
            y={bodyY}
            w={{ fill: 2 * TutorialLayout.PAD }}
            h={bodyHeight}
            text={TutorialText.BODY}
            font={TutorialFonts.BODY}
            color={TutorialColors.BODY}
            align="left"
            valign="top"
            lineHeight={TutorialLayout.LINE}
            shadow
          />

          <text
            x="center"
            y={hintY}
            w={{ fill: 2 * TutorialLayout.PAD }}
            h={hintHeight}
            text={hint}
            font={TutorialFonts.BODY}
            color={TutorialColors.BODY}
            align="left"
            valign="top"
            lineHeight={TutorialLayout.LINE}
            shadow
          />

          <sprite
            x="center"
            y={iconY}
            w={TutorialLayout.ICON_WIDTH}
            h={TutorialLayout.ICON_HEIGHT}
            sprite={TutorialArt.ADVISER_ICON}
          />
        </layer>

        <TutorialButton label={TutorialText.BUTTON_LABEL} />
      </layer>
    </layer>
  );
}
