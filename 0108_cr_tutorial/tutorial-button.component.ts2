import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { closeOnEscape } from '../0877_wgs_rune_door/close-on-escape';
import { closeButtonClickSound } from './close-button-click-sound';
import { TutorialColors, TutorialFonts, TutorialLayout } from './cr-tutorial.constants';

export function TutorialButton({ label }: { label: String }): Component {
  const mobile: Boolean = onMobile();
  const [pressed, setPressed] = useState(0);

  return (
    <layer
      x="center"
      y={TutorialLayout.BUTTON_Y}
      w={TutorialLayout.BUTTON_WIDTH}
      h={TutorialLayout.BUTTON_HEIGHT}
      options={[label]}
      onMouseRepeat={() => {
        if (!mobile) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          setPressed(0);
        }
      }}
      onOptionSelect={() => closeButtonClickSound()}
      onKey={(event) => closeOnEscape(event.keyCode)}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={TutorialFonts.BODY}
        color={TutorialColors.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
