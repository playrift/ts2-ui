import { CS2, predictServerState, useServerState, useState } from 'ts2';

import { playermember, recurringMembership, socialNetworkAccount } from '../lib/game/varcs';
import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { bondsHidden } from '../0589_displayname/displayname.helpers';
import { onIos } from '../0654_league_info/league-info.helpers';
import { hexToRgb, rgbToHex } from '../0259_area_task/area-task.helpers';
import { tobHudNameFlasher } from '../0773_toa_lobby/toa-lobby.helpers';
import { stringFindAndReplace } from '../0491_barbassault_reward_shop/string-find-and-replace';
import { AccountTab, AccountVars, ButtonArt, Layout } from './account.constants';
import { LINK_TABLE_COUNT, UsefulLinks } from './account-links.data';

export function emailUnlinked(): Boolean {
  const [social] = useState(socialNetworkAccount);
  return social === 1;
}

export function isMember(): Boolean {
  const [member] = useState(playermember);
  return member === 1;
}

export function selectTab(index: Int): void {
  predictServerState(AccountVars.TAB, index);
}

export function membershipCollapsed(): Boolean {
  if (!bondsHidden()) {
    return false;
  }
  return useServerState(AccountVars.HAS_BONDS) === 0 && isMember();
}

export function inboxCollapsed(): Boolean {
  if (!bondsHidden()) {
    return false;
  }
  return !emailUnlinked();
}

export function inboxY(): Int {
  return membershipCollapsed() ? Layout.inbox.y - Layout.collapse : Layout.inbox.y;
}

export function nameY(): Int {
  let y: Int = Layout.name.y;
  if (membershipCollapsed()) {
    y = y - Layout.collapse;
  }
  if (inboxCollapsed()) {
    y = y - Layout.collapse;
  }
  return y;
}

export function membershipText(): String {
  const days: Int = useServerState(AccountVars.CREDIT);
  if (isMember() && days > 0) {
    if (days > 99999) {
      return 'Membership: 99999+ days left';
    }
    const [recurring] = useState(recurringMembership);
    if (days === 1) {
      if (recurring === 0) {
        return 'Membership: <col=ff0000>1 day left</col>';
      }
      return 'Membership: 1 day left';
    }
    if (days <= 3 && recurring === 0) {
      return `Membership: <col=ff0000>${days} days left</col>`;
    }
    return `Membership: ${days} days left`;
  }
  return 'Membership: <col=ff0000>None</col>';
}

export function membershipActive(): Boolean {
  return isMember() && useServerState(AccountVars.CREDIT) > 0;
}

export function bondsLabel(): String {
  if (!membershipActive() && useServerState(AccountVars.HAS_BONDS) === 0) {
    return 'View Benefits';
  }
  return 'Bond Pouch';
}

export function bondsIcon(): Sprite {
  if (!membershipActive() && useServerState(AccountVars.HAS_BONDS) === 0) {
    return ButtonArt.BENEFITS;
  }
  return ButtonArt.BONDS;
}

export function inboxText(): String {
  if (emailUnlinked()) {
    return 'Email: <col=ff0000>Unlinked</col>';
  }
  const unread: Int = useServerState(AccountVars.MESSAGES);
  if (unread > 9999) {
    return 'Inbox: 9999+ unread messages';
  }
  if (unread === 1) {
    return 'Inbox: 1 unread message';
  }
  return `Inbox: ${unread} unread messages`;
}

export function nameText(): String {
  if (useServerState(AccountVars.HAS_NAME) === 1) {
    return `Name: ${CS2.chat_playername()}`;
  }
  return 'Name: <col=ff0000>Not Set</col>';
}

export function pollText(running: Boolean): String {
  return running ? 'Polls: <col=0dc10d>Running</col>' : 'Polls: <col=ff0000>Inactive</col>';
}

export function dimmedFlash(): Int {
  const [red, green, blue] = hexToRgb(tobHudNameFlasher());
  return rgbToHex(CS2.scale(4, 5, red), CS2.scale(4, 5, green), CS2.scale(4, 5, blue));
}

export function flashDue(deadline: Int): Boolean {
  return clientClock() >= deadline;
}

export enum TabState {
  SELECTED = 0,
  HOVERED = 1,
  REST = 2,
}

export const NO_TAB = -1;

export function stateOf(tab: Int, hovered: Int, index: Int): Int {
  if (tab === index) {
    return TabState.SELECTED;
  }
  if (hovered === index) {
    return TabState.HOVERED;
  }
  return TabState.REST;
}

export function linkShown(index: Int): Boolean {
  const row = UsefulLinks.at(index);
  if (row === null) {
    return false;
  }
  const ios: Boolean = onIos();
  if (row.accountDeletion) {
    if (!ios) {
      return false;
    }
    if (emailUnlinked()) {
      return false;
    }
    return !row.hiddenOnIos;
  }
  if (!ios) {
    return true;
  }
  return !row.hiddenOnIos;
}

export function linkSlot(index: Int): Int {
  let shown: Int = 0;
  let k: Int = 0;
  while (k < index) {
    if (linkShown(k)) {
      shown = shown + 1;
    }
    k = k + 1;
  }
  return shown;
}

export function linkY(slot: Int): Int {
  return Layout.link.top + (slot / 2) * 36 + (slot / 2) * 2;
}

export function linkCentred(slot: Int): Boolean {
  return slot % 2 === 0 && slot + 1 === LINK_TABLE_COUNT;
}

export function linkSubject(label: String): String {
  return `<col=ff9040>${stringFindAndReplace(label, '<br>', '\u00a0')}</col>`;
}

export function hoverBound(): Boolean {
  return !onMobile();
}

export function openTab(): Int {
  const tab: Int = useServerState(AccountVars.TAB);
  if (tab === AccountTab.COMMUNITY || tab === AccountTab.LINKS) {
    return tab;
  }
  return AccountTab.ACCOUNT;
}
