import { useServerState } from 'ts2';

import { BoatrideAnims, BoatrideColors, BoatrideVarps, BoatrideModels, Layout } from './my2arm-boatride.constants';

export function BoatJourney(): Component {
  const journey: Int = useServerState(BoatrideVarps.JOURNEY);
  const sailing: Int = journeyAnimated(journey);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      {sailing === 1 ? (
        <model
          x="center"
          y="center"
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BoatrideModels.MAP}
          anim={journeyAnim(journey)}
          zoom={Layout.map.zoom}
          pitch={Layout.map.pitch}
          offsetX={Layout.map.offsetX}
          offsetY={Layout.map.offsetY}
        />
      ) : (
        <model
          x="center"
          y="center"
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BoatrideModels.MAP}
          zoom={Layout.map.zoom}
          pitch={Layout.map.pitch}
          offsetX={Layout.map.offsetX}
          offsetY={Layout.map.offsetY}
        />
      )}

      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={BoatrideColors.BLACK}
        hide={sailing === 1 ? true : false}
      />
    </layer>
  );
}

export function journeyAnimated(journey: Int): Int {
  switch (journey) {
    case -1:
      return 1;
    case -2:
      return 1;
    case 1:
      return 1;
    case 2:
      return 1;
    case 3:
      return 1;
    case 4:
      return 1;
    case 5:
      return 1;
    case 6:
      return 1;
  }
  return 0;
}

export function journeyAnim(journey: Int): Animation {
  switch (journey) {
    case -1:
      return BoatrideAnims.OUTWARD;
    case -2:
      return BoatrideAnims.RETURNING;
    case 1:
      return BoatrideAnims.OUT_0_1;
    case 2:
      return BoatrideAnims.OUT_1_2;
    case 3:
      return BoatrideAnims.OUT_2_3;
    case 4:
      return BoatrideAnims.OUT_3_1;
    case 5:
      return BoatrideAnims.OUT_3_4;
    case 6:
      return BoatrideAnims.OUT_4_5;
  }
  return BoatrideAnims.OUTWARD;
}
