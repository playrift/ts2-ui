import { createRef } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { BoatJourney } from './boat-journey.component';
import { BoatrideColors, BoatrideDodge, BoatrideFonts, BoatrideModels, Layout } from './my2arm-boatride.constants';

const dodger = createRef('my2arm_boatride_dodger');

const canvas = createRef('my2arm_boatride_canvas');

export function My2armBoatride(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill" onTimer={() => boatrideInit(dodger, canvas)}>
      <rect x="center" y="center" w="fill" h="fill" fill color={BoatrideColors.BLACK} />

      <layer ref={dodger} w="fill" h="fill">
        <layer w="fill" h="fill">
          <layer w="fill" h="fill">
            <layer ref={canvas} x="center" y="center" w={Layout.CANVAS_W} h={Layout.CANVAS_H}>
              <model
                x="center"
                y="center"
                w={Layout.MODEL_BOX}
                h={Layout.MODEL_BOX}
                model={BoatrideModels.SEA}
                zoom={Layout.sea.zoom}
                pitch={Layout.sea.pitch}
                yaw={Layout.sea.yaw}
                offsetX={Layout.sea.offsetX}
                offsetY={Layout.sea.offsetY}
              />

              <text
                x={{ center: Layout.waterbirth.x }}
                y={{ center: Layout.waterbirth.y }}
                w={Layout.waterbirth.w}
                h={Layout.waterbirth.h}
                font={BoatrideFonts.LABEL}
                text="Waterbirth <br>Island"
                align="center"
                valign="middle"
                color={BoatrideColors.LABEL}
              />

              <text
                x={{ center: Layout.miscellania.x }}
                y={{ center: Layout.miscellania.y }}
                w={Layout.miscellania.w}
                h={Layout.miscellania.h}
                font={BoatrideFonts.LABEL}
                text="Miscellania"
                align="center"
                color={BoatrideColors.LABEL}
              />

              <text
                x={{ center: Layout.etceteria.x }}
                y={{ center: Layout.etceteria.y }}
                w={Layout.etceteria.w}
                h={Layout.etceteria.h}
                font={BoatrideFonts.LABEL}
                text="Etceteria"
                align="center"
                valign="middle"
                color={BoatrideColors.LABEL}
              />

              <text
                x={{ center: Layout.rellekka.x }}
                y={{ center: Layout.rellekka.y }}
                w={Layout.rellekka.w}
                h={Layout.rellekka.h}
                font={BoatrideFonts.LABEL}
                text="Rellekka"
                align="center"
                valign="middle"
                color={BoatrideColors.LABEL}
              />

              <text
                x={{ center: Layout.penguins.x }}
                y={{ center: Layout.penguins.y }}
                w={Layout.penguins.w}
                h={Layout.penguins.h}
                font={BoatrideFonts.LABEL}
                text="Penguins"
                align="center"
                valign="middle"
                color={BoatrideColors.LABEL}
              />

              <BoatJourney />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}

export function boatrideInit(dodgerBox: ComponentId, content: ComponentId): void {
  overlayInit(dodgerBox, content, BoatrideDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1);
}
