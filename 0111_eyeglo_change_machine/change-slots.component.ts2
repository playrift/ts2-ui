import { useInventory } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { ChangeColor, ChangeInventories, Layout } from './eyeglo-change-machine.constants';

export function CoinCell({ item }: { item: Item }): Component {
  return (
    <sprite
      item={item}
      itemCount={1}
      itemCountMode="never"
      hide={item === -1 ? true : false}
      outline={1}
      shadowColor={ChangeColor.SLOT_SHADOW}
      options={['Examine']}
      optionSubject={item === -1 ? '' : `<col=ff9040>${itemName(item)}`}
    />
  );
}

export function ChangeInSlots(): Component {
  const input = useInventory(ChangeInventories.IN);
  const slot0: Item = input[0];
  const slot1: Item = input[1];
  const slot2: Item = input[2];

  return (
    <layer w="fill" h="fill">
      <CoinCell item={slot0} x={0} y={Layout.IN_TOP} w={Layout.CELL_W} h={Layout.CELL_H} />
      <CoinCell item={slot1} x={0} y={Layout.IN_TOP + Layout.IN_STEP} w={Layout.CELL_W} h={Layout.CELL_H} />
      <CoinCell item={slot2} x={0} y={Layout.IN_TOP + Layout.IN_STEP * 2} w={Layout.CELL_W} h={Layout.CELL_H} />
    </layer>
  );
}

export function ChangeOutSlots(): Component {
  const output = useInventory(ChangeInventories.OUT);
  const slot0: Item = output[0];
  const slot1: Item = output[1];
  const slot2: Item = output[2];
  const slot3: Item = output[3];

  return (
    <layer w="fill" h="fill">
      <CoinCell item={slot0} x={0} y={Layout.OUT_TOP} w={Layout.CELL_W} h={Layout.CELL_H} />
      <CoinCell item={slot1} x={Layout.OUT_STEP_X} y={Layout.OUT_TOP} w={Layout.CELL_W} h={Layout.CELL_H} />
      <CoinCell item={slot2} x={0} y={Layout.OUT_TOP + Layout.OUT_STEP_Y} w={Layout.CELL_W} h={Layout.CELL_H} />
      <CoinCell
        item={slot3}
        x={Layout.OUT_STEP_X}
        y={Layout.OUT_TOP + Layout.OUT_STEP_Y}
        w={Layout.CELL_W}
        h={Layout.CELL_H}
      />
    </layer>
  );
}
