import { ChangeInSlots, ChangeOutSlots } from './change-slots.component';
import { eygloHandModel, eygloSelectedCoin } from './eyeglo-machine.helpers';
import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { ChangeModel, CloseSprites, Layout } from './eyeglo-change-machine.constants';

export function ChangeHand(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.HAND_X}
        y={Layout.HAND_Y}
        w={Layout.HAND_W}
        h={Layout.HAND_H}
        model={eygloHandModel()}
        zoom={Layout.HAND_ZOOM}
        pitch={Layout.HAND_PITCH}
        yaw={Layout.HAND_YAW}
      />
    </layer>
  );
}

export function ChangeSelectedCoin(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.COIN_X}
        y={Layout.COIN_Y}
        w={Layout.COIN_W}
        h={Layout.COIN_H}
        item={eygloSelectedCoin()}
        itemCount={1}
        deferred
      />
    </layer>
  );
}

export function EygloChangeMachine(): Component {
  return (
    <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
      <model
        x={Layout.MACHINE_X}
        y={Layout.MACHINE_Y}
        w={Layout.MACHINE_W}
        h={Layout.MACHINE_H}
        model={ChangeModel.MACHINE}
        zoom={Layout.MODEL_ZOOM}
      />

      <ChangeInSlots x={Layout.IN_X} y={Layout.IN_Y} w={Layout.IN_W} h={Layout.IN_H} />

      <ChangeOutSlots x={Layout.OUT_X} y={Layout.OUT_Y} w={Layout.OUT_W} h={Layout.OUT_H} />

      <model
        x={Layout.PLATE_X}
        y={Layout.PLATE_Y}
        w={Layout.CONTROL_W}
        h={Layout.CONTROL_H}
        model={ChangeModel.OUTPUT_PLATE}
        zoom={Layout.MODEL_ZOOM}
      />

      <model
        x={Layout.EXCHANGE_X}
        y={Layout.EXCHANGE_Y}
        w={Layout.CONTROL_W}
        h={Layout.CONTROL_H}
        model={ChangeModel.EXCHANGE}
        zoom={Layout.MODEL_ZOOM}
        options={['Exchange']}
      />

      <model
        x={Layout.SLOT_X}
        y={Layout.SLOT_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        model={ChangeModel.COIN_SLOT}
        zoom={Layout.MODEL_ZOOM}
        options={['Insert coin']}
      />

      <model
        x={Layout.CANCEL_X}
        y={Layout.CANCEL_Y}
        w={Layout.CONTROL_W}
        h={Layout.CONTROL_H}
        model={ChangeModel.CANCEL}
        zoom={Layout.MODEL_ZOOM}
        options={['Cancel exchange']}
      />

      <model
        x={Layout.TRAY_X}
        y={Layout.TRAY_Y}
        w={Layout.TRAY_W}
        h={Layout.TRAY_H}
        model={ChangeModel.TRAY}
        zoom={Layout.MODEL_ZOOM}
      />

      <model
        x={Layout.ACCEPT_X}
        y={Layout.ACCEPT_Y}
        w={Layout.CONTROL_W}
        h={Layout.CONTROL_H}
        model={ChangeModel.ACCEPT}
        zoom={Layout.MODEL_ZOOM}
        options={['Accept exchange']}
      />

      <ChangeHand w="fill" h="fill" />
      <ChangeSelectedCoin w="fill" h="fill" />

      <sprite
        x={{ right: Layout.CLOSE_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapperUnlessMobile(event.component, CloseSprites.LIT)}
        onDrag={(event) => graphicSwapperUnlessMobile(event.component, CloseSprites.REST)}
      />
    </layer>
  );
}
