import { CS2, useServerState } from 'ts2';

import { EYEGLO_HAND_REST, EyegloHandModels } from './eyeglo-hand-models.data';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

export function eygloHandModel(): Model {
  return EyegloHandModels.at(useServerState(Varbits.EYEGLO_HAND)) ?? EYEGLO_HAND_REST;
}

export function eygloSelectedCoin(): Item {
  return useServerState(Varps.EYEGLO_COIN_SELECTED) as Item;
}

export function setEygloHandModel(component: ComponentId): void {
  component.model = eygloHandModel();
}

export function setEygloSelectedCoin(component: ComponentId): void {
  CS2.if_item_set(eygloSelectedCoin(), 1, component);
}
