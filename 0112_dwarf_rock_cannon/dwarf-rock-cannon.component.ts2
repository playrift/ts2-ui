import {
  CutsceneCamera,
  CutsceneColor,
  CutsceneFonts,
  CutsceneModel,
  Layout,
  Placeholder,
} from './dwarf-rock-cannon.constants';

export function DwarfRockCannon(): Component {
  return (
    <>
      <rect
        x={Layout.FADE_X}
        y={Layout.FADE_Y}
        w={Layout.STAGE_W}
        h={Layout.STAGE_H}
        fill
        color={CutsceneColor.STAGE}
      />

      <model
        x={Layout.STAGE_MODEL_X}
        y={Layout.STAGE_MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={CutsceneModel.BACKING}
        zoom={CutsceneCamera.ROCK_ZOOM}
        pitch={CutsceneCamera.ROCK_PITCH}
        yaw={CutsceneCamera.ROCK_YAW}
      />

      <model
        x={Layout.STAGE_MODEL_X}
        y={Layout.STAGE_MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={CutsceneModel.HEAD}
        zoom={CutsceneCamera.STAGE_HEAD_ZOOM}
        pitch={CutsceneCamera.STAGE_HEAD_PITCH}
        yaw={CutsceneCamera.STAGE_HEAD_YAW}
      />

      <model
        x={Layout.STAGE_MODEL_X}
        y={Layout.STAGE_MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={CutsceneModel.FRONT}
        zoom={CutsceneCamera.ROCK_ZOOM}
        pitch={CutsceneCamera.ROCK_PITCH}
        yaw={CutsceneCamera.ROCK_YAW}
      />

      <layer x={Layout.NPC_BAND_X} y={Layout.NPC_BAND_Y} w={Layout.NPC_BAND_W} h={Layout.NPC_BAND_H}>
        <text
          x={Layout.NPC_NAME_X}
          y={Layout.NPC_NAME_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text={Placeholder.NAME}
          font={CutsceneFonts.LABEL}
          color={CutsceneColor.NAME}
          shadow
          align="center"
          valign="top"
        />

        <text
          x={Layout.NPC_LINE_X}
          y={Layout.NPC_LINE_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text={Placeholder.LINE}
          font={CutsceneFonts.LABEL}
          color={CutsceneColor.LINE}
          align="center"
          valign="top"
        />

        <model
          x={Layout.NPC_HEAD_X}
          y={Layout.NPC_HEAD_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={CutsceneModel.HEAD}
          zoom={CutsceneCamera.CHATHEAD_ZOOM}
          pitch={CutsceneCamera.CHATHEAD_PITCH}
          yaw={CutsceneCamera.CHATHEAD_YAW}
        />
      </layer>

      <layer x={Layout.PLAYER_BAND_X} y={Layout.PLAYER_BAND_Y} w={Layout.PLAYER_BAND_W} h={Layout.PLAYER_BAND_H}>
        <text
          x={Layout.PLAYER_LINE_X}
          y={Layout.PLAYER_LINE_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text={Placeholder.LINE}
          font={CutsceneFonts.LABEL}
          color={CutsceneColor.LINE}
          align="center"
          valign="top"
        />
      </layer>

      <layer hide x={Layout.FADE_X} y={Layout.FADE_Y} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.FADE_X}
          y={Layout.FADE_Y}
          w={Layout.STAGE_W}
          h={Layout.STAGE_H}
          model={CutsceneModel.FADE}
          zoom={CutsceneCamera.FADE_ZOOM}
          pitch={CutsceneCamera.FADE_PITCH}
        />
      </layer>
    </>
  );
}
