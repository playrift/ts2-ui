import {
  Camera,
  Layout,
  SchematicArt,
  SchematicColors,
  SchematicFonts,
  SchematicModel,
  SchematicText,
} from './dwarf-rock-schematics.constants';

export function DwarfRockSchematics(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H} fill color={SchematicColors.BACKING} />

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.PAPER_X}
          y={Layout.PAPER_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.PAPER}
          zoom={Camera.PAPER.ZOOM}
          pitch={Camera.PAPER.PITCH}
          yaw={Camera.PAPER.YAW}
        />
      </layer>

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.SCHEMATIC_1_X}
          y={Layout.SCHEMATIC_1_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.SCHEMATIC_1}
          zoom={Camera.SCHEMATIC_1.ZOOM}
          pitch={Camera.SCHEMATIC_1.PITCH}
          yaw={Camera.SCHEMATIC_1.YAW}
        />
      </layer>

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.SCHEMATIC_2_X}
          y={Layout.SCHEMATIC_2_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.SCHEMATIC_2}
          zoom={Camera.SCHEMATIC_2.ZOOM}
          pitch={Camera.SCHEMATIC_2.PITCH}
          yaw={Camera.SCHEMATIC_2.YAW}
        />
      </layer>

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.SCHEMATIC_3_X}
          y={Layout.SCHEMATIC_3_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.SCHEMATIC_3}
          zoom={Camera.SCHEMATIC_3.ZOOM}
          pitch={Camera.SCHEMATIC_3.PITCH}
          yaw={Camera.SCHEMATIC_3.YAW}
        />
      </layer>

      <layer x={Layout.BUTTONS_X} y={Layout.BUTTONS_Y} w={Layout.BUTTONS_W} h={Layout.BUTTONS_H} />

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.BORDER_1_X}
          y={Layout.BORDER_1_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.BORDER_1}
          zoom={Camera.BORDER_1.ZOOM}
          pitch={Camera.BORDER_1.PITCH}
          yaw={Camera.BORDER_1.YAW}
        />
      </layer>

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.BORDER_2_X}
          y={Layout.BORDER_2_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.BORDER_2}
          zoom={Camera.BORDER_2.ZOOM}
          pitch={Camera.BORDER_2.PITCH}
          yaw={Camera.BORDER_2.YAW}
        />
      </layer>

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.BORDER_3_X}
          y={Layout.BORDER_3_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SchematicModel.BORDER_3}
          zoom={Camera.BORDER_3.ZOOM}
          pitch={Camera.BORDER_3.PITCH}
          yaw={Camera.BORDER_3.YAW}
        />
      </layer>

      <layer x={0} y={Layout.BANNER_Y} w={Layout.STAGE_W} h={Layout.BANNER_H} hide>
        <text
          x={0}
          y={0}
          w={Layout.STAGE_W}
          h={Layout.BANNER_H}
          text={SchematicText.CONGRATULATION}
          font={SchematicFonts.BANNER}
          color={SchematicColors.BANNER}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={SchematicArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SchematicArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
