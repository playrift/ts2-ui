        sprite={FrameArt.CORNER_BOTTOM_RIGHT}
      />
      <sprite
        x={Layout.RIGHT_EDGE_X}
        y={Layout.RIGHT_EDGE_UPPER_Y}
        w={Layout.BAR}
        h={Layout.BAR}
