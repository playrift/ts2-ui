import { onMobile } from '../lib/lib.helpers';

export type AttackOption = {
  desktop: String;
  mobile: String;
};

export const PlayerAttackOptions = listOf<AttackOption>([
  { desktop: 'Depends on combat levels', mobile: 'Depends on combat levels' },
  { desktop: 'Always right-click', mobile: 'Always long-tap' },
  { desktop: 'Left-click where available', mobile: 'Tap where available' },
  { desktop: 'Hidden', mobile: 'Hidden' },
  { desktop: 'Right-click for clanmates', mobile: 'Long-tap for clanmates' },
]);

export const NpcAttackOptions = listOf<AttackOption>([
  { desktop: 'Depends on combat levels', mobile: 'Depends on combat levels' },
  { desktop: 'Always right-click', mobile: 'Always long-tap' },
  { desktop: 'Left-click where available', mobile: 'Tap where available' },
  { desktop: 'Hidden', mobile: 'Hidden' },
]);

export function attackOptionText(options: List<AttackOption>, value: Int): String {
  const row = options.at(value);
  if (row === null) {
    return 'Depends on combat levels';
  }
  if (onMobile()) {
    return row.mobile;
  }
  return row.desktop;
}
