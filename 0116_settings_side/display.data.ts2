import { CS2, useServerState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { onEnhancedDesktop } from './settings-side.helpers';
import { SideVars } from './settings-side.constants';

export const BRIGHTNESS_STEPS = 21;

export const ClientLayouts = listOf<String>([
  'Fixed - Classic layout',
  'Resizable - Classic layout',
  'Resizable - Modern layout',
]);

export const FramerateCaps = listOf<String>(['15 fps', '20 fps', '30 fps', '60 fps', 'Unlimited']);

export function clientLayoutIndex(): Int {
  if (CS2.window_mode_get() === 1) {
    return 0;
  }
  if (useServerState(SideVars.RESIZABLE_STONES) === 0) {
    return 1;
  }
  return 2;
}

export function framerateCapIndex(): Int {
  if (!onMobile() && !onEnhancedDesktop()) {
    return 4;
  }
  const capped: Int = CS2.device_option_get(DeviceOption.FRAMERATE);
  if (capped === 0) {
    return 4;
  }
  if (capped <= 15) {
    return 0;
  }
  if (capped <= 20) {
    return 1;
  }
  if (capped <= 30) {
    return 2;
  }
  if (capped <= 60) {
    return 3;
  }
  return 4;
}

export function setFramerateCap(index: Int): void {
  if (!onMobile() && !onEnhancedDesktop()) {
    return;
  }
  const fps: Int = index === 0 ? 15 : index === 1 ? 20 : index === 2 ? 30 : index === 3 ? 60 : 999;
  CS2.device_option_set(DeviceOption.FRAMERATE, fps);
  CS2.device_option_set(DeviceOption.FRAMERATE_ALT, fps);
}

export enum DeviceOption {
  BRIGHTNESS = 6,
  FRAMERATE = 5,
  FRAMERATE_ALT = 26,
  NEW_RENDERER_BLOCKED = 25,
}
