}

function HighlightBar({ hovered, entryH }: { hovered: Int; entryH: Int }): Component {
  return (
    <rect
      y={hovered * entryH - 1}
      w="fill"
      h={entryH + DropdownGeometry.highlightPad}
      color={SideColor.WHITE}
      fill
      transparency={200}
      hide={noEntryHovered(hovered)}
    />
  );
}

function ListScrollbar({ content }: { content: Ref }): Component {
  return (
    <layer
      x={{ right: Layout.overlayScroll.right }}
      y="center"
      w={Layout.overlayScroll.w}
      h={{ fill: Layout.overlayScroll.insetH }}
    >
      <ScrollbarVertical
        content={content}
        track={SideArt.SCROLL_TRACK}
        capTopSprite={SideArt.SCROLL_CAP_TOP}
        thumbSprite={SideArt.SCROLL_THUMB}
        capBottomSprite={SideArt.SCROLL_CAP_BOTTOM}
        arrowUp={SideArt.SCROLL_ARROW_UP}
        arrowDown={SideArt.SCROLL_ARROW_DOWN}
      />
    </layer>
  );
}

function isClamped(panelH: Int, room: Int): Boolean {
  if (panelH > room) {
    return true;
  }
  return false;
}

function noEntryHovered(hovered: Int): Boolean {
  if (hovered < 0) {
    return true;
  }
  return false;
}
