import { useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { openDropdown } from './settings-side.state';
import { clickSound, eq } from './settings-side.helpers';
import { Layout, SideArt, SideColor, SideFont } from './settings-side.constants';

export function DropdownRow({ label, text, id, y }: { label: String; text: String; id: Int; y: Int }): Component {
  const mobile: Boolean = onMobile();
  const [hovered, setHovered] = useState(0);
  const [open, setOpen] = useState(openDropdown);
  const expanded: Boolean = eq(open, id);

  const plateAlpha: Int = expanded ? 255 : hovered === 1 ? 100 : 0;
  const chevron: Sprite = expanded ? SideArt.CHEVRON_OPEN : SideArt.CHEVRON_CLOSED;
  const chevronAlpha: Int = expanded ? 0 : hovered === 1 ? 125 : 0;
  const valueColor: Int = expanded || hovered === 1 ? SideColor.LABEL_LIT : SideColor.LABEL;

  return (
    <layer x="center" y={y} w={{ fill: Layout.dropdown.insetW }} h={Layout.dropdown.h}>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={Layout.dropdown.controlH}
        sprite={SideArt.BACKING}
        tiling
        transparency={plateAlpha}
        onClick={() => {
          clickSound();
          setOpen(id);
        }}
        onMouseEnter={mobile ? undefined : () => setHovered(1)}
        onMouseLeave={mobile ? undefined : () => setHovered(0)}
      />
      <rect x="center" y="bottom" w="fill" h={Layout.dropdown.controlH} color={SideColor.DROPDOWN_BORDER} />
      <rect
        x="center"
        y={{ bottom: Layout.dropdown.innerY }}
        w={{ fill: Layout.dropdown.innerInset }}
        h={Layout.dropdown.innerH}
        color={SideColor.DROPDOWN_INNER}
      />
      <sprite
        x={{ right: Layout.dropdown.chevronInset }}
        y={{ bottom: Layout.dropdown.chevronInset }}
        w={Layout.dropdown.chevron}
        h={Layout.dropdown.chevron}
        sprite={chevron}
        transparency={chevronAlpha}
      />
      <text
        x={Layout.dropdown.valueX}
        y={{ bottom: Layout.dropdown.valueY }}
        w={{ fill: Layout.dropdown.valueInsetW }}
        h={Layout.dropdown.valueH}
        text={text}
        font={SideFont.SMALL}
        color={valueColor}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="center"
        w="fill"
        h={{ fill: Layout.dropdown.labelInsetH }}
        text={`${label}:`}
        font={SideFont.BODY}
        color={SideColor.LABEL}
        shadow
        align="left"
        valign="middle"
      />
    </layer>
  );
}
