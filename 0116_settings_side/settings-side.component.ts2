import { useServerState, useState } from 'ts2';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { AudioPanel } from './audio-panel.component';
import { ControlsPanel } from './controls-panel.component';
import { DisplayPanel } from './display-panel.component';
import { DropdownOverlay } from './dropdown-overlay.component';
import { TabRail } from './tab-rail.component';
import { clickSound } from './settings-side.helpers';
import { Layout, LineHeight, SideColor, SideFont, SideTab, SideVars } from './settings-side.constants';

export function SettingsSide(): Component {
  return (
    <>
      <TabRail />
      <Heading />
      <layer x="center" y={{ bottom: Layout.frame.bottom }} w={Layout.frame.w} h={Layout.frame.h}>
        <ControlsPanel />
        <AudioPanel />
        <DisplayPanel />
        <SteelFrameEntrypoint />
      </layer>
      <AllSettingsButton />
      <DropdownOverlay />
      <layer w={Layout.tooltip.w} h={Layout.tooltip.h} />
    </>
  );
}

function Heading(): Component {
  const tab: Int = useServerState(SideVars.TAB);
  const title: String =
    tab === SideTab.AUDIO ? 'Audio Settings' : tab === SideTab.DISPLAY ? 'Display Settings' : 'Controls Settings';

  return (
    <text
      y={Layout.heading.y}
      w="fill"
      h={Layout.heading.h}
      text={title}
      font={SideFont.HEADING}
      color={SideColor.LABEL}
      shadow
      align="center"
      valign="middle"
    />
  );
}

function AllSettingsButton(): Component {
  const [pressed, setPressed] = useState(0);
  const mobile: Boolean = onMobile();

  return (
    <layer
      x="center"
      y={{ bottom: Layout.allSettings.bottom }}
      w={{ fill: Layout.allSettings.insetW }}
      h={Layout.allSettings.h}
      options={['All Settings']}
      onOptionSelect={() => clickSound()}
      onMouseRepeat={mobile ? undefined : () => setPressed(1)}
      onMouseLeave={mobile ? undefined : () => setPressed(0)}
    >
      {pressed === 1 ? (
        <StoneButtonPressedFilled>
          <AllSettingsCaption />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonFilled>
          <AllSettingsCaption />
        </StoneButtonFilled>
      )}
    </layer>
  );
}

function AllSettingsCaption(): Component {
  return (
    <text
      x="center"
      y="center"
      w={{ fill: Layout.allSettings.textInset }}
      h={{ fill: Layout.allSettings.textInset }}
      text="All Settings"
      font={SideFont.SMALL}
      color={SideColor.LABEL}
      shadow
      align="center"
      valign="middle"
      lineHeight={LineHeight.BUTTON}
    />
  );
}
