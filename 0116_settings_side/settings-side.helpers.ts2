import { CS2, useServerState } from 'ts2';
import { ClientVarbits } from '../lib/lib.constants';
import { playSound } from '../lib/lib.engine';
import { CLICK_SOUND } from './settings-side.constants';

export function clickSound(): void {
  playSound(CLICK_SOUND);
}

export function runEnergyText(): String {
  return `${CS2.runenergy_visible()}%`;
}

export function eq(a: Int, b: Int): Boolean {
  if (a === b) {
    return true;
  }
  return false;
}

export function neq(a: Int, b: Int): Boolean {
  if (a === b) {
    return false;
  }
  return true;
}

export function onEnhancedDesktop(): Boolean {
  if (useServerState(ClientVarbits.SIMULATE_MOBILE) === 1) {
    return false;
  }
  const client: Int = CS2.clienttype();
  if (client === 4 || client === 5 || client === 10) {
    return true;
  }
  return false;
}

export function onEnhancedMobile(): Boolean {
  const client: Int = CS2.clienttype();
  if (useServerState(ClientVarbits.SIMULATE_MOBILE) === 1 && (client === 4 || client === 5 || client === 10)) {
    return true;
  }
  if (client === 7 || client === 8) {
    return true;
  }
  return false;
}

export function onEnhancedAny(): Boolean {
  if (onEnhancedDesktop()) {
    return true;
  }
  return onEnhancedMobile();
}
