import { createRef } from 'ts2';
import { Layout } from './settings-side.constants';
import { SettingsSide } from './settings-side.component';

const settingsSideRef = createRef('settings_side');

export const settingsSideUi = (): UI => (
  <ui ref={settingsSideRef} w={Layout.root.w} h={Layout.root.h}>
    <SettingsSide />
  </ui>
);
