import { predictServerState, useServerState } from 'ts2';
import { clickSound, runEnergyText } from './settings-side.helpers';
import { Layout, LineHeight, SideArt, SideColor, SideFont, SideVars } from './settings-side.constants';

export function SideButtons(): Component {
  const aid: Int = useServerState(SideVars.ACCEPT_AID);
  const ironman: Int = useServerState(SideVars.IRONMAN);
  const run: Int = useServerState(SideVars.RUN);

  return (
    <layer x="center" y={{ bottom: Layout.buttons.bottom }} w={Layout.buttons.w} h={Layout.buttons.h}>
      <layer
        x={Layout.buttons.first}
        w={Layout.buttons.size}
        h="fill"
        options={['Toggle Accept Aid']}
        onOptionSelect={() => toggleAcceptAid(aid, ironman)}
      >
        <Plate on={aid} />
        <sprite x="center" y="center" w={Layout.button.glyph} h={Layout.button.glyph} sprite={SideArt.ICON_AID} />
      </layer>

      <layer
        x={Layout.buttons.first + Layout.buttons.pitch}
        w={Layout.buttons.size}
        h="fill"
        options={['Toggle Run']}
        onOptionSelect={() => toggleRun(run)}
      >
        <Plate on={run} />
        <sprite
          x="center"
          y={{ center: Layout.runButton.glyphY }}
          w={Layout.runButton.glyphW}
          h={Layout.runButton.glyphH}
          sprite={SideArt.ICON_RUN}
        />
        <text
          x="center"
          y={{ center: Layout.runButton.textY }}
          w={{ fill: Layout.runButton.textInsetW }}
          h={Layout.runButton.textH}
          text={runEnergyText()}
          font={SideFont.BODY}
          color={SideColor.LABEL}
          shadow
          align="center"
          valign="middle"
          lineHeight={LineHeight.BUTTON}
        />
      </layer>

      <layer
        x={Layout.buttons.first + Layout.buttons.pitch * 2}
        w={Layout.buttons.size}
        h="fill"
        options={['View House Options']}
        onOptionSelect={() => clickSound()}
      >
        <sprite x="center" y="center" w={Layout.button.plate} h={Layout.button.plate} sprite={SideArt.BUTTON_OFF} />
        <sprite x="center" y="center" w={Layout.button.glyph} h={Layout.button.glyph} sprite={SideArt.ICON_HOUSE} />
      </layer>

      <layer
        x={Layout.buttons.first + Layout.buttons.pitch * 3}
        w={Layout.buttons.size}
        h="fill"
        options={['Open Bond Pouch']}
        onOptionSelect={() => clickSound()}
      >
        <sprite x="center" y="center" w={Layout.button.plate} h={Layout.button.plate} sprite={SideArt.BUTTON_OFF} />
        <sprite
          x={{ center: Layout.button.bond.x }}
          y="center"
          w={Layout.button.bond.w}
          h={Layout.button.bond.h}
          item={SideArt.BOND}
          itemCount={1}
          itemCountMode="never"
          outline={1}
        />
      </layer>
    </layer>
  );
}

function Plate({ on }: { on: Int }): Component {
  return (
    <sprite
      x="center"
      y="center"
      w={Layout.button.plate}
      h={Layout.button.plate}
      sprite={on > 0 ? SideArt.BUTTON_ON : SideArt.BUTTON_OFF}
    />
  );
}

function toggleAcceptAid(aid: Int, ironman: Int): void {
  clickSound();
  if (aid === 0 && ironman === 0) {
    predictServerState(SideVars.ACCEPT_AID, 1);
    return;
  }
  predictServerState(SideVars.ACCEPT_AID, 0);
}

function toggleRun(run: Int): void {
  clickSound();
  if (run <= 0) {
    predictServerState(SideVars.RUN, 1);
    return;
  }
  predictServerState(SideVars.RUN, 0);
}
