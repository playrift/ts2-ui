import { Layout, SideArt } from './settings-side.constants';

const TROUGH = [
  SideArt.SLIDER_CAP_LEFT,
  SideArt.SLIDER_LIT,
  SideArt.SLIDER_SHADE,
  SideArt.SLIDER_EDGE,
  SideArt.SLIDER_BODY,
  SideArt.SLIDER_SHADE,
  SideArt.SLIDER_EDGE,
  SideArt.SLIDER_BODY,
  SideArt.SLIDER_CAP_RIGHT,
];

export function SliderTrough(): Component {
  return (
    <>
      {TROUGH.map((sprite, index) => (
        <sprite x={index * Layout.slider.h} w={Layout.slider.h} h={Layout.slider.h} sprite={sprite} />
      ))}
    </>
  );
}
