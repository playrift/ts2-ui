import { createRef, useInterval } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { FilmAnims, FilmCamera, FilmModel } from './enakh-film.constants';

const timerHost = createRef('0117_enakh_film_timer_host');

const filmSheet = createRef('enakh_film_sheet');

export function EnakhFilm(): Component {
  useInterval(
    () =>
      modelTransparentDynamicZoom(
        timerHost,
        filmSheet,
        FilmCamera.NEAR,
        FilmCamera.FAR,
        FilmCamera.OFFSET_X,
        FilmCamera.OFFSET_Y,
        FilmCamera.PITCH,
        FilmCamera.YAW,
        FilmCamera.ROLL,
      ),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <model
        ref={filmSheet}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={FilmModel.FILM}
        anim={FilmAnims.FILM}
        zoom={FilmCamera.NEAR}
        offsetX={FilmCamera.OFFSET_X}
        offsetY={FilmCamera.OFFSET_Y}
      />
    </layer>
  );
}
