import { createRef } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { FilmAnims, FilmCamera, FilmModel } from './enakh-film.constants';

const filmSheet = createRef('enakh_film_sheet');

export function EnakhFilm(): Component {
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onTimer={(event) =>
        modelTransparentDynamicZoom(
          event.component,
          filmSheet,
          FilmCamera.NEAR,
          FilmCamera.FAR,
          FilmCamera.OFFSET_X,
          FilmCamera.OFFSET_Y,
          FilmCamera.PITCH,
          FilmCamera.YAW,
          FilmCamera.ROLL,
        )
      }
    >
      <model
        ref={filmSheet}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={FilmModel.FILM}
        anim={FilmAnims.FILM}
        zoom={FilmCamera.NEAR}
        offsetX={FilmCamera.OFFSET_X}
        offsetY={FilmCamera.OFFSET_Y}
      />
    </layer>
  );
}
