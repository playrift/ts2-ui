import { createRef, useInterval } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { SmokeAnims, SmokeCamera, SmokeModel, SmokeTint } from './enakh-smoke-overlay.constants';

const timerHost = createRef('0118_enakh_smoke_overlay_timer_host');

const smokeSheet = createRef('enakh_smoke_overlay_smoke');

export function EnakhSmokeOverlay(): Component {
  useInterval(
    () =>
      modelTransparentDynamicZoom(
        timerHost,
        smokeSheet,
        SmokeCamera.NEAR,
        SmokeCamera.FAR,
        SmokeCamera.OFFSET_X,
        SmokeCamera.OFFSET_Y,
        SmokeCamera.PITCH,
        SmokeCamera.YAW,
        SmokeCamera.ROLL,
      ),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={SmokeTint.COLOR}
        fill={true}
        transparency={SmokeTint.TRANSPARENCY}
      />

      <model
        ref={smokeSheet}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={SmokeModel.SMOKE}
        anim={SmokeAnims.SMOKE}
        zoom={SmokeCamera.NEAR}
      />
    </layer>
  );
}
