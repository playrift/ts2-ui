import { CS2 } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { mobileSideStripMode } from '../lib/lib.overlay';
import { List } from './questjournal.constants';

export function largeParchment(frameHeight: Int): Boolean {
  if (frameHeight >= 580 && !onMobile()) {
    return true;
  }
  return false;
}

export function listExtent(lines: Int, paneHeight: Int): Int {
  const content: Int = lines * List.ROW_STEP;
  if (content <= paneHeight) {
    return 0;
  }
  return content + CS2.scale(List.SLACK_NUM, List.SLACK_DEN, paneHeight);
}

export function rowTop(row: Int): Int {
  switch (row) {
    case 100:
      return 1999;
    case 103:
      return 2059;
    case 106:
      return 2121;
    case 107:
      return 2141;
    case 108:
      return 2161;
    case 110:
      return 2201;
    case 111:
      return 2221;
    case 112:
      return 2241;
    case 113:
      return 2261;
    case 116:
      return 2319;
    case 117:
      return 2339;
  }
  return row * List.ROW_STEP;
}

export function rowLeft(row: Int): Int {
  if (row === 37) {
    return -1;
  }
  return 0;
}

export function mobileTopBarHalf(): Int {
  if (onMobile()) {
    return (165 - 20) / 2;
  }
  return 0;
}

export function sideStripWidth(mode: Int): Int {
  if (mode === 2) {
    return 20;
  }
  if (mode === 3) {
    return 204;
  }
  if (mode === 4) {
    return 204 + 20;
  }
  return 0;
}

export function mobileFrameX(frameW: Int, parentW: Int, parentH: Int, frameH: Int): Int {
  const tall: Int = frameH >= parentH - 166 + 26 ? 1 : 0;
  const inset: Int = (parentW - 181 + 40) / 2 - frameW / 2;
  const strip: Int = sideStripWidth(mobileSideStripMode());

  if (frameW + strip * 2 + 10 <= parentW && tall === 0) {
    return 0;
  }
  if (strip > 1) {
    const stripped: Int = (parentW - strip + 3) / 2 - frameW / 2;
    if (tall === 1 && inset + frameW + strip + 4 <= parentW) {
      return Math.max(0, inset);
    }
    return Math.max(0, stripped);
  }
  if (tall === 0) {
    return 0;
  }
  return Math.max(0, inset);
}

export function mobileFrameCentred(frameW: Int, parentW: Int, parentH: Int, frameH: Int): Boolean {
  const tall: Int = frameH >= parentH - 166 + 26 ? 1 : 0;
  const strip: Int = sideStripWidth(mobileSideStripMode());

  if (frameW + strip * 2 + 10 <= parentW && tall === 0) {
    return true;
  }
  if (strip > 1) {
    return false;
  }
  if (tall === 0) {
    return true;
  }
  return false;
}

export function mobileFrameY(parentH: Int, frameH: Int): Int {
  return Math.min(mobileTopBarHalf(), (parentH - frameH) / 2);
}
