import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { graphicSwapper, opsound } from '../lib/lib.helpers';
import {
  TOURNAMENT_OPSOUND_MASK,
  TOURNAMENT_TITLE,
  TournamentColor,
  TournamentFonts,
  TournamentLayout,
  TournamentSprites,
} from './tournament-sidepanel.constants';

export function TournamentSidepanel(): Component {
  return (
    <>
      <text
        x="center"
        y={0}
        w="fill"
        h={TournamentLayout.TITLE_H}
        font={TournamentFonts.TITLE}
        color={TournamentColor.TITLE}
        text={TOURNAMENT_TITLE}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={{ right: TournamentLayout.CLOSE_RIGHT }}
        y={TournamentLayout.CLOSE_TOP}
        w={TournamentLayout.CLOSE}
        h={TournamentLayout.CLOSE}
        sprite={TournamentSprites.CLOSE}
        options={['Close']}
        onOptionSelect={(event) => opsound(event.option, TOURNAMENT_OPSOUND_MASK)}
        onMouseEnter={(event) => graphicSwapper(event.component, TournamentSprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TournamentSprites.CLOSE)}
      />

      <layer
        x="center"
        y={TournamentLayout.CONTENTS_TOP}
        w={{ fill: TournamentLayout.CONTENTS_INSET_W }}
        h={{ fill: TournamentLayout.CONTENTS_INSET_H }}
      >
        <sprite
          x="center"
          y="center"
          w={{ fill: TournamentLayout.BACKING_INSET }}
          h={{ fill: TournamentLayout.BACKING_INSET }}
          sprite={TournamentSprites.BACKING}
          tiling
        />

        <layer
          x={TournamentLayout.LIST_X}
          y="center"
          w={{ fill: TournamentLayout.LIST_INSET_W }}
          h={{ fill: TournamentLayout.LIST_INSET_H }}
        />

        <layer
          x={{ right: TournamentLayout.SCROLLBAR_RIGHT }}
          y="center"
          w={TournamentLayout.SCROLLBAR_W}
          h={{ fill: TournamentLayout.SCROLLBAR_INSET_H }}
        />

        <ThinBoxEntrypoint />
      </layer>

      <layer
        x="center"
        y={{ bottom: 0 }}
        w={TournamentLayout.REFRESH_W}
        h={TournamentLayout.REFRESH_H}
        options={['Refresh']}
      />

      <layer
        x={{ right: TournamentLayout.CONTROLS_RIGHT }}
        y={{ bottom: 0 }}
        w={TournamentLayout.CONTROLS}
        h={TournamentLayout.CONTROLS}
        hide
        options={['*']}
      >
        <sprite
          x="center"
          y="center"
          w={TournamentLayout.CONTROLS_GLYPH}
          h={TournamentLayout.CONTROLS_GLYPH}
          sprite={TournamentSprites.CONTROLS_GLYPH}
        />
      </layer>
    </>
  );
}
