import { KeyChoices } from './keybinding.data';
import { dropdownLeft, dropdownTop } from './keybinding.helpers';
import { KeybindingColor, KeybindingFonts, KeybindingText, Layout } from './keybinding.constants';
import { closeDropdown } from './keybinding.state';

export function KeybindingDropdown({ stone }: { stone: Int }): Component {
  return (
    <layer x={dropdownLeft(stoneX(stone))} y={dropdownTop(stoneY(stone))} w={Layout.DROPDOWN_W} h={Layout.DROPDOWN_H}>
      <rect w={{ fill: Layout.DROPDOWN_WELL_INSET }} h="fill" fill color={KeybindingColor.WELL} />
      <rect w={{ fill: Layout.DROPDOWN_WELL_INSET }} h="fill" color={KeybindingColor.WELL_EDGE} />
      <layer w={{ fill: Layout.DROPDOWN_WELL_INSET }} h={Layout.DROPDOWN_LIST_H}>
        {KeyChoices.map((entry) => (
          <text
            x={Layout.ENTRY_X + (entry.key % 2) * Layout.ENTRY_W}
            y={Layout.ENTRY_Y + (entry.key / 2) * Layout.ENTRY_H}
            w={Layout.ENTRY_W}
            h={Layout.ENTRY_H}
            text={entry.name}
            font={KeybindingFonts.BODY}
            color={KeybindingColor.ENTRY}
            hover={{ color: KeybindingColor.ENTRY_HOVER }}
            options={[KeybindingText.SELECT]}
            onOptionSelect={() => closeDropdown()}
          />
        ))}
      </layer>
      <layer x="right" w={Layout.DROPDOWN_SCROLLBAR_W} h={Layout.DROPDOWN_LIST_H} />
    </layer>
  );
}

function stoneX(stone: Int): Int {
  if (stone <= 5) {
    return 20;
  }
  if (stone <= 10) {
    return 180;
  }
  return 340;
}

function stoneY(stone: Int): Int {
  if (stone <= 5) {
    return 5 + (stone - 1) * 43;
  }
  if (stone <= 10) {
    return 5 + (stone - 6) * 43;
  }
  return 5 + (stone - 11) * 43;
}
