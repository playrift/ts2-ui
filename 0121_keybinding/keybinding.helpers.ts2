import { onMobile } from '../lib/lib.helpers';

import { KeybindingSprites, Layout } from './keybinding.constants';

export function pressedTile(): Sprite {
  if (onMobile()) {
    return KeybindingSprites.TILE_MOBILE_OPEN;
  }
  return KeybindingSprites.TILE_OPEN;
}

export function dropdownLeft(rowX: Int): Int {
  return rowX + Layout.DROPDOWN_DX;
}

export function dropdownTop(rowY: Int): Int {
  const below: Int = rowY + Layout.DROPDOWN_DY;
  if (below + Layout.DROPDOWN_H > Layout.BODY_H) {
    return rowY + Layout.DROPDOWN_FLIP_DY - Layout.DROPDOWN_H;
  }
  return below;
}
