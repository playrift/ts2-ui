import { predictServerState, sessionState, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';

export const DropdownOpen = sessionState(0);

export function selectStone(stone: Int): void {
  predictServerState(Varbits.KEYBINDING_STONE_SELECTION, stone);
}

export function selectedStone(): Int {
  return useServerState(Varbits.KEYBINDING_STONE_SELECTION);
}

export function openDropdown(stone: Int): void {
  selectStone(stone);
  const [, setOpen] = useState(DropdownOpen);
  setOpen(1);
}

export function closeDropdown(): void {
  const [, setOpen] = useState(DropdownOpen);
  setOpen(0);
}

export function escClosesInterface(): Int {
  return useServerState(Varbits.KEYBINDING_ESC_TO_CLOSE);
}

export function toggleEscCloses(): void {
  if (escClosesInterface() === 0) {
    predictServerState(Varbits.KEYBINDING_ESC_TO_CLOSE, 1);
    return;
  }
  predictServerState(Varbits.KEYBINDING_ESC_TO_CLOSE, 0);
}
