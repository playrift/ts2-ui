export function skillName(skill: Int): String {
  return SkillNames.get(skill as Skill) ?? 'Skill';
}

export function dimTag(): String {
  return textClient('<col=7f7f7f>', '<col=adadad>');
}

export function grouped(value: Int): String {
  return groupDigits(value, SEPARATOR);
}
