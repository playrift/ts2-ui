import { Skills, XpDropTiming, XpDropsChoice, XpDropsFont, XpDropsLayout, XpDropsVars } from './xp-drops.constants';

export function dropLineHeight(): Int {
  const size: Int = useServerState(XpDropsVars.SIZE);
  if (onMobile()) {
    return XpDropsLayout.drop.small;
  }
  if (size === 1 || size === 2) {
    return XpDropsLayout.drop.large;
  }
  return XpDropsLayout.drop.small;
}

export function dropFont(): Font {
  const size: Int = useServerState(XpDropsVars.SIZE);
  if (onMobile()) {
    return XpDropsFont.SMALL;
  }
  if (size === 1) {
    return XpDropsFont.MEDIUM;
  }
  if (size === 2) {
    return XpDropsFont.LARGE;
  }
  return XpDropsFont.SMALL;
}

export function containerWidth(): Int {
  return (
    XpDropsLayout.counter.iconGutter +
    textWidth(XpDropsLayout.counter.widest, XpDropsLayout.counter.measureAt, dropFont()) +
    XpDropsLayout.counter.tail
  );
}

export function counterSkill(): Int {
  const kind: Int = useServerState(XpDropsVars.COUNTER_TYPE);
  if (kind === XpDropsChoice.RECENT) {
    const [last] = useState(xpdropsLastskill);
    return last;
  }
  if (kind === XpDropsChoice.TAIL) {
    return -2;
  }
  const skill: Skill | null = SkillByIndex.get(kind);
  if (skill === null) {
    return -1;
  }
  return skill as Int;
}

export function progressSkill(): Int {
  const kind: Int = useServerState(XpDropsVars.PROGRESS_TYPE);
  if (kind === XpDropsChoice.RECENT) {
    const [last] = useState(xpdropsLastskill);
    return last;
  }
  if (kind === XpDropsChoice.TAIL) {
    return -2;
  }
  const skill: Skill | null = SkillByIndex.get(kind);
  if (skill === null) {
    return -1;
  }
  return skill as Int;
}

export function xpTotal(): [Int, Int] {
  let low: Int = 0;
  let high: Int = 0;
  low = low + xpOf(Skills.ATTACK);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.STRENGTH);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.RANGED);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.MAGIC);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.DEFENCE);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HITPOINTS);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.PRAYER);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.AGILITY);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HERBLORE);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.THIEVING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.CRAFTING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.RUNECRAFT);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.MINING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SMITHING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FISHING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.COOKING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FIREMAKING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.WOODCUTTING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FLETCHING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SLAYER);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FARMING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.CONSTRUCTION);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HUNTER);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SAILING);
  while (low >= XP_BILLION) {
    low = low - XP_BILLION;
    high = high + 1;
  }
  return [high, low];
}

const XP_BILLION = 1000000000;

function xpOf(skill: SkillRef<number>): Int {
  if (skill === Skills.SAILING && sailingRestricted()) {
    return 0;
  }
  return CS2.skill_visible_xp(skill);
}

export function totalXpString(high: Int, low: Int): String {
  if (high > 0) {
    return `${groupDigits(high, SEPARATOR)}${SEPARATOR}${padGroup(low / 1000000)}${SEPARATOR}${padGroup((low % 1000000) / 1000)}${SEPARATOR}${padGroup(low % 1000)}`;
  }
  return groupDigits(low, SEPARATOR);
}

const SEPARATOR = ',';

export function percentText(perMille: Int): String {
  if (perMille < 0) {
    return '';
  }
  if (perMille >= 1000) {
    return '- <col=ff0000>COMPLETE!</col>';
  }
  return `${stringOf(perMille / 10)}.${stringOf(perMille % 10)}%`;
}

export function barState(start: Int, current: Int, end: Int, goal: Int, trackW: Int): [Int, Int, Int] {
  let travelled: Int = current - start;
  let total: Int = end - start;

  if (travelled >= total) {
    if (goal === 1) {
      return [trackW, rgbToHex(255, 210, 0), 1000];
    }
    return [trackW, rgbToHex(0, 150, 0), 1000];
  }
  if (travelled <= 0) {
    return [0, rgbToHex(150, 0, 0), 0];
  }
  if (total <= 0) {
    return [trackW, rgbToHex(150, 0, 0), 0];
  }
  if (total < 2) {
    return [0, rgbToHex(150, 0, 0), 0];
  }

  if (total > 1000000000) {
    travelled = travelled / 100000;
    total = total / 100000;
  } else if (total > 100000000) {
    travelled = travelled / 10000;
    total = total / 10000;
  } else if (total > 10000000) {
    travelled = travelled / 1000;
    total = total / 1000;
  } else if (total > 1000000) {
    travelled = travelled / 100;
    total = total / 100;
  } else if (total > 100000) {
    travelled = travelled / 10;
    total = total / 10;
  }
  if (travelled >= total) {
    total = travelled + 1;
  }

  let half: Int = total / 2;
  if (half <= 0) {
    half = 1;
  }
  let red: Int = 0;
  let green: Int = 0;
  if (travelled <= half) {
    red = 150;
    green = CS2.interpolate(0, travelled, 0, half, 150);
  } else {
    red = 150 - CS2.interpolate(0, travelled - half, 0, half, 150);
    green = 150;
  }

  return [
    CS2.interpolate(0, travelled, 0, total, trackW),
    rgbToHex(red, green, 0),
    CS2.interpolate(0, travelled, 0, total, 1000),
  ];
}

export function durationTicks(): Int {
  return XpDropDurationTicks.get(useServerState(XpDropsVars.DURATION)) ?? XpDropTiming.PERMANENT;
}

export function speedTicks(): Int {
  return XpDropSpeedTicks.get(useServerState(XpDropsVars.SPEED)) ?? XpDropTiming.DEFAULT_SPEED;
}

export function xpAtLevel(level: Int): Int {
  return XpForLevel.get(level) ?? 0;
}

export function levelOf(skill: Int): Int {
