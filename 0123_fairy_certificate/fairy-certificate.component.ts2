import {
  CERTIFICATE_COLOR,
  Camera,
  CertificateFonts,
  CertificateModel,
  CertificateSprites,
  CertificateText,
  Layout,
} from './fairy-certificate.constants';

export function FairyCertificate(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={CertificateModel.CERTIFICATE}
        zoom={Camera.ZOOM}
        yaw={Camera.YAW}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CertificateSprites.CLOSE}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={CertificateText.TITLE}
        font={CertificateFonts.HEADING}
        color={CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.ISSUER_X}
        y={Layout.ISSUER_Y}
        w={Layout.ISSUER_W}
        h={Layout.ISSUER_H}
        text={CertificateText.ISSUER}
        font={CertificateFonts.HEADING}
        color={CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.SIGNATURE_X}
        y={Layout.SIGNATURE_Y}
        w={Layout.SIGNATURE_W}
        h={Layout.SIGNATURE_H}
        text={CertificateText.SIGNATURE}
        font={CertificateFonts.SIGNATURE}
        color={CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
        lineHeight={Layout.SIGNATURE_LINE_HEIGHT}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CertificateSprites.CLOSE_OVER}
        />
      </layer>
    </layer>
  );
}
