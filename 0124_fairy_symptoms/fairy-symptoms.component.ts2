import {
  BODY_TEXT,
  FairyColor,
  FairyFonts,
  FairyModel,
  FairySprites,
  Layout,
  ScrollCamera,
  SealCamera,
  TITLE_TEXT,
} from './fairy-symptoms.constants';

export function FairySymptoms(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={Layout.SCROLL_W}
        h={Layout.SCROLL_H}
        model={FairyModel.SCROLL}
        zoom={ScrollCamera.ZOOM}
        pitch={ScrollCamera.PITCH}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={TITLE_TEXT}
        font={FairyFonts.LABEL}
        color={FairyColor.TITLE}
        shadow={true}
        align="center"
        valign="top"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={FairySprites.CLOSE} />

      <text
        x={Layout.BODY_X}
        y={Layout.BODY_Y}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text={BODY_TEXT}
        font={FairyFonts.LABEL}
        color={FairyColor.BODY}
        shadow={true}
        align="left"
        valign="top"
      />

      <model
        x={Layout.SEAL_X}
        y={Layout.SEAL_Y}
        w={Layout.SEAL_W}
        h={Layout.SEAL_H}
        model={FairyModel.SEAL}
        zoom={SealCamera.ZOOM}
        pitch={SealCamera.PITCH}
        yaw={SealCamera.YAW}
      />

      <layer hide x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_W} h={Layout.HOVER_H}>
        <sprite
          x={Layout.HOVER_SPRITE_X}
          y={Layout.HOVER_SPRITE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={FairySprites.CLOSE_HOVER}
        />
      </layer>
    </layer>
  );
}
