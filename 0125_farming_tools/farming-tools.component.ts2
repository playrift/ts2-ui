import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { QuantityButtons } from './quantity-button.component';
import { QUANTITY_CAPTION, QuantityColors, QuantityFonts, QuantitySprites, QuantityStrip } from './storage-main.shared';
import { FARMING_TOOLS } from './farming-tools.data';
import { Panel, ToolSlot } from './farming-tools.constants';
import { FarmingToolMainSlot } from './tool-slot.component';

export function FarmingTools(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Amazing Farming Equipment Store" />

      <layer
        x={Panel.CONTENT_X}
        y={{ bottom: Panel.CONTENT_BOTTOM }}
        w={Panel.CONTENT_W}
        h={{ fill: Panel.CONTENT_INSET }}
      >
        {FARMING_TOOLS.map((tool, index) => (
          <layer
            x={
              index % 4 === 0
                ? Panel.COL_0
                : index % 4 === 1
                  ? Panel.COL_1
                  : index % 4 === 2
                    ? Panel.COL_2
                    : Panel.COL_3
            }
            y={index < 4 ? 0 : index < 8 ? 'center' : 'bottom'}
            w={ToolSlot.WIDTH}
            h={ToolSlot.HEIGHT}
          >
            <FarmingToolMainSlot item={tool.item} label={tool.label} />
          </layer>
        ))}
      </layer>

      <layer x="center" y={{ bottom: QuantityStrip.BOTTOM }} w={{ fill: QuantityStrip.INSET }} h={QuantityStrip.HEIGHT}>
        <QuantityButtons table={QuantityTable.FARMING_TOOLS} />

        <sprite
          x="center"
          y={QuantityStrip.RULE_Y}
          w="fill"
          h={QuantityStrip.RULE_H}
          sprite={QuantitySprites.RULE}
          tiling
        />

        <text
          x="0.12%"
          y={{ center: QuantityStrip.CAPTION_DY }}
          w={QuantityStrip.CAPTION_W}
          h={QuantityStrip.CAPTION_H}
          text={QUANTITY_CAPTION}
          font={QuantityFonts.STRIP}
          color={QuantityColors.CAPTION}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}
