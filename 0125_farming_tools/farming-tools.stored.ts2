import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { FarmingItems, FarmingToolsWateringCans } from './farming-tools.constants';

export function farmingToolsGetStored(item: Item): [Int, Item] {
  let stored: Int = 0;

  switch (item) {
    case FarmingItems.RAKE:
      return [
        CS2.pow(2, 1) * useServerState(Varbits.FARMING_TOOLS_EXTRARAKES) + useServerState(Varbits.FARMING_TOOLS_RAKE),
        FarmingItems.RAKE,
      ];

    case FarmingItems.DIBBER:
      return [
        CS2.pow(2, 1) * useServerState(Varbits.FARMING_TOOLS_EXTRADIBBERS) +
          useServerState(Varbits.FARMING_TOOLS_DIBBER),
        FarmingItems.DIBBER,
      ];

    case FarmingItems.SPADE:
      return [
        CS2.pow(2, 1) * useServerState(Varbits.FARMING_TOOLS_EXTRASPADES) + useServerState(Varbits.FARMING_TOOLS_SPADE),
        FarmingItems.SPADE,
      ];

    case FarmingItems.SECATEURS:
      stored =
        CS2.pow(2, 1) * useServerState(Varbits.FARMING_TOOLS_EXTRASECATEURS) +
        useServerState(Varbits.FARMING_TOOLS_SECATEURS);
      if (useServerState(Varbits.FARMING_TOOLS_FAIRYSECATEURS) === 1) {
        return [stored, FarmingItems.FAIRY_SECATEURS];
      }
      return [stored, FarmingItems.SECATEURS];

    case FarmingItems.WATERING_CAN:
      stored = useServerState(Varbits.FARMING_TOOLS_WATERINGCAN);
      if (stored <= 0) {
        return [0, -1];
      }
      return [1, FarmingToolsWateringCans.get(stored) as Item];

    case FarmingItems.TROWEL:
      return [
        CS2.pow(2, 1) * useServerState(Varbits.FARMING_TOOLS_EXTRATROWELS) +
          useServerState(Varbits.FARMING_TOOLS_TROWEL),
        FarmingItems.TROWEL,
      ];

    case FarmingItems.PLANT_CURE:
      return [useServerState(Varbits.FARMING_TOOLS_PLANTCURE), FarmingItems.PLANT_CURE];

    case FarmingItems.BOTTOMLESS_BUCKET:
      stored = useServerState(Varbits.FARMING_TOOLS_BOTTOMLESS_BUCKET_TYPE);
      if (stored === 1) {
        return [1, FarmingItems.BOTTOMLESS_BUCKET];
      }
      if (stored > 1) {
        return [1, FarmingItems.BOTTOMLESS_BUCKET_FILLED];
      }
      return [0, FarmingItems.BOTTOMLESS_BUCKET];

    case FarmingItems.BUCKET:
      return [
        CS2.pow(2, 8) * useServerState(Varbits.FARMING_TOOLS_EXTRA2BUCKETS) +
          CS2.pow(2, 5) * useServerState(Varbits.FARMING_TOOLS_EXTRABUCKETS) +
          useServerState(Varbits.FARMING_TOOLS_BUCKETS),
        FarmingItems.BUCKET,
      ];

    case FarmingItems.COMPOST:
      return [
        CS2.pow(2, 8) * useServerState(Varbits.FARMING_TOOLS_EXTRACOMPOST) +
          useServerState(Varbits.FARMING_TOOLS_COMPOST),
        FarmingItems.COMPOST,
      ];

    case FarmingItems.SUPERCOMPOST:
      return [
        CS2.pow(2, 8) * useServerState(Varbits.FARMING_TOOLS_EXTRASUPERCOMPOST) +
          useServerState(Varbits.FARMING_TOOLS_SUPERCOMPOST),
        FarmingItems.SUPERCOMPOST,
      ];

    case FarmingItems.ULTRACOMPOST:
      return [useServerState(Varbits.FARMING_TOOLS_ULTRACOMPOST), FarmingItems.ULTRACOMPOST];
  }

  return [0, -1];
}
