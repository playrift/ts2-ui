import { createRef } from 'ts2';
import { FarmingTools } from './farming-tools.component';
import { Panel } from './farming-tools.constants';

const farmingToolsRef = createRef('farming_tools');

export const farmingToolsUi = (): UI => (
  <ui ref={farmingToolsRef} x="center" y="center">
    <layer x="center" y="center" w={Panel.WIDTH} h={{ fill: Panel.HEIGHT_INSET }}>
      <FarmingTools />
    </layer>
  </ui>
);
