import { useState } from 'ts2';

import { ButtonBackground } from '../0370_house-options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { selectedQuantity } from '../0126_farming_tools_side/carried-tools.shared';
import { opsound } from '../lib/lib.helpers';
import { QUANTITY_BUTTONS, QuantityColors, QuantityFonts, QuantityStrip, selectQuantity } from './storage-main.shared';

export function QuantityButton({ table, label, value }: { table: Enum; label: String; value: Int }): Component {
  const [hovered, setHovered] = useState(0);

  const chosen: Int = selectedQuantity(table);

  const menu: String = `Default quantity: <col=ff9040>${label}</col>`;

  if (chosen === value) {
    return (
      <layer w="fill" h="fill" options={[menu]} onOptionSelect={(event) => opsound(event.option, 2)}>
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={QuantityFonts.STRIP}
          color={QuantityColors.REST}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[menu]}
      onMouseRepeat={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={(event) => selectQuantity(table, value, event.option)}
    >
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={QuantityFonts.STRIP}
        color={hovered === 1 ? QuantityColors.HOVER : QuantityColors.REST}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

export function QuantityButtons({ table }: { table: Enum }): Component {
  return (
    <>
      {QUANTITY_BUTTONS.map((button, index) => (
        <layer
          x={index === 0 ? '40%' : index === 1 ? '55%' : index === 2 ? '70%' : '85%'}
          y={{ center: QuantityStrip.BUTTON_DY }}
          w={QuantityStrip.BUTTON}
          h={QuantityStrip.BUTTON}
        >
          <QuantityButton table={table} label={button.label} value={button.value} />
        </layer>
      ))}
    </>
  );
}
