import { CS2, predictServerState } from 'ts2';

import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { Fonts } from '../lib/game/fonts';
import { Sounds } from '../lib/game/sounds';
import { Sprites } from '../lib/game/sprites';
import { Varbits } from '../lib/game/varbits';

export function setSelectedQuantity(table: Enum, value: Int): void {
  if (table === QuantityTable.FARMING_TOOLS || table === QuantityTable.HALLOWED_TOOLS) {
    predictServerState(Varbits.FARMING_TOOLS_SELECTEDQUANTITY, value);
    return;
  }
  if (table === QuantityTable.ELNOCK_STORAGE) {
    predictServerState(Varbits.II_ELNOCK_STORAGE_SELECTEDQUANTITY, value);
    return;
  }
  if (table === QuantityTable.DEPOSIT_BOX) {
    predictServerState(Varbits.DEPOSITBOX_MODE, value);
  }
}

export declare const QuantityFonts: {
  readonly STRIP: typeof Fonts.P12_FULL;
};

export declare const QuantitySprites: {
  readonly RULE: typeof Sprites.STEELBORDER2_0;
};

export enum QuantityColors {
  REST = 0xff981f,
  HOVER = 0xffffff,
  CAPTION = 0xff981f,
}

export enum QuantityStrip {
  HEIGHT = 53,
  INSET = 10,
  BOTTOM = 5,
  RULE_Y = -10,
  RULE_H = 20,
  CAPTION_W = 140,
  CAPTION_H = 36,
  CAPTION_DY = 5,
  BUTTON = 36,
  BUTTON_DY = 5,
}

export const QUANTITY_CAPTION = 'Withdrawal / Storage<br>Quantity';

export const QUANTITY_BUTTONS = [
  { label: '1', value: 0 },
  { label: '5', value: 1 },
  { label: 'X', value: 3 },
  { label: 'All', value: 2 },
];

export function selectQuantity(table: Enum, value: Int, op: Int): void {
  if (op !== 1) {
    return;
  }
  CS2.sound_effect(Sounds.INTERFACE_SELECT1, 1, 0);
  setSelectedQuantity(table, value);
}
