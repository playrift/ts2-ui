import { CS2 } from 'ts2';

import { carriedTotal, MAX_INT } from './carried-tools.shared';
import { FarmingItems, FarmingToolsEnums, FarmingToolsTables } from './farming-tools-side.constants';

export function farmingToolsGetCarried(item: Item): [Int, Item] {
  let total: Int = 0;
  let extra: Int = 0;
  let index: Int = 0;
  let can: Item = -1;
  let first: Item = -1;
  let shown: Item = -1;

  switch (item) {
    case FarmingItems.RAKE:
      return [carriedTotal(FarmingItems.RAKE), FarmingItems.RAKE];
    case FarmingItems.DIBBER:
      return [carriedTotal(FarmingItems.DIBBER), FarmingItems.DIBBER];
    case FarmingItems.SPADE:
      return [carriedTotal(FarmingItems.SPADE), FarmingItems.SPADE];

    case FarmingItems.SECATEURS:
      extra = carriedTotal(FarmingItems.MAGIC_SECATEURS);
      if (extra > 0) {
        total = carriedTotal(FarmingItems.SECATEURS);
        if (MAX_INT - total < extra) {
          return [MAX_INT, FarmingItems.MAGIC_SECATEURS];
        }
        return [extra + total, FarmingItems.MAGIC_SECATEURS];
      }
      return [carriedTotal(FarmingItems.SECATEURS), FarmingItems.SECATEURS];

    case FarmingItems.WATERING_CAN:
      index = CS2.enum_output_count_get(FarmingToolsTables.WATERING_CANS);
      while (index >= 0) {
        can = FarmingToolsEnums.WATERING_CANS.get(index) as Item;
        if (can !== -1) {
          extra = carriedTotal(can);
          if (extra > 0) {
            if (MAX_INT - total < extra) {
              total = MAX_INT;
            } else {
              total = total + extra;
            }
            if (first === -1) {
              first = can;
            }
          }
        }
        index = index - 1;
      }
      return [total, first];

    case FarmingItems.TROWEL:
      return [carriedTotal(FarmingItems.TROWEL), FarmingItems.TROWEL];
    case FarmingItems.PLANT_CURE:
      return [carriedTotal(FarmingItems.PLANT_CURE), FarmingItems.PLANT_CURE];

    case FarmingItems.BOTTOMLESS_BUCKET:
      extra = carriedTotal(FarmingItems.BOTTOMLESS_BUCKET_FILLED);
      if (extra > 0) {
        shown = FarmingItems.BOTTOMLESS_BUCKET_FILLED;
      } else {
        shown = FarmingItems.BOTTOMLESS_BUCKET;
      }
      total = carriedTotal(FarmingItems.BOTTOMLESS_BUCKET);
      if (MAX_INT - total < extra) {
        total = MAX_INT;
      } else {
        total = total + extra;
      }
      return [total, shown];

    case FarmingItems.BUCKET:
      return [carriedTotal(FarmingItems.BUCKET), FarmingItems.BUCKET];
    case FarmingItems.COMPOST:
      return [carriedTotal(FarmingItems.COMPOST), FarmingItems.COMPOST];
    case FarmingItems.SUPERCOMPOST:
      return [carriedTotal(FarmingItems.SUPERCOMPOST), FarmingItems.SUPERCOMPOST];
    case FarmingItems.ULTRACOMPOST:
      return [carriedTotal(FarmingItems.ULTRACOMPOST), FarmingItems.ULTRACOMPOST];
  }

  return [0, -1];
}
