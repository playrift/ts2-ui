import { FARMING_TOOLS } from './farming-tools-side.data';
import { ToolSlot } from './farming-tools-side.constants';
import { FarmingToolSlot } from './tool-slot.component';

export function FarmingToolsSide(): Component {
  return (
    <>
      {FARMING_TOOLS.map((tool, index) => (
        <layer
          x={index % 2 === 0 ? 0 : { right: 0 }}
          y={(index / 2) * ToolSlot.HEIGHT}
          w={ToolSlot.WIDTH}
          h={ToolSlot.HEIGHT}
        >
          <FarmingToolSlot item={tool.item} label={tool.label} />
        </layer>
      ))}
    </>
  );
}
