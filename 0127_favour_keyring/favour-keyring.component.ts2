import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  KeyringArt,
  KeyringColor,
  KeyringFonts,
  KeyringLayout,
  KeyringLinks,
  KeyringModels,
  KeyringWash,
} from './favour-keyring.constants';

export function FavourKeyring(): Component {
  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={KeyringColor.WASH}
        fill
        transparency={KeyringWash.TRANSPARENCY}
      />

      <layer w={KeyringLayout.PIP_W} h={KeyringLayout.PIP_H} />

      <model
        x={KeyringLayout.HEAD_X}
        y={KeyringLayout.HEAD_Y}
        w={KeyringLayout.HEAD_W}
        h={KeyringLayout.HEAD_H}
        model={KeyringModels.HEAD}
        zoom={KeyringLayout.HEAD_ZOOM}
        pitch={KeyringLayout.HEAD_PITCH}
        yaw={KeyringLayout.HEAD_YAW}
      />

      {KeyringLinks.map((link) => (
        <model
          x={link.x}
          y={link.y}
          w={KeyringLayout.LINK_W}
          h={KeyringLayout.LINK_H}
          model={KeyringModels.LINK}
          zoom={link.zoom}
          pitch={KeyringLayout.LINK_PITCH}
          yaw={KeyringLayout.LINK_YAW}
        />
      ))}

      <text
        x="center"
        y={KeyringLayout.HEADING_Y}
        w="fill"
        h={KeyringLayout.HEADING_H}
        font={KeyringFonts.HEADING}
        color={KeyringColor.LABEL}
        align="center"
        shadow
      />

      <text
        x="center"
        y={KeyringLayout.SUB_Y}
        w="fill"
        h={KeyringLayout.SUB_H}
        font={KeyringFonts.BODY}
        color={KeyringColor.LABEL}
        align="center"
        shadow
      />

      <layer x="center" y={KeyringLayout.SLOT_Y} w={KeyringLayout.SLOT_W} h={KeyringLayout.SLOT_H} />

      <text
        y={KeyringLayout.CAPTION_Y}
        w="fill"
        h={KeyringLayout.CAPTION_H}
        font={KeyringFonts.BODY}
        color={KeyringColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x="center"
        y={KeyringLayout.FOOT_Y}
        w="fill"
        h={KeyringLayout.FOOT_H}
        font={KeyringFonts.BODY}
        color={KeyringColor.LABEL}
        align="center"
        shadow
      />

      <model
        x={KeyringLayout.LEFT_X}
        y={KeyringLayout.LEFT_Y}
        w={KeyringLayout.LEFT_W}
        h={KeyringLayout.LEFT_H}
        model={KeyringModels.LEFT_KEY}
        zoom={KeyringLayout.LEFT_ZOOM}
        pitch={KeyringLayout.LEFT_PITCH}
        yaw={KeyringLayout.LEFT_YAW}
      />

      <layer
        x={KeyringLayout.LEFT_ALT_X}
        y={KeyringLayout.LEFT_ALT_Y}
        w={KeyringLayout.LEFT_ALT_W}
        h={KeyringLayout.LEFT_ALT_H}
        hide
      >
        <model
          x={KeyringLayout.LEFT_ALT_INNER_X}
          y={KeyringLayout.LEFT_ALT_INNER_Y}
          w={KeyringLayout.ALT_INNER_W}
          h={KeyringLayout.ALT_INNER_H}
          model={KeyringModels.LEFT_ALT}
          zoom={KeyringLayout.LEFT_ZOOM}
          pitch={KeyringLayout.LEFT_PITCH}
          yaw={KeyringLayout.LEFT_YAW}
        />
      </layer>

      <model
        x={KeyringLayout.RIGHT_X}
        y={KeyringLayout.RIGHT_Y}
        w={KeyringLayout.RIGHT_W}
        h={KeyringLayout.RIGHT_H}
        model={KeyringModels.RIGHT_KEY}
        zoom={KeyringLayout.RIGHT_ZOOM}
        pitch={KeyringLayout.RIGHT_PITCH}
        yaw={KeyringLayout.RIGHT_YAW}
      />

      <layer
        x={KeyringLayout.RIGHT_ALT_X}
        y={KeyringLayout.RIGHT_ALT_Y}
        w={KeyringLayout.RIGHT_ALT_W}
        h={KeyringLayout.RIGHT_ALT_H}
        hide
      >
        <model
          x={KeyringLayout.RIGHT_ALT_INNER_X}
          y={KeyringLayout.RIGHT_ALT_INNER_Y}
          w={KeyringLayout.ALT_INNER_W}
          h={KeyringLayout.ALT_INNER_H}
          model={KeyringModels.RIGHT_ALT}
          zoom={KeyringLayout.RIGHT_ALT_INNER_ZOOM}
          pitch={KeyringLayout.RIGHT_PITCH}
          yaw={KeyringLayout.RIGHT_YAW}
        />
      </layer>

      <sprite
        x={{ right: KeyringLayout.CLOSE_RIGHT }}
        y={KeyringLayout.CLOSE_Y}
        w={KeyringLayout.CLOSE_W}
        h={KeyringLayout.CLOSE_H}
        sprite={KeyringArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, KeyringArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, KeyringArt.CLOSE)}
      />
    </>
  );
}
