import {
  PLATE_HOVER_TRANSPARENCY,
  PLATE_TRANSPARENCY,
  SeedboxLayout,
  SeedboxSprites,
} from './hosidius-seedbox.constants';

export function ButtonPlate({ icon }: { icon: Sprite }): Component {
  return (
    <>
      <sprite
        x="center"
        y="center"
        w={SeedboxLayout.BUTTON}
        h={SeedboxLayout.BUTTON}
        sprite={SeedboxSprites.BUTTON_PLATE}
        transparency={PLATE_TRANSPARENCY}
        hover={{ transparency: PLATE_HOVER_TRANSPARENCY }}
      />
      <sprite x="center" y="center" w={SeedboxLayout.ICON_W} h={SeedboxLayout.ICON_H} sprite={icon} />
    </>
  );
}
