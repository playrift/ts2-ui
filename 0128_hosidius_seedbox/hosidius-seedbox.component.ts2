import { useRef } from 'ts2';

import { closeInterface } from '../lib/lib.helpers';
import { ButtonPlate } from './button-plate.component';
import { SeedboxColors, SeedboxFonts, SeedboxLayout, SeedboxSprites } from './hosidius-seedbox.constants';
import { hideTooltip, showEmptyTooltip, showFillTooltip } from './hosidius-seedbox.state';
import { SeedboxTooltip } from './seedbox-tooltip.component';

export function HosidiusSeedbox(): Component {
  const emptyButton = useRef();
  const fillButton = useRef();
  const tooltipHost = useRef();

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <sprite x="center" y="center" w="fill" h="fill" sprite={SeedboxSprites.BACKING} tiling />

      <sprite
        right={0}
        y={4}
        w={26}
        h={23}
        sprite={SeedboxSprites.CLOSE}
        hover={{ sprite: SeedboxSprites.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
      />

      <text
        x="center"
        y={10}
        w="fill"
        h={15}
        text="Seed Box"
        align="center"
        shadow
        font={SeedboxFonts.TITLE}
        color={SeedboxColors.TITLE}
      />

      <layer x="center" y="center" w={{ fill: 10 }} h={{ fill: 10 }}>
        <layer
          ref={emptyButton}
          right={SeedboxLayout.EMPTY_X}
          bottom={SeedboxLayout.BUTTON_Y}
          w={SeedboxLayout.BUTTON}
          h={SeedboxLayout.BUTTON}
          options={['Empty all to inventory']}
          onMouseRepeat={() => {
            showEmptyTooltip();
          }}
          onMouseLeave={() => {
            hideTooltip();
          }}
        >
          <ButtonPlate icon={SeedboxSprites.EMPTY_ICON} />
        </layer>

        <layer
          ref={fillButton}
          right={SeedboxLayout.FILL_X}
          bottom={SeedboxLayout.BUTTON_Y}
          w={SeedboxLayout.BUTTON}
          h={SeedboxLayout.BUTTON}
          options={['Fill box from inventory']}
          onMouseRepeat={() => {
            showFillTooltip();
          }}
          onMouseLeave={() => {
            hideTooltip();
          }}
        >
          <ButtonPlate icon={SeedboxSprites.FILL_ICON} />
        </layer>

        <layer
          x="center"
          y={SeedboxLayout.SEEDS_Y}
          w={{ fill: SeedboxLayout.SEEDS_INSET_X }}
          h={{ fill: SeedboxLayout.SEEDS_INSET_Y }}
        />
      </layer>

      <layer ref={tooltipHost} x="center" y="center" w="fill" h="fill">
        <SeedboxTooltip host={tooltipHost} empty={emptyButton} fill={fillButton} />
      </layer>
    </layer>
  );
}
