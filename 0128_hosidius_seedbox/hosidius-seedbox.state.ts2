import { useState } from 'ts2';

import { tooltipBuilt, tooltipTime } from '../lib/game/varcs';
import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { Tip, TOOLTIP_DWELL } from './hosidius-seedbox.constants';

function dwellElapsed(): Boolean {
  const [until, setUntil] = useState(tooltipTime);
  if (until < clientClock() + TOOLTIP_DWELL) {
    if (until < clientClock()) {
      setUntil(clientClock() + 2);
    } else {
      setUntil(until + 2);
    }
    return false;
  }
  setUntil(clientClock() + TOOLTIP_DWELL + 10);
  return true;
}

export function showEmptyTooltip(): void {
  const [built, setTip] = useState(tooltipBuilt);
  if (onMobile()) {
    return;
  }
  if (built === Tip.NONE && dwellElapsed()) {
    setTip(Tip.EMPTY);
  }
}

export function showFillTooltip(): void {
  const [built, setTip] = useState(tooltipBuilt);
  if (onMobile()) {
    return;
  }
  if (built === Tip.NONE && dwellElapsed()) {
    setTip(Tip.FILL);
  }
}

export function hideTooltip(): void {
  const [, setTip] = useState(tooltipBuilt);
  setTip(Tip.NONE);
}
