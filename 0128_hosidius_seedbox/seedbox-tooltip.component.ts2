import { useState } from 'ts2';

import { tooltipBuilt } from '../lib/game/varcs';
import { textLineCount, textWidth } from '../lib/lib.engine';
import {
  EMPTY_TOOLTIP,
  FILL_TOOLTIP,
  SeedboxColors,
  SeedboxFonts,
  Tip,
  TOOLTIP_WRAP,
} from './hosidius-seedbox.constants';

export function SeedboxTooltip({ host, empty, fill }: { host: Ref; empty: Ref; fill: Ref }): Component {
  const [tip] = useState(tooltipBuilt);

  const emptyW: Int = 4 + textWidth(EMPTY_TOOLTIP, TOOLTIP_WRAP, 495);
  const emptyH: Int = 4 + 13 * textLineCount(EMPTY_TOOLTIP, TOOLTIP_WRAP, 495);
  const fillW: Int = 4 + textWidth(FILL_TOOLTIP, TOOLTIP_WRAP, 495);
  const fillH: Int = 4 + 13 * textLineCount(FILL_TOOLTIP, TOOLTIP_WRAP, 495);

  const emptyX: Int = Math.min(empty.x + 5, host.width - emptyW);
  const emptyBelow: Int = empty.y + empty.height + 5;
  const fillX: Int = Math.min(fill.x + 5, host.width - fillW);
  const fillBelow: Int = fill.y + fill.height + 5;

  if (tip === Tip.EMPTY) {
    return (
      <layer x={emptyX} y={emptyBelow > host.height - emptyH ? empty.y - emptyH - 5 : emptyBelow} w={emptyW} h={emptyH}>
        <rect x="center" y="center" w="fill" h="fill" color={SeedboxColors.TOOLTIP_FILL} fill />
        <rect x="center" y="center" w="fill" h="fill" color={SeedboxColors.TOOLTIP_INK} />
        <text
          x="center"
          y="center"
          w={{ fill: 4 }}
          h="fill"
          text={EMPTY_TOOLTIP}
          align="left"
          valign="middle"
          font={SeedboxFonts.TOOLTIP}
          color={SeedboxColors.TOOLTIP_INK}
        />
      </layer>
    );
  }

  if (tip === Tip.FILL) {
    return (
      <layer x={fillX} y={fillBelow > host.height - fillH ? fill.y - fillH - 5 : fillBelow} w={fillW} h={fillH}>
        <rect x="center" y="center" w="fill" h="fill" color={SeedboxColors.TOOLTIP_FILL} fill />
        <rect x="center" y="center" w="fill" h="fill" color={SeedboxColors.TOOLTIP_INK} />
        <text
          x="center"
          y="center"
          w={{ fill: 4 }}
          h="fill"
          text={FILL_TOOLTIP}
          align="left"
          valign="middle"
          font={SeedboxFonts.TOOLTIP}
          color={SeedboxColors.TOOLTIP_INK}
        />
      </layer>
    );
  }

  return null;
}
