import { createRef, useInterval } from 'ts2';

import { spinModel } from '../0273_prisonpete/prisonpete.helpers';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { Layout, ListsArt, ListsColor, ListsFonts, ListsModel, OrnamentSpin, Text } from './nzone-lists.constants';

const timerHost = createRef('0129_nzone_lists_timer_host');

export function NzoneLists(): Component {
  useInterval(
    () =>
      spinModel(
        timerHost,
        OrnamentSpin.OFFSET_X,
        OrnamentSpin.OFFSET_Y,
        OrnamentSpin.D_PITCH,
        OrnamentSpin.D_YAW,
        OrnamentSpin.D_ROLL,
      ),
    timerHost,
  );

  return (
    <>
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <SteelBorderEntrypoint title={Text.TITLE} />

        <layer
          x="center"
          y={{ bottom: Layout.BODY_BOTTOM }}
          w={{ fill: Layout.BODY_W_INSET }}
          h={{ fill: Layout.BODY_H_INSET }}
        >
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.PROMPT_H}
            font={ListsFonts.PROMPT}
            color={ListsColor.PROMPT}
            align="center"
            valign="middle"
            shadow
          />

          <model
            x="right"
            y={{ bottom: Layout.ORNAMENT_BOTTOM }}
            w={Layout.ORNAMENT_W}
            h={Layout.ORNAMENT_H}
            model={ListsModel.ORNAMENT}
            zoom={Layout.ORNAMENT_ZOOM}
            pitch={Layout.ORNAMENT_PITCH}
            offsetY={Layout.ORNAMENT_OFFSET_Y}
            ref={timerHost}
          />

          <layer
            x="right"
            y={{ bottom: Layout.BUTTON_YES_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            continueOp
          />
          <layer x="right" y={{ bottom: Layout.BUTTON_NO_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} continueOp />
          <layer
            x="right"
            y={{ bottom: Layout.BUTTON_ALL_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            continueOp
          />
          <layer x="right" y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H} continueOp />

          <layer x={0} y="bottom" w={Layout.LIST_BOX_W} h={{ fill: Layout.LIST_BOX_H_INSET }}>
            <sprite x="center" y="center" w="fill" h="fill" sprite={ListsArt.BACKING} tiling />
            <rect
              x="center"
              y="center"
              w="fill"
              h="fill"
              color={ListsColor.WASH}
              fill
              transparency={Layout.WASH_OPACITY}
            />
            <layer x={Layout.LIST_X} y="center" w={{ fill: Layout.LIST_W_INSET }} h={{ fill: Layout.LIST_H_INSET }} />
            <layer
              x={{ right: Layout.SCROLLBAR_RIGHT }}
              y="center"
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_H_INSET }}
            />
            <ThinStoneBoxEntrypoint />
          </layer>
        </layer>
      </layer>

      <layer x={0} y={0} w={Layout.TOOLTIP_BOX} h={Layout.TOOLTIP_BOX} />
    </>
  );
}
