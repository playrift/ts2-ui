import { createRef, useInterval, useRef, useState } from 'ts2';

import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { clientClock, playSound } from '../lib/lib.engine';
import { REFRESH_COOLDOWN, ViewerColor, ViewerFonts, ViewerSounds } from './deadman-tournament-viewer.constants';

const timerHost = createRef('0130_deadman_tournament_viewer_timer_host');

export function RefreshButton(): Component {
  useInterval(() => {
    if (clientClock() >= pressedUntil) {
      setPressedUntil(0);
    }
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);

  const label = useRef();

  if (pressedUntil !== 0) {
    return (
      <layer w="fill" h="fill" ref={timerHost}>
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="Refresh"
          font={ViewerFonts.BODY}
          color={ViewerColor.PRESSED}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={['Refresh']}
      onMouseEnter={() => {
        label.color = ViewerColor.VALUE;
      }}
      onMouseLeave={() => {
        label.color = ViewerColor.LABEL;
      }}
      onOptionSelect={() => {
        playSound(ViewerSounds.CLICK);
        setPressedUntil(clientClock() + REFRESH_COOLDOWN);
      }}
    >
      <ButtonBackground />
      <text
        ref={label}
        x="center"
        y="center"
        w="fill"
        h="fill"
        text="Refresh"
        font={ViewerFonts.BODY}
        color={ViewerColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
