import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Label, WaitingColor, WaitingFonts, WaitingOverlay } from './castlewars-waitingroom.constants';
import { castlewarsWaitingroomUpdate } from './castlewars-waitingroom.helpers';

const timerHost1 = createRef('0131_castlewars_waitingroom_timer_host1');

const waitingLabel = createRef('castlewars_waitingroom_label');

export function CastlewarsWaitingroom(): Component {
  useInterval(
    () => overlayRelayout(timerHost1, waitingLabel, WaitingOverlay.DODGE, Anchor.CENTRE, Anchor.TOP, 0),
    timerHost1,
  );
  useInterval(() => castlewarsWaitingroomUpdate(waitingLabel), waitingLabel);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <text
          ref={waitingLabel}
          x="center"
          y={0}
          w={Label.W}
          h={Label.H}
          align="center"
          valign="middle"
          font={WaitingFonts.LABEL}
          color={WaitingColor.LABEL}
        />
      </layer>
    </layer>
  );
}
