import { useServerState } from 'ts2';

import { COUNTDOWN_PREFIX, IDLE_TEXT, WaitingVarps } from './castlewars-waitingroom.constants';

export function castlewarsWaitingroomUpdate(label: ComponentId): void {
  const timer: Int = useServerState(WaitingVarps.TIMER);
  if (timer <= 0) {
    label.text = IDLE_TEXT;
  } else {
    label.text = `${COUNTDOWN_PREFIX}${stringOf(timer)}`;
  }
}
