import {
  ArrowStrips,
  Layout,
  ListColors,
  ListFonts,
  ListModel,
  ListRows,
  ListSprites,
  ListText,
} from './garden-list.constants';

export function GardenList(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={ListModel.PAPER}
        zoom={ListModel.ZOOM}
        pitch={ListModel.PITCH}
      />

      {ListRows.map((row) => (
        <text
          x={Layout.ROW_X}
          y={row.y}
          w={Layout.ROW_W}
          h={Layout.ROW_H}
          text={row.label}
          font={ListFonts.BODY}
          color={ListColors.ROW}
          align="center"
        />
      ))}

      {ArrowStrips.map((strip) => (
        <layer x={Layout.STRIP_X} y={strip.y} w={Layout.STRIP_W} h={Layout.STRIP_H}>
          <text
            x={Layout.MARKER_LEFT_X}
            y={Layout.MARKER_Y}
            w={Layout.MARKER_W}
            h={Layout.MARKER_H}
            text={ListText.ARROW_LEFT}
            font={ListFonts.BODY}
            color={ListColors.ARROW}
            align="center"
            shadow
          />
          <text
            x={Layout.MARKER_RIGHT_X}
            y={Layout.MARKER_Y}
            w={Layout.MARKER_W}
            h={Layout.MARKER_H}
            text={ListText.ARROW_RIGHT}
            font={ListFonts.BODY}
            color={ListColors.ARROW}
            align="center"
            shadow
          />
        </layer>
      ))}

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={ListText.TITLE}
        font={ListFonts.BODY}
        color={ListColors.TITLE}
        align="center"
        valign="middle"
        shadow
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={ListSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ListSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
