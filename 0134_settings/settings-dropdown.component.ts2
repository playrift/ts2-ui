import {
  AntiDragKeyIndex,
  GroundItemsModifierKeyCodes,
  GroundItemsModifierKeyIndex,
  MaxForegroundFpsValues,
  MsaaFallbacks,
  MsaaOptions,
  MsaaOptionsUpTo16x,
  NoOptions,
  VsyncIndex,
  VsyncValues,
} from './settings-options.data';
import { CS2, predictServerState, sessionState, useDerived, useServerState, useState } from 'ts2';
import { Sprites } from '../lib/game/sprites';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { settingsDevExampleInt } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';
import { chatMessage, playSound, textLineCount, textWidth } from '../lib/lib.engine';
import { Art, Colour, Row, SettingsFonts, SettingsVarbits, Sounds } from './settings.constants';
import type { SettingsRow } from './settings-rows.data';
import { categoryBase, rowDescription, rowTitle } from './settings-layout';
import { enhancedAny, onEnhancedDesktop, rowLockedMessage, settingEnabled } from './settings.helpers';
import { hideRowTooltip, showRowTooltip } from './settings-tooltip.component';

export declare const DropdownVarbits: {
  readonly MUSIC_PLAYLIST: VarbitRef<19731, 19>;
  readonly MUSIC_TRACK_DISPLAY: VarbitRef<19733, 19>;
  readonly MUSIC_MANUAL_MODE: VarbitRef<19737, 19>;
  readonly LEVELUP_POPUP_OFF: VarbitRef<20157, 3190>;
};

export const Drop = {
  valuePad: 14,
  boxPad: 20,
  measureGap: 25,
  bodyPad: 12,
  controlH: 20,
  controlRight: 10,
  controlHalf: 10,
  innerInset: 2,
  innerH: 18,
  innerRight: 11,
  innerHalf: 9,
  chevron: 16,
  chevronRight: 12,
  chevronHalf: 8,
  valueH: 16,
  valueRight: 28,
  entryH: 20,
  entryHTall: 24,
  panelMax: 120,
  panelPad: 4,
  entryStripeA: 220,
  entryStripeB: 200,
  hover: 240,
  plateRest: 255,
  maxEntries: 13,
} as const;

export const DropColour = {
  OUTLINE: 0x0e0e0c,
  OUTLINE_INNER: 0x474745,
} as const;

export const openDropdownSetting = sessionState(-1);

export const openDropdownRow = sessionState(-1);
export const openDropdownX = sessionState(-1);
export const openDropdownY = sessionState(-1);
export const openDropdownW = sessionState(-1);
export const openDropdownH = sessionState(-1);

export function optionEntry(options: List<String>, index: Int): String {
  return options.at(index) ?? '';
}

function deviceOptionsTable(settingId: Int): List<String> {
  if (settingId !== 318) {
    return NoOptions;
  }
  const [supported, levels] = CS2.device_option_range_get(20);
  if (supported < 0 || levels === 0) {
    return NoOptions;
  }
  return MsaaOptions.get(levels) ?? MsaaOptionsUpTo16x;
}

function deviceOptionsFallback(settingId: Int): String {
  if (settingId !== 318) {
    return '';
  }
  const [supported, levels] = CS2.device_option_range_get(20);
  if (supported < 0 || levels === 0) {
    return '';
  }
  return MsaaFallbacks.get(levels) ?? 'MSAAx16';
}

export function rowOptions(row: SettingsRow, mobile: Boolean): List<String> {
  const device: List<String> = deviceOptionsTable(row.settingId ?? 0);
  if (device.length !== 0) {
    return device;
  }
  const desktop: List<String> = row.options ?? NoOptions;
  const phone: List<String> = row.optionsMobile ?? NoOptions;
  if (mobile && phone.length !== 0) {
    return phone;
  }
  return desktop;
}

export function rowOptionsFallback(row: SettingsRow, mobile: Boolean): String {
  const device: List<String> = deviceOptionsTable(row.settingId ?? 0);
  if (device.length !== 0) {
    return deviceOptionsFallback(row.settingId ?? 0);
  }
  const phone: List<String> = row.optionsMobile ?? NoOptions;
  if (mobile && phone.length !== 0) {
    return row.optionsMobileFallback ?? '';
  }
  return row.optionsFallback ?? '';
}

export function optionCount(options: List<String>): Int {
  return options.length;
}

export function dropdownValue(settingId: Int): Int {
  switch (settingId) {
    case 1:
      return useServerState(Varbits.CHATBOX_SCROLLBARSIDE);
    case 55:
      return useServerState(Varps.OPTION_ATTACKPRIORITY);
    case 56:
      return useServerState(Varps.OPTION_ATTACKPRIORITY_NPC);
    case 86:
      return useServerState(Varbits.SIDE_CONTAINER_STEEL);
    case 12:
      return clientLayoutIndex();
    case 81:
      return useServerState(Varbits.BR_CUSTOM_FOG_COLOUR);
    case 110:
      return useServerState(Varbits.MUSIC_AREA_MODE);
    case 44:
      return loginLogoutSetting();
    case 119:
      return useServerState(Varbits.SETTINGS_CHAT_TIMESTAMPS);
    case 45:
      return framerateCapIndex();
    case 495:
      return framerateIndex(1);
    case 496:
      return framerateIndex(0);
    case 150:
      return useServerState(Varbits.STAT_BOOSTS_HUD_NUM_DISPLAYS);
    case 169:
      return CS2.device_option_get(15);
    case 187:
      return useServerState(Varbits.ORE_RESPAWN_TIMER);
    case 188:
      return useServerState(Varbits.WOODCUTTING_RESPAWN_TIMER);
    case 165:
      return useServerState(Varbits.AGILITY_HELPER_HIGHLIGHT_SHORTCUTS);
    case 207:
      return useServerState(Varbits.RUNINVERT_MODE);
    case 214:
      return useServerState(Varbits.QUESTLIST_SORT_TYPE);
    case 215:
      return useServerState(Varbits.QUESTLIST_HIDE_LACKREQS);
    case 216:
      return useServerState(Varbits.QUESTLIST_HIDE_LACKRECS);
    case 222:
      return useServerState(Varbits.QUESTLIST_LARGER_TEXT);
    case 237:
      return AntiDragKeyIndex.get(useServerState(Varbits.ANTIDRAG_KEY)) ?? 0;
    case 238:
      return AntiDragKeyIndex.get(useServerState(Varbits.ANTIDRAG_DISABLEKEY)) ?? 0;
    case 259:
      return useServerState(Varbits.OPTION_NPC_INDICATORS_TILE);
    case 258:
      return useServerState(Varbits.OPTION_NPC_INDICATORS_NAME);
    case 264:
      return useServerState(Varbits.OPTION_NPC_NAME_ALL);
    case 301:
      return useServerState(Varbits.HPBAR_HUD_BOSS_PERCENTAGE_ENABLED);
    case 318:
      return CS2.device_option_get(20);
    case 334:
      return useServerState(Varbits.GROUND_ITEMS_DESPAWN_TIME_ENABLED_DESKTOP);
    case 336:
      return useServerState(Varbits.GROUND_ITEMS_VISIBILITY_TIME_ENABLED_DESKTOP);
    case 338:
      return useServerState(Varbits.GROUND_ITEMS_EDIT_MODE_ENABLED_DESKTOP);
    case 340:
      return GroundItemsModifierKeyIndex.get(useServerState(Varbits.GROUND_ITEMS_MODIFIER_KEY)) ?? 0;
    case 364:
      return useServerState(Varbits.BUFF_WOODCUTTING_LEPRECHAUN_RAINBOWS_SETTING);
    case 367:
      return useServerState(Varbits.QUEST_START_HIGHLIGHT);
    case 382:
      return useServerState(Varbits.SETTINGS_HIT_SOUNDS);
    case 384:
      return useServerState(Varbits.SETTINGS_HD_BETA_FULL_HD_OR_FAKE_SD);
    case 387:
      return useServerState(Varbits.SETTINGS_TRANSMIT_PRONOUNS);
    case 392:
      return useServerState(Varbits.SETTINGS_MINIMENU_START_INDEX);
    case 411:
      return CS2.device_option_get(18);
    case 438:
      return CS2.device_option_get(23) / 5 - 1;
    case 315:
      return levelUpPopupIndex();
    case 454:
      return useServerState(Varbits.SETTINGS_SAILING_SIDE_PANEL_ONLYONBOAT);
    case 462:
      return useServerState(Varbits.SAILING_START_BOAT_WHEN_SETTING_HEADING);
    case 470:
      return useServerState(Varbits.SETTINGS_CARGO_HOLD_PRIVACY);
    case 477:
      return useServerState(Varps.MUSICPLAY);
    case 478:
      return useServerState(DropdownVarbits.MUSIC_PLAYLIST);
    case 482:
      return useServerState(DropdownVarbits.MUSIC_MANUAL_MODE);
    case 483:
      return useServerState(DropdownVarbits.MUSIC_TRACK_DISPLAY);
    case 497:
      return VsyncIndex.get(CS2.device_option_get(28)) ?? 0;
    case 498:
      return CS2.device_option_get(24);
    case 999:
    case 79:
    case 499:
      return -1;
  }
  return 0;
}

function clientLayoutIndex(): Int {
  if (CS2.window_mode_get() === 1) {
    return 0;
  }
  if (useServerState(Varbits.RESIZABLE_STONE_ARRANGEMENT) === 0) {
    return 1;
  }
  return 2;
}

function loginLogoutSetting(): Int {
  const permanent: Int = useServerState(Varbits.LOGINLOGOUT_PERMANENT);
  if (permanent === 0) {
    return useServerState(Varbits.LOGINLOGOUT_SETTING);
  }
  return permanent;
}

function framerateCapIndex(): Int {
  if (!onMobile() && !onEnhancedDesktop()) {
    return 4;
  }
  const fps: Int = CS2.device_option_get(5);
  if (fps === 0) {
    return 4;
  }
  if (fps <= 15) {
    return 0;
  }
  if (fps <= 20) {
    return 1;
  }
  if (fps <= 30) {
    return 2;
  }
  if (fps <= 60) {
    return 3;
  }
  return 4;
}

function framerateIndex(foreground: Int): Int {
  if (!onEnhancedDesktop()) {
    return 2;
  }
  const stored: Int = foreground === 1 ? CS2.device_option_get(5) : CS2.device_option_get(26);
  const total: Int = 9;
  let index: Int = 0;
  while (index < total) {
    if (stored <= (MaxForegroundFpsValues.at(index) ?? 120)) {
      return index;
    }
    index = index + 1;
  }
  return 2;
}

function levelUpPopupIndex(): Int {
  if (useServerState(DropdownVarbits.LEVELUP_POPUP_OFF) === 1) {
    return 0;
  }
  if (useServerState(Varbits.SKILL_GUIDE_SKILL) === 1) {
    return 2;
  }
  return 1;
}

function typedValue(settingId: Int): Int {
  if (settingId === 999) {
    const [dev] = useState(settingsDevExampleInt);
    return dev;
  }
  if (settingId === 79) {
    return CS2.device_option_get(27);
  }
  if (settingId === 499) {
    return CS2.device_option_get(29);
  }
  return -1;
}

export function optionLabel(settingId: Int, options: List<String>, fallback: String, value: Int): String {
  if (settingId === 999) {
    if (value === -1) {
      return cropText(
        `${stringOf(typedValue(999))}% custom text to be cropped`,
        valueWidth(fallback),
        SettingsFonts.BODY,
      );
    }
    return devExampleColour(optionEntry(options, value), value);
  }
  if (settingId === 79 && value === -1) {
    return `${stringOf(typedValue(79))}%`;
  }
  if (settingId === 499) {
    if (value === -1) {
      return `${stringOf(typedValue(499))}%`;
    }
    if (value === 0) {
      return replaceAll(optionEntry(options, 0), 'XXX', stringOf(100));
    }
  }
  return optionEntry(options, value);
}

export function optionDisabled(settingId: Int, value: Int): Boolean {
  if (settingId === 999 && value !== -1 && value % 2 === 1) {
    return true;
  }
  return false;
}

function devExampleColour(text: String, value: Int): String {
  if (text.length <= 0) {
    return text;
  }
  const head: String = text.substring(0, 1);
  const tail: String = text.substring(1, text.length);
  const rest: Int = value % 3;
  if (rest === 0) {
    return `<col=ff0000>${head}</col>${tail}`;
  }
  if (rest === 1) {
    return `<col=00ff00>${head}</col>${tail}`;
  }
  return `<col=0000ff>${head}</col>${tail}`;
}

function cropText(text: String, maxWidth: Int, font: Font): String {
  let length: Int = text.length;
  if (length <= 0 || textWidth(text, 765, font) <= maxWidth) {
    return text;
  }
  let candidate: String = '';
  while (length > 1) {
    length = length - 1;
    candidate = `${text.substring(0, length)}...`;
    if (textWidth(candidate, 765, font) <= maxWidth) {
      return candidate;
    }
  }
  return `${text.substring(0, 1)}...`;
}

function replaceAll(subject: String, search: String, replacement: String): String {
  let out: String = '';
  let from: Int = 0;
  let at: Int = subject.indexOf(search, 0);
  while (at !== -1) {
    out = `${out}${subject.substring(from, at)}${replacement}`;
    from = at + search.length;
    at = subject.indexOf(search, from);
  }
  return `${out}${subject.substring(from, subject.length)}`;
}

export function valueWidth(fallback: String): Int {
  return textWidth(fallback, 1000, SettingsFonts.BODY) + Drop.valuePad;
}

export function controlWidth(fallback: String): Int {
  return valueWidth(fallback) + Drop.boxPad;
}

function titleBox(row: SettingsRow, mobile: Boolean, width: Int, control: Int): Int {
  let height: Int =
    textLineCount(rowTitle(row, mobile), width - (control + Drop.measureGap), SettingsFonts.TITLE) * Row.lineHeight;
  if (mobile && height < Row.minTitleHeightMobile) {
    height = Row.minTitleHeightMobile;
  }
  return height;
}

function descriptionBox(row: SettingsRow, mobile: Boolean, compact: Boolean, width: Int, control: Int): Int {
  if ((row.hideDescription ?? false) || compact) {
    return 0;
  }
  const text: String = rowDescription(row, mobile);
  if (text.length <= 0) {
    return 0;
  }
  return textLineCount(text, width - (control + Drop.measureGap), SettingsFonts.BODY) * Row.lineHeight;
}

export function dropdownHeight(row: SettingsRow, mobile: Boolean, compact: Boolean, width: Int): Int {
  const options: List<String> = rowOptions(row, mobile);
  if (options.length === 0) {
    return 0;
  }
  const control: Int = controlWidth(rowOptionsFallback(row, mobile));
  return titleBox(row, mobile, width, control) + Drop.bodyPad + descriptionBox(row, mobile, compact, width, control);
}

function antiDragKeyCode(choice: Int): Int {
  if (choice === 1) {
    return 81;
  }
  if (choice === 2) {
    return 82;
  }
  return 0;
}

export function settingsSetDropdown(row: SettingsRow, mobile: Boolean, value: Int): void {
  const settingId: Int = row.settingId ?? 0;
  predictServerState(SettingsVarbits.SELECTED_SETTING, settingId);

  switch (settingId) {
    case 1:
      predictServerState(Varbits.CHATBOX_SCROLLBARSIDE, value);
      break;
    case 12:
      if (value === 0) {
        CS2.window_mode_set(1);
      } else {
        CS2.window_mode_set(2);
        predictServerState(Varbits.RESIZABLE_STONE_ARRANGEMENT, value - 1);
      }
      break;
    case 44:
      predictServerState(Varbits.LOGINLOGOUT_SETTING, value);
      break;
    case 45:
      setFramerateBucket(value);
      break;
    case 110:
      predictServerState(Varbits.MUSIC_AREA_MODE, value);
      break;
    case 86:
      predictServerState(Varbits.SIDE_CONTAINER_STEEL, value);
      break;
    case 165:
      predictServerState(Varbits.AGILITY_HELPER_HIGHLIGHT_SHORTCUTS, value);
      break;
    case 81:
      predictServerState(Varbits.BR_CUSTOM_FOG_COLOUR, value);
      break;
    case 238:
      predictServerState(Varbits.ANTIDRAG_DISABLEKEY, antiDragKeyCode(value));
      break;
    case 237:
      predictServerState(Varbits.ANTIDRAG_KEY, antiDragKeyCode(value));
      break;
    case 301:
      predictServerState(Varbits.HPBAR_HUD_BOSS_PERCENTAGE_ENABLED, value);
      break;
    case 55:
      predictServerState(Varps.OPTION_ATTACKPRIORITY, value);
      break;
    case 56:
      predictServerState(Varps.OPTION_ATTACKPRIORITY_NPC, value);
      break;
    case 207:
      predictServerState(Varbits.RUNINVERT_MODE, value);
      break;
    case 119:
      predictServerState(Varbits.SETTINGS_CHAT_TIMESTAMPS, value);
      break;
    case 150:
      predictServerState(Varbits.STAT_BOOSTS_HUD_NUM_DISPLAYS, value);
      break;
    case 315:
      if (value === 0) {
        predictServerState(DropdownVarbits.LEVELUP_POPUP_OFF, 1);
      } else {
        predictServerState(DropdownVarbits.LEVELUP_POPUP_OFF, 0);
        predictServerState(Varbits.SKILL_GUIDE_SKILL, value - 1);
      }
      break;
    case 495:
      setFramerate(value, 1);
      break;
    case 496:
      setFramerate(value, 0);
      break;
    case 169:
      CS2.device_option_set(15, value);
      break;
    case 187:
      if (enhancedAny()) {
        predictServerState(Varbits.ORE_RESPAWN_TIMER, value);
      }
      break;
    case 188:
      if (enhancedAny()) {
        predictServerState(Varbits.WOODCUTTING_RESPAWN_TIMER, value);
      }
      break;
    case 214:
      predictServerState(Varbits.QUESTLIST_SORT_TYPE, Math.min(11, value));
      break;
    case 215:
      predictServerState(Varbits.QUESTLIST_HIDE_LACKREQS, Math.min(2, value));
      break;
    case 216:
      predictServerState(Varbits.QUESTLIST_HIDE_LACKRECS, Math.min(2, value));
      break;
    case 222:
      predictServerState(Varbits.QUESTLIST_LARGER_TEXT, Math.min(1, value));
      break;
    case 259:
      setNpcIndicatorTile(value);
      break;
    case 258:
      setNpcIndicatorName(value);
      break;
    case 264:
      if (onEnhancedDesktop()) {
        predictServerState(Varbits.OPTION_NPC_NAME_ALL, Math.min(2, value));
      }
      break;
    case 318:
      if (enhancedAny()) {
        CS2.device_option_set(20, Math.clamp(0, 4, value));
      }
      break;
    case 334:
      setGroundItemsDespawn(mobile, value);
      break;
    case 336:
      setGroundItemsDespawn(mobile, value);
      break;
    case 338:
      setGroundItemsEditMode(mobile, value);
      break;
    case 340:
      if (onEnhancedDesktop()) {
        predictServerState(Varbits.GROUND_ITEMS_MODIFIER_KEY, GroundItemsModifierKeyCodes.at(value) ?? 0);
      }
      break;
    case 364:
      if (enhancedAny()) {
        predictServerState(Varbits.BUFF_WOODCUTTING_LEPRECHAUN_RAINBOWS_SETTING, value);
      }
      break;
    case 367:
      if (enhancedAny()) {
        predictServerState(Varbits.QUEST_START_HIGHLIGHT, value);
      }
      break;
    case 382:
      predictServerState(Varbits.SETTINGS_HIT_SOUNDS, value);
      break;
    case 384:
      if (enhancedAny()) {
        predictServerState(Varbits.SETTINGS_HD_BETA_FULL_HD_OR_FAKE_SD, value);
      }
      break;
    case 387:
      predictServerState(Varbits.SETTINGS_TRANSMIT_PRONOUNS, value);
      break;
    case 392:
      setMinimenuStart(value);
      break;
    case 411:
      CS2.device_option_set(18, Math.clamp(0, 2, value));
      break;
    case 438:
      setAfkTimer(value);
      break;
    case 454:
      predictServerState(Varbits.SETTINGS_SAILING_SIDE_PANEL_ONLYONBOAT, value);
      break;
    case 462:
      predictServerState(Varbits.SAILING_START_BOAT_WHEN_SETTING_HEADING, value);
      break;
    case 470:
      predictServerState(Varbits.SETTINGS_CARGO_HOLD_PRIVACY, value);
      break;
    case 999:
      setDevExample(value);
      break;
    case 477:
      predictServerState(Varps.MUSICPLAY, value);
      break;
    case 478:
      predictServerState(DropdownVarbits.MUSIC_PLAYLIST, value);
      break;
    case 482:
      predictServerState(DropdownVarbits.MUSIC_MANUAL_MODE, value);
      break;
    case 483:
      predictServerState(DropdownVarbits.MUSIC_TRACK_DISPLAY, value);
      break;
    case 79:
      setInterfaceScale(value);
      break;
    case 497:
      CS2.device_option_set(28, VsyncValues.at(value) ?? 0);
      break;
    case 498:
      CS2.device_option_set(24, value);
      break;
    case 499:
      setRenderScale(row, mobile, value);
      break;
  }
}

function setFramerateBucket(value: Int): void {
  if (!onMobile() && !onEnhancedDesktop()) {
    return;
  }
  let fps: Int = 0;
  if (value === 0) {
    fps = 15;
  } else if (value === 1) {
    fps = 20;
  } else if (value === 2) {
    fps = 30;
  } else if (value === 3) {
    fps = 60;
  } else if (value === 4) {
    fps = 999;
  } else {
    return;
  }
  CS2.device_option_set(5, fps);
  CS2.device_option_set(26, fps);
}

function setFramerate(value: Int, foreground: Int): void {
  if (!onEnhancedDesktop()) {
    return;
  }
  const fps: Int = MaxForegroundFpsValues.at(value) ?? 120;
  if (foreground === 1) {
    CS2.device_option_set(5, fps);
  } else {
    CS2.device_option_set(26, fps);
  }
}

function setNpcIndicatorTile(value: Int): void {
  if (!onEnhancedDesktop() || useServerState(Varbits.OPTION_NPC_INDICATORS_ENABLED) === 0) {
    return;
  }
  predictServerState(Varbits.OPTION_NPC_INDICATORS_TILE, Math.min(2, value));
  npcIndicatorTidy();
}

function setNpcIndicatorName(value: Int): void {
  if (!onEnhancedDesktop() || useServerState(Varbits.OPTION_NPC_INDICATORS_ENABLED) === 0) {
    return;
  }
  predictServerState(Varbits.OPTION_NPC_INDICATORS_NAME, Math.min(2, value));
  npcIndicatorTidy();
}

function npcIndicatorTidy(): void {
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_OUTLINE_ENABLED) !== 0) {
    return;
  }
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_TILE) !== 0) {
    return;
  }
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_NAME) !== 0) {
    return;
  }
  predictServerState(Varbits.OPTION_NPC_INDICATORS_ENABLED, 0);
}

function setGroundItemsDespawn(mobile: Boolean, value: Int): void {
  if (!enhancedAny()) {
    return;
  }
  if (mobile) {
    predictServerState(Varbits.GROUND_ITEMS_DESPAWN_TIME_ENABLED_MOBILE, Math.clamp(0, 1, value));
  } else {
    predictServerState(Varbits.GROUND_ITEMS_DESPAWN_TIME_ENABLED_DESKTOP, Math.clamp(0, 2, value));
  }
}

function setGroundItemsEditMode(mobile: Boolean, value: Int): void {
  if (!enhancedAny()) {
    return;
  }
  if (mobile) {
    predictServerState(Varbits.GROUND_ITEMS_EDIT_MODE_ENABLED_MOBILE, Math.clamp(0, 1, value));
  } else {
    predictServerState(Varbits.GROUND_ITEMS_EDIT_MODE_ENABLED_DESKTOP, Math.clamp(0, 2, value));
  }
}

function setMinimenuStart(value: Int): void {
  const capped: Int = Math.min(7, value);
  predictServerState(Varbits.SETTINGS_MINIMENU_START_INDEX, capped);
  CS2.game_option_set(13, capped + 1);
}

function setAfkTimer(value: Int): void {
  const minutes: Int = (value + 1) * 5;
  chatMessage(`AFK timer set to ${stringOf(minutes)} minutes.`);
  CS2.device_option_set(23, minutes);
}

function setDevExample(value: Int): void {
  const [, setValue] = useState(settingsDevExampleInt);
  let scale: Int = -1;
  if (value > -1) {
    scale = (value + 1) * 100;
  }
  setValue(Math.clamp(100, 400, scale));
}

function setInterfaceScale(value: Int): void {
  if (!enhancedAny()) {
    return;
  }
  const floor: Int = onMobile() ? 175 : 100;
  let scale: Int = -1;
  if (value > -1) {
    scale = floor + value * 25;
  }
  CS2.device_option_set(27, Math.max(floor, Math.min(400, scale)));
}

function setRenderScale(row: SettingsRow, mobile: Boolean, value: Int): void {
  if (!hdBetaEnabled()) {
    return;
  }
  const options: List<String> = rowOptions(row, mobile);
  if (options.length === 0) {
    return;
  }
  let scale: Int = 100;
  if (value === 0) {
    scale = 100;
  } else if (value < optionCount(options)) {
    scale = 25 * value;
  } else {
    return;
  }
  CS2.device_option_set(29, scale);
}

function hdBetaEnabled(): Boolean {
  if (!enhancedAny()) {
    return false;
  }
  if (useServerState(SettingsVarbits.SD_BETA) === 0) {
    return false;
  }
  if (useServerState(SettingsVarbits.HD_NEW_RENDERER) === 0) {
    return false;
  }
  if (CS2.device_option_get(25) === 1) {
    return false;
  }
  return true;
}

export function SettingsDropdown({
  row,
  top,
  stripe,
  mobile,
  compact,
  width,
  enabled,
  pane,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  mobile: Boolean;
  compact: Boolean;
  width: Int;
  enabled: Boolean;
  pane: Ref;
}): Component {
  const settingId: Int = row.settingId ?? 0;
  const options: List<String> = rowOptions(row, mobile);
  const [open, setOpen] = useState(openDropdownSetting);
  const [, setOpenRow] = useState(openDropdownRow);
  const [, setOpenX] = useState(openDropdownX);
  const [, setOpenY] = useState(openDropdownY);
  const [, setOpenW] = useState(openDropdownW);
  const [, setOpenH] = useState(openDropdownH);
  const enabledFlag: Int = useDerived(() => settingEnabled(row));
  const value: Int = useDerived(() => dropdownValue(settingId));

  if (options.length === 0) {
    return <rect hide />;
  }

  const fallback: String = rowOptionsFallback(row, mobile);
  const valueBox: Int = valueWidth(fallback);
  const control: Int = controlWidth(fallback);
  const title: Int = titleBox(row, mobile, width, control);
  const description: Int = descriptionBox(row, mobile, compact, width, control);
  const box: Int = title + Drop.bodyPad + description;
  const centre: Int = top + (box / 2 - Drop.controlHalf);
  const lit: Boolean = rowLit(enabled, enabledFlag);
  const label: String = optionLabel(settingId, options, fallback, value);
  const expanded: Boolean = isOpen(open, settingId);

  return (
    <>
      <rect x="center" y={top} w={{ fill: Row.blockInsetW }} h={box} fill color={Colour.BLACK} transparency={stripe} />

      {!mobile && compact && rowDescription(row, mobile).length > 0 ? (
        <text
          x={Row.titleX}
          y={top + Row.titleDy}
          w={{ fill: control + Drop.measureGap }}
          h={title}
          text={rowTitle(row, mobile)}
          font={SettingsFonts.TITLE}
          shadow
          color={lit ? Colour.AMBER : Colour.GREY}
          align="left"
          valign="middle"
          lineHeight={Row.lineHeight}
          onMouseRepeat={() => showRowTooltip(row, Row.titleX, top + Row.titleDy, title, pane)}
          onMouseLeave={() => hideRowTooltip()}
        />
      ) : (
        <text
          x={Row.titleX}
          y={top + Row.titleDy}
          w={{ fill: control + Drop.measureGap }}
          h={title}
          text={rowTitle(row, mobile)}
          font={SettingsFonts.TITLE}
          shadow
          color={lit ? Colour.AMBER : Colour.GREY}
          align="left"
          valign="middle"
          lineHeight={Row.lineHeight}
        />
      )}

      <sprite
        x={{ right: Drop.controlRight }}
        y={centre}
        w={control}
        h={Drop.controlH}
        sprite={Sprites.TRADEBACKING}
        tiling
      />
      <rect x={{ right: Drop.controlRight }} y={centre} w={control} h={Drop.controlH} color={DropColour.OUTLINE} />
      <rect
        x={{ right: Drop.innerRight }}
        y={top + (box / 2 - Drop.innerHalf)}
        w={control - Drop.innerInset}
        h={Drop.innerH}
        color={DropColour.OUTLINE_INNER}
      />
      <sprite
        x={{ right: Drop.chevronRight }}
        y={top + (box / 2 - Drop.chevronHalf)}
        w={Drop.chevron}
        h={Drop.chevron}
        sprite={expanded ? Art.BAR_ARROW_UP : Art.BAR_ARROW_DOWN}
      />
      <text
        x={{ right: Drop.valueRight }}
        y={top + (box / 2 - Drop.chevronHalf)}
        w={valueBox}
        h={Drop.valueH}
        text={label}
        font={SettingsFonts.BODY}
        shadow
        color={lit ? Colour.AMBER : Colour.GREY}
        align="center"
        valign="middle"
      />

      {(row.dropdownInput ?? 0) === 1 ? (
        <rect
          x={{ right: Drop.controlRight }}
          y={centre}
          w={control}
          h={Drop.controlH}
          fill
          color={Colour.BLACK}
          transparency={Drop.plateRest}
          noClickThrough
          options={['Select', 'Input']}
          onOptionSelect={() => {
            if (enabled && enabledFlag === 1) {
              playSound(Sounds.TAB_SELECT);
              setOpenRow(categoryBase(row.category) + row.ordinal);
              setOpenX(width - Drop.controlRight - control);
              setOpenY(centre);
              setOpenW(control);
              setOpenH(Drop.controlH);
              setOpen(settingId);
            } else {
              playSound(Sounds.DISMISS);
              chatMessage(rowLockedMessage(row));
            }
          }}
        />
      ) : (
        <rect
          x={{ right: Drop.controlRight }}
          y={centre}
          w={control}
          h={Drop.controlH}
          fill
          color={Colour.BLACK}
          transparency={Drop.plateRest}
          options={['Select']}
          onOptionSelect={() => {
            if (enabled && enabledFlag === 1) {
              playSound(Sounds.TAB_SELECT);
              setOpenRow(categoryBase(row.category) + row.ordinal);
              setOpenX(width - Drop.controlRight - control);
              setOpenY(centre);
              setOpenW(control);
              setOpenH(Drop.controlH);
              setOpen(settingId);
            } else {
              playSound(Sounds.DISMISS);
              chatMessage(rowLockedMessage(row));
            }
          }}
        />
      )}

      {!mobile && lit ? (
        <rect
          x={{ right: Drop.controlRight }}
          y={centre}
          w={control}
          h={Drop.controlH}
          fill
          color={Colour.BLACK}
          transparency={Drop.plateRest}
          hover={{ transparency: Drop.entryStripeA }}
        />
      ) : (
        <rect
          x={{ right: Drop.controlRight }}
          y={centre}
          w={control}
          h={Drop.controlH}
          fill
          color={Colour.BLACK}
          transparency={Drop.plateRest}
        />
      )}

      {(row.dropdownInput ?? 0) === 1 && (
        <input
          x={{ right: Drop.valueRight }}
          y={top + (box / 2 - Drop.chevronHalf)}
          w={valueBox}
          h={Drop.valueH}
          text=""
          font={SettingsFonts.BODY}
          shadow
          color={Colour.WHITE}
          align="left"
          valign="top"
          lineWrapWidth={valueBox}
          lineCountLimit={1}
          lineWidthLimit={settingId === 999 || settingId === 79 ? 4 : -1}
          selectColor={Colour.BLACK}
          selectBgColor={Colour.WHITE}
        />
      )}

      {description > 0 && (
        <text
          x={Row.titleX}
          y={top + Row.titleDy + title}
          w={{ fill: control + Drop.measureGap }}
          h={description}
          text={rowDescription(row, mobile)}
          font={SettingsFonts.BODY}
          shadow
          color={Colour.GREY}
          align="left"
          valign="middle"
          lineHeight={Row.lineHeight}
        />
      )}
    </>
  );
}

export function DropdownEntry({
  row,
  optionsId,
  index,
  count,
  entryH,
  mobile,
}: {
  row: SettingsRow;
  optionsId: List<String>;
  index: Int;
  count: Int;
  entryH: Int;
  mobile: Boolean;
}): Component {
  const [, setOpen] = useState(openDropdownSetting);
  const settingId: Int = row.settingId ?? 0;
  const disabled: Boolean = optionDisabled(settingId, index);
  const y: Int = index * entryH;
  const optionsFallback: String = rowOptionsFallback(row, mobile);

  return (
    <>
      {index < count && (
        <>
          {mobile ? (
            <rect
              y={y}
              w="fill"
              h={entryH}
              fill
              color={Colour.BLACK}
              transparency={index % 2 === 0 ? Drop.entryStripeA : Drop.entryStripeB}
            />
          ) : (
            <rect
              y={y}
              w="fill"
              h={entryH}
              fill
              color={Colour.BLACK}
              transparency={index % 2 === 0 ? Drop.entryStripeA : Drop.entryStripeB}
              hover={{ transparency: Drop.hover }}
            />
          )}

          <text
            y={y}
            w="fill"
            h={entryH}
            text={optionLabel(settingId, optionsId, optionsFallback, index)}
            font={SettingsFonts.BODY}
            shadow
            color={disabled ? Colour.GREY : Colour.AMBER}
            align="center"
            valign="middle"
            lineHeight={Row.lineHeight}
          />

          <rect
            y={y}
            w="fill"
            h={entryH}
            fill
            color={Colour.BLACK}
            transparency={Drop.plateRest}
            hide={disabled}
            options={['Select']}
            onOptionSelect={() => {
              playSound(Sounds.TAB_SELECT);
              if (!(row.live ?? false)) {
                settingsSetDropdown(row, mobile, index);
              }
              setOpen(-1);
            }}
          />
        </>
      )}
    </>
  );
}

function rowLit(enabled: Boolean, flag: Int): Boolean {
  if (enabled && flag === 1) {
    return true;
  }
  return false;
}

function isOpen(open: Int, settingId: Int): Boolean {
  if (open === settingId) {
    return true;
  }
  return false;
}
