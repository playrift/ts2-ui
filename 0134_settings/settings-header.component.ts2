import { textLineCount } from '../lib/lib.engine';
import { Colour, Row, SettingsFonts } from './settings.constants';
import type { SettingsRow } from './settings-rows.data';
import { rowTitle } from './settings-layout';

export function SettingsHeader({
  row,
  top,
  stripe,
  mobile,
  width,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  mobile: Boolean;
  width: Int;
}): Component {
  const title: String = rowTitle(row, mobile);
  if (title.length <= 0) {
    return null;
  }
  const text: Int = textLineCount(title, width - Row.blockMeasureInset, SettingsFonts.TITLE) * Row.lineHeight;

  return (
    <>
      <rect
        x={Row.blockX}
        y={top}
        w={{ fill: Row.blockInsetW }}
        h={text + Row.blockPad}
        fill
        color={Colour.BLACK}
        transparency={stripe}
      />
      <text
        x={Row.blockTextX}
        y={top + Row.blockTextDy}
        w={{ fill: Row.blockTextInsetW }}
        h={text}
        text={title}
        font={SettingsFonts.TITLE}
        shadow
        color={Colour.WHITE}
        align="center"
        valign="middle"
        lineHeight={Row.lineHeight}
      />
    </>
  );
}
