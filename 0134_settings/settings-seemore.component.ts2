import { CS2, useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { showMoreGroups } from './settings.state';
import { Colour, Row, SettingsFonts, Sounds } from './settings.constants';
import type { SettingsRow } from './settings-rows.data';
import { showMoreOpen } from './settings.helpers';

export function SettingsSeeMore({
  row,
  top,
  stripe,
  mobile,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  mobile: Boolean;
}): Component {
  const group: Int = row.showMoreOwns ?? 0;
  const height: Int = mobile ? Row.seeMoreHeightMobile : Row.seeMoreHeight;
  const label: String = showMoreOpen(group) ? 'Show less' : 'Show more';

  return (
    <>
      {mobile ? (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={height}
          fill
          color={Colour.BLACK}
          transparency={stripe}
        />
      ) : (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={height}
          fill
          color={Colour.BLACK}
          transparency={stripe}
          hover={{ transparency: Row.hoverTransparency }}
        />
      )}
      <rect
        x="center"
        y={top}
        w={{ fill: Row.blockInsetW }}
        h={height}
        fill
        color={Colour.WHITE}
        transparency={255}
        options={[label]}
        onOptionSelect={() => toggleShowMore(group)}
      />
      <text
        x="center"
        y={top}
        w={{ fill: Row.blockTextInsetW }}
        h={height}
        text={'<u=f4f4f4>'.concat(label)}
        font={SettingsFonts.BODY}
        shadow
        color={Colour.LINK}
        align="left"
        valign="middle"
        lineHeight={Row.lineHeight}
      />
    </>
  );
}

function toggleShowMore(group: Int): void {
  playSound(Sounds.TAB_SELECT);
  const [open, setOpen] = useState(showMoreGroups);
  if (CS2.testbit(open, group)) {
    setOpen(CS2.bit_clear(open, group));
    return;
  }
  setOpen(CS2.bit_set(open, group));
}
