import type { SettingsRow } from './settings-rows.data';
import { WidgetKind } from './settings-layout';
import { SettingsHeader } from './settings-header.component';
import { SettingsSeeMore } from './settings-seemore.component';
import { SettingsTextBlock } from './settings-text.component';
import { SettingsToggle } from './settings-toggle.component';
import { SettingsActionButton } from './settings-actionbutton.component';
import { SettingsColour } from './settings-colour.component';
import { SettingsDropdown } from './settings-dropdown.component';
import { SettingsKeybind } from './settings-keybind.component';
import { SettingsSelectAmount } from './settings-selectamount.component';
import { SettingsSelectText } from './settings-selecttext.component';
import { SettingsSlider } from './settings-slider.component';
import { SettingsWidgetStub } from './settings-widget-stub.component';

export function SettingsSetting({
  row,
  top,
  stripe,
  column,
  mobile,
  compact,
  width,
  pane,
  lead,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  column: Int;
  mobile: Boolean;
  compact: Boolean;
  width: Int;
  pane: Ref;
  lead: Int;
}): Component {
  const kind: Int = row.kind ?? 0;

  if (kind === WidgetKind.HEADER) {
    return <SettingsHeader row={row} top={top + lead} stripe={stripe} mobile={mobile} width={width} />;
  }
  if (kind === WidgetKind.TOGGLE) {
    return (
      <SettingsToggle
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.SLIDER) {
    return (
      <SettingsSlider
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.DROPDOWN) {
    return (
      <SettingsDropdown
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.KEYBIND) {
    return (
      <SettingsKeybind
        row={row}
        top={top}
        stripe={stripe}
        column={column}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
      />
    );
  }
  if (kind === WidgetKind.COLOUR_SWATCH) {
    return (
      <SettingsColour
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.SELECT_THIN) {
    return (
      <SettingsSelectText
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.SELECT_PLATE) {
    return (
      <SettingsSelectAmount
        row={row}
        top={top}
        stripe={stripe}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
        pane={pane}
      />
    );
  }
  if (kind === WidgetKind.ACTION_BUTTON) {
    return (
      <SettingsActionButton
        row={row}
        top={top}
        stripe={stripe}
        column={column}
        mobile={mobile}
        compact={compact}
        width={width}
        enabled
      />
    );
  }
  if (kind === WidgetKind.SHOW_MORE) {
    return <SettingsSeeMore row={row} top={top} stripe={stripe} mobile={mobile} />;
  }
  if (kind === WidgetKind.TEXT_BLOCK) {
    return <SettingsTextBlock row={row} top={top} stripe={stripe} mobile={mobile} compact={compact} width={width} />;
  }
  return <SettingsWidgetStub row={row} top={top} stripe={stripe} mobile={mobile} width={width} />;
}
