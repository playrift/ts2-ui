import { CS2, predictServerState, useDerived, useServerState } from 'ts2';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { onMobile } from '../lib/lib.helpers';
import { chatMessage, playSound } from '../lib/lib.engine';
import { Art, Colour, Row, SettingsFonts, SettingsVarbits, Sounds } from './settings.constants';
import type { SettingsRow } from './settings-rows.data';
import { descriptionHeight, rowDescription, rowTitle, titleHeight } from './settings-layout';
import {
  enhancedAny,
  groupIronman,
  leaguesWorld,
  onEnhancedDesktop,
  onEnhancedMobile,
  onMac,
  rowLockedMessage,
  settingEnabled,
  settingValue,
} from './settings.helpers';
import { hideRowTooltip, showRowTooltip } from './settings-tooltip.component';

export function SettingsToggle({
  row,
  top,
  stripe,
  mobile,
  compact,
  width,
  enabled,
  pane,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  mobile: Boolean;
  compact: Boolean;
  width: Int;
  enabled: Boolean;
  pane: Ref;
}): Component {
  const title: Int = titleHeight(row, mobile, width);
  const description: Int = descriptionHeight(row, mobile, compact, width);
  const box: Int = title + Row.togglePad + description;
  const settingId: Int = row.settingId ?? 0;
  const raw: Int = useDerived(() => settingValue(settingId));
  const checked: Int = (row.inverted ?? false) ? 1 - raw : raw;
  const enabledFlag: Int = useDerived(() => settingEnabled(row));

  return (
    <>
      {!mobile && enabled && enabledFlag === 1 ? (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={box}
          fill
          color={Colour.BLACK}
          transparency={stripe}
          hover={{ transparency: Row.hoverTransparency }}
        />
      ) : (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={box}
          fill
          color={Colour.BLACK}
          transparency={stripe}
        />
      )}

      <text
        x={Row.titleX}
        y={top + Row.titleDy}
        w={{ fill: Row.titleInsetW }}
        h={title}
        text={rowTitle(row, mobile)}
        font={SettingsFonts.TITLE}
        shadow
        color={enabled && enabledFlag === 1 ? Colour.AMBER : Colour.GREY}
        align="left"
        valign="middle"
        lineHeight={Row.lineHeight}
      />

      <sprite
        x={{ right: Row.checkbox.right }}
        y={top + (box / 2 - Row.checkboxHalf)}
        w={Row.checkbox.w}
        h={Row.checkbox.h}
        sprite={
          checked === 1
            ? enabled && enabledFlag === 1
              ? Art.CHECK_ON
              : Art.CHECK_ON_GREY
            : enabled && enabledFlag === 1
              ? Art.CHECK_OFF
              : Art.CHECK_OFF_GREY
        }
      />

      {description > 0 && (
        <text
          x={Row.titleX}
          y={title + top + Row.titleDy}
          w={{ fill: Row.titleInsetW }}
          h={description}
          text={rowDescription(row, mobile)}
          font={SettingsFonts.BODY}
          shadow
          color={Colour.GREY}
          align="left"
          valign="middle"
          lineHeight={Row.lineHeight}
        />
      )}

      {!mobile && compact && rowDescription(row, mobile).length > 0 ? (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={box}
          fill
          color={Colour.WHITE}
          transparency={255}
          options={['Toggle']}
          onOptionSelect={() => toggleOp(row, enabled, enabledFlag)}
          onMouseRepeat={() => showRowTooltip(row, Row.blockInsetW / 2, top, box, pane)}
          onMouseLeave={() => hideRowTooltip()}
        />
      ) : (
        <rect
          x="center"
          y={top}
          w={{ fill: Row.blockInsetW }}
          h={box}
          fill
          color={Colour.WHITE}
          transparency={255}
          options={['Toggle']}
          onOptionSelect={() => toggleOp(row, enabled, enabledFlag)}
        />
      )}
    </>
  );
}

function toggleOp(row: SettingsRow, enabled: Boolean, enabledFlag: Int): void {
  if (!enabled || enabledFlag !== 1) {
    playSound(Sounds.DISMISS);
    chatMessage(rowLockedMessage(row));
    return;
  }
  playSound(Sounds.TAB_SELECT);
  settingsSetToggle(row);
}

function settingsSetToggle(row: SettingsRow): void {
  const settingId: Int = row.settingId ?? 0;
  predictServerState(SettingsVarbits.SELECTED_SETTING, settingId);

  switch (settingId) {
    case 2:
      if (onMobile()) {
        return;
      }
      if (CS2.window_mode_get() === 1) {
        return;
      }
      predictServerState(Varbits.SIDE_TRANSPARENCY, 1 - useServerState(Varbits.SIDE_TRANSPARENCY));
      break;
    case 3:
      predictServerState(Varbits.OPTION_HIDEXPTOLEVEL, 1 - useServerState(Varbits.OPTION_HIDEXPTOLEVEL));
      break;
    case 4:
      predictServerState(Varbits.OPTION_PRAYERTOOLTIPS, 1 - useServerState(Varbits.OPTION_PRAYERTOOLTIPS));
      break;
    case 5:
      predictServerState(Varbits.HITSPLAT_TINT_DISABLED, 1 - useServerState(Varbits.HITSPLAT_TINT_DISABLED));
      break;
    case 6:
      predictServerState(Varbits.OPTION_SATOOLTIPS, 1 - useServerState(Varbits.OPTION_SATOOLTIPS));
      break;
    case 7:
      predictServerState(Varbits.OPTION_HIDE_ROOFTOPS, 1 - useServerState(Varbits.OPTION_HIDE_ROOFTOPS));
      applyRooftopGameOption();
      break;
    case 8:
      if (onMobile()) {
        return;
      }
      predictServerState(Varbits.ORBS_DISABLED, 1 - useServerState(Varbits.ORBS_DISABLED));
      break;
    case 9:
      if (!onMobile() && useServerState(Varbits.ORBS_DISABLED) === 1) {
        return;
      }
      predictServerState(Varbits.WIKI_ICON_DISABLED, 1 - useServerState(Varbits.WIKI_ICON_DISABLED));
      break;
    case 10:
      predictServerState(Varbits.HPBAR_HUD_BOSS_DISABLED, 1 - useServerState(Varbits.HPBAR_HUD_BOSS_DISABLED));
      break;
    case 11:
      if (onMobile()) {
        return;
      }
      if (CS2.window_mode_get() === 1) {
        return;
      }
      predictServerState(Varbits.CHATBOX_TRANSPARENCY, 1 - useServerState(Varbits.CHATBOX_TRANSPARENCY));
      break;
    case 13:
      predictServerState(Varbits.CAMERA_ZOOM_MOUSE_DISABLED, 1 - useServerState(Varbits.CAMERA_ZOOM_MOUSE_DISABLED));
      break;
    case 33:
      predictServerState(Varbits.MUSIC_UNLOCK_TEXT_TOGGLE, 1 - useServerState(Varbits.MUSIC_UNLOCK_TEXT_TOGGLE));
      break;
    case 34:
      predictServerState(Varps.OPTION_CHAT, 1 - useServerState(Varps.OPTION_CHAT));
      break;
    case 35:
      predictServerState(Varps.OPTION_PM, 1 - useServerState(Varps.OPTION_PM));
      break;
    case 36:
      if (useServerState(Varps.OPTION_PM) === 0 || CS2.window_mode_get() === 1) {
        predictServerState(Varbits.HIDE_PM_ALONGSIDE_CHATBOX, useServerState(Varbits.HIDE_PM_ALONGSIDE_CHATBOX));
        chatMessage("That option is applicable only in resizable mode with 'Split Private Chat' enabled.");
        return;
      }
      predictServerState(Varbits.HIDE_PM_ALONGSIDE_CHATBOX, 1 - useServerState(Varbits.HIDE_PM_ALONGSIDE_CHATBOX));
      break;
    case 37:
      predictServerState(Varps.OPTION_CHATFILTER_DISABLED, 1 - useServerState(Varps.OPTION_CHATFILTER_DISABLED));
      break;
    case 38:
      if (
        useServerState(Varbits.OPTION_LOOTNOTIFICATION_ON) === 0 &&
        useServerState(Varbits.OPTION_LOOTNOTIFICATION_VALUE) <= 0
      ) {
        return;
      }
      predictServerState(Varbits.OPTION_LOOTNOTIFICATION_ON, 1 - useServerState(Varbits.OPTION_LOOTNOTIFICATION_ON));
      break;
    case 40:
      if (useServerState(Varbits.OPTION_LOOTNOTIFICATION_ON) === 1) {
        predictServerState(
          Varbits.OPTION_LOOTNOTIFICATION_UNTRADEABLES,
          1 - useServerState(Varbits.OPTION_LOOTNOTIFICATION_UNTRADEABLES),
        );
      }
      break;
    case 41:
      predictServerState(Varbits.BOSS_KILLCOUNT_FILTERED, 1 - useServerState(Varbits.BOSS_KILLCOUNT_FILTERED));
      break;
    case 42:
      if (
        useServerState(Varbits.OPTION_DROPWARNING_ON) === 0 &&
        useServerState(Varbits.OPTION_DROPWARNING_VALUE) <= 0
      ) {
        return;
      }
      predictServerState(Varbits.OPTION_DROPWARNING_ON, 1 - useServerState(Varbits.OPTION_DROPWARNING_ON));
      break;
    case 46:
      if (useServerState(Varbits.CHATBOX_TRANSPARENCY) === 0) {
        return;
      }
      if (CS2.window_mode_get() === 1) {
        return;
      }
      predictServerState(
        Varbits.TRANSPARENT_CHATBOX_BLOCKCLICK,
        1 - useServerState(Varbits.TRANSPARENT_CHATBOX_BLOCKCLICK),
      );
      break;
    case 47:
      if (useServerState(Varbits.ORBS_DISABLED) === 1) {
        return;
      }
      predictServerState(
        Varbits.TLI_STOREBUTTON_TOGGLE_MOBILE,
        1 - useServerState(Varbits.TLI_STOREBUTTON_TOGGLE_MOBILE),
      );
      break;
    case 48:
      predictServerState(Varps.OPTION_MOUSE, 1 - useServerState(Varps.OPTION_MOUSE));
      break;
    case 49:
      if (onMobile()) {
        return;
      }
      predictServerState(Varbits.MOUSECAM_DISABLED, 1 - useServerState(Varbits.MOUSECAM_DISABLED));
      break;
    case 50:
      predictServerState(Varbits.FOLLOWEROPS_DEPRIORITISED, 1 - useServerState(Varbits.FOLLOWEROPS_DEPRIORITISED));
      break;
    case 51:
      predictServerState(
        Varbits.DESKTOP_SHIFTCLICKDROP_ENABLED,
        1 - useServerState(Varbits.DESKTOP_SHIFTCLICKDROP_ENABLED),
      );
      break;
    case 54:
      if (onMobile()) {
        return;
      }
      if (useServerState(Varbits.RESIZABLE_STONE_ARRANGEMENT) === 1) {
        predictServerState(
          Varbits.HOTKEY_CANNOT_CLOSE_SIDEPANEL,
          1 - useServerState(Varbits.HOTKEY_CANNOT_CLOSE_SIDEPANEL),
        );
      }
      break;
    case 57:
      predictServerState(Varbits.KEYBINDING_ESC_TO_CLOSE, 1 - useServerState(Varbits.KEYBINDING_ESC_TO_CLOSE));
      break;
    case 59:
      if (useServerState(Varbits.OPTION_ACCEPTAID) === 0) {
        if (useServerState(Varbits.IRONMAN) !== 0) {
          chatMessage('Ironmen do not accept aid.');
        } else {
          predictServerState(Varbits.OPTION_ACCEPTAID, 1);
        }
      } else {
        predictServerState(Varbits.OPTION_ACCEPTAID, 0);
      }
      break;
    case 60:
      predictServerState(Varbits.BOUNTY_TELEPORT_WARNING, 1 - useServerState(Varbits.BOUNTY_TELEPORT_WARNING));
      break;
    case 61:
      predictServerState(Varbits.DAREEYAK_TELEPORT_WARNING, 1 - useServerState(Varbits.DAREEYAK_TELEPORT_WARNING));
      break;
    case 62:
      predictServerState(
        Varbits.CARRALLAGAR_TELEPORT_WARNING,
        1 - useServerState(Varbits.CARRALLAGAR_TELEPORT_WARNING),
      );
      break;
    case 63:
      predictServerState(Varbits.ANNAKARL_TELEPORT_WARNING, 1 - useServerState(Varbits.ANNAKARL_TELEPORT_WARNING));
      break;
    case 64:
      predictServerState(Varbits.GHORROCK_TELEPORT_WARNING, 1 - useServerState(Varbits.GHORROCK_TELEPORT_WARNING));
      break;
    case 65:
      predictServerState(
        Varbits.ALCHEMY_WARNING_UNTRADEABLES,
        1 - useServerState(Varbits.ALCHEMY_WARNING_UNTRADEABLES),
      );
      break;
    case 67:
      predictServerState(Varbits.TELETAB_ICE_PLATEAU_WARNING, 1 - useServerState(Varbits.TELETAB_ICE_PLATEAU_WARNING));
      break;
    case 68:
      predictServerState(Varbits.TELETAB_CEMETERY_WARNING, 1 - useServerState(Varbits.TELETAB_CEMETERY_WARNING));
      break;
    case 69:
      predictServerState(Varbits.TELETAB_WILDYCRABS_WARNING, 1 - useServerState(Varbits.TELETAB_WILDYCRABS_WARNING));
      break;
    case 70:
      predictServerState(Varbits.TELETAB_DAREEYAK_WARNING, 1 - useServerState(Varbits.TELETAB_DAREEYAK_WARNING));
      break;
    case 71:
      predictServerState(
        Varbits.TELETAB_CARRALLANGAR_WARNING,
        1 - useServerState(Varbits.TELETAB_CARRALLANGAR_WARNING),
      );
      break;
    case 72:
      predictServerState(Varbits.TELETAB_ANNAKARL_WARNING, 1 - useServerState(Varbits.TELETAB_ANNAKARL_WARNING));
      break;
    case 73:
      predictServerState(Varbits.TELETAB_GHORROCK_WARNING, 1 - useServerState(Varbits.TELETAB_GHORROCK_WARNING));
      break;
    case 82:
      predictServerState(Varbits.OPTION_PRECISE_TIMING, 1 - useServerState(Varbits.OPTION_PRECISE_TIMING));
      break;
    case 83:
      predictServerState(Varbits.OPTION_SEPARATE_HOURS, 1 - useServerState(Varbits.OPTION_SEPARATE_HOURS));
      break;
    case 84:
      predictServerState(
        Varbits.GRAVESTONE_SUPPLYPILES_DISABLED,
        1 - useServerState(Varbits.GRAVESTONE_SUPPLYPILES_DISABLED),
      );
      break;
    case 85:
      if (!CS2.testbit(useServerState(Varbits.OPTION_COLLECTION_NEW_ITEM), 0)) {
        predictServerState(
          Varbits.OPTION_COLLECTION_NEW_ITEM,
          CS2.bit_set(useServerState(Varbits.OPTION_COLLECTION_NEW_ITEM), 0),
        );
      } else {
        predictServerState(
          Varbits.OPTION_COLLECTION_NEW_ITEM,
          CS2.bit_clear(useServerState(Varbits.OPTION_COLLECTION_NEW_ITEM), 0),
        );
      }
      break;
    case 111:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.HPBAR_HUD_STANDARD_DISABLED, 1 - useServerState(Varbits.HPBAR_HUD_STANDARD_DISABLED));
      break;
    case 112:
      if (!onEnhancedDesktop()) {
        return;
      }
      predictServerState(Varbits.TILE_HIGHLIGHTING_DISABLED, 1 - useServerState(Varbits.TILE_HIGHLIGHTING_DISABLED));
      break;
    case 114:
      if (!onEnhancedDesktop()) {
        return;
      }
      predictServerState(Varbits.MOUSEOVER_TOOLTIPS_DISABLED, 1 - useServerState(Varbits.MOUSEOVER_TOOLTIPS_DISABLED));
      break;
    case 115:
      if (!onEnhancedDesktop()) {
        return;
      }
      predictServerState(Varbits.ANTIDRAG_ENABLED, 1 - useServerState(Varbits.ANTIDRAG_ENABLED));
      break;
    case 116:
      if (!enhancedAny()) {
        return;
      }
      if (useServerState(Varbits.ORBS_DISABLED) === 1) {
        return;
      }
      predictServerState(Varbits.REGEN_INDICATOR_DISABLED, 1 - useServerState(Varbits.REGEN_INDICATOR_DISABLED));
      break;
    case 118:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.COX_HELPER_DISABLED, 1 - useServerState(Varbits.COX_HELPER_DISABLED));
      break;
    case 120:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.FISHING_SPOT_INDICATOR_DISABLED,
        1 - useServerState(Varbits.FISHING_SPOT_INDICATOR_DISABLED),
      );
      break;
    case 121:
      if (!enhancedAny()) {
        return;
      }
      if (useServerState(Varbits.FISHING_SPOT_INDICATOR_DISABLED) === 1) {
        return;
      }
      predictServerState(
        Varbits.FISHING_SPOT_INDICATOR_ALL_FISH_DISABLED,
        1 - useServerState(Varbits.FISHING_SPOT_INDICATOR_ALL_FISH_DISABLED),
      );
      break;
    case 122:
      if (!onEnhancedDesktop()) {
        return;
      }
      if (useServerState(Varbits.FISHING_SPOT_INDICATOR_DISABLED) === 1) {
        return;
      }
      predictServerState(
        Varbits.FISHING_SPOT_INDICATOR_MORE_INFO_DISABLED,
        1 - useServerState(Varbits.FISHING_SPOT_INDICATOR_MORE_INFO_DISABLED),
      );
      break;
    case 123:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.ATTACK_STYLE_ENABLED, 1 - useServerState(Varbits.ATTACK_STYLE_ENABLED));
      break;
    case 124:
      if (!enhancedAny() && !leaguesWorld()) {
        return;
      }
      predictServerState(Varbits.BUFF_BAR_HIDDEN, 1 - useServerState(Varbits.BUFF_BAR_HIDDEN));
      break;
    case 125:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_HOME_TELEPORT_DISABLED, 1 - useServerState(Varbits.BUFF_HOME_TELEPORT_DISABLED));
      break;
    case 126:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_MINIGAME_TELEPORT_DISABLED,
        1 - useServerState(Varbits.BUFF_MINIGAME_TELEPORT_DISABLED),
      );
      break;
    case 127:
      if (!leaguesWorld()) {
        return;
      }
      predictServerState(Varbits.BUFF_LEAGUE_RELICS_HIDDEN, 1 - useServerState(Varbits.BUFF_LEAGUE_RELICS_HIDDEN));
      break;
    case 128:
      if (!enhancedAny() && !leaguesWorld()) {
        return;
      }
      predictServerState(Varbits.BUFF_BAR_TOOLTIPS_HIDDEN, 1 - useServerState(Varbits.BUFF_BAR_TOOLTIPS_HIDDEN));
      break;
    case 129:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_TELEBLOCK_DISABLED, 1 - useServerState(Varbits.BUFF_TELEBLOCK_DISABLED));
      break;
    case 130:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_CHARGE_SPELL_DISABLED, 1 - useServerState(Varbits.BUFF_CHARGE_SPELL_DISABLED));
      break;
    case 131:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_GODWARS_ALTAR_DISABLED, 1 - useServerState(Varbits.BUFF_GODWARS_ALTAR_DISABLED));
      break;
    case 132:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_DRAGONFIRE_SHIELD_COOLDOWN_DISABLED,
        1 - useServerState(Varbits.BUFF_DRAGONFIRE_SHIELD_COOLDOWN_DISABLED),
      );
      break;
    case 133:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_IMBUED_HEART_COOLDOWN_DISABLED,
        1 - useServerState(Varbits.BUFF_IMBUED_HEART_COOLDOWN_DISABLED),
      );
      break;
    case 134:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_VENGEANCE_COOLDOWN_DISABLED,
        1 - useServerState(Varbits.BUFF_VENGEANCE_COOLDOWN_DISABLED),
      );
      break;
    case 135:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_VENGEANCE_ACTIVE_DISABLED,
        1 - useServerState(Varbits.BUFF_VENGEANCE_ACTIVE_DISABLED),
      );
      break;
    case 136:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_STAMINA_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_STAMINA_DURATION_DISABLED),
      );
      break;
    case 137:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_PRAYER_ENHANCE_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_PRAYER_ENHANCE_DURATION_DISABLED),
      );
      break;
    case 138:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_OVERLOAD_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_OVERLOAD_DURATION_DISABLED),
      );
      break;
    case 139:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_MAGIC_IMBUE_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_MAGIC_IMBUE_DURATION_DISABLED),
      );
      break;
    case 140:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_SIRE_STUN_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_SIRE_STUN_DURATION_DISABLED),
      );
      break;
    case 141:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_FREEZE_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_FREEZE_DURATION_DISABLED),
      );
      break;
    case 142:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_SOTD_DURATION_DISABLED, 1 - useServerState(Varbits.BUFF_SOTD_DURATION_DISABLED));
      break;
    case 143:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_DIVINE_POTION_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_DIVINE_POTION_DURATION_DISABLED),
      );
      break;
    case 144:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_ANTIFIRE_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_ANTIFIRE_DURATION_DISABLED),
      );
      break;
    case 145:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_ANTIPOISON_DURATION_DISABLED,
        1 - useServerState(Varbits.BUFF_ANTIPOISON_DURATION_DISABLED),
      );
      break;
    case 146:
      if (!onEnhancedDesktop()) {
        return;
      }
      predictServerState(Varbits.ALWAYS_ON_TOP, 1 - useServerState(Varbits.ALWAYS_ON_TOP));
      if (onEnhancedDesktop()) {
        CS2.device_option_set(12, useServerState(Varbits.ALWAYS_ON_TOP));
      }
      break;
    case 147:
      if (!onEnhancedDesktop()) {
        return;
      }
      predictServerState(Varbits.MOUSEOVER_TEXT_ENABLED, 1 - useServerState(Varbits.MOUSEOVER_TEXT_ENABLED));
      break;
    case 148:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.STAT_BOOSTS_HUD_HIDDEN, 1 - useServerState(Varbits.STAT_BOOSTS_HUD_HIDDEN));
      break;
    case 149:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.STAT_BOOSTS_HUD_TOOLTIPS_HIDDEN,
        1 - useServerState(Varbits.STAT_BOOSTS_HUD_TOOLTIPS_HIDDEN),
      );
      break;
    case 151:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.STAT_BOOSTS_HUD_DISPLAY_RELATIVE,
        1 - useServerState(Varbits.STAT_BOOSTS_HUD_DISPLAY_RELATIVE),
      );
      break;
    case 152:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(Varbits.BUFF_CORRUPTION_DISABLED, 1 - useServerState(Varbits.BUFF_CORRUPTION_DISABLED));
      break;
    case 153:
      if (!enhancedAny()) {
        return;
      }
      predictServerState(
        Varbits.BUFF_MARK_OF_DARKNESS_DISABLED,
        1 - useServerState(Varbits.BUFF_MARK_OF_DARKNESS_DISABLED),
