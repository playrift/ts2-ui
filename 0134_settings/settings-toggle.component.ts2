function applyRooftopGameOption(): void {
  if (useServerState(Varbits.OPTION_HIDE_ROOFTOPS_OVERRIDE) > 0) {
    CS2.game_option_set(1, useServerState(Varbits.OPTION_HIDE_ROOFTOPS_OVERRIDE) - 1);
    return;
  }
  CS2.game_option_set(1, useServerState(Varbits.OPTION_HIDE_ROOFTOPS));
}

function clearNpcIndicatorsWhenEmpty(): void {
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_OUTLINE_ENABLED) !== 0) {
    return;
  }
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_TILE) !== 0) {
    return;
  }
  if (useServerState(Varbits.OPTION_NPC_INDICATORS_NAME) !== 0) {
    return;
  }
  predictServerState(Varbits.OPTION_NPC_INDICATORS_ENABLED, 0);
}

function setMinimenuFilter(channel: Int): void {
  let value: Int = 0;
  switch (channel) {
    case 0:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_VISUAL_FEEDBACK,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_VISUAL_FEEDBACK),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_VISUAL_FEEDBACK);
      break;
    case 1:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_TARGET,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_TARGET),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_TARGET);
      break;
    case 2:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_ENTITY,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_ENTITY),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_ENTITY);
      break;
    case 3:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_INTERFACE,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_INTERFACE),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_INTERFACE);
      break;
    case 4:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_WALK,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_WALK),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_WALK);
      break;
    case 5:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_GLOBAL_CLICK,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_GLOBAL_CLICK),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_GLOBAL_CLICK);
      break;
    case 6:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_PLAYER,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_PLAYER),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_PLAYER);
      break;
    case 7:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_USE,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_USE),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_USE);
      break;
    case 8:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_CANCEL,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_CANCEL),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_CANCEL);
      break;
    case 9:
      predictServerState(
        Varbits.SETTINGS_MINIMENU_FILTER_EXAMINE,
        1 - useServerState(Varbits.SETTINGS_MINIMENU_FILTER_EXAMINE),
      );
      value = useServerState(Varbits.SETTINGS_MINIMENU_FILTER_EXAMINE);
      break;
  }
  CS2.native_minimenu_block_mode_set(channel, 1 - value);
}
