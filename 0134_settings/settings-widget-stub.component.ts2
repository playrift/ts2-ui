import { Colour, Row, SettingsFonts } from './settings.constants';
import type { SettingsRow } from './settings-rows.data';
import { rowTitle } from './settings-layout';

export function SettingsWidgetStub({
  row,
  top,
  stripe,
  mobile,
  width,
}: {
  row: SettingsRow;
  top: Int;
  stripe: Int;
  mobile: Boolean;
  width: Int;
}): Component {
  return (
    <>
      <rect
        x="center"
        y={top}
        w={{ fill: Row.blockInsetW }}
        h={Row.stubHeight}
        fill
        color={Colour.BLACK}
        transparency={stripe}
      />
      <text
        x={Row.titleX}
        y={top}
        w={{ fill: Row.titleInsetW }}
        h={Row.stubHeight}
        text={rowTitle(row, mobile)}
        font={SettingsFonts.TITLE}
        shadow
        color={Colour.GREY}
        align="left"
        valign="middle"
        lineHeight={Row.lineHeight}
      />
      <rect
        x={{ right: Row.stubMarker.right }}
        y={top + Row.stubMarker.dy}
        w={Row.stubMarker.w}
        h={Row.stubMarker.h}
        color={Colour.STUB}
        lineWidth={1}
      />
      <text
        x={{ right: Row.stubMarker.right }}
        y={top + Row.stubMarker.dy}
        w={Row.stubMarker.w}
        h={Row.stubMarker.h}
        text={'kind '.concat(stringOf(row.kind ?? 0))}
        font={SettingsFonts.BODY}
        color={Colour.STUB}
        align="center"
        valign="middle"
      />
    </>
  );
}
