import { CS2, useServerState, useState } from 'ts2';
import { hasBit } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { playermember } from '../lib/game/varcs';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { showMoreGroups } from './settings.state';
import { SettingsVarbits, SettingsVarps } from './settings.constants';
import type { SettingsCategory } from './settings-categories.data';
import type { SettingsRow } from './settings-rows.data';
import { SettingsDeps, SettingsDepValues } from './settings-deps.data';
import type { SettingsDep, SettingsDepValue } from './settings-deps.data';
import { dropdownValue } from './settings-dropdown.component';

export function onEnhancedDesktop(): Boolean {
  if (useServerState(SettingsVarbits.MOBILE_SIMULATED) === 1) {
    return false;
  }
  const type: Int = CS2.clienttype();
  if (type === 4 || type === 5 || type === 10) {
    return true;
  }
  return false;
}

export function onEnhancedMobile(): Boolean {
  const type: Int = CS2.clienttype();
  if (useServerState(SettingsVarbits.MOBILE_SIMULATED) === 1) {
    if (type === 4 || type === 5 || type === 10) {
      return true;
    }
  }
  if (type === 7 || type === 8) {
    return true;
  }
  return false;
}

export function enhancedAny(): Boolean {
  if (onEnhancedDesktop()) {
    return true;
  }
  if (onEnhancedMobile()) {
    return true;
  }
  return false;
}

export function onMac(): Boolean {
  if (useServerState(SettingsVarbits.MOBILE_SIMULATED) === 1) {
    return false;
  }
  if (useServerState(SettingsVarbits.HD) === 1) {
    return true;
  }
  if (CS2.clienttype() === 5) {
    return true;
  }
  return false;
}

export function leaguesWorld(): Boolean {
  const flags: Int = useServerState(SettingsVarps.WORLD_FLAGS);
  if (!hasBit(flags, 29) && hasBit(flags, 30)) {
    return true;
  }
  return false;
}

export function specialWorld(): Boolean {
  const flags: Int = useServerState(SettingsVarps.WORLD_FLAGS);
  if (hasBit(flags, 25) && hasBit(flags, 23) && !hasBit(flags, 4)) {
    return true;
  }
  return false;
}

export function speedrunningWorld(): Boolean {
  return hasBit(useServerState(SettingsVarps.WORLD_FLAGS), 8);
}

export function pvpArenaWorld(): Boolean {
  return hasBit(useServerState(SettingsVarps.WORLD_FLAGS), 6);
}

export function rentalWorld(): Boolean {
  return hasBit(useServerState(SettingsVarps.WORLD_FLAGS), 13);
}

export function worldTypeCode(): Int {
  const flags: Int = useServerState(SettingsVarps.WORLD_FLAGS);
  if (hasBit(flags, 25)) {
    return -1;
  }
  if (hasBit(flags, 26)) {
    return 2;
  }
  if (hasBit(flags, 30)) {
    return 3;
  }
  if (hasBit(flags, 29)) {
    return 1;
  }
  if (hasBit(flags, 27)) {
    return 6;
  }
  if (hasBit(flags, 8)) {
    return 5;
  }
  if (hasBit(flags, 6)) {
    return 4;
  }
  return 0;
}

export function groupIronman(): Boolean {
  const mode: Int = useServerState(SettingsVarbits.IRONMAN);
  if (mode === 4 || mode === 5 || mode === 6) {
    return true;
  }
  return false;
}

export function featureFlag(bit: Int): Boolean {
  return hasBit(useServerState(SettingsVarps.FEATURE_FLAGS), bit);
}

export function showMoreOpen(group: Int): Boolean {
  const [expanded] = useState(showMoreGroups);
  return hasBit(expanded, group);
}

export function categoryHidden(category: SettingsCategory): Boolean {
  if ((category.enhancedOnly ?? false) && !enhancedAny()) {
    return true;
  }
  if ((category.leaguesOnly ?? false) && !leaguesWorld()) {
    return true;
  }
  return false;
}

export function rowHidden(row: SettingsRow): Boolean {
  const mobile: Boolean = onMobile();
  const enhanced: Boolean = enhancedAny();
  const leagues: Boolean = leaguesWorld();
  const [member] = useState(playermember);
  const ironmanMode: Int = useServerState(SettingsVarbits.IRONMAN);

  if ((row.membersOnly ?? false) && member === 0) {
    return true;
  }
  if ((row.notOnMobile ?? false) && mobile) {
    return true;
  }
  if ((row.enhancedOrMobileOnly ?? false) && !mobile && !enhanced) {
    return true;
  }
  if ((row.mobileOnly ?? false) && !mobile) {
    return true;
  }
  if ((row.notMac ?? false) && onMac()) {
    return true;
  }
  if ((row.enhancedOnly ?? false) && !enhanced) {
    return true;
  }

  if ((row.needsDependency ?? false) && settingEnabledGates(row) === 0) {
    return true;
  }

  if ((row.notIronman ?? false) && ironmanMode !== 0) {
    return true;
  }
  if ((row.ironmanOnly ?? false) && ironmanMode === 0) {
    return true;
  }
  if ((row.leaguesOnly ?? false) && !leagues) {
    return true;
  }

  if ((row.notSpeedrunning ?? false) && speedrunningWorld()) {
    return true;
  }
  if ((row.speedrunningOnly ?? false) && !speedrunningWorld()) {
    return true;
  }
  if ((row.param1273 ?? false) && !enhanced && !leagues && !featureFlag(3)) {
    return true;
  }
  if ((row.groupIronmanOnly ?? false) && !groupIronman()) {
    return true;
  }
  if (ironmanMode !== 2 && (row.ultimateIronmanOnly ?? false)) {
    return true;
  }
  if ((row.notLeagues ?? false) && leagues) {
    return true;
  }
  if ((row.notDeadman ?? false) && deadmanWorld() !== 0) {
    return true;
  }
  if ((row.notSpecialWorld ?? false) && specialWorld()) {
    return true;
  }
  if ((row.notPvpArena ?? false) && pvpArenaWorld()) {
    return true;
  }
  if ((row.plainWorldOnly ?? false) && worldTypeCode() !== 0) {
    return true;
  }
  if ((row.hdBetaOnly ?? false) && useServerState(SettingsVarbits.HD_BETA) === 0) {
    return true;
  }
  if (
    (row.pastTutorial ?? false) &&
    useServerState(SettingsVarps.TUTORIAL) < 1000 &&
    useServerState(SettingsVarps.TUTORIAL_2) < 1000
  ) {
    return true;
  }

  if (enhanced) {
    const sdBeta: Int = useServerState(SettingsVarbits.SD_BETA);
    if ((row.enhancedRenderNew ?? false) && (sdBeta === 0 || CS2.device_option_get(25) === 1)) {
      return true;
    }
    if ((row.enhancedRenderOld ?? false) && (sdBeta === 0 || CS2.device_option_get(25) === 0)) {
      return true;
    }
    if (
      (row.enhancedGpu ?? false) &&
      useServerState(SettingsVarbits.HD_NEW_RENDERER) === 0 &&
      useServerState(SettingsVarbits.HD_BETA_ENABLED) === 0
    ) {
      return true;
    }
  }

  if ((row.notRentalWorld ?? false) && rentalWorld()) {
    return true;
  }
  if ((row.rentalWorldOnly ?? false) && !rentalWorld()) {
    return true;
  }
  return false;
}

export function deadmanWorld(): Int {
  const flags: Int = useServerState(SettingsVarps.WORLD_FLAGS);
  if (privateEventWorld()) {
    return 3;
  }
  if (hasBit(flags, 29)) {
    if (hasBit(flags, 30) || hasBit(flags, 26)) {
      return 3;
    }
    return 1;
  }
  return 0;
}

export function privateEventWorld(): Boolean {
  const flags: Int = useServerState(SettingsVarps.WORLD_FLAGS);
  if (hasBit(flags, 25) && !hasBit(flags, 23) && hasBit(flags, 4)) {
    return true;
  }
  return false;
}

