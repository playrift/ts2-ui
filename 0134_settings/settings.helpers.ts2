function hdBetaRunning(): Boolean {
  if (!enhancedAny()) {
    return false;
  }
  if (useServerState(SettingsVarbits.SD_BETA) === 0) {
    return false;
  }
  if (useServerState(SettingsVarbits.HD_NEW_RENDERER) === 0) {
    return false;
  }
  if (CS2.device_option_get(25) === 1) {
    return false;
  }
  return true;
}

function settingUnlocked(settingId: Int): Boolean {
  switch (settingId) {
    case 87:
    case 89:
    case 92:
    case 94:
    case 97:
    case 99:
    case 101:
    case 103:
    case 105:
    case 107:
    case 196:
    case 434: {
      if (CS2.window_mode_get() !== 1 && useServerState(Varbits.CHATBOX_TRANSPARENCY) === 1) {
        return false;
      }
      return true;
    }
    case 193:
    case 198: {
      if (!groupIronman()) {
        return false;
      }
      if (CS2.window_mode_get() !== 1 && useServerState(Varbits.CHATBOX_TRANSPARENCY) === 1) {
        return false;
      }
      return true;
    }
    case 194:
    case 199: {
      if (!groupIronman()) {
        return false;
      }
      if (CS2.window_mode_get() === 1 || useServerState(Varbits.CHATBOX_TRANSPARENCY) === 0) {
        return false;
      }
      return true;
    }
    case 206: {
      if (deadmanWorld() !== 0) {
        return false;
      }
      return true;
    }
    case 191:
    case 320: {
      if (onEnhancedMobile() && useServerState(Varbits.POPOUT_PANEL_MOBILE_ENABLED) === 1) {
        return true;
      }
      if (onEnhancedDesktop() && useServerState(Varbits.POPOUT_PANEL_DESKTOP_DISABLED) === 0) {
        return true;
      }
      return false;
    }
    case 296: {
      if (useServerState(Varbits.WILDERNESS_DIARY_ANY_COMPLETE) === 0) {
        return false;
      }
      return true;
    }
    case 380: {
      if (useServerState(Varps.BARCRAWL) !== 2 && useServerState(Varps.SCORPCATCHER) < 6) {
        return false;
      }
      return true;
    }
    case 381: {
      if (useServerState(Varbits.BRUT_FARMING_SMASHING) < 3) {
        return false;
      }
      return true;
    }
    case 373: {
      if (useServerState(Varbits.BRUT_HERB_POTION) < 3) {
        return false;
      }
      return true;
    }
    case 205: {
      if (useServerState(Varbits.IRONMAN) > 0 && !groupIronman()) {
        return false;
      }
      return true;
    }
    case 498: {
      if (
        useServerState(SettingsVarbits.HD_NEW_RENDERER) === 0 &&
        useServerState(SettingsVarbits.HD_BETA_ENABLED) === 0
      ) {
        return false;
      }
      return true;
    }
    case 499: {
      if (!hdBetaRunning()) {
        return false;
      }
      return true;
    }
  }
  return true;
}

export function settingEnabledGates(row: SettingsRow): Int {
  if ((row.mobileAlwaysEnabled ?? false) && onMobile()) {
    return 1;
  }
  if ((row.customEnableCheck ?? false) && !settingUnlocked(row.settingId ?? 0)) {
    return 0;
  }
  return 1;
}

export function settingEnabled(row: SettingsRow): Int {
  if ((row.mobileAlwaysEnabled ?? false) && onMobile()) {
    return 1;
  }
  if ((row.customEnableCheck ?? false) && !settingUnlocked(row.settingId ?? 0)) {
    return 0;
  }
  const requireAll: Int = row.requireAllRows ?? -1;
  if (requireAll !== -1) {
    if (!dependencyMet(requireAll, row.requireAllValues ?? 1565, false)) {
      return 0;
    }
  }
  const requireNone: Int = row.requireNoneRows ?? -1;
  if (requireNone !== -1) {
    if (!dependencyMet(requireNone, row.requireNoneValues ?? -1, true)) {
      return 0;
    }
  }
  return 1;
}

function dependencyValue(settingId: Int, kind: Int): Int {
  if (kind === 0) {
    return settingValue(settingId);
  }
  if (kind === 2) {
    return dropdownValue(settingId);
  }
  return 0;
}

function dependencyEntryMet(
  settingId: Int,
  kind: Int,
  allRows: Int,
  allValues: Int,
  noneRows: Int,
  noneValues: Int,
  expected: Int,
  requireNone: Boolean,
): Boolean {
  if (allRows !== -1 && !dependencyMet(allRows, allValues, false)) {
    return false;
  }
  if (noneRows !== -1 && !dependencyMet(noneRows, noneValues, true)) {
    return false;
  }
  if (settingId === 0) {
    return false;
  }
  const actual: Int = dependencyValue(settingId, kind);
  if (!requireNone) {
    if (expected !== actual) {
      return false;
    }
    return true;
  }
  if (expected === actual) {
    return false;
  }
  return true;
}

export function dependencyMet(rowsEnum: Int, valsEnum: Int, requireNone: Boolean): Boolean {
  const deps: SettingsDep | null = SettingsDeps.get(rowsEnum);
  const values: SettingsDepValue | null = SettingsDepValues.get(valsEnum);
  if (deps === null || values === null) {
    return false;
  }
  if (
    !dependencyEntryMet(
      deps.setting0,
      deps.kind0,
      deps.all0Rows ?? -1,
      deps.all0Values ?? 1565,
      deps.none0Rows ?? -1,
      deps.none0Values ?? -1,
      values.v0,
      requireNone,
    )
  ) {
    return false;
  }
  if (deps.count > 1) {
    if (
      !dependencyEntryMet(
        deps.setting1 ?? 0,
        deps.kind1 ?? 0,
        deps.all1Rows ?? -1,
        deps.all1Values ?? 1565,
        deps.none1Rows ?? -1,
        deps.none1Values ?? -1,
        values.v1,
        requireNone,
      )
    ) {
      return false;
    }
  }
  return true;
}

export function rowLockedMessage(row: SettingsRow): String {
  const mobile: String = row.lockedMessageMobile ?? '';
  if (onMobile() && mobile.length > 0) {
    return mobile;
  }
  return row.lockedMessage ?? LOCKED_MESSAGE;
}

const LOCKED_MESSAGE = "You can't change this setting at the moment.";
