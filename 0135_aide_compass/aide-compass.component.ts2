import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  COMPASS_INK,
  CompassArt,
  CompassCamera,
  CompassFonts,
  CompassLayout,
  CompassModels,
  CompassText,
} from './aide-compass.constants';

export function AideCompass(): Component {
  return (
    <>
      <model
        x={CompassLayout.SCROLL_NORTH.X}
        y={CompassLayout.SCROLL_NORTH.Y}
        w={CompassLayout.SCROLL_NORTH.SIZE}
        h={CompassLayout.SCROLL_NORTH.SIZE}
        model={CompassModels.SCROLL_NS}
        zoom={CompassCamera.NS.ZOOM}
        pitch={CompassCamera.NS.PITCH}
        yaw={CompassCamera.NS.YAW}
      />

      <text
        x={CompassLayout.NORTH_HEAD.X}
        y={CompassLayout.NORTH_HEAD.Y}
        w={CompassLayout.NORTH_HEAD.W}
        h={CompassLayout.NORTH_HEAD.H}
        text={CompassText.NORTH}
        font={CompassFonts.HEADING}
        color={COMPASS_INK}
        align="center"
      />

      <text
        x={CompassLayout.NORTH_BODY.X}
        y={CompassLayout.NORTH_BODY.Y}
        w={CompassLayout.NORTH_BODY.W}
        h={CompassLayout.NORTH_BODY.H}
        text={CompassText.NORTH}
        font={CompassFonts.BODY}
        color={COMPASS_INK}
        align="center"
        valign="middle"
      />

      <model
        x={CompassLayout.SCROLL_EAST.X}
        y={CompassLayout.SCROLL_EAST.Y}
        w={CompassLayout.SCROLL_EAST.SIZE}
        h={CompassLayout.SCROLL_EAST.SIZE}
        model={CompassModels.SCROLL_EW}
        zoom={CompassCamera.EAST.ZOOM}
        pitch={CompassCamera.EAST.PITCH}
        yaw={CompassCamera.EAST.YAW}
      />

      <model
        x={CompassLayout.SCROLL_SOUTH.X}
        y={CompassLayout.SCROLL_SOUTH.Y}
        w={CompassLayout.SCROLL_SOUTH.SIZE}
        h={CompassLayout.SCROLL_SOUTH.SIZE}
        model={CompassModels.SCROLL_NS}
        zoom={CompassCamera.NS.ZOOM}
        pitch={CompassCamera.NS.PITCH}
        yaw={CompassCamera.NS.YAW}
      />

      <text
        x={CompassLayout.EAST_HEAD.X}
        y={CompassLayout.EAST_HEAD.Y}
        w={CompassLayout.EAST_HEAD.W}
        h={CompassLayout.EAST_HEAD.H}
        text={CompassText.EAST}
        font={CompassFonts.HEADING}
        color={COMPASS_INK}
        align="center"
      />

      <text
        x={CompassLayout.SOUTH_HEAD.X}
        y={CompassLayout.SOUTH_HEAD.Y}
        w={CompassLayout.SOUTH_HEAD.W}
        h={CompassLayout.SOUTH_HEAD.H}
        text={CompassText.SOUTH}
        font={CompassFonts.HEADING}
        color={COMPASS_INK}
        align="center"
      />

      <text
        x={CompassLayout.EAST_BODY.X}
        y={CompassLayout.EAST_BODY.Y}
        w={CompassLayout.EAST_BODY.W}
        h={CompassLayout.EAST_BODY.H}
        text={CompassText.EAST}
        font={CompassFonts.BODY}
        color={COMPASS_INK}
        align="center"
        valign="middle"
      />

      <text
        x={CompassLayout.SOUTH_BODY.X}
        y={CompassLayout.SOUTH_BODY.Y}
        w={CompassLayout.SOUTH_BODY.W}
        h={CompassLayout.SOUTH_BODY.H}
        text={CompassText.SOUTH}
        font={CompassFonts.BODY}
        color={COMPASS_INK}
        align="center"
        valign="middle"
      />

      <model
        x={CompassLayout.SCROLL_WEST.X}
        y={CompassLayout.SCROLL_WEST.Y}
        w={CompassLayout.SCROLL_WEST.SIZE}
        h={CompassLayout.SCROLL_WEST.SIZE}
        model={CompassModels.SCROLL_EW}
        zoom={CompassCamera.WEST.ZOOM}
        pitch={CompassCamera.WEST.PITCH}
      />

      <text
        x={CompassLayout.WEST_HEAD.X}
        y={CompassLayout.WEST_HEAD.Y}
        w={CompassLayout.WEST_HEAD.W}
        h={CompassLayout.WEST_HEAD.H}
        text={CompassText.WEST}
        font={CompassFonts.HEADING}
        color={COMPASS_INK}
        align="center"
      />

      <text
        x={CompassLayout.WEST_BODY.X}
        y={CompassLayout.WEST_BODY.Y}
        w={CompassLayout.WEST_BODY.W}
        h={CompassLayout.WEST_BODY.H}
        text={CompassText.WEST}
        font={CompassFonts.BODY}
        color={COMPASS_INK}
        align="center"
        valign="middle"
      />

      <sprite
        x={{ right: CompassLayout.CLOSE.RIGHT }}
        y={CompassLayout.CLOSE.Y}
        w={CompassLayout.CLOSE.W}
        h={CompassLayout.CLOSE.H}
        sprite={CompassArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, CompassArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, CompassArt.CLOSE);
        }}
      />

      <model
        x={CompassLayout.POST.X}
        y={CompassLayout.POST.Y}
        w={CompassLayout.POST.SIZE}
        h={CompassLayout.POST.SIZE}
        model={CompassModels.SIGN_POST}
        zoom={CompassCamera.POST.ZOOM}
        pitch={CompassCamera.POST.PITCH}
      />
    </>
  );
}
