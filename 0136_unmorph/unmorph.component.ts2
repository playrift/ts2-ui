import { LABEL_COLOR, LABEL_TEXT, Layout, OPTION_TEXT, UnmorphFonts, UnmorphSprites } from './unmorph.constants';

export function Unmorph(): Component {
  return (
    <layer x={Layout.PANEL_X} y={Layout.PANEL_Y} w={Layout.PANEL_W} h={Layout.PANEL_H} options={[OPTION_TEXT]}>
      <sprite x={{ right: Layout.BODY_RIGHT_X }} y={0} w={Layout.TILE} h={Layout.TILE} sprite={UnmorphSprites.PLATE} />
      <sprite x={Layout.BODY_LEFT_X} y={0} w={Layout.TILE} h={Layout.TILE} sprite={UnmorphSprites.PLATE} />
      <sprite
        x={{ right: Layout.END_INNER_X }}
        y={0}
        w={Layout.TILE}
        h={Layout.TILE}
        sprite={UnmorphSprites.PLATE_END}
      />
      <sprite x="right" y={0} w={Layout.TILE} h={Layout.TILE} sprite={UnmorphSprites.PLATE_END} />
      <sprite x={0} y={0} w={Layout.TILE} h={Layout.TILE} sprite={UnmorphSprites.PLATE} />

      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        text={LABEL_TEXT}
        font={UnmorphFonts.LABEL}
        color={LABEL_COLOR}
        shadow={true}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
