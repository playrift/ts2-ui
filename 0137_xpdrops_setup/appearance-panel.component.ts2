import { onMobile } from '../lib/lib.helpers';
import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { DisplayControl } from './display-control.component';
import { controlLeft, controlTop } from './xpdrops-setup.helpers';
import { XpdropsControl, XpdropsLayout, XpdropsSprite } from './xpdrops-setup.constants';

export function XpdropsAppearance(): Component {
  const mobile: Boolean = onMobile();

  return (
    <layer x="center" y="top" w="fill" h={XpdropsLayout.main.h}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={XpdropsSprite.PANEL} tiling />

      {!mobile && (
        <layer x={8} y={8} w={115} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.POSITION}
            anchorX={controlLeft(XpdropsControl.POSITION, mobile)}
            anchorY={controlTop(XpdropsControl.POSITION, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={128} y={8} w={110} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.SIZE}
            anchorX={controlLeft(XpdropsControl.SIZE, mobile)}
            anchorY={controlTop(XpdropsControl.SIZE, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={243} y={8} w={{ fill: 366 }} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.SPEED}
            anchorX={controlLeft(XpdropsControl.SPEED, mobile)}
            anchorY={controlTop(XpdropsControl.SPEED, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={{ right: 8 }} y={8} w={110} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.DURATION}
            anchorX={controlLeft(XpdropsControl.DURATION, mobile)}
            anchorY={controlTop(XpdropsControl.DURATION, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={8} y={{ bottom: 8 }} w={105} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.COUNTER}
            anchorX={controlLeft(XpdropsControl.COUNTER, mobile)}
            anchorY={controlTop(XpdropsControl.COUNTER, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={118} y={{ bottom: 8 }} w={105} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.PROGRESS}
            anchorX={controlLeft(XpdropsControl.PROGRESS, mobile)}
            anchorY={controlTop(XpdropsControl.PROGRESS, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={228} y={{ bottom: 8 }} w={{ fill: 386 }} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.COLOUR}
            anchorX={controlLeft(XpdropsControl.COLOUR, mobile)}
            anchorY={controlTop(XpdropsControl.COLOUR, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={{ right: 88 }} y={{ bottom: 8 }} w={65} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.GROUPING}
            anchorX={controlLeft(XpdropsControl.GROUPING, mobile)}
            anchorY={controlTop(XpdropsControl.GROUPING, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {!mobile && (
        <layer x={{ right: 8 }} y={{ bottom: 8 }} w={75} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.FAKES}
            anchorX={controlLeft(XpdropsControl.FAKES, mobile)}
            anchorY={controlTop(XpdropsControl.FAKES, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}

      {mobile && (
        <layer x={8} y={8} w={150} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.COUNTER}
            anchorX={controlLeft(XpdropsControl.COUNTER, mobile)}
            anchorY={controlTop(XpdropsControl.COUNTER, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={163} y={8} w={150} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.PROGRESS}
            anchorX={controlLeft(XpdropsControl.PROGRESS, mobile)}
            anchorY={controlTop(XpdropsControl.PROGRESS, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={{ right: 8 }} y={8} w={{ fill: 327 }} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.COLOUR}
            anchorX={controlLeft(XpdropsControl.COLOUR, mobile)}
            anchorY={controlTop(XpdropsControl.COLOUR, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={8} y={{ bottom: 8 }} w={120} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.SPEED}
            anchorX={controlLeft(XpdropsControl.SPEED, mobile)}
            anchorY={controlTop(XpdropsControl.SPEED, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={133} y={{ bottom: 8 }} w={{ fill: 321 }} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.DURATION}
            anchorX={controlLeft(XpdropsControl.DURATION, mobile)}
            anchorY={controlTop(XpdropsControl.DURATION, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={{ right: 98 }} y={{ bottom: 8 }} w={85} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.GROUPING}
            anchorX={controlLeft(XpdropsControl.GROUPING, mobile)}
            anchorY={controlTop(XpdropsControl.GROUPING, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}
      {mobile && (
        <layer x={{ right: 8 }} y={{ bottom: 8 }} w={85} h={XpdropsLayout.control.h}>
          <DisplayControl
            control={XpdropsControl.FAKES}
            anchorX={controlLeft(XpdropsControl.FAKES, mobile)}
            anchorY={controlTop(XpdropsControl.FAKES, mobile) + XpdropsLayout.control.tipDrop}
          />
        </layer>
      )}

      <StonePanelEntrypoint divider={-1} />
    </layer>
  );
