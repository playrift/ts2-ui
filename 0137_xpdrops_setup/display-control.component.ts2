import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { dropdownChevronSprite, dropdownChevronWash, dropdownStripWash, dropdownValueColor } from './dropdown-control';
import { controlHeading, controlValue } from './xpdrops-setup.helpers';
import { hideControlTooltip, openControl, openDropdown, showControlTooltip } from './xpdrops-setup.state';
import { XpdropsColor, XpdropsFont, XpdropsLayout, XpdropsSprite } from './xpdrops-setup.constants';

export function DisplayControl({ control, anchorX, anchorY }: { control: Int; anchorX: Int; anchorY: Int }): Component {
  const [open] = useState(openControl);
  let lit: Int = 0;
  if (open === control) {
    lit = 1;
  }

  const label: String = controlValue(control);
  const [hovered, setHovered] = useState(0);
  const stripWash: Int = dropdownStripWash(lit, hovered);
  const chevronWash: Int = dropdownChevronWash(lit, hovered);
  const chevronSprite: Sprite = dropdownChevronSprite(lit);
  const valueColor: Int = dropdownValueColor(lit, hovered);

  return (
    <>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={XpdropsLayout.control.stripH}
        sprite={XpdropsSprite.CONTROL}
        tiling
        transparency={stripWash}
        onMouseEnter={
          lit === 1
            ? null
            : () => {
                if (!onMobile()) {
                  setHovered(1);
                }
              }
        }
        onMouseLeave={
          lit === 1
            ? null
            : () => {
                if (!onMobile()) {
                  setHovered(0);
                }
              }
        }
        onClick={() => {
          openDropdown(control);
          setHovered(0);
        }}
      />

      <rect
        x="center"
        y="bottom"
        w="fill"
        h={XpdropsLayout.control.stripH}
        fill={false}
        color={XpdropsColor.CONTROL_EDGE}
        onMouseRepeat={() => showControlTooltip(control, anchorX, anchorY)}
        onMouseLeave={() => hideControlTooltip()}
      />

      <rect
        x="center"
        y={{ bottom: XpdropsLayout.control.innerBottom }}
        w={{ fill: XpdropsLayout.control.innerInset }}
        h={XpdropsLayout.control.innerH}
        fill={false}
        color={XpdropsColor.CONTROL_INNER}
      />

      <sprite
        x={{ right: XpdropsLayout.chevron.right }}
        y={{ bottom: XpdropsLayout.chevron.bottom }}
        w={XpdropsLayout.chevron.size}
        h={XpdropsLayout.chevron.size}
        sprite={chevronSprite}
        transparency={chevronWash}
      />

      <text
        x={XpdropsLayout.value.x}
        y={{ bottom: XpdropsLayout.value.bottom }}
        w={{ fill: XpdropsLayout.value.inset }}
        h={XpdropsLayout.value.h}
        text={label}
        font={XpdropsFont.VALUE}
        color={valueColor}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x="center"
        y={0}
        w="fill"
        h={{ fill: XpdropsLayout.heading.drop }}
        text={controlHeading(control)}
        font={XpdropsFont.HEADING}
        color={XpdropsColor.LABEL}
        align="center"
        valign="top"
        shadow
      />
    </>
  );
}
