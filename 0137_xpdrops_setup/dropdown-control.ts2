import { XpdropsColor, XpdropsSprite, XpdropsWash } from './xpdrops-setup.constants';

export function dropdownStripWash(lit: Int, hovered: Int): Int {
  if (lit === 1) {
    return XpdropsWash.FULL;
  }
  if (hovered === 1) {
    return XpdropsWash.CONTROL_HOVER;
  }
  return XpdropsWash.OPAQUE;
}

export function dropdownChevronWash(lit: Int, hovered: Int): Int {
  if (lit !== 1 && hovered === 1) {
    return XpdropsWash.ARROW_HOVER;
  }
  return XpdropsWash.OPAQUE;
}

export function dropdownChevronSprite(lit: Int): Sprite {
  if (lit === 1) {
    return XpdropsSprite.ARROW_UP;
  }
  return XpdropsSprite.ARROW_DOWN;
}

export function dropdownValueColor(lit: Int, hovered: Int): Int {
  if (lit === 1 || hovered === 1) {
    return XpdropsColor.LABEL_HOT;
  }
  return XpdropsColor.LABEL;
}
