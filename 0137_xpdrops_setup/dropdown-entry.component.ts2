import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { chooseOption, dropdownBarHeight, dropdownBarTop, moveDropdownBar } from './xpdrops-setup.state';
import { XpdropsColor, XpdropsFont, XpdropsWash } from './xpdrops-setup.constants';

export function DropdownEntry({
  value,
  label,
  top,
  height,
  color,
  control,
}: {
  value: Int;
  label: String;
  top: Int;
  height: Int;
  color: Int;
  control: Int;
}): Component {
  const [hovered, setHovered] = useState(0);

  return (
    <text
      x="center"
      y={top}
      w="fill"
      h={height}
      text={label}
      font={XpdropsFont.VALUE}
      color={hovered === 1 ? XpdropsColor.LABEL_HOT : color}
      align="center"
      valign="middle"
      shadow
      options={['Select']}
      onMouseEnter={() => {
        if (!onMobile()) {
          setHovered(1);
          moveDropdownBar(top, height, true);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setHovered(0);
          moveDropdownBar(top, height, false);
        }
      }}
      onOptionSelect={() => chooseOption(control, value)}
    />
  );
}

export function DropdownHoverBar(): Component {
  const [top] = useState(dropdownBarTop);
  const [height] = useState(dropdownBarHeight);
  return (
    <rect
      x={0}
      y={top < 0 ? 0 : top}
      w="fill"
      h={height}
      fill
      color={XpdropsColor.WHITE}
      transparency={XpdropsWash.LIST_HOVER}
      hide={top < 0}
    />
  );
}
