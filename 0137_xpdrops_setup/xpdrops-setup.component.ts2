import { useServerState } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SkillByIndex } from '../lib/skills.data';
import { XpdropsAppearance } from './appearance-panel.component';
import { XpdropsDropdown } from './dropdown-popup.component';
import { XpdropsSkillList } from './skill-list.component';
import { XpdropsSkillSetup } from './skill-setup.component';
import { XpdropsSetupTooltip } from './xpdrops-setup-tooltip.component';
import { XpdropsLayout, XpdropsVars } from './xpdrops-setup.constants';

export function XpdropsSetup(): Component {
  const setupSkill: Int = useServerState(XpdropsVars.SETUP_SKILL);
  const listView: Boolean = SkillByIndex.get(setupSkill) === null && setupSkill !== XpdropsLayout.row.count;

  return (
    <>
      <layer x="center" y="center" w={XpdropsLayout.universe.w} h={XpdropsLayout.universe.h}>
        <SteelBorderEntrypoint title="Configure XP Drops" />

        <layer
          x="center"
          y={{ bottom: XpdropsLayout.contents.bottom }}
          w={{ fill: XpdropsLayout.contents.insetW }}
          h={{ fill: XpdropsLayout.contents.insetH }}
        >
          {listView && <XpdropsAppearance />}
          {listView && <XpdropsSkillList />}
          {!listView && <XpdropsSkillSetup />}
        </layer>

        <XpdropsDropdown />
      </layer>

      <layer w="fill" h="fill">
        <XpdropsSetupTooltip />
      </layer>
    </>
  );
}
