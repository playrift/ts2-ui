import { useServerState } from 'ts2';

import { textClient } from '../0179_farming_view/farming-view.helpers';
import { SkillByIndex } from '../lib/skills.data';
import {
  SkillNamesByIndex,
  SKILLS_ALPHABETICAL,
  XpDropColourNames,
  XpDropDurations,
  XpDropFakes,
  XpDropGrouping,
  XpDropPositions,
  XpDropSizes,
  XpDropSpeeds,
} from './xpdrops-setup.data';
import { XpdropsChoice, XpdropsControl, XpdropsLayout, XpdropsVars } from './xpdrops-setup.constants';

export function controlHeading(control: Int): String {
  switch (control) {
    case XpdropsControl.POSITION:
      return 'Position';
    case XpdropsControl.SIZE:
      return 'Size';
    case XpdropsControl.DURATION:
      return 'Duration';
    case XpdropsControl.COUNTER:
      return 'Counter';
    case XpdropsControl.PROGRESS:
      return 'Progress bar';
    case XpdropsControl.COLOUR:
      return 'Colour';
    case XpdropsControl.GROUPING:
      return 'Group';
    case XpdropsControl.SPEED:
      return 'Speed';
    default:
      return 'Fake drops';
  }
}

export function controlValue(control: Int): String {
  switch (control) {
    case XpdropsControl.POSITION:
      return XpDropPositions.at(useServerState(XpdropsVars.POSITION)) ?? 'Position';
    case XpdropsControl.SIZE:
      return XpDropSizes.at(useServerState(XpdropsVars.SIZE)) ?? 'Size';
    case XpdropsControl.DURATION:
      return XpDropDurations.at(useServerState(XpdropsVars.DURATION)) ?? 'Duration';
    case XpdropsControl.COUNTER: {
      const counter: Int = useServerState(XpdropsVars.COUNTER_TYPE);
      if (counter === XpdropsChoice.RECENT) {
        return 'Most recent';
      }
      if (counter === XpdropsChoice.TAIL) {
        return 'Off';
      }
      if (SkillByIndex.get(counter) !== null) {
        return SkillNamesByIndex.get(counter) ?? 'this skill';
      }
      return 'Total XP';
    }
    case XpdropsControl.PROGRESS: {
      const progress: Int = useServerState(XpdropsVars.PROGRESS_TYPE);
      if (progress === XpdropsChoice.RECENT) {
        return 'Most recent';
      }
      if (progress === XpdropsChoice.TAIL) {
        return 'Total XP goal';
      }
      if (SkillByIndex.get(progress) !== null) {
        return SkillNamesByIndex.get(progress) ?? 'this skill';
      }
      return 'Off';
    }
    case XpdropsControl.COLOUR:
      return XpDropColourNames.at(useServerState(XpdropsVars.COLOUR)) ?? 'Colour';
    case XpdropsControl.GROUPING:
      return XpDropGrouping.at(useServerState(XpdropsVars.GROUPSKILLS)) ?? 'Group';
    case XpdropsControl.SPEED:
      return XpDropSpeeds.at(useServerState(XpdropsVars.SPEED)) ?? 'Speed';
    default:
      return XpDropFakes.at(useServerState(XpdropsVars.FAKESOFF)) ?? 'Fake drops';
  }
}

export function controlChoice(control: Int): Int {
  switch (control) {
    case XpdropsControl.POSITION:
      return useServerState(XpdropsVars.POSITION);
    case XpdropsControl.SIZE:
      return useServerState(XpdropsVars.SIZE);
    case XpdropsControl.DURATION:
      return useServerState(XpdropsVars.DURATION);
    case XpdropsControl.COUNTER:
      return useServerState(XpdropsVars.COUNTER_TYPE);
    case XpdropsControl.PROGRESS:
      return useServerState(XpdropsVars.PROGRESS_TYPE);
    case XpdropsControl.COLOUR:
      return useServerState(XpdropsVars.COLOUR);
    case XpdropsControl.GROUPING:
      return useServerState(XpdropsVars.GROUPSKILLS);
    case XpdropsControl.SPEED:
      return useServerState(XpdropsVars.SPEED);
    default:
      return useServerState(XpdropsVars.FAKESOFF);
  }
}

export function controlTooltip(control: Int): String {
  switch (control) {
    case XpdropsControl.POSITION:
      return 'Controls the position of the XP display and droplets.';
    case XpdropsControl.SIZE:
      return 'Controls the text size used by the XP display and droplets.';
    case XpdropsControl.DURATION:
      return 'Controls how long the XP display remains visible after each event.';
    case XpdropsControl.COUNTER:
      return `Choose which skill will have its details displayed in the number panel.<br><br>'${textClient('<col=ef1020>', '<col=ff981f>')}Most recent</col>' will show whichever skill gained XP most recently.<br><br>If a ${textClient('<col=ef1020>', '<col=ff981f>')}tracker</col> has been set for the skill, the panel will show XP gained since the tracker's start point.`;
    case XpdropsControl.PROGRESS:
      return `Choose which skill will have its details displayed in the progress bar.<br><br>'${textClient('<col=ef1020>', '<col=ff981f>')}Most recent</col>' will show whichever skill gained XP most recently.<br><br>If a ${textClient('<col=ef1020>', '<col=ff981f>')}goal</col> has been set for the skill, the bar will show progress towards that goal.<br><br>Otherwise it will show progress towards the next level.`;
    case XpdropsControl.COLOUR:
      return 'Controls the text colour of the droplets.';
    case XpdropsControl.GROUPING:
      return 'When multiple skills increase together, their droplets may be grouped, within limits.';
    case XpdropsControl.SPEED:
      return 'Droplet speed.';
    default:
      return 'Enables fake XP drops in certain situations where XP is blocked.';
  }
}

export function controlTooltipWrap(control: Int): Int {
  switch (control) {
    case XpdropsControl.POSITION:
      return 170;
    case XpdropsControl.SIZE:
      return 180;
    case XpdropsControl.DURATION:
      return 200;
    case XpdropsControl.COUNTER:
      return 300;
    case XpdropsControl.PROGRESS:
      return 300;
    case XpdropsControl.COLOUR:
      return 150;
    case XpdropsControl.GROUPING:
      return 300;
    case XpdropsControl.SPEED:
      return 200;
    default:
      return 250;
  }
}

export function controlRowCount(control: Int): Int {
  switch (control) {
    case XpdropsControl.POSITION:
      return XpDropPositions.length;
    case XpdropsControl.SIZE:
      return XpDropSizes.length;
    case XpdropsControl.DURATION:
      return XpDropDurations.length;
    case XpdropsControl.COUNTER:
      return SKILLS_ALPHABETICAL.length + 3;
    case XpdropsControl.PROGRESS:
      return SKILLS_ALPHABETICAL.length + 3;
    case XpdropsControl.COLOUR:
      return XpDropColourNames.length;
    case XpdropsControl.GROUPING:
      return XpDropGrouping.length;
    case XpdropsControl.SPEED:
      return XpDropSpeeds.length;
    default:
      return XpDropFakes.length;
  }
}

export function controlIsSkillList(control: Int): Boolean {
  if (control === XpdropsControl.COUNTER) {
    return true;
  }
  if (control === XpdropsControl.PROGRESS) {
    return true;
  }
  return false;
}

export function controlLeft(control: Int, mobile: Boolean): Int {
  const w: Int = XpdropsLayout.contents.w;
  if (mobile) {
    switch (control) {
      case XpdropsControl.COUNTER:
        return 8;
      case XpdropsControl.PROGRESS:
        return 163;
      case XpdropsControl.COLOUR:
        return w - (w - 327) - 8;
      case XpdropsControl.SPEED:
        return 8;
      case XpdropsControl.DURATION:
        return 133;
      case XpdropsControl.GROUPING:
        return w - 85 - 98;
      case XpdropsControl.FAKES:
        return w - 85 - 8;
      default:
        return 8;
    }
  }
  switch (control) {
    case XpdropsControl.POSITION:
      return 8;
    case XpdropsControl.SIZE:
      return 128;
    case XpdropsControl.SPEED:
      return 243;
    case XpdropsControl.DURATION:
      return w - 110 - 8;
    case XpdropsControl.COUNTER:
      return 8;
    case XpdropsControl.PROGRESS:
      return 118;
    case XpdropsControl.COLOUR:
      return 228;
    case XpdropsControl.GROUPING:
      return w - 65 - 88;
    default:
      return w - 75 - 8;
  }
}

export function controlTop(control: Int, mobile: Boolean): Int {
  const bottom: Int = XpdropsLayout.main.h - XpdropsLayout.control.h - 8;
  if (mobile) {
    switch (control) {
      case XpdropsControl.COUNTER:
        return 8;
      case XpdropsControl.PROGRESS:
        return 8;
      case XpdropsControl.COLOUR:
        return 8;
      default:
        return bottom;
    }
  }
  switch (control) {
    case XpdropsControl.POSITION:
      return 8;
    case XpdropsControl.SIZE:
      return 8;
    case XpdropsControl.SPEED:
      return 8;
    case XpdropsControl.DURATION:
      return 8;
    default:
      return bottom;
  }
}

export function controlWidth(control: Int, mobile: Boolean): Int {
  const w: Int = XpdropsLayout.contents.w;
  if (mobile) {
    switch (control) {
      case XpdropsControl.COUNTER:
        return 150;
      case XpdropsControl.PROGRESS:
        return 150;
      case XpdropsControl.COLOUR:
        return w - 327;
      case XpdropsControl.SPEED:
        return 120;
      case XpdropsControl.DURATION:
        return w - 321;
      case XpdropsControl.GROUPING:
        return 85;
      case XpdropsControl.FAKES:
        return 85;
      default:
        return 115;
    }
  }
  switch (control) {
    case XpdropsControl.POSITION:
      return 115;
    case XpdropsControl.SIZE:
      return 110;
    case XpdropsControl.SPEED:
      return w - 366;
    case XpdropsControl.DURATION:
      return 110;
    case XpdropsControl.COUNTER:
      return 105;
    case XpdropsControl.PROGRESS:
      return 105;
    case XpdropsControl.COLOUR:
      return w - 386;
    case XpdropsControl.GROUPING:
      return 65;
    default:
      return 75;
  }
}
