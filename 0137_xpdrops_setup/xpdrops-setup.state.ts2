import { predictServerState, sessionState, useServerState, useState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { clientClock, playSound } from '../lib/lib.engine';
import { enhancedAny } from '../lib/lib.overlay';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { Varps } from '../lib/game/varps';
import { LevelForXp } from './xpdrops-setup.data';
import { XpdropsControl, XpdropsLayout, XpdropsSound, XpdropsVars } from './xpdrops-setup.constants';

export const openControl = sessionState(-1);

export const dropdownBarTop = sessionState(-1);
export const dropdownBarHeight = sessionState(0);

export function openDropdown(control: Int): void {
  const [, setOpen] = useState(openControl);
  const [, setBarTop] = useState(dropdownBarTop);
  playSound(XpdropsSound.SELECT);
  hideControlTooltip();
  setBarTop(-1);
  setOpen(control);
}

export function moveDropdownBar(top: Int, height: Int, lit: Boolean): void {
  const [, setBarTop] = useState(dropdownBarTop);
  const [, setBarHeight] = useState(dropdownBarHeight);
  if (lit) {
    setBarHeight(height);
    setBarTop(top);
    return;
  }
  setBarTop(-1);
}

export function dismissDropdown(): void {
  const [, setOpen] = useState(openControl);
  playSound(XpdropsSound.SELECT);
  hideControlTooltip();
  setOpen(-1);
}

export function chooseOption(control: Int, value: Int): void {
  if (control === XpdropsControl.POSITION) {
    predictServerState(XpdropsVars.POSITION, value);
  } else if (control === XpdropsControl.SIZE) {
    predictServerState(XpdropsVars.SIZE, value);
  } else if (control === XpdropsControl.DURATION) {
    predictServerState(XpdropsVars.DURATION, value);
  } else if (control === XpdropsControl.COUNTER) {
    predictServerState(XpdropsVars.COUNTER_TYPE, value);
  } else if (control === XpdropsControl.PROGRESS) {
    predictServerState(XpdropsVars.PROGRESS_TYPE, value);
  } else if (control === XpdropsControl.COLOUR) {
    predictServerState(XpdropsVars.COLOUR, value);
  } else if (control === XpdropsControl.GROUPING) {
    predictServerState(XpdropsVars.GROUPSKILLS, value);
  } else if (control === XpdropsControl.SPEED) {
    predictServerState(XpdropsVars.SPEED, value);
  } else if (control === XpdropsControl.FAKES) {
    predictServerState(XpdropsVars.FAKESOFF, value);
  }
  dismissDropdown();
}

export function xpdropsDataGet(row: Int): [Int, Int] {
  switch (row) {
    case 0:
      return [useServerState(Varps.XPDROPS_ATTACK_START), useServerState(Varps.XPDROPS_ATTACK_END)];
    case 1:
      return [useServerState(Varps.XPDROPS_STRENGTH_START), useServerState(Varps.XPDROPS_STRENGTH_END)];
    case 2:
      return [useServerState(Varps.XPDROPS_RANGED_START), useServerState(Varps.XPDROPS_RANGED_END)];
    case 3:
      return [useServerState(Varps.XPDROPS_MAGIC_START), useServerState(Varps.XPDROPS_MAGIC_END)];
    case 4:
      return [useServerState(Varps.XPDROPS_DEFENCE_START), useServerState(Varps.XPDROPS_DEFENCE_END)];
    case 5:
      return [useServerState(Varps.XPDROPS_HITPOINTS_START), useServerState(Varps.XPDROPS_HITPOINTS_END)];
    case 6:
      return [useServerState(Varps.XPDROPS_PRAYER_START), useServerState(Varps.XPDROPS_PRAYER_END)];
    case 7:
      return [useServerState(Varps.XPDROPS_AGILITY_START), useServerState(Varps.XPDROPS_AGILITY_END)];
    case 8:
      return [useServerState(Varps.XPDROPS_HERBLORE_START), useServerState(Varps.XPDROPS_HERBLORE_END)];
    case 9:
      return [useServerState(Varps.XPDROPS_THIEVING_START), useServerState(Varps.XPDROPS_THIEVING_END)];
    case 10:
      return [useServerState(Varps.XPDROPS_CRAFTING_START), useServerState(Varps.XPDROPS_CRAFTING_END)];
    case 11:
      return [useServerState(Varps.XPDROPS_RUNECRAFT_START), useServerState(Varps.XPDROPS_RUNECRAFT_END)];
    case 12:
      return [useServerState(Varps.XPDROPS_MINING_START), useServerState(Varps.XPDROPS_MINING_END)];
    case 13:
      return [useServerState(Varps.XPDROPS_SMITHING_START), useServerState(Varps.XPDROPS_SMITHING_END)];
    case 14:
      return [useServerState(Varps.XPDROPS_FISHING_START), useServerState(Varps.XPDROPS_FISHING_END)];
    case 15:
      return [useServerState(Varps.XPDROPS_COOKING_START), useServerState(Varps.XPDROPS_COOKING_END)];
    case 16:
      return [useServerState(Varps.XPDROPS_FIREMAKING_START), useServerState(Varps.XPDROPS_FIREMAKING_END)];
    case 17:
      return [useServerState(Varps.XPDROPS_WOODCUTTING_START), useServerState(Varps.XPDROPS_WOODCUTTING_END)];
    case 18:
      return [useServerState(Varps.XPDROPS_FLETCHING_START), useServerState(Varps.XPDROPS_FLETCHING_END)];
    case 19:
      return [useServerState(Varps.XPDROPS_SLAYER_START), useServerState(Varps.XPDROPS_SLAYER_END)];
    case 20:
      return [useServerState(Varps.XPDROPS_FARMING_START), useServerState(Varps.XPDROPS_FARMING_END)];
    case 21:
      return [useServerState(Varps.XPDROPS_CONSTRUCTION_START), useServerState(Varps.XPDROPS_CONSTRUCTION_END)];
    case 22:
      return [useServerState(Varps.XPDROPS_HUNTER_START), useServerState(Varps.XPDROPS_HUNTER_END)];
    case 23:
      return [useServerState(Varps.XPDROPS_SAILING_START), useServerState(Varps.XPDROPS_SAILING_END)];
    default:
      return [useServerState(Varps.XPDROPS_TOTAL_START), useServerState(Varps.XPDROPS_TOTAL_END)];
  }
}

export function selectSkillRow(row: Int): void {
  playSound(XpdropsSound.SELECT);
  if (row === -1) {
    predictServerState(XpdropsVars.SETUP_SKILL, 0);
    return;
  }
  const [start, end] = xpdropsDataGet(row);
  predictServerState(XpdropsVars.SETUP_SKILL, row + 1);
  if (end === -1) {
    predictServerState(XpdropsVars.SETUP_TYPE, 1);
  } else if (end > start) {
    predictServerState(XpdropsVars.SETUP_TYPE, 2);
  } else {
    predictServerState(XpdropsVars.SETUP_TYPE, 0);
  }
  predictServerState(XpdropsVars.EDIT_START, start);
  predictServerState(XpdropsVars.EDIT_END, end);
}

export function chooseSetupType(type: Int): void {
  playSound(XpdropsSound.SELECT);
  predictServerState(XpdropsVars.SETUP_TYPE, type);
  predictServerState(XpdropsVars.EDIT_START, -1);
  predictServerState(XpdropsVars.EDIT_END, -1);
}

export function xpdropsToString(xp: Int, capital: Int): String {
  if (xp < 0) {
    return '';
  }
  const level: Int = LevelForXp.get(xp) ?? 0;
  if (level > 0) {
    if (capital === 1) {
      return `Level ${stringOf(level)}`;
    }
    return `level ${stringOf(level)}`;
  }
  return `${groupDigits(xp, ',')} XP`;
}

export function xpdropsToStringThousands(xp: Int): String {
  if (xp < 0) {
    return '';
  }
  if (xp <= 0) {
    return stringOf(0);
  }
  return `${groupDigits(xp, ',')},000`;
}

export function pressSetupButton(save: Boolean): Int {
  if (save) {
    playSound(XpdropsSound.SELECT);
    return clientClock() + XpdropsLayout.flash;
  }
  selectSkillRow(-1);
  return -1;
}

export const tooltipControl = sessionState(-1);
export const tooltipLeft = sessionState(-1);
export const tooltipTop = sessionState(-1);

export function showControlTooltip(control: Int, left: Int, top: Int): void {
  const [, setControl] = useState(tooltipControl);
  const [, setLeft] = useState(tooltipLeft);
  const [, setTop] = useState(tooltipTop);
  if (enhancedAny()) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(XpdropsLayout.tooltipDwell)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  setControl(control);
  setLeft(left);
  setTop(top);
  tooltipRaise();
}

export function hideControlTooltip(): void {
  const [, setControl] = useState(tooltipControl);
  tooltipHide();
  setControl(-1);
}
