import { useRef, useServerState } from 'ts2';

import { closeInterface } from '../lib/lib.helpers';
import {
  GliderAnims,
  GliderArt,
  GliderColors,
  GliderFonts,
  GliderGates,
  GliderModels,
  Journey,
  MonkeyMadness2,
  OneSmallFavour,
} from './glidermap.constants';
import { flightPath, journeyFrom, journeyTo } from './glidermap.routes';

export function GliderMap(): Component {
  const journey = useServerState(Journey);
  const favour = useServerState(OneSmallFavour);
  const monkeyMadness = useServerState(MonkeyMadness2);

  const taQuirPriw = useRef();
  const sindarpos = useRef();
  const lemantoAndra = useRef();
  const karHewo = useRef();
  const gandius = useRef();
  const lemantollyUndri = useRef();
  const ookookollyUndri = useRef();

  const [px, py, pitch, yaw, zoom, anim, flying] = flightPath(journeyFrom(journey), journeyTo(journey));

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <model x="center" y={136} w={32} h={32} model={GliderModels.MAP} zoom={582} pitch={503} yaw={1} offsetX={3} />

      <model
        ref={taQuirPriw}
        x={73}
        y={51}
        w={32}
        h={32}
        model={GliderModels.TA_QUIR_PRIW}
        zoom={1061}
        pitch={539}
        yaw={2044}
      />
      <text
        x={43}
        y={118}
        w={140}
        h={17}
        text="Ta Quir Priw"
        font={GliderFonts.LABEL}
        color={GliderColors.LABEL}
        align="center"
      />
      <model
        x={48}
        y={32}
        w={118}
        h={106}
        zoom={400}
        options={['Ta Quir Priw']}
        onMouseEnter={() => {
          taQuirPriw.model = GliderModels.TA_QUIR_PRIW_HOVER;
        }}
        onMouseLeave={() => {
          taQuirPriw.model = GliderModels.TA_QUIR_PRIW;
        }}
      />

      <model
        ref={sindarpos}
        x={257}
        y={43}
        w={32}
        h={32}
        model={GliderModels.SINDARPOS}
        zoom={2073}
        pitch={424}
        yaw={8}
      />
      <text
        x={173}
        y={31}
        w={90}
        h={17}
        text="Sindarpos"
        font={GliderFonts.LABEL}
        color={GliderColors.LABEL}
        align="center"
      />
      <model
        x={183}
        y={29}
        w={141}
        h={58}
        zoom={400}
        options={['Sindarpos']}
        onMouseEnter={() => {
          sindarpos.model = GliderModels.SINDARPOS_HOVER;
        }}
        onMouseLeave={() => {
          sindarpos.model = GliderModels.SINDARPOS;
        }}
      />

      <model
        ref={lemantoAndra}
        x={393}
        y={34}
        w={32}
        h={32}
        model={GliderModels.LEMANTO_ANDRA}
        zoom={1438}
        pitch={506}
        yaw={2043}
      />
      <text x={374} y={89} w={103} h={17} text="Lemanto Andra" font={GliderFonts.LABEL} color={GliderColors.LABEL} />
      <model
        x={366}
        y={37}
        w={114}
        h={78}
        zoom={400}
        options={['Lemanto Andra']}
        onMouseEnter={() => {
          lemantoAndra.model = GliderModels.LEMANTO_ANDRA_HOVER;
        }}
        onMouseLeave={() => {
          lemantoAndra.model = GliderModels.LEMANTO_ANDRA;
        }}
      />

      <model ref={karHewo} x={429} y={149} w={32} h={32} model={GliderModels.KAR_HEWO} zoom={887} pitch={470} yaw={8} />
      <text
        x={335}
        y={137}
        w={95}
        h={17}
        text="Kar-Hewo"
        font={GliderFonts.LABEL}
        color={GliderColors.LABEL_KAR_HEWO}
        align="center"
      />
      <model
        x={348}
        y={137}
        w={137}
        h={62}
        zoom={400}
        options={['Kar-Hewo']}
        onMouseEnter={() => {
          karHewo.model = GliderModels.KAR_HEWO_HOVER;
        }}
        onMouseLeave={() => {
          karHewo.model = GliderModels.KAR_HEWO;
        }}
      />

      <model ref={gandius} x={226} y={224} w={32} h={32} model={GliderModels.GANDIUS} zoom={851} pitch={469} yaw={11} />
      <text
        x={199}
        y={282}
        w={83}
        h={17}
        text="Gandius"
        font={GliderFonts.LABEL}
        color={GliderColors.LABEL}
        align="center"
      />
      <model
        x={209}
        y={220}
        w={64}
        h={81}
        zoom={400}
        options={['Gandius']}
        onMouseEnter={() => {
          gandius.model = GliderModels.GANDIUS_HOVER;
        }}
        onMouseLeave={() => {
          gandius.model = GliderModels.GANDIUS;
        }}
      />

      {favour >= GliderGates.LEMANTOLLY_UNDRI && (
        <layer x="center" y="center" w="fill" h="fill">
          <model
            ref={lemantollyUndri}
            x={51}
            y={220}
            w={32}
            h={32}
            model={GliderModels.LEMANTOLLY_UNDRI}
            zoom={985}
            pitch={416}
            yaw={29}
          />
          <text
            x={19}
            y={174}
            w={100}
            h={17}
            text="Lemantolly"
            font={GliderFonts.LABEL}
            color={GliderColors.LABEL}
            align="center"
          />
          <text
            x={69}
            y={193}
            w={60}
            h={17}
            text="Undri"
            font={GliderFonts.LABEL}
            color={GliderColors.LABEL}
            align="center"
          />
          <model
            x={26}
            y={174}
            w={95}
            h={89}
            zoom={958}
            pitch={416}
            yaw={29}
            options={['Lemantolly Undri']}
            onMouseEnter={() => {
              lemantollyUndri.model = GliderModels.LEMANTOLLY_UNDRI_HOVER;
            }}
            onMouseLeave={() => {
              lemantollyUndri.model = GliderModels.LEMANTOLLY_UNDRI;
            }}
          />
        </layer>
      )}

      {monkeyMadness >= GliderGates.OOKOOKOLLY_UNDRI && (
        <layer x="center" y="center" w="fill" h="fill">
          <model
            ref={ookookollyUndri}
            x={124}
            y={263}
            w={32}
            h={32}
            model={GliderModels.OOKOOKOLLY_UNDRI}
            zoom={1250}
            pitch={513}
          />
          <text
            x={44}
            y={274}
            w={70}
            h={34}
            text="Ookookolly<br>Undri"
            font={GliderFonts.LABEL}
            color={GliderColors.LABEL}
            align="center"
          />
          <model
            x={32}
            y={263}
            w={127}
            h={66}
            zoom={958}
            pitch={416}
            yaw={29}
            options={['Ookookolly Undri']}
            onMouseEnter={() => {
              ookookollyUndri.model = GliderModels.OOKOOKOLLY_UNDRI_HOVER;
            }}
            onMouseLeave={() => {
              ookookollyUndri.model = GliderModels.OOKOOKOLLY_UNDRI;
            }}
          />
        </layer>
      )}

      {journey === GliderGates.NO_JOURNEY && (
        <sprite
          right={30}
          y={14}
          w={26}
          h={23}
          sprite={GliderArt.CLOSE}
          hover={{ sprite: GliderArt.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
        />
      )}

      {flying ? (
        <model x={px} y={py} w={32} h={32} model={GliderModels.PATH} pitch={pitch} yaw={yaw} zoom={zoom} anim={anim} />
      ) : (
        <model x="center" y="center" w={1} h={1} model={GliderModels.NO_PATH} zoom={100} />
      )}
    </layer>
  );
}
