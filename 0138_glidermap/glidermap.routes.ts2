import { GliderAnims } from './glidermap.constants';

export const routeKey = (from: Int, to: Int): Int => from * 8 + to;

export const flightPath = (from: Int, to: Int): [Int, Int, Int, Int, Int, Animation, Boolean] => {
  switch (routeKey(from, to)) {
    case 1:
      return [170, 150, 430, 306, 832, GliderAnims.LONG, true];
    case 2:
      return [272, 129, 425, 105, 689, GliderAnims.LONG, true];
    case 3:
      return [265, 82, 365, 2031, 689, GliderAnims.LONG, true];
    case 4:
      return [287, 78, 404, 2039, 689, GliderAnims.SHORT, true];
    case 5:
      return [60, 136, 293, 497, 689, GliderAnims.LONG, true];
    case 6:
      return [97, 174, 435, 364, 650, GliderAnims.LONG, true];
    case 7:
      return [154, 155, 512, 289, 880, GliderAnims.LONG, true];
    case 8:
      return [144, 127, 405, 1319, 832, GliderAnims.LONG, true];
    case 10:
      return [404, 134, 512, 1817, 720, GliderAnims.SHORT, true];
    case 11:
      return [359, 116, 410, 1700, 850, GliderAnims.LONG, true];
    case 12:
      return [267, 112, 378, 1518, 850, GliderAnims.LONG, true];
    case 13:
      return [43, 206, 512, 1037, 620, GliderAnims.SHORT, true];
    case 14:
      return [75, 305, 320, 903, 680, GliderAnims.LONG, true];
    case 16:
      return [225, 111, 375, 1126, 689, GliderAnims.LONG, true];
    case 17:
      return [239, 257, 512, 839, 680, GliderAnims.SHORT, true];
    case 19:
      return [419, 4, 512, 1582, 780, GliderAnims.SHORT, true];
    case 20:
      return [261, 13, 512, 1277, 680, GliderAnims.SHORT, true];
    case 21:
      return [176, 182, 512, 935, 680, GliderAnims.LONG, true];
    case 22:
      return [227, 258, 384, 807, 620, GliderAnims.LONG, true];
    case 32:
      return [86, 76, 494, 1015, 689, GliderAnims.SHORT, true];
    case 33:
      return [263, 152, 384, 518, 820, GliderAnims.LONG, true];
    case 34:
      return [397, 189, 512, 262, 620, GliderAnims.SHORT, true];
    case 35:
      return [415, 78, 512, 80, 800, GliderAnims.SHORT, true];
    case 37:
      return [134, 148, 512, 764, 720, GliderAnims.LONG, true];
    case 38:
      return [141, 228, 512, 668, 620, GliderAnims.LONG, true];
    case 40:
      return [107, 41, 506, 1584, 689, GliderAnims.SHORT, true];
    case 41:
      return [304, 253, 315, 0, 600, GliderAnims.SHORT, true];
    case 42:
      return [263, 188, 389, 1972, 700, GliderAnims.LONG, true];
    case 43:
      return [271, 125, 389, 1892, 650, GliderAnims.LONG, true];
    case 44:
      return [179, 117, 512, 1790, 750, GliderAnims.LONG, true];
    case 46:
      return [31, 378, 512, 583, 750, GliderAnims.SHORT, true];
    case 48:
      return [94, 153, 412, 1401, 650, GliderAnims.LONG, true];
    case 49:
      return [187, 313, 384, 1839, 710, GliderAnims.LONG, true];
    case 50:
      return [291, 229, 410, 1844, 690, GliderAnims.LONG, true];
    case 51:
      return [326, 170, 521, 1716, 610, GliderAnims.LONG, true];
    case 52:
      return [211, 155, 512, 1678, 640, GliderAnims.LONG, true];
    case 53:
      return [70, 192, 512, 1598, 640, GliderAnims.SHORT, true];
  }
  return [0, 0, 0, 0, 0, GliderAnims.LONG, false];
};

export const portIndex = (raw: Int): Int => {
  if (raw === 9) {
    return 0;
  }
  if (raw === 8) {
    return 6;
  }
  return raw;
};

export const journeyFrom = (journey: Int): Int => portIndex((journey as Coord).x);
export const journeyTo = (journey: Int): Int => portIndex((journey as Coord).z);
