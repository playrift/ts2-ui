import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BACKING_WASH, Gnomeball, GnomeballColor, GnomeballFonts, HEADING, Layout } from './gnomeball.constants';
import { gnomeballScore } from './gnomeball.helpers';

const timerHost1 = createRef('0139_gnomeball_timer_host1');

const timerHost2 = createRef('0139_gnomeball_timer_host2');

const content = createRef('gnomeball_content');

export function Gnomeball_(): Component {
  useInterval(() => overlayRelayout(timerHost1, content, Gnomeball.DODGE, Anchor.RIGHT, Anchor.TOP, 0), timerHost1);
  useInterval(() => gnomeballScore(timerHost2), timerHost2);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={content} x={{ right: Layout.PLATE_RIGHT }} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={GnomeballColor.BACKING}
            fill
            transparency={BACKING_WASH}
          />

          <text
            x="center"
            y={Layout.HEADING_Y}
            w="fill"
            h={Layout.HEADING_H}
            font={GnomeballFonts.HEADING}
            text={HEADING}
            align="center"
            valign="middle"
            lineHeight={Layout.HEADING_LINE}
            shadow
            color={GnomeballColor.HEADING}
          />

          <text
            x="center"
            y={{ bottom: Layout.SCORE_BOTTOM }}
            w="fill"
            h={Layout.SCORE_H}
            font={GnomeballFonts.SCORE}
            text=""
            align="center"
            shadow
            color={GnomeballColor.SCORE}
            ref={timerHost2}
          />
        </layer>
      </layer>
    </layer>
  );
}
