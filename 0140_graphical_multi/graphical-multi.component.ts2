import {
  MULTI_PICTURE_ZOOM,
  MULTI_TITLE,
  MultiArt,
  MultiColors,
  MultiFonts,
  MultiLayout,
} from './graphical-multi.constants';

function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function GraphicalMulti(): Component {
  return (
    <>
      <sprite
        x={MultiLayout.DECOR_LEFT.X}
        y={MultiLayout.DECOR_LEFT.Y}
        w={MultiLayout.DECOR_LEFT.W}
        h={MultiLayout.DECOR_LEFT.H}
        sprite={MultiArt.DECOR_LEFT}
      />

      <sprite
        x={MultiLayout.DECOR_RIGHT.X}
        y={MultiLayout.DECOR_RIGHT.Y}
        w={MultiLayout.DECOR_RIGHT.W}
        h={MultiLayout.DECOR_RIGHT.H}
        sprite={MultiArt.DECOR_RIGHT}
      />

      <text
        x={MultiLayout.CAPTION_A.X}
        y={MultiLayout.CAPTION_A.Y}
        w={MultiLayout.CAPTION_A.W}
        h={MultiLayout.CAPTION_A.H}
        font={MultiFonts.LABEL}
        align="center"
        valign="bottom"
        continueOp
        onMouseEnter={(event) => {
          textColourSwapper(event.component, MultiColors.CAPTION_HOVER);
        }}
        onMouseLeave={(event) => {
          textColourSwapper(event.component, MultiColors.CAPTION);
        }}
      />

      <text
        x={MultiLayout.CAPTION_B.X}
        y={MultiLayout.CAPTION_B.Y}
        w={MultiLayout.CAPTION_B.W}
        h={MultiLayout.CAPTION_B.H}
        font={MultiFonts.LABEL}
        align="center"
        valign="bottom"
        continueOp
        onMouseEnter={(event) => {
          textColourSwapper(event.component, MultiColors.CAPTION_HOVER);
        }}
        onMouseLeave={(event) => {
          textColourSwapper(event.component, MultiColors.CAPTION);
        }}
      />

      <text
        x={MultiLayout.TITLE.X}
        y={MultiLayout.TITLE.Y}
        w={MultiLayout.TITLE.W}
        h={MultiLayout.TITLE.H}
        text={MULTI_TITLE}
        font={MultiFonts.LABEL}
        color={MultiColors.TITLE}
        align="center"
      />

      <model
        x={MultiLayout.PICTURE_A.X}
        y={MultiLayout.PICTURE_A.Y}
        w={MultiLayout.PICTURE_A.W}
        h={MultiLayout.PICTURE_A.H}
        zoom={MULTI_PICTURE_ZOOM}
      />

      <model
        x={MultiLayout.PICTURE_B.X}
        y={MultiLayout.PICTURE_B.Y}
        w={MultiLayout.PICTURE_B.W}
        h={MultiLayout.PICTURE_B.H}
        zoom={MULTI_PICTURE_ZOOM}
      />
    </>
  );
}
