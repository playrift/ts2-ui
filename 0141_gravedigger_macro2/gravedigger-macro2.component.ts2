import { closeInterface } from '../lib/lib.helpers';
import {
  GRAVE_PANEL_TRANSPARENCY,
  GRAVE_SLOTS,
  GraveArt,
  GraveCamera,
  GraveColors,
  GraveLayout,
  GraveModels,
} from './gravedigger-macro2.constants';

export function GravediggerMacro2(): Component {
  return (
    <>
      <model
        x={GraveLayout.BACKGROUND.X}
        y={GraveLayout.BACKGROUND.Y}
        w={GraveLayout.BACKGROUND.SIZE}
        h={GraveLayout.BACKGROUND.SIZE}
        model={GraveModels.BACKGROUND}
        zoom={GraveCamera.BACKGROUND.ZOOM}
      />

      <model
        x={GraveLayout.FOREGROUND.X}
        y={GraveLayout.FOREGROUND.Y}
        w={GraveLayout.FOREGROUND.SIZE}
        h={GraveLayout.FOREGROUND.SIZE}
        model={GraveModels.FOREGROUND}
        zoom={GraveCamera.FOREGROUND.ZOOM}
        pitch={GraveCamera.FOREGROUND.PITCH}
        yaw={GraveCamera.FOREGROUND.YAW}
      />

      <rect
        x={GraveLayout.PANEL.X}
        y={GraveLayout.PANEL.Y}
        w={GraveLayout.PANEL.W}
        h={GraveLayout.PANEL.H}
        color={GraveColors.PANEL}
        fill
        transparency={GRAVE_PANEL_TRANSPARENCY}
      />

      {GRAVE_SLOTS.map((slot) => (
        <model x={slot.X} y={slot.Y} w={GraveLayout.SLOT.W} h={GraveLayout.SLOT.H} zoom={GraveCamera.SLOT_ZOOM} />
      ))}

      <sprite
        x={{ right: GraveLayout.CLOSE.RIGHT }}
        y={GraveLayout.CLOSE.Y}
        w={GraveLayout.CLOSE.W}
        h={GraveLayout.CLOSE.H}
        sprite={GraveArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />
    </>
  );
}
