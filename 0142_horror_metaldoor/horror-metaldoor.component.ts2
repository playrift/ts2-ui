import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { DoorArt, DoorColors, DoorModels, Layout } from './horror-metaldoor.constants';

export function HorrorMetalDoor(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={DoorColors.BACKDROP} />

      <model
        x="center"
        y="center"
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.DOOR}
        zoom={Layout.DOOR_ZOOM}
        yaw={Layout.DOOR_YAW}
        offsetY={Layout.DOOR_OFFSET_Y}
      />

      <model
        x={Layout.FIRE_X}
        y={Layout.FIRE_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.FIRE}
        zoom={Layout.FIRE_ZOOM}
        pitch={Layout.SEAL_PITCH}
      />

      <model
        x={Layout.AIR_X}
        y={Layout.AIR_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.AIR}
        zoom={Layout.AIR_ZOOM}
        pitch={Layout.SEAL_PITCH}
      />

      <model
        x={Layout.EARTH_X}
        y={Layout.EARTH_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.EARTH}
        zoom={Layout.EARTH_ZOOM}
        pitch={Layout.SEAL_PITCH}
      />

      <model
        x={Layout.WATER_X}
        y={Layout.WATER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.WATER}
        zoom={Layout.WATER_ZOOM}
        pitch={Layout.SEAL_PITCH}
      />

      <model
        x={Layout.RANGING_X}
        y={Layout.RANGING_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.RANGING}
        zoom={Layout.RANGING_ZOOM}
        pitch={Layout.RANGING_PITCH}
        yaw={Layout.RANGING_YAW}
      />

      <model
        x={Layout.MELEE_X}
        y={Layout.MELEE_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DoorModels.MELEE}
        zoom={Layout.MELEE_ZOOM}
        pitch={Layout.SEAL_PITCH}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={DoorArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, DoorArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, DoorArt.CLOSE)}
      />
    </>
  );
}
