import { MourningToad } from './mourning-toad.component';
import { graphicSwapper } from '../lib/lib.helpers';
import { CloseSprites, GunColor, GunFonts, GunModel, Layout } from './mourning-gun.constants';

export function MourningGun(): Component {
  return (
    <>
      <layer x="center" y={0} w="fill" h={Layout.BAND_H} noClickThrough>
        <rect x="center" y={0} w="fill" h={{ fill: Layout.BAR_INSET }} fill color={GunColor.LETTERBOX} />
      </layer>

      <layer x="center" y="bottom" w="fill" h={Layout.BAND_H} noClickThrough>
        <rect x="center" y="bottom" w="fill" h={{ fill: Layout.BAR_INSET }} fill color={GunColor.LETTERBOX} />
      </layer>

      <layer x={0} y="center" w={Layout.SIDE_W} h="fill" noClickThrough>
        <rect x={0} y="center" w={{ fill: Layout.SIDE_INSET }} h="fill" fill color={GunColor.LETTERBOX} />
      </layer>

      <layer x="right" y="center" w={Layout.SIDE_W} h="fill" noClickThrough>
        <rect x="right" y="center" w={{ fill: Layout.SIDE_INSET }} h="fill" fill color={GunColor.LETTERBOX} />
      </layer>

      <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.CROSSHAIR_X}
          y={Layout.CROSSHAIR_Y}
          w={Layout.CROSSHAIR_W}
          h={Layout.CROSSHAIR_H}
          model={GunModel.CROSSHAIR}
          zoom={Layout.CROSSHAIR_ZOOM}
          pitch={Layout.CROSSHAIR_PITCH}
          yaw={Layout.CROSSHAIR_YAW}
        />

        <text
          x={Layout.AIM_LEFT_X}
          y={Layout.AIM_LEFT_Y}
          w={Layout.AIM_LEFT_W}
          h={Layout.AIM_LEFT_H}
          font={GunFonts.LABEL}
          color={GunColor.LABEL}
          shadow
          options={['Aim left']}
        />
        <text
          x={Layout.AIM_RIGHT_X}
          y={Layout.AIM_RIGHT_Y}
          w={Layout.AIM_RIGHT_W}
          h={Layout.AIM_RIGHT_H}
          font={GunFonts.LABEL}
          color={GunColor.LABEL}
          shadow
          options={['Aim right']}
        />
        <text
          x={Layout.AIM_UP_X}
          y={Layout.AIM_UP_Y}
          w={Layout.AIM_UP_W}
          h={Layout.AIM_UP_H}
          font={GunFonts.LABEL}
          color={GunColor.LABEL}
          shadow
          options={['Aim up']}
        />
        <text
          x={Layout.AIM_DOWN_X}
          y={Layout.AIM_DOWN_Y}
          w={Layout.AIM_DOWN_W}
          h={Layout.AIM_DOWN_H}
          font={GunFonts.LABEL}
          color={GunColor.LABEL}
          shadow
          options={['Aim down']}
        />
        <text
          x={Layout.FIRE_X}
          y={Layout.FIRE_Y}
          w={Layout.FIRE_W}
          h={Layout.FIRE_H}
          font={GunFonts.LABEL}
          color={GunColor.LABEL}
          shadow
          options={['FIRE!']}
        />

        <rect
          x={Layout.PREVIEW_FRAME_X}
          y={Layout.PREVIEW_FRAME_Y}
          w={Layout.PREVIEW_FRAME_W}
          h={Layout.PREVIEW_FRAME_H}
          fill
          color={GunColor.PREVIEW_FRAME}
        />
        <rect
          x={Layout.PREVIEW_X}
          y={Layout.PREVIEW_Y}
          w={Layout.PREVIEW_W}
          h={Layout.PREVIEW_H}
          fill
          color={GunColor.PREVIEW_FIELD}
        />

        <MourningToad w="fill" h="fill" />

        <sprite
          x={Layout.CLOSE_X}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CloseSprites.REST}
          options={['Close']}
          onMouseEnter={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
          onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.REST)}
        />
      </layer>
    </>
  );
}
