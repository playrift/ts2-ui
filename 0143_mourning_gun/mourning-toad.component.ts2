import { useServerState, useState } from 'ts2';

import { GunModel, Layout, Spin } from './mourning-gun.constants';
import { Varbits } from '../lib/game/varbits';

export function toadModel(ammo: Int): Model {
  if (ammo === 1) {
    return GunModel.TOAD_1;
  }
  if (ammo === 2) {
    return GunModel.TOAD_2;
  }
  if (ammo === 3) {
    return GunModel.TOAD_3;
  }
  if (ammo === 4) {
    return GunModel.TOAD_4;
  }
  return GunModel.TOAD_NONE;
}

export function MourningToad(): Component {
  const ammo: Int = useServerState(Varbits.MOURNING_GUN_AMMO);
  const [yaw, setYaw] = useState(0);

  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.PREVIEW_X}
        y={Layout.PREVIEW_Y}
        w={Layout.PREVIEW_W}
        h={Layout.PREVIEW_H}
        model={toadModel(ammo)}
        zoom={Layout.PREVIEW_ZOOM}
        pitch={Layout.PREVIEW_PITCH}
        yaw={yaw}
        offsetY={Layout.PREVIEW_OFFSET_Y}
        onTimer={() => setYaw((yaw + Spin.STEP) % Spin.TURN)}
      />
    </layer>
  );
}
