import { useServerState } from 'ts2';

import { MineVarbits } from './hauntedmine-controls.constants';

export function anyCartMoving(): Int {
  if (useServerState(MineVarbits.ANIMATE_START) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_SUCCESS) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_38_42) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_38_44) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_37_47) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_39_50) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_35_59) === 1) {
    return 1;
  }
  if (useServerState(MineVarbits.ANIMATE_RETURNED) === 1) {
    return 1;
  }
  return 0;
}
