import { useServerState } from 'ts2';

import { Layout, MineAnims, MineModels, MineVarbits } from './hauntedmine-controls.constants';

export function MineCarts(): Component {
  const start: Int = useServerState(MineVarbits.ANIMATE_START);
  const success: Int = useServerState(MineVarbits.ANIMATE_SUCCESS);
  const leg3842: Int = useServerState(MineVarbits.ANIMATE_38_42);
  const leg3844: Int = useServerState(MineVarbits.ANIMATE_38_44);
  const leg3747: Int = useServerState(MineVarbits.ANIMATE_37_47);
  const leg3950: Int = useServerState(MineVarbits.ANIMATE_39_50);
  const leg3559: Int = useServerState(MineVarbits.ANIMATE_35_59);
  const returned: Int = useServerState(MineVarbits.ANIMATE_RETURNED);

  let moving: Int = 0;
  if (start === 1) {
    moving = 1;
  }
  if (success === 1) {
    moving = 1;
  }
  if (leg3842 === 1) {
    moving = 1;
  }
  if (leg3844 === 1) {
    moving = 1;
  }
  if (leg3747 === 1) {
    moving = 1;
  }
  if (leg3950 === 1) {
    moving = 1;
  }
  if (leg3559 === 1) {
    moving = 1;
  }
  if (returned === 1) {
    moving = 1;
  }

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <model
        x={9}
        y={132}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        hide={moving === 1 ? true : false}
      />
      <model
        x={9}
        y={132}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.TRAVEL}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        hide={start === 1 ? false : true}
      />
      <model
        x={331}
        y={80}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.RIGHT}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={1536}
        hide={success === 1 ? false : true}
      />
      <model
        x={143}
        y={223}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.RIGHT}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
        hide={leg3842 === 1 ? false : true}
      />
      <model
        x={165}
        y={218}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.RIGHT}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        hide={leg3844 === 1 ? false : true}
      />
      <model
        x={324}
        y={218}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.LEFT}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={1024}
        hide={leg3747 === 1 ? false : true}
      />
      <model
        x={330}
        y={223}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.LEFT}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
        hide={leg3950 === 1 ? false : true}
      />
      <model
        x={380}
        y={155}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.TRAVEL}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
        hide={leg3559 === 1 ? false : true}
      />
      <model
        x={47}
        y={132}
        w={Layout.TILE}
        h={Layout.TILE}
        model={MineModels.CART}
        anim={MineAnims.TRAVEL}
        zoom={Layout.CART_ZOOM}
        pitch={Layout.PITCH}
        yaw={1024}
        hide={returned === 1 ? false : true}
      />
    </layer>
  );
}
