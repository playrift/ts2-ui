import { useServerState } from 'ts2';

import { Layout, MineModels, MineVarbits } from './hauntedmine-controls.constants';

export function MineLevers(): Component {
  const leverA: Int = useServerState(MineVarbits.LEVER_A);
  const leverB: Int = useServerState(MineVarbits.LEVER_B);
  const leverC: Int = useServerState(MineVarbits.LEVER_C);
  const leverD: Int = useServerState(MineVarbits.LEVER_D);
  const leverE: Int = useServerState(MineVarbits.LEVER_E);
  const leverI: Int = useServerState(MineVarbits.LEVER_I);
  const leverJ: Int = useServerState(MineVarbits.LEVER_J);
  const leverK: Int = useServerState(MineVarbits.LEVER_K);

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <model
        x={110}
        y={149}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverB === 1 ? MineModels.LEVER_ON_A : MineModels.LEVER_OFF_A}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
      />
      <model
        x={92}
        y={150}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverA === 1 ? MineModels.LEVER_ON_A : MineModels.LEVER_OFF_A}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={1536}
      />
      <model
        x={212}
        y={218}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverC === 1 ? MineModels.LEVER_ON_B : MineModels.LEVER_OFF_B}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
      />
      <model
        x={211}
        y={98}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverD === 1 ? MineModels.LEVER_ON_A : MineModels.LEVER_OFF_A}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={1024}
      />
      <model
        x={211}
        y={149}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverE === 1 ? MineModels.LEVER_ON_A : MineModels.LEVER_OFF_A}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={512}
      />
      <model
        x={331}
        y={218}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverI === 1 ? MineModels.LEVER_ON_B : MineModels.LEVER_OFF_B}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
        yaw={1024}
      />
      <model
        x={331}
        y={115}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverJ === 1 ? MineModels.LEVER_ON_B : MineModels.LEVER_OFF_B}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
      />
      <model
        x={380}
        y={115}
        w={Layout.TILE}
        h={Layout.TILE}
        model={leverK === 1 ? MineModels.LEVER_ON_A : MineModels.LEVER_OFF_A}
        zoom={Layout.TRACK_ZOOM}
        pitch={Layout.PITCH}
      />
    </layer>
  );
}
