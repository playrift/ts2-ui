import { Layout, MineColors, MineModels } from './hauntedmine-controls.constants';

export function RouteLine(): Component {
  return <rect fill color={MineColors.ROUTE} />;
}

export function RouteNode(): Component {
  return (
    <model
      w={Layout.TILE}
      h={Layout.TILE}
      model={MineModels.ROUTE_NODE}
      zoom={Layout.TRACK_ZOOM}
      pitch={Layout.PITCH}
    />
  );
}
