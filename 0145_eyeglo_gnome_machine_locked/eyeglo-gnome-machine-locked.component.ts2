import { createRef, useWatch } from 'ts2';

import { setEygloHandModel, setEygloSelectedCoin } from '../0111_eyeglo_change_machine/eyeglo-machine.helpers';
import { EYEGLO_DIGIT_ZERO } from './eyeglo-digit-models.data';
import { unlockDial } from './unlock-dial.helpers';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { CloseSprites, DialModel, Layout, MachineColor, MachineModel } from './eyeglo-gnome-machine-locked.constants';

const backdrop = createRef();
const digitTens = createRef();
const digitUnits = createRef();
const markerTop = createRef();
const markerMiddle = createRef();
const markerBottom = createRef();
const hand = createRef();
const selectedCoin = createRef();
const unlockItem = createRef();

export function EygloGnomeMachineLocked(): Component {
  useWatch(
    [Varbits.EYEGLO_COIN_VALUE_1, Varbits.EYEGLO_UNLOCK_VAL, Varps.EYEGLO_UNLOCK_A],
    () => unlockDial(digitTens, digitUnits, markerTop, markerMiddle, markerBottom, unlockItem),
    backdrop,
  );

  useWatch(Varbits.EYEGLO_HAND, (event) => setEygloHandModel(event.component), hand);

  useWatch(Varps.EYEGLO_COIN_SELECTED, (event) => setEygloSelectedCoin(event.component), selectedCoin);

  return (
    <>
      <rect
        ref={backdrop}
        x={0}
        y={0}
        w={Layout.BACKDROP_W}
        h={Layout.BACKDROP_H}
        fill
        color={MachineColor.BACKDROP}
        onLoad={() => unlockDial(digitTens, digitUnits, markerTop, markerMiddle, markerBottom, unlockItem)}
      />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CRYSTAL}
        zoom={Layout.HEAD_ZOOM}
      />
      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CAGE}
        zoom={Layout.HEAD_ZOOM}
      />

      <model
        ref={digitTens}
        x={Layout.DIGIT_TENS_X}
        y={Layout.DIGIT_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={digitUnits}
        x={Layout.DIGIT_UNITS_X}
        y={Layout.DIGIT_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />

      <model
        ref={markerTop}
        x={Layout.MARKER_X}
        y={Layout.MARKER_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.TOP_HIGHER}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        ref={markerMiddle}
        x={Layout.MARKER_X}
        y={Layout.MARKER_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.NEEDLE}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        ref={markerBottom}
        x={Layout.MARKER_X}
        y={Layout.MARKER_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.BOTTOM_LOWER}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_BOTTOM_OFFSET_Y}
      />

      <rect
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.HITBOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
      />

      <model
        ref={hand}
        x={Layout.HAND_X}
        y={Layout.HAND_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HAND}
        zoom={Layout.HAND_ZOOM}
        pitch={Layout.HAND_PITCH}
        yaw={Layout.HAND_YAW}
        roll={Layout.HAND_ROLL}
        onLoad={(event) => setEygloHandModel(event.component)}
      />
      <model
        ref={selectedCoin}
        x={Layout.COIN_X}
        y={Layout.COIN_Y}
        w={Layout.COIN_W}
        h={Layout.COIN_H}
        zoom={Layout.COIN_ZOOM}
        pitch={Layout.COIN_PITCH}
        yaw={Layout.COIN_YAW}
      />

      <model
        x={Layout.HOPPER_X}
        y={Layout.HOPPER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HOPPER}
        zoom={Layout.HEAD_ZOOM}
      />

      <rect
        x={Layout.UNLOCK_BOX_X}
        y={Layout.UNLOCK_BOX_Y}
        w={Layout.UNLOCK_BOX_W}
        h={Layout.UNLOCK_BOX_H}
        transparency={Layout.INVISIBLE}
        options={['Unlock machine']}
      />

      <sprite
        x={{ right: Layout.CLOSE_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onDrag={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />

      <model
        x={Layout.UNLOCK_X}
        y={Layout.UNLOCK_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.UNLOCK_PLATE}
        zoom={Layout.UNLOCK_PLATE_ZOOM}
      />

      <model
        ref={unlockItem}
        x={Layout.UNLOCK_X}
        y={Layout.UNLOCK_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.UNLOCK_ITEM_ZOOM}
      />
    </>
  );
}
