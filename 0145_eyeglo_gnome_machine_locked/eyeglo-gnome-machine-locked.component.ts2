import { eygloHandModel, eygloSelectedCoin } from '../0111_eyeglo_change_machine/eyeglo-machine.helpers';
import { UnlockDigits, UnlockItem, UnlockMarkers } from './unlock-dial.component';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { CloseSprites, Layout, MachineColor, MachineModel } from './eyeglo-gnome-machine-locked.constants';

export function MachineHand(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.HAND_X}
        y={Layout.HAND_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={eygloHandModel()}
        zoom={Layout.HAND_ZOOM}
        pitch={Layout.HAND_PITCH}
        yaw={Layout.HAND_YAW}
        roll={Layout.HAND_ROLL}
      />
    </layer>
  );
}

export function MachineSelectedCoin(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.COIN_X}
        y={Layout.COIN_Y}
        w={Layout.COIN_W}
        h={Layout.COIN_H}
        item={eygloSelectedCoin()}
        itemCount={1}
        deferred
      />
    </layer>
  );
}

export function EygloGnomeMachineLocked(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} fill color={MachineColor.BACKDROP} />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CRYSTAL}
        zoom={Layout.HEAD_ZOOM}
      />
      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CAGE}
        zoom={Layout.HEAD_ZOOM}
      />

      <UnlockDigits w="fill" h="fill" />

      <UnlockMarkers w="fill" h="fill" />

      <rect
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.HITBOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
      />

      <MachineHand w="fill" h="fill" />
      <MachineSelectedCoin w="fill" h="fill" />

      <model
        x={Layout.HOPPER_X}
        y={Layout.HOPPER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HOPPER}
        zoom={Layout.HEAD_ZOOM}
      />

      <rect
        x={Layout.UNLOCK_BOX_X}
        y={Layout.UNLOCK_BOX_Y}
        w={Layout.UNLOCK_BOX_W}
        h={Layout.UNLOCK_BOX_H}
        transparency={Layout.INVISIBLE}
        options={['Unlock machine']}
      />

      <sprite
        x={{ right: Layout.CLOSE_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onDrag={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />

      <model
        x={Layout.UNLOCK_X}
        y={Layout.UNLOCK_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.UNLOCK_PLATE}
        zoom={Layout.UNLOCK_PLATE_ZOOM}
      />

      <UnlockItem w="fill" h="fill" />
    </>
  );
}
