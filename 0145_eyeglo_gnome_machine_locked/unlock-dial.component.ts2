import { useServerState } from 'ts2';

import { EYEGLO_DIGIT_ZERO, EyegloDigitModels } from './eyeglo-digit-models.data';
import { DialModel, Layout } from './eyeglo-gnome-machine-locked.constants';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

export function dialMarkers(value: Int, target: Int): [Model, Model, Model] {
  if (target === 0) {
    return [DialModel.NONE, DialModel.NEEDLE, DialModel.NONE];
  }
  if (target > value) {
    return [DialModel.TOP_HIGHER, DialModel.NEEDLE, DialModel.BOTTOM_HIGHER];
  }
  if (target < value) {
    return [DialModel.TOP_LOWER, DialModel.NEEDLE, DialModel.BOTTOM_LOWER];
  }
  return [DialModel.NONE, DialModel.NEEDLE_MATCH, DialModel.NONE];
}

export function UnlockDigits(): Component {
  const value: Int = useServerState(Varbits.EYEGLO_COIN_VALUE_1);

  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.DIGIT_TENS_X}
        y={Layout.DIGIT_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(value / 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        x={Layout.DIGIT_UNITS_X}
        y={Layout.DIGIT_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(value % 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
    </layer>
  );
}

export function UnlockMarkers(): Component {
  const value: Int = useServerState(Varbits.EYEGLO_COIN_VALUE_1);
  const target: Int = useServerState(Varbits.EYEGLO_UNLOCK_VAL);
  const [top, middle, bottom] = dialMarkers(value, target);

  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.MARKER_X}
        y={Layout.MARKER_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={top}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        x={Layout.MARKER_X}
        y={Layout.MARKER_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={middle}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        x={Layout.MARKER_X}
        y={Layout.MARKER_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={bottom}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_BOTTOM_OFFSET_Y}
      />
    </layer>
  );
}

export function UnlockItem(): Component {
  const unlockItem: Item = useServerState(Varps.EYEGLO_UNLOCK_A) as Item;

  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.UNLOCK_X}
        y={Layout.UNLOCK_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={unlockItem}
        itemCount={1}
        itemCountMode="never"
      />
    </layer>
  );
}
