import { FlashbackTint } from './ics-flashback.constants';

export function IcsFlashback(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={FlashbackTint.COLOR}
        fill={true}
        transparency={FlashbackTint.TRANSPARENCY}
      />
    </layer>
  );
}
