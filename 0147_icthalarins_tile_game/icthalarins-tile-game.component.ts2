import { Camera, Layout, TileGameArt, TileGameColors, TileGameModel, Tiles } from './icthalarins-tile-game.constants';

export function IcthalarinsTileGame(): Component {
  return (
    <>
      <rect
        x={Layout.BEZEL_X}
        y={Layout.BEZEL_Y}
        w={Layout.BEZEL_W}
        h={Layout.BEZEL_H}
        fill
        color={TileGameColors.BEZEL}
      />

      <rect
        x={Layout.FIELD_X}
        y={Layout.FIELD_Y}
        w={Layout.FIELD_W}
        h={Layout.FIELD_H}
        fill
        color={TileGameColors.FIELD}
      />

      <rect
        x={Layout.SIDE_X}
        y={Layout.SIDE_Y}
        w={Layout.SIDE_W}
        h={Layout.SIDE_H}
        fill
        color={TileGameColors.SIDE_PANEL}
      />

      <model
        x={Layout.BOARD_X}
        y={Layout.BOARD_Y}
        w={Layout.BOARD_W}
        h={Layout.BOARD_H}
        model={TileGameModel.BOARD}
        zoom={Camera.BOARD.ZOOM}
      />

      {Tiles.map((tile) => (
        <model x={tile.x} y={tile.y} w={tile.w} h={tile.h} model={tile.model} zoom={Camera.TILE.ZOOM} />
      ))}

      <model
        x={Layout.PICTURE_X}
        y={Layout.PICTURE_Y}
        w={Layout.PICTURE_W}
        h={Layout.PICTURE_H}
        model={TileGameModel.PICTURE}
        zoom={Camera.PICTURE.ZOOM}
        pitch={Camera.PICTURE.PITCH}
        yaw={Camera.PICTURE.YAW}
      />

      <model
        x={Layout.COUNTER_X}
        y={Layout.COUNTER_Y}
        w={Layout.COUNTER_W}
        h={Layout.COUNTER_H}
        model={TileGameModel.COUNTER}
        zoom={Camera.COUNTER.ZOOM}
        pitch={Camera.COUNTER.PITCH}
        yaw={Camera.COUNTER.YAW}
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={TileGameArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={TileGameArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
