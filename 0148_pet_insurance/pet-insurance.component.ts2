        />
        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_LINE_2_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_LINE_H}
          text={Copy.INFO_2}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
          shadow
        />
        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_LINE_3_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_LINE_H}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
          shadow
          hide
