import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { ConfirmButton } from './confirm-button.component';
import { Copy, Layout, PetArt, PetColor, PetFonts, PetWash } from './pet-insurance.constants';
import { PetsMessage, PetsSection } from './pets-section.component';
import { RefundButton } from './refund-button.component';
import { TokenReadout } from './token-readout.component';

export function PetInsurance(): Component {
  return (
    <>
      <layer x={0} y={0} w={Layout.FRAME_W} h={Layout.FRAME_H}>
        <SteelBorderEntrypoint title={Copy.TITLE} />
      </layer>

      <layer x={Layout.PETS_MAIN_X} y={Layout.PETS_MAIN_Y} w={Layout.PETS_MAIN_W} h={Layout.PETS_MAIN_H}>
        <sprite
          x={Layout.COM3_X}
          y={Layout.COM3_Y}
          w={Layout.COM3_W}
          h={Layout.COM3_H}
          sprite={PetArt.BACKING}
          tiling
          outline={1}
          hflip
          hide
        />

        <layer
          x={Layout.PETS_CONTAINER_X}
          y={Layout.PETS_CONTAINER_Y}
          w={Layout.PETS_CONTAINER_W}
          h={Layout.PETS_CONTAINER_H}
        >
          <text
            x={0}
            y={0}
            w={Layout.PETS_LABEL_W}
            h={Layout.PETS_LABEL_H}
            text={Copy.PETS_LABEL}
            font={PetFonts.BOLD}
            color={PetColor.ACCENT}
            align="center"
            valign="middle"
            shadow
            hide
          />

          <PetsMessage x={Layout.PETS_MESSAGE_X} y={0} w={Layout.PETS_MESSAGE_W} h={Layout.PETS_MESSAGE_H} />

          <sprite x={0} y={0} w={Layout.COM7_W} h={Layout.COM7_H} sprite={PetArt.BACKING} tiling hide />

          <rect x={0} y={0} w={Layout.DEAD_OUTER_W} h={Layout.DEAD_HIDDEN_RECT_H} color={PetColor.PANE_OUTER} hide />
          <rect
            x={Layout.DEAD_INNER_X}
            y={Layout.DEAD_INNER_Y}
            w={Layout.DEAD_INNER_W}
            h={Layout.DEAD_HIDDEN_INNER_H}
            color={PetColor.ACCENT}
            transparency={PetWash.PANE_INNER}
            hide
          />
          <text
            x={Layout.DEAD_TITLE_X}
            y={Layout.DEAD_TITLE_Y}
            w={Layout.DEAD_TITLE_W}
            h={Layout.DEAD_TITLE_H}
            text={Copy.DEAD_TITLE}
            font={PetFonts.BODY}
            color={PetColor.ACCENT}
            valign="middle"
            shadow
            hide
          />

          <PetsSection />
        </layer>

        <SteelFrameEntrypoint />
      </layer>

      <layer x={Layout.DEAD_X} y={Layout.DEAD_Y} w={Layout.DEAD_W} h={Layout.DEAD_H} hide>
        <sprite x={0} y={0} w={Layout.DEAD_OUTER_W} h={Layout.DEAD_OUTER_H} sprite={PetArt.BACKING} tiling />
        <rect x={0} y={0} w={Layout.DEAD_OUTER_W} h={Layout.DEAD_SHOWN_RECT_H} color={PetColor.PANE_OUTER} />
        <rect
          x={Layout.DEAD_INNER_X}
          y={Layout.DEAD_INNER_Y}
          w={Layout.DEAD_INNER_W}
          h={Layout.DEAD_SHOWN_INNER_H}
          color={PetColor.ACCENT}
          transparency={PetWash.PANE_INNER}
        />
        <text
          x={Layout.DEAD_TITLE_X}
          y={Layout.DEAD_TITLE_Y}
          w={Layout.DEAD_TITLE_W}
          h={Layout.DEAD_TITLE_H}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          valign="middle"
          shadow
        />
        <layer x={Layout.DEAD_PANE_X} y={Layout.DEAD_PANE_Y} w={Layout.DEAD_PANE_W} h={Layout.DEAD_PANE_H} />
        <layer x={Layout.DEAD_BAR_X} y={Layout.DEAD_PANE_Y} w={Layout.DEAD_BAR_W} h={Layout.DEAD_PANE_H} />
      </layer>

      <layer x={Layout.INFO_X} y={Layout.INFO_Y} w={Layout.INFO_W} h={Layout.INFO_H}>
        <sprite x={0} y={0} w={Layout.INFO_W} h={Layout.INFO_BACKING_H} sprite={PetArt.BACKING} tiling hflip />
        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_LINE_1_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_LINE_H}
          text={Copy.INFO_1}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
