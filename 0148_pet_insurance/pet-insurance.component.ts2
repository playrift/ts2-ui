        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_LINE_4_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_LINE_H}
          text={Copy.INFO_4}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
          shadow
        />
        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_LINE_5_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_LINE_H}
          text={Copy.INFO_5}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
          shadow
        />
        <text
          x={Layout.INFO_LINE_X}
          y={Layout.INFO_BOTTOM_Y}
          w={Layout.INFO_LINE_W}
          h={Layout.INFO_BOTTOM_H}
          font={PetFonts.BODY}
          color={PetColor.ACCENT}
          align="center"
          shadow
          hide
        />
        <SteelFrameEntrypoint />
      </layer>

      <layer x={Layout.TOKENS_X} y={Layout.TOKENS_Y} w={Layout.TOKENS_W} h={Layout.TOKENS_H}>
        <sprite x={0} y={0} w={Layout.TOKENS_W} h={Layout.TOKENS_BACKING_H} sprite={PetArt.BACKING} tiling hflip hide />

        <layer x={0} y={0} w={Layout.TOKENS_TEXT_W} h={Layout.TOKENS_TEXT_H}>
          <text
            x={0}
            y={0}
            w={Layout.TOKENS_TEXT_W}
            h={Layout.TOKENS_LABEL_H}
