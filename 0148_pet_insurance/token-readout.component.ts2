import { useServerState } from 'ts2';
import { PetColor, PetFonts, PetVars } from './pet-insurance.constants';
import { tokenText } from './pet-insurance.helpers';

export function TokenReadout(): Component {
  const processed: Int = useServerState(PetVars.CREDITS_PROCESSED);
  const discounted: Int = useServerState(PetVars.DISCOUNTED);

  return (
    <text
      x={0}
      y={0}
      w="fill"
      h="fill"
      text={tokenText(processed, discounted)}
      font={PetFonts.BOLD}
      color={processed === 0 && discounted === 0 ? PetColor.DIM : PetColor.WHITE}
      align="center"
      valign="middle"
      shadow
    />
  );
}
