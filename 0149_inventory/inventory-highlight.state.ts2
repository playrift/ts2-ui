import { CS2, sessionState, useState } from 'ts2';

import { debugWarn } from '../0922_jigsaw/jigsaw.state';
import { clientClock } from '../lib/lib.engine';

export const highlightItem0 = sessionState(-1);
export const highlightItem1 = sessionState(-1);
export const highlightItem2 = sessionState(-1);
export const highlightItem3 = sessionState(-1);
export const highlightItem4 = sessionState(-1);
export const highlightStyle0 = sessionState(-1);
export const highlightStyle1 = sessionState(-1);
export const highlightStyle2 = sessionState(-1);
export const highlightStyle3 = sessionState(-1);
export const highlightStyle4 = sessionState(-1);
export const highlightDuration0 = sessionState(-1);
export const highlightDuration1 = sessionState(-1);
export const highlightDuration2 = sessionState(-1);
export const highlightDuration3 = sessionState(-1);
export const highlightDuration4 = sessionState(-1);
export const highlightSince0 = sessionState(-1);
export const highlightSince1 = sessionState(-1);
export const highlightSince2 = sessionState(-1);
export const highlightSince3 = sessionState(-1);
export const highlightSince4 = sessionState(-1);

export function trackedItem(slot: Int): Item {
  const [i0] = useState(highlightItem0);
  const [i1] = useState(highlightItem1);
  const [i2] = useState(highlightItem2);
  const [i3] = useState(highlightItem3);
  const [i4] = useState(highlightItem4);
  if (slot === 0) {
    return i0 as Item;
  }
  if (slot === 1) {
    return i1 as Item;
  }
  if (slot === 2) {
    return i2 as Item;
  }
  if (slot === 3) {
    return i3 as Item;
  }
  if (slot === 4) {
    return i4 as Item;
  }
  return -1;
}

export function highlightItem(item: Item, style: Int, duration: Int): void {
  if (item === -1) {
    return;
  }
  let slot: Int = -1;
  let n: Int = 0;
  while (n < 5 && slot === -1) {
    if (trackedItem(n) === item) {
      slot = n;
    }
    n = n + 1;
  }
  n = 0;
  while (n < 5 && slot === -1) {
    if (trackedItem(n) === -1) {
      slot = n;
    }
    n = n + 1;
  }
  if (slot === -1) {
    debugWarn(
      'IH',
      'Max number of items already highlighted. Consider adding more vars or disabling other highlights.',
    );
    return;
  }
  setTracked(slot, item, style, duration);
}

function setTracked(slot: Int, item: Item, style: Int, duration: Int): void {
  const now: Int = clientClock();
  if (slot === 0) {
    const [, si] = useState(highlightItem0);
    const [, ss] = useState(highlightStyle0);
    const [, sd] = useState(highlightDuration0);
    const [, st] = useState(highlightSince0);
    si(item as Int);
    ss(style);
    sd(duration);
    st(now);
  } else if (slot === 1) {
    const [, si] = useState(highlightItem1);
    const [, ss] = useState(highlightStyle1);
    const [, sd] = useState(highlightDuration1);
    const [, st] = useState(highlightSince1);
    si(item as Int);
    ss(style);
    sd(duration);
    st(now);
  } else if (slot === 2) {
    const [, si] = useState(highlightItem2);
    const [, ss] = useState(highlightStyle2);
    const [, sd] = useState(highlightDuration2);
    const [, st] = useState(highlightSince2);
    si(item as Int);
    ss(style);
    sd(duration);
    st(now);
  } else if (slot === 3) {
    const [, si] = useState(highlightItem3);
    const [, ss] = useState(highlightStyle3);
    const [, sd] = useState(highlightDuration3);
    const [, st] = useState(highlightSince3);
    si(item as Int);
    ss(style);
    sd(duration);
    st(now);
  } else if (slot === 4) {
    const [, si] = useState(highlightItem4);
    const [, ss] = useState(highlightStyle4);
    const [, sd] = useState(highlightDuration4);
    const [, st] = useState(highlightSince4);
    si(item as Int);
    ss(style);
    sd(duration);
    st(now);
  }
}

export function highlightExpired(since: Int, duration: Int): Int {
  if (duration <= 0) {
    return 0;
  }
  if (clientClock() >= since + duration) {
    return 1;
  }
  return 0;
}

export function pulseTransparency(a: Int, b: Int, step: Int): Int {
  const phase: Int = clientClock() % step;
  if ((clientClock() / step) % 2 === 0) {
    return CS2.interpolate(a, b, 0, step - 1, phase);
  }
  return CS2.interpolate(0, a, 0, step - 1, phase);
}
