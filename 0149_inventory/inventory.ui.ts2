import { createRef } from 'ts2';
import { Inventory } from './inventory.component';
import { InventoryLayout } from './inventory.constants';

export const inventoryRef = createRef('inventory');

export const inventoryUi = (): UI => (
  <ui ref={inventoryRef} x="center" y="center" w={InventoryLayout.ROOT_W} h={InventoryLayout.ROOT_H}>
    <Inventory />
  </ui>
);
