import { createRef } from 'ts2';
import { Fonts } from '../lib/game/fonts';

const mourningGunSide = createRef('mourning_gun_side');

export function MourningGunSide(): Component {
  return <text x="center" y="center" w="fill" h="fill" text="" font={Fonts.Q8_FULL} align="center" valign="middle" />;
}

export const mourningGunSideUi = (): UI => (
  <ui ref={mourningGunSide}>
    <MourningGunSide />
  </ui>
);
