import { Layout, ScrollColors, ScrollFonts } from './questscroll.constants';
import { questPointsLabel } from './questscroll.helpers';

export function QuestPointsLine(): Component {
  return (
    <text
      x="center"
      y={Layout.POINTS.y}
      w={Layout.POINTS.w}
      h={Layout.POINTS.h}
      text={questPointsLabel()}
      font={ScrollFonts.BODY}
      color={ScrollColors.HEADING}
      align="center"
    />
  );
}
