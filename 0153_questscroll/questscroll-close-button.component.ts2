import { useRef } from 'ts2';
import { closeInterface, graphicSwapper, onMobile } from '../lib/lib.helpers';
import { CloseBox, CloseSprites } from './questscroll.constants';

export function QuestScrollCloseButton(): Component {
  if (onMobile()) {
    return (
      <layer
        right={CloseBox.MOBILE.right}
        y={CloseBox.MOBILE.y}
        w={CloseBox.MOBILE.w}
        h={CloseBox.MOBILE.h}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite x="center" y="center" w={CloseBox.FACE_W} h={CloseBox.FACE_H} sprite={CloseSprites.REST} />
      </layer>
    );
  }

  const face = useRef();
  return (
    <layer
      right={CloseBox.DESKTOP.right}
      y={CloseBox.DESKTOP.y}
      w={CloseBox.DESKTOP.w}
      h={CloseBox.DESKTOP.h}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={() => graphicSwapper(face, CloseSprites.HOVER)}
      onMouseLeave={() => graphicSwapper(face, CloseSprites.REST)}
    >
      <sprite ref={face} x="center" y="center" w={CloseBox.FACE_W} h={CloseBox.FACE_H} sprite={CloseSprites.REST} />
    </layer>
  );
}
