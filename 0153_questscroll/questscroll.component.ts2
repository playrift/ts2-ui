import { CloseBox, Layout, RewardLines, ScrollColors, ScrollFonts, ScrollModels } from './questscroll.constants';
import { QuestPointsLine } from './quest-points-line.component';
import { QuestScrollCloseButton } from './questscroll-close-button.component';

export function QuestScroll(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <model
          x="center"
          y={{ center: -ScrollModels.BANNER.up }}
          w={ScrollModels.BANNER.w}
          h={ScrollModels.BANNER.h}
          model={ScrollModels.BANNER.model}
          zoom={ScrollModels.BANNER.zoom}
          pitch={ScrollModels.BANNER.pitch}
          yaw={ScrollModels.BANNER.yaw}
        />

        <text
          x="center"
          y={Layout.TITLE.y}
          w={Layout.TITLE.w}
          h={Layout.TITLE.h}
          text="Congratulations!"
          font={ScrollFonts.TITLE}
          color={ScrollColors.HEADING}
          align="center"
        />
        <text
          x="center"
          y={Layout.SUBTITLE.y}
          w={Layout.SUBTITLE.w}
          h={Layout.SUBTITLE.h}
          text="You have completed a quest!"
          font={ScrollFonts.BODY}
          color={ScrollColors.BODY}
          align="center"
        />

        <model
          x={ScrollModels.REWARD.x}
          y={ScrollModels.REWARD.y}
          w={ScrollModels.REWARD.w}
          h={ScrollModels.REWARD.h}
          zoom={ScrollModels.REWARD.zoom}
        />

        <QuestPointsLine />

        <model
          right={ScrollModels.CORNER.right}
          y={ScrollModels.CORNER.y}
          w={ScrollModels.CORNER.w}
          h={ScrollModels.CORNER.h}
          model={ScrollModels.CORNER.model}
          zoom={ScrollModels.CORNER.zoom}
          pitch={ScrollModels.CORNER.pitch}
        />

        <text
          x="center"
          y={Layout.AWARDED.y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text="You are awarded:"
          font={ScrollFonts.BODY}
          color={ScrollColors.HEADING}
          align="center"
        />

        {RewardLines.map((line) => (
          <text
            x="center"
            y={line.y}
            w={Layout.LINE_W}
            h={Layout.LINE_H}
            text={line.text}
            font={ScrollFonts.BODY}
            color={ScrollColors.BODY}
            align="center"
          />
        ))}

        <QuestScrollCloseButton />
      </layer>
    </layer>
  );
}
