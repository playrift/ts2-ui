import { useServerState } from 'ts2';
import { hasBit } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { Varps } from '../lib/game/varps';
import { QuestScrollVarps, SPEEDRUN_POINT_CAP } from './questscroll.constants';

export function speedrunningWorld(): Boolean {
  return hasBit(useServerState(Varps.MAP_FLAGS_CACHED), 8);
}

export function questPointsLabel(): String {
  const questPoints: String = groupDigits(useServerState(QuestScrollVarps.QUEST_POINTS), ',');

  if (speedrunningWorld()) {
    const speedrunPoints: String = groupDigits(
      Math.min(useServerState(QuestScrollVarps.SPEEDRUN_POINTS), SPEEDRUN_POINT_CAP),
      ',',
    );
    return `Speedrun Points: ${speedrunPoints}`;
  }
  return `Total Quest Points: ${questPoints}`;
}
