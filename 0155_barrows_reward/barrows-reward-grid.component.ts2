import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { BarrowsLoot, Colors, Grid } from './barrows-reward.constants';

export function BarrowsRewardGrid(): Component {
  const rewards = useInventory(BarrowsLoot.INV);

  return (
    <layer w="fill" h="fill">
      {rewards.map(
        (item, slot) =>
          item !== -1 && (
            <sprite
              x={
                slot / Grid.COLUMNS < Grid.MIRROR_FROM_ROW
                  ? slot % Grid.COLUMNS === 0
                    ? 'left'
                    : slot % Grid.COLUMNS === 1
                      ? 'center'
                      : 'right'
                  : slot % Grid.COLUMNS === 0
                    ? 'right'
                    : slot % Grid.COLUMNS === 1
                      ? 'center'
                      : 'left'
              }
              y={(slot / Grid.COLUMNS) * Grid.ROW_PITCH}
              w={Grid.SLOT_WIDTH}
              h={Grid.SLOT_HEIGHT}
              item={item}
              itemCount={rewards.count(slot)}
              outline={1}
              shadowColor={Colors.SLOT_SHADOW}
              options={['', '', '', '', '', '', '', '', '', 'Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
            />
          ),
      )}
    </layer>
  );
}
