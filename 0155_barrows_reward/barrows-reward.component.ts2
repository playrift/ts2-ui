import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { BarrowsModel, Grid } from './barrows-reward.constants';
import { BarrowsRewardGrid } from './barrows-reward-grid.component';

export function BarrowsReward(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Barrows chest" />

      <model
        x={0}
        y={{ bottom: 10 }}
        w="fill"
        h="fill"
        model={BarrowsModel.CHEST}
        zoom={BarrowsModel.ZOOM}
        pitch={BarrowsModel.PITCH}
        yaw={BarrowsModel.YAW}
        offsetX={BarrowsModel.OFFSET_X}
        offsetY={BarrowsModel.OFFSET_Y}
      />

      <BarrowsRewardGrid
        x={{ right: Grid.BOX_INSET_X }}
        y={{ bottom: Grid.BOX_INSET_Y }}
        w={Grid.BOX_WIDTH}
        h={{ fill: Grid.BOX_HEIGHT_INSET }}
      />
    </>
  );
}
