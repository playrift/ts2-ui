import { useState } from 'ts2';

import { bugreportDesc } from '../lib/game/varcs';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { BugreportButton } from './bugreport-button.component';
import { DescriptionPane, NewsPane, ReproductionPane } from './bugreport-pane.component';
import {
  BOX_BACKING_TRANSPARENCY,
  BugreportColour,
  BugreportFonts,
  BugreportInput,
  FORM_PAGE,
  FORM_TEXT,
  INTRO_PAGE,
  INTRO_TEXT,
  Layout,
  REPRO_PAGE,
  REPRO_TEXT,
  STONE_TILE,
  SUPPORT_LABEL,
  SUPPORT_URL,
  TITLE,
} from './bugreport.constants';
import {
  bugreportBack,
  bugreportContinue,
  bugreportHome,
  bugreportInit,
  bugreportNext,
  bugreportSubmit,
  bugreportTextinput,
} from './bugreport.state';
import { StonebuttonUrl } from './stonebutton-url.component';

export function Bugreport(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={TITLE} />
      <layer
        x="center"
        y={{ bottom: Layout.BODY_BOTTOM }}
        w={{ fill: Layout.BODY_INSET_W }}
        h={{ fill: Layout.BODY_INSET_H }}
        onLoad={() => bugreportInit()}
      >
        <layer ref={INTRO_PAGE} x="center" y={0} w="fill" h="fill">
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.INTRO_H}
            text={INTRO_TEXT}
            font={BugreportFonts.BODY}
            shadow
            color={BugreportColour.AMBER}
          />
          <StonebuttonUrl label={SUPPORT_LABEL} url={SUPPORT_URL} />
          <layer x="center" y={Layout.NEWS_Y} w="fill" h={{ fill: Layout.NEWS_INSET_H }}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={STONE_TILE}
              tiling
              transparency={BOX_BACKING_TRANSPARENCY}
            />
            <NewsPane />
            <ThinBoxEntrypoint />
          </layer>
          <layer x="center" y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H} onClick={() => bugreportContinue()}>
            <BugreportButton label="Continue" />
          </layer>
        </layer>

        <layer ref={FORM_PAGE} x="center" y="center" w="fill" h="fill" hide>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.FORM_PROMPT_H}
            text={FORM_TEXT}
            font={BugreportFonts.BODY}
            shadow
            color={BugreportColour.AMBER}
          />
          <layer
            x="center"
            y={Layout.FORM_BOX_Y}
            w="fill"
            h={{ fill: Layout.FORM_BOX_INSET_H }}
            onClick={() => bugreportTextinput(BugreportInput.DESCRIPTION)}
          >
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={STONE_TILE}
              tiling
              transparency={BOX_BACKING_TRANSPARENCY}
            />
            <DescriptionPane />
            <ThinBoxEntrypoint />
          </layer>
          <layer
            x={Layout.BUTTON_SIDE}
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            options={['Back']}
            onClick={() => bugreportHome()}
          >
            <BugreportButton label="Back" />
          </layer>
          <layer
            x={{ right: Layout.BUTTON_SIDE }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            onClick={() => bugreportNext()}
          >
            <BugreportButton label="Next" />
          </layer>
        </layer>

        <layer ref={REPRO_PAGE} x="center" y="center" w="fill" h="fill" hide>
          <text
            x={0}
            y={0}
            w="fill"
            h={Layout.REPRO_PROMPT_H}
            text={REPRO_TEXT}
            font={BugreportFonts.BODY}
            shadow
            color={BugreportColour.AMBER}
          />
          <layer
            x="center"
            y={Layout.REPRO_BOX_Y}
            w="fill"
            h={{ fill: Layout.REPRO_BOX_INSET_H }}
            onClick={() => bugreportTextinput(BugreportInput.REPRODUCTION)}
          >
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={STONE_TILE}
              tiling
              transparency={BOX_BACKING_TRANSPARENCY}
            />
            <ReproductionPane />
            <ThinBoxEntrypoint />
          </layer>
          <SubmitButton />
          <layer
            x={Layout.BUTTON_SIDE}
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            onClick={() => bugreportBack()}
          >
            <BugreportButton label="Back" />
          </layer>
        </layer>
      </layer>
    </>
  );
}

function SubmitButton(): Component {
  const [desc] = useState(bugreportDesc);
  const typed: Boolean = desc.length > 0;
  return (
    <layer
      x={{ right: Layout.BUTTON_SIDE }}
      y="bottom"
      w={Layout.BUTTON_W}
      h={Layout.BUTTON_H}
      options={typed ? ['Submit'] : []}
      onOptionSelect={typed ? () => bugreportSubmit() : null}
      onClick={typed ? null : () => bugreportSubmit()}
    >
      <BugreportButton label="Submit" />
    </layer>
  );
}
