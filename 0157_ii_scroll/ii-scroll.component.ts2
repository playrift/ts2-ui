import { createRef, onMounted, onUpdated, useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import {
  CountSlots,
  IiScrollDodge,
  IiScrollFonts,
  ImplingColor,
  Layout,
  LeftIcons,
  LuckyImpling,
  RightIcons,
} from './ii-scroll.constants';
import { implingColour } from './ii-scroll.helpers';

const dodger = createRef('ii_scroll_dodger');

const content = createRef('ii_scroll_content');

export function IiScroll(): Component {
  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={dodger} onLoad={() => loadDodger()}>
        <layer static ref={content} x="right" y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <rect
            x="right"
            y={Layout.PLATE_Y}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            color={ImplingColor.PLATE}
            fill
            transparency={Layout.PLATE_WASH}
          />

          {LeftIcons.map((icon) => (
            <sprite
              x={{ right: Layout.LEFT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          {RightIcons.map((icon) => (
            <sprite
              x={{ right: Layout.RIGHT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          <sprite
            x={{ right: Layout.LEFT_ICON_RIGHT }}
            y={LuckyImpling.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={LuckyImpling.SPRITE}
          />

          <ImplingCounts />
        </layer>
      </layer>
    </layer>
  );
}

function ImplingCounts(): Component {
  const backpack = useInventory(Inventories.INV);
  const mobile: Boolean = onMobile();
  onMounted(() => anchorContent(mobile));
  onUpdated(() => anchorContent(mobile));

  return (
    <layer x={0} y={0} w="fill" h="fill">
      {CountSlots.map((slot) => (
        <text
          x={{ right: slot.right }}
          y={slot.y}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={IiScrollFonts.COUNT}
          shadow
          color={implingColour(backpack.total(slot.jar))}
          text={stringOf(backpack.total(slot.jar))}
        />
      ))}
    </layer>
  );
}

function anchorContent(mobile: Boolean): void {
  if (mobile) {
    content.props = { x: 'right', y: 'bottom' };
  } else {
    content.props = { x: 'right', y: 0 };
  }
}

function loadDodger(): void {
  let vAnchor: Int = Anchor.TOP;
  if (onMobile()) {
    vAnchor = Anchor.BOTTOM;
  }
  overlayInit(dodger, content, IiScrollDodge.DODGE, Anchor.RIGHT, vAnchor, 0);
}
