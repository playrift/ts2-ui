import { createRef, useInterval, useWatch } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import {
  CountRow,
  IiScrollFonts,
  ImplingColor,
  Jar,
  Layout,
  LeftIcons,
  LuckyImpling,
  RightIcons,
} from './ii-scroll.constants';
import { iiScrollInit, implingCount } from './ii-scroll.helpers';

const dodger = createRef('ii_scroll_dodger');

const count1 = createRef('ii_scroll:ii_captured_impling_1');
const count2 = createRef('ii_scroll:ii_captured_impling_2');
const count3 = createRef('ii_scroll:ii_captured_impling_3');
const count4 = createRef('ii_scroll:ii_captured_impling_4');
const count5 = createRef('ii_scroll:ii_captured_impling_5');
const count6 = createRef('ii_scroll:ii_captured_impling_6');
const count7 = createRef('ii_scroll:ii_captured_impling_7');
const count8 = createRef('ii_scroll:ii_captured_impling_8');
const count9 = createRef('ii_scroll:ii_captured_impling_9');
const count10 = createRef('ii_scroll:ii_captured_impling_10');
const count11 = createRef('ii_scroll:ii_captured_impling_11');

const content = createRef('ii_scroll_content');

export function IiScroll(): Component {
  useInterval(() => iiScrollInit(dodger, content), dodger);

  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.ONE), count1);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.TWO), count2);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.THREE), count3);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.FOUR), count4);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.FIVE), count5);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.SIX), count6);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.SEVEN), count7);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.EIGHT), count8);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.NINE), count9);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.TEN), count10);
  useWatch(Inventories.INV, (event) => implingCount(event.component, Jar.ELEVEN), count11);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={dodger} onLoad={() => iiScrollInit(dodger, content)}>
        <layer ref={content} x="right" y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <rect
            x="right"
            y={Layout.PLATE_Y}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            color={ImplingColor.PLATE}
            fill
            transparency={Layout.PLATE_WASH}
          />

          {LeftIcons.map((icon) => (
            <sprite
              x={{ right: Layout.LEFT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          {RightIcons.map((icon) => (
            <sprite
              x={{ right: Layout.RIGHT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          <text
            ref={count1}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={CountRow.ONE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.ONE)}
          />
          <text
            ref={count2}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={CountRow.TWO}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.TWO)}
          />
          <text
            ref={count3}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={CountRow.THREE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.THREE)}
          />
          <text
            ref={count4}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={CountRow.FOUR}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.FOUR)}
          />
          <text
            ref={count5}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={CountRow.FIVE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.FIVE)}
          />

          <text
            ref={count6}
            x={{ right: Layout.RIGHT_COUNT_RIGHT }}
            y={CountRow.ONE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.SIX)}
          />
          <text
            ref={count7}
            x={{ right: Layout.RIGHT_COUNT_RIGHT }}
            y={CountRow.TWO}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.SEVEN)}
          />
          <text
            ref={count8}
            x={{ right: Layout.RIGHT_COUNT_RIGHT }}
            y={CountRow.THREE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.EIGHT)}
          />
          <text
            ref={count9}
            x={{ right: Layout.RIGHT_COUNT_RIGHT }}
            y={CountRow.FOUR}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.NINE)}
          />
          <text
            ref={count10}
            x={{ right: Layout.RIGHT_COUNT_RIGHT }}
            y={CountRow.FIVE}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.TEN)}
          />

          <sprite
            x={{ right: Layout.LEFT_ICON_RIGHT }}
            y={LuckyImpling.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={LuckyImpling.SPRITE}
          />
          <text
            ref={count11}
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={LuckyImpling.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onLoad={(event) => implingCount(event.component, Jar.ELEVEN)}
          />
        </layer>
      </layer>
    </layer>
  );
}
