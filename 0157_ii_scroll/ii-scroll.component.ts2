import { createRef } from 'ts2';

import {
  IiScrollFonts,
  ImplingColor,
  Layout,
  LeftCounts,
  LeftIcons,
  LuckyImpling,
  RightCounts,
  RightIcons,
} from './ii-scroll.constants';
import { iiScrollInit, implingCount } from './ii-scroll.helpers';

const content = createRef('ii_scroll_content');

export function IiScroll(): Component {
  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" onTimer={(event) => iiScrollInit(event.component, content)}>
        <layer ref={content} x="right" y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <rect
            x="right"
            y={Layout.PLATE_Y}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            color={ImplingColor.PLATE}
            fill
            transparency={Layout.PLATE_WASH}
          />

          {LeftIcons.map((icon) => (
            <sprite
              x={{ right: Layout.LEFT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          {RightIcons.map((icon) => (
            <sprite
              x={{ right: Layout.RIGHT_ICON_RIGHT }}
              y={icon.y}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={icon.sprite}
            />
          ))}

          {LeftCounts.map((row) => (
            <text
              x={{ right: Layout.LEFT_COUNT_RIGHT }}
              y={row.y}
              w={Layout.COUNT_W}
              h={Layout.COUNT_H}
              font={IiScrollFonts.COUNT}
              color={ImplingColor.NONE}
              shadow
              onTimer={(event) => implingCount(event.component, row.item)}
            />
          ))}

          {RightCounts.map((row) => (
            <text
              x={{ right: Layout.RIGHT_COUNT_RIGHT }}
              y={row.y}
              w={Layout.COUNT_W}
              h={Layout.COUNT_H}
              font={IiScrollFonts.COUNT}
              color={ImplingColor.NONE}
              shadow
              onTimer={(event) => implingCount(event.component, row.item)}
            />
          ))}

          <sprite
            x={{ right: Layout.LEFT_ICON_RIGHT }}
            y={LuckyImpling.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={LuckyImpling.SPRITE}
          />
          <text
            x={{ right: Layout.LEFT_COUNT_RIGHT }}
            y={LuckyImpling.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={IiScrollFonts.COUNT}
            color={ImplingColor.NONE}
            shadow
            onTimer={(event) => implingCount(event.component, LuckyImpling.ITEM)}
          />
        </layer>
      </layer>
    </layer>
  );
}
