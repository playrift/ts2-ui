import { CS2, useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { IiScrollDodge, ImplingColor } from './ii-scroll.constants';

export function iiScrollInit(dodger: ComponentId, content: ComponentId): void {
  let vAnchor: Int = Anchor.TOP;
  if (onMobile()) {
    vAnchor = Anchor.BOTTOM;
  }
  CS2.if_position_set(0, 0, Anchor.RIGHT, vAnchor, content);
  overlayRelayout(dodger, content, IiScrollDodge.DODGE, Anchor.RIGHT, vAnchor, 0);
}

export function implingCount(label: ComponentId, jar: Item): void {
  const backpack = useInventory(Inventories.INV);
  const held: Int = backpack.total(jar);
  if (held > 0) {
    label.color = ImplingColor.HELD;
  } else {
    label.color = ImplingColor.NONE;
  }
  label.text = stringOf(held);
}
