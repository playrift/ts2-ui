import { createRef } from 'ts2';
import {
  Camera,
  CELL_H,
  HorizontalRules,
  Layout,
  MODEL,
  NAME_CELL_W,
  NameCells,
  REMOVE_ICON_X,
  RemoveIcons,
  ROLE_CELL_X,
  ROLE_CELL_W,
  RoleCells,
  ROW_NUMBER_H,
  ROW_NUMBER_X,
  RowNumbers,
  RULE_H_H,
  RULE_H_W,
  RULE_H_X,
  RULE_V_H,
  RULE_V_W,
  RULE_V_Y,
  ScrollColor,
  ScrollFonts,
  ScrollModel,
  VerticalRules,
  WAVE_X,
  WaveCells,
} from './barbassault-scroll-pl1.constants';
import { compSetHide } from './barbassault-scroll-pl1.helpers';

const tickHover = createRef('barbassault_tick_hover');
const crossHover = createRef('barbassault_cross_hover');

export function BarbassaultScrollPl1(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.SCROLL}
        zoom={Camera.SCROLL.ZOOM}
        pitch={Camera.SCROLL.PITCH}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text="Player 1 Interface Screen"
        font={ScrollFonts.HEADING}
        color={ScrollColor.TITLE}
        shadow
      />

      <text
        x={Layout.DECLINE_LABEL_X}
        y={Layout.DECLINE_LABEL_Y}
        w={Layout.DECLINE_LABEL_W}
        h={Layout.DECLINE_LABEL_H}
        text="Decline"
        font={ScrollFonts.BODY}
        color={ScrollColor.BUTTON}
        shadow
      />

      <model
        x={Layout.DECLINE_ICON_X}
        y={Layout.DECLINE_ICON_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.CROSS}
        zoom={Camera.CROSS.ZOOM}
        pitch={Camera.CROSS.PITCH}
        yaw={Camera.CROSS.YAW}
      />

      <text
        x={Layout.ACCEPT_LABEL_X}
        y={Layout.ACCEPT_LABEL_Y}
        w={Layout.ACCEPT_LABEL_W}
        h={Layout.ACCEPT_LABEL_H}
        text="Accept"
        font={ScrollFonts.BODY}
        color={ScrollColor.BUTTON}
        shadow
      />

      <text
        x={Layout.PL2_ROLE_CAPTION_X}
        y={Layout.PL2_ROLE_CAPTION_Y}
        w={Layout.PL2_ROLE_CAPTION_W}
        h={Layout.PL2_ROLE_CAPTION_H}
        text="Player 2 selected role:"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />
      <text
        x={Layout.PL2_ROLE_X}
        y={Layout.PL2_ROLE_Y}
        w={Layout.PL2_ROLE_W}
        h={Layout.PL2_ROLE_H}
        text="Waiting ..."
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      <text
        x={Layout.TEAM_X}
        y={Layout.TEAM_Y}
        w={Layout.TEAM_W}
        h={Layout.TEAM_H}
        text="The team:"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
      />

      <text
        x={Layout.NAME_HEAD_X}
        y={Layout.NAME_HEAD_Y}
        w={Layout.NAME_HEAD_W}
        h={Layout.NAME_HEAD_H}
        text="Name"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />
      <text
        x={Layout.ROLE_HEAD_X}
        y={Layout.ROLE_HEAD_Y}
        w={Layout.ROLE_HEAD_W}
        h={Layout.ROLE_HEAD_H}
        text="Role"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      {RowNumbers.map((row) => (
        <text
          x={ROW_NUMBER_X}
          y={row.y}
          w={row.w}
          h={ROW_NUMBER_H}
          text={row.text}
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}

      {NameCells.map((cell) => (
        <text
          x={cell.x}
          y={cell.y}
          w={NAME_CELL_W}
          h={CELL_H}
          text="none set"
          font={ScrollFonts.CELL}
          color={ScrollColor.BODY}
          shadow
          valign="middle"
        />
      ))}

      {RoleCells.map((cell) => (
        <text
          x={ROLE_CELL_X}
          y={cell.y}
          w={ROLE_CELL_W}
          h={CELL_H}
          text="none set"
          font={ScrollFonts.CELL}
          color={ScrollColor.BODY}
          shadow
          align="center"
          valign="middle"
        />
      ))}

      <text
        x={Layout.WAVE_HEAD_X}
        y={Layout.WAVE_HEAD_Y}
        w={Layout.WAVE_HEAD_W}
        h={Layout.WAVE_HEAD_H}
        text="Wave"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      <text
        x={Layout.WAVE1_X}
        y={Layout.WAVE1_Y}
        w={Layout.WAVE_W}
        h={Layout.WAVE_H}
        text="0"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />

      {RemoveIcons.map((icon) => (
        <model
          x={REMOVE_ICON_X}
          y={icon.y}
          w={MODEL}
          h={MODEL}
          model={ScrollModel.CROSS}
          zoom={Camera.REMOVE.ZOOM}
          pitch={Camera.REMOVE.PITCH}
          yaw={Camera.REMOVE.YAW}
          options={['Remove']}
        />
      ))}

      <text
        x={Layout.REMOVE_HEAD_X}
        y={Layout.REMOVE_HEAD_Y}
        w={Layout.REMOVE_HEAD_W}
        h={Layout.REMOVE_HEAD_H}
        text="Remove?"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      {WaveCells.map((cell) => (
        <text
          x={WAVE_X}
          y={cell.y}
          w={Layout.WAVE_W}
          h={Layout.WAVE_H}
          text="0"
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}

      <model
        x={Layout.ACCEPT_ICON_X}
        y={Layout.ACCEPT_ICON_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.TICK}
        zoom={Camera.TICK.ZOOM}
        pitch={Camera.TICK.PITCH}
        yaw={Camera.TICK.YAW}
      />

      {VerticalRules.map((rule) => (
        <rect x={rule.x} y={RULE_V_Y} w={RULE_V_W} h={RULE_V_H} color={ScrollColor.RULE} fill />
      ))}
      {HorizontalRules.map((rule) => (
        <rect x={RULE_H_X} y={rule.y} w={RULE_H_W} h={RULE_H_H} color={ScrollColor.RULE} fill />
      ))}

      <text
        x={Layout.PL2_LEVEL_CAPTION_X}
        y={Layout.PL2_LEVEL_CAPTION_Y}
        w={Layout.PL2_LEVEL_W}
        h={Layout.PL2_LEVEL_H}
        text="Level in role:"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />
      <text
        x={Layout.PL2_LEVEL_X}
        y={Layout.PL2_LEVEL_Y}
        w={Layout.PL2_LEVEL_W}
        h={Layout.PL2_LEVEL_H}
        text="Waiting ..."
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      <layer ref={tickHover} hide x={Layout.TICK_HOVER_X} y={Layout.TICK_HOVER_Y} w={Layout.HOVER} h={Layout.HOVER}>
        <model
          x={Layout.HOVER_FACE_X}
          y={Layout.HOVER_FACE_Y}
          w={MODEL}
          h={MODEL}
          model={ScrollModel.TICK_LIT}
          zoom={Camera.TICK.ZOOM}
          pitch={Camera.TICK.PITCH}
          yaw={Camera.TICK.YAW}
        />
      </layer>
      <layer ref={crossHover} hide x={Layout.CROSS_HOVER_X} y={Layout.CROSS_HOVER_Y} w={Layout.HOVER} h={Layout.HOVER}>
        <model
          x={Layout.HOVER_FACE_X}
          y={Layout.HOVER_FACE_Y}
          w={MODEL}
          h={MODEL}
          model={ScrollModel.CROSS_LIT}
          zoom={Camera.CROSS.ZOOM}
          pitch={Camera.CROSS.PITCH}
          yaw={Camera.CROSS.YAW}
        />
      </layer>

      <sprite
        x={Layout.ACCEPT_HITBOX_X}
        y={Layout.HITBOX_Y}
        w={Layout.HITBOX_W}
        h={Layout.HITBOX_H}
        options={['Accept']}
        onMouseEnter={() => compSetHide(0, tickHover)}
        onMouseLeave={() => compSetHide(1, tickHover)}
      />
      <sprite
        x={Layout.DECLINE_HITBOX_X}
        y={Layout.HITBOX_Y}
        w={Layout.HITBOX_W}
        h={Layout.HITBOX_H}
        options={['Decline']}
        onMouseEnter={() => compSetHide(0, crossHover)}
        onMouseLeave={() => compSetHide(1, crossHover)}
      />
    </>
  );
}
