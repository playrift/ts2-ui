import { createRef } from 'ts2';
import {
  Camera,
  CELL_H,
  CELL_W,
  FollowerLabels,
  Layout,
  MODEL,
  NameCells,
  ROLE_LABEL_W,
  ROLE_MODEL,
  RoleCells,
  RoleHitboxes,
  RoleHovers,
  Roles,
  ScrollColor,
  ScrollFonts,
  ScrollModel,
  WaveCells,
} from './barbassault-scroll-pl2.constants';
import { compSetHide } from './barbassault-scroll-pl2.helpers';

const swordHover = createRef('barbassault_sword_hover');
const shieldHover = createRef('barbassault_shield_hover');
const eggHover = createRef('barbassault_egg_hover');
const medicHover = createRef('barbassault_medic_hover');
const tickHighlight = createRef('barbassault_tick_highlight');
const crossHighlight = createRef('barbassault_cross_highlight');

export function BarbassaultScrollPl2(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.SCROLL}
        zoom={Camera.SCROLL.ZOOM}
        pitch={Camera.SCROLL.PITCH}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text="Player 2 Interface Screen"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
      />

      <text
        x={Layout.ROLENAME_X}
        y={Layout.ROLENAME_Y}
        w={Layout.ROLENAME_W}
        h={Layout.ROLENAME_H}
        text="None"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      <layer hide x={Layout.WAIT_X} y={Layout.WAIT_Y} w={Layout.WAIT_W} h={Layout.WAIT_H}>
        <text
          x={Layout.WAIT_TEXT_X}
          y={Layout.WAIT_TEXT_Y}
          w={Layout.WAIT_TEXT_W}
          h={Layout.WAIT_TEXT_H}
          text="Waiting for player 1 to accept..."
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <text
        x={Layout.TEAM_X}
        y={Layout.TEAM_Y}
        w={Layout.TEAM_W}
        h={Layout.TEAM_H}
        text="The team:"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
      />

      <text
        x={Layout.LEADER_NAME_X}
        y={Layout.LEADER_NAME_Y}
        w={Layout.NAME_LABEL_W}
        h={Layout.LABEL_H}
        text="Name"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />
      <text
        x={Layout.LEADER_ROLE_X}
        y={Layout.LEADER_ROLE_Y}
        w={Layout.ROLE_LABEL_W}
        h={Layout.LABEL_H}
        text="Role"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />

      <text
        x={Layout.LEADER_X}
        y={Layout.LEADER_Y}
        w={Layout.DIVIDER_W}
        h={Layout.DIVIDER_H}
        text="--- Leader ---"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />
      <text
        x={Layout.FOLLOWERS_X}
        y={Layout.FOLLOWERS_Y}
        w={Layout.DIVIDER_W}
        h={Layout.DIVIDER_H}
        text="--- Followers ---"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />

      {NameCells.map((cell) => (
        <text
          x={cell.x}
          y={cell.y}
          w={CELL_W}
          h={CELL_H}
          text="none set"
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}
      {RoleCells.map((cell) => (
        <text
          x={cell.x}
          y={cell.y}
          w={CELL_W}
          h={CELL_H}
          text="none set"
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}

      <text
        x={Layout.WAVE_HEAD_X}
        y={Layout.WAVE_HEAD_Y}
        w={Layout.WAVE_HEAD_W}
        h={Layout.WAVE_HEAD_H}
        text="Wave"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />
      {WaveCells.map((cell) => (
        <text
          x={cell.x}
          y={cell.y}
          w={Layout.WAVE_W}
          h={Layout.WAVE_H}
          text="0"
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}

      <text
        x={Layout.PROMPT_X}
        y={Layout.PROMPT_Y}
        w={Layout.PROMPT_W}
        h={Layout.PROMPT_H}
        text="Please select a role!<br>Current Role:"
        font={ScrollFonts.HEADING}
        color={ScrollColor.BODY}
        shadow
        align="center"
      />

      {Roles.map((role) => (
        <>
          <model
            x={role.x}
            y={role.y}
            w={ROLE_MODEL}
            h={ROLE_MODEL}
            model={role.model}
            zoom={Camera.ROLE.ZOOM}
            pitch={Camera.ROLE.PITCH}
          />
          <text
            x={role.labelX}
            y={role.labelY}
            w={ROLE_LABEL_W}
            h={role.labelH}
            text={role.text}
            font={ScrollFonts.BODY}
            color={ScrollColor.BODY}
            shadow
            align="center"
          />
        </>
      ))}

      <model
        x={Layout.ACCEPT_ICON_X}
        y={Layout.ACCEPT_ICON_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.TICK}
        zoom={Camera.TICK.ZOOM}
        pitch={Camera.TICK.PITCH}
        yaw={Camera.TICK.YAW}
      />
      <text
        x={Layout.ACCEPT_LABEL_X}
        y={Layout.ACCEPT_LABEL_Y}
        w={Layout.ACCEPT_LABEL_W}
        h={Layout.ACCEPT_LABEL_H}
        text="Accept"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />

      <model
        x={Layout.DECLINE_ICON_X}
        y={Layout.DECLINE_ICON_Y}
        w={MODEL}
        h={MODEL}
        model={ScrollModel.CROSS}
        zoom={Camera.CROSS.ZOOM}
        pitch={Camera.CROSS.PITCH}
        yaw={Camera.CROSS.YAW}
      />
      <text
        x={Layout.DECLINE_LABEL_X}
        y={Layout.DECLINE_LABEL_Y}
        w={Layout.DECLINE_LABEL_W}
        h={Layout.DECLINE_LABEL_H}
        text="Decline"
        font={ScrollFonts.BODY}
        color={ScrollColor.BODY}
        shadow
      />

      <layer ref={swordHover} hide x={RoleHovers.SWORD.x} y={RoleHovers.SWORD.y} w={ROLE_MODEL} h={ROLE_MODEL}>
        <model
          x={0}
          y={0}
          w={ROLE_MODEL}
          h={ROLE_MODEL}
          model={RoleHovers.SWORD.model}
          zoom={Camera.ROLE.ZOOM}
          pitch={Camera.ROLE.PITCH}
        />
      </layer>
      <layer ref={shieldHover} hide x={RoleHovers.SHIELD.x} y={RoleHovers.SHIELD.y} w={ROLE_MODEL} h={ROLE_MODEL}>
        <model
          x={0}
          y={0}
          w={ROLE_MODEL}
          h={ROLE_MODEL}
          model={RoleHovers.SHIELD.model}
          zoom={Camera.ROLE.ZOOM}
          pitch={Camera.ROLE.PITCH}
        />
      </layer>
      <layer ref={eggHover} hide x={RoleHovers.EGG.x} y={RoleHovers.EGG.y} w={ROLE_MODEL} h={ROLE_MODEL}>
        <model
          x={0}
          y={0}
          w={ROLE_MODEL}
          h={ROLE_MODEL}
          model={RoleHovers.EGG.model}
          zoom={Camera.ROLE.ZOOM}
          pitch={Camera.ROLE.PITCH}
        />
      </layer>
      <layer ref={medicHover} hide x={RoleHovers.MEDIC.x} y={RoleHovers.MEDIC.y} w={ROLE_MODEL} h={ROLE_MODEL}>
        <model
          x={0}
          y={0}
          w={ROLE_MODEL}
          h={ROLE_MODEL}
          model={RoleHovers.MEDIC.model}
          zoom={Camera.ROLE.ZOOM}
          pitch={Camera.ROLE.PITCH}
        />
      </layer>

      <layer ref={tickHighlight} hide x={Layout.TICK_HOVER_X} y={Layout.TICK_HOVER_Y} w={Layout.HOVER} h={Layout.HOVER}>
        <model
          x={Layout.TICK_FACE_X}
          y={Layout.TICK_FACE_Y}
          w={MODEL}
          h={MODEL}
          model={ScrollModel.TICK_LIT}
          zoom={Camera.TICK.ZOOM}
          pitch={Camera.TICK.PITCH}
          yaw={Camera.TICK.YAW}
        />
      </layer>
      <layer
        ref={crossHighlight}
        hide
        x={Layout.CROSS_HOVER_X}
        y={Layout.CROSS_HOVER_Y}
        w={Layout.HOVER}
        h={Layout.HOVER}
      >
        <model
          x={Layout.CROSS_FACE_X}
          y={Layout.CROSS_FACE_Y}
          w={MODEL}
          h={MODEL}
          model={ScrollModel.CROSS_LIT}
          zoom={Camera.CROSS.ZOOM}
          pitch={Camera.CROSS.PITCH}
          yaw={Camera.CROSS.YAW}
        />
      </layer>

      <sprite
        x={RoleHitboxes.ATTACKER.x}
        y={RoleHitboxes.ATTACKER.y}
        w={RoleHitboxes.ATTACKER.w}
        h={RoleHitboxes.ATTACKER.h}
        options={['Attacker']}
        onMouseEnter={() => compSetHide(0, swordHover)}
        onMouseLeave={() => compSetHide(1, swordHover)}
      />
      <sprite
        x={RoleHitboxes.DEFENDER.x}
        y={RoleHitboxes.DEFENDER.y}
        w={RoleHitboxes.DEFENDER.w}
        h={RoleHitboxes.DEFENDER.h}
        options={['Defender']}
        onMouseEnter={() => compSetHide(0, shieldHover)}
        onMouseLeave={() => compSetHide(1, shieldHover)}
      />
      <sprite
        x={RoleHitboxes.COLLECTOR.x}
        y={RoleHitboxes.COLLECTOR.y}
        w={RoleHitboxes.COLLECTOR.w}
        h={RoleHitboxes.COLLECTOR.h}
        options={['Collector']}
        onMouseEnter={() => compSetHide(0, eggHover)}
        onMouseLeave={() => compSetHide(1, eggHover)}
      />
      <sprite
        x={RoleHitboxes.HEALER.x}
        y={RoleHitboxes.HEALER.y}
        w={RoleHitboxes.HEALER.w}
        h={RoleHitboxes.HEALER.h}
        options={['Healer']}
        onMouseEnter={() => compSetHide(0, medicHover)}
        onMouseLeave={() => compSetHide(1, medicHover)}
      />

      <sprite
        x={Layout.ACCEPT_HITBOX_X}
        y={Layout.ACCEPT_HITBOX_Y}
        w={Layout.ACCEPT_HITBOX_W}
        h={Layout.ACCEPT_HITBOX_H}
        options={['Accept']}
        onMouseEnter={() => compSetHide(0, tickHighlight)}
        onMouseLeave={() => compSetHide(1, tickHighlight)}
      />
      <sprite
        x={Layout.DECLINE_HITBOX_X}
        y={Layout.DECLINE_HITBOX_Y}
        w={Layout.DECLINE_HITBOX_W}
        h={Layout.DECLINE_HITBOX_H}
        options={['Decline']}
        onMouseEnter={() => compSetHide(0, crossHighlight)}
        onMouseLeave={() => compSetHide(1, crossHighlight)}
      />

      {FollowerLabels.map((label) => (
        <text
          x={label.x}
          y={label.y}
          w={label.w}
          h={Layout.LABEL_H}
          text={label.text}
          font={ScrollFonts.BODY}
          color={ScrollColor.BODY}
          shadow
        />
      ))}
    </>
  );
}
