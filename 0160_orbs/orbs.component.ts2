      <XpDropsButton left={0} top={17} fromRight={false} />
      <HealthOrb left={0} top={37} fromRight={false} wide={false} clickY={5} clickW={50} clickH={26} />
      <PrayerOrb left={0} top={71} fromRight={false} wide={false} clickY={5} clickW={49} clickH={26} />
      <RunOrb left={10} top={103} fromRight={false} wide={false} clickY={5} clickW={50} clickH={26} />
      <SpecOrb
