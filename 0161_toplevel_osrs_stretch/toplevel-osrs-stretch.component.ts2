function AtmosphereEffect(): Component {
  const [kind] = useState(atmosphereKind);
  const [start] = useState(atmosphereStart);
  const [modelId] = useState(atmosphereModel);
  const [until] = useState(atmosphereUntil);
  const [phase] = useState(weddingPhase);
  const [phaseStart] = useState(weddingPhaseStart);
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {kind === AtmosphereKind.JAR_OF_DARKNESS ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={0x000000}
          fill
          transparency={255}
          onTimer={(event) => {
            event.self.transparency = jarStep(start);
          }}
        />
      ) : null}
      {kind === AtmosphereKind.SARADOMINS_LIGHT ? (
        <>
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={Models.SARADOMINS_LIGHT_29403}
            pitch={512}
            yaw={48}
            zoom={1050}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= SaradominsLight.SPIN) {
                event.self.props = {
                  offsetX: 0,
                  offsetY: 0,
                  pitch: 512,
                  yaw: saradominsLightYaw(t),
                  roll: 0,
                  zoom: saradominsLightZoom(t),
                };
                event.self.model = Models.SARADOMINS_LIGHT_29403;
              } else if (t <= SaradominsLight.END) {
                event.self.model = 16238;
              } else {
                endAtmosphere();
              }
            }}
          />
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0xffffff}
            fill
            transparency={255}
            onTimer={(event) => {
              event.self.transparency = saradominsLightFill(clientClock() - start);
            }}
          />
        </>
      ) : null}
      {kind === AtmosphereKind.SOULBEARER_REPAIR ? (
        <>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0x221100}
            fill
            transparency={255}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t > SoulbearerRepair.END) {
                endAtmosphere();
              }
              event.self.transparency = soulbearerRepairFill(t);
            }}
          />
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={Models.SOUL_DEVOURER_29280}
            anim={Animations.SOUL_SKULL_ACTIVE}
            offsetY={300}
            pitch={100}
            yaw={1536}
            zoom={10100}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= SoulbearerRepair.SPIN) {
                event.self.props = {
                  offsetX: 0,
                  offsetY: 300,
                  pitch: 100,
                  yaw: 1536,
                  roll: t * 3,
                  zoom: 10100 - t * 200,
                };
              } else if (t <= SoulbearerRepair.END) {
                event.self.model = 16238;
              }
            }}
          />
        </>
      ) : null}
      {kind === AtmosphereKind.LITTLE_NIGHTMARE ? (
        <>
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={16238}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= LittleNightmare.DARK) {
                event.self.model = 16238;
              } else if (t <= LittleNightmare.END) {
                event.self.model = Models.LITTLE_NIGHTMARE_39197;
                event.self.transparency = 255;
                event.self.props = {
                  offsetX: -25,
                  offsetY: 30,
                  pitch: 0,
                  yaw: 1950,
                  roll: 0,
                  zoom: littleNightmareZoom(t),
                };
              } else {
                endAtmosphere();
              }
            }}
          />
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0x0a0a0a}
            fill
            transparency={255}
            onTimer={(event) => {
              event.self.transparency = littleNightmareFill(clientClock() - start);
            }}
          />
        </>
      ) : null}
      {kind === AtmosphereKind.ABYSSALSIRE_OVERSEER ? (
        <>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0xffffff}
            fill
            transparency={255}
            onTimer={(event) => {
              event.self.transparency = abyssalsireOverseerFill(clientClock() - start);
            }}
          />
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={Models.ABYSSAL_RIFT_7427}
            anim={Animations.RCU_APOCALYPSE_SPINS}
            offsetY={120}
            zoom={2000}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= AbyssalsireOverseer.SPIN) {
                event.self.props = {
                  offsetX: 0,
                  offsetY: 120,
                  pitch: 0,
                  yaw: 0,
                  roll: 0,
                  zoom: abyssalsireOverseerZoom(t),
                };
                event.self.model = Models.ABYSSAL_RIFT_7427;
              } else if (t <= AbyssalsireOverseer.END) {
                event.self.model = 16238;
              }
            }}
          />
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={Models.ABYSSAL_RIFT_7428}
            anim={Animations.RCU_APOCALYPSE_SPINS}
            offsetY={120}
            zoom={2000}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= AbyssalsireOverseer.SPIN) {
                event.self.props = {
                  offsetX: 0,
                  offsetY: 120,
                  pitch: 0,
                  yaw: 0,
                  roll: 0,
                  zoom: abyssalsireOverseerZoom(t),
                };
                event.self.model = Models.ABYSSAL_RIFT_7428;
              } else if (t <= AbyssalsireOverseer.END) {
                event.self.model = 16238;
              } else {
                endAtmosphere();
              }
            }}
          />
        </>
      ) : null}
      {kind === AtmosphereKind.DOLL ? (
        <>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0xffffff}
            fill
            transparency={255}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t > Doll.END) {
                endAtmosphere();
              }
              event.self.color = dollColour(t);
              event.self.transparency = dollFill(t);
            }}
          />
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={34415}
            offsetY={60}
            pitch={30}
            yaw={0}
            zoom={1580}
            onTimer={(event) => {
              const t: Int = clientClock() - start;
              if (t <= Doll.FLASH) {
                if (dollAlternate(t)) {
                  event.self.model = 34415;
                } else {
                  event.self.model = Models.DOLL_34414;
                }
                event.self.props = { offsetX: 0, offsetY: 60, pitch: 30, yaw: dollYaw(t), roll: 0, zoom: dollZoom(t) };
              } else if (t <= Doll.END) {
                event.self.model = 16238;
              }
            }}
          />
        </>
      ) : null}
      {kind === AtmosphereKind.MOLE_SPLAT ? (
        <model
          x="center"
          y="center"
          w="fill"
          h="fill"
          model={modelId as Model}
          anim={Animations.MOLE_MUD_SPLAT_INTERFACE}
          pitch={MoleSplat.PITCH}
          zoom={moleSplatZoom(overlayAtmosphereRef.height!)}
          onTimer={(event) => {
            if (clientClock() >= until) {
              endAtmosphere();
            } else {
              event.self.props = {
                offsetX: 0,
                offsetY: 0,
                pitch: MoleSplat.PITCH,
                yaw: 0,
                roll: 0,
                zoom: moleSplatZoom(overlayAtmosphereRef.height!),
              };
            }
          }}
        />
      ) : null}
      {kind === AtmosphereKind.WEDDING ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={0x000000}
          fill
          transparency={phase === WeddingPhase.FADE_IN ? 255 : 0}
          onTimer={(event) => {
            if (phase === WeddingPhase.FADE_IN) {
              const t: Int = clientClock() - start;
              if (t < Wedding.FADE_IN) {
                event.self.transparency = weddingFadeIn(t);
              } else {
                event.self.transparency = 0;
                enterWeddingPhase(WeddingPhase.HUD);
              }
            } else if (phase === WeddingPhase.HUD) {
              if (clientClock() - phaseStart >= Wedding.HUD_END) {
                enterWeddingPhase(WeddingPhase.FADE_OUT);
              }
            } else {
              const t: Int = clientClock() - phaseStart;
              if (t < Wedding.FADE_OUT) {
                event.self.transparency = weddingFadeOut(t);
              } else {
                endAtmosphere();
              }
            }
          }}
        />
      ) : null}
    </layer>
  );
}

