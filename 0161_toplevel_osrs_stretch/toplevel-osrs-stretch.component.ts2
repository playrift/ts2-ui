function CutsceneLayout(): Component {
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const buffBarHidden: Int = useServerState(Varbits.BUFF_BAR_HIDDEN);
  const minimapToggle: Int = useServerState(Varbits.MINIMAP_TOGGLE);
  const hideSide: Boolean = cutsceneHidesSide();
  const mask: Sprite = minimapClickMask();

  let inCutscene: Boolean = false;
  if (cutscene !== 0) {
    inCutscene = true;
  }
  let mapHidden: Boolean = false;
  if (cutscene >= 1) {
    mapHidden = true;
  }
  let compassHidden: Boolean = false;
  if (cutscene === 1 || fovClamp !== 0) {
    compassHidden = true;
  }
  let buffBarShown: Boolean = false;
  if (buffBarHidden === 0 && cutscene === 0) {
    buffBarShown = true;
  }
  let chatMode: Int = 0;
  if (cutscene === 1) {
    chatMode = fovClamp === FovClamp.NARROW ? 1 : 2;
  }
  let minimapHidden: Boolean = false;
  if (minimapToggle >= 1) {
    minimapHidden = true;
  }
  onMounted(() =>
    cutsceneHides(inCutscene, mapHidden, compassHidden, buffBarShown, chatMode, hideSide, minimapHidden, mask),
  );
  onUpdated(() =>
    cutsceneHides(inCutscene, mapHidden, compassHidden, buffBarShown, chatMode, hideSide, minimapHidden, mask),
  );
  return <layer x={0} y={0} w={0} h={0} />;
}

function cutsceneHides(
  inCutscene: Boolean,
  mapHidden: Boolean,
  compassHidden: Boolean,
  buffBarShown: Boolean,
  chatMode: Int,
  hideSide: Boolean,
  minimapHidden: Boolean,
  mask: Sprite,
): void {
  mapContainerRef.hide = mapHidden;
  compassclickRef.hide = compassHidden;
  buffBarRef.hide = !buffBarShown;
  pmContainerRef.hide = inCutscene;
  statBoostsHudRef.hide = inCutscene;
  helperRef.hide = inCutscene;
  hpbarHudRef.hide = inCutscene;
  mouseoverRef.hide = inCutscene;
  sideMenuRef.hide = hideSide;
  mapMinimapRef.hide = minimapHidden;
  minimapRef.clickMask = mask;
  if (chatMode === 1) {
    chatContainerRef.props = { x: 'center', y: 'bottom' };
  } else if (chatMode === 2) {
    chatContainerRef.props = { x: 0, y: { bottom: Frame.CHAT_CUTSCENE_DROP } };
  } else {
    chatContainerRef.props = { x: 0, y: 'bottom' };
  }
  applyClientSettings();
  applySavedZoom();
  touchStretchBuffBar();
}

function ViewportLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const xpdropsPosition: Int = useServerState(Varbits.XPDROPS_POSITION);
  const [bgTrans] = useState(toplevelMainmodalBgTrans);

  const frameW: Int = controlRef.width!;
  const frameH: Int = controlRef.height!;
  applyFov(fovClamp);
  const [viewW, viewH] = CS2.viewport_effective_size_get();
  const right: Int = hudRightInset(fovClamp, frameW, viewW);
  const bottom: Int = hudBottomInset(fovClamp, frameH, viewH);

  let modalMode: Int = 0;
  if (!onMobile() && CS2.if_sub_has(mainmodalRef)) {
    if (bgTrans === -2) {
      modalMode = 1;
    } else if (bgTrans === -3) {
      modalMode = 2;
    }
  }
  let debugY: Int = 0;
  if (CS2.if_sub_has(xpDropsRef) && xpdropsPosition === 0) {
    debugY = 38;
  }

  onMounted(() => placeViewport(viewW, viewH, right, bottom, modalMode, debugY));
  onUpdated(() => placeViewport(viewW, viewH, right, bottom, modalMode, debugY));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeViewport(viewW: Int, viewH: Int, right: Int, bottom: Int, modalMode: Int, debugY: Int): void {
  viewportTrackerBackRef.props = { w: viewW, h: viewH };
  viewportTrackerFrontRef.props = { w: viewW, h: viewH };
  hudContainerBackRef.props = { x: 0, y: 0, w: { fill: right }, h: { fill: bottom } };
  hudContainerFrontRef.props = { x: 0, y: 0, w: { fill: right }, h: { fill: bottom } };
  if (modalMode === 1) {
    mainmodalRef.props = { w: Frame.MODAL_W, h: 'fill' };
  } else if (modalMode === 2) {
    mainmodalRef.props = { w: 'fill', h: 'fill' };
  } else {
    mainmodalRef.props = { w: Frame.MODAL_W, h: Frame.MODAL_H };
  }
  debugRef.props = { x: 'right', y: debugY };
  xpDropsRef.props = { w: 'fill', h: 'fill' };
}

function SidePanelLayout(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const [panel] = useState(toplevelPanel);
  const modalUp: Boolean = CS2.if_sub_has(sidemodalRef);
  let openSlot: ComponentId = -1;
  if (panel >= 0 && panel < Panel.COUNT) {
    const slot: ComponentId = sideSlotOf(panel);
    if (slot !== -1 && CS2.if_sub_has(slot)) {
      openSlot = slot;
    }
  }
  onMounted(() => placeSide(openSlot, modalUp));
  onUpdated(() => placeSide(openSlot, modalUp));
  return <layer x={0} y={0} w={0} h={0} />;
}

function sideSlotOf(panel: Int): ComponentId {
  if (panel === 0) return side0Ref;
  if (panel === 1) return side1Ref;
  if (panel === 2) return side2Ref;
  if (panel === 3) return side3Ref;
  if (panel === 4) return side4Ref;
  if (panel === 5) return side5Ref;
  if (panel === 6) return side6Ref;
  if (panel === 7) return side7Ref;
  if (panel === 8) return side8Ref;
  if (panel === 9) return side9Ref;
  if (panel === 10) return side10Ref;
  if (panel === 11) return side11Ref;
  if (panel === 12) return side12Ref;
  if (panel === 13) return side13Ref;
  return -1;
}

function placeSide(openSlot: ComponentId, modalUp: Boolean): void {
  side0Ref.hide = openSlot !== side0Ref;
  side1Ref.hide = openSlot !== side1Ref;
  side2Ref.hide = openSlot !== side2Ref;
  side3Ref.hide = openSlot !== side3Ref;
  side4Ref.hide = openSlot !== side4Ref;
  side5Ref.hide = openSlot !== side5Ref;
  side6Ref.hide = openSlot !== side6Ref;
  side7Ref.hide = openSlot !== side7Ref;
  side8Ref.hide = openSlot !== side8Ref;
  side9Ref.hide = openSlot !== side9Ref;
  side10Ref.hide = openSlot !== side10Ref;
  side11Ref.hide = openSlot !== side11Ref;
  side12Ref.hide = openSlot !== side12Ref;
  side13Ref.hide = openSlot !== side13Ref;
  sidePanelsRef.hide = modalUp;
  sidecrmRef.hide = modalUp;
  sideTopRef.hide = modalUp;
  sideBottomRef.hide = modalUp;
}

function MultiwayLayout(): Component {
  const multiway: Int = useServerState(Varbits.MULTIWAY_INDICATOR);
  const singlewayPlus: Int = useServerState(Varbits.SINGLEWAY_PLUS_INDICATOR);
  const td: Int = useServerState(Varbits.TD_MULTIWAY_INDICATOR);
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  let sprite: Sprite = NoSprite.NONE;
  let shown: Boolean = false;
  if (multiway === 1 && cutscene === 0) {
    sprite = Sprites.OVERLAY_MULTIWAY;
    shown = true;
  } else if (singlewayPlus === 1 && cutscene === 0) {
    sprite = Sprites.OVERLAY_SINGLEWAY_PLUS;
    shown = true;
  } else if (td > 0 && cutscene === 0) {
    if (td === 1) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_0;
    } else if (td === 2) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_1;
    } else if (td === 3) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_2;
    }
    shown = true;
  }
  onMounted(() => placeMultiway(sprite, shown));
  onUpdated(() => placeMultiway(sprite, shown));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeMultiway(sprite: Sprite, shown: Boolean): void {
  if (sprite !== NoSprite.NONE) {
    multiwayIconRef.sprite = sprite;
  }
  multiwayIconRef.hide = !shown;
}

function SideBackdrop(): Component {
  const transparent: Int = useServerState(Varbits.SIDE_TRANSPARENCY);
  let dark: Boolean = false;
  if (transparent === 1) {
    dark = true;
  }
  onMounted(() => placeBackdrop(dark));
  onUpdated(() => placeBackdrop(dark));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeBackdrop(dark: Boolean): void {
  if (dark) {
    sideBackgroundRef.props = { sprite: Sprites.TRADEBACKING_DARK, transparency: 0 };
  } else {
    sideBackgroundRef.props = { sprite: Sprites.TRADEBACKING_LIGHT, transparency: Frame.LIGHT_TRANS };
  }
}

function ModalBackdrop(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const [colour] = useState(toplevelMainmodalBgColour);
  const [trans] = useState(toplevelMainmodalBgTrans);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  let shown: Boolean = false;
  if (colour > -1 && trans > -1 && CS2.if_sub_has(mainmodalRef)) {
    shown = true;
  }
  const frameW: Int = controlRef.width!;
  const frameH: Int = controlRef.height!;
  const [viewW, viewH] = CS2.viewport_effective_size_get();
  const right: Int = hudRightInset(fovClamp, frameW, viewW);
  const bottom: Int = hudBottomInset(fovClamp, frameH, viewH);
  const frontW: Int = viewW - right;
  const frontH: Int = viewH - bottom;
  const left: Int = (frontW - Frame.MODAL_W) / 2;
  const top: Int = (frontH - Frame.MODAL_H) / 2;
  const rightGap: Int = frontW - (left + Frame.MODAL_W);
  const bottomGap: Int = frontH - (top + Frame.MODAL_H);
  return (
    <>
      {shown && (
        <>
          <rect x={0} y={0} w="fill" h={top} color={colour} fill transparency={trans} />
          <rect x={0} y="bottom" w="fill" h={bottomGap + bottom} color={colour} fill transparency={trans} />
          <rect x={0} y={top} w={left} h={Frame.MODAL_H} color={colour} fill transparency={trans} />
          <rect x="right" y={top} w={rightGap + right} h={Frame.MODAL_H} color={colour} fill transparency={trans} />
        </>
      )}
    </>
  );
}

function EhcHooks(): Component {
  const enhanced: Boolean = enhancedAny();
  return (
    <>
      {enhanced && (
        <>
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
        </>
      )}
    </>
  );
}

function SideTopTabs(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const prayerbook: Int = useServerState(Varbits.PRAYERBOOK);
  const spellbook: Int = useServerState(Varbits.SPELLBOOK);
  const sailing: Int = useServerState(Varbits.SAILING_SIDEPANEL_VISIBLE);
  const journalTab: Int = useServerState(Varbits.SIDE_JOURNAL_TAB);
  const leagueType: Int = useServerState(Varbits.LEAGUE_TYPE);
  const prayerFilter: Int = useServerState(Varbits.PRAYER_HIDEFILTERBUTTON);
  const spellFilter: Int = useServerState(Varbits.MAGIC_SPELLBOOK_HIDEFILTERBUTTON);

  const combatLabel: String = sailing === 1 ? 'Sailing Options' : 'Combat Options';
  const combatIcon: Sprite = sailing === 1 ? Sprites.SIDEICONS_INTERFACE_67 : Sprites.SIDEICONS_INTERFACE_0;

  const fifth: Int = fifthTab();
  let journalIcon: Sprite = JournalTabIcons.at(journalTab) ?? 2309;
  let journalOp6: String = '';
  let journalOp5: String = '';
  if (fifth === FifthTab.FSW || fifth === FifthTab.LEAGUES || fifth === FifthTab.DEADMAN) {
    if (journalTab === 4) {
      journalIcon = LeagueJournalIcons.get(leagueType) ?? journalIcon;
    } else {
      journalOp6 = JournalTabLabels.at(4) ?? '';
    }
  } else if (fifth === FifthTab.PATHS) {
    if (journalTab !== 3) {
      journalOp5 = JournalTabLabels.at(3) ?? '';
    }
  }
  const journalOp2: String = journalTab !== 0 ? (JournalTabLabels.at(0) ?? '') : '';
  const journalOp3: String = journalTab !== 1 ? (JournalTabLabels.at(1) ?? '') : '';
  const journalOp4: String = journalTab !== 2 ? (JournalTabLabels.at(2) ?? '') : '';

  const prayerIcon: Sprite = prayerbook === 1 ? Sprites.SIDEICONS_INTERFACE_56 : Sprites.SIDEICONS_INTERFACE_5;
  let magicIcon: Sprite = Sprites.SIDEICONS_INTERFACE_6;
  if (spellbook === 1) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_19;
  } else if (spellbook === 2) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_20;
  } else if (spellbook === 3) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_21;
  }
  const prayerOp2: String = filterOption(prayerFilter, 'Enable prayer filtering', 'Disable prayer filtering');
  const magicOp2: String = filterOption(spellFilter, 'Enable spell filtering', 'Disable spell filtering');

  const combatHidden: Boolean = tabHidden(Panel.COMBAT);
  const skillsHidden: Boolean = tabHidden(Panel.SKILLS);
  const journalHidden: Boolean = tabHidden(Panel.JOURNAL);
  const inventoryHidden: Boolean = tabHidden(Panel.INVENTORY);
  const equipmentHidden: Boolean = tabHidden(Panel.EQUIPMENT);
  const prayerHidden: Boolean = tabHidden(Panel.PRAYER);
  const magicHidden: Boolean = tabHidden(Panel.MAGIC);

  return (
    <>
      <sprite
        x={StoneX.X0}
        y={0}
        w={Frame.STONE_END_W}
        h={Frame.STONE_H}
        sprite={stoneSprite(Panel.COMBAT)}
        hide={combatHidden}
        options={[combatLabel]}
        onOptionSelect={(event) => stretchTabOp(Panel.COMBAT, event.option)}
      />
      <sprite
        x={StoneX.X1}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.SKILLS)}
        hide={skillsHidden}
        options={[SidePanelOps.at(Panel.SKILLS) ?? '']}
        onOptionSelect={(event) => stretchTabOp(Panel.SKILLS, event.option)}
      />
      <sprite
        x={StoneX.X2}
        y={0}
        w={Frame.STONE_END_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.JOURNAL)}
        hide={journalHidden}
        options={[JournalTabLabels.at(journalTab) ?? '', journalOp2, journalOp3, journalOp4, journalOp5, journalOp6]}
        onOptionSelect={(event) => stretchTabOp(Panel.JOURNAL, event.option)}
      />
      <sprite
        x={StoneX.X3}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.INVENTORY)}
        hide={inventoryHidden}
        options={[SidePanelOps.at(Panel.INVENTORY) ?? '']}
        onOptionSelect={(event) => stretchTabOp(Panel.INVENTORY, event.option)}
      />
      <sprite
        x={StoneX.X4}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.EQUIPMENT)}
        hide={equipmentHidden}
        options={[SidePanelOps.at(Panel.EQUIPMENT) ?? '']}
        onOptionSelect={(event) => stretchTabOp(Panel.EQUIPMENT, event.option)}
      />
      <sprite
        x={StoneX.X5}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.PRAYER)}
        hide={prayerHidden}
        options={[SidePanelOps.at(Panel.PRAYER) ?? '', prayerOp2]}
        onOptionSelect={(event) => stretchTabOp(Panel.PRAYER, event.option)}
      />
      <sprite
        x={StoneX.X6}
        y={0}
        w={Frame.STONE_END_W}
        h={Frame.STONE_H}
        sprite={stoneSprite(Panel.MAGIC)}
        hide={magicHidden}
        options={[SidePanelOps.at(Panel.MAGIC) ?? '', magicOp2]}
        onOptionSelect={(event) => stretchTabOp(Panel.MAGIC, event.option)}
      />
      <sprite
        x={StoneX.ICON_END_LEFT}
        y={0}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={combatIcon}
        hide={combatHidden}
      />
      <sprite x={StoneX.X1} y={0} w={Frame.ICON_W} h={Frame.ICON_H} sprite={Sprites.SIDE_ICONS_1} hide={skillsHidden} />
      <sprite x={StoneX.X2} y={0} w={Frame.ICON_W} h={Frame.ICON_H} sprite={journalIcon} hide={journalHidden} />
      <sprite
        x={StoneX.X3}
        y={0}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={Sprites.SIDE_ICONS_3}
        hide={inventoryHidden}
      />
      <sprite
        x={StoneX.X4}
        y={0}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={Sprites.SIDE_ICONS_4}
        hide={equipmentHidden}
      />
      <sprite x={StoneX.X5} y={0} w={Frame.ICON_W} h={Frame.ICON_H} sprite={prayerIcon} hide={prayerHidden} />
      <sprite x={StoneX.ICON_END_RIGHT} y={0} w={Frame.ICON_W} h={Frame.ICON_H} sprite={magicIcon} hide={magicHidden} />
    </>
  );
}

function SideBottomTabs(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
