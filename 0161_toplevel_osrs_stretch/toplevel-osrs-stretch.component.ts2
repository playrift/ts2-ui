            w={32}
            h={32}
            npcHead={742}
            anim={Animations.CHATIDLENEU1}
            pitch={105}
            yaw={0}
            zoom={650}
            onTimer={(event) => {
              const t: Int = clientClock() - phaseStart;
              if (t >= Wedding.TURN_DELAY) {
                event.self.props = {
                  offsetX: 0,
                  offsetY: 0,
                  pitch: 105,
                  yaw: weddingHeadYaw(0, 213, t),
                  roll: 0,
                  zoom: 650,
                };
              }
            }}
          />
          <text
            x="center"
            y={{ center: 90 }}
            w="fill"
            h={80}
            font={Fonts.QUILL_OBLIQUE_LARGE}
            color={0x680038}
            shadow
            align="center"
            valign="middle"
            lineHeight={0}
            text={'Snowflake & My Arm<br>forever'}
          />
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={0x000000}
            fill
            transparency={0}
            onTimer={(event) => {
              const t: Int = clientClock() - phaseStart;
              if (t < Wedding.HUD_END) {
                event.self.transparency = weddingCover(t);
              }
            }}
          />
        </>
      ) : null}
      {until >= 0 ? (
        <text
          x="center"
          y={0}
          w="fill"
          h="33.33%"
          font={Fonts.QUILL_OBLIQUE_LARGE}
          color={0xff981f}
          shadow
          align="center"
          valign="middle"
          lineHeight={0}
          text="<col=ffffff>F12</col>: Exit<br><col=ffffff>PageUP</col>: Faster<br><col=ffffff>PageDOWN</col>: Slower<br>"
          onTimer={() => {
            if (clientClock() >= until) {
              endSpectatorHint();
            }
          }}
        />
      ) : null}
    </layer>
  );
}

function FlashHighlight(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const flashside: Int = useServerState(Varbits.FLASHSIDE);
  const [selected] = useState(toplevelPanel);
  const hideSide: Boolean = cutsceneHidesSide();
  const tab: Int = flashside - 1;
  let shown: Boolean = false;
  if (tab >= 0 && tab < Panel.COUNT && tab !== selected && !hideSide && !CS2.if_sub_has(sidemodalRef)) {
    shown = true;
  }
  const border = HighlightBorders.at(0);
  const pulse = HighlightPulses.at(0);
  const width: Int = border === null ? 1 : Math.max(1, border.width);
  const padding: Int = border === null ? 0 : border.padding;
  const colour: Int = border === null ? 0x00ffff : border.colour;
  const a: Int = pulse === null ? 220 : pulse.transparencyRangeSlot0;
  const b: Int = pulse === null ? 0 : pulse.transparencyRangeSlot1;
  const step: Int = pulse === null ? 30 : pulse.stepDuration;
  const grow: Int = width * 2 + padding * 2;
  const boxX: Int = universe.width - Frame.SIDE_MENU_W + tabIconX(tab) - grow / 2;
  const boxY: Int = universe.height - tabRowFromBottom(tab) - Frame.ROW_H - grow / 2;
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {shown ? (
        <layer x={boxX} y={boxY} w={Frame.ICON_W + grow} h={Frame.ICON_H + grow}>
          <rect
            x={{ center: 0 }}
            y={{ center: 0 }}
            w={{ fill: 0 }}
            h={{ fill: 0 }}
            color={colour}
            transparency={0}
            onTimer={(event) => {
              event.self.transparency = pulseTransparency(a, b, step);
            }}
          />
          <rect
            x={{ center: 0 }}
            y={{ center: 0 }}
            w={{ fill: 2 }}
            h={{ fill: 2 }}
            color={colour}
            transparency={0}
            onTimer={(event) => {
              event.self.transparency = pulseTransparency(a, b, step);
            }}
          />
        </layer>
      ) : null}
    </layer>
  );
}

function CompassOps(): Component {
  const state: Int = useServerState(Varbits.MINIMAP_STATE);
  let live: Boolean = true;
  if (state === 3 || state === 4 || state === 5) {
    live = false;
  }
  return (
    <>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        options={live ? ['Look North', 'Look East', 'Look South', 'Look West'] : undefined}
        onOptionSelect={live ? (event) => compassOp(event.option) : undefined}
      />
    </>
  );
}

function GravestoneTimer(): Component {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const tliHide: Int = useServerState(Varbits.GRAVESTONE_TLI_HIDE);
  const [ticks] = useState(stretchGraveTicks);
  const [elapsed] = useState(stretchGraveElapsed);
  let shown: Boolean = true;
  if (duration <= 0 || tliHide === 1) {
    shown = false;
  }
  const hidden: Boolean = !shown;
  let long: Boolean = false;
  if (duration > 1500) {
    long = true;
  }
  let label: String = '---';
  let colour: Int = 0x9f9f9f;
  if (shown && !long) {
    let total: Int = ticks;
    if (total === -1) {
      total = duration * 30;
    }
    const seconds: Int = Math.max(1, (total - elapsed) / 50);
    const minutes: Int = seconds / 60;
    const rest: Int = seconds % 60;
    label = rest >= 10 ? `${minutes}:${rest}` : `${minutes}:0${rest}`;
    colour = tobHudNameFlasher();
  }
  useWatch(Varbits.GRAVESTONE_DURATION, () => stretchGraveResynch());
  useInterval(() => {
    const [start] = useState(stretchGraveStart);
    const [, setElapsed] = useState(stretchGraveElapsed);
    if (start !== -1) {
      setElapsed(Math.min(clientClock() - start, 90));
    }
  });
  return (
    <>
      <sprite x="center" y={1} w={13} h={13} sprite={Sprites.MOD_ICONS_INTERFACE_21} hide={hidden} />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        align="center"
        valign="bottom"
        shadow
        color={colour}
        text={label}
        hide={hidden}
      />
    </>
  );
}

function stretchGraveResynch(): void {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const [, setTicks] = useState(stretchGraveTicks);
  const [, setStart] = useState(stretchGraveStart);
  const [, setElapsed] = useState(stretchGraveElapsed);
  if (duration <= 0 || duration > 1500) {
    setTicks(-1);
    setStart(-1);
    setElapsed(0);
    return;
  }
  setTicks(duration * 30);
  setStart(clientClock());
  setElapsed(0);
}
