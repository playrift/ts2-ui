            y={{ bottom: Layout.MES_BUTTON_Y }}
            w={Layout.MES_BUTTON}
            h={Layout.MES_BUTTON}
            hide
            noClickThrough
          />
          <layer
            static
            ref={mesButton2Ref}
            x="center"
            y={{ bottom: Layout.MES_BUTTON_Y }}
            w={Layout.MES_BUTTON}
            h={Layout.MES_BUTTON}
            hide
            noClickThrough
          />
          <layer
            static
