  Layout,
  achievementClickRef,
  chatBackgroundRef,
  chatareaRef,
  chatboxAreaRef,
  chatcrmRef,
  chatdisplayRef,
  chatmodalRef,
  chatoverlayRef,
  controlsBackgroundRef,
  controlsGraphicRef,
  controlsRef,
  crmCloseGraphicRef,
  crmCloseRef,
  crmContentRef,
  crmPlateRef,
  crmspaceRef,
  inputClickareaRef,
  inputLineRef,
  line0Ref,
  mesButton1Ref,
  mesButton2Ref,
  mesButton3Ref,
  mesCloseRef,
  mesKeyboardRef,
  mesLayerRef,
  mesListRef,
  mesScrollAreaRef,
  mesScrollBarRef,
  mesText2Ref,
  mesTextRef,
  mesToggleRef,
  openInputRef,
  reportGraphicRef,
  reportRef,
  tab0PlateRef,
  tab0Ref,
  tab1PlateRef,
  tab1Ref,
  tab1StateRef,
  tab2PlateRef,
  tab2Ref,
  tab2StateRef,
  tab3PlateRef,
  tab3Ref,
  tab3StateRef,
  tab4PlateRef,
  tab4Ref,
  tab4StateRef,
  tab5PlateRef,
  tab5Ref,
  tab5StateRef,
  tab6CaptionRef,
  tab6PlateRef,
  tab6Ref,
  tab6StateRef,
} from './chatbox.constants';
import { ChatBackdrop, ChatHairlines, ChatStripPlate } from './chatbox-backdrop.component';
import { MeslayerEchoRow, MeslayerPromptRow } from './meslayer.component';
import { MessageLines } from './message-lines.component';
import { chatboxOpenInput, meslayerCloseEntrypoint } from './meslayer';
import { graphicSwapperUnlessMobile } from '../lib/lib.helpers';

export function Chatbox(): Component {
  return (
