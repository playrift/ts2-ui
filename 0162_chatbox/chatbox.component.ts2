        >
          <sprite
            static
            ref={tab1PlateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            sprite={ChatboxSprites.TAB_IDLE}
          />
          <text
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            text="Game<br> "
            font={ChatboxFonts.TAB}
            color={ChatboxColor.CAPTION}
            align="center"
            valign="middle"
            shadow
          />
          <text
            static
            ref={tab1StateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            font={ChatboxFonts.TAB}
            color={ChatboxColor.TAB_STATE}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer
