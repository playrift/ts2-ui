        >
          <sprite
            static
            ref={tab3PlateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            sprite={ChatboxSprites.TAB_IDLE}
          />
          <text
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            text="Private<br> "
            font={ChatboxFonts.TAB}
            color={ChatboxColor.CAPTION}
            align="center"
            valign="middle"
            shadow
          />
          <text
            static
            ref={tab3StateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            font={ChatboxFonts.TAB}
            color={ChatboxColor.TAB_STATE}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer
          static
          ref={tab4Ref}
          x={Layout.TAB0_X + Layout.TAB_PITCH * 4}
          y="center"
          w={Layout.TAB_W}
          h="fill"
          options={[
            'Switch tab',
            '',
            '<col=ffff00>Channel:</col> Show all',
            '<col=ffff00>Channel:</col> Show friends',
            '<col=ffff00>Channel:</col> Show none',
            '',
            '<col=ffff00>Channel:</col> Clear history',
          ]}
        >
          <sprite
            static
            ref={tab4PlateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            sprite={ChatboxSprites.TAB_IDLE}
          />
          <text
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            text="Channel<br> "
            font={ChatboxFonts.TAB}
            color={ChatboxColor.CAPTION}
            align="center"
            valign="middle"
            shadow
          />
          <text
            static
            ref={tab4StateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            font={ChatboxFonts.TAB}
            color={ChatboxColor.TAB_STATE}
            align="center"
            valign="middle"
            shadow
          />
