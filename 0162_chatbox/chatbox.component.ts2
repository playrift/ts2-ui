            '<col=ffff00>Public:</col> Show standard',
            '<col=ffff00>Public:</col> Show friends',
            '<col=ffff00>Public:</col> Show none',
            '<col=ffff00>Public:</col> Hide',
            '<col=ffff00>Public:</col> Clear history',
            '<col=00ff00>Filter public chat</col>',
