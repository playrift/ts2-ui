              x={{ right: Layout.MES_BAR_RIGHT }}
              y="center"
              w={Layout.MES_BAR_W}
              h={{ fill: Layout.MES_PANE_INSET_H }}
            />
            <layer
              static
              ref={mesToggleRef}
              x="center"
              y="bottom"
              w={Layout.MES_TOGGLE}
              h={Layout.MES_TOGGLE}
              options={['Toggle']}
            />
          </layer>
        </layer>

        <layer static ref={chatdisplayRef} x="center" y="center" w="fill" h="fill">
          <layer
            static
