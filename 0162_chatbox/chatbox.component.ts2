          </layer>

          <layer static ref={crmspaceRef} x="center" y="center" w="fill" h="fill" hide>
            <layer x={{ center: Layout.CRM_X }} y={{ center: Layout.CRM_Y }} w={Layout.CRM_W} h={Layout.CRM_H}>
              <layer static ref={crmContentRef} x="center" y="center" w="fill" h="fill" />
