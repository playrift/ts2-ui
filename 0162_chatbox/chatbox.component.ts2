            ref={tab2StateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            font={ChatboxFonts.TAB}
            color={ChatboxColor.TAB_STATE}
            align="center"
            valign="middle"
            shadow
          />
