          x={Layout.TAB0_X}
          y="center"
          w={Layout.TAB_W}
          h="fill"
          options={[
            'Switch tab',
            '<col=ffff00>Set chat mode:</col> Public (/@p)',
            '<col=ffff00>Set chat mode:</col> Channel (/@f)',
            '<col=ffff00>Set chat mode:</col> Clan (/@c)',
            '<col=ffff00>Set chat mode:</col> Guest Clan (/@gc)',
            '<col=ffff00>Set chat mode:</col> Group (/@g)',
          ]}
        >
          <sprite
            static
            ref={tab0PlateRef}
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            sprite={ChatboxSprites.TAB_IDLE}
          />
          <text
            x="center"
            y={{ bottom: Layout.PLATE_Y }}
            w="fill"
            h={Layout.CAPTION_H}
            text="All"
            font={ChatboxFonts.TAB}
            color={ChatboxColor.CAPTION}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer
