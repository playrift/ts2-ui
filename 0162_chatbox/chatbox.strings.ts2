import { CS2 } from 'ts2';

import { stringToIntLimit } from '../0665_myq5_tomb_puzzle/myq5-tomb-puzzle.state';

export function boolToInt(value: Boolean): Int {
  return value ? 1 : 0;
}

export function stringToInt(text: String): Int {
  return stringToIntLimit(text, -1);
}

export function stringIsNullOrEmpty(text: String): Boolean {
  if (CS2.compare(text, 'null') === 0 || CS2.compare(text, '') === 0) {
    return true;
  }
  return false;
}

export function stringTrimLeft(text: String): String {
  let at: Int = 0;
  const length: Int = CS2.string_length(text);
  while (at < length) {
    if (CS2.compare(CS2.substring(text, at, at + 1), ' ') !== 0) {
      return CS2.substring(text, at, length);
    }
    at = at + 1;
  }
  return '';
}

export function stringTrimRight(text: String): String {
  let at: Int = CS2.string_length(text);
  while (at > 0) {
    if (CS2.compare(CS2.substring(text, at - 1, at), ' ') !== 0) {
      return CS2.substring(text, 0, at);
    }
    at = at - 1;
  }
  return '';
}

export function stringTrim(text: String): String {
  return stringTrimLeft(stringTrimRight(text));
}

export function hasModCrown(name: String): Boolean {
  if (CS2.string_indexof_string(name, '<img=1>', 0) === 0 || CS2.string_indexof_string(name, '<img=0>', 0) === 0) {
    return true;
  }
  return false;
}

export function isGimNotification(body: String): Boolean {
  if (CS2.string_length(body) > 0 && CS2.compare(CS2.substring(body, 0, 1), '|') === 0) {
    return true;
  }
  return false;
}

export function isPvpArenaNotification(body: String): Boolean {
  if (CS2.string_length(body) >= 2 && CS2.compare(CS2.substring(body, 0, 2), 'p|') === 0) {
    return true;
  }
  return false;
}

export function leagueChatIcon(): String {
  return '<img=22>';
}
