import { CS2, useState } from 'ts2';

import {
  chatLastbroadcastTime,
  chatinput,
  chatout0,
  chatout1,
  chatout10,
  chatout11,
  chatout12,
  chatout13,
  chatout14,
  chatout15,
  chatout16,
  chatout17,
  chatout18,
  chatout19,
  chatout2,
  chatout3,
  chatout4,
  chatout5,
  chatout6,
  chatout7,
  chatout8,
  chatout9,
  chatoutReadpos,
  chatoutWritepos,
  broadcastClearedTime,
  lastPmReceivedSender,
} from '../lib/game/varcs';

export const CHATOUT_SLOTS = 20;

export function chatoutGet(slot: Int): String {
  const [s0] = useState(chatout0);
  const [s1] = useState(chatout1);
  const [s2] = useState(chatout2);
  const [s3] = useState(chatout3);
  const [s4] = useState(chatout4);
  const [s5] = useState(chatout5);
  const [s6] = useState(chatout6);
  const [s7] = useState(chatout7);
  const [s8] = useState(chatout8);
  const [s9] = useState(chatout9);
  const [s10] = useState(chatout10);
  const [s11] = useState(chatout11);
  const [s12] = useState(chatout12);
  const [s13] = useState(chatout13);
  const [s14] = useState(chatout14);
  const [s15] = useState(chatout15);
  const [s16] = useState(chatout16);
  const [s17] = useState(chatout17);
  const [s18] = useState(chatout18);
  const [s19] = useState(chatout19);
  if (slot === 0) return s0;
  if (slot === 1) return s1;
  if (slot === 2) return s2;
  if (slot === 3) return s3;
  if (slot === 4) return s4;
  if (slot === 5) return s5;
  if (slot === 6) return s6;
  if (slot === 7) return s7;
  if (slot === 8) return s8;
  if (slot === 9) return s9;
  if (slot === 10) return s10;
  if (slot === 11) return s11;
  if (slot === 12) return s12;
  if (slot === 13) return s13;
  if (slot === 14) return s14;
  if (slot === 15) return s15;
  if (slot === 16) return s16;
  if (slot === 17) return s17;
  if (slot === 18) return s18;
  if (slot === 19) return s19;
  return '';
}

export function chatoutSet(slot: Int, line: String): void {
  const [, s0] = useState(chatout0);
  const [, s1] = useState(chatout1);
  const [, s2] = useState(chatout2);
  const [, s3] = useState(chatout3);
  const [, s4] = useState(chatout4);
  const [, s5] = useState(chatout5);
  const [, s6] = useState(chatout6);
  const [, s7] = useState(chatout7);
  const [, s8] = useState(chatout8);
  const [, s9] = useState(chatout9);
  const [, s10] = useState(chatout10);
  const [, s11] = useState(chatout11);
  const [, s12] = useState(chatout12);
  const [, s13] = useState(chatout13);
  const [, s14] = useState(chatout14);
  const [, s15] = useState(chatout15);
  const [, s16] = useState(chatout16);
  const [, s17] = useState(chatout17);
  const [, s18] = useState(chatout18);
  const [, s19] = useState(chatout19);
  if (slot === 0) {
    s0(line);
  } else if (slot === 1) {
    s1(line);
  } else if (slot === 2) {
    s2(line);
  } else if (slot === 3) {
    s3(line);
  } else if (slot === 4) {
    s4(line);
  } else if (slot === 5) {
    s5(line);
  } else if (slot === 6) {
    s6(line);
  } else if (slot === 7) {
    s7(line);
  } else if (slot === 8) {
    s8(line);
  } else if (slot === 9) {
    s9(line);
  } else if (slot === 10) {
    s10(line);
  } else if (slot === 11) {
    s11(line);
  } else if (slot === 12) {
    s12(line);
  } else if (slot === 13) {
    s13(line);
  } else if (slot === 14) {
    s14(line);
  } else if (slot === 15) {
    s15(line);
  } else if (slot === 16) {
    s16(line);
  } else if (slot === 17) {
    s17(line);
  } else if (slot === 18) {
    s18(line);
  } else if (slot === 19) {
    s19(line);
  }
}

export function chatoutAdd(line: String): void {
  const [writepos, setWritepos] = useState(chatoutWritepos);
  const [, setReadpos] = useState(chatoutReadpos);
  chatoutSet(writepos, line);
  let next: Int = writepos + 1;
  if (next >= CHATOUT_SLOTS) {
    next = 0;
  }
  setWritepos(next);
  setReadpos(-1);
}

export function chatoutScrollUp(): void {
  const [readpos, setReadpos] = useState(chatoutReadpos);
  const [writepos] = useState(chatoutWritepos);
  const [, setInput] = useState(chatinput);

  let at: Int = readpos;
  if (at === -1) {
    at = writepos;
  }
  if (readpos !== writepos) {
    at = at - 1;
    if (at < 0) {
      at = CHATOUT_SLOTS - 1;
    }
    const line: String = chatoutGet(at);
    if (CS2.string_length(line) > 0) {
      setInput(line);
      setReadpos(at);
    }
  }
}

export function chatoutScrollDown(): void {
  const [readpos, setReadpos] = useState(chatoutReadpos);
  const [writepos] = useState(chatoutWritepos);
  const [, setInput] = useState(chatinput);

  if (readpos !== -1) {
    let at: Int = readpos + 1;
    if (at >= CHATOUT_SLOTS) {
      at = 0;
    }
    setReadpos(at);
    if (at === writepos) {
      setInput('');
      setReadpos(-1);
    } else {
      const line: String = chatoutGet(at);
      if (CS2.string_length(line) > 0) {
        setInput(line);
      }
    }
  }
}

export function newestChatUid(): Int {
  let newestUid: Int = -1;
  let newestStamp: Int = MIN_INT;
  let newestPmStamp: Int = MIN_INT;
  const [, setLastPm] = useState(lastPmReceivedSender);
  const [, setLastBroadcast] = useState(chatLastbroadcastTime);
  const [broadcastCleared] = useState(broadcastClearedTime);

  let type: Int = 0;
  while (type <= LAST_CHAT_TYPE) {
    if (CS2.chat_history_length_get(type) > 0) {
      const [uid, stamp, sender, _title, _body, _friend, _prefix, _mode] = CS2.chat_history_by_type_and_line_get(
        type,
        0,
      );
      if (stamp > newestStamp || uid > newestUid) {
        newestStamp = stamp;
        newestUid = uid;
      }
      if (type === CHATTYPE_PRIVATE || type === CHATTYPE_PRIVATE_OUT || type === CHATTYPE_MOD_PRIVATE) {
        if (stamp > newestPmStamp) {
          newestPmStamp = stamp;
          setLastPm(CS2.tags_remove(sender));
        }
      } else if (type === CHATTYPE_BROADCAST) {
        if (uid !== -1 && stamp >= broadcastCleared && stamp > CS2.clientclock() - BROADCAST_FADE_MS) {
          setLastBroadcast(stamp);
        }
      }
    }
    type = type + 1;
  }
  return newestUid;
}

const MIN_INT = -2147483648;
const LAST_CHAT_TYPE = 118;
const CHATTYPE_PRIVATE = 3;
const CHATTYPE_PRIVATE_OUT = 6;
const CHATTYPE_MOD_PRIVATE = 7;
const CHATTYPE_BROADCAST = 14;
const BROADCAST_FADE_MS = 3000;
