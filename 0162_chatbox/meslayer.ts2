export function meslayerMode18(): void {
  const [snapshot] = useState(snapshotOpen);
  if (snapshot === 1) {
    CS2.if_close();
  }
  meslayerOpen(18);
  const [, setPrompt] = useState(meslayerPromptText);
  setPrompt('Show players whose names contain the following text:');
  meslayerEcho('');
  bindPromptKeys();
  CS2.if_on_dialog_abort_set(null, mesText2Ref);
  if (onMobile()) {
    keyboardShow(KEYBOARD_STRING, SEARCH_LIMIT);
  }
}

export function meslayerMode6(name: String): void {
  if (useServerState(Varbits.HAS_DISPLAYNAME_TRANSMITTER) === 0) {
    CS2.message('You must set a name before you can chat.');
    return;
  }
  const [snapshot] = useState(snapshotOpen);
  if (snapshot === 1) {
    CS2.message("You can't do that right now.");
    return;
  }
  const [, setTarget] = useState(friendtomessage);
  setTarget(name);
  meslayerOpen(6);
  const [, setPrompt] = useState(meslayerPromptText);
  setPrompt(`Enter message to send to ${name}`);
  meslayerEcho('');
  bindPromptKeys();
  if (onMobile()) {
    keyboardShow(KEYBOARD_STRING, CHAT_LIMIT);
  }
}

export function meslayerMode12(): void {
  const [snapshot] = useState(snapshotOpen);
  if (snapshot === 1) {
    CS2.if_close();
  }
  meslayerOpen(12);
  if (CS2.string_length(CS2.chat_message_filter_get()) > 0) {
    CS2.chat_message_filter_set('');
  }
  meslayerEcho('');
  meslayerMode12SetPrompt();
  bindPromptKeys();
  if (onMobile()) {
    keyboardShow(KEYBOARD_STRING, FILTER_LIMIT);
  }
}

export function meslayerMode12SetPrompt(): void {
  const [typed] = useState(meslayerinput);
  const [, setPrompt] = useState(meslayerPromptText);
  if (CS2.string_length(typed) > 0) {
    setPrompt(`Filter public chat: <col=0000ff>${CS2.escape(CS2.lowercase(typed))}</col>`);
  } else {
    setPrompt('Filter public chat: <col=7f0000>[no filter]</col>');
  }
}

export function meslayerMode13(): void {
  const [snapshot] = useState(snapshotOpen);
  if (snapshot === 1) {
    CS2.if_close();
  }
  if (useServerState(Varbits.HAS_DISPLAYNAME_TRANSMITTER) === 0) {
    CS2.message('You must set a name before you can chat.');
    return;
  }
  meslayerOpen(13);
  const [, setAutotyper] = useState(autotyper);
  const [, setPause] = useState(autochatPause);
  setAutotyper('');
  setPause(0);
  meslayerEcho('');
  meslayerMode13SetPrompt();
  bindPromptKeys();
  if (onMobile()) {
    keyboardShow(KEYBOARD_STRING, CHAT_LIMIT);
  }
}

export function meslayerMode13SetPrompt(): void {
  const [typed] = useState(meslayerinput);
  const [, setPrompt] = useState(meslayerPromptText);
  if (CS2.string_length(typed) > 0) {
    setPrompt(`Send autochat: <col=0000ff>${CS2.escape(typed)}</col>`);
  } else {
    setPrompt('Send autochat: <col=7f0000>[off]</col>');
  }
}

const NAME_LIMIT = 12;
const FILTER_LIMIT = 10;
const SEARCH_LIMIT = 10;

function bindPromptKeys(): void {
  CS2.if_on_key_set(null, mesText2Ref);
}

export function meslayerMode1Enabled(chatType: Int): Boolean {
  if (!(MesboxChatTypes.get(chatType) ?? false)) {
    return false;
  }
  if (chatType === 108 || chatType === 114 || chatType === 115 || chatType === 116 || chatType === 118) {
    return false;
  }
  if (inLeagueTutorial()) {
    return false;
  }
  if (inEarlySpeedrun()) {
    return false;
  }
  return true;
}

export const MesboxChatTypes = mapOf<Int, Boolean>([
  [0, true],
  [4, true],
  [26, true],
  [27, true],
  [28, true],
  [29, true],
  [30, true],
  [31, true],
  [99, true],
  [105, true],
  [106, true],
  [107, true],
  [108, true],
  [114, true],
  [115, true],
  [116, true],
  [118, true],
]);

function inEarlySpeedrun(): Boolean {
  if (!speedrunWorld()) {
    return false;
  }
  return useServerState(Varbits.SPEEDRUNNING_INTRO) < SPEEDRUN_INTRO_DONE;
}

const SPEEDRUN_INTRO_DONE = 3;

function textColourSwapper(component: ComponentId, colour: Int): void {
  if (CS2.if_find(component)) {
    CS2.cc_colour_set(colour);
  }
}

const MAX_INT = 2147483647;
