import { useState } from 'ts2';

import { HelperFlags, Panel } from '../0548_toplevel/toplevel.constants';
import { desktopToplevelInit, switchSidePanel } from '../0548_toplevel/toplevel.helpers';
import { toplevelPanel } from '../lib/game/varcs';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { PreEocInset, helperContentRef, helperDodgerRef } from './toplevel-pre-eoc.constants';

export function preEocToplevelInit(): void {
  desktopToplevelInit(ToplevelComponents.PRE_EOC, true);
}

export function preEocHelperInit(): void {
  if (onMobile()) {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.MOBILE, Anchor.LEFT, Anchor.TOP, 1);
  } else {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.DESKTOP, Anchor.LEFT, Anchor.TOP, 1);
  }
}

export function preEocTabOp(panel: Int, option: Int): void {
  if (option !== 1) {
    return;
  }
  const [selected] = useState(toplevelPanel);
  if (selected === panel) {
    switchSidePanel(Panel.NONE, 0, true);
    return;
  }
  switchSidePanel(panel, 0, true);
}

export function preEocLogoutOp(option: Int): void {
  preEocTabOp(Panel.LOGOUT, option);
}

export function preEocInsetRight(clamp: Int, frameW: Int, viewW: Int): Int {
  if (clamp === 0) {
    return PreEocInset.RIGHT;
  }
  return Math.max(0, PreEocInset.RIGHT - Math.max(0, frameW - viewW) / 2);
}

export function preEocInsetBottom(clamp: Int, frameH: Int, viewH: Int): Int {
  if (clamp === 0) {
    return PreEocInset.BOTTOM;
  }
  return Math.max(0, PreEocInset.BOTTOM - Math.max(0, frameH - viewH) / 2);
}
