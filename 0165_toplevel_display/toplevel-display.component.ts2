import { CS2, Engine, onMounted, onUpdated, useRerenderOn, useServerState, useState } from 'ts2';

import { cameraZoom } from '../0016_oculus/oculus.camera';
import { EhcHooks } from '../0548_toplevel/toplevel.component';
import { Resize } from '../0548_toplevel/toplevel.constants';
import { desktopFov } from '../0548_toplevel/toplevel.helpers';
import { applyClientSettings, applySavedZoom, touchBuffBarDodgers } from '../0601_toplevel_osm/toplevel-osm.helpers';
import { Varbits } from '../lib/game/varbits';
import { toplevelMainmodalBgTrans } from '../lib/game/varcs';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import {
  blackoutRef,
  buffBarRef,
  chatContainerRef,
  controlRef,
  displaymodalRef,
  ehcListenerRef,
  floaterRef,
  helperContentRef,
  helperDodgerRef,
  helperRef,
  hpbarHudRef,
  layersRef,
  maincrmRef,
  mainmodalRef,
  mouseoverRef,
  notificationsRef,
  orbsRef,
  overlayAtmosphereRef,
  overlayHudRef,
  pmContainerRef,
  popoutRef,
  pvpIconsRef,
  side0Ref,
  side10Ref,
  side11Ref,
  side12Ref,
  side13Ref,
  side1Ref,
  side2Ref,
  side3Ref,
  side4Ref,
  side5Ref,
  side6Ref,
  side7Ref,
  side8Ref,
  side9Ref,
  sidecrmRef,
  sidemodalRef,
  statBoostsHudRef,
  uiHighlightsRef,
  xpDropsRef,
  zeahRef,
} from './toplevel-display.constants';
import { displayHelperInit, displayToplevelInit } from './toplevel-display.helpers';

export function ToplevelDisplay(): Component {
  return (
    <>
      <layer static ref={layersRef} x={0} y={0} w={1} h={1}>
        <layer static ref={chatContainerRef} x={0} y={0} w={1} h={1} />
        <layer static ref={helperRef} x={0} y={0} w={1} h={1}>
          <layer static ref={helperDodgerRef} x={0} y={0} w={1} h={1} onLoad={() => displayHelperInit()}>
            <layer static ref={helperContentRef} x={0} y={0} w={1} h={1} />
          </layer>
        </layer>
        <layer static ref={statBoostsHudRef} x={0} y={0} w={1} h={1} />
        <layer static ref={buffBarRef} x={0} y={0} w={1} h={1} />
        <layer static ref={notificationsRef} x="center" y={10} w={178} h={100} />
        <layer
          static
          ref={overlayAtmosphereRef}
          x={0}
          y={0}
          w={1}
          h={1}
          onScrollWheel={(event) => cameraZoom(event.mouseY)}
        />
        <layer static ref={hpbarHudRef} x={0} y={0} w={1} h={1} />
        <layer static ref={overlayHudRef} x={0} y={0} w={1} h={1} />
        <layer static ref={xpDropsRef} x={0} y={0} w="fill" h="fill" />
        <layer static ref={zeahRef} x={0} y={0} w={1} h={1} />
        <layer static ref={mainmodalRef} x={0} y={0} w={Resize.MODAL_W} h={Resize.MODAL_H} />
        <layer static ref={maincrmRef} x={0} y={0} w={1} h={1} />
        <layer static ref={sidemodalRef} x={0} y={0} w={1} h={1} />
        <layer static ref={side0Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side1Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side2Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side3Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side4Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side5Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side6Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side7Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side8Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side9Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side10Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side11Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side12Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={side13Ref} x={0} y={0} w={1} h={1} />
        <layer static ref={sidecrmRef} x={0} y={0} w={1} h={1} />
        <layer static ref={pvpIconsRef} x={0} y={0} w={1} h={1} />
        <layer static ref={pmContainerRef} x={0} y={0} w={1} h={1} />
        <layer static ref={orbsRef} x={0} y={0} w={1} h={1} />
        <layer static ref={ehcListenerRef} x={0} y={0} w={1} h={1}>
          <EhcHooks />
        </layer>
        <layer static ref={mouseoverRef} x={0} y={0} w={1} h={1} />
        <layer static ref={uiHighlightsRef} x={0} y={0} w={512} h={334} />
      </layer>

      <layer static ref={controlRef} x={0} y={0} w="fill" h="fill" onLoad={() => displayToplevelInit()}>
        <rect static ref={blackoutRef} x="center" y="center" w="fill" h="fill" color={0x000000} fill />
        <layer static ref={displaymodalRef} x="center" y="center" w="fill" h="fill" />
        <layer static ref={floaterRef} x="center" y="center" w="fill" h="fill" />
      </layer>

      <layer static ref={popoutRef} x="right" y={0} w={300} h="fill" />

      <layer x={0} y={0} w="fill" h="fill">
        <DisplayLayout />
      </layer>
    </>
  );
}

function DisplayLayout(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const buffBarHidden: Int = useServerState(Varbits.BUFF_BAR_HIDDEN);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  const [bgTrans] = useState(toplevelMainmodalBgTrans);
  const mobile: Boolean = onMobile();

  desktopFov(fovClamp, ToplevelComponents.DISPLAY);

  let inCutscene: Boolean = false;
  if (cutscene !== 0) {
    inCutscene = true;
  }
  let buffBarShown: Boolean = false;
  if (buffBarHidden === 0 && cutscene === 0) {
    buffBarShown = true;
  }
  const sideModalUp: Boolean = CS2.if_sub_has(sidemodalRef);
  let modalMode: Int = 0;
  if (!mobile && CS2.if_sub_has(mainmodalRef)) {
    modalMode = bgTrans;
  }
  let xpDropsInset: Int = 0;
  if (mobile) {
    xpDropsInset = minimapToggle === 0 ? Resize.MOBILE_MINIMAP : Resize.MOBILE_MINIMAP_COLLAPSED;
  }

  onMounted(() => placeDisplay(inCutscene, buffBarShown, sideModalUp, modalMode, xpDropsInset));
  onUpdated(() => placeDisplay(inCutscene, buffBarShown, sideModalUp, modalMode, xpDropsInset));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeDisplay(
  inCutscene: Boolean,
  buffBarShown: Boolean,
  sideModalUp: Boolean,
  modalMode: Int,
  xpDropsInset: Int,
): void {
  buffBarRef.props = { hide: !buffBarShown };
  pmContainerRef.props = { hide: inCutscene };
  statBoostsHudRef.props = { hide: inCutscene };
  helperRef.props = { hide: inCutscene };
  hpbarHudRef.props = { hide: inCutscene };
  mouseoverRef.props = { hide: inCutscene };
  sidecrmRef.props = { hide: sideModalUp };
  if (modalMode === Resize.MODAL_TALL) {
    mainmodalRef.props = { w: Resize.MODAL_W, h: 'fill' };
  } else if (modalMode === Resize.MODAL_FILL) {
    mainmodalRef.props = { w: 'fill', h: 'fill' };
  } else {
    mainmodalRef.props = { w: Resize.MODAL_W, h: Resize.MODAL_H };
  }
  xpDropsRef.props = { w: { fill: xpDropsInset }, h: 'fill' };
  applyClientSettings();
  applySavedZoom();
  touchBuffBarDodgers();
}
