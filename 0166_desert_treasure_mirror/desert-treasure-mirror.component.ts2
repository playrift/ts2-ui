import { onMobile } from '../lib/lib.helpers';

import { Camera, Layout, MirrorColors, MirrorModels } from './desert-treasure-mirror.constants';

export function DesertTreasureMirror(): Component {
  let washHidden: Boolean = true;
  let innerHidden: Boolean = false;
  if (onMobile()) {
    washHidden = false;
    innerHidden = true;
  }

  return (
    <>
      <rect
        w="fill"
        h="fill"
        fill
        color={MirrorColors.MOBILE_WASH}
        transparency={Layout.WASH_TRANSPARENCY}
        hide={washHidden}
      />

      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={MirrorModels.OUTER}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
        zoom={Camera.ZOOM}
      />

      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={MirrorModels.INNER}
        transparent
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
        zoom={Camera.ZOOM}
        hide={innerHidden}
      />

      <layer y="center" w="50%" h="fill">
        <rect y="center" w={{ fill: Layout.BAR_INSET }} h="fill" fill color={MirrorColors.LETTERBOX} />
      </layer>

      <layer x="right" y="center" w="50%" h="fill">
        <rect x="right" y="center" w={{ fill: Layout.BAR_INSET }} h="fill" fill color={MirrorColors.LETTERBOX} />
      </layer>
    </>
  );
}
