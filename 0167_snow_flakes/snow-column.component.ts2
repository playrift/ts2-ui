import { SnowFall } from './snow-fall.component';
import { SnowLayout } from './snow-flakes.constants';

export function SnowColumn({ column }: { column: Int }): Component {
  return (
    <layer x={column * SnowLayout.COLUMN_WIDTH} y="center" w={SnowLayout.COLUMN_WIDTH} h="fill">
      <SnowFall />
    </layer>
  );
}
