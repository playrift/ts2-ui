import { useState, useUniverse } from 'ts2';

import { SnowAnims, SnowLayout, SnowModels } from './snow-flakes.constants';
import { snowZoom } from './snow-flakes.helpers';

export function SnowFall(): Component {
  const universe = useUniverse();
  const measured: Int = universe.height;
  const [seen, setSeen] = useState(0);

  universe.onResize = () => {
    setSeen(universe.height);
  };

  const zoom: Int = snowZoom(seen === 0 ? measured : seen);

  return (
    <>
      <model
        x="center"
        y="bottom"
        w="fill"
        h={1}
        model={SnowModels.FLAKES}
        anim={SnowAnims.FLAKES}
        offsetY={SnowLayout.OFFSET_Y}
        zoom={zoom}
      />
      <model
        x="center"
        y="bottom"
        w="fill"
        h={1}
        model={SnowModels.FLAKES_ALT}
        anim={SnowAnims.FLAKES_ALT}
        offsetY={SnowLayout.OFFSET_Y}
        zoom={zoom}
      />
    </>
  );
}
