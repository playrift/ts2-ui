import { SnowColumn } from './snow-column.component';
import { SNOW_COLUMNS } from './snow-flakes.constants';

export function SnowFlakes(): Component {
  return (
    <layer w="fill" h="fill">
      {SNOW_COLUMNS.map((column) => (
        <SnowColumn column={column} />
      ))}
    </layer>
  );
}
