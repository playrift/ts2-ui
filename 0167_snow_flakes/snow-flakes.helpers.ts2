import { CS2 } from 'ts2';

import { SnowZoom } from './snow-flakes.constants';

export const snowZoom = (height: Int): Int => {
  let clamped: Int = height;
  if (clamped < SnowZoom.MIN_HEIGHT) {
    clamped = SnowZoom.MIN_HEIGHT;
  } else if (clamped > SnowZoom.MAX_HEIGHT) {
    clamped = SnowZoom.MAX_HEIGHT;
  }

  const excess: Int = CS2.invpow(clamped - SnowZoom.MIN_HEIGHT, SnowZoom.ROOT);
  const full: Int = CS2.invpow(SnowZoom.MAX_HEIGHT - SnowZoom.MIN_HEIGHT, SnowZoom.ROOT);
  return SnowZoom.NEAR - CS2.interpolate(0, excess, 0, full, SnowZoom.SPAN);
};
