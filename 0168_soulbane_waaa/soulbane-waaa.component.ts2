import { Camera, Layout, WaaaModel } from './soulbane-waaa.constants';

export function SoulbaneWaaa(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={0x000000} fill={true} />

      <model
        x="center"
        y={{ center: Layout.MODEL_Y_FROM_CENTER }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={WaaaModel.FACE}
        anim={WaaaModel.FEAR_CUT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
        offsetY={Camera.OFFSET_Y}
      />
    </>
  );
}
