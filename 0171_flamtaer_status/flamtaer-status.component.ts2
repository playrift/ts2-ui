import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { FLAMTAER_YELLOW, FlamtaerDodge, FlamtaerFonts, Layout, RowLabels, TITLE } from './flamtaer-status.constants';
import { flamtaerStatus } from './flamtaer-status.helpers';

const templeLayer = createRef('flamtaer_status_temple_layer');

const repair = createRef('flamtaer_status_repair');
const resources = createRef('flamtaer_status_resources');
const sanctity = createRef('flamtaer_status_sanctity');

export function FlamtaerStatus(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, templeLayer, FlamtaerDodge.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer
          ref={templeLayer}
          x={{ right: Layout.PLATE_RIGHT }}
          y={Layout.PLATE_TOP}
          w={Layout.PLATE_W}
          h={Layout.PLATE_H}
          onTimer={() => flamtaerStatus(repair, resources, sanctity)}
        >
          <text
            x={0}
            y={Layout.TITLE_Y}
            w="fill"
            h={Layout.TITLE_H}
            text={TITLE}
            font={FlamtaerFonts.TITLE}
            color={FLAMTAER_YELLOW}
            align="center"
            valign="middle"
            shadow
          />

          <text
            x={Layout.LABEL_X}
            y={Layout.REPAIR_LABEL.y}
            w={Layout.REPAIR_LABEL.w}
            h={Layout.REPAIR_LABEL.h}
            text={RowLabels.REPAIR}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            align="right"
            valign="middle"
            shadow
          />
          <text
            ref={repair}
            x={Layout.VALUE_X}
            y={Layout.REPAIR_VALUE_Y}
            w={Layout.VALUE_W}
            h={Layout.VALUE_H}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            shadow
          />

          <text
            x={Layout.LABEL_X}
            y={Layout.RESOURCES_LABEL.y}
            w={Layout.RESOURCES_LABEL.w}
            h={Layout.RESOURCES_LABEL.h}
            text={RowLabels.RESOURCES}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            align="right"
            valign="middle"
            shadow
          />
          <text
            ref={resources}
            x={Layout.VALUE_X}
            y={Layout.RESOURCES_VALUE_Y}
            w={Layout.VALUE_W}
            h={Layout.VALUE_H}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            shadow
          />

          <text
            x={Layout.LABEL_X}
            y={Layout.SANCTITY_LABEL.y}
            w={Layout.SANCTITY_LABEL.w}
            h={Layout.SANCTITY_LABEL.h}
            text={RowLabels.SANCTITY}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            align="right"
            valign="middle"
            shadow
          />
          <text
            ref={sanctity}
            x={Layout.VALUE_X}
            y={Layout.SANCTITY_VALUE_Y}
            w={Layout.VALUE_W}
            h={Layout.VALUE_H}
            font={FlamtaerFonts.ROW}
            color={FLAMTAER_YELLOW}
            shadow
          />
        </layer>
      </layer>
    </layer>
  );
}
