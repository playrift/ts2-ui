import { useServerState } from 'ts2';

import { Varps } from '../lib/game/varps';

export function flamtaerStatus(repair: ComponentId, resources: ComponentId, sanctity: ComponentId): void {
  const repaired: Int = useServerState(Varps.TEMPLE_REPAIRED_P);
  repair.text = `${stringOf(repaired)}%`;

  const stock: Int = useServerState(Varps.TEMPLE_RESOURCES_P);
  resources.text = `${stringOf(stock)}%`;

  const sanctified: Int = useServerState(Varps.TEMPLE_SANCTITY_P);
  sanctity.text = `${stringOf(sanctified)}%`;
}
