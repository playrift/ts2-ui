import { BoatcrashAnims, BoatcrashColors, BoatcrashModels, Camera, Layout } from './keldagrim-boatcrash.constants';

export function KeldagrimBoatcrash(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={BoatcrashColors.BACKDROP} fill />

      <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <model
          x={Layout.CANAL_X}
          y={Layout.CANAL_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={BoatcrashModels.CANAL}
          zoom={Camera.CANAL_ZOOM}
          pitch={Camera.CANAL_PITCH}
          yaw={Camera.CANAL_YAW}
        />

        <model
          x={Layout.BOAT_X}
          y={Layout.BOAT_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={BoatcrashModels.BOAT}
          zoom={Camera.BOAT_ZOOM}
          pitch={Camera.BOAT_PITCH}
          yaw={Camera.BOAT_YAW}
        />

        <model
          x={Layout.STATUE_X}
          y={Layout.STATUE_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={BoatcrashModels.STATUE}
          anim={BoatcrashAnims.STATUE}
          zoom={Camera.STATUE_ZOOM}
          pitch={Camera.STATUE_PITCH}
          yaw={Camera.STATUE_YAW}
        />
      </layer>
    </>
  );
}
