import { CS2 } from 'ts2';
import { Flash, FlashAnim, FlashModel } from './slice-flash.constants';

export function modelTransparentInit(who: ComponentId): void {
  CS2.if_model_transparent_set(true, who);
}

export function SliceFlash(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={FlashModel.FLASH}
        anim={FlashAnim.FLASH}
        zoom={Flash.ZOOM}
        onLoad={(event) => modelTransparentInit(event.self)}
      />
    </layer>
  );
}
