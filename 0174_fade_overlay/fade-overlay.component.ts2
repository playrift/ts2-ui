import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  FadeColor,
  FadeDodge,
  FadeFonts,
  FILTER_WASH,
  Layout,
  MESSAGE_TEXT,
  MESSAGE_Y,
} from './fade-overlay.constants';

const timerHost = createRef('0174_fade_overlay_timer_host');

const filter = createRef('fade_overlay_filter');

const fader = createRef('fade_overlay_fader');

export function FadeOverlay(): Component {
  useInterval(() => overlayRelayout(timerHost, -1, FadeDodge.DODGE, Anchor.LEFT, Anchor.TOP, 0), timerHost);

  return (
    <layer w="fill" h="fill">
      <rect
        ref={filter}
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={FadeColor.PLATE}
        transparency={FILTER_WASH}
      />

      <rect ref={fader} x="center" y="center" w="fill" h="fill" fill color={FadeColor.PLATE} />

      <layer w="fill" h="fill" ref={timerHost}>
        <text
          x="center"
          y={MESSAGE_Y}
          w={{ fill: Layout.MESSAGE_INSET_W }}
          h={Layout.MESSAGE_H}
          text={MESSAGE_TEXT}
          font={FadeFonts.MESSAGE}
          align="center"
          color={FadeColor.MESSAGE}
        />
      </layer>
    </layer>
  );
}
