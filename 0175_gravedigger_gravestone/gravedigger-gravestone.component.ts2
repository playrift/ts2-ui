import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { GravestoneArt, GravestoneModel, Layout } from './gravedigger-gravestone.constants';

export function GravediggerGravestone(): Component {
  return (
    <>
      <model
        x={Layout.stone.x}
        y={Layout.stone.y}
        w={Layout.stone.w}
        h={Layout.stone.h}
        model={GravestoneModel.STONE}
        zoom={GravestoneModel.STONE_ZOOM}
        pitch={GravestoneModel.STONE_PITCH}
      />

      <model
        x={Layout.profession.x}
        y={Layout.profession.y}
        w={Layout.profession.w}
        h={Layout.profession.h}
        zoom={GravestoneModel.PROFESSION_ZOOM}
        pitch={GravestoneModel.PROFESSION_PITCH}
        yaw={GravestoneModel.PROFESSION_YAW}
      />

      <sprite
        x={{ right: Layout.close.right }}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={GravestoneArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, GravestoneArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, GravestoneArt.CLOSE)}
      />
    </>
  );
}
