import { Layout, SnowAnims, SnowColors, SnowModels } from './snow-medium.constants';

export function SnowMedium(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.CENTRE_W} h="fill">
        <model
          x="center"
          y="center"
          w="fill"
          h="fill"
          model={SnowModels.FLAKES}
          anim={SnowAnims.FLAKES}
          zoom={Layout.SHEET_ZOOM}
          offsetX={Layout.SHEET_OFFSET_X}
        />
      </layer>

      <layer x={0} y="center" w={{ fill: Layout.WING_INSET }} h="fill">
        <layer x={0} y="center" w="50%" h="fill">
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={SnowModels.FLAKES}
            anim={SnowAnims.FLAKES}
            zoom={Layout.SHEET_ZOOM}
            offsetX={Layout.SHEET_OFFSET_X}
          />
        </layer>
      </layer>

      <layer x="right" y="center" w={{ fill: Layout.WING_INSET }} h="fill">
        <layer x="right" y="center" w="50%" h="fill">
          <model
            x="right"
            y="center"
            w="fill"
            h="fill"
            model={SnowModels.FLAKES}
            anim={SnowAnims.FLAKES}
            zoom={Layout.SHEET_ZOOM}
            offsetX={Layout.SHEET_OFFSET_X}
          />
        </layer>
      </layer>

      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={SnowColors.WASH}
        transparency={Layout.WASH_TRANSPARENCY}
      />
    </>
  );
}
