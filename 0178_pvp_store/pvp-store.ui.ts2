import { createRef } from 'ts2';

import { PvpStore } from './pvp-store.component';
import { Layout } from './pvp-store.constants';

const pvpStoreRef = createRef('pvp_store');

export const pvpStoreUi = (): UI => (
  <ui ref={pvpStoreRef} x="center" y="center" w={Layout.ROOT_W} h={Layout.ROOT_H}>
    <PvpStore />
  </ui>
);
