import { useServerState, useState } from 'ts2';

import { opsound } from '../lib/lib.helpers';
import { FarmingColor, FarmingFonts, FarmingSprites, FarmingVarbits, Layout, TabNames } from './farming-view.constants';
import { selectTab } from './farming-view.helpers';

export function FarmingTabs(): Component {
  const tab: Int = useServerState(FarmingVarbits.TAB);

  const [hot0, setHot0] = useState(0);
  const [hot1, setHot1] = useState(0);
  const [hot2, setHot2] = useState(0);
  const [hot3, setHot3] = useState(0);
  const [hot4, setHot4] = useState(0);
  const [hot5, setHot5] = useState(0);

  const name0: String = TabNames.at(0) ?? '';
  const name1: String = TabNames.at(1) ?? '';
  const name2: String = TabNames.at(2) ?? '';
  const name3: String = TabNames.at(3) ?? '';
  const name4: String = TabNames.at(4) ?? '';
  const name5: String = TabNames.at(5) ?? '';

  return (
    <>
      {tab === 0 ? (
        <sprite
          x={0}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name0]}
          onMouseLeave={() => {
            setHot0(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={0}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name0]}
          onMouseRepeat={() => {
            setHot0(1);
          }}
          onMouseLeave={() => {
            setHot0(0);
          }}
          onOptionSelect={() => {
            setHot0(0);
            selectTab(0);
          }}
        />
      )}
      <text
        x={0}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name0}
        font={FarmingFonts.TAB}
        color={hot0 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 1 ? (
        <sprite
          x={Layout.TAB_W}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name1]}
          onMouseLeave={() => {
            setHot1(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name1]}
          onMouseRepeat={() => {
            setHot1(1);
          }}
          onMouseLeave={() => {
            setHot1(0);
          }}
          onOptionSelect={() => {
            setHot1(0);
            selectTab(1);
          }}
        />
      )}
      <text
        x={Layout.TAB_W}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name1}
        font={FarmingFonts.TAB}
        color={hot1 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 2 ? (
        <sprite
          x={Layout.TAB_W * 2}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name2]}
          onMouseLeave={() => {
            setHot2(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 2}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name2]}
          onMouseRepeat={() => {
            setHot2(1);
          }}
          onMouseLeave={() => {
            setHot2(0);
          }}
          onOptionSelect={() => {
            setHot2(0);
            selectTab(2);
          }}
        />
      )}
      <text
        x={Layout.TAB_W * 2}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name2}
        font={FarmingFonts.TAB}
        color={hot2 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 3 ? (
        <sprite
          x={Layout.TAB_W * 3}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name3]}
          onMouseLeave={() => {
            setHot3(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 3}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name3]}
          onMouseRepeat={() => {
            setHot3(1);
          }}
          onMouseLeave={() => {
            setHot3(0);
          }}
          onOptionSelect={() => {
            setHot3(0);
            selectTab(3);
          }}
        />
      )}
      <text
        x={Layout.TAB_W * 3}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name3}
        font={FarmingFonts.TAB}
        color={hot3 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 4 ? (
        <sprite
          x={Layout.TAB_W * 4}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name4]}
          onMouseLeave={() => {
            setHot4(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 4}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name4]}
          onMouseRepeat={() => {
            setHot4(1);
          }}
          onMouseLeave={() => {
            setHot4(0);
          }}
          onOptionSelect={() => {
            setHot4(0);
            selectTab(4);
          }}
        />
      )}
      <text
        x={Layout.TAB_W * 4}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name4}
        font={FarmingFonts.TAB}
        color={hot4 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 5 ? (
        <sprite
          x={Layout.TAB_W * 5}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name5]}
          onMouseLeave={() => {
            setHot5(0);
          }}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 5}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name5]}
          onMouseRepeat={() => {
            setHot5(1);
          }}
          onMouseLeave={() => {
            setHot5(0);
          }}
          onOptionSelect={() => {
            setHot5(0);
            selectTab(5);
          }}
        />
      )}
      <text
        x={Layout.TAB_W * 5}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name5}
        font={FarmingFonts.TAB}
        color={hot5 === 1 ? FarmingColor.HOVER : FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
