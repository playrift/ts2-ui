import { useRef, useServerState } from 'ts2';

import { opsound } from '../lib/lib.helpers';
import { FarmingColor, FarmingFonts, FarmingSprites, FarmingVarbits, Layout, TabNames } from './farming-view.constants';
import { selectTab } from './farming-view.helpers';

export function FarmingTabs(): Component {
  const tab: Int = useServerState(FarmingVarbits.TAB);

  const label0 = useRef();
  const label1 = useRef();
  const label2 = useRef();
  const label3 = useRef();
  const label4 = useRef();
  const label5 = useRef();

  const name0: String = TabNames.at(0) ?? '';
  const name1: String = TabNames.at(1) ?? '';
  const name2: String = TabNames.at(2) ?? '';
  const name3: String = TabNames.at(3) ?? '';
  const name4: String = TabNames.at(4) ?? '';
  const name5: String = TabNames.at(5) ?? '';

  return (
    <>
      {tab === 0 ? (
        <sprite
          x={0}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name0]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={0}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name0]}
          onMouseRepeat={() => {
            label0.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label0.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(0)}
        />
      )}
      <text
        ref={label0}
        x={0}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name0}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 1 ? (
        <sprite
          x={Layout.TAB_W}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name1]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name1]}
          onMouseRepeat={() => {
            label1.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label1.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(1)}
        />
      )}
      <text
        ref={label1}
        x={Layout.TAB_W}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name1}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 2 ? (
        <sprite
          x={Layout.TAB_W * 2}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name2]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 2}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name2]}
          onMouseRepeat={() => {
            label2.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label2.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(2)}
        />
      )}
      <text
        ref={label2}
        x={Layout.TAB_W * 2}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name2}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 3 ? (
        <sprite
          x={Layout.TAB_W * 3}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name3]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 3}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name3]}
          onMouseRepeat={() => {
            label3.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label3.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(3)}
        />
      )}
      <text
        ref={label3}
        x={Layout.TAB_W * 3}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name3}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 4 ? (
        <sprite
          x={Layout.TAB_W * 4}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name4]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 4}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name4]}
          onMouseRepeat={() => {
            label4.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label4.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(4)}
        />
      )}
      <text
        ref={label4}
        x={Layout.TAB_W * 4}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name4}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      {tab === 5 ? (
        <sprite
          x={Layout.TAB_W * 5}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB_SELECTED}
          options={[name5]}
          onOptionSelect={() => opsound(0, 0)}
        />
      ) : (
        <sprite
          x={Layout.TAB_W * 5}
          y="center"
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          sprite={FarmingSprites.TAB}
          options={[name5]}
          onMouseRepeat={() => {
            label5.color = FarmingColor.HOVER;
          }}
          onMouseLeave={() => {
            label5.color = FarmingColor.TEXT;
          }}
          onOptionSelect={() => selectTab(5)}
        />
      )}
      <text
        ref={label5}
        x={Layout.TAB_W * 5}
        y="center"
        w={Layout.TAB_W}
        h="fill"
        text={name5}
        font={FarmingFonts.TAB}
        color={FarmingColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
