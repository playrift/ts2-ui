import { onMounted } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { Layout } from './farming-view.constants';
import { FarmingPane } from './farming-pane.component';
import { FarmingTabs } from './farming-tabs.component';
import { PatchTooltip } from './patch-tooltip.component';
import { farmingViewReset } from './farming-view.state';

export function FarmingView(): Component {
  onMounted(() => {
    farmingViewReset();
  });

  return (
    <layer x="center" y="center" w={Layout.CONTENTS_W} h={Layout.CONTENTS_H}>
      <SteelBorderEntrypoint title="Farming Patch Status" />

      <layer x="center" y={Layout.TABS_Y} w={Layout.TABS_W} h={Layout.TABS_H}>
        <FarmingTabs />
      </layer>

      <layer x="center" y={Layout.BODY_Y} w={{ fill: Layout.BODY_INSET_W }} h={{ fill: Layout.BODY_INSET_H }}>
        <FarmingPane />
      </layer>
    </layer>
  );
}

export function FarmingViewTooltip(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <PatchTooltip />
    </layer>
  );
}
