import { useRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { FarmingPatchCells } from './farming-view.cells';
import { FarmingSprites, Layout } from './farming-view.constants';
import { FarmingTabs } from './farming-tabs.component';
import { PatchTooltip } from './patch-tooltip.component';

export function FarmingView(): Component {
  const pane = useRef();

  return (
    <layer x="center" y="center" w={Layout.CONTENTS_W} h={Layout.CONTENTS_H}>
      <SteelBorderEntrypoint title="Farming Patch Status" />

      <layer x="center" y={Layout.TABS_Y} w={Layout.TABS_W} h={Layout.TABS_H}>
        <FarmingTabs />
      </layer>

      <layer x="center" y={Layout.BODY_Y} w={{ fill: Layout.BODY_INSET_W }} h={{ fill: Layout.BODY_INSET_H }}>
        <layer ref={pane} y="center" w={{ fill: Layout.PANE_INSET_W }} h="fill">
          <FarmingPatchCells />
        </layer>

        <layer x="right" y="center" w={Layout.BAR_W} h="fill">
          <ScrollbarVertical
            content={pane}
            track={FarmingSprites.BAR_TRACK}
            capTopSprite={FarmingSprites.BAR_CAP_TOP}
            thumbSprite={FarmingSprites.BAR_THUMB}
            capBottomSprite={FarmingSprites.BAR_CAP_BOTTOM}
            arrowUp={FarmingSprites.BAR_ARROW_UP}
            arrowDown={FarmingSprites.BAR_ARROW_DOWN}
          />
        </layer>
      </layer>
    </layer>
  );
}

export function FarmingViewTooltip(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <PatchTooltip />
    </layer>
  );
}
