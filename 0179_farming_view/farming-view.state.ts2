import { sessionState } from 'ts2';

import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { Layout } from './farming-view.constants';

export const invokedPatch = sessionState(8);
export const invokedItem = sessionState(1942);
export const invokedGrowth = sessionState(3);
export const invokedLastState = sessionState(4);
export const invokedMinYield = sessionState(2);
export const invokedWatered = sessionState(1);
export const invokedFlags = sessionState(32);
export const invokedName = sessionState('allotment');

export function showPatchTooltip(): void {
  tooltipMark();
  if (tooltipDown() && tooltipDwellElapsed(Layout.TOOLTIP_DWELL)) {
    tooltipRaise();
  }
}

export function hidePatchTooltip(): void {
  tooltipHide();
}
