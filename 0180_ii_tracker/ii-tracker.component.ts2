import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import {
  II_TRACKER_TITLE,
  IiTrackerColor,
  IiTrackerFonts,
  IiTrackerTab,
  Layout,
  TabSprites,
} from './ii-tracker.constants';
import { iiTrackerTabSelect } from './ii-tracker.helpers';
import {
  leftTab1,
  leftTab2,
  middleTab1,
  middleTab2,
  puroGrid,
  puroScrollbar,
  rightTab1,
  rightTab2,
  surfaceGrid,
  surfaceScrollbar,
} from './ii-tracker.refs';

export function IiTracker(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_W_INSET }} h={{ fill: Layout.ROOT_H_INSET }}>
      <SteelBorderEntrypoint title={II_TRACKER_TITLE} />

      <layer
        x="center"
        y={Layout.CONTENTS_Y}
        w={{ fill: Layout.CONTENTS_W_INSET }}
        h={{ fill: Layout.CONTENTS_H_INSET }}
      >
        <layer
          ref={surfaceScrollbar}
          x={{ right: Layout.SCROLLBAR_RIGHT }}
          y={Layout.SCROLLBAR_Y}
          w={Layout.SCROLLBAR_W}
          h={{ fill: Layout.SCROLLBAR_H_INSET }}
        />

        <layer
          ref={surfaceGrid}
          x={Layout.GRID_X}
          y={Layout.GRID_Y}
          w={{ fill: Layout.GRID_W_INSET }}
          h={{ fill: Layout.GRID_H_INSET }}
        >
          <layer w="fill" h="fill" />
          <layer w="fill" h="fill" />
        </layer>

        <layer
          ref={puroScrollbar}
          x={{ right: Layout.SCROLLBAR_RIGHT }}
          y={Layout.SCROLLBAR_Y}
          w={Layout.SCROLLBAR_W}
          h={{ fill: Layout.SCROLLBAR_H_INSET }}
        />

        <layer
          ref={puroGrid}
          x={Layout.GRID_X}
          y={Layout.GRID_Y}
          w={{ fill: Layout.GRID_W_INSET }}
          h={{ fill: Layout.GRID_H_INSET }}
          hide
        >
          <layer w="fill" h="fill" />
          <layer w="fill" h="fill" />
        </layer>

        <layer x="center" y={0} w="fill" h={Layout.TABS_H}>
          <rect x="right" y="bottom" w={{ fill: Layout.RULE_W_INSET }} h={Layout.RULE_H} color={IiTrackerColor.RULE} />

          <layer
            x={Layout.TAB_1_X}
            y={0}
            w={Layout.TAB_W}
            h="fill"
            options={['Select']}
            onOptionSelect={() => iiTrackerTabSelect(IiTrackerTab.SURFACE)}
          >
            <sprite ref={leftTab1} x={0} y={0} w={Layout.TAB_END_W} h={Layout.TAB_SKIN_H} sprite={TabSprites.ON_LEFT} />
            <sprite
              ref={middleTab1}
              x="center"
              y={0}
              w={{ fill: Layout.TAB_MIDDLE_W_INSET }}
              h={Layout.TAB_SKIN_H}
              sprite={TabSprites.ON_MIDDLE}
              tiling
            />
            <sprite
              ref={rightTab1}
              x="right"
              y={0}
              w={Layout.TAB_END_W}
              h={Layout.TAB_SKIN_H}
              sprite={TabSprites.ON_RIGHT}
            />
            <text
              x={0}
              y={0}
              w="fill"
              h="fill"
              font={IiTrackerFonts.TAB}
              text="Surface World"
              align="center"
              valign="middle"
              shadow
              color={IiTrackerColor.CAPTION}
            />
          </layer>

          <layer
            x={Layout.TAB_2_X}
            y={0}
            w={Layout.TAB_W}
            h="fill"
            options={['Select']}
            onOptionSelect={() => iiTrackerTabSelect(IiTrackerTab.PURO)}
          >
            <sprite
              ref={leftTab2}
              x={0}
              y={0}
              w={Layout.TAB_END_W}
              h={Layout.TAB_SKIN_H}
              sprite={TabSprites.OFF_LEFT}
            />
            <sprite
              ref={middleTab2}
              x="center"
              y={0}
              w={{ fill: Layout.TAB_MIDDLE_W_INSET }}
              h={Layout.TAB_SKIN_H}
              sprite={TabSprites.OFF_MIDDLE}
              tiling
            />
            <sprite
              ref={rightTab2}
              x="right"
              y={0}
              w={Layout.TAB_END_W}
              h={Layout.TAB_SKIN_H}
              sprite={TabSprites.OFF_RIGHT}
            />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              font={IiTrackerFonts.TAB}
              text="Puro-Puro"
              align="center"
              valign="middle"
              shadow
              color={IiTrackerColor.CAPTION}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
