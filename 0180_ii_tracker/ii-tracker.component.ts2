import { useState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import {
  II_TRACKER_TITLE,
  IiTrackerColor,
  IiTrackerFonts,
  IiTrackerTab,
  Layout,
  TabSprites,
} from './ii-tracker.constants';
import { iiTrackerTabSelect } from './ii-tracker.helpers';
import { iiTrackerSelectedTab } from './ii-tracker.state';

export function IiTracker(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_W_INSET }} h={{ fill: Layout.ROOT_H_INSET }}>
      <SteelBorderEntrypoint title={II_TRACKER_TITLE} />

      <IiTrackerContents />
    </layer>
  );
}

function IiTrackerContents(): Component {
  const [tab] = useState(iiTrackerSelectedTab);
  const puro: Boolean = tab === IiTrackerTab.PURO;
  const surface: Boolean = tab === IiTrackerTab.SURFACE;

  return (
    <layer x="center" y={Layout.CONTENTS_Y} w={{ fill: Layout.CONTENTS_W_INSET }} h={{ fill: Layout.CONTENTS_H_INSET }}>
      <layer
        x={{ right: Layout.SCROLLBAR_RIGHT }}
        y={Layout.SCROLLBAR_Y}
        w={Layout.SCROLLBAR_W}
        h={{ fill: Layout.SCROLLBAR_H_INSET }}
        hide={puro}
      />

      <layer
        x={Layout.GRID_X}
        y={Layout.GRID_Y}
        w={{ fill: Layout.GRID_W_INSET }}
        h={{ fill: Layout.GRID_H_INSET }}
        hide={puro}
      >
        <layer w="fill" h="fill" />
        <layer w="fill" h="fill" />
      </layer>

      <layer
        x={{ right: Layout.SCROLLBAR_RIGHT }}
        y={Layout.SCROLLBAR_Y}
        w={Layout.SCROLLBAR_W}
        h={{ fill: Layout.SCROLLBAR_H_INSET }}
        hide={surface}
      />

      <layer
        x={Layout.GRID_X}
        y={Layout.GRID_Y}
        w={{ fill: Layout.GRID_W_INSET }}
        h={{ fill: Layout.GRID_H_INSET }}
        hide={!puro}
      >
        <layer w="fill" h="fill" />
        <layer w="fill" h="fill" />
      </layer>

      <layer x="center" y={0} w="fill" h={Layout.TABS_H}>
        <rect x="right" y="bottom" w={{ fill: Layout.RULE_W_INSET }} h={Layout.RULE_H} color={IiTrackerColor.RULE} />

        <layer
          x={Layout.TAB_1_X}
          y={0}
          w={Layout.TAB_W}
          h="fill"
          options={['Select']}
          onOptionSelect={() => iiTrackerTabSelect(IiTrackerTab.SURFACE)}
        >
          <sprite
            x={0}
            y={0}
            w={Layout.TAB_END_W}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.OFF_LEFT : TabSprites.ON_LEFT}
          />
          <sprite
            x="center"
            y={0}
            w={{ fill: Layout.TAB_MIDDLE_W_INSET }}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.OFF_MIDDLE : TabSprites.ON_MIDDLE}
            tiling
          />
          <sprite
            x="right"
            y={0}
            w={Layout.TAB_END_W}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.OFF_RIGHT : TabSprites.ON_RIGHT}
          />
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            font={IiTrackerFonts.TAB}
            text="Surface World"
            align="center"
            valign="middle"
            shadow
            color={IiTrackerColor.CAPTION}
          />
        </layer>

        <layer
          x={Layout.TAB_2_X}
          y={0}
          w={Layout.TAB_W}
          h="fill"
          options={['Select']}
          onOptionSelect={() => iiTrackerTabSelect(IiTrackerTab.PURO)}
        >
          <sprite
            x={0}
            y={0}
            w={Layout.TAB_END_W}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.ON_LEFT : TabSprites.OFF_LEFT}
          />
          <sprite
            x="center"
            y={0}
            w={{ fill: Layout.TAB_MIDDLE_W_INSET }}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.ON_MIDDLE : TabSprites.OFF_MIDDLE}
            tiling
          />
          <sprite
            x="right"
            y={0}
            w={Layout.TAB_END_W}
            h={Layout.TAB_SKIN_H}
            sprite={puro ? TabSprites.ON_RIGHT : TabSprites.OFF_RIGHT}
          />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            font={IiTrackerFonts.TAB}
            text="Puro-Puro"
            align="center"
            valign="middle"
            shadow
            color={IiTrackerColor.CAPTION}
          />
        </layer>
      </layer>
    </layer>
  );
}
