import { IiTrackerTab, TabSprites } from './ii-tracker.constants';
import {
  leftTab1,
  leftTab2,
  middleTab1,
  middleTab2,
  puroGrid,
  puroScrollbar,
  rightTab1,
  rightTab2,
  surfaceGrid,
  surfaceScrollbar,
} from './ii-tracker.refs';

export function iiTrackerTabSelect(tab: IiTrackerTab): void {
  if (tab === IiTrackerTab.SURFACE) {
    leftTab2.sprite = TabSprites.OFF_LEFT;
    middleTab2.sprite = TabSprites.OFF_MIDDLE;
    rightTab2.sprite = TabSprites.OFF_RIGHT;
    puroGrid.hide = true;
    puroScrollbar.hide = true;
    leftTab1.sprite = TabSprites.ON_LEFT;
    middleTab1.sprite = TabSprites.ON_MIDDLE;
    rightTab1.sprite = TabSprites.ON_RIGHT;
    surfaceGrid.hide = false;
    surfaceScrollbar.hide = false;
  } else {
    leftTab1.sprite = TabSprites.OFF_LEFT;
    middleTab1.sprite = TabSprites.OFF_MIDDLE;
    rightTab1.sprite = TabSprites.OFF_RIGHT;
    surfaceGrid.hide = true;
    surfaceScrollbar.hide = true;
    leftTab2.sprite = TabSprites.ON_LEFT;
    middleTab2.sprite = TabSprites.ON_MIDDLE;
    rightTab2.sprite = TabSprites.ON_RIGHT;
    puroGrid.hide = false;
    puroScrollbar.hide = false;
  }
}
