import { intArray } from 'ts2';
import { ParchmentPanel } from '../lib/parchment-panel.component';
import { RecipeRow } from './recipe-row.component';
import { RecipeFonts, Row } from './prif-recipes.constants';
import { textLineCount } from '../lib/lib.engine';

const enum Ingredients {
  CELESTIAL_SIGNET = '100 Crystal Shards, 1 Celestial Ring, 1 Elven Signet & 1,000 Stardust',
  CRYSTAL_HELM = '50 Crystal Shards & 1 Crystal Armour Seed',
  CRYSTAL_LEGS = '100 Crystal Shards & 2 Crystal Armour Seeds',
  CRYSTAL_BODY = '150 Crystal Shards & 3 Crystal Armour Seeds',
  CRYSTAL_PICKAXE = '120 Crystal Shards, 1 Crystal Tool Seed & 1 Dragon Pickaxe',
  CRYSTAL_AXE = '120 Crystal Shards, 1 Crystal Tool Seed & 1 Dragon Axe',
  CRYSTAL_FELLING_AXE = '120 Crystal Shards, 1 Crystal Tool Seed & 1 Dragon Felling Axe',
  CRYSTAL_HARPOON = '120 Crystal Shards, 1 Crystal Tool Seed & 1 Dragon Harpoon',
  CRYSTAL_BOW = '40 Crystal Shards & 1 Crystal Weapon Seed',
  CRYSTAL_HALBERD = '40 Crystal Shards & 1 Crystal Weapon Seed',
  CRYSTAL_SHIELD = '40 Crystal Shards & 1 Crystal Weapon Seed',
  ENHANCED_CRYSTAL_KEY = '10 Crystal Shards & 1 Crystal Key',
  ETERNAL_TELEPORT_CRYSTAL = '100 Crystal Shards & 1 Enhanced Crystal Teleport Seed',
  ENHANCED_CRYSTAL_WEAPON_SEED = '250 Crystal Shards & 1 Blade of Saeldor or 1 Bow of Faerdhinen',
  BLADE_OF_SAELDOR = '100 Crystal Shards & 1 Enhanced Crystal Weapon Seed',
  BLADE_OF_SAELDOR_C = '1,000 Crystal Shards & 1 Blade of Saeldor',
  BOW_OF_FAERDHINEN = '100 Crystal Shards & 1 Enhanced Crystal Weapon Seed',
  BOW_OF_FAERDHINEN_C = '2,000 Crystal Shards & 1 Bow of Faerdhinen',
}

function rowHeight(ingredients: String): Int {
  const wrapped: Int = textLineCount(ingredients, Row.TEXT_WIDTH, RecipeFonts.BODY) * Row.LINE + 2 + Row.TITLE_H;
  return wrapped > Row.MIN_HEIGHT ? wrapped : Row.MIN_HEIGHT;
}

export function PrifRecipes(): Component {
  const rowH = intArray(18);
  rowH[0] = rowHeight(Ingredients.CELESTIAL_SIGNET);
  rowH[1] = rowHeight(Ingredients.CRYSTAL_HELM);
  rowH[2] = rowHeight(Ingredients.CRYSTAL_LEGS);
  rowH[3] = rowHeight(Ingredients.CRYSTAL_BODY);
  rowH[4] = rowHeight(Ingredients.CRYSTAL_PICKAXE);
  rowH[5] = rowHeight(Ingredients.CRYSTAL_AXE);
  rowH[6] = rowHeight(Ingredients.CRYSTAL_FELLING_AXE);
  rowH[7] = rowHeight(Ingredients.CRYSTAL_HARPOON);
  rowH[8] = rowHeight(Ingredients.CRYSTAL_BOW);
  rowH[9] = rowHeight(Ingredients.CRYSTAL_HALBERD);
  rowH[10] = rowHeight(Ingredients.CRYSTAL_SHIELD);
  rowH[11] = rowHeight(Ingredients.ENHANCED_CRYSTAL_KEY);
  rowH[12] = rowHeight(Ingredients.ETERNAL_TELEPORT_CRYSTAL);
  rowH[13] = rowHeight(Ingredients.ENHANCED_CRYSTAL_WEAPON_SEED);
  rowH[14] = rowHeight(Ingredients.BLADE_OF_SAELDOR);
  rowH[15] = rowHeight(Ingredients.BLADE_OF_SAELDOR_C);
  rowH[16] = rowHeight(Ingredients.BOW_OF_FAERDHINEN);
  rowH[17] = rowHeight(Ingredients.BOW_OF_FAERDHINEN_C);

  const rowY = intArray(18);
  let cursor: Int = 0;
  let index: Int = 0;
  while (index < 18) {
    rowY[index] = cursor;
    cursor = cursor + rowH[index] + Row.SPACING;
    index = index + 1;
  }
  const contentHeight: Int = cursor - Row.SPACING;

  return (
    <ParchmentPanel title="Crystal Singing Recipes" contentHeight={contentHeight}>
      <RecipeRow
        y={rowY[0]}
        height={rowH[0]}
        name="Celestial Signet"
        ingredients={Ingredients.CELESTIAL_SIGNET}
        item={25545}
      />
      <RecipeRow y={rowY[1]} height={rowH[1]} name="Crystal Helm" ingredients={Ingredients.CRYSTAL_HELM} item={23971} />
      <RecipeRow y={rowY[2]} height={rowH[2]} name="Crystal Legs" ingredients={Ingredients.CRYSTAL_LEGS} item={23979} />
      <RecipeRow y={rowY[3]} height={rowH[3]} name="Crystal Body" ingredients={Ingredients.CRYSTAL_BODY} item={23975} />
      <RecipeRow
        y={rowY[4]}
        height={rowH[4]}
        name="Crystal Pickaxe"
        ingredients={Ingredients.CRYSTAL_PICKAXE}
        item={23680}
      />
      <RecipeRow y={rowY[5]} height={rowH[5]} name="Crystal Axe" ingredients={Ingredients.CRYSTAL_AXE} item={23673} />
      <RecipeRow
        y={rowY[6]}
        height={rowH[6]}
        name="Crystal Felling Axe"
        ingredients={Ingredients.CRYSTAL_FELLING_AXE}
        item={28220}
      />
      <RecipeRow
        y={rowY[7]}
        height={rowH[7]}
        name="Crystal Harpoon"
        ingredients={Ingredients.CRYSTAL_HARPOON}
        item={23762}
      />
      <RecipeRow y={rowY[8]} height={rowH[8]} name="Crystal Bow" ingredients={Ingredients.CRYSTAL_BOW} item={24123} />
      <RecipeRow
        y={rowY[9]}
        height={rowH[9]}
        name="Crystal Halberd"
        ingredients={Ingredients.CRYSTAL_HALBERD}
        item={24125}
      />
      <RecipeRow
        y={rowY[10]}
        height={rowH[10]}
        name="Crystal Shield"
        ingredients={Ingredients.CRYSTAL_SHIELD}
        item={24127}
      />
      <RecipeRow
        y={rowY[11]}
        height={rowH[11]}
        name="Enhanced Crystal Key"
        ingredients={Ingredients.ENHANCED_CRYSTAL_KEY}
        item={23951}
      />
      <RecipeRow
        y={rowY[12]}
        height={rowH[12]}
        name="Eternal Teleport Crystal"
        ingredients={Ingredients.ETERNAL_TELEPORT_CRYSTAL}
        item={23946}
      />
      <RecipeRow
        y={rowY[13]}
        height={rowH[13]}
        name="Enhanced Crystal Weapon Seed"
        ingredients={Ingredients.ENHANCED_CRYSTAL_WEAPON_SEED}
        item={25859}
      />
      <RecipeRow
        y={rowY[14]}
        height={rowH[14]}
        name="Blade of Saeldor"
        ingredients={Ingredients.BLADE_OF_SAELDOR}
        item={23995}
      />
      <RecipeRow
        y={rowY[15]}
        height={rowH[15]}
        name="Blade of Saeldor (c)"
        ingredients={Ingredients.BLADE_OF_SAELDOR_C}
        item={24551}
      />
      <RecipeRow
        y={rowY[16]}
        height={rowH[16]}
        name="Bow of Faerdhinen"
        ingredients={Ingredients.BOW_OF_FAERDHINEN}
        item={25865}
      />
      <RecipeRow
        y={rowY[17]}
        height={rowH[17]}
        name="Bow of Faerdhinen (c)"
        ingredients={Ingredients.BOW_OF_FAERDHINEN_C}
        item={25867}
      />
    </ParchmentPanel>
  );
}
