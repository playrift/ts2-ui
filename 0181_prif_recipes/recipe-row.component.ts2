import { RecipeColors, RecipeFonts, Row } from './prif-recipes.constants';

export function RecipeRow({
  y,
  height,
  name,
  ingredients,
  item,
}: {
  y: Int;
  height: Int;
  name: String;
  ingredients: String;
  item: ItemName;
}): Component {
  return (
    <layer x={0} y={y} w="fill" h={height}>
      <sprite
        x={0}
        y={0}
        w={Row.ICON_W}
        h={Row.ICON_H}
        item={item}
        itemCount={-1}
        outline={1}
        shadowColor={RecipeColors.ICON_SHADOW}
      />

      <text
        x="right"
        y={0}
        w={{ fill: Row.ICON_W + Row.GAP }}
        h={Row.TITLE_H}
        text={name}
        align="left"
        valign="top"
        shadow
        font={RecipeFonts.TITLE}
        color={RecipeColors.LABEL}
      />

      <text
        x="right"
        y="bottom"
        w={{ fill: Row.ICON_W + Row.GAP }}
        h={{ fill: Row.TITLE_H }}
        text={ingredients}
        align="left"
        valign="middle"
        shadow
        lineHeight={0}
        font={RecipeFonts.BODY}
        color={RecipeColors.LABEL}
      />
    </layer>
  );
}
