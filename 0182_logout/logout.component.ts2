import { CS2, useServerState } from 'ts2';
import { textDevice } from '../lib/lib.helpers';
import { Satisfaction } from './satisfaction.component';
import {
  CsatType,
  LogoutColors,
  LogoutContentType,
  LogoutCopy,
  LogoutFonts,
  LogoutLayout,
  LogoutSprites,
  LogoutVarbits,
  NO_SURVEY,
} from './logout.constants';

export function surveyArm(hidden: Int, type: Int): Int {
  if (hidden !== 0) {
    return NO_SURVEY;
  }
  if (type === CsatType.THUMBS) {
    return CsatType.THUMBS;
  }
  if (type === CsatType.FIVE_SCALE) {
    return CsatType.FIVE_SCALE;
  }
  return NO_SURVEY;
}

export function Logout(): Component {
  const hidden: Int = useServerState(LogoutVarbits.CSAT_HIDE);
  const type: Int = useServerState(LogoutVarbits.CSAT_TYPE);
  const arm: Int = surveyArm(hidden, type);

  return (
    <>
      <layer
        x="center"
        y={{ bottom: arm === NO_SURVEY ? LogoutLayout.BUTTONS_BOTTOM_ALONE : LogoutLayout.BUTTONS_BOTTOM_WITH_SURVEY }}
        w="fill"
        h={arm === NO_SURVEY ? LogoutLayout.BUTTONS_H_ALONE : LogoutLayout.BUTTONS_H_WITH_SURVEY}
      >
        <text
          x="center"
          y={0}
          w="fill"
          h={LogoutLayout.BLURB_H}
          text={LogoutCopy.BLURB}
          font={LogoutFonts.BODY}
          color={LogoutColors.BODY}
          shadow
          align="center"
          valign="middle"
          lineHeight={LogoutLayout.LINE_H}
        />

        <layer
          x="center"
          y="center"
          w={LogoutLayout.BUTTON_W}
          h={LogoutLayout.BUTTON_H}
          options={[LogoutCopy.SWITCHER]}
        >
          <sprite
            x={LogoutLayout.PLATE_MID_X}
            y={0}
            w={LogoutLayout.PLATE_MID_W}
            h={LogoutLayout.BUTTON_H}
            sprite={LogoutSprites.GREY_MIDDLE}
            tiling
          />
          <sprite x={0} y={0} w={LogoutLayout.PLATE_CAP} h={LogoutLayout.PLATE_CAP} sprite={LogoutSprites.GREY_LEFT} />
          <sprite
            x={LogoutLayout.PLATE_CAP_RIGHT_X}
            y={0}
            w={LogoutLayout.PLATE_CAP}
            h={LogoutLayout.PLATE_CAP}
            sprite={LogoutSprites.GREY_RIGHT}
          />
          <text
            x="center"
            y="center"
            w={LogoutLayout.BUTTON_W}
            h={LogoutLayout.BUTTON_H}
            contentType={LogoutContentType.SWITCHER_LABEL}
            text={LogoutCopy.SWITCHER}
            font={LogoutFonts.LABEL}
            color={LogoutColors.LABEL}
            hover={{ color: LogoutColors.SWITCHER_OVER }}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer
          x="center"
          y="bottom"
          w={LogoutLayout.BUTTON_W}
          h={LogoutLayout.BUTTON_H}
          options={[LogoutCopy.LOGOUT_OP]}
          onOptionSelect={() => CS2.logout()}
        >
          <sprite
            x={LogoutLayout.PLATE_MID_X}
            y={0}
            w={LogoutLayout.PLATE_MID_W}
            h={LogoutLayout.BUTTON_H}
            sprite={LogoutSprites.RED_MIDDLE}
            tiling
          />
          <sprite x={0} y={0} w={LogoutLayout.PLATE_CAP} h={LogoutLayout.PLATE_CAP} sprite={LogoutSprites.RED_LEFT} />
          <sprite
            x={LogoutLayout.PLATE_CAP_RIGHT_X}
            y={0}
            w={LogoutLayout.PLATE_CAP}
            h={LogoutLayout.PLATE_CAP}
            sprite={LogoutSprites.RED_RIGHT}
          />
          <text
            x="center"
            y="center"
            w={LogoutLayout.BUTTON_W}
            h={LogoutLayout.BUTTON_H}
            contentType={LogoutContentType.LOGOUT_LABEL}
            text={textDevice(LogoutCopy.LOGOUT_DESKTOP, LogoutCopy.LOGOUT_MOBILE)}
            font={LogoutFonts.LABEL}
            color={LogoutColors.LABEL}
            hover={{ color: LogoutColors.LOGOUT_OVER }}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>

      {arm !== NO_SURVEY && (
        <layer x="center" y={LogoutLayout.SURVEY_Y} w="fill" h={LogoutLayout.SURVEY_H}>
          <Satisfaction type={arm} />
        </layer>
      )}
    </>
  );
}
