import { createRef } from 'ts2';
import { Logout } from './logout.component';
import { LogoutLayout } from './logout.constants';

const logoutRef = createRef('logout');

export const logoutUi = (): UI => (
  <ui ref={logoutRef} w={LogoutLayout.ROOT_W} h={LogoutLayout.ROOT_H}>
    <Logout />
  </ui>
);
