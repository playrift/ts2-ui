import { RatingButton } from './rating-button.component';
import { ThumbButton } from './thumb-button.component';
import {
  CsatType,
  LogoutColors,
  LogoutCopy,
  LogoutFonts,
  LogoutLayout,
  RatingFaces,
  Thumb,
  ThumbSprites,
} from './logout.constants';

export function Satisfaction({ type }: { type: Int }): Component {
  return (
    <>
      <text
        x="center"
        y={0}
        w="fill"
        h={LogoutLayout.BLURB_H}
        text={type === CsatType.THUMBS ? LogoutCopy.QUESTION_THUMBS : LogoutCopy.QUESTION_FIVE_SCALE}
        font={LogoutFonts.BODY}
        color={LogoutColors.BODY}
        shadow
        align="center"
        valign="middle"
        lineHeight={LogoutLayout.LINE_H}
      />

      {type === CsatType.THUMBS && (
        <layer x="center" y="bottom" w="fill" h={LogoutLayout.STRIP_H}>
          <ThumbButton
            x={LogoutLayout.THUMB_INSET}
            y="center"
            w={LogoutLayout.THUMB_W}
            h="fill"
            answer={Thumb.UP}
            label={LogoutCopy.THUMBS_UP_OP}
            rest={ThumbSprites.UP_REST}
            over={ThumbSprites.UP_OVER}
          />
          <ThumbButton
            x={{ right: LogoutLayout.THUMB_INSET }}
            y="center"
            w={LogoutLayout.THUMB_W}
            h="fill"
            answer={Thumb.DOWN}
            label={LogoutCopy.THUMBS_DOWN_OP}
            rest={ThumbSprites.DOWN_REST}
            over={ThumbSprites.DOWN_OVER}
          />
        </layer>
      )}

      {type === CsatType.FIVE_SCALE && (
        <layer x="center" y="bottom" w="fill" h={LogoutLayout.STRIP_H}>
          <RatingButton
            x={{ center: LogoutLayout.RATING_DX_1 }}
            y="center"
            w={LogoutLayout.FACE_W}
            h={LogoutLayout.STRIP_H}
            answer={1}
            label="1"
            rest={RatingFaces.REST_1}
            over={RatingFaces.OVER_1}
          />
          <RatingButton
            x={{ center: LogoutLayout.RATING_DX_2 }}
            y="center"
            w={LogoutLayout.FACE_W}
            h={LogoutLayout.STRIP_H}
            answer={2}
            label="2"
            rest={RatingFaces.REST_2}
            over={RatingFaces.OVER_2}
          />
          <RatingButton
            x={{ center: LogoutLayout.RATING_DX_3 }}
            y="center"
            w={LogoutLayout.FACE_W}
            h={LogoutLayout.STRIP_H}
            answer={3}
            label="3"
            rest={RatingFaces.REST_3}
            over={RatingFaces.OVER_3}
          />
          <RatingButton
            x={{ center: LogoutLayout.RATING_DX_4 }}
            y="center"
            w={LogoutLayout.FACE_W}
            h={LogoutLayout.STRIP_H}
            answer={4}
            label="4"
            rest={RatingFaces.REST_4}
            over={RatingFaces.OVER_4}
          />
          <RatingButton
            x={{ center: LogoutLayout.RATING_DX_5 }}
            y="center"
            w={LogoutLayout.FACE_W}
            h={LogoutLayout.STRIP_H}
            answer={5}
            label="5"
            rest={RatingFaces.REST_5}
            over={RatingFaces.OVER_5}
          />
        </layer>
      )}
    </>
  );
}
