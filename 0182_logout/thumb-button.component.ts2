import { predictServerState, useRef, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { ButtonBackground } from '../0370_house-options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { hoverSwapUnlessMobile } from '../0889_nps/hover-swap';
import { LogoutLayout, LogoutVarbits } from './logout.constants';

export function ThumbButton({
  answer,
  label,
  rest,
  over,
}: {
  answer: Int;
  label: String;
  rest: Sprite;
  over: Sprite;
}): Component {
  const chosen: Int = useServerState(LogoutVarbits.CSAT_VOTE);
  const icon = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onOptionSelect={() => {
        playSound(Sounds.CLICK);
        predictServerState(LogoutVarbits.CSAT_VOTE, chosen === answer ? 0 : answer);
      }}
      onMouseRepeat={() => {
        hoverSwapUnlessMobile(icon, over);
      }}
      onMouseLeave={() => {
        hoverSwapUnlessMobile(icon, rest);
      }}
    >
      {chosen === answer ? <ButtonBackgroundPressed /> : <ButtonBackground />}
      <sprite ref={icon} x="center" y="center" w={LogoutLayout.THUMB_ICON} h={LogoutLayout.THUMB_ICON} sprite={rest} />
    </layer>
  );
}
