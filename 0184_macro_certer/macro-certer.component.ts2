import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  CERTER_ANSWERS,
  CERTER_PROMPT,
  CERTER_PROMPT_CONTENT_TYPE,
  CerterArt,
  CerterButtons,
  CerterCamera,
  CerterColors,
  CerterFonts,
  CerterLayout,
  CerterModels,
} from './macro-certer.constants';

export function MacroCerter(): Component {
  return (
    <>
      <model
        x={CerterLayout.BASE.X}
        y={CerterLayout.BASE.Y}
        w={CerterLayout.BASE.W}
        h={CerterLayout.BASE.H}
        model={CerterModels.BASE}
        zoom={CerterCamera.BASE.ZOOM}
        pitch={CerterCamera.BASE.PITCH}
        yaw={CerterCamera.BASE.YAW}
      />

      {CERTER_ANSWERS.map((answer) => (
        <text
          x={CerterLayout.ANSWER.X}
          y={answer.Y}
          w={CerterLayout.ANSWER.W}
          h={CerterLayout.ANSWER.H}
          text={answer.TEXT}
          font={CerterFonts.LABEL}
          color={CerterColors.INK}
          valign="middle"
        />
      ))}

      <text
        x={CerterLayout.PROMPT.X}
        y={CerterLayout.PROMPT.Y}
        w={CerterLayout.PROMPT.W}
        h={CerterLayout.PROMPT.H}
        text={CERTER_PROMPT}
        font={CerterFonts.LABEL}
        color={CerterColors.PROMPT}
        contentType={CERTER_PROMPT_CONTENT_TYPE}
      />

      <rect
        x={CerterLayout.FRAME.X}
        y={CerterLayout.FRAME.Y}
        w={CerterLayout.FRAME.W}
        h={CerterLayout.FRAME.H}
        color={CerterColors.INK}
        fill
      />

      <rect
        x={CerterLayout.PANEL.X}
        y={CerterLayout.PANEL.Y}
        w={CerterLayout.PANEL.W}
        h={CerterLayout.PANEL.H}
        color={CerterColors.PANEL}
        fill
      />

      <model
        x={CerterLayout.SUBJECT.X}
        y={CerterLayout.SUBJECT.Y}
        w={CerterLayout.SUBJECT.W}
        h={CerterLayout.SUBJECT.H}
        model={CerterModels.SUBJECT}
        zoom={CerterCamera.SUBJECT.ZOOM}
        pitch={CerterCamera.SUBJECT.PITCH}
        yaw={CerterCamera.SUBJECT.YAW}
      />

      <model
        x={CerterLayout.BUTTON.X}
        y={CerterButtons.A.Y}
        w={CerterLayout.BUTTON.SIZE}
        h={CerterLayout.BUTTON.SIZE}
        model={CerterModels.BUTTON_A}
        zoom={CerterCamera.BUTTON_A.ZOOM}
        pitch={CerterCamera.BUTTON_A.PITCH}
        yaw={CerterCamera.BUTTON_A.YAW}
        options={[CerterButtons.A.OPTION]}
      />

      <model
        x={CerterLayout.BUTTON.X}
        y={CerterButtons.B.Y}
        w={CerterLayout.BUTTON.SIZE}
        h={CerterLayout.BUTTON.SIZE}
        model={CerterModels.BUTTON_B}
        zoom={CerterCamera.BUTTON_B.ZOOM}
        pitch={CerterCamera.BUTTON_B.PITCH}
        yaw={CerterCamera.BUTTON_B.YAW}
        options={[CerterButtons.B.OPTION]}
      />

      <model
        x={CerterLayout.BUTTON.X}
        y={CerterButtons.C.Y}
        w={CerterLayout.BUTTON.SIZE}
        h={CerterLayout.BUTTON.SIZE}
        model={CerterModels.BUTTON_C}
        zoom={CerterCamera.BUTTON_C.ZOOM}
        pitch={CerterCamera.BUTTON_C.PITCH}
        yaw={CerterCamera.BUTTON_C.YAW}
        options={[CerterButtons.C.OPTION]}
      />

      <sprite
        x={CerterLayout.CLOSE.X}
        y={CerterLayout.CLOSE.Y}
        w={CerterLayout.CLOSE.W}
        h={CerterLayout.CLOSE.H}
        sprite={CerterArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, CerterArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, CerterArt.CLOSE);
        }}
      />
    </>
  );
}
