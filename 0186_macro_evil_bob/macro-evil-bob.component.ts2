import { createRef, useInterval } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  BACKING_WASH,
  BANNER,
  EvilBobColor,
  EvilBobFonts,
  EvilBobSprites,
  Layout,
  MacroEvilBob,
} from './macro-evil-bob.constants';

const timerHost = createRef('0186_macro_evil_bob_timer_host');

const content = createRef('macro_evil_bob_content1');

export function MacroEvilBob_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, MacroEvilBob.DODGE, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={Layout.PLATE_X} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect
            x={0}
            y={0}
            w={Layout.PLATE_W}
            h={Layout.PLATE_H}
            color={EvilBobColor.BACKING}
            fill
            transparency={BACKING_WASH}
          />

          <text
            x={Layout.TEXT_X}
            y={{ center: 0 }}
            w={Layout.TEXT_W}
            h={Layout.TEXT_H}
            font={EvilBobFonts.BANNER}
            text={BANNER}
            align="center"
            valign="middle"
            shadow
            color={EvilBobColor.TEXT}
          />

          <sprite
            x={Layout.CLOSE_X}
            y={{ center: Layout.CLOSE_Y }}
            w={Layout.CLOSE_W}
            h={Layout.CLOSE_H}
            sprite={EvilBobSprites.CLOSE_REST}
            options={['Close']}
            onMouseEnter={(event) => graphicSwapper(event.component, EvilBobSprites.CLOSE_LIT)}
            onMouseLeave={(event) => graphicSwapper(event.component, EvilBobSprites.CLOSE_REST)}
            onOptionSelect={() => closeInterface()}
          />
        </layer>
      </layer>
    </layer>
  );
}
