import { useState } from 'ts2';

import { chatDefaultStopInput } from '../0608_fossil_mushtrees/chatdefault-input';
import { onMobile } from '../lib/lib.helpers';
import { MenuMode, menuCall, menuMode, menuOptions, menuTitle } from './menu.state';

export function menu(title: String, options: String, keys: Boolean): void {
  let shortcuts: Boolean = keys;
  if (onMobile()) {
    shortcuts = false;
  }
  if (shortcuts) {
    chatDefaultStopInput();
  }
  menuOpen(title, options, shortcuts ? MenuMode.KEYS : MenuMode.PLAIN);
}

export function menuIndexed(title: String, options: String): void {
  menuOpen(title, options, MenuMode.INDEXED);
}

function menuOpen(title: String, options: String, mode: Int): void {
  const [call, setCall] = useState(menuCall);
  const [, setTitle] = useState(menuTitle);
  const [, setOptions] = useState(menuOptions);
  const [, setMode] = useState(menuMode);
  setTitle(title);
  setOptions(options);
  setMode(mode);
  setCall(call + 1);
}
