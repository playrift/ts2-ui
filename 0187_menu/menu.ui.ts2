import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, MenuArt, menuRef } from './menu.constants';
import { Menu } from './menu.component';

export const menuUi = (): UI => (
  <ui ref={menuRef} w={Layout.SLOT_W} h={Layout.SLOT_H}>
    <layer x={0} y={0} w="fill" h="fill">
      <Menu />
    </layer>
    <sprite
      x={Layout.CLOSE_X}
      y={Layout.CLOSE_Y}
      w={Layout.CLOSE_W}
      h={Layout.CLOSE_H}
      sprite={MenuArt.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={(event) => graphicSwapper(event.component, MenuArt.CLOSE_HOVER)}
      onMouseLeave={(event) => graphicSwapper(event.component, MenuArt.CLOSE)}
    />
  </ui>
);
