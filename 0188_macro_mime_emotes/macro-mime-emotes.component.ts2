import { MimeLayout, MimeModel } from './macro-mime-emotes.constants';
import { MimeEmotes } from './mime-emotes.data';
import { MimeEmoteButton } from './mime-emote-button.component';

export function MacroMimeEmotes(): Component {
  return (
    <>
      <layer
        x={MimeLayout.CONTENT_X}
        y={MimeLayout.CONTENT_Y}
        w={MimeLayout.CONTENT_WIDTH}
        h={MimeLayout.CONTENT_HEIGHT}
      >
        <MimeEmoteButton label={MimeEmotes.get(0).label} x={MimeEmotes.get(0).x} y={MimeEmotes.get(0).y} />
        <MimeEmoteButton label={MimeEmotes.get(1).label} x={MimeEmotes.get(1).x} y={MimeEmotes.get(1).y} />
        <MimeEmoteButton label={MimeEmotes.get(2).label} x={MimeEmotes.get(2).x} y={MimeEmotes.get(2).y} />
        <MimeEmoteButton label={MimeEmotes.get(3).label} x={MimeEmotes.get(3).x} y={MimeEmotes.get(3).y} />
        <MimeEmoteButton label={MimeEmotes.get(4).label} x={MimeEmotes.get(4).x} y={MimeEmotes.get(4).y} />
        <MimeEmoteButton label={MimeEmotes.get(5).label} x={MimeEmotes.get(5).x} y={MimeEmotes.get(5).y} />
        <MimeEmoteButton label={MimeEmotes.get(6).label} x={MimeEmotes.get(6).x} y={MimeEmotes.get(6).y} />
        <MimeEmoteButton label={MimeEmotes.get(7).label} x={MimeEmotes.get(7).x} y={MimeEmotes.get(7).y} />
      </layer>

      <model
        x={460}
        y={33}
        w={MimeLayout.MIME_SIZE}
        h={MimeLayout.MIME_SIZE}
        model={MimeModel.MIME}
        zoom={MimeModel.RIGHT_ZOOM}
        pitch={MimeModel.RIGHT_PITCH}
        yaw={MimeModel.RIGHT_YAW}
      />
      <model
        x={-13}
        y={34}
        w={MimeLayout.MIME_SIZE}
        h={MimeLayout.MIME_SIZE}
        model={MimeModel.MIME}
        zoom={MimeModel.LEFT_ZOOM}
        pitch={MimeModel.LEFT_PITCH}
        yaw={MimeModel.LEFT_YAW}
      />
    </>
  );
}
