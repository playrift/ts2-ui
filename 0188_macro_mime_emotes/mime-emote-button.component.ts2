import { useState } from 'ts2';
import { Frame } from '../lib/frame.component';
import { onMobile } from '../lib/lib.helpers';
import { ButtonSkinIn, ButtonSkinOut, MimeColors, MimeFonts, MimeLayout } from './macro-mime-emotes.constants';

export function MimeEmoteButton({ label, x, y }: { label: String; x: Int; y: Int }): Component {
  const [pressed, setPressed] = useState(0);

  let hoverable: Boolean = false;
  if (!onMobile()) {
    hoverable = true;
  }

  return (
    <layer
      x={x}
      y={y}
      w={MimeLayout.BUTTON_WIDTH}
      h={MimeLayout.BUTTON_HEIGHT}
      options={['Perform']}
      optionSubject={`<col=ff9040>${label}</col>`}
      onMouseRepeat={() => {
        if (hoverable) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (hoverable) {
          setPressed(0);
        }
      }}
    >
      {pressed === 1 ? (
        <>
          <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={MimeColors.PRESSED_FILL} fill />
          <Frame
            topLeft={ButtonSkinIn.TOP_LEFT}
            topRight={ButtonSkinIn.TOP_RIGHT}
            bottomLeft={ButtonSkinIn.BOTTOM_LEFT}
            bottomRight={ButtonSkinIn.BOTTOM_RIGHT}
            left={ButtonSkinIn.LEFT}
            top={ButtonSkinIn.TOP}
            right={ButtonSkinIn.RIGHT}
            bottom={ButtonSkinIn.BOTTOM}
          />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={ButtonSkinOut.FILL} tiling />
          <Frame
            topLeft={ButtonSkinOut.TOP_LEFT}
            topRight={ButtonSkinOut.TOP_RIGHT}
            bottomLeft={ButtonSkinOut.BOTTOM_LEFT}
            bottomRight={ButtonSkinOut.BOTTOM_RIGHT}
            left={ButtonSkinOut.LEFT}
            top={ButtonSkinOut.TOP}
            right={ButtonSkinOut.RIGHT}
            bottom={ButtonSkinOut.BOTTOM}
          />
        </>
      )}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        align="center"
        valign="middle"
        font={MimeFonts.LABEL}
        color={MimeColors.LABEL}
      />
    </layer>
  );
}
