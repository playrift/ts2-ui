  [2, { label: 'Climb rope', x: 194, y: 4 }],
  [3, { label: 'Glass box', x: 290, y: 4 }],
  [4, { label: 'Cry', x: 4, y: 41 }],
  [5, { label: 'Dance', x: 97, y: 41 }],
  [6, { label: 'Lean', x: 194, y: 41 }],
  [7, { label: 'Glass wall', x: 290, y: 41 }],
