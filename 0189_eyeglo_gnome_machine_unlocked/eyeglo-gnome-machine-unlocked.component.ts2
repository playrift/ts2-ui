import { eygloHandModel, eygloSelectedCoin } from '../0111_eyeglo_change_machine/eyeglo-machine.helpers';
import { MachineDigits, MachineItems, MachineMarkers } from './machine-rows.component';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { CloseSprites, Layout, MachineColor, MachineModel } from './eyeglo-gnome-machine-unlocked.constants';

export function MachineHand(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.HAND_X}
        y={Layout.HAND_Y}
        w={{ fill: Layout.HAND_FILL_W }}
        h={{ fill: Layout.HAND_FILL_H }}
        model={eygloHandModel()}
        zoom={Layout.HAND_ZOOM}
        pitch={Layout.HAND_PITCH}
        yaw={Layout.HAND_YAW}
        roll={Layout.HAND_ROLL}
      />
    </layer>
  );
}

export function MachineSelectedCoin(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.COIN_X}
        y={Layout.COIN_Y}
        w={Layout.COIN_W}
        h={Layout.COIN_H}
        item={eygloSelectedCoin()}
        itemCount={1}
        deferred
      />
    </layer>
  );
}

export function EygloGnomeMachineUnlocked(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} fill color={MachineColor.BACKDROP} />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CRYSTAL}
        zoom={Layout.HEAD_ZOOM}
      />
      <model
        x={Layout.COLLAR_X}
        y={Layout.COLLAR_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.COLLAR}
        zoom={Layout.COLLAR_ZOOM}
      />

      <MachineDigits w="fill" h="fill" />

      <MachineMarkers w="fill" h="fill" />

      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_1} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>
      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_2} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>
      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_3} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>

      <rect
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_1}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
      />
      <rect
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_2}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
      />
      <rect
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_3}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
      />

      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_1}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />
      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_2}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />
      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_3}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />

      <MachineHand w="fill" h="fill" />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HEAD_3}
        zoom={Layout.HEAD_ZOOM}
      />

      <MachineItems w="fill" h="fill" />

      <model
        x={Layout.CANCEL_X}
        y={Layout.CANCEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CANCEL}
        zoom={Layout.HEAD_ZOOM}
        pitch={Layout.CANCEL_PITCH}
        yaw={Layout.CANCEL_YAW}
        options={['Cancel operation']}
      />

      <model
        x={Layout.ACTIVATE_LEVER_X}
        y={Layout.ACTIVATE_LEVER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.ACTIVATE}
        zoom={Layout.HEAD_ZOOM}
        pitch={Layout.ACTIVATE_LEVER_PITCH}
        options={['Activate machine']}
      />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HEAD_4}
        zoom={Layout.HEAD_ZOOM}
      />

      <MachineSelectedCoin w="fill" h="fill" />

      <sprite
        x={{ right: Layout.CLOSE_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onDrag={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />
    </>
  );
}
