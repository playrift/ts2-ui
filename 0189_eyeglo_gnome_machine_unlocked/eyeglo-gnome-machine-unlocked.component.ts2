import { createRef, useWatch } from 'ts2';

import { setEygloHandModel, setEygloSelectedCoin } from '../0111_eyeglo_change_machine/eyeglo-machine.helpers';
import { EYEGLO_DIGIT_ZERO } from '../0145_eyeglo_gnome_machine_locked/eyeglo-digit-models.data';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { machineRowOne, machineRowThree, machineRowTwo } from './eyeglo-gnome-machine-unlocked.helpers';
import {
  CloseSprites,
  Digits,
  DialModel,
  Layout,
  MachineColor,
  MachineModel,
  Markers,
  Slots,
} from './eyeglo-gnome-machine-unlocked.constants';

const rowOneBox = createRef();
const rowTwoBox = createRef();
const rowThreeBox = createRef();
const rowOneTens = createRef();
const rowOneUnits = createRef();
const rowTwoTens = createRef();
const rowTwoUnits = createRef();
const rowThreeTens = createRef();
const rowThreeUnits = createRef();
const rowOneTop = createRef();
const rowOneMiddle = createRef();
const rowOneBottom = createRef();
const rowTwoTop = createRef();
const rowTwoMiddle = createRef();
const rowTwoBottom = createRef();
const rowThreeTop = createRef();
const rowThreeMiddle = createRef();
const rowThreeBottom = createRef();
const slotOne = createRef();
const slotTwo = createRef();
const slotThree = createRef();
const slotFour = createRef();
const slotFive = createRef();
const slotSix = createRef();
const hand = createRef();
const selectedCoin = createRef();

export function EygloGnomeMachineUnlocked(): Component {
  useWatch(
    [Varbits.EYEGLO_COIN_VALUE_2, Varbits.EYEGLO_OPERATE1_VAL, Varps.EYEGLO_OPERATE1_A],
    () => machineRowOne(rowOneTens, rowOneUnits, rowOneTop, rowOneMiddle, rowOneBottom, slotOne),
    rowOneBox,
  );
  useWatch(
    [Varbits.EYEGLO_COIN_VALUE_3, Varbits.EYEGLO_OPERATE2_VAL, Varps.EYEGLO_OPERATE2_A, Varps.EYEGLO_OPERATE2_B],
    () => machineRowTwo(rowTwoTens, rowTwoUnits, rowTwoTop, rowTwoMiddle, rowTwoBottom, slotTwo, slotThree),
    rowTwoBox,
  );
  useWatch(
    [
      Varbits.EYEGLO_COIN_VALUE_4,
      Varbits.EYEGLO_OPERATE3_VAL,
      Varps.EYEGLO_OPERATE3_A,
      Varps.EYEGLO_OPERATE3_B,
      Varps.EYEGLO_OPERATE3_C,
    ],
    () =>
      machineRowThree(
        rowThreeTens,
        rowThreeUnits,
        rowThreeTop,
        rowThreeMiddle,
        rowThreeBottom,
        slotFour,
        slotFive,
        slotSix,
      ),
    rowThreeBox,
  );

  useWatch(Varbits.EYEGLO_HAND, (event) => setEygloHandModel(event.component), hand);

  useWatch(Varps.EYEGLO_COIN_SELECTED, (event) => setEygloSelectedCoin(event.component), selectedCoin);

  return (
    <>
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} fill color={MachineColor.BACKDROP} />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CRYSTAL}
        zoom={Layout.HEAD_ZOOM}
      />
      <model
        x={Layout.COLLAR_X}
        y={Layout.COLLAR_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.COLLAR}
        zoom={Layout.COLLAR_ZOOM}
      />

      <model
        ref={rowOneTens}
        x={Digits.ROW_1_TENS_X}
        y={Digits.ROW_1_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={rowOneUnits}
        x={Digits.ROW_1_UNITS_X}
        y={Digits.ROW_1_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={rowTwoTens}
        x={Digits.ROW_2_TENS_X}
        y={Digits.ROW_2_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={rowTwoUnits}
        x={Digits.ROW_2_UNITS_X}
        y={Digits.ROW_2_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={rowThreeTens}
        x={Digits.ROW_3_TENS_X}
        y={Digits.ROW_3_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        ref={rowThreeUnits}
        x={Digits.ROW_3_UNITS_X}
        y={Digits.ROW_3_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />

      <model
        ref={rowOneTop}
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.TOP_HIGHER}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        ref={rowOneMiddle}
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.NEEDLE}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        ref={rowOneBottom}
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.BOTTOM_LOWER}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        ref={rowTwoTop}
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.TOP_HIGHER}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        ref={rowTwoMiddle}
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.NEEDLE}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        ref={rowTwoBottom}
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.BOTTOM_LOWER}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        ref={rowThreeTop}
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.TOP_HIGHER}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        ref={rowThreeMiddle}
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.NEEDLE}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        ref={rowThreeBottom}
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={DialModel.BOTTOM_LOWER}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />

      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_1} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>
      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_2} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>
      <layer x={Layout.HOPPER_BOX_X} y={Layout.HOPPER_BOX_Y_3} w={Layout.HOPPER_BOX_W} h={Layout.HOPPER_BOX_H}>
        <model
          x={Layout.HOPPER_INSET}
          y={Layout.HOPPER_INSET}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={MachineModel.HOPPER}
          zoom={Layout.HEAD_ZOOM}
        />
      </layer>

      <rect
        ref={rowOneBox}
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_1}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
        onLoad={() => machineRowOne(rowOneTens, rowOneUnits, rowOneTop, rowOneMiddle, rowOneBottom, slotOne)}
      />
      <rect
        ref={rowTwoBox}
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_2}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
        onLoad={() => machineRowTwo(rowTwoTens, rowTwoUnits, rowTwoTop, rowTwoMiddle, rowTwoBottom, slotTwo, slotThree)}
      />
      <rect
        ref={rowThreeBox}
        x={Layout.INSERT_X}
        y={Layout.INSERT_Y_3}
        w={Layout.INSERT_W}
        h={Layout.INSERT_H}
        color={MachineColor.INSERT_BOX}
        transparency={Layout.INVISIBLE}
        options={['Insert coin']}
        onLoad={() =>
          machineRowThree(
            rowThreeTens,
            rowThreeUnits,
            rowThreeTop,
            rowThreeMiddle,
            rowThreeBottom,
            slotFour,
            slotFive,
            slotSix,
          )
        }
      />

      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_1}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />
      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_2}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />
      <rect
        x={Layout.ACTIVATE_X}
        y={Layout.ACTIVATE_Y_3}
        w={Layout.ACTIVATE_W}
        h={Layout.ACTIVATE_H}
        color={MachineColor.ACTIVATE_BOX}
        transparency={Layout.INVISIBLE}
        options={['Activate machine']}
      />

      <model
        ref={hand}
        x={Layout.HAND_X}
        y={Layout.HAND_Y}
        w={{ fill: Layout.HAND_FILL_W }}
        h={{ fill: Layout.HAND_FILL_H }}
        model={MachineModel.HAND}
        zoom={Layout.HAND_ZOOM}
        pitch={Layout.HAND_PITCH}
        yaw={Layout.HAND_YAW}
        roll={Layout.HAND_ROLL}
        onLoad={(event) => setEygloHandModel(event.component)}
      />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HEAD_3}
        zoom={Layout.HEAD_ZOOM}
      />

      <model
        ref={slotOne}
        x={Layout.ITEM_X}
        y={Slots.Y_1}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />
      <model
        ref={slotTwo}
        x={Layout.ITEM_X}
        y={Slots.Y_2}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />
      <model
        ref={slotThree}
        x={Layout.ITEM_X}
        y={Slots.Y_3}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />
      <model
        ref={slotFour}
        x={Layout.ITEM_X}
        y={Slots.Y_4}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />
      <model
        ref={slotFive}
        x={Layout.ITEM_X}
        y={Slots.Y_5}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />
      <model
        ref={slotSix}
        x={Layout.ITEM_X}
        y={Slots.Y_6}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        zoom={Layout.ITEM_ZOOM}
      />

      <model
        x={Layout.CANCEL_X}
        y={Layout.CANCEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.CANCEL}
        zoom={Layout.HEAD_ZOOM}
        pitch={Layout.CANCEL_PITCH}
        yaw={Layout.CANCEL_YAW}
        options={['Cancel operation']}
      />

      <model
        x={Layout.ACTIVATE_LEVER_X}
        y={Layout.ACTIVATE_LEVER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.ACTIVATE}
        zoom={Layout.HEAD_ZOOM}
        pitch={Layout.ACTIVATE_LEVER_PITCH}
        options={['Activate machine']}
      />

      <model
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MachineModel.HEAD_4}
        zoom={Layout.HEAD_ZOOM}
      />

      <model
        ref={selectedCoin}
        x={Layout.COIN_X}
        y={Layout.COIN_Y}
        w={Layout.COIN_W}
        h={Layout.COIN_H}
        zoom={Layout.COIN_ZOOM}
        pitch={Layout.COIN_PITCH}
        yaw={Layout.COIN_YAW}
      />

      <sprite
        x={{ right: Layout.CLOSE_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onDrag={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />
    </>
  );
}
