import { CS2, useServerState } from 'ts2';

import { EYEGLO_DIGIT_ZERO, EyegloDigitModels } from '../0145_eyeglo_gnome_machine_locked/eyeglo-digit-models.data';
import { DialModel } from './eyeglo-gnome-machine-unlocked.constants';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

export function dialMarkers(value: Int, target: Int): [Model, Model, Model] {
  if (target === 0) {
    return [DialModel.NONE, DialModel.NEEDLE, DialModel.NONE];
  }
  if (target > value) {
    return [DialModel.TOP_HIGHER, DialModel.NEEDLE, DialModel.BOTTOM_HIGHER];
  }
  if (target < value) {
    return [DialModel.TOP_LOWER, DialModel.NEEDLE, DialModel.BOTTOM_LOWER];
  }
  return [DialModel.NONE, DialModel.NEEDLE_MATCH, DialModel.NONE];
}

function writeDigits(value: Int, tens: ComponentId, units: ComponentId): void {
  tens.model = EyegloDigitModels.get(value / 10) ?? EYEGLO_DIGIT_ZERO;
  units.model = EyegloDigitModels.get(value % 10) ?? EYEGLO_DIGIT_ZERO;
}

function writeMarkers(value: Int, target: Int, top: ComponentId, middle: ComponentId, bottom: ComponentId): void {
  const [topModel, middleModel, bottomModel] = dialMarkers(value, target);
  top.model = topModel;
  middle.model = middleModel;
  bottom.model = bottomModel;
}

export function machineRowOne(
  tens: ComponentId,
  units: ComponentId,
  top: ComponentId,
  middle: ComponentId,
  bottom: ComponentId,
  slot: ComponentId,
): void {
  const value: Int = useServerState(Varbits.EYEGLO_COIN_VALUE_2);
  writeDigits(value, tens, units);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE1_A) as Item, 1, slot);
  writeMarkers(value, useServerState(Varbits.EYEGLO_OPERATE1_VAL), top, middle, bottom);
}

export function machineRowTwo(
  tens: ComponentId,
  units: ComponentId,
  top: ComponentId,
  middle: ComponentId,
  bottom: ComponentId,
  slotA: ComponentId,
  slotB: ComponentId,
): void {
  const value: Int = useServerState(Varbits.EYEGLO_COIN_VALUE_3);
  writeDigits(value, tens, units);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE2_A) as Item, 1, slotA);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE2_B) as Item, 1, slotB);
  writeMarkers(value, useServerState(Varbits.EYEGLO_OPERATE2_VAL), top, middle, bottom);
}

export function machineRowThree(
  tens: ComponentId,
  units: ComponentId,
  top: ComponentId,
  middle: ComponentId,
  bottom: ComponentId,
  slotA: ComponentId,
  slotB: ComponentId,
  slotC: ComponentId,
): void {
  const value: Int = useServerState(Varbits.EYEGLO_COIN_VALUE_4);
  writeDigits(value, tens, units);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE3_A) as Item, 1, slotA);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE3_B) as Item, 1, slotB);
  CS2.if_item_nonum_set(useServerState(Varps.EYEGLO_OPERATE3_C) as Item, 1, slotC);
  writeMarkers(value, useServerState(Varbits.EYEGLO_OPERATE3_VAL), top, middle, bottom);
}
