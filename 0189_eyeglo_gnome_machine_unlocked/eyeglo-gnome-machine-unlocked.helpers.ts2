import { useServerState } from 'ts2';

import { DialModel, Row, Slot } from './eyeglo-gnome-machine-unlocked.constants';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';

export function machineValue(row: Row): Int {
  switch (row) {
    case Row.ONE:
      return useServerState(Varbits.EYEGLO_COIN_VALUE_2);
    case Row.TWO:
      return useServerState(Varbits.EYEGLO_COIN_VALUE_3);
    case Row.THREE:
      return useServerState(Varbits.EYEGLO_COIN_VALUE_4);
  }
  return 0;
}

export function machineTarget(row: Row): Int {
  switch (row) {
    case Row.ONE:
      return useServerState(Varbits.EYEGLO_OPERATE1_VAL);
    case Row.TWO:
      return useServerState(Varbits.EYEGLO_OPERATE2_VAL);
    case Row.THREE:
      return useServerState(Varbits.EYEGLO_OPERATE3_VAL);
  }
  return 0;
}

export function machineSlotItem(slot: Slot): Int {
  switch (slot) {
    case Slot.ONE:
      return useServerState(Varps.EYEGLO_OPERATE1_A);
    case Slot.TWO:
      return useServerState(Varps.EYEGLO_OPERATE2_A);
    case Slot.THREE:
      return useServerState(Varps.EYEGLO_OPERATE2_B);
    case Slot.FOUR:
      return useServerState(Varps.EYEGLO_OPERATE3_A);
    case Slot.FIVE:
      return useServerState(Varps.EYEGLO_OPERATE3_B);
    case Slot.SIX:
      return useServerState(Varps.EYEGLO_OPERATE3_C);
  }
  return -1;
}

export function dialMarkers(value: Int, target: Int): [Model, Model, Model] {
  if (target === 0) {
    return [DialModel.NONE, DialModel.NEEDLE, DialModel.NONE];
  }
  if (target > value) {
    return [DialModel.TOP_HIGHER, DialModel.NEEDLE, DialModel.BOTTOM_HIGHER];
  }
  if (target < value) {
    return [DialModel.TOP_LOWER, DialModel.NEEDLE, DialModel.BOTTOM_LOWER];
  }
  return [DialModel.NONE, DialModel.NEEDLE_MATCH, DialModel.NONE];
}
