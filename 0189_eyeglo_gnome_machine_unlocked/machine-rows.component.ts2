import { useDerived } from 'ts2';

import { EYEGLO_DIGIT_ZERO, EyegloDigitModels } from '../0145_eyeglo_gnome_machine_locked/eyeglo-digit-models.data';
import { Digits, Layout, Markers, Row, Slot, Slots } from './eyeglo-gnome-machine-unlocked.constants';
import { dialMarkers, machineSlotItem, machineTarget, machineValue } from './eyeglo-gnome-machine-unlocked.helpers';

export function MachineDigits(): Component {
  const first: Int = useDerived(() => machineValue(Row.ONE));
  const second: Int = useDerived(() => machineValue(Row.TWO));
  const third: Int = useDerived(() => machineValue(Row.THREE));

  return (
    <layer w="fill" h="fill">
      <model
        x={Digits.ROW_1_TENS_X}
        y={Digits.ROW_1_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(first / 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        x={Digits.ROW_1_UNITS_X}
        y={Digits.ROW_1_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(first % 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />

      <model
        x={Digits.ROW_2_TENS_X}
        y={Digits.ROW_2_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(second / 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        x={Digits.ROW_2_UNITS_X}
        y={Digits.ROW_2_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(second % 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />

      <model
        x={Digits.ROW_3_TENS_X}
        y={Digits.ROW_3_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(third / 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
      <model
        x={Digits.ROW_3_UNITS_X}
        y={Digits.ROW_3_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        model={EyegloDigitModels.get(third % 10) ?? EYEGLO_DIGIT_ZERO}
        zoom={Layout.DIGIT_ZOOM}
        offsetY={Layout.DIGIT_OFFSET_Y}
      />
    </layer>
  );
}

export function MachineMarkers(): Component {
  const firstValue: Int = useDerived(() => machineValue(Row.ONE));
  const firstTarget: Int = useDerived(() => machineTarget(Row.ONE));
  const secondValue: Int = useDerived(() => machineValue(Row.TWO));
  const secondTarget: Int = useDerived(() => machineTarget(Row.TWO));
  const thirdValue: Int = useDerived(() => machineValue(Row.THREE));
  const thirdTarget: Int = useDerived(() => machineTarget(Row.THREE));
  const [top1, mid1, bottom1] = dialMarkers(firstValue, firstTarget);
  const [top2, mid2, bottom2] = dialMarkers(secondValue, secondTarget);
  const [top3, mid3, bottom3] = dialMarkers(thirdValue, thirdTarget);

  return (
    <layer w="fill" h="fill">
      <model
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={top1}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={mid1}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        x={Markers.ROW_1_X}
        y={Markers.ROW_1_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={bottom1}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />

      <model
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={top2}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={mid2}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        x={Markers.ROW_2_X}
        y={Markers.ROW_2_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={bottom2}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />

      <model
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_TOP_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={top3}
        zoom={Layout.MARKER_ZOOM}
      />
      <model
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_MID_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={mid3}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
      <model
        x={Markers.ROW_3_X}
        y={Markers.ROW_3_BOTTOM_Y}
        w={Layout.MARKER_W}
        h={Layout.MARKER_H}
        model={bottom3}
        zoom={Layout.MARKER_ZOOM}
        offsetY={Layout.MARKER_OFFSET_Y}
      />
    </layer>
  );
}

export function MachineItems(): Component {
  const one: Item = useDerived(() => machineSlotItem(Slot.ONE)) as Item;
  const two: Item = useDerived(() => machineSlotItem(Slot.TWO)) as Item;
  const three: Item = useDerived(() => machineSlotItem(Slot.THREE)) as Item;
  const four: Item = useDerived(() => machineSlotItem(Slot.FOUR)) as Item;
  const five: Item = useDerived(() => machineSlotItem(Slot.FIVE)) as Item;
  const six: Item = useDerived(() => machineSlotItem(Slot.SIX)) as Item;

  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_1}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={one}
        itemCount={1}
        itemCountMode="never"
      />
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_2}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={two}
        itemCount={1}
        itemCountMode="never"
      />
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_3}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={three}
        itemCount={1}
        itemCountMode="never"
      />
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_4}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={four}
        itemCount={1}
        itemCountMode="never"
      />
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_5}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={five}
        itemCount={1}
        itemCountMode="never"
      />
      <model
        x={Layout.ITEM_X}
        y={Slots.Y_6}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        item={six}
        itemCount={1}
        itemCountMode="never"
      />
    </layer>
  );
}
