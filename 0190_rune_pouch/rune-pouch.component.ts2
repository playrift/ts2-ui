import { useWatch } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Varps } from '../lib/game/varps';
import {
  Art,
  Colour,
  Font,
  Layout,
  TextAlign,
  allRef,
  bodyRef,
  customRef,
  fiveRef,
  frameRef,
  inventoryRef,
  oneRef,
  pouchRef,
  quantitiesRef,
  topRef,
} from './rune-pouch.constants';
import { drawPouch, drawQuantityButtons, redrawInventory, runePouchInit, runePouchLayout } from './rune-pouch.builders';

export function RunePouch(): Component {
  useWatch(Inventories.INV, () => redrawInventory(), inventoryRef);
  useWatch([Varps.MILLCHECK_MULTI, Varps.ROVING_UPDATE_ILFEEN_CHANT], () => redrawInventory(), inventoryRef);
  useWatch([Varps.MILLCHECK_MULTI, Varps.ROVING_UPDATE_ILFEEN_CHANT], () => drawQuantityButtons(), oneRef);
  useWatch([Varps.IF1, Varps.LEAGUE_GENERAL, Varps.LEAGUE_RELICS], () => runePouchLayout(), frameRef);
  useWatch(
    [
      Varps.IF1,
      Varps.LEAGUE_GENERAL,
      Varps.LEAGUE_RELICS,
      Varps.MILLCHECK_MULTI,
      Varps.ROVING_UPDATE_ILFEEN_CHANT,
      Varps.RUNE_POUCH_A,
      Varps.RUNE_POUCH_B,
      Varps.RUNE_POUCH_C,
      Varps.RUNE_POUCH_D,
    ],
    () => drawPouch(),
    bodyRef,
  );

  return (
    <>
      <layer static ref={frameRef} w="fill" h="fill" onLoad={() => runePouchInit()} />
      <layer
        static
        ref={bodyRef}
        x="center"
        y={{ bottom: Layout.BODY_BOTTOM }}
        w={{ fill: Layout.BODY_INSET_W }}
        h={{ fill: Layout.BODY_INSET_H }}
      >
        <layer static ref={topRef} x="center" y={0} w="fill" h={Layout.TOP_H}>
          <layer static ref={pouchRef} x="center" y="center" w={{ fill: Layout.POUCH_INSET_W }} h="fill">
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={Art.BACKING}
              tiling
              transparency={Layout.BACKING_TRANS}
            />
            <text
              x="center"
              y={0}
              w="fill"
              h={Layout.CAPTION_H}
              text="Pouch"
              font={Font.P12_FULL}
              color={Colour.CAPTION}
              shadow
              align="center"
              valign="bottom"
            />
          </layer>
        </layer>

        <layer
          static
          ref={inventoryRef}
          x="center"
          y={Layout.INVENTORY_Y}
          w={Layout.INVENTORY_W}
          h={{ fill: Layout.INVENTORY_INSET_H }}
        >
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={Art.BACKING}
            tiling
            transparency={Layout.BACKING_TRANS}
          />
          <text
            x="center"
            y={0}
            w={Layout.INVENTORY_W}
            h={Layout.CAPTION_H}
            text="Inventory"
            font={Font.P12_FULL}
            color={Colour.CAPTION}
            shadow
            align="center"
            valign="bottom"
          />
        </layer>

        <layer static ref={quantitiesRef} x="center" y={{ bottom: 0 }} w="fill" h={Layout.QUANTITIES_H}>
          <layer
            static
            ref={oneRef}
            x={{ center: Layout.BUTTON_1_X }}
            y={0}
            w={Layout.BUTTON}
            h={Layout.BUTTON}
            options={['*']}
          />
          <layer
            static
            ref={fiveRef}
            x={{ center: Layout.BUTTON_5_X }}
            y={0}
            w={Layout.BUTTON}
            h={Layout.BUTTON}
            options={['*']}
          />
          <layer
            static
            ref={customRef}
            x={{ center: Layout.BUTTON_X_X }}
            y={0}
            w={Layout.BUTTON}
            h={Layout.BUTTON}
            options={['*', '*']}
          />
          <layer
            static
            ref={allRef}
            x={{ center: Layout.BUTTON_ALL_X }}
            y={0}
            w={Layout.BUTTON}
            h={Layout.BUTTON}
            options={['*']}
          />
        </layer>
      </layer>
    </>
  );
}
