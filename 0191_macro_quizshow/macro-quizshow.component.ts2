import { BoardCamera, Layout, QUESTION_COLOR, QUESTION_TEXT, QuizFonts, QuizModel } from './macro-quizshow.constants';

export function MacroQuizshow(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.BOARD_X}
        y={Layout.BOARD_Y}
        w={Layout.BOARD_W}
        h={Layout.BOARD_H}
        model={QuizModel.BOARD}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />

      <layer x={Layout.BUTTONS_X} y={Layout.BUTTONS_Y} w={Layout.BUTTONS_W} h={Layout.BUTTONS_H} />

      <text
        x={Layout.QUESTION_X}
        y={Layout.QUESTION_Y}
        w={Layout.QUESTION_W}
        h={Layout.QUESTION_H}
        text={QUESTION_TEXT}
        font={QuizFonts.LABEL}
        color={QUESTION_COLOR}
        shadow={true}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
