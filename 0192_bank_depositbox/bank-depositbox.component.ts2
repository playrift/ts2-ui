import { QuantityButton } from '../0125_farming_tools/quantity-button.component';
import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { QuiverSlot } from '../0084_equipment/quiver-slot.component';
import { Copy, DepositBoxColor, DepositBoxSprites, Layout, Wash, WornSlot } from './bank-depositbox.constants';
import { resetDepositMenu, toggleDepositMenu } from './bank-depositbox.helpers';
import { depositBlocker, depositMain, depositMenuButton, depositSettingsMenu } from './bank-depositbox.state';
import { DepositBoxBorder } from './deposit-box-border.component';
import { DepositButtonRow } from './deposit-button-row.component';
import { DepositEquipSlot } from './deposit-equip-slot.component';
import { DepositGrid, LockFrames } from './deposit-grid.component';
import { DepositSettingsRow } from './deposit-settings-row.component';
import { LockSettingsButton } from './lock-settings-button.component';

export function BankDepositbox(): Component {
  return (
    <>
      <DepositBoxBorder />

      <layer
        ref={depositMenuButton}
        x={Layout.menuButton.x}
        y={Layout.menuButton.y}
        w={Layout.menuButton.size}
        h={Layout.menuButton.size}
        options={[Copy.SHOW_MENU]}
        onOptionSelect={() => toggleDepositMenu()}
      >
        <sprite
          x={0}
          y={0}
          w={Layout.menuButton.size}
          h={Layout.menuButton.size}
          sprite={DepositBoxSprites.MENU}
          hover={{ sprite: DepositBoxSprites.MENU_HOVER }}
        />
      </layer>

      <layer
        ref={depositMain}
        x="center"
        y={{ bottom: Layout.main.bottom }}
        w={{ fill: Layout.main.inset }}
        h={{ fill: Layout.main.drop }}
      >
        <layer x={0} y={0} w={Layout.equipment.w} h={Layout.equipment.h}>
          <sprite
            x="center"
            y="center"
            w={Layout.steel.spineW}
            h={Layout.steel.spineH}
            sprite={DepositBoxSprites.STEEL_V}
            tiling
          />
          <sprite
            x={{ center: -Layout.steel.armDx }}
            y={{ center: Layout.steel.armDy }}
            w={Layout.steel.armW}
            h={Layout.steel.armH}
            sprite={DepositBoxSprites.STEEL_V}
            tiling
          />
          <sprite
            x={{ center: Layout.steel.armDx }}
            y={{ center: Layout.steel.armDy }}
            w={Layout.steel.armW}
            h={Layout.steel.armH}
            sprite={DepositBoxSprites.STEEL_V}
            tiling
          />
          <sprite
            x="center"
            y="center"
            w={Layout.steel.beltW}
            h={Layout.steel.beltH}
            sprite={DepositBoxSprites.STEEL_H}
            tiling
          />
          <sprite
            x="center"
            y={{ center: Layout.steel.collarDy }}
            w={Layout.steel.collarW}
            h={Layout.steel.collarH}
            sprite={DepositBoxSprites.STEEL_H}
            tiling
          />

          <layer x="center" y={{ center: -78 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.HEAD} />
          </layer>
          <layer x={{ center: -41 }} y={{ center: -39 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.CAPE} />
          </layer>
          <layer x="center" y={{ center: -39 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.AMULET} />
          </layer>
          <layer x={{ center: -56 }} y="center" w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.WEAPON} />
          </layer>
          <layer x="center" y="center" w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.BODY} />
          </layer>
          <layer x={{ center: 56 }} y="center" w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.SHIELD} />
          </layer>
          <layer x="center" y={{ center: 39 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.LEGS} />
          </layer>
          <layer x={{ center: -56 }} y={{ center: 79 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.HANDS} />
          </layer>
          <layer x="center" y={{ center: 79 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.FEET} />
          </layer>
          <layer x={{ center: 56 }} y={{ center: 79 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.RING} />
          </layer>
          <layer x={{ center: 41 }} y={{ center: -39 }} w={Layout.slot.size} h={Layout.slot.size}>
            <DepositEquipSlot slot={WornSlot.AMMO} />
          </layer>

          <layer x={{ center: 41 }} y={{ center: -78 }} w={Layout.slot.size} h={Layout.slot.size}>
            <QuiverSlot />
          </layer>
        </layer>

        <layer x={Layout.deposit.x} y="center" w={Layout.deposit.w} h={Layout.deposit.h}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.deposit.backingInset }}
            h={{ fill: Layout.deposit.backingInset }}
            sprite={DepositBoxSprites.BACKING}
            tiling
            transparency={Wash.BACKING}
          />
          <layer x="center" y="center" w="fill" h="fill">
            <LockFrames />
          </layer>
          <rect x="center" y="center" w="fill" h="fill" color={DepositBoxColor.THINBOX_OUTER} />
          <rect
            x="center"
            y="center"
            w={{ fill: Layout.deposit.thinboxInset }}
            h={{ fill: Layout.deposit.thinboxInset }}
            color={DepositBoxColor.THINBOX_INNER}
          />
          <DepositGrid />
        </layer>

        <layer x={Layout.buttons.x} y="bottom" w={Layout.buttons.w} h={Layout.buttons.h}>
          <DepositButtonRow />
        </layer>

        <layer x={{ right: Layout.column.right }} y="center" w={Layout.column.w} h="fill">
          <layer x="center" y={0} w="fill" h={Layout.lockButton.h}>
            <LockSettingsButton />
          </layer>

          <layer x="center" y={{ bottom: Layout.quantity.one }} w="fill" h={Layout.quantity.h}>
            <QuantityButton table={QuantityTable.DEPOSIT_BOX} label="1" value={0} />
          </layer>
          <layer x="center" y={{ bottom: Layout.quantity.five }} w="fill" h={Layout.quantity.h}>
            <QuantityButton table={QuantityTable.DEPOSIT_BOX} label="5" value={1} />
          </layer>
          <layer x="center" y={{ bottom: Layout.quantity.ten }} w="fill" h={Layout.quantity.h}>
            <QuantityButton table={QuantityTable.DEPOSIT_BOX} label="10" value={4} />
          </layer>
          <layer
            x="center"
            y={{ bottom: Layout.quantity.x }}
            w="fill"
            h={Layout.quantity.h}
            options={['', Copy.SET_CUSTOM_QUANTITY]}
          >
            <QuantityButton table={QuantityTable.DEPOSIT_BOX} label="X" value={3} />
          </layer>
          <layer x="center" y={{ bottom: Layout.quantity.all }} w="fill" h={Layout.quantity.h}>
            <QuantityButton table={QuantityTable.DEPOSIT_BOX} label="All" value={2} />
          </layer>
        </layer>
      </layer>

      <layer ref={depositBlocker} x="center" y="center" w="fill" h="fill" onLoad={() => resetDepositMenu()} />

      <layer
        ref={depositSettingsMenu}
        x="center"
        y={{ bottom: Layout.settings.bottom }}
        w={{ fill: Layout.settings.inset }}
        h={{ fill: Layout.settings.drop }}
        hide
      >
        <DepositSettingsRow />
      </layer>
    </>
  );
}
