import { createRef } from 'ts2';
import { BankDepositbox } from './bank-depositbox.component';
import { Panel } from './bank-depositbox.constants';
import { setMobileFullscreen } from '../lib/lib.toplevel';

const bankDepositboxRef = createRef('bank_depositbox');

export const bankDepositboxUi = (): UI => (
  <ui ref={bankDepositboxRef} w={Panel.WIDTH} h={Panel.HEIGHT} x="center" y="center">
    <BankDepositbox />
    <layer x={0} y={0} w={0} h={0} onLoad={() => setMobileFullscreen(1)} />
  </ui>
);
