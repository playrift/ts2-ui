import { useServerState } from 'ts2';

import { ActionButton } from '../0607_fossil_driftnet/action-button.component';
import { Copy, DepositBoxSprites, DepositBoxVarbits, Layout } from './bank-depositbox.constants';

export function DepositButtonRow(): Component {
  const wornHidden: Int = useServerState(DepositBoxVarbits.WORN_BUTTON_HIDDEN);

  if (wornHidden === 1) {
    return (
      <>
        <layer x={{ center: Layout.buttons.hiddenDx }} y="center" w={Layout.buttons.buttonW} h="fill">
          <ActionButton label={Copy.DEPOSIT_INV} icon={DepositBoxSprites.ICON_DEPOSIT_INV} />
        </layer>
        <layer x={{ center: -Layout.buttons.hiddenDx }} y="center" w={Layout.buttons.buttonW} h="fill">
          <ActionButton label={Copy.EMPTY_CONTAINERS} icon={DepositBoxSprites.ICON_EMPTY_CONTAINERS} />
        </layer>
      </>
    );
  }

  return (
    <>
      <layer x="right" y="center" w={Layout.buttons.buttonW} h="fill">
        <ActionButton label={Copy.DEPOSIT_WORN} icon={DepositBoxSprites.ICON_DEPOSIT_WORN} />
      </layer>
      <layer x="center" y="center" w={Layout.buttons.buttonW} h="fill">
        <ActionButton label={Copy.DEPOSIT_INV} icon={DepositBoxSprites.ICON_DEPOSIT_INV} />
      </layer>
      <layer x={0} y="center" w={Layout.buttons.buttonW} h="fill">
        <ActionButton label={Copy.EMPTY_CONTAINERS} icon={DepositBoxSprites.ICON_EMPTY_CONTAINERS} />
      </layer>
    </>
  );
}
