import { ObjectBoxColor, ObjectBoxFonts, ObjectBoxLayout, ObjectSlot } from './objectbox.constants';

export function ObjectBox(): Component {
  return (
    <>
      <model x={ObjectSlot.X} y={ObjectSlot.Y} w={ObjectSlot.SIZE} h={ObjectSlot.SIZE} zoom={ObjectSlot.ZOOM} />

      <text
        x={ObjectBoxLayout.TEXT_X}
        y={ObjectBoxLayout.TEXT_Y}
        w={ObjectBoxLayout.TEXT_W}
        h={ObjectBoxLayout.TEXT_H}
        font={ObjectBoxFonts.BODY}
        color={ObjectBoxColor.MESSAGE}
        align="center"
        valign="middle"
      />
    </>
  );
}
