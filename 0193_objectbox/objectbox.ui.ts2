import { createRef } from 'ts2';
import { ObjectBox } from './objectbox.component';
import { ObjectBoxLayout } from './objectbox.constants';

const objectBoxRef = createRef('objectbox');

export const objectBoxUi = (): UI => (
  <ui ref={objectBoxRef} w={ObjectBoxLayout.ROOT_W} h={ObjectBoxLayout.ROOT_H} x="center" y="center">
    <ObjectBox />
  </ui>
);
