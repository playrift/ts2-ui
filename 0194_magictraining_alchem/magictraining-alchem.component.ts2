import { createRef } from 'ts2';

import {
  AlchemArrows,
  AlchemColor,
  AlchemFonts,
  AlchemModel,
  AlchemRowYs,
  Layout,
} from './magictraining-alchem.constants';
import { magictrainingAlchInit } from '../0553_magictraining_main/magictraining.overlay';

const dodger = createRef('magictraining_alchem_dodger');

const contents = createRef('magictraining_alchem_contents');

export function MagicTrainingAlchem_(): Component {
  return (
    <layer w="fill" h="fill" onTimer={() => magictrainingAlchInit(dodger, contents)}>
      <layer ref={dodger} w="fill" h="fill">
        <layer ref={contents} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.ARENA_RIGHT }}
            y={Layout.ARENA_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={AlchemModel.ARENA}
            zoom={Layout.ARENA_ZOOM}
            pitch={Layout.ARENA_PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={AlchemFonts.TITLE}
            text="Alchemy"
            align="center"
            valign="middle"
            shadow
            color={AlchemColor.HEADING}
          />

          <text
            x={Layout.HEADER_X}
            y={Layout.HEADER_Y}
            w={Layout.HEADER_W}
            h={Layout.HEADER_H}
            font={AlchemFonts.ROW}
            text="Pizazz Points:"
            shadow
            color={AlchemColor.HEADING}
          />

          <text
            x={{ right: Layout.POINTS_RIGHT }}
            y={Layout.POINTS_Y}
            w={Layout.POINTS_W}
            h={Layout.ROW_H}
            font={AlchemFonts.ROW}
            text="9999"
            align="right"
            shadow
            color={AlchemColor.VALUE}
          />

          <text
            x={Layout.ITEM_X}
            y={58}
            w={Layout.ITEM_W}
            h={Layout.ROW_H}
            font={AlchemFonts.ROW}
            text="Leather Boots:"
            shadow
            color={AlchemColor.ITEM}
          />

          <text
            x={Layout.ITEM_X}
            y={81}
            w={Layout.ITEM_W}
            h={Layout.ROW_H_TALL}
            font={AlchemFonts.ROW}
            text="Adamant Kiteshield:"
            valign="middle"
            shadow
            color={AlchemColor.ITEM}
          />

          <text
            x={Layout.ITEM_X}
            y={104}
            w={Layout.ITEM_W}
            h={Layout.ROW_H}
            font={AlchemFonts.ROW}
            text="Adamant Helm:"
            shadow
            color={AlchemColor.ITEM}
          />

          <text
            x={Layout.ITEM_X}
            y={127}
            w={Layout.ITEM_W}
            h={Layout.ROW_H}
            font={AlchemFonts.ROW}
            text="Emerald:"
            shadow
            color={AlchemColor.ITEM}
          />

          <text
            x={Layout.ITEM_X}
            y={150}
            w={Layout.ITEM_W}
            h={Layout.ROW_H}
            font={AlchemFonts.ROW}
            text="Rune Longsword:"
            valign="middle"
            shadow
            color={AlchemColor.ITEM}
          />

          {AlchemRowYs.map((y) => (
            <text
              x={{ right: Layout.COST_RIGHT }}
              y={y}
              w={Layout.COST_W}
              h={Layout.ROW_H}
              font={AlchemFonts.ROW}
              text="999"
              align="right"
              shadow
              color={AlchemColor.VALUE}
            />
          ))}

          {AlchemArrows.map((arrow) => (
            <layer x={arrow.x} y={arrow.y} w={Layout.ARROW_W} h={Layout.ARROW_H} hide>
              <model
                w={Layout.ARROW_W}
                h={Layout.ARROW_H}
                model={AlchemModel.ARROW}
                zoom={Layout.ARROW_ZOOM}
                pitch={arrow.pitch}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
