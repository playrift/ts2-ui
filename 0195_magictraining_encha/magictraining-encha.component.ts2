import { createRef, useInterval } from 'ts2';

import {
  EnchaColor,
  EnchaFonts,
  EnchaModel,
  EnchaShapes,
  Layout,
  SHAPE_HOLDER_W,
} from './magictraining-encha.constants';
import { magictrainingOtherInit } from '../0553_magictraining_main/magictraining.overlay';

const timerHost = createRef('0195_magictraining_encha_timer_host');

const dodgerTop = createRef('magictraining_encha_dodger_top');

const dodgerRight = createRef('magictraining_encha_dodger_right');

const contentTop = createRef('magictraining_encha_content_top');

const contentRight = createRef('magictraining_encha_content_right');

export function MagicTrainingEncha_(): Component {
  useInterval(() => magictrainingOtherInit(dodgerTop, dodgerRight, contentTop, contentRight), timerHost);

  return (
    <layer w="fill" h="fill" ref={timerHost}>
      <layer ref={dodgerTop} w="fill" h="fill">
        <layer ref={contentTop} x="right" y={Layout.TOP_Y} w={Layout.TOP_W} h={Layout.TOP_H}>
          <model
            x={{ right: Layout.CHAMBER_RIGHT }}
            y={Layout.CHAMBER_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={EnchaModel.CHAMBER}
            zoom={Layout.CHAMBER_ZOOM}
            pitch={Layout.CHAMBER_PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={EnchaFonts.TITLE}
            text="Enchantment"
            align="center"
            valign="middle"
            shadow
            color={EnchaColor.TITLE}
          />

          <text
            x={{ right: Layout.LABEL_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={EnchaFonts.ROW}
            text="Pizazz Points:"
            shadow
            color={EnchaColor.LABEL}
          />

          <text
            x={{ right: Layout.POINTS_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.POINTS_W}
            h={Layout.LABEL_H}
            font={EnchaFonts.ROW}
            text="9999"
            align="right"
            shadow
            color={EnchaColor.VALUE}
          />
        </layer>
      </layer>

      <layer ref={dodgerRight} w="fill" h="fill">
        <layer ref={contentRight} x="right" y="bottom" w={Layout.BOTTOM_W} h={Layout.BOTTOM_H}>
          {EnchaShapes.map((shape) => (
            <layer x="right" y="bottom" w={SHAPE_HOLDER_W} h={shape.h} hide>
              <model
                x={Layout.SHAPE_X}
                y={Layout.SHAPE_Y}
                w={Layout.MODEL_W}
                h={Layout.MODEL_H}
                model={shape.model}
                zoom={shape.zoom}
                pitch={shape.pitch}
                yaw={shape.yaw}
              />
            </layer>
          ))}

          <text
            x={{ right: Layout.BONUS_RIGHT }}
            y={{ bottom: Layout.BONUS_BOTTOM }}
            w={Layout.BONUS_W}
            h={Layout.BONUS_H}
            font={EnchaFonts.ROW}
            text="Bonus:"
            align="center"
            valign="middle"
            shadow
            color={EnchaColor.LABEL}
          />
        </layer>
      </layer>
    </layer>
  );
}
