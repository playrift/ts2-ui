import { createRef, useInterval } from 'ts2';

import { GraveBones, GraveColor, GraveFonts, GraveModel, GraveRanks, Layout } from './magictraining-grave.constants';
import { magictrainingOtherInit } from '../0553_magictraining_main/magictraining.overlay';

const timerHost = createRef('0196_magictraining_grave_timer_host');

const dodgerTop = createRef('magictraining_grave_dodger_top');

const dodgerRight = createRef('magictraining_grave_dodger_right');

const contentTop = createRef('magictraining_grave_content_top');

const contentRight = createRef('magictraining_grave_content_right');

export function MagicTrainingGrave_(): Component {
  useInterval(() => magictrainingOtherInit(dodgerTop, dodgerRight, contentTop, contentRight), timerHost);

  return (
    <layer w="fill" h="fill" ref={timerHost}>
      <layer ref={dodgerTop} w="fill" h="fill">
        <layer ref={contentTop} x="right" y={Layout.TOP_Y} w={Layout.TOP_W} h={Layout.TOP_H}>
          <model
            x={{ right: Layout.CHAMBER_RIGHT }}
            y={Layout.CHAMBER_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={GraveModel.CHAMBER}
            zoom={Layout.CHAMBER_ZOOM}
            pitch={Layout.CHAMBER_PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={GraveFonts.TITLE}
            text="Graveyard"
            align="center"
            valign="middle"
            shadow
            color={GraveColor.LABEL}
          />

          <text
            x={{ right: Layout.LABEL_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={GraveFonts.ROW}
            text="Pizazz Points:"
            shadow
            color={GraveColor.LABEL}
          />

          <text
            x={{ right: Layout.POINTS_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.POINTS_W}
            h={Layout.LABEL_H}
            font={GraveFonts.ROW}
            text="9999"
            align="right"
            shadow
            color={GraveColor.VALUE}
          />
        </layer>
      </layer>

      <layer ref={dodgerRight} w="fill" h="fill">
        <layer ref={contentRight} x="right" y="bottom" w={Layout.BOTTOM_W} h={Layout.BOTTOM_H}>
          {GraveBones.map((bone) => (
            <model
              x={{ right: bone.right }}
              y={{ bottom: bone.bottom }}
              w={Layout.MODEL_W}
              h={Layout.MODEL_H}
              model={bone.model}
              zoom={bone.zoom}
              pitch={bone.pitch}
              yaw={bone.yaw}
            />
          ))}

          {GraveRanks.map((rank) => (
            <text
              x={{ right: Layout.RANK_RIGHT }}
              y={{ bottom: rank.bottom }}
              w={Layout.RANK_W}
              h={Layout.RANK_H}
              font={GraveFonts.RANK}
              text={rank.text}
              align="center"
              shadow
              color={rank.color}
            />
          ))}
        </layer>
      </layer>
    </layer>
  );
}
