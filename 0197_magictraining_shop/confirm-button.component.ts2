import { useServerState, useState } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { Confirm, NO_SELECTION, ShopColor, ShopFonts, ShopVarbits } from './magictraining-shop.constants';
import { MagicTrainingRewards } from './magictraining-shop.data';
import { confirmCaption } from './magictraining-shop.helpers';

export function ConfirmButton(): Component {
  const [pressed, setPressed] = useState(0);
  const selected: Int = useServerState(ShopVarbits.SELECTED);
  const reward: ItemName = MagicTrainingRewards.at(selected) ?? -1;
  const caption: String = confirmCaption(selected, itemName(reward as Item));

  if (pressed === 1) {
    return (
      <layer w="fill" h="fill" onMouseRepeat={() => setPressed(1)} onMouseLeave={() => setPressed(0)}>
        <StoneButtonPressedFilled>
          <text
            x="center"
            y="center"
            w={{ fill: Confirm.INSET }}
            h={{ fill: Confirm.INSET }}
            font={ShopFonts.BODY}
            text={caption}
            align="center"
            valign="middle"
            lineHeight={Confirm.LINE_HEIGHT}
            shadow
            color={ShopColor.LABEL}
          />
        </StoneButtonPressedFilled>
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => setPressed(1)} onMouseLeave={() => setPressed(0)}>
      <StoneButtonFilled>
        <text
          x="center"
          y="center"
          w={{ fill: Confirm.INSET }}
          h={{ fill: Confirm.INSET }}
          font={ShopFonts.BODY}
          text={caption}
          align="center"
          valign="middle"
          lineHeight={Confirm.LINE_HEIGHT}
          shadow
          color={ShopColor.LABEL}
        />
      </StoneButtonFilled>
    </layer>
  );
}
