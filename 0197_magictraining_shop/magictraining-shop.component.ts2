import { useRef, useUniverse } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ConfirmButton } from './confirm-button.component';
import { CostPanel } from './cost-panel.component';
import { Layout, SHOP_TITLE, ShopScrollbarSprites, Strip } from './magictraining-shop.constants';
import { MagicTrainingRewards } from './magictraining-shop.data';
import { QuantityStrip } from './quantity-strip.component';
import { RewardShelf } from './reward-shelf.component';

export function MagicTrainingShop(): Component {
  const slot = useUniverse();
  const shelfH: Int = slot.height - Layout.ROOT_INSET - Layout.CONTENT_H_INSET - Layout.REWARDS_H_INSET;
  const rows: Int = (MagicTrainingRewards.length + Layout.SHELF_COLUMNS - 1) / Layout.SHELF_COLUMNS;
  const shelf = useRef();

  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_INSET }} h={{ fill: Layout.ROOT_INSET }}>
      <SteelBorderEntrypoint title={SHOP_TITLE} />

      <layer x="center" y={Layout.CONTENT_Y} w={{ fill: Layout.CONTENT_W_INSET }} h={{ fill: Layout.CONTENT_H_INSET }}>
        <layer x="right" y={0} w={Layout.SCROLLBAR_W} h={{ fill: Layout.SCROLLBAR_H_INSET }}>
          <ScrollbarVertical
            content={shelf}
            track={ShopScrollbarSprites.TRACK}
            capTopSprite={ShopScrollbarSprites.CAP_TOP}
            thumbSprite={ShopScrollbarSprites.THUMB}
            capBottomSprite={ShopScrollbarSprites.CAP_BOTTOM}
            arrowUp={ShopScrollbarSprites.ARROW_UP}
            arrowDown={ShopScrollbarSprites.ARROW_DOWN}
          />
        </layer>

        <layer x={{ right: Layout.BUYX_RIGHT }} y={0} w={Strip.BUTTON} h={Strip.MOUNT_H}>
          <QuantityStrip />
        </layer>

        <layer
          ref={shelf}
          x={0}
          y={0}
          w={{ fill: Layout.REWARDS_W_INSET }}
          h={{ fill: Layout.REWARDS_H_INSET }}
          scrollHeight={rows * (shelfH / Layout.SHELF_ROWS)}
        >
          <RewardShelf />
        </layer>

        <layer x={0} y="bottom" w="fill" h={Layout.FOOTER_H}>
          <layer x="right" y={0} w={Layout.CONFIRM_W} h={Layout.CONFIRM_H} options={['Confirm']}>
            <ConfirmButton />
          </layer>

          <layer x={0} y={0} w={{ fill: Layout.COSTS_W_INSET }} h="fill">
            <CostPanel />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
