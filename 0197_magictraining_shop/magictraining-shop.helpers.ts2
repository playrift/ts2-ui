import { predictServerState, useServerState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { Costs, NO_SELECTION, ShopColor, ShopVarbits, ShopVarps } from './magictraining-shop.constants';

export function selectReward(option: Int, reward: Int): void {
  if (option !== 1) {
    return;
  }
  predictServerState(ShopVarps.QUANTITY, 1);
  predictServerState(ShopVarbits.SELECTED, reward);
}

export function costColour(pool: Int, needed: Int, quantity: Int): Int {
  if (pool < needed || quantity === 0) {
    return ShopColor.SHORT;
  }
  return ShopColor.AFFORDABLE;
}

export function costLine(label: String, pool: Int, needed: Int, quantity: Int): String {
  if (quantity === 0) {
    return `${label}: ?`;
  }
  return `${label}: ${groupDigits(pool, Costs.SEPARATOR)}/${groupDigits(needed, Costs.SEPARATOR)}`;
}

export function confirmCaption(reward: Int, name: String): String {
  if (reward === NO_SELECTION) {
    return 'Select a reward';
  }
  return `Confirm: <br><col=ffffff>${name}</col> <br>x${stringOf(useServerState(ShopVarps.QUANTITY))}`;
}
