import { useServerState } from 'ts2';

import { SkillQuantityButton } from '../lib/skillmain-quantity.component';
import { Strip } from './magictraining-shop.constants';
import { ShopVarps } from './magictraining-shop.constants';

export function QuantityStrip(): Component {
  const chosen: Int = useServerState(ShopVarps.QUANTITY);
  const quantity: Int = Math.min(Strip.MAX, chosen);

  return (
    <layer w="fill" h="fill">
      <layer x="center" y={0} w={Strip.BUTTON} h={Strip.BUTTON}>
        <SkillQuantityButton quantity={1} selected={quantity === 1 ? true : false} material={Strip.MATERIAL} />
      </layer>

      <layer x="center" y={Strip.DY} w={Strip.BUTTON} h={Strip.BUTTON}>
        <SkillQuantityButton quantity={5} selected={quantity === 5 ? true : false} material={Strip.MATERIAL} />
      </layer>

      <layer x="center" y={Strip.DY * 2} w={Strip.BUTTON} h={Strip.BUTTON}>
        <SkillQuantityButton quantity={10} selected={quantity === 10 ? true : false} material={Strip.MATERIAL} />
      </layer>

      <layer x="center" y={Strip.DY * 3} w={Strip.BUTTON} h={Strip.BUTTON}>
        <SkillQuantityButton
          quantity={Strip.ALL}
          selected={quantity >= Strip.MAX ? true : false}
          material={Strip.MATERIAL}
          isAll
        />
      </layer>
    </layer>
  );
}
