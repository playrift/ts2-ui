import { createRef } from 'ts2';

import { Layout, TeleColor, TeleFonts, TeleModel } from './magictraining-tele.constants';
import { magictrainingOtherInit } from '../0553_magictraining_main/magictraining.overlay';

const dodgerTop = createRef('magictraining_tele_dodger_top');

const dodgerRight = createRef('magictraining_tele_dodger_right');

const contentTop = createRef('magictraining_tele_content_top');

const contentRight = createRef('magictraining_tele_content_right');

export function MagicTrainingTele_(): Component {
  return (
    <layer w="fill" h="fill" onTimer={() => magictrainingOtherInit(dodgerTop, dodgerRight, contentTop, contentRight)}>
      <layer ref={dodgerTop} w="fill" h="fill">
        <layer ref={contentTop} x="right" y={Layout.TOP_Y} w={Layout.TOP_W} h={Layout.TOP_H}>
          <model
            x={{ right: Layout.CHAMBER_RIGHT }}
            y={Layout.CHAMBER_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={TeleModel.CHAMBER}
            zoom={Layout.CHAMBER_ZOOM}
            pitch={Layout.CHAMBER_PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={TeleFonts.TITLE}
            text="Telekinetic"
            align="center"
            valign="middle"
            shadow
            color={TeleColor.TITLE}
          />

          <text
            x={{ right: Layout.LABEL_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={TeleFonts.ROW}
            text="Pizazz Points:"
            shadow
            color={TeleColor.LABEL}
          />

          <text
            x={{ right: Layout.POINTS_RIGHT }}
            y={Layout.LABEL_Y}
            w={Layout.POINTS_W}
            h={Layout.LABEL_H}
            font={TeleFonts.ROW}
            text="999999"
            align="right"
            shadow
            color={TeleColor.VALUE}
          />
        </layer>
      </layer>

      <layer ref={dodgerRight} w="fill" h="fill">
        <layer ref={contentRight} x="right" y="bottom" w={Layout.BOTTOM_W} h={Layout.BOTTOM_H}>
          <model
            x={{ right: Layout.GUARDIAN_RIGHT }}
            y={{ bottom: Layout.GUARDIAN_BOTTOM }}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={TeleModel.GUARDIAN}
            zoom={Layout.GUARDIAN_ZOOM}
            pitch={Layout.GUARDIAN_PITCH}
            yaw={Layout.GUARDIAN_YAW}
          />

          <text
            x="right"
            y={{ bottom: Layout.SOLVED_BOTTOM }}
            w={Layout.SOLVED_W}
            h={Layout.SOLVED_H}
            font={TeleFonts.COUNTER}
            text="Solved:"
            align="center"
            valign="middle"
            shadow
            color={TeleColor.VALUE}
          />

          <text
            x="right"
            y={{ bottom: Layout.COUNT_BOTTOM }}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            font={TeleFonts.COUNTER}
            text="999"
            align="center"
            valign="middle"
            shadow
            color={TeleColor.VALUE}
          />
        </layer>
      </layer>
    </layer>
  );
}
