import { createRef, useInterval } from 'ts2';

import { ThinBox } from '../lib/thin-box.component';
import { FfaArt, FfaColor, FfaFonts, HINT, Plate } from './clanwars-ffa.constants';
import { clanwarsFfaHint } from './clanwars-ffa.helpers';
import { clanwarsFfaLayout } from './clanwars-ffa.layout';

const timerHost1 = createRef('0199_clanwars_ffa_timer_host1');

const timerHost2 = createRef('0199_clanwars_ffa_timer_host2');

const ffaPlate = createRef('clanwars_ffa_plate');

export function ClanwarsFfa(): Component {
  useInterval(() => clanwarsFfaHint(ffaPlate), timerHost1);
  useInterval(() => clanwarsFfaLayout(timerHost2, ffaPlate), timerHost2);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={ffaPlate} x="center" y={Plate.Y} w={1} h={1}>
          <sprite x={0} y={0} w="fill" h="fill" sprite={FfaArt.BACKING} tiling transparency={Plate.BACKING_WASH} />

          <ThinBox />

          <text
            x={0}
            y={Plate.TEXT_Y}
            w="fill"
            h={Plate.TEXT_H}
            text={HINT}
            align="center"
            valign="middle"
            shadow
            font={FfaFonts.HINT}
            color={FfaColor.HINT}
          />
        </layer>
      </layer>
    </layer>
  );
}
