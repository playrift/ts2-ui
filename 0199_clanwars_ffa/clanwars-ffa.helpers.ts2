import { coordInBox } from '../lib/lib.helpers';
import { playerCoord } from '../lib/lib.engine';
import { FfaZone } from './clanwars-ffa.constants';

export function clanwarsFfaHint(plate: ComponentId): void {
  if (
    coordInBox(
      tileOf(FfaZone.MIN_X, FfaZone.MIN_Z, FfaZone.MIN_PLANE),
      tileOf(FfaZone.MAX_X, FfaZone.MAX_Z, FfaZone.MAX_PLANE),
      playerCoord(),
    )
  ) {
    plate.hide = false;
  } else {
    plate.hide = true;
  }
}
