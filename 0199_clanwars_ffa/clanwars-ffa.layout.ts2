import { CS2 } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { textWidth } from '../lib/lib.engine';
import { FfaFonts, FfaOverlay, HINT, Plate } from './clanwars-ffa.constants';

const enum SizeMode {
  ABS = 0,
}

export function clanwarsFfaLayout(dodger: ComponentId, plate: ComponentId): void {
  CS2.if_size_set(
    textWidth(HINT, Plate.MEASURE_WIDTH, FfaFonts.HINT) + Plate.PADDING,
    Plate.H,
    SizeMode.ABS,
    SizeMode.ABS,
    plate,
  );
  overlayRelayout(dodger, plate, FfaOverlay.DODGE, Anchor.CENTRE, Anchor.TOP, 0);
}
