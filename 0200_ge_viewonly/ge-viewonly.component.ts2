import { useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { GeTooltip } from './ge-tooltip.component';
import { GeOfferSlot } from './ge-offer-slot.component';
import { GeColors, GeFonts, Panel } from './ge-viewonly.constants';
import { panel, tooltipHost } from './ge-viewonly.refs';
import { hideGeTooltip, showGeTooltip } from './ge-viewonly.state';

export function GeSlots(): Component {
  const inv0 = useInventory(Inventories.TRADINGPOST_SELL_0);
  const inv1 = useInventory(Inventories.TRADINGPOST_SELL_1);
  const inv2 = useInventory(Inventories.TRADINGPOST_SELL_2);
  const inv3 = useInventory(Inventories.TRADINGPOST_SELL_3);
  const inv4 = useInventory(Inventories.TRADINGPOST_SELL_4);
  const inv5 = useInventory(Inventories.TRADINGPOST_SELL_5);
  const inv6 = useInventory(Inventories.GE_COLLECT_6);
  const inv7 = useInventory(Inventories.GE_COLLECT_7);

  const a0: Item = inv0[0];
  const b0: Item = inv0[1];
  const a1: Item = inv1[0];
  const b1: Item = inv1[1];
  const a2: Item = inv2[0];
  const b2: Item = inv2[1];
  const a3: Item = inv3[0];
  const b3: Item = inv3[1];
  const a4: Item = inv4[0];
  const b4: Item = inv4[1];
  const a5: Item = inv5[0];
  const b5: Item = inv5[1];
  const a6: Item = inv6[0];
  const b6: Item = inv6[1];
  const a7: Item = inv7[0];
  const b7: Item = inv7[1];

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer
        x={Panel.SLOT_NEAR}
        y={Panel.ROW_0}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(0)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={0} held0={a0} count0={inv0.count(0)} held1={b0} count1={inv0.count(1)} />
      </layer>
      <layer
        x={Panel.SLOT_MID}
        y={Panel.ROW_0}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(1)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={1} held0={a1} count0={inv1.count(0)} held1={b1} count1={inv1.count(1)} />
      </layer>
      <layer
        x={{ right: Panel.SLOT_MID }}
        y={Panel.ROW_0}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(2)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={2} held0={a2} count0={inv2.count(0)} held1={b2} count1={inv2.count(1)} />
      </layer>
      <layer
        x={{ right: Panel.SLOT_NEAR }}
        y={Panel.ROW_0}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(3)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={3} held0={a3} count0={inv3.count(0)} held1={b3} count1={inv3.count(1)} />
      </layer>
      <layer
        x={Panel.SLOT_NEAR}
        y={Panel.ROW_1}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(4)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={4} held0={a4} count0={inv4.count(0)} held1={b4} count1={inv4.count(1)} />
      </layer>
      <layer
        x={Panel.SLOT_MID}
        y={Panel.ROW_1}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(5)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={5} held0={a5} count0={inv5.count(0)} held1={b5} count1={inv5.count(1)} />
      </layer>
      <layer
        x={{ right: Panel.SLOT_MID }}
        y={Panel.ROW_1}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(6)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={6} held0={a6} count0={inv6.count(0)} held1={b6} count1={inv6.count(1)} />
      </layer>
      <layer
        x={{ right: Panel.SLOT_NEAR }}
        y={Panel.ROW_1}
        w={Panel.SLOT_W}
        h={Panel.SLOT_H}
        onMouseRepeat={() => showGeTooltip(7)}
        onMouseLeave={() => hideGeTooltip()}
      >
        <GeOfferSlot slot={7} held0={a7} count0={inv7.count(0)} held1={b7} count1={inv7.count(1)} />
      </layer>
    </layer>
  );
}

export function GeViewonly(): Component {
  return (
    <>
      <layer static ref={panel} x="center" y="center" w={Panel.W} h={Panel.H}>
        <SteelBorderEntrypoint title="Grand Exchange Offer Status" />

        <text
          x="center"
          y={Panel.TEXT_Y}
          w="fill"
          h={Panel.TEXT_H}
          font={GeFonts.BODY}
          color={GeColors.INSTRUCTION}
          shadow
          align="center"
          valign="middle"
          lineHeight={Panel.LINE}
          text={
            'Visit a <col=ffffff>bank</col> to <col=ffffff>collect items</col>,' +
            ' or <col=ffffff>set up offers</col><br>at the' +
            ' <col=ffffff>Grand Exchange</col> near Varrock.'
          }
        />

        <GeSlots />
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w="fill" h="fill">
        <GeTooltip />
      </layer>
    </>
  );
}
