import { Sprites } from '../lib/game/sprites';

export declare const StonePanelSprite: {
  readonly TOP: typeof Sprites.V2_BORDERS_SLIM_0;
  readonly LEFT: typeof Sprites.V2_BORDERS_SLIM_1;
  readonly BOTTOM: typeof Sprites.V2_BORDERS_SLIM_2;
  readonly RIGHT: typeof Sprites.V2_BORDERS_SLIM_3;
  readonly TOP_LEFT: typeof Sprites.V2_BORDERS_SLIM_4;
  readonly TOP_RIGHT: typeof Sprites.V2_BORDERS_SLIM_5;
  readonly BOTTOM_LEFT: typeof Sprites.V2_BORDERS_SLIM_6;
  readonly BOTTOM_RIGHT: typeof Sprites.V2_BORDERS_SLIM_7;
  readonly DIVIDER: typeof Sprites.V2_BORDERS_SLIM_8;
  readonly DIVIDER_LEFT: typeof Sprites.V2_BORDERS_SLIM_9;
  readonly DIVIDER_RIGHT: typeof Sprites.V2_BORDERS_SLIM_10;
};

export function StonePanel({ divider = 0 }: { divider?: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={16} y={-13} w={{ fill: 32 }} h={32} sprite={StonePanelSprite.TOP} tiling />
      <sprite x={16} y={{ bottom: -12 }} w={{ fill: 32 }} h={32} sprite={StonePanelSprite.BOTTOM} tiling />
      <sprite x={-14} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelSprite.LEFT} tiling />
      <sprite x={{ right: -12 }} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelSprite.RIGHT} tiling />

      <sprite x="left" y="top" w={32} h={32} sprite={StonePanelSprite.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={StonePanelSprite.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={StonePanelSprite.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={StonePanelSprite.BOTTOM_RIGHT} tiling />

      {divider >= 6 && <sprite x="left" y={divider - 20} w="fill" h={32} sprite={StonePanelSprite.DIVIDER} tiling />}
      {divider >= 6 && <sprite x="left" y={divider - 18} w={32} h={32} sprite={StonePanelSprite.DIVIDER_LEFT} tiling />}
      {divider >= 6 && (
        <sprite x="right" y={divider - 18} w={32} h={32} sprite={StonePanelSprite.DIVIDER_RIGHT} tiling />
      )}
    </layer>
  );
}
