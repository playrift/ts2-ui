import { magicToString } from '../0126_farming_tools_side/carried-tools.shared';
import { AutocastColor, AutocastWeapon, Spellbook } from './autocast.constants';
import {
  AncientLayout,
  ArceuusLayout,
  IbanStaffLayout,
  NoLayout,
  SkullSceptreImbuedLayout,
  SlayerStaffLayout,
  SpellPos,
  StaffOfBalanceLayout,
  StaffOfLightLayout,
  StaffOfTheDeadLayout,
  StandardLayout,
  VoidMaceLayout,
  WildSceptreLayout,
} from './autocast-layouts.data';

export function autocastLayout(weapon: Item, spellbook: Int): Map<Int, SpellPos> {
  if (weapon === -1) {
    return StandardLayout;
  }
  switch (weapon) {
    case AutocastWeapon.SOS_SKULL_SCEPTRE:
      return ArceuusLayout;
    case AutocastWeapon.STAFF_OF_ZAROS:
      return AncientLayout;
    case AutocastWeapon.SLAYER_STAFF:
      return SlayerStaffLayout;
    case AutocastWeapon.PEST_VOID_KNIGHT_MACE:
      return VoidMaceLayout;
    case AutocastWeapon.IBANSTAFF:
      return IbanStaffLayout;
    case AutocastWeapon.SOTD:
      return StaffOfTheDeadLayout;
    case AutocastWeapon.STAFF_OF_LIGHT:
      return StaffOfLightLayout;
    case AutocastWeapon.STAFF_OF_BALANCE:
      return StaffOfBalanceLayout;
    case AutocastWeapon.WILD_CAVE_SCEPTRE_UNCHARGED_RECOL:
    case AutocastWeapon.WILD_CAVE_SCEPTRE_CHARGED_RECOL:
    case AutocastWeapon.WILD_CAVE_ACCURSED_UNCHARGED_RECOL:
    case AutocastWeapon.WILD_CAVE_ACCURSED_CHARGED_RECOL:
      return WildSceptreLayout;
    case AutocastWeapon.KODAI_WAND:
      return ArceuusLayout;
    case AutocastWeapon.BARROWS_AHRIM_WEAPON: {
      if (spellbook === Spellbook.ARCEUUS) {
        return ArceuusLayout;
      }
      return StandardLayout;
    }
    case AutocastWeapon.SOS_SKULL_SCEPTRE_IMBUED: {
      if (spellbook === Spellbook.STANDARD) {
        return SkullSceptreImbuedLayout;
      } else if (spellbook === Spellbook.ARCEUUS) {
        return ArceuusLayout;
      }
      return NoLayout;
    }
  }
  return NoLayout;
}

export function runeCountLabel(exact: Int, have: Int, need: Int): String {
  if (have >= need) {
    if (exact === 1) {
      return `${stringOf(need)}/${stringOf(need)}`;
    }
    return `${magicToString(have)}/${stringOf(need)}`;
  }
  return `${magicToString(have)}/${stringOf(need)}`;
}

export function runeCountColor(have: Int, need: Int): Int {
  if (have >= need) {
    return AutocastColor.RUNES_ENOUGH;
  }
  return AutocastColor.RUNES_SHORT;
}

export function spellNameLine(spell: Item): String {
  if (spell.spellLevelreq! > 0 && spell.spellHideLevelreq! === false) {
    return `Level ${stringOf(spell.spellLevelreq!)}: ${spell.spellName!}`;
  }
  return spell.spellName!;
}
