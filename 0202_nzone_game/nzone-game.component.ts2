import { createRef, useInterval } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { Layout, NzoneDodge, NzoneGameColor, NzoneGameFonts, NzoneSideways } from './nzone-game.constants';

const timerHost = createRef('0202_nzone_game_timer_host');

const dodgerLeft = createRef('nzone_game_dodger_left');
const contentLeft = createRef('nzone_game_content_left');
const dodgerMid = createRef('nzone_game_dodger_mid');
const contentMid = createRef('nzone_game_content_mid');
const dodgerRight = createRef('nzone_game_dodger_right');
const contentRight = createRef('nzone_game_content_right');

export function nzoneGameInit(
  leftDodger: ComponentId,
  leftContent: ComponentId,
  midDodger: ComponentId,
  midContent: ComponentId,
  rightDodger: ComponentId,
  rightContent: ComponentId,
): void {
  overlayInit(leftDodger, leftContent, NzoneDodge.SIDE, Anchor.LEFT, Anchor.TOP, NzoneSideways.NO);
  overlayInit(midDodger, midContent, NzoneDodge.SIDE, Anchor.CENTRE, Anchor.TOP, NzoneSideways.NO);
  overlayInit(rightDodger, rightContent, NzoneDodge.RIGHT, Anchor.RIGHT, Anchor.TOP, NzoneSideways.NO);
}

export function NzoneGame(): Component {
  useInterval(
    () => nzoneGameInit(dodgerLeft, contentLeft, dodgerMid, contentMid, dodgerRight, contentRight),
    timerHost,
  );

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
        <layer static ref={dodgerLeft} w="fill" h="fill">
          <layer static ref={contentLeft} w="fill" h="fill" />
        </layer>

        <layer static ref={dodgerRight} w="fill" h="fill">
          <layer static ref={contentRight} w="fill" h="fill" />
        </layer>

        <layer static ref={dodgerMid} w="fill" h="fill">
          <layer static ref={contentMid} w="fill" h="fill" />
        </layer>
      </layer>

      <text
        x="center"
        y={0}
        w={Layout.CONTROL_BOX}
        h={Layout.CONTROL_BOX}
        font={NzoneGameFonts.CONTROL}
        color={NzoneGameColor.CONTROL}
        align="center"
        shadow
      />
    </>
  );
}
