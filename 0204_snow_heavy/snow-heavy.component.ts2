import { CS2 } from 'ts2';
import { Layout, SnowAnims, SnowColors, SnowModels, SnowSheets } from './snow-heavy.constants';

export function modelTransparentInit(who: ComponentId): void {
  CS2.if_model_transparent_set(true, who);
}

export function SnowHeavy(): Component {
  return (
    <>
      {SnowSheets.map((sheet) => (
        <layer x={sheet.x} y={sheet.y} w={Layout.TILE} h={Layout.TILE}>
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={SnowModels.FLAKES}
            anim={SnowAnims.FLAKES}
            zoom={Layout.SHEET_ZOOM}
            offsetX={Layout.SHEET_OFFSET_X}
            offsetY={Layout.SHEET_OFFSET_Y}
            onLoad={(event) => modelTransparentInit(event.self)}
          />
        </layer>
      ))}

      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={SnowColors.WASH}
        transparency={Layout.WASH_TRANSPARENCY}
      />
    </>
  );
}
