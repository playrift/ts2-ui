import { Varbits } from '../lib/game/varbits';
import { useServerState } from 'ts2';

export type SkinColour = {
  key: Int;
  colour: Int;
};

export const SkinColours = listOf<SkinColour>([
  { key: 7, colour: 0xd5a985 },
  { key: 0, colour: 0xbb8f6a },
  { key: 1, colour: 0xa47f5d },
  { key: 2, colour: 0x9e7a49 },
  { key: 3, colour: 0x836e42 },
  { key: 4, colour: 0x79582a },
  { key: 5, colour: 0x644e24 },
  { key: 6, colour: 0x4c3d09 },
  { key: 8, colour: 0x007f00 },
  { key: 9, colour: 0x0f0f0f },
  { key: 10, colour: 0xffffff },
  { key: 11, colour: 0x05989f },
  { key: 12, colour: 0x6441a4 },
]);

export function skinColourUnlocked(key: Int): Boolean {
  if (key <= 7) {
    return true;
  }
  if (key === 8) {
    if (useServerState(Varbits.HW07_SKINCOLS) === 1) {
      return true;
    }
    return false;
  }
  if (key === 9 || key === 10) {
    if (useServerState(Varbits.HW15_SKINCOLS) === 1) {
      return true;
    }
    return false;
  }
  if (key === 11) {
    if (useServerState(Varbits.HW17_SKINCOLS) === 1) {
      return true;
    }
    return false;
  }
  if (key === 12) {
    return true;
  }
  return false;
}
