import { NzoneRewardsTabs } from './nzone-tabs.component';
import { NzoneLayout } from './nzone-rewards.constants';

export function NzoneRewards(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Dom Onion's Reward Shop" />

      <layer x={NzoneLayout.TABS_X} y={NzoneLayout.TABS_Y} w={NzoneLayout.TABS_W} h={NzoneLayout.TABS_H}>
        <NzoneRewardsTabs />
      </layer>

      <layer x={NzoneLayout.BODY_X} y={NzoneLayout.BODY_Y} w={NzoneLayout.PANE_W} h={NzoneLayout.PANE_H}>
        <NzoneRewardsPanes />
      </layer>
    </>
