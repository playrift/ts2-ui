import { useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { NzoneActiveTab, NzonePotions, NzoneSounds } from './nzone-rewards.constants';

export function selectNzoneTab(tab: Int): void {
  const [, setTab] = useState(NzoneActiveTab);
  playSound(NzoneSounds.TAB);
  setTab(tab);
}

export function potionDoses(potion: ItemName, dose1: Int, dose2: Int, dose3: Int, dose4: Int): String {
  if (potion === NzonePotions.ABSORPTION) {
    return `(${stringOf(dose1)})`;
  }
  if (potion === NzonePotions.OVERLOAD) {
    return `(${stringOf(dose2)})`;
  }
  if (potion === NzonePotions.SUPER_RANGING) {
    return `(${stringOf(dose3)})`;
  }
  if (potion === NzonePotions.SUPER_MAGIC) {
    return `(${stringOf(dose4)})`;
  }
  return '';
}
