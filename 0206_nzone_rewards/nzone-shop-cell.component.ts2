import { CS2 } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { ccSetTransparency } from '../0612_fossil_volcanic_shop/cc-settrans';
import { nzoneRewardPrice } from './nzone-rewards.price';
import { NzoneColor, NzoneFonts, NzoneLayout } from './nzone-rewards.constants';

export function NzoneShopCell({ item, x, y }: { item: ItemName; x: Int; y: Int }): Component {
  return (
    <>
      <sprite
        x={x}
        y={y}
        w={NzoneLayout.ICON_W}
        h={NzoneLayout.ICON_H}
        item={CS2.item_uncert(item as Item)}
        itemCount={1}
        outline={1}
        shadowColor={NzoneColor.ICON_SHADOW}
        options={['Buy-1', 'Buy-5', 'Buy-10', 'Buy-50', 'Buy-X', '', '', '', '', 'Examine']}
        optionSubject={`<col=ff9040>${itemName(item as Item)}`}
        onMouseEnter={(event) => ccSetTransparency(event.component, event.subId, 50)}
        onMouseLeave={(event) => ccSetTransparency(event.component, event.subId, 0)}
      />

      <text
        x={x}
        y={y + NzoneLayout.ICON_H}
        w={NzoneLayout.PRICE_W}
        h={NzoneLayout.PRICE_H}
        text={nzoneRewardPrice(item)}
        font={NzoneFonts.SMALL}
        color={NzoneColor.LABEL}
        shadow
        align="center"
        valign="top"
      />
    </>
  );
}
