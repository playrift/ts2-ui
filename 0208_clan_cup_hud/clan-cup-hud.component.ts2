import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { CLAN_CUP_TEXT, ClanCupDodge, ClanCupFonts, ClanCupSideways, Layout } from './clan-cup-hud.constants';
import { clancupHudUpdate } from './clan-cup-hud.helpers';

const timerHost1 = createRef('0208_clan_cup_hud_timer_host1');

const timerHost2 = createRef('0208_clan_cup_hud_timer_host2');

const content = createRef('clan_cup_hud_content');

const header = createRef('clan_cup_hud_header0');

const results = createRef('clan_cup_hud_results1');

export function ClanCupHud(): Component {
  useInterval(() => clancupHudUpdate(header, results), timerHost1);
  useInterval(
    () => overlayRelayout(timerHost2, content, ClanCupDodge.CONTENT, Anchor.LEFT, Anchor.TOP, ClanCupSideways.ALLOWED),
    timerHost2,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={content} x={0} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <text
            ref={header}
            x={Layout.TEXT_X}
            y={Layout.TEXT_Y}
            w={Layout.TEXT_W}
            h={Layout.TEXT_H}
            font={ClanCupFonts.BODY}
            lineHeight={Layout.LINE_HEIGHT}
            shadow
            color={CLAN_CUP_TEXT}
          />

          <text
            ref={results}
            x={Layout.TEXT_X}
            y={Layout.TEXT_Y}
            w={Layout.TEXT_W}
            h={Layout.TEXT_H}
            font={ClanCupFonts.BODY}
            align="right"
            lineHeight={Layout.LINE_HEIGHT}
            shadow
            color={CLAN_CUP_TEXT}
          />
        </layer>
      </layer>
    </layer>
  );
}
