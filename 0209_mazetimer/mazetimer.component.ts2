import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, MazeTimerColors, MazeTimerCopy, MazeTimerFonts, MazeTimerOverlay } from './mazetimer.constants';
import { macroMazeTimer } from './mazetimer.helpers';

const contentTop = createRef('mazetimer_content_top2');

const contentRight = createRef('mazetimer_content_right3');

export function MazeTimer(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentTop, MazeTimerOverlay.DODGE_TOP, Anchor.CENTRE, Anchor.TOP, 0)
        }
      >
        <layer ref={contentTop} x="center" y={0} w={Layout.BANNER_W} h={Layout.BANNER_H}>
          <text
            x="center"
            y={Layout.BANNER_TEXT_Y}
            w="fill"
            h={Layout.BANNER_TEXT_H}
            text={MazeTimerCopy.BANNER}
            font={MazeTimerFonts.BODY}
            align="center"
            shadow
            color={MazeTimerColors.BANNER}
          />
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentRight, MazeTimerOverlay.DODGE_RIGHT, Anchor.RIGHT, Anchor.BOTTOM, 0)
        }
      >
        <layer ref={contentRight} x="right" y="bottom" w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer
            x={{ right: Layout.INNER_RIGHT }}
            y={{ bottom: Layout.INNER_BOTTOM }}
            w={Layout.INNER_W}
            h={Layout.INNER_H}
          >
            <text
              x={Layout.LEAD_X}
              y={Layout.LEAD_Y}
              w={Layout.LEAD_W}
              h={Layout.LEAD_H}
              text={MazeTimerCopy.LEAD}
              font={MazeTimerFonts.BODY}
              align="center"
              shadow
              color={MazeTimerColors.SENTENCE}
            />

            <text
              x={Layout.VALUE_X}
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text=""
              font={MazeTimerFonts.VALUE}
              align="center"
              shadow
              color={MazeTimerColors.VALUE}
              onTimer={(event) => macroMazeTimer(event.component)}
            />

            <text
              x={Layout.TAIL_X}
              y={Layout.TAIL_Y}
              w={Layout.TAIL_W}
              h={Layout.TAIL_H}
              text={MazeTimerCopy.TAIL}
              font={MazeTimerFonts.BODY}
              align="right"
              shadow
              color={MazeTimerColors.SENTENCE}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
