import { createRef, useInterval, useWatch } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Layout,
  MazeTimerColors,
  MazeTimerCopy,
  MazeTimerFonts,
  MazeTimerOverlay,
  MazeTimerVarps,
} from './mazetimer.constants';
import { macroMazeTimer } from './mazetimer.helpers';

const timerHost1 = createRef('0209_mazetimer_timer_host1');

const timerHost2 = createRef('0209_mazetimer_timer_host2');

const contentTop = createRef('mazetimer_content_top2');

const contentRight = createRef('mazetimer_content_right3');

const percentage = createRef('mazetimer_percentage');

export function MazeTimer(): Component {
  useWatch(MazeTimerVarps.MACRO_TRANSMIT, (event) => macroMazeTimer(event.component), percentage);

  useInterval(
    () => overlayRelayout(timerHost1, contentTop, MazeTimerOverlay.DODGE_TOP, Anchor.CENTRE, Anchor.TOP, 0),
    timerHost1,
  );
  useInterval(
    () => overlayRelayout(timerHost2, contentRight, MazeTimerOverlay.DODGE_RIGHT, Anchor.RIGHT, Anchor.BOTTOM, 0),
    timerHost2,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={contentTop} x="center" y={0} w={Layout.BANNER_W} h={Layout.BANNER_H}>
          <text
            x="center"
            y={Layout.BANNER_TEXT_Y}
            w="fill"
            h={Layout.BANNER_TEXT_H}
            text={MazeTimerCopy.BANNER}
            font={MazeTimerFonts.BODY}
            align="center"
            shadow
            color={MazeTimerColors.BANNER}
          />
        </layer>
      </layer>

      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={contentRight} x="right" y="bottom" w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer
            x={{ right: Layout.INNER_RIGHT }}
            y={{ bottom: Layout.INNER_BOTTOM }}
            w={Layout.INNER_W}
            h={Layout.INNER_H}
          >
            <text
              x={Layout.LEAD_X}
              y={Layout.LEAD_Y}
              w={Layout.LEAD_W}
              h={Layout.LEAD_H}
              text={MazeTimerCopy.LEAD}
              font={MazeTimerFonts.BODY}
              align="center"
              shadow
              color={MazeTimerColors.SENTENCE}
            />

            <text
              ref={percentage}
              x={Layout.VALUE_X}
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text=""
              font={MazeTimerFonts.VALUE}
              align="center"
              shadow
              color={MazeTimerColors.VALUE}
              onLoad={(event) => macroMazeTimer(event.component)}
            />

            <text
              x={Layout.TAIL_X}
              y={Layout.TAIL_Y}
              w={Layout.TAIL_W}
              h={Layout.TAIL_H}
              text={MazeTimerCopy.TAIL}
              font={MazeTimerFonts.BODY}
              align="right"
              shadow
              color={MazeTimerColors.SENTENCE}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
