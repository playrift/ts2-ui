import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { PETLIST_TITLE, PetlistArt, PetlistLayout } from './poh-petlist.constants';

export function PohPetlist(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={PETLIST_TITLE} />

      <sprite
        x={PetlistLayout.LIST_X}
        y={PetlistLayout.LIST_Y}
        w={PetlistLayout.LIST_W}
        h={PetlistLayout.LIST_H}
        sprite={PetlistArt.BACKDROP}
        tiling
      />

      <layer x={PetlistLayout.LIST_X} y={PetlistLayout.LIST_Y} w={PetlistLayout.LIST_W} h={PetlistLayout.LIST_H} />

      <layer x={PetlistLayout.BAR_X} y={PetlistLayout.BAR_Y} w={PetlistLayout.BAR_W} h={PetlistLayout.BAR_H} />
    </>
  );
}
