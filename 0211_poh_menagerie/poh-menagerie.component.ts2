import { Grid, MenagerieArt, MenagerieColors, MenagerieFonts } from './poh-menagerie.constants';

export function PohMenagerie(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Pet house" />

      <layer x={10} y={40} w={280} h={180}>
        <sprite w="fill" h="fill" sprite={MenagerieArt.BACKDROP} tiling />

        <rect w="fill" h="fill" color={MenagerieColors.FRAME} />
        <rect x={1} y={1} w={278} h={178} color={MenagerieColors.INNER} transparency={150} />

