import { createRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { RoomList } from './room-list.component';
import { PohColors, PohCopy, PohFonts, PohLayout, PohScrollbar } from './poh-add-room.constants';

const roomPane = createRef('poh_add_room_list');

export function PohAddRoom(): Component {
  return (
    <>
      <layer x={0} y={0} w={PohLayout.ROOT_W} h={PohLayout.ROOT_H}>
        <SteelBorderEntrypoint title={PohCopy.TITLE} />
      </layer>

      <text
        x="center"
        y={PohLayout.HEADING_Y}
        w={{ fill: PohLayout.HEADING_INSET_W }}
        h={PohLayout.HEADING_H}
        text={PohCopy.HEADING}
        font={PohFonts.BODY}
        color={PohColors.HEADING}
        shadow
        align="left"
        valign="top"
      />

      <rect
        x={PohLayout.FRAME_X}
        y={PohLayout.FRAME_Y}
        w={PohLayout.FRAME_W}
        h={PohLayout.FRAME_H}
        color={PohColors.PANE_BORDER}
      />

      <layer
        static
        ref={roomPane}
        x={PohLayout.LIST_X}
        y={PohLayout.LIST_Y}
        w={PohLayout.LIST_W}
        h={PohLayout.LIST_H}
        scrollHeight={PohLayout.LIST_EXTENT}
      >
        <RoomList x={0} y={0} w="fill" h={PohLayout.LIST_EXTENT} />
      </layer>

      <layer x={PohLayout.BAR_X} y={PohLayout.FRAME_Y} w={PohLayout.BAR_W} h={PohLayout.FRAME_H}>
        <ScrollbarVertical
          content={roomPane}
          track={PohScrollbar.TRACK}
          capTopSprite={PohScrollbar.CAP_TOP}
          thumbSprite={PohScrollbar.THUMB}
          capBottomSprite={PohScrollbar.CAP_BOTTOM}
          arrowUp={PohScrollbar.ARROW_UP}
          arrowDown={PohScrollbar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
