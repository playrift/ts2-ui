import { CS2 } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { textWidth } from '../lib/lib.engine';
import { PohColors, PohCopy, PohLayout } from './poh-add-room.constants';

export function ccColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function costColour(coins: Int, cost: Int): Int {
  if (coins < cost) {
    return PohColors.COST_SHORT;
  }
  return PohColors.COST_OK;
}

export function roomLabel(name: String, level: Int): String {
  return `${name}: Lvl ${stringOf(level)}`;
}

export function labelWidth(label: String): Int {
  return Math.max(
    PohLayout.LABEL_MIN_W,
    textWidth(label, PohLayout.LABEL_MEASURE_W, 495 as Font) + PohLayout.LABEL_PAD,
  );
}

export function costLabel(cost: Int): String {
  return `${groupDigits(cost, PohCopy.GROUP_SEPARATOR)}${PohCopy.COST_SUFFIX}`;
}

export function selectRoom(button: ComponentId, sound: Int): void {
  CS2.sound_effect(sound, 1, 0);
  CS2.if_resume_pausebutton(button);
}
