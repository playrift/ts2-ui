import { CS2 } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { dragGuideWindow, textColourSwapper } from './skill-guide.helpers';
import { GuideArt, GuideFonts, GuideInk, GuideModels, GuideRows, Layout } from './skill-guide.constants';
import { guideClose, guideRoot, guideWindow } from './skill-guide.refs';

export function SkillGuide(): Component {
  return (
    <layer ref={guideWindow} x={0} y={0} w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
      <model
        x={Layout.PAGE_MODEL_X}
        y={Layout.PAGE_MODEL_Y}
        w={Layout.MODEL}
        h={Layout.MODEL}
        model={GuideModels.PAGE}
        zoom={Layout.PAGE_MODEL_ZOOM}
        pitch={Layout.PAGE_MODEL_PITCH}
      />

      <model
        x={Layout.HEADER_MODEL_X}
        y={Layout.HEADER_MODEL_Y}
        w={Layout.MODEL}
        h={Layout.MODEL}
        model={GuideModels.HEADER}
        zoom={Layout.HEADER_MODEL_ZOOM}
        pitch={Layout.HEADER_MODEL_PITCH}
        yaw={Layout.HEADER_MODEL_YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        font={GuideFonts.TITLE}
        color={GuideInk.REST}
        align="center"
      />

      <text
        x={Layout.SUBTITLE_X}
        y={Layout.SUBTITLE_Y}
        w={Layout.SUBTITLE_W}
        h={Layout.SUBTITLE_H}
        font={GuideFonts.SUBTITLE}
        color={GuideInk.REST}
        align="center"
      />

      <layer x={Layout.COLUMN_X} y={Layout.COLUMN_Y} w={Layout.COLUMN_W} h={Layout.COLUMN_H}>
        <layer
          x="center"
          y="center"
          w={{ fill: Layout.COLUMN_INNER_W_INSET }}
          h={{ fill: Layout.COLUMN_INNER_H_INSET }}
        />

        <layer x="center" y="center" w="fill" h={{ fill: Layout.COLUMN_INNER_H_INSET }}>
          <model
            x="center"
            y={0}
            w={Layout.MODEL}
            h={Layout.MODEL}
            model={GuideModels.COLUMN_BACK}
            zoom={Layout.COLUMN_BACK_ZOOM}
            pitch={Layout.COLUMN_BACK_PITCH}
            yaw={Layout.COLUMN_BACK_YAW}
            offsetX={Layout.COLUMN_BACK_OFFSET_X}
            offsetY={Layout.COLUMN_BACK_OFFSET_Y}
          />
        </layer>

        <model
          x="center"
          y={Layout.COLUMN_TOP_Y}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={GuideModels.COLUMN_TOP}
          zoom={Layout.COLUMN_CAP_ZOOM}
          pitch={Layout.COLUMN_CAP_PITCH}
          yaw={Layout.COLUMN_CAP_YAW}
          offsetX={Layout.COLUMN_TOP_OFFSET_X}
        />

        <model
          x="center"
          y={{ bottom: Layout.COLUMN_BOTTOM_Y }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={GuideModels.COLUMN_BOTTOM}
          zoom={Layout.COLUMN_CAP_ZOOM}
          pitch={Layout.COLUMN_CAP_PITCH}
          yaw={Layout.COLUMN_CAP_YAW}
        />

        {GuideRows.map((row) => (
          <text
            x="center"
            y={row.y}
            w={Layout.ROW_W}
            h={Layout.ROW_H}
            font={GuideFonts.ROW}
            color={GuideInk.REST}
            align="center"
            onMouseEnter={(event) => textColourSwapper(event.component, GuideInk.HOVER)}
            onMouseLeave={(event) => textColourSwapper(event.component, GuideInk.REST)}
          />
        ))}
      </layer>

      <layer
        x={Layout.MOVE_X}
        y={Layout.MOVE_Y}
        w={Layout.MOVE_W}
        h={Layout.MOVE_H}
        options={['Move']}
        interactionDepth={2}
        onDrag={(event) => dragGuideWindow(guideWindow, guideRoot, event.mouseX, event.mouseY)}
      />

      <layer x={Layout.GUTTER_X} y={Layout.GUTTER_Y} w={Layout.GUTTER_W} h={Layout.GUTTER_H} />

      <layer x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={GuideArt.CLOSE}
        ref={guideClose}
        options={['Close']}
        onLoad={() => bindGuideEscape()}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, GuideArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, GuideArt.CLOSE)}
      />

      <layer x={Layout.PAGE_X} y={Layout.PAGE_Y} w={Layout.PAGE_W} h={Layout.PAGE_H}>
        <layer x={0} y={0} w={Layout.PAGE_W} h={Layout.PAGE_H} />
      </layer>
    </layer>
  );
}

function bindGuideEscape(): void {
  CS2.if_op_key_set(1, ESCAPE_KEY, 0, guideClose);
}

const ESCAPE_KEY = 13;
