import { createRef } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';

import { ScoreLines, ScoresArt, ScoresBackdrop, ScoresColor, ScoresFonts, ScoresLayout } from './ntk-scores.constants';

const closeButton = createRef('ntk_scores_close');

export function NtkScores(): Component {
  return (
    <>
      <model
        x={ScoresBackdrop.X}
        y={ScoresBackdrop.Y}
        w={ScoresBackdrop.W}
        h={ScoresBackdrop.H}
        model={ScoresBackdrop.MODEL}
        zoom={ScoresBackdrop.ZOOM}
      />

      {ScoreLines.map((line) => (
        <text
          x={ScoresLayout.LINE_X}
          y={ScoresLayout.FIRST_LINE_Y + line * ScoresLayout.LINE_STEP}
          w={ScoresLayout.LINE_W}
          h={ScoresLayout.LINE_H}
          font={ScoresFonts.LINE}
          color={ScoresColor.LINE}
          align="center"
        />
      ))}

      <sprite
        x={ScoresLayout.CLOSE_X}
        y={ScoresLayout.CLOSE_Y}
        w={ScoresLayout.CLOSE_W}
        h={ScoresLayout.CLOSE_H}
        ref={closeButton}
        sprite={ScoresArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={() => {
          graphicSwapper(closeButton, ScoresArt.CLOSE_HOVER);
        }}
        onMouseLeave={() => {
          graphicSwapper(closeButton, ScoresArt.CLOSE);
        }}
      />
    </>
  );
}
