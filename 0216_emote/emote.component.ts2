import { useRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { EmoteScrollbarSprites, Layout, SCROLL_EXTENT } from './emote.constants';
import { EmoteGrid } from './emote-grid.component';
import { EmoteTooltip } from './emote-tooltip.component';

export function Emote_(): Component {
  const scrollable = useRef();

  return (
    <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <layer
        ref={scrollable}
        x={Layout.PANE_X}
        y={0}
        w={Layout.PANE_W}
        h={Layout.PANE_H}
        scrollHeight={SCROLL_EXTENT}
        scrollY={0}
      >
        <EmoteGrid x={0} y={0} w="fill" h={SCROLL_EXTENT} pane={scrollable} />

        <layer w="fill" h="fill" />
      </layer>

      <layer x={Layout.SCROLLBAR_X} y={0} w={Layout.SCROLLBAR_W} h={Layout.PANE_H}>
        <ScrollbarVertical
          content={scrollable}
          track={EmoteScrollbarSprites.TRACK}
          capTopSprite={EmoteScrollbarSprites.CAP_TOP}
          thumbSprite={EmoteScrollbarSprites.THUMB}
          capBottomSprite={EmoteScrollbarSprites.CAP_BOTTOM}
          arrowUp={EmoteScrollbarSprites.ARROW_UP}
          arrowDown={EmoteScrollbarSprites.ARROW_DOWN}
        />
      </layer>

      <EmoteTooltip />
    </layer>
  );
}
