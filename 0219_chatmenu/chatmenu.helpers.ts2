import { useState } from 'ts2';

import { pipeHead, pipeTail } from '../lib/lib.format';
import { Rows, Title } from './chatmenu.constants';
import {
  menuArmedAt1,
  menuArmedAt2,
  menuArmedAt3,
  menuArmedAt4,
  menuArmedAt5,
  menuCount,
  menuOptions,
  menuTitle,
  menuWaiting,
} from './chatmenu.state';

export function chatmenuBuild(title: String, options: String): void {
  const [, setTitle] = useState(menuTitle);
  const [, setOptions] = useState(menuOptions);
  const [, setCount] = useState(menuCount);
  const [, setWaiting] = useState(menuWaiting);
  const [, setArmed1] = useState(menuArmedAt1);
  const [, setArmed2] = useState(menuArmedAt2);
  const [, setArmed3] = useState(menuArmedAt3);
  const [, setArmed4] = useState(menuArmedAt4);
  const [, setArmed5] = useState(menuArmedAt5);

  const afterFirst: String = pipeTail(options);
  const afterSecond: String = pipeTail(afterFirst);
  const third: String = pipeHead(afterSecond);
  const afterThird: String = pipeTail(afterSecond);
  const fourth: String = pipeHead(afterThird);
  const afterFourth: String = pipeTail(afterThird);
  const fifth: String = pipeHead(afterFourth);

  let count: Int = 2;
  if (third.length > 0) {
    count = 3;
    if (fourth.length > 0) {
      count = 4;
      if (fifth.length > 0) {
        count = 5;
      }
    }
  }

  setTitle(title);
  setOptions(options);
  setCount(count);

  setWaiting(0);
  setArmed1(0);
  setArmed2(0);
  setArmed3(0);
  setArmed4(0);
  setArmed5(0);
}

export function optionAt(options: String, row: Int): String {
  if (row === 1) {
    return pipeHead(options);
  }
  const afterFirst: String = pipeTail(options);
  if (row === 2) {
    return pipeHead(afterFirst);
  }
  const afterSecond: String = pipeTail(afterFirst);
  if (row === 3) {
    return pipeHead(afterSecond);
  }
  const afterThird: String = pipeTail(afterSecond);
  if (row === 4) {
    return pipeHead(afterThird);
  }
  return pipeHead(pipeTail(afterThird));
}

export function rowHeight(count: Int, phone: Boolean): Int {
  if (count <= 2) {
    return phone ? Rows.TWO.H_MOBILE : Rows.TWO.H;
  }
  if (count === 3) {
    return phone ? Rows.THREE.H_MOBILE : Rows.THREE.H;
  }
  if (count === 4) {
    return phone ? Rows.FOUR.H_MOBILE : Rows.FOUR.H;
  }
  return phone ? Rows.FIVE.H_MOBILE : Rows.FIVE.H;
}

export function rowTop(count: Int, row: Int, phone: Boolean): Int {
  if (count <= 2) {
    if (row === 1) {
      return phone ? Rows.TWO.A_MOBILE : Rows.TWO.A;
    }
    return phone ? Rows.TWO.B_MOBILE : Rows.TWO.B;
  }
  if (count === 3) {
    if (row === 1) {
      return phone ? Rows.THREE.A_MOBILE : Rows.THREE.A;
    }
    if (row === 2) {
      return phone ? Rows.THREE.B_MOBILE : Rows.THREE.B;
    }
    return phone ? Rows.THREE.C_MOBILE : Rows.THREE.C;
  }
  if (count === 4) {
    if (row === 1) {
      return phone ? Rows.FOUR.A_MOBILE : Rows.FOUR.A;
    }
    if (row === 2) {
      return phone ? Rows.FOUR.B_MOBILE : Rows.FOUR.B;
    }
    if (row === 3) {
      return phone ? Rows.FOUR.C_MOBILE : Rows.FOUR.C;
    }
    return phone ? Rows.FOUR.D_MOBILE : Rows.FOUR.D;
  }
  if (row === 1) {
    return phone ? Rows.FIVE.A_MOBILE : Rows.FIVE.A;
  }
  if (row === 2) {
    return phone ? Rows.FIVE.B_MOBILE : Rows.FIVE.B;
  }
  if (row === 3) {
    return phone ? Rows.FIVE.C_MOBILE : Rows.FIVE.C;
  }
  if (row === 4) {
    return phone ? Rows.FIVE.D_MOBILE : Rows.FIVE.D;
  }
  return phone ? Rows.FIVE.E_MOBILE : Rows.FIVE.E;
}

export function titleTop(count: Int, phone: Boolean): Int {
  if (!phone) {
    return Title.TOP;
  }
  if (count === 3) {
    return Title.TOP_MOBILE_3;
  }
  if (count === 4) {
    return Title.TOP_MOBILE_4;
  }
  if (count === 5) {
    return Title.TOP_MOBILE_5;
  }
  return Title.TOP;
}
