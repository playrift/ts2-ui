import { createRef } from 'ts2';
import { ChatMenu } from './chatmenu.component';
import { Root } from './chatmenu.constants';

const chatmenuRef = createRef('chatmenu');

export const chatmenuUi = (): UI => (
  <ui ref={chatmenuRef} w={Root.W} h={Root.H} x={Root.X} y={Root.Y}>
    <ChatMenu />
  </ui>
);
