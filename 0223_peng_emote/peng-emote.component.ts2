import { EmoteSprites, Layout } from './peng-emote.constants';

export function PengEmote(): Component {
  return (
    <layer x={0} y={0} w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <sprite x={Layout.COL_1_X} y={Layout.ROW_1_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.SHIVER} />
      <sprite x={Layout.COL_2_X} y={Layout.ROW_1_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.SPIN} />
      <sprite x={Layout.COL_3_X} y={Layout.ROW_1_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.CLAP} />
      <sprite x={Layout.COL_4_X} y={Layout.ROW_1_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.BOW} />

      <sprite x={Layout.COL_1_X} y={Layout.ROW_2_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.CHEER} />
      <sprite x={Layout.COL_2_X} y={Layout.ROW_2_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.WAVE} />
      <sprite x={Layout.COL_3_X} y={Layout.ROW_2_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.PREEN} />
      <sprite x={Layout.COL_4_X} y={Layout.ROW_2_Y} w={Layout.ICON} h={Layout.ICON} sprite={EmoteSprites.FLAP} />
    </layer>
  );
}
