import { Layout, MessageColor, MessageFonts, MessageSprites, ScrollModel } from './mm-message.constants';

export function MmMessage(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={Layout.SCROLL_SIZE}
        h={Layout.SCROLL_SIZE}
        model={ScrollModel.SCROLL}
        zoom={ScrollModel.ZOOM}
      />

      <text
        x={Layout.LINE_X}
        y={Layout.TITLE_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        text=""
        font={MessageFonts.BODY}
        color={MessageColor.TITLE}
        shadow={true}
        align="center"
      />

      {Layout.ROW_Y.map((y) => (
        <text
          x={Layout.LINE_X}
          y={y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text=""
          font={MessageFonts.BODY}
          color={MessageColor.BODY}
          align="center"
        />
      ))}

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MessageSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={MessageSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
