import { onMounted, useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { DeadmanTab } from './deadman-tab.component';
import { DeadmanArt, DeathType, Layout } from './deadmanprotect.constants';
import { selectedTab } from './deadmanprotect.state';

const Tabs = [
  { index: DeathType.PVM, icon: DeadmanArt.ICON_PVM, label: 'PvM' },
  { index: DeathType.PVP, icon: DeadmanArt.ICON_PVP, label: 'PvP' },
  { index: DeathType.SKULLED, icon: DeadmanArt.ICON_SKULLED, label: 'Skulled' },
  { index: DeathType.GUARDED, icon: DeadmanArt.ICON_GUARDED, label: 'Guarded' },
] as const;

export function DeadmanTabStrip(): Component {
  const [tab, setTab] = useState(selectedTab);
  const mobile: Boolean = onMobile();

  onMounted(() => {
    setTab(DeathType.PVP);
  });

  return (
    <layer w="fill" h="fill">
      {Tabs.map((row, index) => (
        <DeadmanTab
          index={row.index}
          icon={row.icon}
          label={row.label}
          x={index * Layout.TAB_STRIDE}
          tab={tab}
          mobile={mobile}
        />
      ))}
    </layer>
  );
}
