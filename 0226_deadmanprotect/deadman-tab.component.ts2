import { useRef } from 'ts2';
import { DeadmanArt, DeadmanColor, Layout, TAB_HITBOX_TRANSPARENCY } from './deadmanprotect.constants';
import { openTab } from './deadmanprotect.state';

function tabHoverable(index: Int, tab: Int, mobile: Boolean): Boolean {
  if (index === tab) {
    return false;
  }
  if (mobile) {
    return false;
  }
  return true;
}

function hoverTab(lit: Boolean, leftCap: ComponentId, rightCap: ComponentId, middle: ComponentId): void {
  if (lit) {
    leftCap.sprite = DeadmanArt.TAB_CAP_ON;
    rightCap.sprite = DeadmanArt.TAB_CAP_ON;
    middle.sprite = DeadmanArt.TAB_MIDDLE_ON;
  } else {
    leftCap.sprite = DeadmanArt.TAB_CAP_OFF;
    rightCap.sprite = DeadmanArt.TAB_CAP_OFF;
    middle.sprite = DeadmanArt.TAB_MIDDLE_OFF;
  }
}

export function DeadmanTab({
  index,
  icon,
  label,
  x,
  tab,
  mobile,
}: {
  index: Int;
  icon: Sprite;
  label: String;
  x: Int;
  tab: Int;
  mobile: Boolean;
}): Component {
  const leftCap = useRef();
  const rightCap = useRef();
  const middle = useRef();

  const capSprite: Sprite = index === tab ? DeadmanArt.TAB_CAP_ON : DeadmanArt.TAB_CAP_OFF;
  const middleSprite: Sprite = index === tab ? DeadmanArt.TAB_MIDDLE_ON : DeadmanArt.TAB_MIDDLE_OFF;

  return (
    <>
      <sprite ref={leftCap} x={x} y="bottom" w={Layout.TAB_CAP_W} h={Layout.TAB_H} sprite={capSprite} />

      <sprite
        ref={rightCap}
        x={x + Layout.TAB_CAP_RIGHT_DX}
        y="bottom"
        w={Layout.TAB_CAP_W}
        h={Layout.TAB_H}
        sprite={capSprite}
        hflip
      />

      <sprite
        ref={middle}
        x={x + Layout.TAB_MIDDLE_DX}
        y="bottom"
        w={Layout.TAB_MIDDLE_W}
        h={Layout.TAB_H}
        sprite={middleSprite}
        tiling
      />

      <sprite x={x + Layout.TAB_ICON_DX} y="center" w={Layout.TAB_ICON_W} h={Layout.TAB_ICON_H} sprite={icon} />

      {tabHoverable(index, tab, mobile) ? (
        <rect
          x={x}
          y="center"
          w={Layout.TAB_W}
          h="fill"
          color={DeadmanColor.TAB_HITBOX}
          fill
          transparency={TAB_HITBOX_TRANSPARENCY}
          options={[label]}
          onOptionSelect={() => openTab(true, index)}
          onMouseRepeat={() => hoverTab(true, leftCap, rightCap, middle)}
          onMouseLeave={() => hoverTab(false, leftCap, rightCap, middle)}
        />
      ) : (
        <rect
          x={x}
          y="center"
          w={Layout.TAB_W}
          h="fill"
          color={DeadmanColor.TAB_HITBOX}
          fill
          transparency={TAB_HITBOX_TRANSPARENCY}
          options={[label]}
          onOptionSelect={() => openTab(true, index)}
        />
      )}
    </>
  );
}
