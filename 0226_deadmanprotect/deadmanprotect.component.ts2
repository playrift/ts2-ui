export function DeadmanProtect(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Lost on Death" />

      <layer x="center" y={{ bottom: 10 }} w={{ fill: 20 }} h={{ fill: 50 }}>
        <layer x="center" y={0} w="fill" h={110}>
          <rect x="center" y="bottom" w="fill" h={{ fill: 25 }} color={DeadmanColor.TAB_PLATE} fill />
          <rect x="center" y="bottom" w="fill" h={{ fill: 25 }} color={DeadmanColor.TAB_PLATE_EDGE} />

          <DeadmanTabStrip w="fill" h={26} />

          <LossExplanation x="center" y="bottom" w={{ fill: 10 }} h={{ fill: 26 }} />
        </layer>

        <layer x="center" y="bottom" w="fill" h={{ fill: 115 }}>
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={DeadmanArt.LIST_BACKING} tiling />

          <text
