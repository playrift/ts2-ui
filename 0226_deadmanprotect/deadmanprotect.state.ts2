import { sessionState, useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';

export const selectedTab = sessionState(1);

export function openTab(clicked: Boolean, tab: Int): void {
  if (clicked) {
    playSound(Sounds.CLICK);
  }
  const [, setTab] = useState(selectedTab);
  setTab(tab);
}
