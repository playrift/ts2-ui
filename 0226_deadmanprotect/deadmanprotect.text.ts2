import { DeathType, DeadmanWorld } from './deadmanprotect.constants';

export function lostOnDeathText(tab: Int, world: Int): String {
  let text: String = '';

  if (tab === DeathType.PVM) {
    text =
      'In Deadman mode, when you die <col=ffffff>unskulled</col> from <col=ffffff>PvM combat</col>, unprotected tradable items will drop to the floor. Your 3 most valuable items are protected.<br><br>You may lose more if you are <col=ffffff>skulled</col> at the time.';
    return text;
  }

  if (tab === DeathType.SKULLED) {
    if (world === DeadmanWorld.EVENT_HALF_BANK) {
      text =
        "In this Deadman event, if you die whilst <col=ffffff>skulled</col>, you lose <col=ffffff>all</col> of the items you're carrying and <col=ffffff>50%</col> from each of your <col=ffffff>10</col> most valuable item stacks in the bank.";
    } else if (world === DeadmanWorld.EVENT_CARRIED_ONLY) {
      text =
        "In this Deadman event, if you die whilst <col=ffffff>skulled</col>, you lose <col=ffffff>all</col> of the items you're carrying.";
    } else {
      text =
        'In Deadman mode, if you die whilst <col=ffffff>skulled</col>, you lose the <col=ffffff>10</col> most valuable stacks of items in your bank, as well as <col=ffffff>all</col> of the items you are carrying at the time.';
    }
    return text;
  }

  if (tab === DeathType.GUARDED) {
    if (world === DeadmanWorld.EVENT_HALF_BANK) {
      text =
        "In this Deadman event, if you die in a <col=ffffff>guarded</col> area whilst <col=ffffff>skulled</col>, you lose <col=ffffff>all</col> of the items you're carrying and <col=ffffff>50%</col> from each of your <col=ffffff>10</col> most valuable item stacks in the bank.";
    }
    if (world === DeadmanWorld.EVENT_CARRIED_ONLY) {
      text =
        "In this Deadman event, if you die in a <col=ffffff>guarded</col> area whilst <col=ffffff>skulled</col>, you lose <col=ffffff>all</col> of the items you're carrying.";
    } else {
      text =
        'In Deadman mode, if you die in a <col=ffffff>guarded</col> area whilst <col=ffffff>skulled</col>, you lose the <col=ffffff>10</col> most valuable stacks of items in your bank, as well as <col=ffffff>all</col> of the items you are carrying at the time.';
    }
    return text;
  }

  if (world === DeadmanWorld.EVENT_HALF_BANK) {
    text =
      "In this Deadman event, dying in <col=ffffff>PvP combat</col> results in you losing <col=ffffff>all</col> of the items you're carrying and <col=ffffff>50%</col> from each of your <col=ffffff>10</col> most valuable item stacks in the bank.";
  } else if (world === DeadmanWorld.EVENT_CARRIED_ONLY) {
    text =
      "In this Deadman event, dying in <col=ffffff>PvP combat</col> results in you losing <col=ffffff>all</col> of the items you're carrying.";
  } else {
    text =
      'In Deadman mode, when you die from <col=ffffff>PvP combat</col>, you lose the <col=ffffff>10</col> most valuable stacks of items in your bank, as well as <col=ffffff>all</col> of the items you are carrying at the time.';
  }
  return text;
}
