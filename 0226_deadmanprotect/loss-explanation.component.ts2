import { useState } from 'ts2';
import { deadmanWorld } from './deadman-world.helpers';
import { lostOnDeathText } from './deadmanprotect.text';
import { DeadmanColor, DeadmanFonts } from './deadmanprotect.constants';
import { selectedTab } from './deadmanprotect.state';

export function LossExplanation(): Component {
  const [tab] = useState(selectedTab);
  const world: Int = deadmanWorld();

  return (
    <text
      w="fill"
      h="fill"
      text={lostOnDeathText(tab, world)}
      font={DeadmanFonts.BODY}
      color={DeadmanColor.LABEL}
      shadow
      valign="middle"
      lineHeight={15}
    />
  );
}
