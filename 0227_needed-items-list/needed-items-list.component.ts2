import { useRef } from 'ts2';
import { CloseSprites, ListFonts, ListModels } from './needed-items-list.constants';
import { QuestListScrollbar } from './quest-list-scrollbar.component';

export function NeededItemsList(): Component {
  const listContainer = useRef();

  return (
    <layer w={512} h={334}>
      <layer x={37} y={37} w={387} h={287}>
        <model x={163} y={79} w={55} h={81} model={ListModels.BACKDROP} zoom={643} pitch={510} />
      </layer>

      <text x={53} y={56} w={297} h={17} text="List of needed items:" font={ListFonts.TITLE} />

      <layer ref={listContainer} x={48} y={80} w={326} h={215}>
        <text w="fill" h="fill" text="" font={ListFonts.LIST} align="center" />
      </layer>

      <QuestListScrollbar x={383} y={80} w={16} h={218} content={listContainer} font={ListFonts.LIST} />

      <sprite
        x={378}
        y={53}
        w={26}
        h={23}
        sprite={CloseSprites.DEFAULT}
        hover={{ sprite: CloseSprites.HOVER }}
        options={['Close']}
        onOptionSelect={() => CS2.if_close()}
      />
    </layer>
  );
}
