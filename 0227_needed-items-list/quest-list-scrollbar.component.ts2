import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ScrollbarSprites as Bar } from './needed-items-list.constants';

export function QuestListScrollbar({
  x,
  y,
  w,
  h,
  content,
  font,
}: {
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  content: Ref;
  font: Font;
}): Component {
  const paraHeight: Int = CS2.paraheight('', content.width, font) * 12 + 5;
  content.scrollY = 0;
  content.scrollHeight = paraHeight;

  return (
    <layer x={x} y={y} w={w} h={h}>
      <ScrollbarVertical
        content={content}
        track={Bar.TRACK}
        capTopSprite={Bar.CAP_TOP}
        thumbSprite={Bar.THUMB}
        capBottomSprite={Bar.CAP_BOTTOM}
        arrowUp={Bar.ARROW_UP}
        arrowDown={Bar.ARROW_DOWN}
      />
    </layer>
  );
}
