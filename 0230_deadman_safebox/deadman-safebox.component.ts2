import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { DepositButton } from './deposit-button.component';
import { SafeboxCounter } from './safebox-counter.component';
import { SafeboxGrid } from './safebox-grid.component';
import { Layout, SafeboxArt, SafeboxColor, Transparency } from './deadman-safebox.constants';

export function DeadmanSafebox(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <rect
        x="right"
        y="bottom"
        w={{ fill: Layout.SHADOW_INSET }}
        h={{ fill: Layout.SHADOW_INSET }}
        color={SafeboxColor.SHADOW}
        fill
        transparency={Transparency.PANEL_SHADOW}
      />

      <layer x="center" y="center" w={{ fill: Layout.SHADOW_INSET }} h={{ fill: Layout.SHADOW_INSET }}>
        <StoneBorderEntrypoint title="Safe Deposit Box" />

        <layer x="center" y={50} w={{ fill: 38 }} h={{ fill: 125 }}>
          <SafeboxGrid />
        </layer>

        <sprite x={0} y={{ bottom: 40 }} w={32} h={32} sprite={SafeboxArt.PLINTH_LEFT} />
        <sprite x={11} y={{ bottom: 42 }} w={{ fill: 22 }} h={32} sprite={SafeboxArt.PLINTH_MIDDLE} tiling />
        <sprite x="right" y={{ bottom: 40 }} w={32} h={32} sprite={SafeboxArt.PLINTH_RIGHT} />

        <DepositButton buttonRight={48} iconRight={53} icon={SafeboxArt.ICON_INVENTORY} label="Deposit inventory" />

        <DepositButton buttonRight={12} iconRight={16} icon={SafeboxArt.ICON_WORN} label="Deposit worn items" />

        <SafeboxCounter />
      </layer>
    </layer>
  );
}
