import { stopTimer } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { DEPOSIT_OP, PRESS_CYCLES } from './deadman-safebox.constants';

export function pressDepositButton(button: ComponentId, pressed: Sprite, rest: Sprite, op: Int): void {
  if (op !== DEPOSIT_OP) {
    return;
  }
  button.sprite = pressed;
  playSound(Sounds.CLICK);
  const restoreAt: Int = clientClock() + PRESS_CYCLES;
  button.onTimer = () => {
    if (clientClock() < restoreAt) {
      return;
    }
    button.sprite = rest;
    stopTimer(button);
  };
}
