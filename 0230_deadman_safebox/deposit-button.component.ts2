import { useRef } from 'ts2';
import { setTransparency } from '../lib/lib.components';
import { pressDepositButton } from './deadman-safebox.helpers';
import { SafeboxArt, Transparency } from './deadman-safebox.constants';

export function DepositButton({
  buttonRight,
  iconRight,
  icon,
  label,
}: {
  buttonRight: Int;
  iconRight: Int;
  icon: Sprite;
  label: String;
}): Component {
  const glyph = useRef();

  return (
    <>
      <sprite
        x={{ right: buttonRight }}
        y={{ bottom: 13 }}
        w={36}
        h={36}
        sprite={SafeboxArt.BUTTON}
        options={[label]}
        onMouseEnter={() => setTransparency(glyph, Transparency.ICON_DIMMED)}
        onMouseLeave={() => setTransparency(glyph, Transparency.CLEAR)}
        onOptionSelect={(event) =>
          pressDepositButton(event.self, SafeboxArt.BUTTON_PRESSED, SafeboxArt.BUTTON, event.option)
        }
      />

      <sprite ref={glyph} x={{ right: iconRight }} y={{ bottom: 20 }} w={29} h={22} sprite={icon} />
    </>
  );
}
