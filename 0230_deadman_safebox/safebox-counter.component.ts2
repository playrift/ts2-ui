import { useInventory } from 'ts2';
import { SafeboxColor, SafeboxFonts, SafeboxInventories } from './deadman-safebox.constants';

export function SafeboxCounter(): Component {
  const box = useInventory(SafeboxInventories.SAFEBOX);

  const held: Int =
    box.count(0) +
    box.count(1) +
    box.count(2) +
    box.count(3) +
    box.count(4) +
    box.count(5) +
    box.count(6) +
    box.count(7) +
    box.count(8) +
    box.count(9);

  return (
    <>
      <text
        x={28}
        y={149}
        w={32}
        h={32}
        text={`${held}`}
        font={SafeboxFonts.NUMERAL}
        color={SafeboxColor.LABEL}
        shadow
        align="right"
      />

      <text x={63} y={154} w={32} h={32} text="/" font={SafeboxFonts.SLASH} color={SafeboxColor.LABEL} shadow />
      <text x={60} y={163} w={32} h={32} text="/" font={SafeboxFonts.SLASH} color={SafeboxColor.LABEL} shadow />

      <text
        x={71}
        y={149}
        w={32}
        h={32}
        text={`${box.size}`}
        font={SafeboxFonts.NUMERAL}
        color={SafeboxColor.LABEL}
        shadow
      />
    </>
  );
}
