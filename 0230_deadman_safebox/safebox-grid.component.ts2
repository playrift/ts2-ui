import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { Layout, SafeboxColor, SafeboxInventories, SafeboxItems, Transparency } from './deadman-safebox.constants';

function SafeboxSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  if (item === -1) {
    return (
      <sprite
        x={(slot % Layout.SLOT_COLUMNS) * Layout.SLOT_STRIDE_X}
        y={(slot / Layout.SLOT_COLUMNS) * Layout.SLOT_STRIDE_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        item={SafeboxItems.BLANK}
        itemCount={1}
        transparency={Transparency.EMPTY}
        outline={1}
        shadowColor={SafeboxColor.SLOT_SHADOW}
        dragDeadZone={Layout.DRAG_DEAD}
        dragDeadTime={Layout.DRAG_DEAD}
      />
    );
  }

  return (
    <sprite
      x={(slot % Layout.SLOT_COLUMNS) * Layout.SLOT_STRIDE_X}
      y={(slot / Layout.SLOT_COLUMNS) * Layout.SLOT_STRIDE_Y}
      w={Layout.SLOT_W}
      h={Layout.SLOT_H}
      item={item}
      itemCount={count}
      transparency={Transparency.CLEAR}
      outline={1}
      shadowColor={SafeboxColor.SLOT_SHADOW}
      dragDeadZone={Layout.DRAG_DEAD}
      dragDeadTime={Layout.DRAG_DEAD}
      options={['Withdraw-1', 'Withdraw-5', 'Withdraw-10', 'Withdraw-X', 'Withdraw-All', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff981f>${itemName(item)}`}
    />
  );
}

export function SafeboxGrid(): Component {
  const box = useInventory(SafeboxInventories.SAFEBOX);

  return (
    <layer w="fill" h="fill">
      {box.map((item, slot) => (
        <SafeboxSlot item={item} count={box.count(slot)} slot={slot} />
      ))}
    </layer>
  );
}
