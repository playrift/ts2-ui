import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { BLANK_ITEM, Grid, Safebox, SafeboxColor, Transparency } from './deadman-safebox-side.constants';

function SafeboxSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={Grid.OUTLINE}
      shadowColor={SafeboxColor.SLOT_SHADOW}
      dragDeadZone={Grid.DRAG_DEAD}
      dragDeadTime={Grid.DRAG_DEAD}
      transparency={Transparency.FILLED}
      options={['Deposit-1', 'Deposit-5', 'Deposit-10', 'Deposit-X', 'Deposit-All', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
    />
  );
}

function SafeboxBlank({ slot }: { slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={BLANK_ITEM}
      itemCount={1}
      outline={Grid.OUTLINE}
      shadowColor={SafeboxColor.SLOT_SHADOW}
      dragDeadZone={Grid.DRAG_DEAD}
      dragDeadTime={Grid.DRAG_DEAD}
      transparency={Transparency.BLANK}
    />
  );
}

export function DeadmanSafeboxGrid(): Component {
  const bag = useInventory(Safebox.INV);

  return (
    <layer w="fill" h="fill">
      {bag.map((item, slot) =>
        item === -1 ? <SafeboxBlank slot={slot} /> : <SafeboxSlot item={item} count={bag.count(slot)} slot={slot} />,
      )}
    </layer>
  );
}
