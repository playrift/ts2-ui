  SkillAnims,
  SkillModels,
} from './levelup-display.constants';

const continueLine = createRef('levelup_continue');

function advanceFeedback(line: ComponentId): void {
  if (CS2.if_text_get(line).length === 0) {
    return;
  }
  CS2.if_resume_pausebutton(line);
  line.text = 'Please wait...';
  line.color = LevelUpColor.CONTINUE;
}

