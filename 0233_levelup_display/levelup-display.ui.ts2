import { createRef } from 'ts2';
import { LevelUpDisplay } from './levelup-display.component';
import { LevelUpBox } from './levelup-display.constants';

const levelUpDisplayRef = createRef('levelup_display');

export const levelUpDisplayUi = (): UI => (
  <ui ref={levelUpDisplayRef} w={LevelUpBox.WIDTH} h={LevelUpBox.HEIGHT} x="center" y="center">
    <LevelUpDisplay />
  </ui>
);
