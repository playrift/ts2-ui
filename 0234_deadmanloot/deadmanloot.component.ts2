import { setTransparency } from '../lib/lib.components';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { LootArt, LootColor, LootFonts, Layout } from './deadmanloot.constants';
import {
  chooseWithdrawItem,
  chooseWithdrawNote,
  closeDestroyConfirm,
  flashControl,
  openDestroyConfirm,
  recolour,
} from './deadmanloot.helpers';
import {
  confirmButtons,
  confirmLayer,
  controlsGreyout,
  destroyCancelText,
  destroyConfirmText,
  emptyBanner,
  itemsPane,
  withdrawItemText,
  withdrawNoteText,
} from './deadmanloot.refs';
import { LootItems } from './loot-items.component';
import { LootTabs } from './loot-tabs.component';
import { WithdrawItemSkin, WithdrawNoteSkin } from './withdraw-toggle.component';

export function DeadmanLoot(): Component {
  return (
    <>
      <rect
        x={{ center: Layout.SHADOW_DX }}
        y={{ center: Layout.SHADOW_DX }}
        w={Layout.PANEL_W}
        h={Layout.PANEL_H}
        fill
        transparency={Layout.SHADOW_TRANSPARENCY}
      />

      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <StoneBorderEntrypoint title="Bank Raid" />
        </layer>

        <line
          x="center"
          y={Layout.TAB_DIVIDER_Y}
          w={{ fill: Layout.TAB_DIVIDER_W_INSET }}
          color={LootColor.DIVIDER}
          lineWidth={Layout.LINE_WIDTH}
        />

        <layer x={Layout.TABS_X} y={Layout.TABS_Y} w={{ fill: Layout.TABS_W_INSET }} h={Layout.TABS_H}>
          <LootTabs />
        </layer>

        <layer ref={itemsPane} x="center" y={Layout.ITEMS_Y} w={Layout.ITEMS_W} h={Layout.ITEMS_H}>
          <LootItems />
        </layer>

        <layer ref={emptyBanner} x="center" y={Layout.ITEMS_Y} w={Layout.ITEMS_W} h={Layout.ITEMS_H} hide>
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            text="This chest is now empty."
            font={LootFonts.LABEL}
            color={LootColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <sprite x={0} y={Layout.RULE_Y} w={Layout.RULE_LEFT_W} h={Layout.RULE_H} sprite={LootArt.RULE_LEFT} />
        <sprite
          x={Layout.RULE_MIDDLE_X}
          y={Layout.RULE_MIDDLE_Y}
          w={{ fill: Layout.RULE_MIDDLE_W_INSET }}
          h={Layout.RULE_H}
          sprite={LootArt.RULE_MIDDLE}
          tiling
        />
        <sprite
          x={{ right: Layout.RULE_RIGHT_X }}
          y={Layout.RULE_Y}
          w={Layout.RULE_RIGHT_W}
          h={Layout.RULE_H}
          sprite={LootArt.RULE_RIGHT}
        />

        <layer x={Layout.CONTROL_INSET} y={{ bottom: Layout.CONTROL_INSET }} w={Layout.CONTROL} h={Layout.CONTROL}>
          <sprite
            x="center"
            y="center"
            w={Layout.CONTROL}
            h={Layout.CONTROL}
            sprite={LootArt.BUTTON}
            options={['Destroy']}
            onMouseEnter={(event) => setTransparency(event.component, 75)}
            onMouseLeave={(event) => setTransparency(event.component, 0)}
            onOptionSelect={() => openDestroyConfirm()}
          />
          <sprite x="center" y="center" w={Layout.GLYPH_W} h={Layout.GLYPH_H} sprite={LootArt.DESTROY_ICON} />
        </layer>

        <line
          x={Layout.DESTROY_DIVIDER_X}
          y={{ bottom: Layout.DIVIDER_BOTTOM }}
          h={Layout.DIVIDER_H}
          color={LootColor.DIVIDER}
          lineWidth={Layout.LINE_WIDTH}
        />

        <text
          x={Layout.WITHDRAW_AS_X}
          y={{ bottom: Layout.WITHDRAW_AS_Y }}
          w={Layout.WITHDRAW_AS_W}
          h={Layout.WITHDRAW_AS_H}
          text="Withdraw as:"
          font={LootFonts.LABEL}
          color={LootColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />

        <layer
          x={Layout.ITEM_TOGGLE_X}
          y={{ bottom: Layout.TOGGLE_Y }}
          w={Layout.TOGGLE_W}
          h={Layout.TOGGLE_H}
          options={['Item']}
          onMouseEnter={() => recolour(withdrawItemText, LootColor.HOVER)}
          onMouseLeave={() => recolour(withdrawItemText, LootColor.LABEL)}
          onOptionSelect={() => chooseWithdrawItem()}
        >
          <WithdrawItemSkin x={0} y={0} w="fill" h="fill" />
          <text
            ref={withdrawItemText}
            x="center"
            y={0}
            w={Layout.ITEM_TEXT_W}
            h={Layout.TOGGLE_H}
            text="Item"
            font={LootFonts.LABEL}
            color={LootColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer
          x={Layout.NOTE_TOGGLE_X}
          y={{ bottom: Layout.TOGGLE_Y }}
          w={Layout.TOGGLE_W}
          h={Layout.TOGGLE_H}
          options={['Note']}
          onOptionSelect={() => chooseWithdrawNote()}
        >
          <WithdrawNoteSkin x={0} y={0} w="fill" h="fill" />
          <text
            ref={withdrawNoteText}
            x="center"
            y={0}
            w="fill"
            h={Layout.TOGGLE_H}
            text="Note"
            font={LootFonts.LABEL}
            color={LootColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer
          x={{ right: Layout.CONTROL_INSET }}
          y={{ bottom: Layout.CONTROL_INSET }}
          w={Layout.CONTROL}
          h={Layout.CONTROL}
        >
          <sprite
            x={0}
            y={0}
            w={Layout.CONTROL}
            h={Layout.CONTROL}
            sprite={LootArt.BUTTON}
            optionSubject="inventory"
            options={['Withdraw all to']}
            onMouseEnter={(event) => setTransparency(event.component, 75)}
            onMouseLeave={(event) => setTransparency(event.component, 0)}
            onOptionSelect={(event) => flashControl(event.component, event.option)}
          />
          <sprite
            x={Layout.INV_GLYPH_X}
            y={Layout.INV_GLYPH_Y}
            w={Layout.GLYPH_W}
            h={Layout.GLYPH_H}
            sprite={LootArt.TO_INVENTORY_ICON}
          />
        </layer>

        <line
          x={{ right: Layout.WITHDRAW_DIVIDER_X }}
          y={{ bottom: Layout.DIVIDER_BOTTOM }}
          h={Layout.DIVIDER_H}
          color={LootColor.DIVIDER}
          lineWidth={Layout.LINE_WIDTH}
        />

        <text
          x={{ right: Layout.COUNT_X }}
          y={{ bottom: Layout.COUNT_Y }}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={LootFonts.BODY}
          color={LootColor.LABEL}
          shadow
          align="center"
        />

        <line
          x={{ right: Layout.COUNT_RULE_X }}
          y={{ bottom: Layout.COUNT_RULE_Y }}
          w={Layout.COUNT_RULE_W}
          color={LootColor.LABEL}
          lineWidth={Layout.LINE_WIDTH}
        />

        <text
          x={{ right: Layout.COUNT_X }}
          y={{ bottom: Layout.COUNT_Y }}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={LootFonts.BODY}
          color={LootColor.LABEL}
          shadow
          align="center"
          valign="bottom"
        />

        <layer
          x={{ right: Layout.DESTROY_DIVIDER_X }}
          y={{ bottom: Layout.CONTROL_INSET }}
          w={Layout.CONTROL}
          h={Layout.CONTROL}
        >
          <sprite
            x="center"
            y="center"
            w={Layout.CONTROL}
            h={Layout.CONTROL}
            sprite={LootArt.BUTTON}
            optionSubject="bank"
            options={['Withdraw all to']}
            onMouseEnter={(event) => setTransparency(event.component, 75)}
            onMouseLeave={(event) => setTransparency(event.component, 0)}
            onOptionSelect={(event) => flashControl(event.component, event.option)}
          />
          <sprite x="center" y="center" w={Layout.GLYPH_W} h={Layout.GLYPH_H} sprite={LootArt.TO_BANK_ICON} />
        </layer>

        <layer
          ref={controlsGreyout}
          x="center"
          y={{ bottom: Layout.CONTROLS_GREYOUT_Y }}
          w={{ fill: Layout.CONTROLS_GREYOUT_W_INSET }}
          h={Layout.CONTROLS_GREYOUT_H}
          hide
        >
          <rect x={0} y={0} w="fill" h="fill" fill transparency={Layout.GREYOUT_TRANSPARENCY} />
        </layer>
      </layer>

      <layer ref={confirmLayer} x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H} noClickThrough hide>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.GREYOUT_INSET }}
          h={{ fill: Layout.GREYOUT_INSET }}
          fill
          transparency={Layout.GREYOUT_TRANSPARENCY}
        />

        <text
          x="center"
          y={Layout.CONFIRM_TITLE_Y}
          w={{ fill: Layout.CONFIRM_TITLE_W_INSET }}
          h={Layout.CONFIRM_TITLE_H}
          text="Are you SURE you want to destroy the contents of this inventory?"
          font={LootFonts.HEADING}
          color={LootColor.DANGER}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x="center"
          y={Layout.CONFIRM_BODY_Y}
          w={{ fill: Layout.CONFIRM_BODY_W_INSET }}
          h={Layout.CONFIRM_BODY_H}
          text="All items will be destroyed.<br>This action cannot be undone."
          font={LootFonts.BODY}
          color={LootColor.LABEL}
          shadow
          align="center"
          valign="middle"
          lineHeight={Layout.CONFIRM_BODY_LINE}
        />

        <layer
          ref={confirmButtons}
          x="center"
          y={Layout.CONFIRM_BUTTONS_Y}
          w={Layout.CONFIRM_BUTTONS_W}
          h={Layout.CONFIRM_BUTTONS_H}
        >
          <sprite
            x={0}
            y={0}
            w={Layout.CONFIRM_BUTTON_W}
            h={Layout.CONFIRM_BUTTONS_H}
            sprite={LootArt.CONFIRM_BUTTON}
            options={['Confirm Destroy']}
            onMouseEnter={() => recolour(destroyConfirmText, LootColor.HOVER)}
            onMouseLeave={() => recolour(destroyConfirmText, LootColor.LABEL)}
            onOptionSelect={() => closeDestroyConfirm()}
          />
          <sprite
            x="right"
            y={0}
            w={Layout.CONFIRM_BUTTON_W}
            h={Layout.CONFIRM_BUTTONS_H}
            sprite={LootArt.CONFIRM_BUTTON}
            options={['Cancel']}
            onMouseEnter={() => recolour(destroyCancelText, LootColor.HOVER)}
            onMouseLeave={() => recolour(destroyCancelText, LootColor.LABEL)}
            onOptionSelect={() => closeDestroyConfirm()}
          />
          <text
            ref={destroyConfirmText}
            x={0}
            y={0}
            w={Layout.CONFIRM_BUTTON_W}
            h={Layout.CONFIRM_BUTTONS_H}
            text="Destroy"
            font={LootFonts.HEADING}
            color={LootColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
          <text
            ref={destroyCancelText}
            x="right"
            y={0}
            w={Layout.CONFIRM_BUTTON_W}
            h={Layout.CONFIRM_BUTTONS_H}
            text="Cancel"
            font={LootFonts.HEADING}
            color={LootColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>
    </>
  );
}
