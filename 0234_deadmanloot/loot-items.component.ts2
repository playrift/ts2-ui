import { useInventory, useServerState } from 'ts2';

import { LootGrid, LootInventories, LootVarbits } from './deadmanloot.constants';
import { controlsGreyout, emptyBanner } from './deadmanloot.refs';
import { LootSlot } from './loot-slot.component';

export function LootItems(): Component {
  const tab: Int = useServerState(LootVarbits.TAB);
  const page0 = useInventory(LootInventories.PAGE_0);
  const page1 = useInventory(LootInventories.PAGE_1);
  const page2 = useInventory(LootInventories.PAGE_2);
  const page3 = useInventory(LootInventories.PAGE_3);
  const page4 = useInventory(LootInventories.PAGE_4);

  let held: Int = 0;
  let slot: Int = 0;
  let seen: Item = -1;
  while (slot < LootGrid.SLOTS) {
    seen = -1;
    if (tab === 0) {
      seen = page0[slot];
    }
    if (tab === 1) {
      seen = page1[slot];
    }
    if (tab === 2) {
      seen = page2[slot];
    }
    if (tab === 3) {
      seen = page3[slot];
    }
    if (tab === 4) {
      seen = page4[slot];
    }
    if (seen !== -1) {
      held = held + 1;
    }
    slot = slot + 1;
  }
  const hasLoot: Boolean = held > 0 ? true : false;
  emptyBanner.hide = hasLoot;
  controlsGreyout.hide = hasLoot;

  return (
    <layer x={0} y={0} w="fill" h="fill">
      {page0.map((item, at) => (
        <LootSlot item={item} count={page0.count(at)} slot={at} active={tab === 0 ? true : false} />
      ))}
      {page1.map((item, at) => (
        <LootSlot item={item} count={page1.count(at)} slot={at} active={tab === 1 ? true : false} />
      ))}
      {page2.map((item, at) => (
        <LootSlot item={item} count={page2.count(at)} slot={at} active={tab === 2 ? true : false} />
      ))}
      {page3.map((item, at) => (
        <LootSlot item={item} count={page3.count(at)} slot={at} active={tab === 3 ? true : false} />
      ))}
      {page4.map((item, at) => (
        <LootSlot item={item} count={page4.count(at)} slot={at} active={tab === 4 ? true : false} />
      ))}
    </layer>
  );
}
