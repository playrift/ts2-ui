import { itemName } from '../lib/lib.engine';
import { LootColor, LootGrid, LootItemArt } from './deadmanloot.constants';

export function LootSlot({
  item,
  count,
  slot,
  active,
}: {
  item: Item;
  count: Int;
  slot: Int;
  active: Boolean;
}): Component {
  if (item !== -1 && active) {
    return (
      <sprite
        x={(slot % LootGrid.COLUMNS) * LootGrid.COL_PITCH}
        y={(slot / LootGrid.COLUMNS) * LootGrid.ROW_PITCH}
        w={LootGrid.SLOT_W}
        h={LootGrid.SLOT_H}
        item={item}
        itemCount={count}
        shadowColor={LootColor.ITEM_SHADOW}
        outline={1}
        optionSubject={`<col=ff981f>${itemName(item)}`}
        options={[
          'Bank 1',
          'Bank 5',
          'Bank 10',
          'Bank X',
          'Bank All',
          'Withdraw 1',
          'Withdraw 5',
          'Withdraw 10',
          'Withdraw X',
          'Withdraw All',
        ]}
      />
    );
  }

  return (
    <sprite
      x={(slot % LootGrid.COLUMNS) * LootGrid.COL_PITCH}
      y={(slot / LootGrid.COLUMNS) * LootGrid.ROW_PITCH}
      w={LootGrid.SLOT_W}
      h={LootGrid.SLOT_H}
      item={LootItemArt.EMPTY_SLOT}
      itemCount={1}
      itemCountMode="never"
      shadowColor={LootColor.ITEM_SHADOW}
      outline={1}
      optionSubject=""
      options={[
        'Bank 1',
        'Bank 5',
        'Bank 10',
        'Bank X',
        'Bank All',
        'Withdraw 1',
        'Withdraw 5',
        'Withdraw 10',
        'Withdraw X',
        'Withdraw All',
      ]}
      hide
    />
  );
}
