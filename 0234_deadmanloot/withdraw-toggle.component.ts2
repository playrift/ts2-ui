import { useServerState } from 'ts2';

import { LootArt, LootColor, LootVarbits, Layout } from './deadmanloot.constants';
import { recolour } from './deadmanloot.helpers';
import { withdrawNoteText } from './deadmanloot.refs';

export function WithdrawItemSkin(): Component {
  const notes: Int = useServerState(LootVarbits.WITHDRAW_NOTES);
  const selected: Boolean = notes !== 1 ? true : false;

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <sprite
        x={0}
        y={0}
        w={Layout.TOGGLE_CAP_W}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_LEFT : LootArt.SPLIT_OFF_LEFT}
      />
      <sprite
        x="center"
        y={0}
        w={{ fill: Layout.TOGGLE_MIDDLE_INSET }}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_MIDDLE : LootArt.SPLIT_OFF_MIDDLE}
        tiling
      />
      <sprite
        x="right"
        y={0}
        w={Layout.TOGGLE_CAP_W}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_RIGHT : LootArt.SPLIT_OFF_RIGHT}
      />
    </layer>
  );
}

export function WithdrawNoteSkin(): Component {
  const notes: Int = useServerState(LootVarbits.WITHDRAW_NOTES);
  const selected: Boolean = notes === 1 ? true : false;

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <sprite
        x={0}
        y={0}
        w={Layout.TOGGLE_CAP_W}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_LEFT : LootArt.SPLIT_OFF_LEFT}
        onMouseEnter={() => recolour(withdrawNoteText, LootColor.HOVER)}
        onMouseLeave={() => recolour(withdrawNoteText, LootColor.LABEL)}
      />
      <sprite
        x="center"
        y={0}
        w={{ fill: Layout.TOGGLE_MIDDLE_INSET }}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_MIDDLE : LootArt.SPLIT_OFF_MIDDLE}
        tiling
        onMouseEnter={() => recolour(withdrawNoteText, LootColor.HOVER)}
        onMouseLeave={() => recolour(withdrawNoteText, LootColor.LABEL)}
      />
      <sprite
        x="right"
        y={0}
        w={Layout.TOGGLE_CAP_W}
        h={Layout.TOGGLE_H}
        sprite={selected ? LootArt.SPLIT_ON_RIGHT : LootArt.SPLIT_OFF_RIGHT}
        onMouseEnter={() => recolour(withdrawNoteText, LootColor.HOVER)}
        onMouseLeave={() => recolour(withdrawNoteText, LootColor.LABEL)}
      />
    </layer>
  );
}
