import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Icon, Layout, ServeryColor, ServeryDish, ServeryHud, Tip } from './hosidius-servery-hud.constants';
import { serveryRow } from './hosidius-servery-hud.helpers';
import {
  content,
  meatPieBar,
  meatPieContainer,
  meatPieFill,
  meatPieIcon,
  meatPieOutline,
  pineapplePizzaBar,
  pineapplePizzaContainer,
  pineapplePizzaFill,
  pineapplePizzaIcon,
  pineapplePizzaOutline,
  stewBar,
  stewContainer,
  stewFill,
  stewIcon,
  stewOutline,
  tooltipHost,
} from './hosidius-servery-hud.refs';
import { hideTooltip, showTooltip } from './hosidius-servery-hud.state';
import { ServeryTooltip } from './servery-tooltip.component';

export function HosidiusServeryHud_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, content, ServeryHud.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite
            ref={meatPieIcon}
            x={Layout.ICON_X}
            y={Layout.ROW1_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            outline={Icon.OUTLINE}
            shadowColor={Icon.SHADOW}
            onTimer={() => serveryRow(meatPieIcon, meatPieOutline, meatPieFill, ServeryDish.MEAT_PIE)}
            onMouseRepeat={() => showTooltip(Tip.MEAT_PIE_ICON)}
            onMouseLeave={() => hideTooltip()}
          />

          <layer
            ref={meatPieContainer}
            x={Layout.BAR_X}
            y={Layout.ROW1_BAR_Y}
            w={Layout.BAR_W}
            h={Layout.BAR_H}
            onMouseRepeat={() => showTooltip(Tip.MEAT_PIE_BAR)}
            onMouseLeave={() => hideTooltip()}
          >
            <rect x="center" y="center" w="fill" h="fill" color={ServeryColor.BACKDROP} fill />
            <layer ref={meatPieBar} x="center" y="center" w={{ fill: Layout.BAR_INSET }} h={{ fill: Layout.BAR_INSET }}>
              <rect ref={meatPieFill} x={0} y="center" w="0%" h="fill" fill />
            </layer>
            <rect ref={meatPieOutline} x="center" y="center" w="fill" h="fill" />
          </layer>

          <sprite
            ref={pineapplePizzaIcon}
            x={Layout.ICON_X}
            y={Layout.ROW2_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            outline={Icon.OUTLINE}
            shadowColor={Icon.SHADOW}
            onTimer={() =>
              serveryRow(pineapplePizzaIcon, pineapplePizzaOutline, pineapplePizzaFill, ServeryDish.PINEAPPLE_PIZZA)
            }
            onMouseRepeat={() => showTooltip(Tip.PINEAPPLE_PIZZA_ICON)}
            onMouseLeave={() => hideTooltip()}
          />

          <layer
            ref={pineapplePizzaContainer}
            x={Layout.BAR_X}
            y={Layout.ROW2_BAR_Y}
            w={Layout.BAR_W}
            h={Layout.BAR_H}
            onMouseRepeat={() => showTooltip(Tip.PINEAPPLE_PIZZA_BAR)}
            onMouseLeave={() => hideTooltip()}
          >
            <rect x="center" y="center" w="fill" h="fill" color={ServeryColor.BACKDROP} fill />
            <layer
              ref={pineapplePizzaBar}
              x="center"
              y="center"
              w={{ fill: Layout.BAR_INSET }}
              h={{ fill: Layout.BAR_INSET }}
            >
              <rect ref={pineapplePizzaFill} x={0} y="center" w="0%" h="fill" fill />
            </layer>
            <rect ref={pineapplePizzaOutline} x="center" y="center" w="fill" h="fill" />
          </layer>

          <sprite
            ref={stewIcon}
            x={Layout.ICON_X}
            y={Layout.ROW3_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            outline={Icon.OUTLINE}
            shadowColor={Icon.SHADOW}
            onTimer={() => serveryRow(stewIcon, stewOutline, stewFill, ServeryDish.STEW)}
            onMouseRepeat={() => showTooltip(Tip.STEW_ICON)}
            onMouseLeave={() => hideTooltip()}
          />

          <layer
            ref={stewContainer}
            x={Layout.BAR_X}
            y={Layout.ROW3_BAR_Y}
            w={Layout.BAR_W}
            h={Layout.BAR_H}
            onMouseRepeat={() => showTooltip(Tip.STEW_BAR)}
            onMouseLeave={() => hideTooltip()}
          >
            <rect x="center" y="center" w="fill" h="fill" color={ServeryColor.BACKDROP} fill />
            <layer ref={stewBar} x="center" y="center" w={{ fill: Layout.BAR_INSET }} h={{ fill: Layout.BAR_INSET }}>
              <rect ref={stewFill} x={0} y="center" w="0%" h="fill" fill />
            </layer>
            <rect ref={stewOutline} x="center" y="center" w="fill" h="fill" />
          </layer>

          <layer ref={tooltipHost} x={0} y={0} w="fill" h="fill">
            <ServeryTooltip />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
