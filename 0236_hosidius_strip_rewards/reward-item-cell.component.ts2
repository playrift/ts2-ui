import { CS2, useRef } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { TitheFlash, TitheGrid, TitheItems, TitheLayout } from './hosidius-strip-rewards.constants';

export function RewardItemCell({ name, col, rowY }: { name: ItemName; col: Int; rowY: Int }): Component {
  const cell = useRef();

  const item: Item = CS2.item_uncert(name as Item);

  return (
    <sprite
      ref={cell}
      x={TitheGrid.ICON_INSET + col * TitheGrid.COLUMN_STRIDE}
      y={rowY}
      w={TitheLayout.ICON_W}
      h={TitheLayout.ICON_H}
      item={item}
      itemCount={name === TitheItems.GRAPE_BLESSING ? TitheGrid.BULK : -1}
      outline={1}
      shadowColor={TitheGrid.ICON_SHADOW}
      options={['Value', 'Buy-1', 'Buy-5', 'Buy-10', 'Buy-50', 'Buy-X', '', '', '', 'Examine']}
      optionSubject={
        name === TitheItems.GRAPE_BLESSING
          ? `<col=ff9040>${itemName(name as Item)} (sets of ${stringOf(TitheGrid.BULK)})</col>`
          : `<col=ff9040>${itemName(name as Item)}</col>`
      }
      onOptionSelect={() => {
        flashFor(cell, TitheFlash.DIM, TitheFlash.CLEAR);
      }}
    />
  );
}
