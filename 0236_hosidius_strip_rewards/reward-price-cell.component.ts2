import { RewardPrices, TitheColor, TitheFonts, TitheGrid, TitheItems } from './hosidius-strip-rewards.constants';

export function RewardPriceCell({
  name,
  points,
  col,
  rowY,
}: {
  name: ItemName;
  points: Int;
  col: Int;
  rowY: Int;
}): Component {
  const price: Int = RewardPrices.get(name as Item) ?? TitheGrid.NO_PRICE;

  return (
    <text
      x={col * TitheGrid.COLUMN_STRIDE}
      y={rowY + TitheGrid.PRICE_DY}
      w={TitheGrid.COLUMN_W}
      h={TitheGrid.PRICE_H}
      font={TitheFonts.PRICE}
      align="center"
      shadow
      color={points < price ? TitheColor.RED : TitheColor.WHITE}
      text={name === TitheItems.GRAPE_BLESSING ? `${stringOf(price)} for ${stringOf(TitheGrid.BULK)}` : stringOf(price)}
    />
  );
}
