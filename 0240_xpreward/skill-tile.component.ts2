import { TileArt } from './xpreward.constants';

export function SkillTile({ fade = 0 }: { fade?: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={6} h={6} sprite={TileArt.OFF_NW} transparency={fade} />
      <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={TileArt.OFF_N} tiling transparency={fade} />
      <sprite x="right" y="top" w={6} h={6} sprite={TileArt.OFF_NE} transparency={fade} />
      <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={TileArt.OFF_W} tiling transparency={fade} />
      <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={TileArt.OFF_C} tiling transparency={fade} />
      <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={TileArt.OFF_E} tiling transparency={fade} />
      <sprite x="left" y="bottom" w={6} h={6} sprite={TileArt.OFF_SW} transparency={fade} />
      <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={TileArt.OFF_S} tiling transparency={fade} />
      <sprite x="right" y="bottom" w={6} h={6} sprite={TileArt.OFF_SE} transparency={fade} />
    </layer>
  );
}

export function SkillTilePressed({ fade = 0 }: { fade?: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={6} h={6} sprite={TileArt.ON_NW} transparency={fade} />
      <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={TileArt.ON_N} tiling transparency={fade} />
      <sprite x="right" y="top" w={6} h={6} sprite={TileArt.ON_NE} transparency={fade} />
      <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={TileArt.ON_W} tiling transparency={fade} />
      <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={TileArt.ON_C} tiling transparency={fade} />
      <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={TileArt.ON_E} tiling transparency={fade} />
      <sprite x="left" y="bottom" w={6} h={6} sprite={TileArt.ON_SW} transparency={fade} />
      <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={TileArt.ON_S} tiling transparency={fade} />
      <sprite x="right" y="bottom" w={6} h={6} sprite={TileArt.ON_SE} transparency={fade} />
    </layer>
  );
}
