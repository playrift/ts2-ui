import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { Layout, TitheColor, TitheFonts, TitheHud, TitheSprites } from './hosidius-strip-farming.constants';
import { hosidiusTitheHudUpdate } from './hosidius-strip-farming.helpers';

const timerHost1 = createRef('0241_hosidius_strip_farming_timer_host1');

const timerHost2 = createRef('0241_hosidius_strip_farming_timer_host2');

const panel = createRef('hosidius_strip_farming_panel');

const fruit = createRef('hosidius_strip_farming_fruit');

const counter = createRef('hosidius_strip_farming_counter');

const points = createRef('hosidius_strip_farming_points');

export function HosidiusStripFarming_(): Component {
  useInterval(() => hosidiusTitheHudUpdate(fruit, counter, points), timerHost1);
  useInterval(() => overlayRelayout(timerHost2, panel, TitheHud.DODGE, Anchor.RIGHT, Anchor.TOP, 0), timerHost2);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={panel} x={{ right: Layout.PLATE_X }} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={TitheSprites.BACKING}
            tiling
            transparency={Layout.BACKING_WASH}
          />

          <model ref={fruit} x={Layout.FRUIT_X} y={0} w={Layout.FRUIT_W} h={Layout.FRUIT_H} zoom={Layout.FRUIT_ZOOM} />

          <text
            ref={counter}
            x={{ right: Layout.COUNTER_X }}
            y={0}
            w={{ fill: Layout.COUNTER_INSET_W }}
            h={{ fill: Layout.COUNTER_INSET_H }}
            align="center"
            valign="middle"
            shadow
            font={TitheFonts.COUNTER}
            color={TitheColor.AMBER}
          />

          <text
            ref={points}
            x="center"
            y="bottom"
            w={{ fill: Layout.POINTS_INSET_W }}
            h={Layout.POINTS_H}
            align="center"
            valign="bottom"
            shadow
            font={TitheFonts.POINTS}
            color={TitheColor.AMBER}
          />

          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>
    </layer>
  );
}
