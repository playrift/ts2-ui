import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ServeryCamera, ServeryLayout, ServeryModels } from './hosidius_servery.constants';

export function HosidiusServery(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Servery cupboard" />

      <model
        x={0}
        y="bottom"
        w={ServeryLayout.CUPBOARD_W}
        h={ServeryLayout.CUPBOARD_H}
        model={ServeryModels.CUPBOARD}
        zoom={ServeryCamera.ZOOM}
        pitch={ServeryCamera.PITCH}
        yaw={ServeryCamera.YAW}
        offsetY={ServeryCamera.OFFSET_Y}
      />

      <layer
        x={{ right: ServeryLayout.ITEMS_RIGHT }}
        y={ServeryLayout.ITEMS_TOP}
        w={ServeryLayout.ITEMS_W}
        h={ServeryLayout.ITEMS_H}
      />
    </>
  );
}
