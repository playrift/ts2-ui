import { useServerState, useState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import {
  PestRewardsConfirm,
  PestRewardsConfirmDisabled,
  pressConfirm,
  releaseConfirm,
} from '../0645_br_reward_shop/pest-rewards.shared';
import { confirmPestReward } from './pest-rewardshop.state';
import {
  PestColor,
  PestFonts,
  PestFrame,
  PestLabels,
  PestVarps,
  SelectedPestReward,
} from './pest-rewardshop.constants';

export function PestRewardPoints(): Component {
  const points: Int = useServerState(PestVarps.POINTS);

  return (
    <text
      x={0}
      y="center"
      w={PestFrame.POINTS_W}
      h="fill"
      text={`Points: <col=ffffff>${groupDigits(points, ',')}</col>`}
      font={PestFonts.POINTS}
      color={PestColor.REST}
      shadow
      align="center"
      valign="middle"
    />
  );
}

export function PestRewardConfirm(): Component {
  const [selected] = useState(SelectedPestReward);

  return (
    <layer x="center" y="center" w={PestFrame.CONFIRM_W} h="fill">
      <layer x="center" y="center" w="fill" h="fill">
        {selected !== -1 ? <PestRewardsConfirm label={PestLabels.at(selected)} /> : <PestRewardsConfirmDisabled />}
      </layer>

      {selected !== -1 ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          options={['Confirm']}
          onMouseRepeat={() => pressConfirm()}
          onMouseLeave={() => releaseConfirm()}
          onOptionSelect={() => confirmPestReward()}
        />
      ) : null}
    </layer>
  );
}
