import { PestFrame } from './pest-rewardshop.constants';

export function PestRewardShop(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Void Knights' Reward Options" />

      <layer
        x="center"
        y={{ bottom: PestFrame.BODY_BOTTOM }}
