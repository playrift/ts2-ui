import { useState } from 'ts2';
import { chatMessage, playSound } from '../lib/lib.engine';
import { PestSkill, PestSounds, SelectedPestReward } from './pest-rewardshop.constants';

export function selectPestReward(index: Int): void {
  const [, setSelected] = useState(SelectedPestReward);
  playSound(PestSounds.SELECT);
  setSelected(index);
}

export function refusePestReward(message: String): void {
  const [, setSelected] = useState(SelectedPestReward);
  playSound(PestSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
}

export function confirmPestReward(): void {
  const [, setSelected] = useState(SelectedPestReward);
  playSound(PestSounds.SELECT);
  setSelected(-1);
}

export function costPts(points: Int): String {
  if (points === 1) {
    return '1 Pt';
  }
  return `${stringOf(points)} Pts`;
}

export function trainingXp(skill: Skill, base: Int): Int {
  if (skill === PestSkill.RANGED || skill === PestSkill.MAGIC) {
    return (Math.pow(base, 2) / 600) * 32;
  }
  if (skill === PestSkill.PRAYER) {
    return (Math.pow(base, 2) / 600) * 18;
  }
  return (Math.pow(base, 2) / 600) * 35;
}
