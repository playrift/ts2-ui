import { PestXpButton } from './pest-xp-button.component';
import { trainingXp } from './pest-rewardshop.state';
import {
  PestColor,
  PestCosts,
  PestFonts,
  PestLayout,
  PestLevels,
  SkillIcons,
  SkillNames,
} from './pest-rewardshop.constants';

export function PestSkillRow({
  skill,
  base,
  x,
  y,
  cellW,
  level,
  points,
  selected,
}: {
  skill: Skill;
  base: Int;
  x: Int;
  y: Int;
  cellW: Int;
  level: Int;
  points: Int;
  selected: Int;
}): Component {
  const textX: Int = x + PestLayout.TEXT_X;
  const textW: Int = cellW - PestLayout.TEXT_X;
  const buttonW: Int = textW / 3;

  const cost: Int = PestCosts.at(base) ?? 2147483647;
  const name: String = SkillNames.get(skill) ?? 'Skill';

  const rowSelected: Int = selected === base || selected === base + 1 || selected === base + 2 ? 1 : 0;

  return (
    <>
      <sprite
        x={x + PestLayout.SKILL_ICON_X}
        y={y}
        w={PestLayout.SKILL_ICON}
        h={PestLayout.SKILL_ICON}
        sprite={SkillIcons.get(skill) ?? -1}
      />

      <text
        x={textX}
        y={y}
        w={textW}
        h={PestLayout.ROW_H}
        text={
          level < PestLevels.TRAINING
            ? `${name} - requires level ${stringOf(PestLevels.TRAINING)}`
            : points < cost
              ? `${name} - ${stringOf(cost)}+ points`
              : `${name} - ${stringOf(trainingXp(skill, level))} XP`
        }
        font={PestFonts.NAME}
        color={
          level < PestLevels.TRAINING
            ? PestColor.REFUSED
            : points < cost
              ? PestColor.REFUSED
              : rowSelected === 1
                ? PestColor.SELECTED
                : PestColor.AVAILABLE
        }
        shadow
        align="left"
        valign="top"
      />

      <PestXpButton
        index={base}
        skill={skill}
        x={textX}
        y={y}
        w={buttonW}
        level={level}
        points={points}
        selected={selected}
      />
      <PestXpButton
        index={base + 1}
        skill={skill}
        x={textX + buttonW}
        y={y}
        w={buttonW}
        level={level}
        points={points}
        selected={selected}
      />
      <PestXpButton
        index={base + 2}
        skill={skill}
        x={textX + buttonW * 2}
        y={y}
        w={buttonW}
        level={level}
        points={points}
        selected={selected}
      />
    </>
  );
}
