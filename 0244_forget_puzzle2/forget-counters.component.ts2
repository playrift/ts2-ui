import { useServerState } from 'ts2';

import { CounterPrefix, ForgetColors, ForgetFonts, ForgetVarbits } from './forget-puzzle2.constants';

export function ForgetYellowCounter(): Component {
  const carts: Int = useServerState(ForgetVarbits.NUM_LEFT);
  return (
    <text
      w="fill"
      h="fill"
      text={`${CounterPrefix}${stringOf(carts)}`}
      font={ForgetFonts.COUNTER}
      color={ForgetColors.COUNTER}
      shadow
    />
  );
}

export function ForgetGreenCounter(): Component {
  const carts: Int = useServerState(ForgetVarbits.NUM_RIGHT);
  return (
    <text
      w="fill"
      h="fill"
      text={`${CounterPrefix}${stringOf(carts)}`}
      font={ForgetFonts.COUNTER}
      color={ForgetColors.COUNTER}
      shadow
    />
  );
}
