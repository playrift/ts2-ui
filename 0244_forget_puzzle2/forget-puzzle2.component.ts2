import { setTransparency } from '../lib/lib.components';
import { ForgetGreenCounter, ForgetYellowCounter } from './forget-counters.component';
import { ForgetSwitches } from './forget-switches.component';
import { ForgetTracks } from './forget-tracks.component';
import {
  CounterCamera,
  CounterModel,
  EndModel,
  ForgetArt,
  ForgetColors,
  ForgetFonts,
  JunctionButton,
  JunctionButtons,
  OkButton,
  OkHover,
  TrackCamera,
} from './forget-puzzle2.constants';

export function ForgetPuzzle2(): Component {
  return (
    <>
      <layer w="fill" h="fill">
        <layer w="fill" h="fill">
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            model={EndModel.START}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
          />
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            model={EndModel.FINISH}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
          />
        </layer>

        <layer w="fill" h="fill">
          <ForgetYellowCounter x={47} y={22} w={32} h={20} />
          <ForgetGreenCounter x={47} y={52} w={32} h={20} />
          <model
            x={12}
            y={19}
            w={CounterCamera.SIZE}
            h={CounterCamera.SIZE}
            model={CounterModel.YELLOW}
            zoom={CounterCamera.ZOOM}
            pitch={CounterCamera.PITCH}
            roll={CounterCamera.ROLL}
          />
          <model
            x={12}
            y={50}
            w={CounterCamera.SIZE}
            h={CounterCamera.SIZE}
            model={CounterModel.GREEN}
            zoom={CounterCamera.ZOOM}
            pitch={CounterCamera.PITCH}
            roll={CounterCamera.ROLL}
          />
        </layer>

        <layer w="fill" h="fill">
          <ForgetTracks w="fill" h="fill" />
        </layer>

        <layer w="fill" h="fill">
          <ForgetSwitches w="fill" h="fill" />
          {JunctionButtons.map((button) => (
            <layer
              x={button.x}
              y={button.y}
              w={JunctionButton.SIZE}
              h={JunctionButton.SIZE}
              options={[JunctionButton.OP]}
            />
          ))}
        </layer>
      </layer>

      <layer x={OkButton.X} y={OkButton.Y} w={OkButton.SIZE} h={OkButton.SIZE} options={[OkButton.OP]}>
        <sprite
          x="center"
          y="center"
          w={OkButton.SIZE}
          h={OkButton.SIZE}
          sprite={ForgetArt.OK_BOX}
          onMouseEnter={(event) => setTransparency(event.component, OkHover.LIT)}
          onMouseLeave={(event) => setTransparency(event.component, OkHover.REST)}
        />
        <text
          x="center"
          y="center"
          w={OkButton.SIZE}
          h={OkButton.SIZE}
          text={OkButton.LABEL}
          font={ForgetFonts.BUTTON}
          color={ForgetColors.BUTTON_LABEL}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    </>
  );
}
