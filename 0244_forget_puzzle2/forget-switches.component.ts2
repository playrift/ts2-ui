import { useServerState } from 'ts2';

import { ForgetVarbits, Junction, SwitchModels, TrackCamera } from './forget-puzzle2.constants';

export function ForgetSwitches(): Component {
  const a: Int = useServerState(ForgetVarbits.SWITCH_A);
  const b: Int = useServerState(ForgetVarbits.SWITCH_B);
  const c: Int = useServerState(ForgetVarbits.SWITCH_C);
  const d: Int = useServerState(ForgetVarbits.SWITCH_D);
  const e: Int = useServerState(ForgetVarbits.SWITCH_E);
  const f: Int = useServerState(ForgetVarbits.SWITCH_F);
  const g: Int = useServerState(ForgetVarbits.SWITCH_G);
  const h: Int = useServerState(ForgetVarbits.SWITCH_H);
  const i: Int = useServerState(ForgetVarbits.SWITCH_I);
  const j: Int = useServerState(ForgetVarbits.SWITCH_J);
  const k: Int = useServerState(ForgetVarbits.SWITCH_K);
  const l: Int = useServerState(ForgetVarbits.SWITCH_L);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill">
        {a !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={a === Junction.RIGHT ? SwitchModels.A.right : SwitchModels.A.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {b !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={b === Junction.RIGHT ? SwitchModels.B.right : SwitchModels.B.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {c !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={c === Junction.RIGHT ? SwitchModels.C.right : SwitchModels.C.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {d !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={d === Junction.RIGHT ? SwitchModels.D.right : SwitchModels.D.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {e !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={e === Junction.RIGHT ? SwitchModels.E.right : SwitchModels.E.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {f !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={f === Junction.RIGHT ? SwitchModels.F.right : SwitchModels.F.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {g !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={g === Junction.RIGHT ? SwitchModels.G.right : SwitchModels.G.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {h !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={h === Junction.RIGHT ? SwitchModels.H.right : SwitchModels.H.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {i !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={i === Junction.RIGHT ? SwitchModels.I.right : SwitchModels.I.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {j !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={j === Junction.RIGHT ? SwitchModels.J.right : SwitchModels.J.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {k !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={k === Junction.RIGHT ? SwitchModels.K.right : SwitchModels.K.left}
          />
        )}
      </layer>

      <layer w="fill" h="fill">
        {l !== Junction.UNSET && (
          <model
            x={TrackCamera.X}
            y={TrackCamera.Y}
            w={TrackCamera.SIZE}
            h={TrackCamera.SIZE}
            zoom={TrackCamera.ZOOM}
            pitch={TrackCamera.PITCH}
            model={l === Junction.RIGHT ? SwitchModels.L.right : SwitchModels.L.left}
          />
        )}
      </layer>
    </layer>
  );
}
