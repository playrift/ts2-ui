import { useServerState } from 'ts2';

import { ForgetVarbits, Junction, TrackCamera, TrackModels } from './forget-puzzle2.constants';

export function ForgetTracks(): Component {
  const a: Int = useServerState(ForgetVarbits.SWITCH_A);
  const b: Int = useServerState(ForgetVarbits.SWITCH_B);
  const c: Int = useServerState(ForgetVarbits.SWITCH_C);
  const d: Int = useServerState(ForgetVarbits.SWITCH_D);
  const e: Int = useServerState(ForgetVarbits.SWITCH_E);
  const f: Int = useServerState(ForgetVarbits.SWITCH_F);
  const g: Int = useServerState(ForgetVarbits.SWITCH_G);
  const h: Int = useServerState(ForgetVarbits.SWITCH_H);
  const i: Int = useServerState(ForgetVarbits.SWITCH_I);
  const j: Int = useServerState(ForgetVarbits.SWITCH_J);
  const k: Int = useServerState(ForgetVarbits.SWITCH_K);
  const l: Int = useServerState(ForgetVarbits.SWITCH_L);

  return (
    <layer w="fill" h="fill">
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={a === Junction.LEFT ? TrackModels.A.leftSet : TrackModels.A.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={a === Junction.RIGHT ? TrackModels.A.rightSet : TrackModels.A.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={b === Junction.LEFT ? TrackModels.B.leftSet : TrackModels.B.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={b === Junction.RIGHT ? TrackModels.B.rightSet : TrackModels.B.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={c === Junction.LEFT ? TrackModels.C.leftSet : TrackModels.C.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={c === Junction.RIGHT ? TrackModels.C.rightSet : TrackModels.C.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={d === Junction.LEFT ? TrackModels.D.leftSet : TrackModels.D.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={d === Junction.RIGHT ? TrackModels.D.rightSet : TrackModels.D.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={e === Junction.LEFT ? TrackModels.E.leftSet : TrackModels.E.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={e === Junction.RIGHT ? TrackModels.E.rightSet : TrackModels.E.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={f === Junction.LEFT ? TrackModels.F.leftSet : TrackModels.F.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={f === Junction.RIGHT ? TrackModels.F.rightSet : TrackModels.F.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={g === Junction.LEFT ? TrackModels.G.leftSet : TrackModels.G.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={g === Junction.RIGHT ? TrackModels.G.rightSet : TrackModels.G.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={h === Junction.LEFT ? TrackModels.H.leftSet : TrackModels.H.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={h === Junction.RIGHT ? TrackModels.H.rightSet : TrackModels.H.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={i === Junction.LEFT ? TrackModels.I.leftSet : TrackModels.I.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={i === Junction.RIGHT ? TrackModels.I.rightSet : TrackModels.I.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={j === Junction.LEFT ? TrackModels.J.leftSet : TrackModels.J.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={j === Junction.RIGHT ? TrackModels.J.rightSet : TrackModels.J.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={k === Junction.LEFT ? TrackModels.K.leftSet : TrackModels.K.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={k === Junction.RIGHT ? TrackModels.K.rightSet : TrackModels.K.right}
      />

      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={l === Junction.LEFT ? TrackModels.L.leftSet : TrackModels.L.left}
      />
      <model
        x={TrackCamera.X}
        y={TrackCamera.Y}
        w={TrackCamera.SIZE}
        h={TrackCamera.SIZE}
        zoom={TrackCamera.ZOOM}
        pitch={TrackCamera.PITCH}
        model={l === Junction.RIGHT ? TrackModels.L.rightSet : TrackModels.L.right}
      />
    </layer>
  );
