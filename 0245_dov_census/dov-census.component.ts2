import { useServerState } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  CensusArt,
  CensusColors,
  CensusFonts,
  CensusModel,
  CensusPageBounds,
  CensusVarbits,
  Headings,
  Layout,
} from './dov-census.constants';
import { censusNames, censusProfessions } from './dov-census.helpers';

export function DovCensus(): Component {
  const page: Int = useServerState(CensusVarbits.PAGE);

  let prevHidden: Boolean = false;
  if (page <= CensusPageBounds.FIRST) {
    prevHidden = true;
  }
  let nextHidden: Boolean = false;
  if (page >= CensusPageBounds.LAST) {
    nextHidden = true;
  }

  return (
    <>
      <layer x="center" y="center" w={Layout.BODY_W} h={Layout.BODY_H}>
        <model
          x="center"
          y={{ center: Layout.BACKDROP_Y }}
          w={Layout.BACKDROP_W}
          h={Layout.BACKDROP_H}
          model={CensusModel.BACKDROP}
          zoom={Camera.ZOOM}
          pitch={Camera.PITCH}
        />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CensusArt.CLOSE_REST}
          options={['Close']}
          dragTarget
          onOptionSelect={() => closeInterface()}
          onMouseRepeat={(event) => graphicSwapper(event.component, CensusArt.CLOSE_LIT)}
          onMouseLeave={(event) => graphicSwapper(event.component, CensusArt.CLOSE_REST)}
        />

        <text
          x={Layout.LEFT_X}
          y={Layout.HEADING_Y}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          font={CensusFonts.LEDGER}
          color={CensusColors.INK}
          shadow
          lineHeight={Layout.LINE_HEIGHT}
          text={Headings.NAMES}
        />

        <text
          x={Layout.LEFT_X}
          y={Layout.COLUMN_Y}
          w={Layout.COLUMN_W}
          h={Layout.COLUMN_H}
          font={CensusFonts.LEDGER}
          color={CensusColors.INK}
          shadow
          lineHeight={Layout.LINE_HEIGHT}
          text={censusNames(page)}
        />

        <text
          x={{ right: Layout.RIGHT_INSET }}
          y={Layout.HEADING_Y}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          font={CensusFonts.LEDGER}
          color={CensusColors.INK}
          shadow
          lineHeight={Layout.LINE_HEIGHT}
          text={Headings.PROFESSIONS}
        />

        <text
          x={{ right: Layout.RIGHT_INSET }}
          y={Layout.COLUMN_Y}
          w={Layout.COLUMN_W}
          h={Layout.COLUMN_H}
          font={CensusFonts.LEDGER}
          color={CensusColors.INK}
          shadow
          lineHeight={Layout.LINE_HEIGHT}
          text={censusProfessions(page)}
        />

        <sprite
          x={{ center: -Layout.ARROW_DX }}
          y={{ center: Layout.ARROW_Y }}
          w={Layout.ARROW_W}
          h={Layout.ARROW_H}
          sprite={CensusArt.PREV_REST}
          hide={prevHidden}
          options={['Previous page']}
          onMouseRepeat={(event) => graphicSwapper(event.component, CensusArt.PREV_LIT)}
          onMouseLeave={(event) => graphicSwapper(event.component, CensusArt.PREV_REST)}
        />

        <sprite
          x={{ center: Layout.ARROW_DX }}
          y={{ center: Layout.ARROW_Y }}
          w={Layout.ARROW_W}
          h={Layout.ARROW_H}
          sprite={CensusArt.NEXT_REST}
          hide={nextHidden}
          options={['Next page']}
          onMouseRepeat={(event) => graphicSwapper(event.component, CensusArt.NEXT_LIT)}
          onMouseLeave={(event) => graphicSwapper(event.component, CensusArt.NEXT_REST)}
        />
      </layer>
    </>
  );
}
