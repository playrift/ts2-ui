import { CensusPages } from './dov-census.constants';

export function censusNames(page: Int): String {
  switch (page) {
    case 0:
      return CensusPages.PAGE_0.names;
    case 1:
      return CensusPages.PAGE_1.names;
    case 2:
      return CensusPages.PAGE_2.names;
    case 3:
      return CensusPages.PAGE_3.names;
    case 4:
      return CensusPages.PAGE_4.names;
    case 5:
      return CensusPages.PAGE_5.names;
  }
  return '';
}

export function censusProfessions(page: Int): String {
  switch (page) {
    case 0:
      return CensusPages.PAGE_0.professions;
    case 1:
      return CensusPages.PAGE_1.professions;
    case 2:
      return CensusPages.PAGE_2.professions;
    case 3:
      return CensusPages.PAGE_3.professions;
    case 4:
      return CensusPages.PAGE_4.professions;
    case 5:
      return CensusPages.PAGE_5.professions;
  }
  return '';
}
