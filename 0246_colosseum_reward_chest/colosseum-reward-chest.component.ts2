import { useRef } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { opsound } from '../lib/lib.helpers';
import {
  ChestColors,
  ChestFonts,
  ChestHighlight,
  ChestModels,
  ChestOpSound,
  ChestSprites,
} from './colosseum-reward-chest.constants';

export function ColosseumRewardChest(): Component {
  const bankIcon = useRef();
  const inventoryIcon = useRef();
  const discardIcon = useRef();

  return (
    <>
      <SteelBorderEntrypoint title="Fortis Colosseum" />

      <layer x="center" y={{ bottom: 6 }} w={{ fill: 20 }} h={{ fill: 53 }}>
        <text
          x="center"
          y={{ center: 91 }}
          w="fill"
          h={32}
          text="Total Value:"
          font={ChestFonts.LABEL}
          color={ChestColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />

        <model
          x="right"
          y={0}
          w={130}
          h={130}
          model={ChestModels.CHEST}
          zoom={1000}
          pitch={171}
          yaw={267}
          offsetX={-3}
          offsetY={181}
        />

        <sprite
          x={{ right: 43 }}
          y={{ bottom: 45 }}
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Bank-all']}
          onMouseEnter={() => setTransparency(bankIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(bankIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.BANK)}
        />
        <sprite ref={bankIcon} x={{ right: 46 }} y={{ bottom: 52 }} w={29} h={22} sprite={ChestSprites.BANK_ICON} />

        <sprite
          x={{ right: 3 }}
          y={{ bottom: 45 }}
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['Take-all']}
          onMouseEnter={() => setTransparency(inventoryIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(inventoryIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.INVENTORY)}
        />
        <sprite
          ref={inventoryIcon}
          x={{ right: 8 }}
          y={{ bottom: 52 }}
          w={29}
          h={22}
          sprite={ChestSprites.INVENTORY_ICON}
        />

        <sprite
          x={{ right: 93 }}
          y={{ bottom: 45 }}
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Discard-all']}
          onMouseEnter={() => setTransparency(discardIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparency(discardIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.DISCARD)}
        />
        <sprite
          ref={discardIcon}
          x={{ right: 97 }}
          y={{ bottom: 52 }}
          w={29}
          h={22}
          sprite={ChestSprites.DISCARD_ICON}
        />

        <layer x={4} y={2} w={145} h={178} />
      </layer>
    </>
  );
}
