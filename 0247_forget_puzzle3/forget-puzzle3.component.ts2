import { createRef, useServerState, useWatch } from 'ts2';

import { setTransparency } from '../lib/lib.components';
import {
  BoardModels,
  ForgetArt,
  ForgetColors,
  ForgetFonts,
  ForgetVarbits,
  Junctions,
  Layout,
  LegendModels,
  OkFade,
  SwitchModels,
  TrackModels,
} from './forget-puzzle3.constants';

function countLeft(component: ComponentId): void {
  component.text = `x ${useServerState(ForgetVarbits.COUNT_LEFT)}`;
}

function countRight(component: ComponentId): void {
  component.text = `x ${useServerState(ForgetVarbits.COUNT_RIGHT)}`;
}

const yellowCounter = createRef('forget_puzzle3:yellow_counter');
const greenCounter = createRef('forget_puzzle3:green_counter');

export function ForgetPuzzle3(): Component {
  useWatch(ForgetVarbits.COUNT_LEFT, (event) => countLeft(event.component), yellowCounter);
  useWatch(ForgetVarbits.COUNT_RIGHT, (event) => countRight(event.component), greenCounter);

  return (
    <>
      <layer w="fill" h="fill">
        {BoardModels.map((model) => (
          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_SIZE}
            h={Layout.MODEL_SIZE}
            model={model}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
          />
        ))}
      </layer>

      <layer w="fill" h="fill">
        <text
          ref={yellowCounter}
          x={Layout.COUNT_LEFT_X}
          y={Layout.COUNT_LEFT_Y}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={ForgetFonts.COUNTER}
          color={ForgetColors.COUNTER}
          shadow
          text="x 2"
          onLoad={(event) => countLeft(event.component)}
        />
        <text
          ref={greenCounter}
          x={Layout.COUNT_RIGHT_X}
          y={Layout.COUNT_RIGHT_Y}
          w={Layout.COUNT_W}
          h={Layout.COUNT_H}
          font={ForgetFonts.COUNTER}
          color={ForgetColors.COUNTER}
          shadow
          text="x 2"
          onLoad={(event) => countRight(event.component)}
        />
        <model
          x={Layout.LEGEND_X}
          y={Layout.LEGEND_TOP_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={LegendModels.TOP}
          zoom={Layout.LEGEND_ZOOM}
          pitch={Layout.LEGEND_PITCH}
          roll={Layout.LEGEND_ROLL}
        />
        <model
          x={Layout.LEGEND_X}
          y={Layout.LEGEND_BOTTOM_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={LegendModels.BOTTOM}
          zoom={Layout.LEGEND_ZOOM}
          pitch={Layout.LEGEND_PITCH}
          roll={Layout.LEGEND_ROLL}
        />
      </layer>

      <layer w="fill" h="fill">
        {TrackModels.map((model) => (
          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_SIZE}
            h={Layout.MODEL_SIZE}
            model={model}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
          />
        ))}
      </layer>

      <layer w="fill" h="fill">
        {SwitchModels.map((model) => (
          <layer w="fill" h="fill" hide>
            <model
              x={Layout.MODEL_X}
              y={Layout.MODEL_Y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={model}
              zoom={Layout.MODEL_ZOOM}
              pitch={Layout.MODEL_PITCH}
            />
          </layer>
        ))}
        {Junctions.map((junction) => (
          <layer
            x={junction.x}
            y={junction.y}
            w={Layout.JUNCTION_SIZE}
            h={Layout.JUNCTION_SIZE}
            options={['Set Junction']}
          />
        ))}
      </layer>

      <layer x={Layout.OK_X} y={Layout.OK_Y} w={Layout.OK_SIZE} h={Layout.OK_SIZE} options={['Ok']}>
        <sprite
          x="center"
          y="center"
          w={Layout.OK_SIZE}
          h={Layout.OK_SIZE}
          sprite={ForgetArt.BUTTON}
          onMouseEnter={(event) => setTransparency(event.component, OkFade.HOVER)}
          onMouseLeave={(event) => setTransparency(event.component, OkFade.REST)}
        />
        <text
          x="center"
          y="center"
          w={Layout.OK_SIZE}
          h={Layout.OK_SIZE}
          font={ForgetFonts.BUTTON}
          color={ForgetColors.BUTTON}
          shadow
          align="center"
          valign="middle"
          text="Ok"
        />
      </layer>
    </>
  );
}
