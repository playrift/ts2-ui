import { useServerState } from 'ts2';
import { setTransparency } from '../lib/lib.components';
import {
  BoardCamera,
  ButtonFade,
  CounterVars,
  IconCamera,
  Junction,
  JunctionOption,
  JunctionVars,
  Junctions,
  Layout,
  OkButton,
  PuzzleColors,
  PuzzleFonts,
  PuzzleModels,
  PuzzleSprites,
} from './forget-puzzle1.constants';

export function ForgetPuzzle1(): Component {
  return (
    <>
      <layer w="fill" h="fill">
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={PuzzleModels.BOARD_BACK}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={PuzzleModels.BOARD_FRONT}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>

        <layer w="fill" h="fill">
          <layer x={Layout.COUNTER_X} y={Layout.COUNTER_TOP_Y} w={Layout.COUNTER_W} h={Layout.COUNTER_H}>
            <CounterLeft />
          </layer>
          <layer x={Layout.COUNTER_X} y={Layout.COUNTER_BOTTOM_Y} w={Layout.COUNTER_W} h={Layout.COUNTER_H}>
            <CounterRight />
          </layer>
          <model
            x={Layout.ICON_X}
            y={Layout.ICON_TOP_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={PuzzleModels.ICON_TOP}
            zoom={IconCamera.ZOOM}
            pitch={IconCamera.PITCH}
            yaw={IconCamera.YAW}
            roll={IconCamera.ROLL}
          />
          <model
            x={Layout.ICON_X}
            y={Layout.ICON_BOTTOM_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={PuzzleModels.ICON_BOTTOM}
            zoom={IconCamera.ZOOM}
            pitch={IconCamera.PITCH}
            yaw={IconCamera.YAW}
            roll={IconCamera.ROLL}
          />
        </layer>

        <layer w="fill" h="fill">
          <Tracks />
        </layer>

        <layer w="fill" h="fill">
          <Switches />
          <layer
            x={Junctions.A.hitX}
            y={Junctions.A.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.B.hitX}
            y={Junctions.B.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.C.hitX}
            y={Junctions.C.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.D.hitX}
            y={Junctions.D.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.E.hitX}
            y={Junctions.E.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.F.hitX}
            y={Junctions.F.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.G.hitX}
            y={Junctions.G.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
          <layer
            x={Junctions.H.hitX}
            y={Junctions.H.hitY}
            w={Layout.HITBOX}
            h={Layout.HITBOX}
            options={[JunctionOption]}
          />
        </layer>
      </layer>

      <layer x={Layout.OK_X} y={Layout.OK_Y} w={Layout.OK_BOX} h={Layout.OK_BOX} options={[OkButton.OPTION]}>
        <sprite
          x={0}
          y={0}
          w={Layout.OK_BOX}
          h={Layout.OK_BOX}
          sprite={PuzzleSprites.BUTTON}
          onMouseEnter={(event) => setTransparency(event.component, ButtonFade.HOVER)}
          onMouseLeave={(event) => setTransparency(event.component, ButtonFade.REST)}
        />
        <text
          x="center"
          y="center"
          w={Layout.OK_BOX}
          h={Layout.OK_BOX}
          text={OkButton.LABEL}
          font={PuzzleFonts.BUTTON}
          color={PuzzleColors.BUTTON}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}

export function CounterLeft(): Component {
  const count: Int = useServerState(CounterVars.LEFT);
  return <text w="fill" h="fill" text={`x ${count}`} font={PuzzleFonts.COUNTER} color={PuzzleColors.COUNTER} shadow />;
}

export function CounterRight(): Component {
  const count: Int = useServerState(CounterVars.RIGHT);
  return <text w="fill" h="fill" text={`x ${count}`} font={PuzzleFonts.COUNTER} color={PuzzleColors.COUNTER} shadow />;
}

export function Tracks(): Component {
  const a: Int = useServerState(JunctionVars.A);
  const b: Int = useServerState(JunctionVars.B);
  const c: Int = useServerState(JunctionVars.C);
  const d: Int = useServerState(JunctionVars.D);
  const e: Int = useServerState(JunctionVars.E);
  const f: Int = useServerState(JunctionVars.F);
  const g: Int = useServerState(JunctionVars.G);
  const h: Int = useServerState(JunctionVars.H);
  return (
    <>
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={a === Junction.LEFT ? Junctions.A.trackLeftLit : Junctions.A.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={a === Junction.RIGHT ? Junctions.A.trackRightLit : Junctions.A.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={b === Junction.LEFT ? Junctions.B.trackLeftLit : Junctions.B.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={b === Junction.RIGHT ? Junctions.B.trackRightLit : Junctions.B.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={c === Junction.LEFT ? Junctions.C.trackLeftLit : Junctions.C.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={c === Junction.RIGHT ? Junctions.C.trackRightLit : Junctions.C.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={d === Junction.LEFT ? Junctions.D.trackLeftLit : Junctions.D.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={d === Junction.RIGHT ? Junctions.D.trackRightLit : Junctions.D.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={e === Junction.LEFT ? Junctions.E.trackLeftLit : Junctions.E.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={e === Junction.RIGHT ? Junctions.E.trackRightLit : Junctions.E.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={f === Junction.LEFT ? Junctions.F.trackLeftLit : Junctions.F.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={f === Junction.RIGHT ? Junctions.F.trackRightLit : Junctions.F.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={g === Junction.LEFT ? Junctions.G.trackLeftLit : Junctions.G.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={g === Junction.RIGHT ? Junctions.G.trackRightLit : Junctions.G.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={h === Junction.LEFT ? Junctions.H.trackLeftLit : Junctions.H.trackLeftBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
      <model
        x={Layout.MESH_X}
        y={Layout.MESH_Y}
        w={Layout.MESH_BOX}
        h={Layout.MESH_BOX}
        model={h === Junction.RIGHT ? Junctions.H.trackRightLit : Junctions.H.trackRightBase}
        zoom={BoardCamera.ZOOM}
        pitch={BoardCamera.PITCH}
      />
    </>
  );
}

export function Switches(): Component {
  const a: Int = useServerState(JunctionVars.A);
  const b: Int = useServerState(JunctionVars.B);
  const c: Int = useServerState(JunctionVars.C);
  const d: Int = useServerState(JunctionVars.D);
  const e: Int = useServerState(JunctionVars.E);
  const f: Int = useServerState(JunctionVars.F);
  const g: Int = useServerState(JunctionVars.G);
  const h: Int = useServerState(JunctionVars.H);
  return (
    <>
      {a !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={a === Junction.RIGHT ? Junctions.A.switchRight : Junctions.A.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {b !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={b === Junction.RIGHT ? Junctions.B.switchRight : Junctions.B.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {c !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={c === Junction.RIGHT ? Junctions.C.switchRight : Junctions.C.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {d !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={d === Junction.RIGHT ? Junctions.D.switchRight : Junctions.D.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {e !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={e === Junction.RIGHT ? Junctions.E.switchRight : Junctions.E.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {f !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={f === Junction.RIGHT ? Junctions.F.switchRight : Junctions.F.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {g !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={g === Junction.RIGHT ? Junctions.G.switchRight : Junctions.G.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
      {h !== Junction.UNSET && (
        <layer w="fill" h="fill">
          <model
            x={Layout.MESH_X}
            y={Layout.MESH_Y}
            w={Layout.MESH_BOX}
            h={Layout.MESH_BOX}
            model={h === Junction.RIGHT ? Junctions.H.switchRight : Junctions.H.switchLeft}
            zoom={BoardCamera.ZOOM}
            pitch={BoardCamera.PITCH}
          />
        </layer>
      )}
    </>
  );
}
