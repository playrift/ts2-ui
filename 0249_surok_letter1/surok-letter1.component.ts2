import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { LetterArt, LetterColor, LetterCopy, LetterFont, LetterModel, Layout } from './surok-letter1.constants';

export function SurokLetter1(): Component {
  return (
    <>
      <model
        x={Layout.model.x}
        y={Layout.model.y}
        w={Layout.model.w}
        h={Layout.model.h}
        model={LetterModel.PARCHMENT}
        zoom={LetterModel.ZOOM}
        pitch={LetterModel.PITCH}
      />

      <text
        x={Layout.heading.x}
        y={Layout.heading.y}
        w={Layout.heading.w}
        h={Layout.heading.h}
        font={LetterFont.HAND}
        color={LetterColor.INK}
        text={LetterCopy.HEADING}
      />

      <text
        x={Layout.body.x}
        y={Layout.body.y}
        w={Layout.body.w}
        h={Layout.body.h}
        font={LetterFont.HAND}
        color={LetterColor.INK}
        text={LetterCopy.BODY}
      />

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={LetterArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, LetterArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, LetterArt.CLOSE)}
      />
    </>
  );
}
