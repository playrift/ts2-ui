import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, LockGateArt, LockGateModel, LockPlates, LOCK_OP } from './olaf2-lock-gate.constants';

export function Olaf2LockGate(): Component {
  return (
    <>
      <model
        x={Layout.GATE_X}
        y={Layout.GATE_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={LockGateModel.GATE}
        zoom={Camera.GATE.ZOOM}
        pitch={Camera.GATE.PITCH}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={LockGateArt.CLOSE}
        options={['Close']}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, LockGateArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, LockGateArt.CLOSE);
        }}
      />

      <layer
        x={Layout.CLOSE_HOLDER_X}
        y={Layout.CLOSE_HOLDER_Y}
        w={Layout.CLOSE_HOLDER_SIZE}
        h={Layout.CLOSE_HOLDER_SIZE}
        hide
      />

      {LockPlates.map((plate) => (
        <layer x={plate.x} y={plate.y} w={plate.w} h={plate.h} />
      ))}

      <model
        x={Layout.DUMMY_KEY_X}
        y={Layout.DUMMY_KEY_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={LockGateModel.DUMMY_KEY}
        zoom={Camera.DUMMY_KEY.ZOOM}
        pitch={Camera.DUMMY_KEY.PITCH}
      />

      {LockPlates.map((plate) => (
        <model x={plate.x} y={plate.y} w={plate.w} h={plate.h} zoom={Camera.SLOT_ZOOM} options={[LOCK_OP]} />
      ))}

      <model
        x={Layout.KEY_DUMMY_X}
        y={Layout.KEY_DUMMY_Y}
        w={Layout.KEY_DUMMY_W}
        h={Layout.KEY_DUMMY_H}
        zoom={Camera.SLOT_ZOOM}
      />
    </>
  );
}
