import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, Levers, LeverSlots, SkullArt, SkullModel, SkullOps } from './olaf2-skull-puzzle.constants';

export function Olaf2SkullPuzzle(): Component {
  return (
    <>
      <model
        x={Layout.BACKGROUND_X}
        y={Layout.BACKGROUND_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.BACKGROUND}
        zoom={Camera.SKULL_ZOOM}
        pitch={Camera.PITCH}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={SkullArt.CLOSE}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, SkullArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, SkullArt.CLOSE);
        }}
      />

      <layer
        x={Layout.CLOSE_HOLDER_X}
        y={Layout.CLOSE_HOLDER_Y}
        w={Layout.CLOSE_HOLDER_SIZE}
        h={Layout.CLOSE_HOLDER_SIZE}
        hide
      />

      <model
        x={Layout.BITS_X}
        y={Layout.BITS_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.BITS}
        zoom={Camera.BITS_ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.RIGHT_X}
        y={Layout.RIGHT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.RIGHT}
        zoom={Camera.SKULL_ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.TOP_X}
        y={Layout.TOP_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.TOP}
        zoom={Camera.SKULL_ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.LEFT_X}
        y={Layout.LEFT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.LEFT}
        zoom={Camera.SKULL_ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.BOTTOM_X}
        y={Layout.BOTTOM_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.BOTTOM}
        zoom={Camera.SKULL_ZOOM}
        pitch={Camera.PITCH}
      />

      {Levers.map((lever) => (
        <model
          x={lever.x}
          y={lever.y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={SkullModel.LEVER}
          zoom={Camera.LEVER_ZOOM}
          pitch={Camera.PITCH}
          options={[SkullOps.PULL]}
        />
      ))}

      <model
        x={Layout.CONFIRM_X}
        y={Layout.CONFIRM_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SkullModel.LEVER}
        zoom={Camera.LEVER_ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.CONFIRM_YAW}
        options={[SkullOps.CONFIRM]}
      />

      {LeverSlots.map((slot) => (
        <layer x={slot.x} y={slot.y} w={slot.w} h={slot.h} />
      ))}

      <layer x={Layout.CONFIRM_SLOT_X} y={Layout.CONFIRM_SLOT_Y} w={Layout.CONFIRM_SLOT_W} h={Layout.CONFIRM_SLOT_H} />
    </>
  );
}
