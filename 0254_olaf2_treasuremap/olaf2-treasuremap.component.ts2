import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, Olaf2Art, Olaf2Model } from './olaf2-treasuremap.constants';

export function Olaf2TreasureMap(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={Olaf2Model.MAP}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={Olaf2Art.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, Olaf2Art.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, Olaf2Art.CLOSE)}
      />
    </>
  );
}
