import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  Olaf2UlricArt,
  Olaf2UlricColor,
  Olaf2UlricFont,
  Olaf2UlricModel,
} from './olaf2-ulric-parchment.constants';

export function Olaf2UlricParchment(): Component {
  return (
    <>
      <model
        x={Layout.model.x}
        y={Layout.model.y}
        w={Layout.model.w}
        h={Layout.model.h}
        model={Olaf2UlricModel.PARCHMENT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={Olaf2UlricArt.CLOSE}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, Olaf2UlricArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, Olaf2UlricArt.CLOSE)}
      />

      <layer x={Layout.closeHit.x} y={Layout.closeHit.y} w={Layout.closeHit.w} h={Layout.closeHit.h} hide />

      <text
        x={Layout.text.x}
        y={Layout.text.y}
        w={Layout.text.w}
        h={Layout.text.h}
        font={Olaf2UlricFont.BODY}
        color={Olaf2UlricColor.INK}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
