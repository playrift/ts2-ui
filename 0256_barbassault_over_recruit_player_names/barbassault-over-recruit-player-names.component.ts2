import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BarbassaultOverlay } from '../0485_barbassault_over_att/barbassault-overlay.shared';
import {
  BODY_WASH,
  HeadCamera,
  Layout,
  RosterColor,
  RosterFonts,
  RosterRows,
  TITLE_WASH,
} from './barbassault-over-recruit-player-names.constants';

const timerHost = createRef('0256_barbassault_over_recruit_player_names_timer_host');

const content = createRef('barbassault_over_recruit_player_names_content');

export function BarbassaultOverRecruitPlayerNames_(): Component {
  useInterval(
    () => overlayRelayout(timerHost, content, BarbassaultOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0),
    timerHost,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={{ right: Layout.PLATE_RIGHT }} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect x={0} y={0} w={Layout.TITLE_W} h={Layout.TITLE_H} color={RosterColor.FRAME} />
          <rect x={0} y={Layout.BODY_Y} w={Layout.BODY_W} h={Layout.BODY_H} color={RosterColor.FRAME} />
          <rect
            x={0}
            y={0}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            color={RosterColor.FRAME}
            fill
            transparency={TITLE_WASH}
          />
          <rect
            x={0}
            y={Layout.BODY_Y}
            w={Layout.BODY_W}
            h={Layout.BODY_H}
            color={RosterColor.FRAME}
            fill
            transparency={BODY_WASH}
          />

          <text
            x={Layout.HEADING_X}
            y={Layout.HEADING_Y}
            w={Layout.HEADING_W}
            h={Layout.ROW_H}
            font={RosterFonts.HEADING}
            text="Current team"
            shadow
            color={RosterColor.NAME}
          />

          {RosterRows.map((row) => (
            <text
              x={Layout.NAME_X}
              y={row.y}
              w={Layout.NAME_W}
              h={Layout.ROW_H}
              font={RosterFonts.ROW}
              text="-----"
              shadow
              color={RosterColor.NAME}
            />
          ))}

          {RosterRows.map((row) => (
            <text
              x={Layout.LABEL_X}
              y={row.y}
              w={Layout.LABEL_W}
              h={Layout.ROW_H}
              font={RosterFonts.ROW}
              text={row.label}
              shadow
              color={RosterColor.LABEL}
            />
          ))}

          {RosterRows.map((row) => (
            <model
              x={Layout.HEAD_X}
              y={row.y}
              w={Layout.HEAD_W}
              h={Layout.HEAD_H}
              zoom={HeadCamera.ZOOM}
              pitch={HeadCamera.PITCH}
              yaw={HeadCamera.YAW}
            />
          ))}
        </layer>
      </layer>
    </layer>
  );
}
