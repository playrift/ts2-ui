import { createRef, useInterval } from 'ts2';

import { modelDynamicZoom } from '../lib/lib.models';
import { CARRIAGE_Y_CENTER_OFFSET, Layout, TrainAnim, TrainCamera, TrainModel } from './slice-train-driveby.constants';

const timerHost = createRef('0258_slice_train_driveby_timer_host');

const lastCarriage = createRef('slice_train_driveby_com_9');

export function SliceTrainDriveby(): Component {
  useInterval(
    () =>
      modelDynamicZoom(
        timerHost,
        lastCarriage,
        TrainCamera.NEAR,
        TrainCamera.FAR,
        TrainCamera.OFFSET_X,
        TrainCamera.OFFSET_Y,
        TrainCamera.PITCH,
        TrainCamera.YAW,
        TrainCamera.ROLL,
      ),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.ENGINE}
        anim={TrainAnim.CAR_1}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_A}
        anim={TrainAnim.CAR_2}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_3}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_4}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_5}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_6}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_7}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_8}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
      <model
        ref={lastCarriage}
        x="center"
        y={{ center: CARRIAGE_Y_CENTER_OFFSET }}
        w={Layout.CARRIAGE_BOX}
        h={Layout.CARRIAGE_BOX}
        model={TrainModel.CAR_B}
        anim={TrainAnim.CAR_9}
        zoom={TrainCamera.NEAR}
        pitch={TrainCamera.PITCH}
      />
    </layer>
  );
}
