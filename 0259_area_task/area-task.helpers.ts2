import { useServerState } from 'ts2';
import { scaled } from '../lib/lib.engine';
import { Varbits } from '../lib/game/varbits';
import { leaguesEnabled } from '../0735_league-3-fragments/league-3-fragments.helpers';
import { AreaTaskColors, Layout } from './area-task.constants';

export function areaTaskComplete(diary: Int): Int {
  if (diary === 0) {
    if (
      useServerState(Varbits.ATJUN_EASY_DONE) === 2 &&
      useServerState(Varbits.ATJUN_MED_DONE) === 2 &&
      useServerState(Varbits.ATJUN_HARD_DONE) === 2 &&
      useServerState(Varbits.KARAMJA_DIARY_ELITE_COMPLETE) === 1
    ) {
      return 2;
    }
    if (useServerState(Varbits.ATJUN_STARTED) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 1) {
    if (
      useServerState(Varbits.ARDOUGNE_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.ARDOUGNE_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.ARDOUGNE_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.ARDOUGNE_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_ARDOUGNE_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 2) {
    if (
      useServerState(Varbits.FALADOR_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.FALADOR_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.FALADOR_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.FALADOR_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_FALADOR_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 9) {
    if (
      useServerState(Varbits.WILDERNESS_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.WILDERNESS_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.WILDERNESS_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.WILDERNESS_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_WILDERNESS_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 10) {
    if (
      useServerState(Varbits.WESTERN_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.WESTERN_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.WESTERN_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.WESTERN_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_WESTERN_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 4) {
    if (
      useServerState(Varbits.KANDARIN_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.KANDARIN_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.KANDARIN_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.KANDARIN_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_KANDARIN_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 5) {
    if (
      useServerState(Varbits.DESERT_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.DESERT_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.DESERT_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.DESERT_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_DESERT_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 7) {
    if (
      useServerState(Varbits.MORYTANIA_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.MORYTANIA_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.MORYTANIA_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.MORYTANIA_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_MORYTANIA_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 3) {
    if (
      useServerState(Varbits.FREMENNIK_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.FREMENNIK_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.FREMENNIK_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.FREMENNIK_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_FREMENNIK_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 6) {
    if (
      useServerState(Varbits.LUMBRIDGE_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.LUMBRIDGE_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.LUMBRIDGE_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.LUMBRIDGE_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_LUMBRIDGE_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 8) {
    if (
      useServerState(Varbits.VARROCK_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.VARROCK_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.VARROCK_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.VARROCK_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_VARROCK_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  if (diary === 11) {
    if (
      useServerState(Varbits.KOUREND_DIARY_EASY_COMPLETE) +
        useServerState(Varbits.KOUREND_DIARY_MEDIUM_COMPLETE) +
        useServerState(Varbits.KOUREND_DIARY_HARD_COMPLETE) +
        useServerState(Varbits.KOUREND_DIARY_ELITE_COMPLETE) ===
      4
    ) {
      return 2;
    }
    if (useServerState(Varbits.STARTED_KOUREND_DIARY) === 0) {
      return 0;
    }
    return 1;
  }
  return 0;
}

export function tierCount(diary: Int, tier: Int): Int {
  switch (diary) {
    case 0:
      if (tier === 0) return useServerState(Varbits.KARAMJA_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.KARAMJA_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.KARAMJA_HARD_COUNT);
      return useServerState(Varbits.KARAMJA_ELITE_COUNT);
    case 1:
      if (tier === 0) return useServerState(Varbits.ARDOUGNE_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.ARDOUGNE_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.ARDOUGNE_HARD_COUNT);
      return useServerState(Varbits.ARDOUGNE_ELITE_COUNT);
    case 2:
      if (tier === 0) return useServerState(Varbits.FALADOR_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.FALADOR_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.FALADOR_HARD_COUNT);
      return useServerState(Varbits.FALADOR_ELITE_COUNT);
    case 9:
      if (tier === 0) return useServerState(Varbits.WILDERNESS_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.WILDERNESS_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.WILDERNESS_HARD_COUNT);
      return useServerState(Varbits.WILDERNESS_ELITE_COUNT);
    case 10:
      if (tier === 0) return useServerState(Varbits.WESTERN_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.WESTERN_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.WESTERN_HARD_COUNT);
      return useServerState(Varbits.WESTERN_ELITE_COUNT);
    case 4:
      if (tier === 0) return useServerState(Varbits.KANDARIN_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.KANDARIN_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.KANDARIN_HARD_COUNT);
      return useServerState(Varbits.KANDARIN_ELITE_COUNT);
    case 5:
      if (tier === 0) return useServerState(Varbits.DESERT_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.DESERT_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.DESERT_HARD_COUNT);
      return useServerState(Varbits.DESERT_ELITE_COUNT);
    case 7:
      if (tier === 0) return useServerState(Varbits.MORYTANIA_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.MORYTANIA_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.MORYTANIA_HARD_COUNT);
      return useServerState(Varbits.MORYTANIA_ELITE_COUNT);
    case 3:
      if (tier === 0) return useServerState(Varbits.FREMENNIK_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.FREMENNIK_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.FREMENNIK_HARD_COUNT);
      return useServerState(Varbits.FREMENNIK_ELITE_COUNT);
    case 6:
      if (tier === 0) return useServerState(Varbits.LUMBRIDGE_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.LUMBRIDGE_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.LUMBRIDGE_HARD_COUNT);
      return useServerState(Varbits.LUMBRIDGE_ELITE_COUNT);
    case 8:
      if (tier === 0) return useServerState(Varbits.VARROCK_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.VARROCK_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.VARROCK_HARD_COUNT);
      return useServerState(Varbits.VARROCK_ELITE_COUNT);
    case 11:
      if (tier === 0) return useServerState(Varbits.KOUREND_EASY_COUNT);
      if (tier === 1) return useServerState(Varbits.KOUREND_MED_COUNT);
      if (tier === 2) return useServerState(Varbits.KOUREND_HARD_COUNT);
      return useServerState(Varbits.KOUREND_ELITE_COUNT);
  }
  return -1;
}

export function tierTotal(diary: Int, tier: Int): Int {
  switch (diary) {
    case 0:
      if (tier === 0) return 10;
      if (tier === 1) return 19;
      if (tier === 2) return 10;
      return 5;
    case 1:
      if (tier === 0) return 10;
      if (tier === 1) return 12;
      if (tier === 2) return 12;
      return 8;
    case 2:
      if (tier === 0) return 11;
      if (tier === 1) return 14;
      if (tier === 2) return 11;
      return 6;
    case 9:
      if (tier === 0) return 12;
      if (tier === 1) return 11;
      if (tier === 2) return 10;
      return 7;
    case 10:
      if (tier === 0) return 11;
      if (tier === 1) return 13;
      if (tier === 2) return 13;
      return 7;
    case 4:
      if (tier === 0) return 11;
      if (tier === 1) return 14;
      if (tier === 2) return 11;
      return 7;
    case 5:
      if (tier === 0) return 11;
      if (tier === 1) return 12;
      if (tier === 2) return 10;
      return 6;
    case 7:
      if (tier === 0) return 11;
      if (tier === 1) return 11;
      if (tier === 2) return 10;
      return 6;
    case 3:
      if (tier === 0) return 10;
      if (tier === 1) return 9;
      if (tier === 2) return 9;
      return 6;
    case 6:
      if (tier === 0) return 12;
      if (tier === 1) return 12;
      if (tier === 2) return 11;
      return 6;
    case 8:
      if (tier === 0) return 14;
      if (tier === 1) return 13;
      if (tier === 2) return 10;
      return 5;
    case 11:
      if (tier === 0) return 12;
      if (tier === 1) return 13;
      if (tier === 2) return 10;
      return 8;
  }
  return -1;
}

export function tierReward(diary: Int, tier: Int): Int {
  switch (diary) {
    case 0:
      if (tier === 0) return useServerState(Varbits.ATJUN_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.ATJUN_MED_REWARD);
      if (tier === 2) return useServerState(Varbits.ATJUN_HARD_REWARD);
      return useServerState(Varbits.KARAMJA_ELITE_REWARD);
    case 1:
      if (tier === 0) return useServerState(Varbits.ARDOUGNE_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.ARDOUGNE_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.ARDOUGNE_HARD_REWARD);
      return useServerState(Varbits.ARDOUGNE_ELITE_REWARD);
    case 2:
      if (tier === 0) return useServerState(Varbits.FALADOR_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.FALADOR_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.FALADOR_HARD_REWARD);
      return useServerState(Varbits.FALADOR_ELITE_REWARD);
    case 9:
      if (tier === 0) return useServerState(Varbits.WILDERNESS_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.WILDERNESS_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.WILDERNESS_HARD_REWARD);
      return useServerState(Varbits.WILDERNESS_ELITE_REWARD);
    case 10:
      if (tier === 0) return useServerState(Varbits.WESTERN_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.WESTERN_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.WESTERN_HARD_REWARD);
      return useServerState(Varbits.WESTERN_ELITE_REWARD);
    case 4:
      if (tier === 0) return useServerState(Varbits.KANDARIN_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.KANDARIN_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.KANDARIN_HARD_REWARD);
      return useServerState(Varbits.KANDARIN_ELITE_REWARD);
    case 5:
      if (tier === 0) return useServerState(Varbits.DESERT_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.DESERT_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.DESERT_HARD_REWARD);
      return useServerState(Varbits.DESERT_ELITE_REWARD);
    case 7:
      if (tier === 0) return useServerState(Varbits.MORYTANIA_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.MORYTANIA_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.MORYTANIA_HARD_REWARD);
      return useServerState(Varbits.MORYTANIA_ELITE_REWARD);
    case 3:
      if (tier === 0) return useServerState(Varbits.FREMENNIK_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.FREMENNIK_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.FREMENNIK_HARD_REWARD);
      return useServerState(Varbits.FREMENNIK_ELITE_REWARD);
    case 6:
      if (tier === 0) return useServerState(Varbits.LUMBRIDGE_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.LUMBRIDGE_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.LUMBRIDGE_HARD_REWARD);
      return useServerState(Varbits.LUMBRIDGE_ELITE_REWARD);
    case 8:
      if (tier === 0) return useServerState(Varbits.VARROCK_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.VARROCK_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.VARROCK_HARD_REWARD);
      return useServerState(Varbits.VARROCK_ELITE_REWARD);
    case 11:
      if (tier === 0) return useServerState(Varbits.KOUREND_EASY_REWARD);
      if (tier === 1) return useServerState(Varbits.KOUREND_MEDIUM_REWARD);
      if (tier === 2) return useServerState(Varbits.KOUREND_HARD_REWARD);
      return useServerState(Varbits.KOUREND_ELITE_REWARD);
  }
  return -1;
}

export function diaryGreyed(diary: Int): Boolean {
  if (leaguesEnabled() === false) {
    return false;
  }
  if (useServerState(Varbits.LEAGUE_TYPE) === 1) {
    if (diary === 11) {
      return false;
    }
    return true;
  }
  return false;
}

export function diaryColour(diary: Int): Int {
  if (diaryGreyed(diary)) {
    return AreaTaskColors.GREY;
  }
  const state: Int = areaTaskComplete(diary);
  if (state === 2) {
    return AreaTaskColors.COMPLETE;
  }
  if (state === 1) {
    return AreaTaskColors.STARTED;
  }
  return AreaTaskColors.NOT_STARTED;
}

export function hexToRgb(colour: Int): [Int, Int, Int] {
  return [(colour / Math.pow(2, 16)) % 256, (colour / Math.pow(2, 8)) % 256, colour % 256];
}

export function rgbToHex(red: Int, green: Int, blue: Int): Int {
  let r: Int = red;
  let g: Int = green;
  let b: Int = blue;
  if (r > 255) {
    r = 255;
  } else if (r < 0) {
    r = 0;
  }
  if (g > 255) {
    g = 255;
  } else if (g < 0) {
    g = 0;
  }
  if (b > 255) {
    b = 255;
  } else if (b < 0) {
    b = 0;
  }
  return (r * 65536) | (g * 256) | b;
}

export function scaleColour(from: Int, to: Int, num: Int, den: Int): Int {
  const [fromRed, fromGreen, fromBlue] = hexToRgb(from);
  const [toRed, toGreen, toBlue] = hexToRgb(to);
  return rgbToHex(
    fromRed + scaled(num, den, toRed - fromRed),
    fromGreen + scaled(num, den, toGreen - fromGreen),
    fromBlue + scaled(num, den, toBlue - fromBlue),
  );
}

export function segmentWidth(count: Int, total: Int): Int {
  if (count === 0) {
    return 0;
  }
  return Math.min(Layout.segment.fillMax, 1 + scaled(count, total, Layout.segment.fillMax - 1));
}

export function segmentColour(claimed: Int, width: Int): Int {
  if (claimed === 1) {
    return AreaTaskColors.REWARD_CLAIMED;
  }
  return scaleColour(AreaTaskColors.BAR_EMPTY, AreaTaskColors.BAR_FULL, width, Layout.segment.fillMax);
}

export function segmentFill(diary: Int, tier: Int): Int {
  return segmentWidth(tierCount(diary, tier), tierTotal(diary, tier));
}

export function segmentFillColour(diary: Int, tier: Int): Int {
  return segmentColour(tierReward(diary, tier), segmentFill(diary, tier));
}
