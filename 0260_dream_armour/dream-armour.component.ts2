import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { DreamArmourArt, DreamArmourColor, DreamArmourFonts, Layout, Text } from './dream-armour.constants';
import { DreamBankGrid } from './dream-bank-grid.component';
import { DreamChestIcons } from './dream-chest-icons.component';
import { DreamChestSlots } from './dream-chest-slots.component';

export function DreamArmour(): Component {
  return (
    <>
      <rect
        x={Layout.plateBank.x}
        y={Layout.plateBank.y}
        w={Layout.plateBank.w}
        h={Layout.plateBank.h}
        color={DreamArmourColor.PLATE}
        fill={true}
        transparency={DreamArmourColor.PLATE_TRANSPARENCY}
      />
      <rect
        x={Layout.plateChest.x}
        y={Layout.plateChest.y}
        w={Layout.plateChest.w}
        h={Layout.plateChest.h}
        color={DreamArmourColor.PLATE}
        fill={true}
        transparency={DreamArmourColor.PLATE_TRANSPARENCY}
      />

      <layer x={Layout.frame.x} y={Layout.frame.y} w={Layout.frame.w} h={Layout.frame.h}>
        <sprite x={24} y={22} w={256} h={296} sprite={DreamArmourArt.BACKING} tiling />
        <sprite x={292} y={16} w={214} h={304} sprite={DreamArmourArt.BACKING} tiling />

        <sprite x={17} y={15} w={32} h={32} sprite={DreamArmourArt.CORNER_TL} />
        <sprite x={17} y={34} w={32} h={32} sprite={DreamArmourArt.DIVIDER_LEFT} />
        <sprite x={17} y={293} w={32} h={32} sprite={DreamArmourArt.CORNER_BL} />
        <sprite x={255} y={15} w={32} h={32} sprite={DreamArmourArt.CORNER_TR} />
        <sprite x={255} y={34} w={32} h={32} sprite={DreamArmourArt.DIVIDER_RIGHT} />
        <sprite x={255} y={293} w={32} h={32} sprite={DreamArmourArt.CORNER_BR} />

        <sprite x={291} y={15} w={32} h={32} sprite={DreamArmourArt.CORNER_TL} />
        <sprite x={291} y={34} w={32} h={32} sprite={DreamArmourArt.DIVIDER_LEFT} />
        <sprite x={291} y={293} w={32} h={32} sprite={DreamArmourArt.CORNER_BL} />
        <sprite x={481} y={15} w={32} h={32} sprite={DreamArmourArt.CORNER_TR} />
        <sprite x={481} y={34} w={32} h={32} sprite={DreamArmourArt.DIVIDER_RIGHT} />
        <sprite x={481} y={293} w={32} h={32} sprite={DreamArmourArt.CORNER_BR} />

        <sprite x={4} y={54} w={21} h={241} sprite={DreamArmourArt.RAIL_LEFT} tiling />
        <sprite x={267} y={54} w={24} h={240} sprite={DreamArmourArt.RAIL_RIGHT} tiling />

        <sprite x={47} y={2} w={209} h={20} sprite={DreamArmourArt.RAIL_TOP} tiling />
        <sprite x={27} y={32} w={253} h={26} sprite={DreamArmourArt.DIVIDER} tiling />
        <sprite x={48} y={305} w={208} h={25} sprite={DreamArmourArt.RAIL_BOTTOM} tiling />

        <sprite x={323} y={305} w={161} h={28} sprite={DreamArmourArt.RAIL_BOTTOM} tiling />
        <sprite x={322} y={2} w={176} h={30} sprite={DreamArmourArt.RAIL_TOP} tiling />
        <sprite x={300} y={32} w={202} h={22} sprite={DreamArmourArt.DIVIDER} tiling />
        <sprite x={493} y={55} w={20} h={240} sprite={DreamArmourArt.RAIL_RIGHT} tiling />
        <sprite x={278} y={55} w={22} h={241} sprite={DreamArmourArt.RAIL_LEFT} tiling />

        <sprite x={314} y={66} w={61} h={62} sprite={DreamArmourArt.CHEST} />

        <sprite x={406} y={123} w={Layout.STUB} h={Layout.STUB} sprite={DreamArmourArt.CONNECTOR} />
        <sprite x={406} y={167} w={Layout.STUB} h={Layout.STUB} sprite={DreamArmourArt.CONNECTOR} />
        <sprite x={385} y={145} w={Layout.STUB} h={Layout.STUB} sprite={DreamArmourArt.DIVIDER} />
        <sprite x={406} y={208} w={Layout.STUB} h={Layout.STUB} sprite={DreamArmourArt.CONNECTOR} />

        <sprite x={406} y={104} w={Layout.TILE} h={Layout.TILE} sprite={DreamArmourArt.SLOT} />
        <sprite x={406} y={145} w={Layout.TILE} h={Layout.TILE} sprite={DreamArmourArt.SLOT} />
        <sprite x={406} y={186} w={Layout.TILE} h={Layout.TILE} sprite={DreamArmourArt.SLOT} />
        <sprite x={406} y={227} w={Layout.TILE} h={Layout.TILE} sprite={DreamArmourArt.SLOT} />
        <sprite x={356} y={145} w={Layout.TILE} h={Layout.TILE} sprite={DreamArmourArt.SLOT} />

        <layer x={0} y={0} w="fill" h="fill">
          <DreamChestIcons />
        </layer>

        <text
          x={Layout.bankTitle.x}
          y={Layout.bankTitle.y}
          w={Layout.bankTitle.w}
          h={Layout.bankTitle.h}
          text={Text.BANK}
          font={DreamArmourFonts.HEADING}
          color={DreamArmourColor.HEADING}
          shadow
          align="left"
          valign="top"
        />

        <layer x={Layout.bank.x} y={Layout.bank.y} w={Layout.bank.w} h={Layout.bank.h}>
          <DreamBankGrid />
        </layer>

        <text
          x={Layout.chestTitle.x}
          y={Layout.chestTitle.y}
          w={Layout.chestTitle.w}
          h={Layout.chestTitle.h}
          text={Text.CHEST}
          font={DreamArmourFonts.HEADING}
          color={DreamArmourColor.HEADING}
          shadow
          align="center"
          valign="top"
        />
      </layer>

      <layer x={Layout.chest.x} y={Layout.chest.y} w={Layout.chest.w} h={Layout.chest.h}>
        <DreamChestSlots />
      </layer>

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={DreamArmourArt.CLOSE}
        options={['Close']}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, DreamArmourArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, DreamArmourArt.CLOSE)}
      />

      <layer x={Layout.oldClose.x} y={Layout.oldClose.y} w={Layout.oldClose.w} h={Layout.oldClose.h} hide />
    </>
  );
}
