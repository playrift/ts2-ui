import { useInventory } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { DreamArmourColor, DreamArmourInv, Grid } from './dream-armour.constants';

export function DreamBankGrid(): Component {
  const bank = useInventory(DreamArmourInv.BANK);

  return (
    <layer w="fill" h="fill">
      {bank.map(
        (item, slot) =>
          item !== -1 && (
            <sprite
              x={Grid.X0 + (slot % Grid.COLUMNS) * Grid.DX}
              y={Grid.Y0 + (slot / Grid.COLUMNS) * Grid.DY}
              w={Grid.SLOT_W}
              h={Grid.SLOT_H}
              item={item}
              itemCount={bank.count(slot)}
              outline={1}
              shadowColor={DreamArmourColor.ITEM_SHADOW}
              options={['Withdraw']}
              optionSubject={itemName(item)}
            />
          ),
      )}
    </layer>
  );
}
