import { useInventory } from 'ts2';

import { ChestSlots, DreamArmourInv, Layout } from './dream-armour.constants';

export function DreamChestIcons(): Component {
  const crate = useInventory(DreamArmourInv.CRATE);

  return (
    <layer w="fill" h="fill">
      {ChestSlots.map((slot, index) => (
        <sprite
          x={slot.iconX}
          y={slot.iconY}
          w={Layout.ICON}
          h={Layout.ICON}
          sprite={crate[index] !== -1 ? -1 : slot.icon}
        />
      ))}
    </layer>
  );
}
