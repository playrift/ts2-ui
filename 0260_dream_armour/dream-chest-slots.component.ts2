import { useInventory } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { ChestSlots, DreamArmourColor, DreamArmourInv, Grid } from './dream-armour.constants';

export function DreamChestSlots(): Component {
  const crate = useInventory(DreamArmourInv.CRATE);

  return (
    <layer w="fill" h="fill">
      {ChestSlots.map(
        (slot, index) =>
          crate[index] !== -1 && (
            <sprite
              x={slot.x}
              y={slot.y}
              w={Grid.SLOT_W}
              h={Grid.SLOT_H}
              item={crate[index]}
              itemCount={crate.count(index)}
              outline={1}
              shadowColor={DreamArmourColor.ITEM_SHADOW}
              options={['Deposit']}
              optionSubject={itemName(crate[index])}
            />
          ),
      )}
    </layer>
  );
}
