import { PipeArt, PipeConnections, PipeModel } from './elem-magicpress-pipes.constants';

export function ElemMagicpressPipes(): Component {
  return (
    <>
      <model x={222} y={147} w={32} h={32} model={PipeModel.BASE_PLATE} zoom={400} pitch={519} />

      <layer x={344} y={36} w={130} h={81}>
        <model x={57} y={26} w={32} h={32} model={PipeModel.SPARE_1} zoom={528} pitch={517} yaw={624} />
      </layer>

      <layer x={343} y={126} w={125} h={78}>
        <model x={48} y={23} w={32} h={32} model={PipeModel.SPARE_2} zoom={528} pitch={517} yaw={645} />
      </layer>

      <layer x={349} y={217} w={118} h={65}>
        <model x={40} y={9} w={32} h={32} model={PipeModel.SPARE_3} zoom={528} pitch={517} />
      </layer>

      {PipeConnections.map((pipe) => (
        <layer x={0} y={0} w={pipe.lw} h={pipe.lh} hide>
          <model x={pipe.x} y={pipe.y} w={32} h={32} model={pipe.model} zoom={pipe.zoom} pitch={517} />
        </layer>
      ))}

      <model x={249} y={37} w={57} h={47} model={PipeModel.INLET_UPPER} zoom={400} pitch={519} />

      <model x={37} y={240} w={59} h={42} model={PipeModel.INLET_LOWER} zoom={400} pitch={517} />
      <model x={140} y={239} w={58} h={45} model={PipeModel.INLET_LOWER} zoom={400} pitch={517} />
      <model x={249} y={239} w={56} h={45} model={PipeModel.INLET_LOWER} zoom={400} pitch={517} />

      <model x={35} y={37} w={61} h={47} model={PipeModel.INLET_UPPER} zoom={400} pitch={512} />
      <model x={141} y={36} w={57} h={48} model={PipeModel.INLET_UPPER} zoom={400} pitch={512} />

      <model x={220} y={145} w={36} h={36} model={PipeModel.BACKGROUND} zoom={442} pitch={517} />

      <sprite x={475} y={6} w={26} h={23} sprite={PipeArt.CLOSE} />

      <layer x={472} y={2} w={32} h={32} hide>
        <sprite x={3} y={4} w={26} h={23} sprite={PipeArt.CLOSE_HOVER} />
      </layer>
    </>
  );
}
