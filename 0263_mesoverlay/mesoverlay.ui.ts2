import { createRef } from 'ts2';
import { Mesoverlay } from './mesoverlay.component';
import { Layout } from './mesoverlay.constants';

const mesoverlayRef = createRef('mesoverlay');

export const mesoverlayUi = (): UI => (
  <ui ref={mesoverlayRef} w={Layout.ROOT_W} h={Layout.ROOT_H} x="center" y="center">
    <Mesoverlay />
  </ui>
);
