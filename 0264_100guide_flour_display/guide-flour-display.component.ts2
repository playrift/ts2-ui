import { graphicSwapperUnlessMobile, opsound } from '../lib/lib.helpers';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  CONTINUE_OPSOUND_MASK,
  GuideAnim,
  GuideArt,
  GuideColor,
  GuideModel,
  GuideWash,
  Layout,
} from './guide-flour-display.constants';

const Markers = [
  { x: 27, y: 256, anim: GuideAnim.UP },
  { x: 149, y: 256, anim: GuideAnim.UP },
  { x: 271, y: 256, anim: GuideAnim.UP },
  { x: 394, y: 256, anim: GuideAnim.UP },
  { x: 333, y: 152, anim: GuideAnim.DOWN },
  { x: 456, y: 152, anim: GuideAnim.DOWN },
  { x: 89, y: 152, anim: GuideAnim.DOWN },
  { x: 211, y: 152, anim: GuideAnim.DOWN },
];

const Stripes = [
  { x: -50, color: GuideColor.STRIPE_BLUE },
  { x: 11, color: GuideColor.STRIPE_OLIVE },
  { x: 72, color: GuideColor.STRIPE_BLUE },
  { x: 133, color: GuideColor.STRIPE_OLIVE },
  { x: 194, color: GuideColor.STRIPE_BLUE },
  { x: 255, color: GuideColor.STRIPE_OLIVE },
  { x: 316, color: GuideColor.STRIPE_BLUE },
  { x: 377, color: GuideColor.STRIPE_OLIVE },
  { x: 438, color: GuideColor.STRIPE_BLUE },
  { x: 499, color: GuideColor.STRIPE_OLIVE },
];

export function GuideFlourDisplay(): Component {
  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={GuideArt.BACKDROP} tiling />

      {Markers.map((marker) => (
        <model
          x={marker.x}
          y={marker.y}
          w={Layout.MARKER}
          h={Layout.MARKER}
          model={GuideModel.ARROW}
          anim={marker.anim}
          zoom={Layout.MARKER_ZOOM}
        />
      ))}

      {Stripes.map((stripe) => (
        <rect
          x={stripe.x}
          y="center"
          w={Layout.STRIPE_W}
          h="fill"
          color={stripe.color}
          fill
          transparency={GuideWash.STRIPE}
        />
      ))}

      <rect
        x={{ center: Layout.SHADOW_DX }}
        y={{ center: Layout.SHADOW_DY }}
        w={Layout.BOX_W}
        h={Layout.BOX_H}
        color={GuideColor.SHADOW}
        fill
        transparency={GuideWash.SHADOW}
      />

      <layer x="center" y="center" w={Layout.BOX_W} h={Layout.BOX_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BOX_BACKING_INSET }}
          h={{ fill: Layout.BOX_BACKING_INSET }}
          sprite={GuideArt.BOX_BACKING}
          tiling
        />

        <layer x="center" y="center" w={{ fill: Layout.BOX_INSET }} h={{ fill: Layout.BOX_INSET }} />

        <SteelFrameEntrypoint />
      </layer>

      <sprite
        x={{ right: Layout.CONTINUE_RIGHT }}
        y={Layout.CONTINUE_TOP}
        w={Layout.CONTINUE_W}
        h={Layout.CONTINUE_H}
        sprite={GuideArt.CONTINUE}
        options={['Continue']}
        onOptionSelect={(event) => opsound(event.option, CONTINUE_OPSOUND_MASK)}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, GuideArt.CONTINUE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, GuideArt.CONTINUE)}
      />

      <ThinBoxEntrypoint />
    </>
  );
}
