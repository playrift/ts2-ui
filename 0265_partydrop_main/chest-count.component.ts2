import { useInventory } from 'ts2';
import { Chest, PartyDropColors, PartyDropFonts, PartyDropInventories } from './partydrop-main.constants';

export function ChestCount(): Component {
  const chest = useInventory(PartyDropInventories.CHEST);

  let occupied: Int = 0;
  let slot: Int = 0;
  while (slot < Chest.SLOTS) {
    if (chest[slot] !== -1) {
      occupied = occupied + 1;
    }
    slot = slot + 1;
  }

  return (
    <text
      w="fill"
      h="fill"
      text={stringOf(occupied)}
      font={PartyDropFonts.LABEL}
      color={PartyDropColors.ORANGE}
      shadow
      align="center"
      valign="top"
    />
  );
}
