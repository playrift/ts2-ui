import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ChestCount } from './chest-count.component';
import { ChestPane } from './chest-pane.component';
import { ConfirmButton } from './confirm-button.component';
import { OfferSlots } from './offer-slots.component';
import { QuantityButton } from './quantity-button.component';
import {
  CHEST_TOTAL,
  CONFIRM_WARNING,
  Layout,
  PANEL_TITLE,
  PartyDropArt,
  PartyDropColors,
  PartyDropFonts,
  Quantity,
} from './partydrop-main.constants';

export function PartydropMain(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={PANEL_TITLE} />

      <ChestCount x={Layout.COUNT_X} y={Layout.COUNT_Y} w={Layout.COUNT_W} h={Layout.COUNT_H} />

      <line x={Layout.RULE_X} y={Layout.RULE_Y} w={Layout.RULE_W} color={PartyDropColors.ORANGE} lineWidth={1} />

      <layer x={Layout.COUNT_X} y={Layout.COUNT_Y} w={Layout.COUNT_W} h={Layout.COUNT_H} noClickThrough>
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={CHEST_TOTAL}
          font={PartyDropFonts.LABEL}
          color={PartyDropColors.ORANGE}
          shadow
          align="center"
          valign="bottom"
        />
      </layer>

      <layer x={Layout.BOX_X} y={Layout.BOX_Y} w={{ fill: Layout.BOX_INSET_W }} h={{ fill: Layout.BOX_INSET_H }}>
        <ChestPane />

        <ThinBoxEntrypoint />
      </layer>

      <layer
        x={{ right: Layout.QUANTITY_RIGHT }}
        y={Layout.QUANTITY_Y}
        w={Layout.QUANTITY_W}
        h={{ fill: Layout.QUANTITY_INSET_H }}
      >
        <QuantityButton label="1" mode={Quantity.ONE} dy={Quantity.ONE_DY} />
        <QuantityButton label="5" mode={Quantity.FIVE} dy={Quantity.FIVE_DY} />
        <QuantityButton label="X" mode={Quantity.X} dy={Quantity.X_DY} />
        <QuantityButton label="All" mode={Quantity.ALL} dy={Quantity.ALL_DY} />
      </layer>

      <layer x="center" y="bottom" w="fill" h={Layout.FOOTER_H}>
        <sprite
          x="center"
          y={Layout.STRIP_Y}
          w={{ fill: Layout.STRIP_INSET_W }}
          h={Layout.STRIP_H}
          sprite={PartyDropArt.FOOTER_STRIP}
          tiling
        />

        <text
          x="center"
          y={{ bottom: Layout.WARNING_Y }}
          w="fill"
          h={Layout.WARNING_H}
          text={CONFIRM_WARNING}
          font={PartyDropFonts.LABEL}
          color={PartyDropColors.WARNING}
          shadow
          align="center"
          valign="bottom"
        />

        <layer x={Layout.OFFER_X} y={{ center: Layout.OFFER_DY }} w={{ fill: Layout.OFFER_INSET_W }} h={Layout.OFFER_H}>
          <OfferSlots />
        </layer>

        <ConfirmButton />
      </layer>
    </>
  );
}
