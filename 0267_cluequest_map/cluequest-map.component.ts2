import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Borders, Camera, Layout, MapArt, MapModel, Trees } from './cluequest-map.constants';

export function CluequestMap(): Component {
  return (
    <>
      <model
        x={Layout.BACKGROUND_X}
        y={Layout.BACKGROUND_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MapModel.BACKGROUND}
        zoom={Camera.BACKGROUND.ZOOM}
        pitch={Camera.BACKGROUND.PITCH}
        yaw={Camera.BACKGROUND.YAW}
      />

      {Borders.map((border) => (
        <model
          x={border.x}
          y={border.y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={MapModel.BORDER}
          zoom={Camera.BORDER_ZOOM}
          pitch={border.pitch}
          yaw={border.yaw}
        />
      ))}

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MapArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, MapArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, MapArt.CLOSE);
        }}
      />

      <sprite x={Layout.MAP_X} y={Layout.MAP_Y} w={Layout.MAP_W} h={Layout.MAP_H} sprite={MapArt.PARCHMENT} />

      {Trees.map((tree) => (
        <model
          x={tree.x}
          y={tree.y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={MapModel.TREE}
          zoom={Camera.TREE.ZOOM}
          pitch={Camera.TREE.PITCH}
          yaw={Camera.TREE.YAW}
        />
      ))}

      <model
        x={Layout.CROSS_X}
        y={Layout.CROSS_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MapModel.CROSS}
        zoom={Camera.CROSS.ZOOM}
        pitch={Camera.CROSS.PITCH}
        yaw={Camera.CROSS.YAW}
      />
    </>
  );
}
