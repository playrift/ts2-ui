import { closeInterface } from '../lib/lib.helpers';
import { RedeemButton } from './redeem-button.component';
import { Layout, RedeemColors, RedeemFonts } from './f2p-bond-redeem.constants';

export function F2pBondRedeem(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <model
        x={Layout.MODEL_INSET}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        zoom={Layout.MODEL_ZOOM}
      />
      <model
        x={{ right: Layout.MODEL_INSET }}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        zoom={Layout.MODEL_ZOOM}
      />

      <text
        x="center"
        y={Layout.HEADLINE_Y}
        w={{ fill: Layout.HEADLINE_INSET }}
        h={Layout.HEADLINE_HEIGHT}
        font={RedeemFonts.HEADLINE}
        color={RedeemColors.LABEL}
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y={Layout.BODY_Y}
        w={Layout.BODY_WIDTH}
        h={Layout.BODY_HEIGHT}
        font={RedeemFonts.BODY}
        color={RedeemColors.LABEL}
        align="center"
        valign="middle"
        lineHeight={Layout.BODY_LINE_HEIGHT}
      />

      <RedeemButton
        label="Bond Pouch"
        x="center"
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <CloseLine />
    </layer>
  );
}

function CloseLine(): Component {
  return (
    <text
      x="center"
      y="bottom"
      w={Layout.CLOSE_WIDTH}
      h={Layout.CLOSE_HEIGHT}
      text="Close"
      font={RedeemFonts.CLOSE}
      color={RedeemColors.LABEL}
      align="center"
      valign="middle"
      options={['Close']}
      onOptionSelect={() => {
        closeInterface();
      }}
      onMouseRepeat={(event) => {
        event.self.color = RedeemColors.CLOSE_HOVER;
      }}
      onMouseLeave={(event) => {
        event.self.color = RedeemColors.CLOSE_REST;
      }}
    />
  );
}
