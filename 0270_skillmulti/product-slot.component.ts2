import { Frame } from '../lib/frame.component';
import { SlotColors, SlotSkinIn, SlotSkinOut } from './skillmulti.constants';

export function ProductSlot({
  item,
  w,
  h,
  pressed = false,
}: {
  item: Item;
  w: Int;
  h: Int;
  pressed?: Boolean;
}): Component {
  const size: Int = (w < h ? w : h) - 10;

  return (
    <layer w={w} h={h}>
      {pressed ? (
        <>
          <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={SlotColors.PRESSED_FILL} fill />
          <Frame
            topLeft={SlotSkinIn.TOP_LEFT}
            topRight={SlotSkinIn.TOP_RIGHT}
            bottomLeft={SlotSkinIn.BOTTOM_LEFT}
            bottomRight={SlotSkinIn.BOTTOM_RIGHT}
            left={SlotSkinIn.LEFT}
            top={SlotSkinIn.TOP}
            right={SlotSkinIn.RIGHT}
            bottom={SlotSkinIn.BOTTOM}
          />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={SlotSkinOut.FILL} tiling />
          <Frame
            topLeft={SlotSkinOut.TOP_LEFT}
            topRight={SlotSkinOut.TOP_RIGHT}
            bottomLeft={SlotSkinOut.BOTTOM_LEFT}
            bottomRight={SlotSkinOut.BOTTOM_RIGHT}
            left={SlotSkinOut.LEFT}
            top={SlotSkinOut.TOP}
            right={SlotSkinOut.RIGHT}
            bottom={SlotSkinOut.BOTTOM}
          />
        </>
      )}

      <model x="center" y="center" w={size} h={size} item={item} itemCount={2147483647} />
    </layer>
  );
}
