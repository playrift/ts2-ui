import { useServerState } from 'ts2';
import { StorageButton } from './storage-button.component';
import { Layout, PrivateVarbits, StorageColors, StorageFonts } from './raids-storage-private.constants';

export function PrivateFooter(): Component {
  const inDungeon: Int = useServerState(PrivateVarbits.IN_DUNGEON);

  return (
    <>
      <layer x={{ right: Layout.BUTTON_X }} y={{ bottom: Layout.BUTTON_Y }} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
        <StorageButton label={inDungeon === 1 ? 'Deposit all' : 'Bank all'} font={StorageFonts.BODY} />
      </layer>

      <text
        x="center"
        y={{ bottom: Layout.WARNING_Y }}
        w={{ fill: Layout.WARNING_W_INSET }}
        h={Layout.WARNING_H}
        text={
          inDungeon === 1
            ? 'Items stored here <col=ff0000>cannot</col> be taken by other players.<br>' +
              'Any <col=ff0000>non-raiding</col> items left in here <col=ff0000>can</col> be retrieved outside.'
            : 'You must retrieve <col=ff0000>all your items</col> from the private storage<br>' +
              'before you can re-enter the Chambers of Xeric.'
        }
        font={StorageFonts.BODY}
        color={StorageColors.WHITE}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
