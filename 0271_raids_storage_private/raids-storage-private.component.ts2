import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { PrivateItems } from './private-items.component';
import { PrivateFooter } from './private-footer.component';
import { StorageButton } from './storage-button.component';
import { Layout, StorageColors, StorageFonts, StorageSprites } from './raids-storage-private.constants';

export function RaidsStoragePrivate(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Private storage" />

      <PrivateItems />

      <line
        x={Layout.RULE_X}
        y={Layout.RULE_Y}
        w={Layout.RULE_W}
        color={StorageColors.LABEL}
        lineWidth={Layout.RULE_WIDTH}
      />

      <text
        x={Layout.COUNT_X}
        y={Layout.COUNT_Y}
        w={Layout.COUNT_W}
        h={Layout.COUNT_H}
        text=""
        font={StorageFonts.SMALL}
        color={StorageColors.LABEL}
        shadow
        align="center"
        valign="bottom"
      />

      <layer x={Layout.TAB_X} y={Layout.TAB_Y} w={Layout.TAB_W} h={Layout.TAB_H}>
        <StorageButton label="Shared" font={StorageFonts.SMALL} />
      </layer>

      <sprite
        x="center"
        y={Layout.DIVIDER_Y}
        w={{ fill: Layout.DIVIDER_W_INSET }}
        h={Layout.DIVIDER_H}
        sprite={StorageSprites.DIVIDER}
        tiling
      />

      <layer x={Layout.BUTTON_X} y={{ bottom: Layout.BUTTON_Y }} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
        <StorageButton label="Withdraw all" font={StorageFonts.BODY} />
      </layer>

      <PrivateFooter />
    </>
  );
}
