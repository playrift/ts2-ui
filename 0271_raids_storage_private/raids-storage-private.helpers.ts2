import { DragScroll, Grid } from './raids-storage-private.constants';

export function dragScroll(pane: Ref, mouseY: Int): void {
  let step: Int = DragScroll.STEP;
  let offset: Int = pane.scrollY;

  if (mouseY - offset < DragScroll.TOP_BAND) {
    if (mouseY < DragScroll.TOP_URGENT) {
      step = DragScroll.STEP_NEAR;
    }
    if (offset > step) {
      offset = offset - step;
    } else {
      offset = 0;
    }
    pane.scrollY = offset;
    return;
  }

  const room: Int = pane.height - Grid.H - mouseY;
  if (room < DragScroll.BOTTOM_BAND) {
    if (room < DragScroll.BOTTOM_PAST) {
      step = DragScroll.STEP_PAST;
    } else if (room < DragScroll.BOTTOM_NEAR) {
      step = DragScroll.STEP_NEAR;
    }
    pane.scrollY = offset + step;
  }
}
