import { useInterval, useRef, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { PRESS_CYCLES, StorageColors, StorageSounds } from './raids-storage-private.constants';

export function StorageButton({ label, font }: { label: String; font: Font }): Component {
  const timerHost = useRef();

  useInterval(() => {
    if (clientClock() < pressedUntil) {
      return;
    }
    setPressedUntil(0);
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);

  if (pressedUntil !== 0) {
    return (
      <layer w="fill" h="fill" ref={timerHost}>
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="---"
          font={font}
          color={StorageColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(StorageSounds.SELECT);
        setPressedUntil(clientClock() + PRESS_CYCLES);
      }}
    >
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={font}
        color={StorageColors.LABEL}
        hover={{ color: StorageColors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
