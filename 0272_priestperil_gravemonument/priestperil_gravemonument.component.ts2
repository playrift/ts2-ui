import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import {
  GraveColors,
  GraveFonts,
  GraveLayout,
  GraveModels,
  MonumentCamera,
  PlaqueInteraction,
  PlaqueStripCamera,
  TableModelCamera,
} from './priestperil_gravemonument.constants';

export function PriestperilGravemonument(): Component {
  return (
    <layer x="center" y={0} w={{ fill: GraveLayout.ROOT_INSET }} h="fill">
      <SteelBorderEntrypoint title="Grave Monument" />

      <layer x="center" y={{ bottom: GraveLayout.CONTENTS_BOTTOM }} w="fill" h={{ fill: GraveLayout.CONTENTS_INSET_H }}>
        <layer x="center" y={0} w="fill" h={GraveLayout.PLAQUE_H}>
          <model
            x="center"
            y="bottom"
            w="fill"
            h={GraveLayout.PLAQUE_MODEL_H}
            model={GraveModels.PLAQUE}
            zoom={PlaqueStripCamera.ZOOM}
            offsetY={PlaqueStripCamera.OFFSET_Y}
            spellTargets={['object', 'player']}
            interactionDepth={PlaqueInteraction.DEPTH}
          />
        </layer>

        <layer x={0} y="bottom" w="fill" h={{ fill: GraveLayout.TABLE_INSET_H }}>
          <model
            x="center"
            y="bottom"
            w={GraveLayout.TABLE_MODEL}
            h={GraveLayout.TABLE_MODEL}
            model={GraveModels.PLAQUE}
            zoom={TableModelCamera.ZOOM}
            pitch={TableModelCamera.PITCH}
            yaw={TableModelCamera.YAW}
            offsetY={TableModelCamera.OFFSET_Y}
          />
        </layer>

        <text
          x="center"
          y={GraveLayout.TEXT_Y}
          w={GraveLayout.TEXT_W}
          h={GraveLayout.TEXT_H}
          text="Saradomin<br><br>lights my way<br><br>through<br><br>the darkness of life"
          font={GraveFonts.ENGRAVING}
          color={GraveColors.ENGRAVING}
          align="center"
          valign="middle"
        />

        <model
          x="center"
          y={{ center: GraveLayout.MONUMENT_DY }}
          w={GraveLayout.MONUMENT_SIZE}
          h={GraveLayout.MONUMENT_SIZE}
          model={GraveModels.MONUMENT}
          zoom={MonumentCamera.ZOOM}
          pitch={MonumentCamera.PITCH}
        />
      </layer>
    </layer>
  );
}
