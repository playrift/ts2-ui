import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { BalloonSpin, INFO_TEXT, Layout, PeteArt, PeteColor, PeteFonts, PeteModel } from './prisonpete.constants';
import { spinModel } from './prisonpete.helpers';

export function Prisonpete(): Component {
  return (
    <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <model
        x={Layout.BARS_X}
        y={Layout.BARS_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={PeteModel.PRISON_BARS}
        zoom={Layout.BARS_ZOOM}
      />

      <text
        x={Layout.INFO_X}
        y={Layout.INFO_Y}
        w={Layout.INFO_W}
        h={Layout.INFO_H}
        font={PeteFonts.INFO}
        color={PeteColor.INFO}
        align="center"
        shadow
        text={INFO_TEXT}
      />

      <layer x={0} y={0} w={Layout.BALLOON_W} h={Layout.BALLOON_H}>
        <model
          x={{ center: Layout.BALLOON1_DX }}
          y={{ center: Layout.BALLOON1_DY }}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={PeteModel.BALLOON}
          zoom={Layout.BALLOON1_ZOOM}
          pitch={Layout.BALLOON1_PITCH}
          yaw={Layout.BALLOON1_YAW}
          onTimer={(event) =>
            spinModel(
              event.component,
              BalloonSpin.OFFSET_X,
              BalloonSpin.OFFSET_Y,
              BalloonSpin.D_PITCH,
              BalloonSpin.D_YAW,
              BalloonSpin.D_ROLL,
            )
          }
        />
      </layer>

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PeteArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, PeteArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, PeteArt.CLOSE)}
      />
    </layer>
  );
}
