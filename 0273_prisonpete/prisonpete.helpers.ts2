import { CS2 } from 'ts2';

export enum Turn {
  FULL = 2048,
}

export function spinModel(model: ComponentId, offsetX: Int, offsetY: Int, dPitch: Int, dYaw: Int, dRoll: Int): void {
  let pitch: Int = (CS2.if_model_angle_x_get(model) + dPitch) % Turn.FULL;
  if (pitch < 0) {
    pitch = pitch + Turn.FULL;
  }
  let yaw: Int = (CS2.if_model_angle_y_get(model) + dYaw) % Turn.FULL;
  if (yaw < 0) {
    yaw = yaw + Turn.FULL;
  }
  let roll: Int = (CS2.if_model_angle_z_get(model) + dRoll) % Turn.FULL;
  if (roll < 0) {
    roll = roll + Turn.FULL;
  }

  CS2.if_model_angle_set(offsetX, offsetY, pitch, yaw, roll, CS2.if_model_zoom_get(model), model);
}
