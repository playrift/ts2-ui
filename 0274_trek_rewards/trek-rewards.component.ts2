import { predictServerState, useRef, useServerState, useUniverse } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import {
  Fade,
  Grid,
  Layout,
  Outline,
  RewardItems,
  RewardNames,
  TrekColors,
  TrekFonts,
  TrekVarbits,
} from './trek-rewards.constants';

export function TrekRewards(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_INSET_W }} h={{ fill: Layout.ROOT_INSET_H }}>
      <SteelBorderEntrypoint title="Temple Trekking Rewards" />

      <layer x="center" y={Layout.BODY_Y} w={{ fill: Layout.BODY_INSET_W }} h={{ fill: Layout.BODY_INSET_H }}>
        <line
          x={{ right: Layout.DIVIDER_RIGHT }}
          y={0}
          w={0}
          h="fill"
          color={TrekColors.DIVIDER}
          lineWidth={Layout.DIVIDER_WIDTH}
        />

        <layer x={0} y={0} w={{ fill: Layout.CHOOSER_INSET_W }} h="fill">
          <RewardChooser />
        </layer>

        <layer x="right" y={0} w={Layout.DETAIL_W} h="fill">
          <RewardDetails />
        </layer>
      </layer>
    </layer>
  );
}

export function RewardChooser(): Component {
  const selected: Int = useServerState(TrekVarbits.SELECTED);

  const universe = useUniverse();
  const iconInset: Int = (universe.width / Grid.COLUMNS - Grid.ICON_W) / 2;
  const stride: Int = iconInset * 2 + Grid.ICON_W;
  const labelInset: Int = iconInset - Grid.LABEL_OVERHANG;

  const iconX0: Int = iconInset;
  const iconX1: Int = iconInset + stride;
  const iconX2: Int = iconInset + stride * 2;
  const labelX0: Int = labelInset;
  const labelX1: Int = labelInset + stride;
  const labelX2: Int = labelInset + stride * 2;

  const rowY0: Int = Grid.ROW0_Y;
  const rowY1: Int = Grid.ROW0_Y + Grid.ROW_PITCH;
  const rowY2: Int = Grid.ROW0_Y + Grid.ROW_PITCH * 2;

  const label0 = useRef();
  const label1 = useRef();
  const label2 = useRef();
  const label3 = useRef();
  const label4 = useRef();
  const label5 = useRef();
  const label6 = useRef();
  const label7 = useRef();
  const label8 = useRef();

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <text
          ref={label0}
          x={labelX0}
          y={rowY0}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(0)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label1}
          x={labelX1}
          y={rowY0}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(1)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label2}
          x={labelX2}
          y={rowY0}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(2)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label3}
          x={labelX0}
          y={rowY1}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(3)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label4}
          x={labelX1}
          y={rowY1}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(4)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label5}
          x={labelX2}
          y={rowY1}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(5)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label6}
          x={labelX0}
          y={rowY2}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(6)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label7}
          x={labelX1}
          y={rowY2}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(7)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
        <text
          ref={label8}
          x={labelX2}
          y={rowY2}
          w={Grid.LABEL_W}
          h={Grid.LABEL_H}
          text={RewardNames.at(8)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          align="center"
          valign="bottom"
        />
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <sprite
          x={iconX0}
          y={rowY0}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(0)}
          itemCount={-1}
          outline={selected === 0 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 0);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label0.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label0.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX1}
          y={rowY0}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(1)}
          itemCount={-1}
          outline={selected === 1 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 1);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label1.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label1.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX2}
          y={rowY0}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(2)}
          itemCount={-1}
          outline={selected === 2 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 2);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label2.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label2.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX0}
          y={rowY1}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(3)}
          itemCount={-1}
          outline={selected === 3 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 3);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label3.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label3.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX1}
          y={rowY1}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(4)}
          itemCount={-1}
          outline={selected === 4 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 4);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label4.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label4.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX2}
          y={rowY1}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(5)}
          itemCount={-1}
          outline={selected === 5 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 5);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label5.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label5.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX0}
          y={rowY2}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(6)}
          itemCount={-1}
          outline={selected === 6 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 6);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label6.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label6.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX1}
          y={rowY2}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(7)}
          itemCount={-1}
          outline={selected === 7 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 7);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label7.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label7.color = TrekColors.TEXT;
          }}
        />
        <sprite
          x={iconX2}
          y={rowY2}
          w={Grid.ICON_W}
          h={Grid.ICON_H}
          item={RewardItems.at(8)}
          itemCount={-1}
          outline={selected === 8 ? Outline.SELECTED : Outline.REST}
          options={['Details']}
          onOptionSelect={() => {
            predictServerState(TrekVarbits.SELECTED, 8);
          }}
          onMouseEnter={(event) => {
            event.self.transparency = Fade.ICON_HOVER;
            label8.color = TrekColors.LABEL_HOVER;
          }}
          onMouseLeave={(event) => {
            event.self.transparency = Fade.ICON_REST;
            label8.color = TrekColors.TEXT;
          }}
        />
      </layer>
    </>
  );
}

export function RewardDetails(): Component {
  const selected: Int = useServerState(TrekVarbits.SELECTED);

  const pressed = useRef();

  return (
    <>
      <text
        x="center"
        y={Layout.TITLE_Y}
        w={{ fill: Layout.TITLE_INSET_W }}
        h={Layout.TITLE_H}
        hide={nothingSelected(selected)}
        text={RewardNames.at(selected) ?? ''}
        font={TrekFonts.TITLE}
        color={TrekColors.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      <text
        x="center"
        y={Layout.DESC_Y}
        w={{ fill: Layout.DESC_INSET_W }}
        h={{ fill: Layout.DESC_INSET_H }}
        text={rewardDescription(selected)}
        font={TrekFonts.BODY}
        color={TrekColors.TEXT}
        shadow
        align="center"
        valign="middle"
        lineHeight={Layout.DESC_LINE_HEIGHT}
      />

      <layer
        x="center"
        y={{ bottom: Layout.CLAIM_BOTTOM }}
        w={{ fill: Layout.CLAIM_INSET_W }}
        h={Layout.CLAIM_H}
        hide={nothingSelected(selected)}
      >
        <layer
          w="fill"
          h="fill"
          options={['Claim']}
          onMouseEnter={() => {
            pressed.hide = false;
          }}
          onMouseLeave={() => {
            pressed.hide = true;
          }}
        >
          <StoneButtonEntrypoint />
          <layer ref={pressed} hide w="fill" h="fill">
            <StoneButtonPressedEntrypoint />
          </layer>
        </layer>

        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="Claim"
          font={TrekFonts.TITLE}
          color={TrekColors.TEXT}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}

function nothingSelected(selected: Int): Boolean {
  if (selected >= Grid.REWARDS) {
    return true;
  }
  return false;
}

export function rewardDescription(selected: Int): String {
  if (selected === 0) {
    return 'Blue token:<br>50-150 essence<br><br>Yellow token:<br>120-380 essence<br><br>Red token:<br>370-660 essence';
  }
  if (selected === 1) {
    return 'Blue token:<br>100-200 bow strings<br><br>Yellow token:<br>150-250 bow strings<br><br>Red token:<br>200-300 bow strings';
  }
  if (selected === 2) {
    return 'Blue token:<br>5-50 silver bars<br><br>Yellow token:<br>50-100 silver bars<br><br>Red token:<br>100-150 silver bars';
  }
  if (selected === 3) {
    return 'Blue token:<br>5-15 herbs<br><br>Yellow token:<br>10-20 herbs<br><br>Red token:<br>15-30 herbs';
  }
  if (selected === 4) {
    return 'Blue token:<br>21-72 coal and iron ores<br><br>Yellow token:<br>66-165 coal and iron ores<br><br>Red token:<br>150-216 coal and iron ores';
  }
  if (selected === 5) {
    return 'Blue token:<br>10-20 watermelon seeds<br><br>Yellow token:<br>15-30 watermelon seeds<br><br>Red token:<br>20-40 watermelon seeds';
  }
  if (selected === 6) {
    return 'Blue token:<br>2-35 raw lobsters<br><br>Yellow token:<br>30-65 raw lobsters<br><br>Red token:<br>60-80 raw lobsters';
  }
  if (selected === 7) {
    return 'Blue token:<br>1100-1650 XP tome<br><br>Yellow token:<br>2035-3025 XP tome<br><br>Red token:<br>4015-5005 XP tome';
  }
  if (selected === 8) {
    return 'A random reward appropriate to the token colour.';
  }
  return 'Select a reward<br><br>on the left to<br><br>display information<br><br>here.';
}
