import { predictServerState, useServerState, useState, useUniverse, useWatch } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import {
  Fade,
  Grid,
  Layout,
  Outline,
  RewardItems,
  RewardNames,
  Shown,
  TrekColors,
  TrekFonts,
  TrekVarbits,
} from './trek-rewards.constants';

export function TrekRewards(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_INSET_W }} h={{ fill: Layout.ROOT_INSET_H }}>
      <SteelBorderEntrypoint title="Temple Trekking Rewards" />

      <layer x="center" y={Layout.BODY_Y} w={{ fill: Layout.BODY_INSET_W }} h={{ fill: Layout.BODY_INSET_H }}>
        <line
          x={{ right: Layout.DIVIDER_RIGHT }}
          y={0}
          w={0}
          h="fill"
          color={TrekColors.DIVIDER}
          lineWidth={Layout.DIVIDER_WIDTH}
        />

        <RewardPanes />
      </layer>
    </layer>
  );
}

export function RewardPanes(): Component {
  const selected: Int = useServerState(TrekVarbits.SELECTED);
  const [shown, setShown] = useState(Shown.NONE);
  const [hover0, setHover0] = useState(0);
  const [hover1, setHover1] = useState(0);
  const [hover2, setHover2] = useState(0);
  const [hover3, setHover3] = useState(0);
  const [hover4, setHover4] = useState(0);
  const [hover5, setHover5] = useState(0);
  const [hover6, setHover6] = useState(0);
  const [hover7, setHover7] = useState(0);
  const [hover8, setHover8] = useState(0);

  useWatch(TrekVarbits.SELECTED, () => {
    if (shown !== Shown.NONE) {
      setShown(paintOf(selected));
    }
  });

  const universe = useUniverse();
  const chooserW: Int = universe.width - Layout.CHOOSER_INSET_W;
  const iconInset: Int = (chooserW / Grid.COLUMNS - Grid.ICON_W) / 2;
  const stride: Int = iconInset * 2 + Grid.ICON_W;
  const labelInset: Int = iconInset - Grid.LABEL_OVERHANG;

  const iconX0: Int = iconInset;
  const iconX1: Int = iconInset + stride;
  const iconX2: Int = iconInset + stride * 2;
  const labelX0: Int = labelInset;
  const labelX1: Int = labelInset + stride;
  const labelX2: Int = labelInset + stride * 2;

  const rowY0: Int = Grid.ROW0_Y;
  const rowY1: Int = Grid.ROW0_Y + Grid.ROW_PITCH;
  const rowY2: Int = Grid.ROW0_Y + Grid.ROW_PITCH * 2;

  return (
    <>
      <layer x={0} y={0} w={{ fill: Layout.CHOOSER_INSET_W }} h="fill">
        <layer x="center" y="center" w="fill" h="fill">
          <text
            x={labelX0}
            y={rowY0}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(0)}
            font={TrekFonts.BODY}
            color={labelColor(hover0)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX1}
            y={rowY0}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(1)}
            font={TrekFonts.BODY}
            color={labelColor(hover1)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX2}
            y={rowY0}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(2)}
            font={TrekFonts.BODY}
            color={labelColor(hover2)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX0}
            y={rowY1}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(3)}
            font={TrekFonts.BODY}
            color={labelColor(hover3)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX1}
            y={rowY1}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(4)}
            font={TrekFonts.BODY}
            color={labelColor(hover4)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX2}
            y={rowY1}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(5)}
            font={TrekFonts.BODY}
            color={labelColor(hover5)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX0}
            y={rowY2}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(6)}
            font={TrekFonts.BODY}
            color={labelColor(hover6)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX1}
            y={rowY2}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(7)}
            font={TrekFonts.BODY}
            color={labelColor(hover7)}
            align="center"
            valign="bottom"
          />
          <text
            x={labelX2}
            y={rowY2}
            w={Grid.LABEL_W}
            h={Grid.LABEL_H}
            text={RewardNames.at(8)}
            font={TrekFonts.BODY}
            color={labelColor(hover8)}
            align="center"
            valign="bottom"
          />
        </layer>

        <layer x="center" y="center" w="fill" h="fill">
          <sprite
            x={iconX0}
            y={rowY0}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(0)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 0)}
            transparency={iconFade(hover0)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 0);
              setShown(0);
            }}
            onMouseEnter={() => {
              setHover0(1);
            }}
            onMouseLeave={() => {
              setHover0(0);
            }}
          />
          <sprite
            x={iconX1}
            y={rowY0}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(1)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 1)}
            transparency={iconFade(hover1)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 1);
              setShown(1);
            }}
            onMouseEnter={() => {
              setHover1(1);
            }}
            onMouseLeave={() => {
              setHover1(0);
            }}
          />
          <sprite
            x={iconX2}
            y={rowY0}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(2)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 2)}
            transparency={iconFade(hover2)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 2);
              setShown(2);
            }}
            onMouseEnter={() => {
              setHover2(1);
            }}
            onMouseLeave={() => {
              setHover2(0);
            }}
          />
          <sprite
            x={iconX0}
            y={rowY1}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(3)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 3)}
            transparency={iconFade(hover3)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 3);
              setShown(3);
            }}
            onMouseEnter={() => {
              setHover3(1);
            }}
            onMouseLeave={() => {
              setHover3(0);
            }}
          />
          <sprite
            x={iconX1}
            y={rowY1}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(4)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 4)}
            transparency={iconFade(hover4)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 4);
              setShown(4);
            }}
            onMouseEnter={() => {
              setHover4(1);
            }}
            onMouseLeave={() => {
              setHover4(0);
            }}
          />
          <sprite
            x={iconX2}
            y={rowY1}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(5)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 5)}
            transparency={iconFade(hover5)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 5);
              setShown(5);
            }}
            onMouseEnter={() => {
              setHover5(1);
            }}
            onMouseLeave={() => {
              setHover5(0);
            }}
          />
          <sprite
            x={iconX0}
            y={rowY2}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(6)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 6)}
            transparency={iconFade(hover6)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 6);
              setShown(6);
            }}
            onMouseEnter={() => {
              setHover6(1);
            }}
            onMouseLeave={() => {
              setHover6(0);
            }}
          />
          <sprite
            x={iconX1}
            y={rowY2}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(7)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 7)}
            transparency={iconFade(hover7)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 7);
              setShown(7);
            }}
            onMouseEnter={() => {
              setHover7(1);
            }}
            onMouseLeave={() => {
              setHover7(0);
            }}
          />
          <sprite
            x={iconX2}
            y={rowY2}
            w={Grid.ICON_W}
            h={Grid.ICON_H}
            item={RewardItems.at(8)}
            itemCount={0}
            itemCountMode="never"
            outline={outlineOf(shown, 8)}
            transparency={iconFade(hover8)}
            options={['Details']}
            onOptionSelect={() => {
              predictServerState(TrekVarbits.SELECTED, 8);
              setShown(8);
            }}
            onMouseEnter={() => {
              setHover8(1);
            }}
            onMouseLeave={() => {
              setHover8(0);
            }}
          />
        </layer>
      </layer>

      <layer x="right" y={0} w={Layout.DETAIL_W} h="fill">
        <text
          x="center"
          y={Layout.TITLE_Y}
          w={{ fill: Layout.TITLE_INSET_W }}
          h={Layout.TITLE_H}
          hide={nothingShown(shown)}
          text={RewardNames.at(shown) ?? ''}
          font={TrekFonts.TITLE}
          color={TrekColors.TEXT}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x="center"
          y={Layout.DESC_Y}
          w={{ fill: Layout.DESC_INSET_W }}
          h={{ fill: Layout.DESC_INSET_H }}
          text={rewardDescription(shown)}
          font={TrekFonts.BODY}
          color={TrekColors.TEXT}
          shadow
          align="center"
          valign="middle"
          lineHeight={Layout.DESC_LINE_HEIGHT}
        />

        <layer
          x="center"
          y={{ bottom: Layout.CLAIM_BOTTOM }}
          w={{ fill: Layout.CLAIM_INSET_W }}
          h={Layout.CLAIM_H}
          hide={nothingShown(shown)}
        >
          <ClaimButton />

          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="Claim"
            font={TrekFonts.TITLE}
            color={TrekColors.TEXT}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>
    </>
  );
}

export function ClaimButton(): Component {
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      w="fill"
      h="fill"
      options={['Claim']}
      onMouseEnter={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
    >
      <StoneButtonEntrypoint />
      <layer hide={pressed === 0} w="fill" h="fill">
        <StoneButtonPressedEntrypoint />
      </layer>
    </layer>
  );
}

function paintOf(selected: Int): Int {
  if (selected >= Grid.REWARDS) {
    return Shown.NONE;
  }
  return selected;
}

function nothingShown(shown: Int): Boolean {
  return shown === Shown.NONE;
}

function outlineOf(shown: Int, index: Int): Int {
  if (shown === index) {
    return Outline.SELECTED;
  }
  return Outline.REST;
}

function iconFade(hovered: Int): Int {
  if (hovered !== 0) {
    return Fade.ICON_HOVER;
  }
  return Fade.ICON_REST;
}

function labelColor(hovered: Int): Int {
  if (hovered !== 0) {
    return TrekColors.LABEL_HOVER;
  }
  return TrekColors.TEXT;
}

export function rewardDescription(selected: Int): String {
  if (selected === 0) {
    return 'Blue token:<br>50-150 essence<br><br>Yellow token:<br>120-380 essence<br><br>Red token:<br>370-660 essence';
  }
  if (selected === 1) {
    return 'Blue token:<br>100-200 bow strings<br><br>Yellow token:<br>150-250 bow strings<br><br>Red token:<br>200-300 bow strings';
  }
  if (selected === 2) {
    return 'Blue token:<br>5-50 silver bars<br><br>Yellow token:<br>50-100 silver bars<br><br>Red token:<br>100-150 silver bars';
  }
  if (selected === 3) {
    return 'Blue token:<br>5-15 herbs<br><br>Yellow token:<br>10-20 herbs<br><br>Red token:<br>15-30 herbs';
  }
  if (selected === 4) {
    return 'Blue token:<br>21-72 coal and iron ores<br><br>Yellow token:<br>66-165 coal and iron ores<br><br>Red token:<br>150-216 coal and iron ores';
  }
  if (selected === 5) {
    return 'Blue token:<br>10-20 watermelon seeds<br><br>Yellow token:<br>15-30 watermelon seeds<br><br>Red token:<br>20-40 watermelon seeds';
  }
  if (selected === 6) {
    return 'Blue token:<br>2-35 raw lobsters<br><br>Yellow token:<br>30-65 raw lobsters<br><br>Red token:<br>60-80 raw lobsters';
  }
  if (selected === 7) {
    return 'Blue token:<br>1100-1650 XP tome<br><br>Yellow token:<br>2035-3025 XP tome<br><br>Red token:<br>4015-5005 XP tome';
  }
  if (selected === 8) {
    return 'A random reward appropriate to the token colour.';
  }
  return 'Select a reward<br><br>on the left to<br><br>display information<br><br>here.';
}
