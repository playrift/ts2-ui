import { useState } from 'ts2';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { BenefitColors, BenefitFonts } from './membership-benefits.constants';

export function BenefitButton({ label }: { label: String }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer w="fill" h="fill" options={[label]} onMouseRepeat={() => setPressed(1)} onMouseLeave={() => setPressed(0)}>
      {skin === 1 ? (
        <StoneButtonPressedFilled>
          <BenefitButtonLabel label={label} />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonOutFilled>
          <BenefitButtonLabel label={label} />
        </StoneButtonOutFilled>
      )}
    </layer>
  );
}

function BenefitButtonLabel({ label }: { label: String }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={BenefitFonts.BODY}
      color={BenefitColors.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}
