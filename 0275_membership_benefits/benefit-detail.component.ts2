import { useState } from 'ts2';
import { graphicSwapper } from '../lib/lib.helpers';
import { BenefitColors, BenefitFonts, BenefitSprites, Benefits, Layout, NONE } from './membership-benefits.constants';
import { closeBenefit, openBenefit } from './membership-benefits.state';

export function BenefitDetail(): Component {
  const [open] = useState(openBenefit);
  const shown: Int = open;

  return (
    <layer x={0} y={0} w="fill" h="fill" noClickThrough hide={shown === NONE ? true : false}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={BenefitSprites.BACKING} tiling />

      <sprite
        x={{ right: Layout.DETAIL_INSET }}
        y={Layout.DETAIL_INSET}
        w={Layout.CHEVRON_W}
        h={Layout.CHEVRON_H}
        sprite={BenefitSprites.CLOSE}
        options={['Close']}
        onMouseRepeat={(event) => graphicSwapper(event.self, BenefitSprites.CLOSE_LIT)}
        onMouseLeave={(event) => graphicSwapper(event.self, BenefitSprites.CLOSE)}
        onOptionSelect={() => closeBenefit()}
      />

      {Benefits.map((benefit, index) =>
        shown === index ? (
          <>
            <text
              x={{ center: Layout.DETAIL_TITLE_DX }}
              y={Layout.DETAIL_INSET}
              w="fill"
              h={Layout.ROW_H}
              text={benefit.title}
              font={BenefitFonts.TITLE}
              color={BenefitColors.LABEL}
              align="left"
              valign="middle"
              shadow
            />
            <sprite
              x={Layout.DETAIL_INSET}
              y={Layout.DETAIL_INSET}
              w={Layout.ICON_W}
              h={Layout.ICON_H}
              sprite={benefit.icon}
            />
            <text
              x={Layout.DETAIL_INSET}
              y={{ bottom: Layout.DETAIL_INSET }}
              w={{ fill: Layout.DETAIL_BODY_W_INSET }}
              h={Layout.DETAIL_BODY_H}
              text={benefit.body}
              font={BenefitFonts.BODY}
              color={BenefitColors.WHITE}
              align="center"
              valign="middle"
              shadow
            />
            <sprite
              x={{ right: Layout.DETAIL_INSET }}
              y={{ bottom: Layout.DETAIL_INSET }}
              w={Layout.DETAIL_IMAGE_W}
              h={Layout.DETAIL_IMAGE_H}
              sprite={benefit.image}
            />
          </>
        ) : null,
      )}
    </layer>
  );
}
