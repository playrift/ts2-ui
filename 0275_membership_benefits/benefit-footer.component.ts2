import { useServerState, useState } from 'ts2';
import { membersWorld } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { bondsHidden } from '../0589_displayname/displayname.helpers';
import { playermember } from '../lib/game/varcs';
import { BenefitButton } from './benefit-button.component';
import { BenefitVarbits, Layout } from './membership-benefits.constants';

export function BenefitFooter(): Component {
  const [member] = useState(playermember);
  const hasBonds: Int = useServerState(BenefitVarbits.HAS_BONDS);
  const mobile: Boolean = onMobile();
  const blocked: Boolean = bondsHidden();

  let storeLabel: String = 'Upgrade Now';
  if (membersWorld() || member === 1) {
    storeLabel = 'Open Store';
  }

  if (mobile && blocked && hasBonds === 0) {
    return (
      <layer w="fill" h="fill">
        <layer x="center" y="center" w={Layout.BUTTON_W} h="fill">
          <BenefitButton label={storeLabel} />
        </layer>
        <layer x="right" y={0} w={Layout.BUTTON_W} h="fill" hide />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill">
      <layer x={0} y={0} w={Layout.BUTTON_W} h="fill">
        <BenefitButton label={storeLabel} />
      </layer>
      <layer x="right" y={0} w={Layout.BUTTON_W} h="fill">
        <BenefitButton label="Bond Pouch" />
      </layer>
    </layer>
  );
}
