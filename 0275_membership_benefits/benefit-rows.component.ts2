import { useState } from 'ts2';
import { BenefitColors, BenefitFonts, BenefitSprites, Benefits, Layout, NONE } from './membership-benefits.constants';
import { hoverBenefit, hoveredBenefit, openBenefitRow } from './membership-benefits.state';

export function BenefitRows(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer x={0} y={0} w={Layout.ROWS_W} h={Layout.ROWS_H}>
        {Benefits.map((benefit, index) => (
          <sprite
            x="center"
            y={index * Layout.ROW_PITCH}
            w="fill"
            h={Layout.ROW_H}
            sprite={BenefitSprites.BACKING}
            tiling
            options={['View']}
            optionSubject="<col=ff9040>Benefits</col>"
            onOptionSelect={() => openBenefitRow(index)}
            onMouseRepeat={() => hoverBenefit(index)}
            onMouseLeave={() => hoverBenefit(NONE)}
          />
        ))}
      </layer>

      <BenefitHover x={0} y={0} w={Layout.ROWS_W} h={Layout.ROWS_H} />

      <layer x={0} y={0} w={Layout.ROWS_W} h={Layout.ROWS_H}>
        {Benefits.map((benefit, index) => (
          <text
            x={{ center: Layout.TITLE_DX }}
            y={index * Layout.ROW_PITCH}
            w="fill"
            h={Layout.ROW_H}
            text={benefit.title}
            font={BenefitFonts.TITLE}
            color={BenefitColors.LABEL}
            align="left"
            valign="middle"
            shadow
          />
        ))}
      </layer>

      <layer x={0} y={0} w={Layout.ICONS_W} h={Layout.ICONS_H}>
        {Benefits.map((benefit, index) => (
          <sprite
            x={Layout.ICON_X}
            y={index * Layout.ROW_PITCH}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={benefit.icon}
          />
        ))}
      </layer>

      <BenefitChevrons x={0} y={0} w={Layout.ICONS_W} h={Layout.ICONS_H} />
    </layer>
  );
}

function BenefitHover(): Component {
  const [hovered] = useState(hoveredBenefit);
  const lit: Int = hovered;

  return (
    <layer w="fill" h="fill">
      {Benefits.map((benefit, index) =>
        lit === index ? (
          <rect
            x={0}
            y={index * Layout.ROW_PITCH}
            w="fill"
            h={Layout.ROW_H}
            fill
            color={BenefitColors.WHITE}
            transparency={Layout.WASH_TRANSPARENCY}
          />
        ) : null,
      )}
    </layer>
  );
}

function BenefitChevrons(): Component {
  const [hovered] = useState(hoveredBenefit);
  const lit: Int = hovered;

  return (
    <layer w="fill" h="fill">
      {Benefits.map((benefit, index) => (
        <sprite
          x={{ right: Layout.CHEVRON_INSET }}
          y={index * Layout.ROW_PITCH + Layout.CHEVRON_INSET}
          w={Layout.CHEVRON_W}
          h={Layout.CHEVRON_H}
          sprite={lit === index ? BenefitSprites.OPEN_LIT : BenefitSprites.OPEN}
        />
      ))}
    </layer>
  );
}
