import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { BenefitDetail } from './benefit-detail.component';
import { BenefitFooter } from './benefit-footer.component';
import { BenefitRows } from './benefit-rows.component';
import { Layout } from './membership-benefits.constants';

export function MembershipBenefits(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <StoneBorderEntrypoint title="Membership Benefits" />

      <layer
        x="center"
        y={{ bottom: Layout.BODY_BOTTOM }}
        w={{ fill: Layout.BODY_W_INSET }}
        h={{ fill: Layout.BODY_H_INSET }}
      >
        <BenefitFooter x={0} y="bottom" w="fill" h={Layout.FOOTER_H} />

        <layer x={0} y={0} w="fill" h={{ fill: Layout.LIST_H_INSET }}>
          <BenefitRows x={0} y={0} w="fill" h="fill" />
          <BenefitDetail x={0} y={0} w="fill" h="fill" />
        </layer>
      </layer>
    </layer>
  );
}
