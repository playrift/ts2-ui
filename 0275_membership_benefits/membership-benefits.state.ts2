import { sessionState, useState } from 'ts2';

export const openBenefit = sessionState(-1);

export const hoveredBenefit = sessionState(-1);

export function hoverBenefit(row: Int): void {
  const [, setHovered] = useState(hoveredBenefit);
  setHovered(row);
}

export function openBenefitRow(row: Int): void {
  const [, setOpen] = useState(openBenefit);
  setOpen(row);
}

export function closeBenefit(): void {
  const [, setOpen] = useState(openBenefit);
  setOpen(-1);
}
