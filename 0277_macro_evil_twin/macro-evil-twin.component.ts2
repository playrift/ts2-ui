import { createRef } from 'ts2';
import { graphicSwapper } from '../lib/lib.helpers';
import { TWIN_GRAB_CONTENT_TYPE, TwinArt, TwinCamera, TwinLayout, TwinModels } from './macro-evil-twin.constants';

function modelSwapper(component: ComponentId, model: Model): void {
  component.model = model;
}

const joystick = createRef('grab_evil_twin_joystick');

export function MacroEvilTwin(): Component {
  return (
    <>
      <model
        x={TwinLayout.PANEL.X}
        y={TwinLayout.PANEL.Y}
        w={TwinLayout.PANEL.SIZE}
        h={TwinLayout.PANEL.SIZE}
        model={TwinModels.PANEL}
        zoom={TwinCamera.PANEL.ZOOM}
        pitch={TwinCamera.PANEL.PITCH}
      />

      <model
        x={TwinLayout.ARROWS.X}
        y={TwinLayout.ARROWS.Y}
        w={TwinLayout.ARROWS.SIZE}
        h={TwinLayout.ARROWS.SIZE}
        model={TwinModels.ARROWS}
        zoom={TwinCamera.ARROWS.ZOOM}
        pitch={TwinCamera.ARROWS.PITCH}
        yaw={TwinCamera.ARROWS.YAW}
      />

      <layer x={TwinLayout.GRAB.X} y={TwinLayout.GRAB.Y} w={TwinLayout.GRAB.W} h={TwinLayout.GRAB.H} options={['Grab']}>
        <model
          x="center"
          y="center"
          w={TwinLayout.GRAB_FACE.SIZE}
          h={TwinLayout.GRAB_FACE.SIZE}
          model={TwinModels.GRAB}
          zoom={TwinCamera.GRAB.ZOOM}
          pitch={TwinCamera.GRAB.PITCH}
          yaw={TwinCamera.GRAB.YAW}
          contentType={TWIN_GRAB_CONTENT_TYPE}
          onMouseEnter={(event) => {
            modelSwapper(event.component, TwinModels.GRAB_HOVER);
          }}
          onMouseLeave={(event) => {
            modelSwapper(event.component, TwinModels.GRAB);
          }}
        />
      </layer>

      <model
        ref={joystick}
        x={TwinLayout.STICK.X}
        y={TwinLayout.STICK.Y}
        w={TwinLayout.STICK.SIZE}
        h={TwinLayout.STICK.SIZE}
        model={TwinModels.STICK}
        zoom={TwinCamera.STICK.ZOOM}
        pitch={TwinCamera.STICK.PITCH}
      />

      <sprite
        x={TwinLayout.CLOSE.X}
        y={TwinLayout.CLOSE.Y}
        w={TwinLayout.CLOSE.W}
        h={TwinLayout.CLOSE.H}
        sprite={TwinArt.CLOSE}
        options={['Close']}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, TwinArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, TwinArt.CLOSE);
        }}
      />

      <layer
        x={TwinLayout.MOVE_RIGHT.X}
        y={TwinLayout.MOVE_RIGHT.Y}
        w={TwinLayout.ARROW.W}
        h={TwinLayout.ARROW.H}
        options={['Move-right']}
        onMouseEnter={() => {
          modelSwapper(joystick, TwinModels.STICK_RIGHT);
        }}
        onMouseLeave={() => {
          modelSwapper(joystick, TwinModels.STICK);
        }}
      />

      <layer
        x={TwinLayout.MOVE_UP.X}
        y={TwinLayout.MOVE_UP.Y}
        w={TwinLayout.ARROW.W}
        h={TwinLayout.ARROW.H}
        options={['Move-up']}
        onMouseEnter={() => {
          modelSwapper(joystick, TwinModels.STICK_UP);
        }}
        onMouseLeave={() => {
          modelSwapper(joystick, TwinModels.STICK);
        }}
      />

      <layer
        x={TwinLayout.MOVE_LEFT.X}
        y={TwinLayout.MOVE_LEFT.Y}
        w={TwinLayout.ARROW.W}
        h={TwinLayout.ARROW.H}
        options={['Move-left']}
        onMouseEnter={() => {
          modelSwapper(joystick, TwinModels.STICK_LEFT);
        }}
        onMouseLeave={() => {
          modelSwapper(joystick, TwinModels.STICK);
        }}
      />

      <layer
        x={TwinLayout.MOVE_DOWN.X}
        y={TwinLayout.MOVE_DOWN.Y}
        w={TwinLayout.ARROW.W}
        h={TwinLayout.ARROW.H}
        options={['Move-down']}
        onMouseEnter={() => {
          modelSwapper(joystick, TwinModels.STICK_DOWN);
        }}
        onMouseLeave={() => {
          modelSwapper(joystick, TwinModels.STICK);
        }}
      />

      <layer x={TwinLayout.TRIES.X} y={TwinLayout.TRIES.Y} w={TwinLayout.TRIES.W} h={TwinLayout.TRIES.H} />
    </>
  );
}
