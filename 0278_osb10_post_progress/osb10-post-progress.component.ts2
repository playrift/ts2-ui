import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  LeftRows,
  ProgressArt,
  ProgressColor,
  ProgressFont,
  ProgressModel,
  ProgressText,
  RightRows,
} from './osb10-post-progress.constants';

export function Osb10PostProgress(): Component {
  return (
    <>
      <model
        x={Layout.model.X}
        y={Layout.model.Y}
        w={Layout.model.W}
        h={Layout.model.H}
        model={ProgressModel.MUSEUM}
        zoom={Camera.MUSEUM.ZOOM}
        pitch={Camera.MUSEUM.PITCH}
        offsetY={Camera.MUSEUM.OFFSET_Y}
      />

      <layer
        x={Layout.close.X}
        y={Layout.close.Y}
        w={Layout.close.W}
        h={Layout.close.H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.closeFace.X}
          y={Layout.closeFace.Y}
          w={Layout.closeFace.W}
          h={Layout.closeFace.H}
          sprite={ProgressArt.CLOSE}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, ProgressArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, ProgressArt.CLOSE)}
        />
      </layer>

      <layer x={{ center: Layout.column.CENTER_DX }} y={Layout.column.Y} w={Layout.column.W} h={Layout.column.H}>
        <layer x="center" y={Layout.headBand.Y} w={{ fill: Layout.headBand.INSET }} h={Layout.headBand.H}>
          <text
            x="center"
            y="center"
            w={{ fill: Layout.headText.INSET }}
            h={Layout.headText.H}
            text={ProgressText.HEADING}
            font={ProgressFont.HEADING}
            color={ProgressColor.WHITE}
            shadow
            align="center"
          />
        </layer>

        <layer
          x="center"
          y={Layout.rowBand.Y}
          w={{ fill: Layout.rowBand.INSET_W }}
          h={{ fill: Layout.rowBand.INSET_H }}
        >
          {LeftRows.map((row) => (
            <>
              <sprite
                x={Layout.left.SLOT_X}
                y={row.y}
                w={Layout.row.SLOT_W}
                h={Layout.row.SLOT_H}
                outline={1}
                shadowColor={ProgressColor.SLOT_SHADOW}
                hflip
              />
              <text
                x={Layout.left.TEXT_X}
                y={row.y}
                w={Layout.row.TEXT_W}
                h={Layout.row.NAME_H}
                text={row.name}
                font={ProgressFont.ROW}
                color={ProgressColor.WHITE}
                shadow
                align="center"
              />
              <text
                x={Layout.left.TEXT_X}
                y={row.y + Layout.row.VALUE_DY}
                w={Layout.row.TEXT_W}
                h={Layout.row.VALUE_H}
                text={ProgressText.EMPTY}
                font={ProgressFont.ROW}
                color={ProgressColor.WHITE}
                shadow
                align="center"
              />
            </>
          ))}

          {RightRows.map((row) => (
            <>
              <sprite
                x={{ right: Layout.right.SLOT_X }}
                y={row.y}
                w={Layout.row.SLOT_W}
                h={Layout.row.SLOT_H}
                outline={1}
                shadowColor={ProgressColor.SLOT_SHADOW}
                hflip
              />
              <text
                x={{ right: Layout.right.TEXT_X }}
                y={row.y}
                w={Layout.row.TEXT_W}
                h={Layout.row.NAME_H}
                text={row.name}
                font={ProgressFont.ROW}
                color={ProgressColor.WHITE}
                shadow
                align="center"
              />
              <text
                x={{ right: Layout.right.TEXT_X }}
                y={row.y + Layout.row.VALUE_DY}
                w={Layout.row.TEXT_W}
                h={Layout.row.VALUE_H}
                text={ProgressText.EMPTY}
                font={ProgressFont.ROW}
                color={ProgressColor.WHITE}
                shadow
                align="center"
              />
            </>
          ))}
        </layer>
      </layer>
    </>
  );
}
