        zoom={Camera.OPPONENT_CAT.ZOOM}
        pitch={Camera.OPPONENT_CAT.PITCH}
        yaw={Camera.OPPONENT_CAT.YAW}
      />

      <model
        x={Layout.P2_PILE_X}
