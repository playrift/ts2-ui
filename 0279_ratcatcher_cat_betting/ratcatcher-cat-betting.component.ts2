        h={Layout.VS_H}
        text="Vs"
        font={BettingFonts.HEADING}
        color={BettingColor.CAPTION}
        align="center"
      />

      <text
        x={Layout.BUTTON_X}
        y={Layout.ACCEPT_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text="ACCEPT"
