        h={Layout.AMOUNT_H}
        text="Amount"
        font={BettingFonts.CAPTION}
        color={BettingColor.AMOUNT}
        shadow
        align="center"
      />
      <text
        x={Layout.P2_AMOUNT_X}
        y={Layout.P2_AMOUNT_Y}
        w={Layout.AMOUNT_W}
        h={Layout.AMOUNT_H}
        text="Amount"
        font={BettingFonts.CAPTION}
        color={BettingColor.AMOUNT}
