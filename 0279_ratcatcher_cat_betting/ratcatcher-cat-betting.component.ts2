        y={Layout.DECLINE_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={BettingArt.BUTTON}
      />

      <text
        x={Layout.P1_NAME_X}
        y={Layout.P1_NAME_Y}
