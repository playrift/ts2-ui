import {
  BettingColor,
  BettingFonts,
  BettingSprites,
  Layout,
  PROMPT_TEXT,
} from './ratcatcher-cat-betting-confirm.constants';

export function RatcatcherCatBettingConfirm(): Component {
  return (
    <layer w="fill" h="fill">
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} color={BettingColor.BACKDROP} fill={true} />

      <sprite
        x={Layout.BUTTON_X}
        y={Layout.ACCEPT_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={BettingSprites.BUTTON}
      />
      <sprite
        x={Layout.BUTTON_X}
        y={Layout.DECLINE_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={BettingSprites.BUTTON}
      />

      <text
        x={Layout.BUTTON_X}
        y={Layout.ACCEPT_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text="YES"
        font={BettingFonts.LABEL}
        color={BettingColor.ACCEPT}
        shadow={true}
        align="center"
        valign="middle"
      />
      <text
        x={Layout.BUTTON_X}
        y={Layout.DECLINE_Y}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text="NO"
        font={BettingFonts.LABEL}
        color={BettingColor.DECLINE}
        shadow={true}
        align="center"
        valign="middle"
      />

      <text
        x={Layout.PROMPT_X}
        y={Layout.PROMPT_Y}
        w={Layout.PROMPT_W}
        h={Layout.PROMPT_H}
        text={PROMPT_TEXT}
        font={BettingFonts.LABEL}
        color={BettingColor.PROMPT}
        align="center"
        valign="top"
      />
    </layer>
  );
}
