import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  CatScoresColor,
  CatScoresDodge,
  CatScoresFonts,
  CatScoresModel,
  Layout,
} from './ratcatcher-cat-scores.constants';

const scores = createRef('ratcatcher_cat_scores_scores1');

export function RatcatcherCatScores(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, scores, CatScoresDodge.DODGE, Anchor.RIGHT, Anchor.TOP, 0)}
      >
        <layer ref={scores} x="right" y={0} w={Layout.SCORES_W} h={Layout.SCORES_H}>
          <text
            x={{ right: Layout.NAME_RIGHT }}
            y={Layout.NAME_TOP_Y}
            w={Layout.NAME_TOP_W}
            h={Layout.NAME_TOP_H}
            font={CatScoresFonts.Q8}
            shadow
            align="center"
            color={CatScoresColor.ORANGE}
          />

          <text
            x={{ right: Layout.NAME_RIGHT }}
            y={Layout.NAME_BOTTOM_Y}
            w={Layout.NAME_BOTTOM_W}
            h={Layout.NAME_BOTTOM_H}
            font={CatScoresFonts.Q8}
            shadow
            align="center"
            color={CatScoresColor.ORANGE}
          />

          <model
            x={{ right: Layout.CAT_RIGHT }}
            y={Layout.CAT_TOP_Y}
            w={Layout.CAT_W}
            h={Layout.CAT_H}
            model={CatScoresModel.CAT_TOP}
            pitch={Layout.CAT_TOP_PITCH}
            yaw={Layout.CAT_TOP_YAW}
            zoom={Layout.CAT_ZOOM}
          />

          <model
            x={{ right: Layout.CAT_RIGHT }}
            y={Layout.CAT_BOTTOM_Y}
            w={Layout.CAT_W}
            h={Layout.CAT_H}
            model={CatScoresModel.CAT_BOTTOM}
            pitch={Layout.CAT_BOTTOM_PITCH}
            yaw={Layout.CAT_BOTTOM_YAW}
            zoom={Layout.CAT_ZOOM}
          />

          <text
            x={{ right: Layout.SCORE_RIGHT }}
            y={Layout.SCORE_TOP_Y}
            w={Layout.SCORE_W}
            h={Layout.SCORE_H}
            text="10"
            font={CatScoresFonts.P12}
            shadow
            color={CatScoresColor.ORANGE}
          />

          <text
            x={{ right: Layout.SCORE_RIGHT }}
            y={Layout.SCORE_BOTTOM_Y}
            w={Layout.SCORE_W}
            h={Layout.SCORE_H}
            text="10"
            font={CatScoresFonts.P12}
            shadow
            color={CatScoresColor.ORANGE}
          />
        </layer>
      </layer>

      <layer hide x="center" y="center" w={Layout.DEFEAT_W} h={Layout.DEFEAT_H}>
        <model
          x="center"
          y="center"
          w={Layout.TROPHY_W}
          h={Layout.TROPHY_H}
          model={CatScoresModel.TROPHY}
          pitch={Layout.TROPHY_PITCH}
          zoom={Layout.TROPHY_ZOOM}
        />

        <text
          x="center"
          y={Layout.LINE_1_Y}
          w={Layout.LINE_1_W}
          h={Layout.LINE_H}
          text="Your cat has been"
          font={CatScoresFonts.Q8}
          align="center"
        />

        <text
          x="center"
          y={Layout.LINE_2_Y}
          w={Layout.LINE_2_W}
          h={Layout.LINE_H}
          text="Defeated"
          font={CatScoresFonts.Q8}
        />
      </layer>
    </layer>
  );
}
