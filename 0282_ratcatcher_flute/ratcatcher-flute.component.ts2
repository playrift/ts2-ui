import { FluteColor, FluteFonts, FluteModel, FluteSprites, FluteText, Layout } from './ratcatcher-flute.constants';

export function RatcatcherFlute(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={Layout.SCROLL_SIZE}
        h={Layout.SCROLL_SIZE}
        model={FluteModel.SCROLL}
        zoom={Layout.SCROLL_ZOOM}
        pitch={Layout.SCROLL_PITCH}
      />

      <model
        x={Layout.BIG_FLUTE_X}
        y={Layout.BIG_FLUTE_Y}
        w={Layout.BIG_FLUTE_SIZE}
        h={Layout.BIG_FLUTE_SIZE}
        model={FluteModel.BIG_FLUTE}
        zoom={Layout.BIG_FLUTE_ZOOM}
        pitch={Layout.BIG_FLUTE_PITCH}
        yaw={Layout.BIG_FLUTE_YAW}
      />

      {Layout.MINI.map((slot) => (
        <model
          x={slot.x}
          y={slot.y}
          w={Layout.MINI_SIZE.w}
          h={Layout.MINI_SIZE.h}
          model={FluteModel.MINI_FLUTE}
          zoom={Layout.MINI_ZOOM}
          pitch={Layout.MINI_PITCH}
        />
      ))}

      <text
        x={Layout.PAGE_X}
        y={Layout.PAGE_Y}
        w={Layout.PAGE_W}
        h={Layout.PAGE_H}
        text={FluteText.PAGE_NUMBER}
        font={FluteFonts.BODY}
        color={FluteColor.PAGE_NUMBER}
        align="center"
      />

      <model
        x={Layout.OCTAVE_X}
        y={Layout.OCTAVE_Y}
        w={Layout.OCTAVE_W}
        h={Layout.OCTAVE_H}
        model={FluteModel.OCTAVE}
        zoom={Layout.OCTAVE_ZOOM}
        pitch={Layout.OCTAVE_PITCH}
      />

      <model
        x={Layout.KEY_D.x}
        y={Layout.KEY_D.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_D}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_D_PITCH}
      />
      <model
        x={Layout.KEY_E.x}
        y={Layout.KEY_E.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_E}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_FSHARP.x}
        y={Layout.KEY_FSHARP.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_FSHARP}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_G.x}
        y={Layout.KEY_G.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_G}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_A.x}
        y={Layout.KEY_A.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_A}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_B.x}
        y={Layout.KEY_B.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_B}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_CSHARP.x}
        y={Layout.KEY_CSHARP.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_CSHARP}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />
      <model
        x={Layout.KEY_C.x}
        y={Layout.KEY_C.y}
        w={Layout.MINI_SIZE.w}
        h={Layout.MINI_SIZE.h}
        model={FluteModel.KEY_C}
        zoom={Layout.KEY_ZOOM}
        pitch={Layout.KEY_PITCH}
      />

      <text
        x={Layout.PLAY_X}
        y={Layout.PLAY_Y}
        w={Layout.PLAY_W}
        h={Layout.PLAY_H}
        text={FluteText.PLAY}
        font={FluteFonts.BODY}
        color={FluteColor.PLAY}
        shadow={true}
        align="center"
      />

      <layer x={Layout.PREV_HOLDER_X} y={Layout.PREV_HOLDER_Y} w={Layout.ARROW_HOLDER_W} h={Layout.ARROW_HOLDER_H}>
        <model
          x={Layout.PREV_ARROW_X}
          y={Layout.PREV_ARROW_Y}
          w={Layout.PREV_ARROW_W}
          h={Layout.PREV_ARROW_H}
          model={FluteModel.PAGE_ARROW}
          zoom={Layout.ARROW_ZOOM}
          pitch={Layout.PREV_ARROW_PITCH}
          yaw={Layout.PREV_ARROW_YAW}
        />
      </layer>

      <layer x={Layout.NEXT_HOLDER_X} y={Layout.NEXT_HOLDER_Y} w={Layout.ARROW_HOLDER_W} h={Layout.ARROW_HOLDER_H}>
        <model
          x={Layout.NEXT_ARROW_X}
          y={Layout.NEXT_ARROW_Y}
          w={Layout.NEXT_ARROW_W}
          h={Layout.NEXT_ARROW_H}
          model={FluteModel.PAGE_ARROW}
          zoom={Layout.ARROW_ZOOM}
          pitch={Layout.NEXT_ARROW_PITCH}
        />
      </layer>

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={FluteSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={FluteSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
