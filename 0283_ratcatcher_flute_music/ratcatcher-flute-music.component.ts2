import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, MusicArt, MusicModel, Notes, Staves } from './ratcatcher-flute-music.constants';

export function RatcatcherFluteMusic(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={Layout.SCROLL_SIZE}
        h={Layout.SCROLL_SIZE}
        model={MusicModel.SCROLL}
        zoom={Camera.SCROLL.ZOOM}
        pitch={Camera.SCROLL.PITCH}
        yaw={Camera.SCROLL.YAW}
      />

      {Staves.map((stave) => (
        <model
          x={stave.x}
          y={stave.y}
          w={Layout.COLUMN_W}
          h={Layout.COLUMN_H}
          model={MusicModel.STAVE}
          zoom={Camera.NOTE.ZOOM}
          pitch={Camera.NOTE.PITCH}
        />
      ))}

      {Notes.map((note) => (
        <model
          x={note.x}
          y={note.y}
          w={Layout.COLUMN_W}
          h={Layout.COLUMN_H}
          model={note.model}
          zoom={Camera.NOTE.ZOOM}
          pitch={Camera.NOTE.PITCH}
        />
      ))}

      <model
        x={Layout.SHARP_X}
        y={Layout.SHARP_Y}
        w={Layout.SHARP_SIZE}
        h={Layout.SHARP_SIZE}
        model={MusicModel.SHARP}
        zoom={Camera.SHARP.ZOOM}
        pitch={Camera.SHARP.PITCH}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MusicArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, MusicArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, MusicArt.CLOSE);
        }}
      />
    </>
  );
}
