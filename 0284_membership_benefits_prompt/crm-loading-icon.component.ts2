import { useInterval, useRef, useUniverse } from 'ts2';
import { scaled } from '../lib/lib.engine';
import { CosineDegrees, LoadingIcon, LoadingRingItems, SineDegrees } from './membership-benefits-prompt.constants';

export function CrmLoadingIcon(): Component {
  const universe = useUniverse();
  const size: Int = Math.min(universe.width, universe.height) / LoadingIcon.SIZE_DIVISOR;
  const centerX: Int = (universe.width - size) / 2;
  const centerY: Int = (universe.height - size) / 2;

  return (
    <layer x="center" y="center" w="fill" h="fill">
      {LoadingRingItems.map((item, index) => (
        <LoadingRingItem item={item} index={index} centerX={centerX} centerY={centerY} size={size} />
      ))}
    </layer>
  );
}

function LoadingRingItem({
  item,
  index,
  centerX,
  centerY,
  size,
}: {
  item: Item;
  index: Int;
  centerX: Int;
  centerY: Int;
  size: Int;
}): Component {
  const angle: Int = index * LoadingIcon.DEGREES_PER_ITEM + Math.min(index + 1, LoadingIcon.DEGREES_SPARE);

  const zoom: Int = Math.max(LoadingIcon.ZOOM_MAX - index * LoadingIcon.ZOOM_STEP, LoadingIcon.ZOOM_MIN);

  const me = useRef();

  useInterval(() => {
    const next: Int = me.zoom + LoadingIcon.ZOOM_PER_CYCLE;
    me.props = {
      offsetX: 0,
      offsetY: 0,
      pitch: LoadingIcon.PITCH,
      yaw: LoadingIcon.YAW,
      roll: LoadingIcon.ROLL,
      zoom: next > LoadingIcon.ZOOM_MAX ? LoadingIcon.ZOOM_MIN : next,
    };
  }, me);

  return (
    <model
      ref={me}
      x={centerX + scaled(cosDegrees(angle), LoadingIcon.TRIG_UNIT, LoadingIcon.RADIUS)}
      y={centerY + scaled(sinDegrees(angle), LoadingIcon.TRIG_UNIT, LoadingIcon.RADIUS)}
      w={size}
      h={size}
      item={item}
      itemCount={LoadingIcon.STACK}
      pitch={LoadingIcon.PITCH}
      yaw={LoadingIcon.YAW}
      roll={LoadingIcon.ROLL}
      zoom={zoom}
    />
  );
}

function sinDegrees(degrees: Int): Int {
  return SineDegrees.at(degrees) ?? 0;
}

function cosDegrees(degrees: Int): Int {
  return CosineDegrees.at(degrees) ?? 0;
}
