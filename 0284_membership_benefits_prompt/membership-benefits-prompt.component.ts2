import { useRef } from 'ts2';
import { graphicSwapperUnlessMobile, onMobile, opsound } from '../lib/lib.helpers';
import { CrmLoadingIcon } from './crm-loading-icon.component';
import { CloseSprites, CrmColors, Dimmer, Layout, Ops, UpgradeSprites } from './membership-benefits-prompt.constants';

export function MembershipBenefitsPrompt(): Component {
  const closeIcon = useRef();

  return (
    <layer x={Layout.PANEL_X} y={Layout.PANEL_Y} w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <layer w="fill" h="fill">
        <sprite w={Layout.BACKDROP_WIDTH} h={Layout.BACKDROP_HEIGHT} />

        <sprite
          x="center"
          y={{ bottom: Layout.UPGRADE_BOTTOM }}
          w={Layout.UPGRADE_WIDTH}
          h={Layout.UPGRADE_HEIGHT}
          hide
          sprite={UpgradeSprites.OUT}
          options={['Upgrade Now']}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, UpgradeSprites.OVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, UpgradeSprites.OUT);
          }}
          onOptionSelect={(event) => {
            opsound(event.option, Ops.UPGRADE_SOUND_MASK);
          }}
        />

        <layer w="fill" h="fill" />

        <rect w="fill" h="fill" hide fill color={CrmColors.DIM} transparency={Dimmer.IDLE} />

        <layer
          x={Layout.CLOSE_X}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_HIT}
          h={Layout.CLOSE_HIT}
          hide
          noClickThrough
          onMouseEnter={() => {
            graphicSwapperUnlessMobile(closeIcon, CloseSprites.OVER);
          }}
          onMouseLeave={() => {
            graphicSwapperUnlessMobile(closeIcon, CloseSprites.OUT);
          }}
        >
          <sprite
            ref={closeIcon}
            x="center"
            y="center"
            w={Layout.CLOSE_WIDTH}
            h={Layout.CLOSE_HEIGHT}
            sprite={CloseSprites.OUT}
          />
        </layer>

        <layer w="fill" h="fill">
          <CrmLoadingIcon />
        </layer>
      </layer>
    </layer>
  );
}
