      <sprite x={12} y={290} w={25} h={30} sprite={StillArt.STEELBORDER_2} />
      <sprite x={475} y={20} w={25} h={30} sprite={StillArt.STEELBORDER_1} />
      <sprite x={439} y={5} w={36} h={36} sprite={StillArt.STEELBORDER2_0} />
      <sprite x={475} y={290} w={25} h={30} sprite={StillArt.STEELBORDER_3} />
      <sprite x={439} y={299} w={36} h={36} sprite={StillArt.MISCGRAPHICS_3} />
      {InnerTopEdge.map((row) => (
