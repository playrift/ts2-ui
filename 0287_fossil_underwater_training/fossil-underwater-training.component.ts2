import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ExchangeButton } from './exchange-button.component';
import { TearCount } from './tear-count.component';
import { Band, Counter, Exchange, TrainingModel } from './fossil-underwater-training.constants';

export function FossilUnderwaterTraining(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Mairin's Training" />

      <layer x="center" y={Band.TOP} w={{ fill: Band.WIDTH_INSET }} h={{ fill: Band.HEIGHT_INSET }}>
        <ExchangeButton kind={Exchange.AGILITY} title="Agility XP" x={0} y={0} w={Band.BUTTON_WIDTH} h="fill" />
        <model
          x={0}
          y="center"
          w={Band.MODEL_WIDTH}
          h={Band.MODEL_HEIGHT}
          model={TrainingModel.AGILITY}
          zoom={TrainingModel.AGILITY_ZOOM}
          pitch={TrainingModel.AGILITY_PITCH}
          offsetX={-2}
          offsetY={2}
        />

        <ExchangeButton kind={Exchange.THIEVING} title="Thieving XP" x="right" y={0} w={Band.BUTTON_WIDTH} h="fill" />
        <model
          x="right"
          y="center"
          w={Band.MODEL_WIDTH}
          h={Band.MODEL_HEIGHT}
          model={TrainingModel.THIEVING}
          zoom={TrainingModel.THIEVING_ZOOM}
          pitch={TrainingModel.THIEVING_PITCH}
          offsetX={2}
          offsetY={1}
        />

        <ExchangeButton kind={Exchange.BOTH} title="Both skills" x="center" y={0} w={Band.BUTTON_WIDTH} h="fill" />
        <model
          x="center"
          y="center"
          w={Band.MODEL_WIDTH}
          h={Band.MODEL_HEIGHT}
          model={TrainingModel.AGILITY}
          zoom={TrainingModel.BOTH_AGILITY_ZOOM}
          pitch={TrainingModel.AGILITY_PITCH}
          offsetX={-2}
          offsetY={-1}
        />
        <model
          x="center"
          y="center"
          w={Band.MODEL_WIDTH}
          h={Band.MODEL_HEIGHT}
          model={TrainingModel.THIEVING}
          zoom={TrainingModel.BOTH_THIEVING_ZOOM}
          pitch={TrainingModel.THIEVING_PITCH}
          offsetX={2}
          offsetY={11}
        />
      </layer>

      <layer x="center" y={{ bottom: Counter.BOTTOM }} w={{ fill: Counter.WIDTH_INSET }} h={Counter.HEIGHT}>
        <TearCount />
      </layer>
    </>
  );
}
