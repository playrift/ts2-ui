import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { FADE_TRANSPARENCY, PopupLayout, PopupOverlayColor } from './popupoverlay.constants';

export function PopupOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={PopupOverlayColor.FADE}
        transparency={FADE_TRANSPARENCY}
      />

      <layer x="center" y="center" w={PopupLayout.WINDOW} h={PopupLayout.WINDOW}>
        <layer x="center" y="center" w="fill" h="fill" />

        <layer
          x="center"
          y={{ bottom: PopupLayout.CONTAINER_BOTTOM }}
          w={{ fill: PopupLayout.CONTAINER_INSET_W }}
          h={{ fill: PopupLayout.CONTAINER_INSET_H }}
        >
          <layer
            x={PopupLayout.LIST_X}
            y="center"
            w={{ fill: PopupLayout.LIST_INSET_W }}
            h={{ fill: PopupLayout.LIST_INSET_H }}
          >
            <layer x={0} y={{ bottom: 0 }} w={0} h={0} hide />
            <layer x={{ right: 0 }} y={{ bottom: 0 }} w={0} h={0} hide />
          </layer>

          <layer
            x={{ right: PopupLayout.SCROLLBAR_RIGHT }}
            y="center"
            w={PopupLayout.SCROLLBAR_W}
            h={{ fill: PopupLayout.SCROLLBAR_INSET_H }}
          />

          <ThinBoxEntrypoint />
        </layer>
      </layer>
    </layer>
  );
}
