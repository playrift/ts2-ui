import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Backing,
  DialCamera,
  DialsAnim,
  DialsArt,
  DialsColor,
  DialOps,
  DialsModel,
  Dials,
  Gears,
  Layout,
  Screws,
} from './roguesden-dials.constants';

export function RoguesdenDials(): Component {
  return (
    <>
      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <layer x={0} y={0} w="fill" h="fill">
          <layer x={0} y={0} w="fill" h="fill">
            <rect
              x={Layout.PLATE_X}
              y={Layout.PLATE_Y}
              w={Layout.PLATE_W}
              h={Layout.PLATE_H}
              fill
              color={DialsColor.PLATE}
            />

            <model
              x={Gears.GEAR_6.x}
              y={Gears.GEAR_6.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.GEAR_6}
              anim={DialsAnim.GEAR_6}
              zoom={Gears.GEAR_6.zoom}
              pitch={Gears.GEAR_6.pitch}
              yaw={Gears.GEAR_6.yaw}
              offsetY={Gears.GEAR_6.offsetY}
            />

            <model
              x={Gears.GEAR_3.x}
              y={Gears.GEAR_3.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.GEAR_3}
              anim={DialsAnim.GEAR_3}
              zoom={Gears.GEAR_3.zoom}
              pitch={Gears.GEAR_3.pitch}
              yaw={Gears.GEAR_3.yaw}
            />

            <model
              x={Gears.GEAR_8.x}
              y={Gears.GEAR_8.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.GEAR_8}
              anim={DialsAnim.GEAR_8}
              zoom={Gears.GEAR_8.zoom}
              pitch={Gears.GEAR_8.pitch}
              yaw={Gears.GEAR_8.yaw}
              offsetY={Gears.GEAR_8.offsetY}
            />

            <model
              x={Gears.GEAR_5.x}
              y={Gears.GEAR_5.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.GEAR_5}
              anim={DialsAnim.GEAR_5}
              zoom={Gears.GEAR_5.zoom}
              pitch={Gears.GEAR_5.pitch}
              yaw={Gears.GEAR_5.yaw}
              offsetX={Gears.GEAR_5.offsetX}
              offsetY={Gears.GEAR_5.offsetY}
            />

            <model
              x={Backing.BASE.x}
              y={Backing.BASE.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.METAL_BASE}
              zoom={Backing.BASE.zoom}
              pitch={Backing.BASE.pitch}
              yaw={Backing.BASE.yaw}
            />

            <model
              x={Backing.GRIDLINES.x}
              y={Backing.GRIDLINES.y}
              w={Layout.MODEL_SIZE}
              h={Layout.MODEL_SIZE}
              model={DialsModel.GRIDLINES}
              zoom={Backing.GRIDLINES.zoom}
              pitch={Backing.GRIDLINES.pitch}
            />

            {Screws.map((screw) => (
              <model
                x={screw.x}
                y={screw.y}
                w={Layout.MODEL_SIZE}
                h={Layout.MODEL_SIZE}
                model={DialsModel.SCREW}
                zoom={Backing.SCREW_ZOOM}
                pitch={screw.pitch}
                yaw={screw.yaw}
              />
            ))}
          </layer>

          <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
            {Dials.map((dial) => (
              <model
                x={dial.x}
                y={dial.y}
                w={Layout.DIAL_SIZE}
                h={Layout.DIAL_SIZE}
                model={DialsModel.DIAL}
                anim={DialsAnim.DIAL}
                zoom={DialCamera.ZOOM}
                pitch={DialCamera.PITCH}
                yaw={DialCamera.YAW}
                options={[DialOps.CLOCKWISE, DialOps.ANTICLOCKWISE]}
              />
            ))}
          </layer>
        </layer>
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={DialsArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, DialsArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, DialsArt.CLOSE);
        }}
      />
    </>
  );
}
