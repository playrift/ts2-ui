import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, NoteArt, NoteColors, NoteFonts, NoteModel } from './note.constants';

export function Note(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <model
        x={{ center: Layout.MODEL_DX }}
        y={{ center: Layout.MODEL_DY }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={NoteModel.BACKGROUND}
        zoom={NoteModel.ZOOM}
        pitch={NoteModel.PITCH}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={NoteArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, NoteArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, NoteArt.CLOSE)}
      />

      <layer x={{ center: Layout.PANE_DX }} y={{ center: Layout.PANE_DY }} w={Layout.PANE_W} h={Layout.PANE_H}>
        <text
          x="center"
          y={Layout.LINE1_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE2_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE3_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE4_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE5_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE6_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE7_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE8_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE9_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE10_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE11_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
        <text
          x="center"
          y={Layout.LINE12_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={NoteFonts.LINE}
          color={NoteColors.LINE}
          align="center"
          shadow
        />
      </layer>
    </layer>
  );
