import { CS2, predictServerState, useServerState } from 'ts2';

import { chatMessage } from '../lib/lib.engine';
import {
  Bank,
  Difficulty,
  LargePuzzles,
  SmallPuzzles,
  SudokuBanks,
  SudokuVarbits,
} from './roguetrader-sudoku.constants';

export function tileRune(index: Int): Int {
  const low: Int = (index % Bank.cellsPerVarp) * Bank.bits;
  switch (index / Bank.cellsPerVarp) {
    case 0:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_0), low, low + 3);
    case 1:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_1), low, low + 3);
    case 2:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_2), low, low + 3);
    case 3:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_3), low, low + 3);
    case 4:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_4), low, low + 3);
    case 5:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_5), low, low + 3);
    case 6:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_6), low, low + 3);
    case 7:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_7), low, low + 3);
    case 8:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_8), low, low + 3);
    case 9:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_9), low, low + 3);
    case 10:
      return CS2.bit_range_get(useServerState(SudokuBanks.BANK_10), low, low + 3);
  }
  return 0;
}

export function setTileRune(index: Int, rune: Int): void {
  const low: Int = (index % Bank.cellsPerVarp) * Bank.bits;
  switch (index / Bank.cellsPerVarp) {
    case 0:
      predictServerState(
        SudokuBanks.BANK_0,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_0), rune, low, low + 3),
      );
      return;
    case 1:
      predictServerState(
        SudokuBanks.BANK_1,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_1), rune, low, low + 3),
      );
      return;
    case 2:
      predictServerState(
        SudokuBanks.BANK_2,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_2), rune, low, low + 3),
      );
      return;
    case 3:
      predictServerState(
        SudokuBanks.BANK_3,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_3), rune, low, low + 3),
      );
      return;
    case 4:
      predictServerState(
        SudokuBanks.BANK_4,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_4), rune, low, low + 3),
      );
      return;
    case 5:
      predictServerState(
        SudokuBanks.BANK_5,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_5), rune, low, low + 3),
      );
      return;
    case 6:
      predictServerState(
        SudokuBanks.BANK_6,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_6), rune, low, low + 3),
      );
      return;
    case 7:
      predictServerState(
        SudokuBanks.BANK_7,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_7), rune, low, low + 3),
      );
      return;
    case 8:
      predictServerState(
        SudokuBanks.BANK_8,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_8), rune, low, low + 3),
      );
      return;
    case 9:
      predictServerState(
        SudokuBanks.BANK_9,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_9), rune, low, low + 3),
      );
      return;
    case 10:
      predictServerState(
        SudokuBanks.BANK_10,
        CS2.bit_range_to_int_set(useServerState(SudokuBanks.BANK_10), rune, low, low + 3),
      );
      return;
  }
}

export function transposedDigit(digit: Int): Int {
  if (digit === 0 || digit === -1) {
    return digit;
  }
  const shifted: Int = (digit + useServerState(SudokuVarbits.TRANSPOSE)) % 9;
  if (shifted === 0) {
    return 9;
  }
  return shifted;
}

export function cannotRemoveRune(): void {
  chatMessage('I cannot remove this rune.');
}

export function selectRune(slot: Int): void {
  predictServerState(SudokuVarbits.SELECTED_RUNE, slot);
}

export function placeRune(difficulty: Int, puzzleId: Int, index: Int): void {
  const solution: Map<Int, Int> | null =
    difficulty === Difficulty.LARGE ? LargePuzzles.get(puzzleId) : SmallPuzzles.get(puzzleId);
  const given: Int = solution === null ? -1 : (solution.get(index) ?? -1);
  if (given > 0) {
    return;
  }
  setTileRune(index, useServerState(SudokuVarbits.SELECTED_RUNE));
}
