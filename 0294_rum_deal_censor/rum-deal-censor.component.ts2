import { Layout, RumAnims, RumColors, RumFonts, RumModels } from './rum-deal-censor.constants';

export function RumDealCensor(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={RumColors.BACKDROP} />

      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <model
          x={Layout.SCENE_X}
          y={Layout.SCENE_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={RumModels.SCENE}
          zoom={Layout.SCENE_ZOOM}
          pitch={Layout.SCENE_PITCH}
        />

        <model
          x={Layout.BANNER_X}
          y={Layout.BANNER_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={RumModels.BANNER}
          zoom={Layout.BANNER_ZOOM}
          pitch={Layout.BANNER_PITCH}
          yaw={Layout.BANNER_YAW}
        />

        <model
          x={Layout.PROP_X}
          y={Layout.PROP_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={RumModels.PROP}
          zoom={Layout.PROP_ZOOM}
          pitch={Layout.PROP_PITCH}
          yaw={Layout.PROP_YAW}
        />

        <model
          x={Layout.ACTOR_X}
          y={Layout.ACTOR_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={RumModels.ACTOR}
          anim={RumAnims.ACTOR}
          zoom={Layout.ACTOR_ZOOM}
          pitch={Layout.ACTOR_PITCH}
          yaw={Layout.ACTOR_YAW}
        />

        <text
          x={Layout.RUM_X}
          y={Layout.RUM_Y}
          w={Layout.WORD_W}
          h={Layout.WORD_H}
          text="Rum"
          font={RumFonts.TITLE}
          color={RumColors.TITLE}
          shadow
          align="right"
        />

        <text
          x={Layout.DEAL_X}
          y={Layout.DEAL_Y}
          w={Layout.WORD_W}
          h={Layout.WORD_H}
          text="Deal"
          font={RumFonts.TITLE}
          color={RumColors.TITLE}
          shadow
          valign="bottom"
        />
      </layer>
    </>
  );
}
