import { Layout, RumDealFont, RumDealModel, ScrollCamera, TITLE_COLOR, TITLE_TEXT } from './rum-deal-title.constants';

export function RumDealTitle(): Component {
  return (
    <layer x="center" y={0} w="fill" h={Layout.CONTAINER_H}>
      <model
        x="center"
        y={0}
        w="fill"
        h="fill"
        model={RumDealModel.SCROLL}
        zoom={ScrollCamera.ZOOM}
        pitch={ScrollCamera.PITCH}
        offsetX={ScrollCamera.OFFSET_X}
        offsetY={ScrollCamera.OFFSET_Y}
      />

      <text
        x="center"
        y="center"
        w="fill"
        h={Layout.TITLE_H}
        text={TITLE_TEXT}
        font={RumDealFont.TITLE}
        color={TITLE_COLOR}
        shadow={true}
        align="center"
        valign="top"
      />
    </layer>
  );
}
