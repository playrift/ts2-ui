import { createRef } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { SandCamera, SandLayout, SandTint, SandstormAnims, SandstormModel } from './sandstorm.constants';

const sandHaze = createRef('sandstorm_haze');

export function Sandstorm(): Component {
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onTimer={(event) =>
        modelTransparentDynamicZoom(
          event.component,
          sandHaze,
          SandCamera.NEAR,
          SandCamera.FAR,
          SandCamera.OFFSET_X,
          SandCamera.OFFSET_Y,
          SandCamera.PITCH,
          SandCamera.YAW,
          SandCamera.ROLL,
        )
      }
    >
      <model
        ref={sandHaze}
        x="center"
        y="center"
        w={{ fill: SandLayout.HAZE_FILL_W }}
        h={{ fill: SandLayout.HAZE_FILL_H }}
        model={SandstormModel.HAZE}
        anim={SandstormAnims.HAZE}
        zoom={SandCamera.NEAR}
      />

      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={SandTint.COLOR}
        fill={true}
        transparency={SandTint.TRANSPARENCY}
      />
    </layer>
  );
}
