import {
  JourneyColor,
  JourneyFont,
  JourneyModel,
  JourneyModelId,
  JourneyText,
  Layout,
  Places,
  Waves,
} from './ship-journey.constants';

export function ShipJourney(): Component {
  return (
    <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
      <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
        <rect x={0} y={0} w={Layout.sea.W} h={Layout.sea.H} fill color={JourneyColor.SEA} />
      </layer>

      <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
        <model
          x={Layout.coast.X}
          y={Layout.coast.Y}
          w={Layout.coast.W}
          h={Layout.coast.H}
          model={JourneyModelId.COAST}
          zoom={Layout.coast.ZOOM}
          pitch={Layout.coast.PITCH}
          yaw={Layout.coast.YAW}
        />

        <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
          {Places.map((place) => (
            <text
              x={place.x}
              y={place.y}
              w={place.w}
              h={place.h}
              text={place.text}
              font={JourneyFont.LABEL}
              color={JourneyColor.PLACE}
              shadow
              align="center"
            />
          ))}
        </layer>

        <model
          x={Layout.boat.X}
          y={Layout.boat.Y}
          w={Layout.boat.W}
          h={Layout.boat.H}
          model={JourneyModel.BOAT}
          zoom={Layout.boat.ZOOM}
          pitch={Layout.boat.PITCH}
          yaw={Layout.boat.YAW}
        />

        <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
          {Waves.map((wave) => (
            <model
              x={wave.x}
              y={wave.y}
              w={Layout.WAVE_BOX}
              h={Layout.WAVE_BOX}
              model={JourneyModelId.WAVE}
              zoom={wave.zoom}
              pitch={wave.pitch}
              yaw={wave.yaw}
            />
          ))}
        </layer>

        <text
          x={Layout.title.X}
          y={Layout.title.Y}
          w={Layout.title.W}
          h={Layout.title.H}
          text={JourneyText.TITLE}
          font={JourneyFont.LABEL}
          color={JourneyColor.TITLE}
          shadow
        />
      </layer>
    </layer>
  );
}
