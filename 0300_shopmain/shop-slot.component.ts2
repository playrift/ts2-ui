import { flashFor } from '../lib/lib.components';
import { itemName } from '../lib/lib.engine';
import { BLANK_ITEM, Layout, ShopColors, ShopTransparency } from './shopmain.constants';
import { shopQuantityLabel } from './shopmain.helpers';

export function ShopSlot({
  item,
  count,
  slot,
  stride,
  quantity,
  flat,
  selected,
  customQuantity,
  fiftyOption,
}: {
  item: Item;
  count: Int;
  slot: Int;
  stride: Int;
  quantity: Int;
  flat: Boolean;
  selected: Item;
  customQuantity: Int;
  fiftyOption: Boolean;
}): Component {
  const left: Int = (slot % Layout.COLUMNS) * stride;
  const top: Int = (slot / Layout.COLUMNS) * stride;

  if (item === -1) {
    return (
      <sprite
        hide
        x={left}
        y={top}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        item={BLANK_ITEM}
        itemCount={1}
        itemCountMode="never"
        outline={Layout.OUTLINE}
        shadowColor={ShopColors.SLOT_SHADOW}
        transparency={ShopTransparency.REST}
        options={['', 'Buy 1', 'Buy 5', 'Buy 10', fiftyOption ? 'Buy 50' : '', '', '', '', '', 'Examine']}
        onOptionSelect={(event) => {
          flashFor(event.self, ShopTransparency.FLASH, ShopTransparency.REST);
        }}
      />
    );
  }

  return (
    <sprite
      x={left}
      y={top}
      w={Layout.SLOT_W}
      h={Layout.SLOT_H}
      item={item}
      itemCount={flat ? 1 : count}
      outline={Layout.OUTLINE}
      shadowColor={ShopColors.SLOT_SHADOW}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      options={[
        quantity > 0 ? shopQuantityLabel(quantity) : 'Value',
        'Buy 1',
        'Buy 5',
        'Buy 10',
        fiftyOption ? 'Buy 50' : '',
        quantity > 0 ? 'Value' : '',
        '',
        '',
        buyCustomLabel(item, selected, customQuantity),
        'Examine',
      ]}
      onOptionSelect={(event) => {
        flashFor(event.self, ShopTransparency.FLASH, ShopTransparency.REST);
      }}
    />
  );
}

function buyCustomLabel(item: Item, selected: Item, quantity: Int): String {
  if (item !== selected) {
    return '';
  }
  if (quantity <= 1) {
    return '';
  }
  if (quantity === 5) {
    return '';
  }
  if (quantity === 10) {
    return '';
  }
  return `Buy ${stringOf(quantity)}`;
}
