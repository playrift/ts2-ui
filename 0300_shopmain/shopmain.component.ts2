import { createRef } from 'ts2';
import { Layout, ShopArt, ShopColors, ShopFonts } from './shopmain.constants';
import { textColourSwapper } from './shopmain.helpers';
import { ShopStock } from './shop-stock.component';

const quantity1Label = createRef('shopmain_quantity1_text');
const quantity5Label = createRef('shopmain_quantity5_text');
const quantity10Label = createRef('shopmain_quantity10_text');
const quantity50Label = createRef('shopmain_quantity50_text');

export function Shopmain(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y={{ bottom: Layout.STRIP_BOTTOM }} w="fill" h={Layout.STRIP_H}>
        <sprite
          x="center"
          y={Layout.RULE_Y}
          w={{ fill: Layout.RULE_W_INSET }}
          h={Layout.RULE_H}
          sprite={ShopArt.STRIP_RULE}
          tiling
        />

        <text
          x={{ center: Layout.VALUE_LABEL_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.VALUE_LABEL_W}
          h={Layout.LABEL_H}
          text="Value check:"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={{ center: Layout.VALUE_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
          options={['Value']}
        />

        <sprite
          x={{ center: Layout.VALUE_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.VALUE_ICON}
          h={Layout.VALUE_ICON}
          sprite={ShopArt.VALUE_ICON}
        />

        <text
          x={{ center: Layout.QUANTITY_LABEL_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.QUANTITY_LABEL_W}
          h={Layout.LABEL_H}
          text="Quantity:"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={{ center: Layout.QUANTITY_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
          options={['Buy-1']}
          onMouseEnter={() => textColourSwapper(quantity1Label, ShopColors.LABEL_HOVER)}
          onMouseLeave={() => textColourSwapper(quantity1Label, ShopColors.LABEL)}
        />
        <text
          ref={quantity1Label}
          x={{ center: Layout.QUANTITY_X }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.LABEL_H}
          text="1"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
          options={['Buy-5']}
          onMouseEnter={() => textColourSwapper(quantity5Label, ShopColors.LABEL_HOVER)}
          onMouseLeave={() => textColourSwapper(quantity5Label, ShopColors.LABEL)}
        />
        <text
          ref={quantity5Label}
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP }}
          y={{ center: Layout.FIVE_LABEL_Y }}
          w={Layout.BUTTON}
          h={Layout.FIVE_LABEL_H}
          text="5"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP * 2 }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
          options={['Buy-10']}
          onMouseEnter={() => textColourSwapper(quantity10Label, ShopColors.LABEL_HOVER)}
          onMouseLeave={() => textColourSwapper(quantity10Label, ShopColors.LABEL)}
        />
        <text
          ref={quantity10Label}
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP * 2 }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.LABEL_H}
          text="10"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP * 3 }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
          options={['Buy-50']}
          onMouseEnter={() => textColourSwapper(quantity50Label, ShopColors.LABEL_HOVER)}
          onMouseLeave={() => textColourSwapper(quantity50Label, ShopColors.LABEL)}
        />
        <text
          ref={quantity50Label}
          x={{ center: Layout.QUANTITY_X + Layout.QUANTITY_STEP * 3 }}
          y={{ center: Layout.STRIP_ROW_Y }}
          w={Layout.BUTTON}
          h={Layout.LABEL_H}
          text="50"
          font={ShopFonts.LABEL}
          color={ShopColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />
      </layer>

      <ShopStock />
    </>
  );
}
