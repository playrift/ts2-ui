import { useServerState } from 'ts2';
import { ShopFlatStack } from './shop-stack-mode.data';
import { ShopQuantity, ShopVarbits } from './shopmain.constants';

export function shopQuantityLabel(quantity: Int): String {
  switch (quantity) {
    case ShopQuantity.VALUE:
      return 'Value';
    case ShopQuantity.ONE:
      return 'Buy 1';
    case ShopQuantity.FIVE:
      return 'Buy 5';
    case ShopQuantity.TEN:
      return 'Buy 10';
    case ShopQuantity.FIFTY:
      return 'Buy 50';
  }
  return '';
}

export function shopQuantity(): Int {
  return useServerState(ShopVarbits.QUANTITY);
}

export function shopStackFlat(inventory: Int): Boolean {
  if ((ShopFlatStack.get(inventory) ?? 0) === 1) {
    return true;
  }
  return false;
}

export function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}
