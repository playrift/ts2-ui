import { useServerState } from 'ts2';
import { PrayerbookSlot } from './prayerbook-slot.component';
import { Layout, Prayerbooks } from './horror-prayerbooks.constants';

export function PrayerbookGrid(): Component {
  return (
    <layer w="fill" h="fill">
      {Prayerbooks.map((book) => (
        <layer
          x={book.col === 0 ? 0 : book.col === 1 ? 'center' : 'right'}
          y={book.row === 0 ? 0 : 'bottom'}
          w={Layout.slot.W}
          h={Layout.slot.H}
        >
          <PrayerbookSlot
            god={book.god}
            owned={useServerState(book.state)}
            unfinished={book.unfinished}
            finished={book.finished}
          />
        </layer>
      ))}
    </layer>
  );
}
