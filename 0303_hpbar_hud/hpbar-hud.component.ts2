import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { HpBarColor, HpBarDodge, HpBarFont, HpBarSprite, Layout, REST_TRANSPARENCY } from './hpbar-hud.constants';
import { hpDodgerRelayout, hpHudPos, hpHudUpdate } from './hpbar-hud.helpers';

const universe = createRef('hpbar_hud_universe0');
const dodgerSide = createRef('hpbar_hud_hpdodgerside1');
const contentSide = createRef('hpbar_hud_hpcontentside18');
const dodger = createRef('hpbar_hud_hpdodger2');
const hp = createRef('hpbar_hud_hp3');
const outerBorder = createRef('hpbar_hud_outer_border11');
const nameBacking = createRef('hpbar_hud_name_backing12');
const nameArea = createRef('hpbar_hud_name_area4');
const creatureName = createRef('hpbar_hud_creature_name10');
const hpBar = createRef('hpbar_hud_hp_bar5');
const innerBorder = createRef('hpbar_hud_inner_border13');
const healthBarBack = createRef('hpbar_hud_health_bar_back7');
const healthBarSliding = createRef('hpbar_hud_health_bar_sliding8');
const healthBarRemaining = createRef('hpbar_hud_health_bar_remaining9');
const hpBarMark1 = createRef('hpbar_hud_hp_bar_116');
const hpBarMark2 = createRef('hpbar_hud_hp_bar_217');
const lowerThreshold = createRef('hpbar_hud_health_bar_lower_threshold14');
const upperThreshold = createRef('hpbar_hud_health_bar_upper_threshold15');
const hpBarText = createRef('hpbar_hud_hp_bar_text6');

export function HpBarHud(): Component {
  useInterval(
    () =>
      hpHudPos(
        universe,
        hp,
        nameArea,
        creatureName,
        hpBarText,
        healthBarBack,
        healthBarSliding,
        healthBarRemaining,
        lowerThreshold,
        upperThreshold,
        hpBarMark1,
        hpBarMark2,
        dodger,
        contentSide,
      ),
    universe,
  );
  useInterval(() => overlayRelayout(dodgerSide, contentSide, HpBarDodge.SIDE, Anchor.LEFT, Anchor.TOP, 1), dodgerSide);
  useInterval(() => hpDodgerRelayout(dodger, hp), dodger);
  useInterval(
    () =>
      hpHudUpdate(
        hp,
        hpBarText,
        healthBarBack,
        healthBarSliding,
        healthBarRemaining,
        nameArea,
        creatureName,
        lowerThreshold,
        upperThreshold,
        hpBarMark1,
        hpBarMark2,
        0,
      ),
    hpBarText,
  );

  return (
    <layer ref={universe} x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" />

      <layer ref={dodgerSide} x="center" y="center" w="fill" h="fill">
        <layer ref={contentSide} x={0} y={0} w={Layout.SIDE_W} h={Layout.SIDE_H} />
      </layer>

      <layer ref={dodger} x="center" y="center" w="fill" h="fill">
        <layer ref={hp} x="center" y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H} hide>
          <rect
            ref={outerBorder}
            x="center"
            y={Layout.BORDER_Y}
            w={{ fill: Layout.BORDER_INSET }}
            h={{ fill: Layout.BORDER_INSET }}
            color={HpBarColor.OUTLINE}
            transparency={REST_TRANSPARENCY}
          />

          <sprite
            ref={nameBacking}
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={HpBarSprite.BACKING}
            tiling
            transparency={REST_TRANSPARENCY}
          />

          <layer ref={nameArea} x="center" y={0} w="fill" h={Layout.NAME_H}>
            <text
              ref={creatureName}
              x="center"
              y={{ center: Layout.NAME_Y }}
              w={{ fill: Layout.NAME_INSET }}
              h="fill"
              font={HpBarFont.LABEL}
              text="-"
              align="center"
              valign="middle"
              shadow
              color={HpBarColor.NAME}
            />
          </layer>

          <layer
            ref={hpBar}
            x="center"
            y={{ bottom: Layout.BAR_BOTTOM }}
            w={{ fill: Layout.BAR_INSET }}
            h={Layout.BAR_H}
          >
            <rect
              ref={innerBorder}
              x="center"
              y="center"
              w={{ fill: Layout.BORDER_INSET }}
              h={{ fill: Layout.BORDER_INSET }}
              color={HpBarColor.OUTLINE}
              transparency={REST_TRANSPARENCY}
            />

            <layer x="center" y="center" w={{ fill: Layout.FILL_INSET }} h={{ fill: Layout.FILL_INSET }}>
              <rect
                ref={healthBarBack}
                x="center"
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.EMPTY}
                fill
                transparency={REST_TRANSPARENCY}
              />

              <rect
                ref={healthBarSliding}
                x={0}
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.SLIDE}
                fill
                transparency={REST_TRANSPARENCY}
              />

              <rect
                ref={healthBarRemaining}
                x={0}
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.REMAINING}
                fill
                transparency={REST_TRANSPARENCY}
              />
            </layer>

            <rect
              ref={hpBarMark1}
              x={Layout.MARK_X}
              y="center"
              w={Layout.MARK_W}
              h={{ fill: Layout.MARK_INSET }}
              color={HpBarColor.OUTLINE}
              fill
              hide
              transparency={REST_TRANSPARENCY}
            />

            <rect
              ref={hpBarMark2}
              x={Layout.MARK_X}
              y="center"
              w={Layout.MARK_W}
              h={{ fill: Layout.MARK_INSET }}
              color={HpBarColor.OUTLINE}
              fill
              hide
              transparency={REST_TRANSPARENCY}
            />

            <sprite
              ref={lowerThreshold}
              x={0}
              y="center"
              w={Layout.PIP_W}
              h={{ fill: Layout.PIP_INSET }}
              sprite={HpBarSprite.BRACKET_LOWER}
              hide
              transparency={REST_TRANSPARENCY}
            />

            <sprite
              ref={upperThreshold}
              x="right"
              y="center"
              w={Layout.PIP_W}
              h={{ fill: Layout.PIP_INSET }}
              sprite={HpBarSprite.BRACKET_UPPER}
              hide
              transparency={REST_TRANSPARENCY}
            />

            <text
              ref={hpBarText}
              x="center"
              y={{ center: Layout.TEXT_Y }}
              w="fill"
              h="fill"
              font={HpBarFont.LABEL}
              text="- / -"
              align="center"
              valign="middle"
              shadow
              color={HpBarColor.LABEL}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
