import { useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  HpBarColor,
  HpBarDodge,
  HpBarFont,
  HpBarSprite,
  Layout,
  REST_TRANSPARENCY,
  contentSideRef,
  creatureNameRef,
  dodgerRef,
  dodgerSideRef,
  healthBarBackRef,
  healthBarRemainingRef,
  healthBarSlidingRef,
  hpBarMark1Ref,
  hpBarMark2Ref,
  hpBarRef,
  hpBarTextRef,
  hpRef,
  innerBorderRef,
  lowerThresholdRef,
  nameAreaRef,
  nameBackingRef,
  outerBorderRef,
  universeRef,
  upperThresholdRef,
} from './hpbar-hud.constants';
import { hpDodgerRelayout, hpHudPos, hpHudUpdate } from './hpbar-hud.helpers';

export function HpBarHud(): Component {
  useInterval(
    () =>
      hpHudPos(
        universeRef,
        hpRef,
        nameAreaRef,
        creatureNameRef,
        hpBarTextRef,
        healthBarBackRef,
        healthBarSlidingRef,
        healthBarRemainingRef,
        lowerThresholdRef,
        upperThresholdRef,
        hpBarMark1Ref,
        hpBarMark2Ref,
        dodgerRef,
        contentSideRef,
      ),
    universeRef,
  );
  useInterval(
    () => overlayRelayout(dodgerSideRef, contentSideRef, HpBarDodge.SIDE, Anchor.LEFT, Anchor.TOP, 1),
    dodgerSideRef,
  );
  useInterval(() => hpDodgerRelayout(dodgerRef, hpRef), dodgerRef);
  useInterval(
    () =>
      hpHudUpdate(
        hpRef,
        hpBarTextRef,
        healthBarBackRef,
        healthBarSlidingRef,
        healthBarRemainingRef,
        nameAreaRef,
        creatureNameRef,
        lowerThresholdRef,
        upperThresholdRef,
        hpBarMark1Ref,
        hpBarMark2Ref,
        0,
      ),
    hpBarTextRef,
  );

  return (
    <layer ref={universeRef} x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" />

      <layer ref={dodgerSideRef} x="center" y="center" w="fill" h="fill">
        <layer ref={contentSideRef} x={0} y={0} w={Layout.SIDE_W} h={Layout.SIDE_H} />
      </layer>

      <layer ref={dodgerRef} x="center" y="center" w="fill" h="fill">
        <layer ref={hpRef} x="center" y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H} hide>
          <rect
            ref={outerBorderRef}
            x="center"
            y={Layout.BORDER_Y}
            w={{ fill: Layout.BORDER_INSET }}
            h={{ fill: Layout.BORDER_INSET }}
            color={HpBarColor.OUTLINE}
            transparency={REST_TRANSPARENCY}
          />

          <sprite
            ref={nameBackingRef}
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={HpBarSprite.BACKING}
            tiling
            transparency={REST_TRANSPARENCY}
          />

          <layer ref={nameAreaRef} x="center" y={0} w="fill" h={Layout.NAME_H}>
            <text
              ref={creatureNameRef}
              x="center"
              y={{ center: Layout.NAME_Y }}
              w={{ fill: Layout.NAME_INSET }}
              h="fill"
              font={HpBarFont.LABEL}
              text="-"
              align="center"
              valign="middle"
              shadow
              color={HpBarColor.NAME}
            />
          </layer>

          <layer
            ref={hpBarRef}
            x="center"
            y={{ bottom: Layout.BAR_BOTTOM }}
            w={{ fill: Layout.BAR_INSET }}
            h={Layout.BAR_H}
          >
            <rect
              ref={innerBorderRef}
              x="center"
              y="center"
              w={{ fill: Layout.BORDER_INSET }}
              h={{ fill: Layout.BORDER_INSET }}
              color={HpBarColor.OUTLINE}
              transparency={REST_TRANSPARENCY}
            />

            <layer x="center" y="center" w={{ fill: Layout.FILL_INSET }} h={{ fill: Layout.FILL_INSET }}>
              <rect
                ref={healthBarBackRef}
                x="center"
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.EMPTY}
                fill
                transparency={REST_TRANSPARENCY}
              />

              <rect
                ref={healthBarSlidingRef}
                x={0}
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.SLIDE}
                fill
                transparency={REST_TRANSPARENCY}
              />

              <rect
                ref={healthBarRemainingRef}
                x={0}
                y="center"
                w="fill"
                h="fill"
                color={HpBarColor.REMAINING}
                fill
                transparency={REST_TRANSPARENCY}
              />
            </layer>

            <rect
              ref={hpBarMark1Ref}
              x={Layout.MARK_X}
              y="center"
              w={Layout.MARK_W}
              h={{ fill: Layout.MARK_INSET }}
              color={HpBarColor.OUTLINE}
              fill
              hide
              transparency={REST_TRANSPARENCY}
            />

            <rect
              ref={hpBarMark2Ref}
              x={Layout.MARK_X}
              y="center"
              w={Layout.MARK_W}
              h={{ fill: Layout.MARK_INSET }}
              color={HpBarColor.OUTLINE}
              fill
              hide
              transparency={REST_TRANSPARENCY}
            />

            <sprite
              ref={lowerThresholdRef}
              x={0}
              y="center"
              w={Layout.PIP_W}
              h={{ fill: Layout.PIP_INSET }}
              sprite={HpBarSprite.BRACKET_LOWER}
              hide
              transparency={REST_TRANSPARENCY}
            />

            <sprite
              ref={upperThresholdRef}
              x="right"
              y="center"
              w={Layout.PIP_W}
              h={{ fill: Layout.PIP_INSET }}
              sprite={HpBarSprite.BRACKET_UPPER}
              hide
              transparency={REST_TRANSPARENCY}
            />

            <text
              ref={hpBarTextRef}
              x="center"
              y={{ center: Layout.TEXT_Y }}
              w="fill"
              h="fill"
              font={HpBarFont.LABEL}
              text="- / -"
              align="center"
              valign="middle"
              shadow
              color={HpBarColor.LABEL}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
