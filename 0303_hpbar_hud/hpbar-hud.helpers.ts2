import { predictServerState, useServerState, useState } from 'ts2';

import { minmax } from '../0811_lockpicking/lockpicking.state';
import { Fonts } from '../lib/game/fonts';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { hpbarFadeStatus, hpbarHudLastNpc, hpbarSliding } from '../lib/game/varcs';
import { clientClock, npcName, scaled, textLineCount } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayInit, overlayRelayout } from '../lib/lib.overlay';
import { BRUTUS_AT, FADE_STEP, FadeStatus, HpBarDodge, HpBarNpc, MAX_INT, Panel, Slide } from './hpbar-hud.constants';
import {
  hpbarBarWidth,
  hpbarCaption,
  hpbarFadeLevel,
  hpbarOpen,
  hpbarRemainingPx,
  hpbarRemainingTarget,
  hpbarSlideDeadline,
  hpbarSlideTarget,
  hpbarSlidingPx,
  hpbarSnap,
} from './hpbar-hud.state';

export function addCapped(value: Int, offset: Int, cap: Int): Int {
  if (cap - offset <= value) {
    return cap;
  }
  return value + offset;
}

export function npcDisplayName(npc: Npc, caption: String): String {
  if (npc === -1) {
    return '';
  }
  if (npc === HpBarNpc.DOM_BOSS || npc === HpBarNpc.DOM_BOSS_BURROWED || npc === HpBarNpc.DOM_BOSS_SHIELDED) {
    const floor: String = groupDigits(addCapped(useServerState(Varps.DOM_CURRENT_LEVEL_TEMP), 1, MAX_INT), ',');
    return `${caption} (Level ${floor})`;
  }
  if (npc === HpBarNpc.BULL_A || npc === HpBarNpc.BULL_B || npc === HpBarNpc.BULL_C) {
    if (useServerState(Varbits.VARBIT_20106) >= BRUTUS_AT) {
      return 'Brutus';
    }
    return 'Bull';
  }
  return caption;
}

export function npcCaption(npcId: Int): String {
  if (npcId === -1) {
    return '';
  }
  const npc: Npc = npcId as Npc;
  const caption: String = npcDisplayName(npc, npc.caption!);
  if (caption.length === 0) {
    return npcName(npc);
  }
  return caption;
}

export function fitCaption(caption: String, width: Int): String {
  let fitted: String = caption;
  while (textLineCount(fitted, width, Fonts.P11_FULL) > 1) {
    fitted = `${fitted.slice(0, fitted.length - 4)}...`;
  }
  return fitted;
}

export function plateHasName(caption: String): Boolean {
  if (caption.length === 0) {
    return false;
  }
  if (useServerState(Varbits.HPBAR_HUD_BOSS_NAME_DISABLED) === 1) {
    return false;
  }
  return true;
}

export function plateWidth(stage: Int): Int {
  if (useServerState(Varbits.HPBAR_HUD_BOSS) === 1 && !onMobile()) {
    if (useServerState(Varbits.HPBAR_HUD_BOSS_COMPACT_ENABLED) === 1) {
      return minmax(Panel.COMPACT_MIN, Panel.COMPACT_MAX, scaled(1, Panel.COMPACT_SHARE, stage));
    }
    return minmax(Panel.WIDE_MIN, Panel.WIDE_MAX, scaled(1, Panel.WIDE_SHARE, stage));
  }
  return Panel.NARROW;
}

export function plateCentred(): Boolean {
  if (useServerState(Varbits.HPBAR_HUD_BOSS) === 1 && !onMobile()) {
    return true;
  }
  return false;
}

export function filledPx(health: Int, base: Int, barWidth: Int): Int {
  let filled: Int = scaled(health, base, barWidth);
  if (filled === 0 && health > 0) {
    filled = 1;
  }
  if (filled === barWidth && health < base) {
    filled = filled - 1;
  }
  return filled;
}

export function healthLabel(npcId: Int, health: Int, base: Int): String {
  let percentage: Boolean = false;
  if (useServerState(Varbits.HPBAR_HUD_BOSS_PERCENTAGE_ENABLED) === 1) {
    percentage = true;
  } else if (npcId !== -1 && (npcId as Npc).percentage! === 1) {
    percentage = true;
  }
  if (!percentage) {
    return `${health} / ${useServerState(Varbits.HPBAR_HUD_BASEHP)}`;
  }
  let percent: Int = minmax(1, 99, scaled(health, base, 100));
  if (health <= 0) {
    percent = 0;
  } else if (health >= base) {
    percent = 100;
  }
  return `${percent}%`;
}

export function markX(mark: Int, base: Int, barWidth: Int): Int {
  return scaled(mark - 1, base, barWidth);
}

export function markShown(mark: Int, base: Int): Boolean {
  if (mark > 0 && mark <= base + 1) {
    return true;
  }
  return false;
}

export function fadeStep(): void {
  const [direction, setDirection] = useState(hpbarFadeStatus);
  const [level, setLevel] = useState(hpbarFadeLevel);
  if (direction === FadeStatus.IN) {
    const next: Int = Math.max(0, level - FADE_STEP);
    setLevel(next);
    if (next <= 0) {
      setDirection(FadeStatus.IDLE);
    }
  } else if (direction === FadeStatus.OUT) {
    const next: Int = Math.min(255, level + FADE_STEP);
    setLevel(next);
    if (next >= 255) {
      setDirection(FadeStatus.IDLE);
    }
  }
}

export function updateBars(barWidth: Int): void {
  const npcId: Int = useServerState(Varps.HPBAR_HUD_NPC);
  const health: Int = useServerState(Varbits.HPBAR_HUD_HP);
  const base: Int = Math.max(useServerState(Varbits.HPBAR_HUD_BASEHP), 1);
  predictServerState(Varbits.HPBAR_HUD_BASEHP, base);
  const target: Int = filledPx(health, base, barWidth);

  const [remaining, setRemaining] = useState(hpbarRemainingPx);
  const [sliding, setSliding] = useState(hpbarSlidingPx);
  const [, setSlideTarget] = useState(hpbarSlideTarget);
  const [, setDeadline] = useState(hpbarSlideDeadline);
  const [snap, setSnap] = useState(hpbarSnap);
  const [measured, setMeasured] = useState(hpbarBarWidth);
  const [walking] = useState(hpbarSliding);
  const [, setRemainingTarget] = useState(hpbarRemainingTarget);

  if (npcId !== -1) {
    const [, setCaption] = useState(hpbarCaption);
    setCaption(npcCaption(npcId));
  }

  let remainingNow: Int = remaining;
  let slidingNow: Int = sliding;
  if (npcId !== -1 && (npcId as Npc).seedOnePixel! === true && remainingNow === 0 && target > 0) {
    remainingNow = 1;
    slidingNow = 1;
  }

  if (snap === 1 || measured !== barWidth || remainingNow === 0) {
    setRemaining(target);
    setSliding(target);
    setSlideTarget(target);
    setDeadline(Slide.NO_DEADLINE);
    setRemainingTarget(-1);
    setSnap(0);
    setMeasured(barWidth);
    return;
  }

  if (target < remainingNow) {
    const wasFilled: Int = remainingNow;
    remainingNow = target;
    if (slidingNow < wasFilled) {
      slidingNow = wasFilled;
    }
    setSlideTarget(target);
    if (walking === 0) {
      setDeadline(clientClock() + Slide.DELAY_CYCLES);
    } else {
      setDeadline(clientClock());
    }
    setRemainingTarget(-1);
  } else {
    setRemainingTarget(target);
  }
  setRemaining(remainingNow);
  setSliding(slidingNow);
}

export function walkBars(): void {
  const [remaining, setRemaining] = useState(hpbarRemainingPx);
  const [sliding, setSliding] = useState(hpbarSlidingPx);
  const [slideTarget] = useState(hpbarSlideTarget);
  const [deadline, setDeadline] = useState(hpbarSlideDeadline);
  const [, setWalking] = useState(hpbarSliding);
  const [remainingTarget, setRemainingTarget] = useState(hpbarRemainingTarget);

  if (deadline !== Slide.NO_DEADLINE && clientClock() >= deadline) {
    if (sliding === slideTarget) {
      setDeadline(Slide.NO_DEADLINE);
      setWalking(0);
    } else {
      setWalking(1);
      if (sliding < slideTarget) {
        setSliding(sliding + 1);
      } else {
        setSliding(sliding - 1);
      }
    }
  }
  if (remainingTarget === -1) {
    return;
  }
  if (remaining === remainingTarget) {
    setWalking(0);
    setRemainingTarget(-1);
  } else if (remaining < remainingTarget) {
    setWalking(1);
    setRemaining(remaining + 1);
  }
}

export function hpDodgerInit(dodger: ComponentId, content: ComponentId): void {
  if (useServerState(Varbits.HPBAR_HUD_BOSS) === 1 && !onMobile()) {
    overlayInit(dodger, content, HpBarDodge.BOSS, Anchor.CENTRE, Anchor.TOP, 0);
  } else if (useServerState(Varbits.HPBAR_HUD_BOSS) === 0 && !onMobile()) {
    overlayInit(dodger, content, HpBarDodge.STANDARD, Anchor.LEFT, Anchor.TOP, 1);
  } else {
    overlayInit(dodger, content, HpBarDodge.MOBILE, Anchor.LEFT, Anchor.TOP, 1);
  }
}

export function hpDodgerRelayout(dodger: ComponentId, content: ComponentId): void {
  if (useServerState(Varbits.HPBAR_HUD_BOSS) === 1 && !onMobile()) {
    overlayRelayout(dodger, content, HpBarDodge.BOSS, Anchor.CENTRE, Anchor.TOP, 0);
  } else if (useServerState(Varbits.HPBAR_HUD_BOSS) === 0 && !onMobile()) {
    overlayRelayout(dodger, content, HpBarDodge.STANDARD, Anchor.LEFT, Anchor.TOP, 1);
  } else {
    overlayRelayout(dodger, content, HpBarDodge.MOBILE, Anchor.LEFT, Anchor.TOP, 1);
  }
}

function restingLevel(npcId: Int): Int {
  if (npcId !== -1 && (npcId as Npc).noFade! === 1) {
    return 0;
  }
  if (useServerState(Varbits.HPBAR_HUD_BOSS) === 0) {
    return 0;
  }
  return 255;
}

export function hpHudOpen(): void {
  const npcId: Int = useServerState(Varps.HPBAR_HUD_NPC);
  const [lastNpc, setLastNpc] = useState(hpbarHudLastNpc);
  const [open, setOpen] = useState(hpbarOpen);
  const [direction, setDirection] = useState(hpbarFadeStatus);
  const [, setLevel] = useState(hpbarFadeLevel);
  const [, setSnap] = useState(hpbarSnap);
  const rest: Int = restingLevel(npcId);

  if (open === 1) {
    if (direction === FadeStatus.OUT) {
      if (rest === 0) {
        setLevel(0);
      }
      setDirection(FadeStatus.IN);
      fadeStep();
      setSnap(1);
    }
    if (lastNpc !== npcId) {
      setSnap(1);
    }
    setLastNpc(npcId);
    return;
  }

  setLastNpc(npcId);
  setOpen(1);
  setLevel(rest);
  setDirection(FadeStatus.IN);
  fadeStep();
  fadeStep();
  setSnap(1);
}

export function hpHudFadeOut(): void {
  const [, setDirection] = useState(hpbarFadeStatus);
  setDirection(FadeStatus.OUT);
  fadeStep();
}
