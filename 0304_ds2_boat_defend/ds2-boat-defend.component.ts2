import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BoatDefendColor, BoatDefendDodge, BoatDefendFont, Layout } from './ds2-boat-defend.constants';

const timerHost = createRef('0304_ds2_boat_defend_timer_host');

const content = createRef('ds2_boat_defend_content');

export function Ds2BoatDefend_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, BoatDefendDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer x="center" y={Layout.BAR_Y} w={{ fill: Layout.BAR_INSET }} h={Layout.BAR_H}>
            <rect
              x={{ right: Layout.BAR_X }}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={BoatDefendColor.DAMAGE}
              fill
            />

            <rect
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={BoatDefendColor.INTEGRITY}
              fill
            />

            <rect
              x={Layout.OUTLINE_X}
              y={Layout.OUTLINE_Y}
              w={Layout.OUTLINE_W}
              h={Layout.OUTLINE_H}
              color={BoatDefendColor.OUTLINE}
            />

            <text
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              font={BoatDefendFont.LABEL}
              text="Ship Integrity"
              align="center"
              valign="middle"
              color={BoatDefendColor.OUTLINE}
            />
          </layer>

          <layer x="center" y={{ bottom: Layout.CLOCK_BOTTOM }} w={{ fill: Layout.BAR_INSET }} h={Layout.CLOCK_STRIP_H}>
            <text
              x={Layout.CLOCK_X}
              y={Layout.CLOCK_Y}
              w={Layout.CLOCK_W}
              h={Layout.CLOCK_H}
              font={BoatDefendFont.LABEL}
              text="Time Left: 5:00"
              valign="middle"
              shadow
              color={BoatDefendColor.CLOCK}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
