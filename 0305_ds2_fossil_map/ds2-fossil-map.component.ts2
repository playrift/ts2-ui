import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { rotatePiece, stuckPiece, swapPieces } from './ds2-fossil-map.actions';
import {
  FossilMapArt,
  FossilMapGrid,
  FossilMapOps,
  FossilMapView,
  FossilModels,
  FossilPieces,
  MOVABLE_A1_A4,
  MOVABLE_A6_C5,
  MOVABLE_D2,
  MOVABLE_D4_E6,
  MOVABLE_F2_F6,
} from './ds2-fossil-map.constants';
import { angleOf, pieceOf } from './ds2-fossil-map.slots';

export function Ds2FossilMap(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={FossilMapGrid.BOARD}
        h={FossilMapGrid.BOARD}
        model={FossilModels.BOARD}
        zoom={610}
        pitch={512}
      />

      <layer x="center" y="center" w={FossilMapGrid.BOARD} h={FossilMapGrid.BOARD}>
        <FossilMapPieces />
      </layer>

      <sprite
        right={56}
        y={12}
        w={26}
        h={23}
        sprite={FossilMapArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapperUnlessMobile(event.component, FossilMapArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapperUnlessMobile(event.component, FossilMapArt.CLOSE);
        }}
      />
    </>
  );
}

export function FossilMapPieces(): Component {
  return (
    <>
      {MOVABLE_A1_A4.map((slot) => (
        <model
          x={FossilMapGrid.TILE * (slot % FossilMapGrid.COLUMNS)}
          y={FossilMapGrid.TILE * (slot / FossilMapGrid.COLUMNS)}
          w={FossilMapGrid.TILE}
          h={FossilMapGrid.TILE}
          model={FossilPieces.get(pieceOf(slot))}
          pitch={FossilMapView.PITCH}
          yaw={FossilMapView.QUARTER * angleOf(slot)}
          zoom={FossilMapView.ZOOM}
          options={['Rotate-right', 'Rotate-left']}
          onOptionSelect={(event) => rotatePiece(event.option, event.subId)}
          dragDeadZone={FossilMapOps.DRAG_DEAD_ZONE}
          dragDeadTime={FossilMapOps.DRAG_DEAD_TIME}
          onDragComplete={(event) => swapPieces(event.component, event.subId, event.dragTarget, event.dragTargetSubId)}
        />
      ))}
      <model
        x={FossilMapGrid.TILE * (4 % FossilMapGrid.COLUMNS)}
        y={FossilMapGrid.TILE * (4 / FossilMapGrid.COLUMNS)}
        w={FossilMapGrid.TILE}
        h={FossilMapGrid.TILE}
        model={FossilModels.STUCK_A5}
        pitch={FossilMapView.PITCH}
        zoom={FossilMapView.ZOOM}
        options={['', '', '', '', '', '', '', '', '', 'Check']}
        onOptionSelect={(event) => stuckPiece(event.option, FossilMapOps.CHECK_MASK)}
      />
      {MOVABLE_A6_C5.map((slot) => (
        <model
          x={FossilMapGrid.TILE * (slot % FossilMapGrid.COLUMNS)}
          y={FossilMapGrid.TILE * (slot / FossilMapGrid.COLUMNS)}
          w={FossilMapGrid.TILE}
          h={FossilMapGrid.TILE}
          model={FossilPieces.get(pieceOf(slot))}
          pitch={FossilMapView.PITCH}
          yaw={FossilMapView.QUARTER * angleOf(slot)}
          zoom={FossilMapView.ZOOM}
          options={['Rotate-right', 'Rotate-left']}
          onOptionSelect={(event) => rotatePiece(event.option, event.subId)}
          dragDeadZone={FossilMapOps.DRAG_DEAD_ZONE}
          dragDeadTime={FossilMapOps.DRAG_DEAD_TIME}
          onDragComplete={(event) => swapPieces(event.component, event.subId, event.dragTarget, event.dragTargetSubId)}
        />
      ))}
      <model
        x={FossilMapGrid.TILE * (17 % FossilMapGrid.COLUMNS)}
        y={FossilMapGrid.TILE * (17 / FossilMapGrid.COLUMNS)}
        w={FossilMapGrid.TILE}
        h={FossilMapGrid.TILE}
        model={FossilModels.STUCK_C6}
        pitch={FossilMapView.PITCH}
        zoom={FossilMapView.ZOOM}
        options={['', '', '', '', '', '', '', '', '', 'Check']}
        onOptionSelect={(event) => stuckPiece(event.option, FossilMapOps.CHECK_MASK)}
      />
      <model
        x={FossilMapGrid.TILE * (18 % FossilMapGrid.COLUMNS)}
        y={FossilMapGrid.TILE * (18 / FossilMapGrid.COLUMNS)}
        w={FossilMapGrid.TILE}
        h={FossilMapGrid.TILE}
        model={FossilModels.STUCK_D1}
        pitch={FossilMapView.PITCH}
        zoom={FossilMapView.ZOOM}
        options={['', '', '', '', '', '', '', '', '', 'Check']}
        onOptionSelect={(event) => stuckPiece(event.option, FossilMapOps.CHECK_MASK)}
      />
      {MOVABLE_D2.map((slot) => (
        <model
          x={FossilMapGrid.TILE * (slot % FossilMapGrid.COLUMNS)}
          y={FossilMapGrid.TILE * (slot / FossilMapGrid.COLUMNS)}
          w={FossilMapGrid.TILE}
          h={FossilMapGrid.TILE}
          model={FossilPieces.get(pieceOf(slot))}
          pitch={FossilMapView.PITCH}
          yaw={FossilMapView.QUARTER * angleOf(slot)}
          zoom={FossilMapView.ZOOM}
          options={['Rotate-right', 'Rotate-left']}
          onOptionSelect={(event) => rotatePiece(event.option, event.subId)}
          dragDeadZone={FossilMapOps.DRAG_DEAD_ZONE}
          dragDeadTime={FossilMapOps.DRAG_DEAD_TIME}
          onDragComplete={(event) => swapPieces(event.component, event.subId, event.dragTarget, event.dragTargetSubId)}
        />
      ))}
      <model
        x={FossilMapGrid.TILE * (20 % FossilMapGrid.COLUMNS)}
        y={FossilMapGrid.TILE * (20 / FossilMapGrid.COLUMNS)}
        w={FossilMapGrid.TILE}
        h={FossilMapGrid.TILE}
        model={FossilModels.STUCK_D3}
        pitch={FossilMapView.PITCH}
        zoom={FossilMapView.ZOOM}
        options={['', '', '', '', '', '', '', '', '', 'Check']}
        onOptionSelect={(event) => stuckPiece(event.option, FossilMapOps.CHECK_MASK)}
      />
      {MOVABLE_D4_E6.map((slot) => (
        <model
          x={FossilMapGrid.TILE * (slot % FossilMapGrid.COLUMNS)}
          y={FossilMapGrid.TILE * (slot / FossilMapGrid.COLUMNS)}
          w={FossilMapGrid.TILE}
          h={FossilMapGrid.TILE}
          model={FossilPieces.get(pieceOf(slot))}
          pitch={FossilMapView.PITCH}
          yaw={FossilMapView.QUARTER * angleOf(slot)}
          zoom={FossilMapView.ZOOM}
          options={['Rotate-right', 'Rotate-left']}
          onOptionSelect={(event) => rotatePiece(event.option, event.subId)}
          dragDeadZone={FossilMapOps.DRAG_DEAD_ZONE}
          dragDeadTime={FossilMapOps.DRAG_DEAD_TIME}
          onDragComplete={(event) => swapPieces(event.component, event.subId, event.dragTarget, event.dragTargetSubId)}
        />
      ))}
      <model
        x={FossilMapGrid.TILE * (30 % FossilMapGrid.COLUMNS)}
        y={FossilMapGrid.TILE * (30 / FossilMapGrid.COLUMNS)}
        w={FossilMapGrid.TILE}
        h={FossilMapGrid.TILE}
        model={FossilModels.STUCK_F1}
        pitch={FossilMapView.PITCH}
        zoom={FossilMapView.ZOOM}
        options={['', '', '', '', '', '', '', '', '', 'Check']}
        onOptionSelect={(event) => stuckPiece(event.option, FossilMapOps.CHECK_MASK)}
      />
      {MOVABLE_F2_F6.map((slot) => (
        <model
          x={FossilMapGrid.TILE * (slot % FossilMapGrid.COLUMNS)}
          y={FossilMapGrid.TILE * (slot / FossilMapGrid.COLUMNS)}
          w={FossilMapGrid.TILE}
          h={FossilMapGrid.TILE}
          model={FossilPieces.get(pieceOf(slot))}
          pitch={FossilMapView.PITCH}
          yaw={FossilMapView.QUARTER * angleOf(slot)}
          zoom={FossilMapView.ZOOM}
          options={['Rotate-right', 'Rotate-left']}
          onOptionSelect={(event) => rotatePiece(event.option, event.subId)}
          dragDeadZone={FossilMapOps.DRAG_DEAD_ZONE}
          dragDeadTime={FossilMapOps.DRAG_DEAD_TIME}
          onDragComplete={(event) => swapPieces(event.component, event.subId, event.dragTarget, event.dragTargetSubId)}
        />
      ))}
    </>
  );
}
