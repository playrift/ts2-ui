import { predictServerState, useServerState } from 'ts2';

import { FossilMapVarbits } from './ds2-fossil-map.constants';

export function pieceOf(slot: Int): Int {
  switch (slot) {
    case 0:
      return useServerState(FossilMapVarbits.A1_PIECE);
    case 1:
      return useServerState(FossilMapVarbits.A2_PIECE);
    case 2:
      return useServerState(FossilMapVarbits.A3_PIECE);
    case 3:
      return useServerState(FossilMapVarbits.A4_PIECE);
    case 5:
      return useServerState(FossilMapVarbits.A6_PIECE);
    case 6:
      return useServerState(FossilMapVarbits.B1_PIECE);
    case 7:
      return useServerState(FossilMapVarbits.B2_PIECE);
    case 8:
      return useServerState(FossilMapVarbits.B3_PIECE);
    case 9:
      return useServerState(FossilMapVarbits.B4_PIECE);
    case 10:
      return useServerState(FossilMapVarbits.B5_PIECE);
    case 11:
      return useServerState(FossilMapVarbits.B6_PIECE);
    case 12:
      return useServerState(FossilMapVarbits.C1_PIECE);
    case 13:
      return useServerState(FossilMapVarbits.C2_PIECE);
    case 14:
      return useServerState(FossilMapVarbits.C3_PIECE);
    case 15:
      return useServerState(FossilMapVarbits.C4_PIECE);
    case 16:
      return useServerState(FossilMapVarbits.C5_PIECE);
    case 19:
      return useServerState(FossilMapVarbits.D2_PIECE);
    case 21:
      return useServerState(FossilMapVarbits.D4_PIECE);
    case 22:
      return useServerState(FossilMapVarbits.D5_PIECE);
    case 23:
      return useServerState(FossilMapVarbits.D6_PIECE);
    case 24:
      return useServerState(FossilMapVarbits.E1_PIECE);
    case 25:
      return useServerState(FossilMapVarbits.E2_PIECE);
    case 26:
      return useServerState(FossilMapVarbits.E3_PIECE);
    case 27:
      return useServerState(FossilMapVarbits.E4_PIECE);
    case 28:
      return useServerState(FossilMapVarbits.E5_PIECE);
    case 29:
      return useServerState(FossilMapVarbits.E6_PIECE);
    case 31:
      return useServerState(FossilMapVarbits.F2_PIECE);
    case 32:
      return useServerState(FossilMapVarbits.F3_PIECE);
    case 33:
      return useServerState(FossilMapVarbits.F4_PIECE);
    case 34:
      return useServerState(FossilMapVarbits.F5_PIECE);
    case 35:
      return useServerState(FossilMapVarbits.F6_PIECE);
  }
  return 0;
}

export function angleOf(slot: Int): Int {
  switch (slot) {
    case 0:
      return useServerState(FossilMapVarbits.A1_ANGLE);
    case 1:
      return useServerState(FossilMapVarbits.A2_ANGLE);
    case 2:
      return useServerState(FossilMapVarbits.A3_ANGLE);
    case 3:
      return useServerState(FossilMapVarbits.A4_ANGLE);
    case 5:
      return useServerState(FossilMapVarbits.A6_ANGLE);
    case 6:
      return useServerState(FossilMapVarbits.B1_ANGLE);
    case 7:
      return useServerState(FossilMapVarbits.B2_ANGLE);
    case 8:
      return useServerState(FossilMapVarbits.B3_ANGLE);
    case 9:
      return useServerState(FossilMapVarbits.B4_ANGLE);
    case 10:
      return useServerState(FossilMapVarbits.B5_ANGLE);
    case 11:
      return useServerState(FossilMapVarbits.B6_ANGLE);
    case 12:
      return useServerState(FossilMapVarbits.C1_ANGLE);
    case 13:
      return useServerState(FossilMapVarbits.C2_ANGLE);
    case 14:
      return useServerState(FossilMapVarbits.C3_ANGLE);
    case 15:
      return useServerState(FossilMapVarbits.C4_ANGLE);
    case 16:
      return useServerState(FossilMapVarbits.C5_ANGLE);
    case 19:
      return useServerState(FossilMapVarbits.D2_ANGLE);
    case 21:
      return useServerState(FossilMapVarbits.D4_ANGLE);
    case 22:
      return useServerState(FossilMapVarbits.D5_ANGLE);
    case 23:
      return useServerState(FossilMapVarbits.D6_ANGLE);
    case 24:
      return useServerState(FossilMapVarbits.E1_ANGLE);
    case 25:
      return useServerState(FossilMapVarbits.E2_ANGLE);
    case 26:
      return useServerState(FossilMapVarbits.E3_ANGLE);
    case 27:
      return useServerState(FossilMapVarbits.E4_ANGLE);
    case 28:
      return useServerState(FossilMapVarbits.E5_ANGLE);
    case 29:
      return useServerState(FossilMapVarbits.E6_ANGLE);
    case 31:
      return useServerState(FossilMapVarbits.F2_ANGLE);
    case 32:
      return useServerState(FossilMapVarbits.F3_ANGLE);
    case 33:
      return useServerState(FossilMapVarbits.F4_ANGLE);
    case 34:
      return useServerState(FossilMapVarbits.F5_ANGLE);
    case 35:
      return useServerState(FossilMapVarbits.F6_ANGLE);
  }
  return 0;
}

export function setSlot(slot: Int, piece: Int, angle: Int): void {
  switch (slot) {
    case 0:
      predictServerState(FossilMapVarbits.A1_PIECE, piece);
      predictServerState(FossilMapVarbits.A1_ANGLE, angle);
      return;
    case 1:
      predictServerState(FossilMapVarbits.A2_PIECE, piece);
      predictServerState(FossilMapVarbits.A2_ANGLE, angle);
      return;
    case 2:
      predictServerState(FossilMapVarbits.A3_PIECE, piece);
      predictServerState(FossilMapVarbits.A3_ANGLE, angle);
      return;
    case 3:
      predictServerState(FossilMapVarbits.A4_PIECE, piece);
      predictServerState(FossilMapVarbits.A4_ANGLE, angle);
      return;
    case 5:
      predictServerState(FossilMapVarbits.A6_PIECE, piece);
      predictServerState(FossilMapVarbits.A6_ANGLE, angle);
      return;
    case 6:
      predictServerState(FossilMapVarbits.B1_PIECE, piece);
      predictServerState(FossilMapVarbits.B1_ANGLE, angle);
      return;
    case 7:
      predictServerState(FossilMapVarbits.B2_PIECE, piece);
      predictServerState(FossilMapVarbits.B2_ANGLE, angle);
      return;
    case 8:
      predictServerState(FossilMapVarbits.B3_PIECE, piece);
      predictServerState(FossilMapVarbits.B3_ANGLE, angle);
      return;
    case 9:
      predictServerState(FossilMapVarbits.B4_PIECE, piece);
      predictServerState(FossilMapVarbits.B4_ANGLE, angle);
      return;
    case 10:
      predictServerState(FossilMapVarbits.B5_PIECE, piece);
      predictServerState(FossilMapVarbits.B5_ANGLE, angle);
      return;
    case 11:
      predictServerState(FossilMapVarbits.B6_PIECE, piece);
      predictServerState(FossilMapVarbits.B6_ANGLE, angle);
      return;
    case 12:
      predictServerState(FossilMapVarbits.C1_PIECE, piece);
      predictServerState(FossilMapVarbits.C1_ANGLE, angle);
      return;
    case 13:
      predictServerState(FossilMapVarbits.C2_PIECE, piece);
      predictServerState(FossilMapVarbits.C2_ANGLE, angle);
      return;
    case 14:
      predictServerState(FossilMapVarbits.C3_PIECE, piece);
      predictServerState(FossilMapVarbits.C3_ANGLE, angle);
      return;
    case 15:
      predictServerState(FossilMapVarbits.C4_PIECE, piece);
      predictServerState(FossilMapVarbits.C4_ANGLE, angle);
      return;
    case 16:
      predictServerState(FossilMapVarbits.C5_PIECE, piece);
      predictServerState(FossilMapVarbits.C5_ANGLE, angle);
      return;
    case 19:
      predictServerState(FossilMapVarbits.D2_PIECE, piece);
      predictServerState(FossilMapVarbits.D2_ANGLE, angle);
      return;
    case 21:
      predictServerState(FossilMapVarbits.D4_PIECE, piece);
      predictServerState(FossilMapVarbits.D4_ANGLE, angle);
      return;
    case 22:
      predictServerState(FossilMapVarbits.D5_PIECE, piece);
      predictServerState(FossilMapVarbits.D5_ANGLE, angle);
      return;
    case 23:
      predictServerState(FossilMapVarbits.D6_PIECE, piece);
      predictServerState(FossilMapVarbits.D6_ANGLE, angle);
      return;
    case 24:
      predictServerState(FossilMapVarbits.E1_PIECE, piece);
      predictServerState(FossilMapVarbits.E1_ANGLE, angle);
      return;
    case 25:
      predictServerState(FossilMapVarbits.E2_PIECE, piece);
      predictServerState(FossilMapVarbits.E2_ANGLE, angle);
      return;
    case 26:
      predictServerState(FossilMapVarbits.E3_PIECE, piece);
      predictServerState(FossilMapVarbits.E3_ANGLE, angle);
      return;
    case 27:
      predictServerState(FossilMapVarbits.E4_PIECE, piece);
      predictServerState(FossilMapVarbits.E4_ANGLE, angle);
      return;
    case 28:
      predictServerState(FossilMapVarbits.E5_PIECE, piece);
      predictServerState(FossilMapVarbits.E5_ANGLE, angle);
      return;
    case 29:
      predictServerState(FossilMapVarbits.E6_PIECE, piece);
      predictServerState(FossilMapVarbits.E6_ANGLE, angle);
      return;
    case 31:
      predictServerState(FossilMapVarbits.F2_PIECE, piece);
      predictServerState(FossilMapVarbits.F2_ANGLE, angle);
      return;
    case 32:
      predictServerState(FossilMapVarbits.F3_PIECE, piece);
      predictServerState(FossilMapVarbits.F3_ANGLE, angle);
      return;
    case 33:
      predictServerState(FossilMapVarbits.F4_PIECE, piece);
      predictServerState(FossilMapVarbits.F4_ANGLE, angle);
      return;
    case 34:
      predictServerState(FossilMapVarbits.F5_PIECE, piece);
      predictServerState(FossilMapVarbits.F5_ANGLE, angle);
      return;
    case 35:
      predictServerState(FossilMapVarbits.F6_PIECE, piece);
      predictServerState(FossilMapVarbits.F6_ANGLE, angle);
      return;
  }
}
