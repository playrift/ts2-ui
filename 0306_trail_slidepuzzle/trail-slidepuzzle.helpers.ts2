export function puzzleItem(variant: Int, slot: Int): Item {
  if (variant === PuzzleVariant.REINITIALISATION_DONE) {
    const done = useInventory(Inventories.REINITIALISATION_INV_INACTIVE);
    return done[slot];
  }
  if (variant === PuzzleVariant.REINITIALISATION) {
    const live = useInventory(Inventories.REINITIALISATION_INV);
    return live[slot];
  }
  if (variant === PuzzleVariant.BAS) {
    const bas = useInventory(Inventories.BAS_PUZZLE_INV);
    return bas[slot];
  }
  const trail = useInventory(Inventories.TRAIL_PUZZLEINV);
  return trail[slot];
}

export function pieceModel(variant: Int, slot: Int, basProgress: Int): Model {
  const piece: Item = puzzleItem(variant, slot);
  if (piece === BasPuzzle.HIDDEN_PIECE) {
    if (basProgress < BasPuzzle.SOLVED) {
      return TileModel.NONE;
    }
  }
  return PieceModels.get(piece) ?? TileModel.NONE;
}

export function tilesMovable(
  indexes: Map<Item, Int> | null,
  items: Map<Int, ItemName> | null,
  variant: Int,
  basProgress: Int,
): Boolean {
  if (items === null) {
    return false;
  }
  if (indexes === null) {
    return false;
  }
  if (variant === PuzzleVariant.REINITIALISATION_DONE) {
    return false;
  }
  if (variant === PuzzleVariant.BAS) {
    if (basProgress >= BasPuzzle.SOLVED) {
      return false;
    }
  }
  return true;
}

function slidePiece(from: Int, into: Int, piece: Int): Boolean {
  if (pieceAt(into) !== -1) {
    return false;
  }
  CS2.sound_effect(PuzzleSounds.SLIDE, 1, 0);
  setPieceAt(into, piece);
  setPieceAt(from, -1);
  const [, setLastMove] = useState(slotinfoOther00);
  setLastMove(clientClock());
  return true;
}

export function movePiece(op: Int, slot: Int): void {
  if (op !== 1) {
    return;
  }
  const piece: Int = pieceAt(slot);
  if (piece === -1) {
    return;
  }
  const column: Int = slot % PuzzleLayout.COLUMNS;
  const row: Int = slot / PuzzleLayout.COLUMNS;
  if (column > 0) {
    if (slidePiece(slot, column - 1 + row * PuzzleLayout.COLUMNS, piece)) {
      return;
    }
  }
  if (column < PuzzleLayout.COLUMNS - 1) {
    if (slidePiece(slot, column + 1 + row * PuzzleLayout.COLUMNS, piece)) {
      return;
    }
  }
  if (row > 0) {
    if (slidePiece(slot, column + (row - 1) * PuzzleLayout.COLUMNS, piece)) {
      return;
    }
  }
  if (row < PuzzleLayout.ROWS - 1) {
    if (slidePiece(slot, column + (row + 1) * PuzzleLayout.COLUMNS, piece)) {
      return;
    }
  }
  CS2.sound_effect(PuzzleSounds.BLOCKED, 1, 0);
}
