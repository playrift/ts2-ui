import { createRef } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { CataBossDodge, CataBossModel, CataBossSprite, Layout } from './cata-boss.constants';

const timerHost = createRef('0308_cata_boss_timer_host');

const cataAltars = createRef('cata_boss_cata_altars');

export function CataBoss_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        ref={timerHost}
        onLoad={() => overlayInit(timerHost, cataAltars, CataBossDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={cataAltars} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite
            x="center"
            y="center"
            w={Layout.ORB_W}
            h={Layout.ORB_H}
            sprite={CataBossSprite.ORB}
            outline={Layout.ORB_OUTLINE}
          />

          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={CataBossModel.ALTAR}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
            yaw={Layout.MODEL_YAW}
            offsetY={Layout.MODEL_OFFSET_Y}
          />

          <sprite
            x={Layout.MARKER_SIDE_INSET}
            y="center"
            w={Layout.MARKER_BOX}
            h={Layout.MARKER_BOX}
            sprite={CataBossSprite.MARKER}
          />

          <sprite
            x={{ right: Layout.MARKER_SIDE_INSET }}
            y="center"
            w={Layout.MARKER_BOX}
            h={Layout.MARKER_BOX}
            sprite={CataBossSprite.MARKER}
          />

          <sprite
            x="center"
            y={{ bottom: Layout.MARKER_END_INSET }}
            w={Layout.MARKER_BOX}
            h={Layout.MARKER_BOX}
            sprite={CataBossSprite.MARKER}
          />

          <sprite
            x="center"
            y={Layout.MARKER_END_INSET}
            w={Layout.MARKER_BOX}
            h={Layout.MARKER_BOX}
            sprite={CataBossSprite.MARKER}
          />
        </layer>
      </layer>
    </layer>
  );
}
