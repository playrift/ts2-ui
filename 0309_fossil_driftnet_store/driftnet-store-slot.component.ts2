import { useRef, useServerState } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import {
  Colors,
  Content,
  FADE_CYCLES,
  FossilItem,
  FossilVarbits,
  Transparency,
} from './fossil-driftnet-store.constants';

export function DriftnetStoreSlot(): Component {
  const stock: Int = useServerState(FossilVarbits.STORE);
  const cell = useRef();

  if (stock <= 0) {
    return (
      <sprite
        x="center"
        y="center"
        w={Content.SLOT_WIDTH}
        h={Content.SLOT_HEIGHT}
        item={FossilItem.DRIFT_NET}
        itemCount={stock}
        outline={1}
        shadowColor={Colors.SLOT_SHADOW}
        transparency={Transparency.DIM}
      />
    );
  }

  return (
    <sprite
      ref={cell}
      x="center"
      y="center"
      w={Content.SLOT_WIDTH}
      h={Content.SLOT_HEIGHT}
      item={FossilItem.DRIFT_NET}
      itemCount={stock}
      outline={1}
      shadowColor={Colors.SLOT_SHADOW}
      transparency={Transparency.CLEAR}
      options={['Withdraw-1', 'Withdraw-5', 'Withdraw-X', 'Withdraw-All', '', '', '', '', 'Banknote-All', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(FossilItem.DRIFT_NET)}</col>`}
      onOptionSelect={() => {
        flashFor(cell, Transparency.DIM, Transparency.CLEAR);
      }}
    />
  );
}
