import { CS2 } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { DriftnetStoreSlot } from './driftnet-store-slot.component';
import { Content, FossilAnim, FossilModel, FossilNpc } from './fossil-driftnet-store.constants';

export function annetteHead(who: ComponentId): void {
  CS2.if_npc_head_set(FossilNpc.ANNETTE, who);
  CS2.if_model_anim_set(FossilAnim.CHAT_IDLE, who);
}

export function FossilDriftnetStore(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Annette's Nets" />

      <layer
        x="center"
        y={{ bottom: Content.BOTTOM }}
        w={{ fill: Content.WIDTH_INSET }}
        h={{ fill: Content.HEIGHT_INSET }}
      >
        <model
          x={Content.RACK_X}
          y={Content.MODEL_Y}
          w={Content.MODEL_SIZE}
          h={Content.MODEL_SIZE}
          model={FossilModel.NET_RACK}
          zoom={FossilModel.RACK_ZOOM}
          pitch={FossilModel.RACK_PITCH}
          yaw={FossilModel.RACK_YAW}
        />

        <model
          x={Content.HEAD_X}
          y={Content.MODEL_Y}
          w={Content.MODEL_SIZE}
          h={Content.MODEL_SIZE}
          onLoad={(event) => annetteHead(event.self)}
          zoom={FossilModel.HEAD_ZOOM}
          pitch={FossilModel.HEAD_PITCH}
          yaw={FossilModel.HEAD_YAW}
        />

        <layer
          x={{ right: Content.SLOT_RIGHT }}
          y={{ bottom: Content.SLOT_BOTTOM }}
          w={Content.SLOT_WIDTH}
          h={Content.SLOT_HEIGHT}
        >
          <DriftnetStoreSlot />
        </layer>
      </layer>
    </>
  );
}
