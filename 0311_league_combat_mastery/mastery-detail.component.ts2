import { CS2, useState } from 'ts2';

import { textLineCount, textWidth } from '../lib/lib.engine';
import { onMobile, textDevice } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorder } from '../lib/steel-border.component';
import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { colourTag } from '../0889_nps/colour-tag';

import {
  EFFECT_PANE,
  EXTRA_PANE,
  MasteryColour,
  MasteryFonts,
  MasteryScrollbar,
  MasterySounds,
} from './league-combat-mastery.constants';
import { CombatMasteries, MasteryPassives } from './league-combat-mastery.data';
import { masteryAccent, masteryDetailBack, masteryRefused, masteryState } from './league-combat-mastery.helpers';
import { confirmOpen, detailMastery, detailPassive, extraOpen, masteryLoading } from './league-combat-mastery.state';

function pageW(windowW: Int): Int {
  return windowW - 12;
}

function pageH(windowH: Int): Int {
  return windowH - 41 - 46;
}

function descriptionOf(mastery: Int): String {
  const row = CombatMasteries.at(mastery);
  if (row === null) {
    return '';
  }
  return row.description;
}

function passiveTextOf(passive: Int): String {
  const row = MasteryPassives.get(passive);
  if (row === null) {
    return '';
  }
  return row.description;
}

function effectTextH(mastery: Int, windowW: Int): Int {
  return textLineCount(descriptionOf(mastery), pageW(windowW) - 148 - 32, MasteryFonts.BODY) * 15;
}

function passiveTextH(passive: Int, windowW: Int): Int {
  return textLineCount(passiveTextOf(passive), pageW(windowW) - 148 - 14, MasteryFonts.BODY) * 15;
}

function effectContentH(mastery: Int, windowW: Int): Int {
  return effectTextH(mastery, windowW) + 12 + 20;
}

function pageRoom(windowH: Int): Int {
  return pageH(windowH) - 41;
}

function overflows(mastery: Int, windowW: Int, windowH: Int): Boolean {
  return effectContentH(mastery, windowW) > pageRoom(windowH) - 53;
}

function effectBoxH(mastery: Int, windowW: Int, windowH: Int): Int {
  if (overflows(mastery, windowW, windowH)) {
    return pageH(windowH) - 96;
  }
  return effectContentH(mastery, windowW) + 6;
}

function passiveBoxBranchH(mastery: Int, windowW: Int, windowH: Int): Int {
  if (overflows(mastery, windowW, windowH)) {
    return 53;
  }
  return pageRoom(windowH) - effectContentH(mastery, windowW) - 8;
}

function collapsed(mastery: Int, passive: Int, windowW: Int, windowH: Int): Boolean {
  if (passive === -1) {
    return false;
  }
  return passiveTextH(passive, windowW) > passiveBoxBranchH(mastery, windowW, windowH) - 33;
}

function passiveBoxH(mastery: Int, passive: Int, windowW: Int, windowH: Int): Int {
  if (passive === -1) {
    return passiveBoxBranchH(mastery, windowW, windowH);
  }
  if (collapsed(mastery, passive, windowW, windowH)) {
    return 53;
  }
  return 33 + passiveTextH(passive, windowW);
}

export function detailWindowHeight(mastery: Int, passive: Int, windowW: Int, windowH: Int): Int {
  const both: Int = effectBoxH(mastery, windowW, windowH) + passiveBoxH(mastery, passive, windowW, windowH) + 2;
  if (both > 192) {
    return windowH;
  }
  return 320;
}

export function MasteryDetail({ windowW, windowH }: { windowW: Int; windowH: Int }): Component {
  const [mastery] = useState(detailMastery);
  if (mastery === -1) {
    return null;
  }
  const [passive] = useState(detailPassive);
  const row = CombatMasteries.at(mastery);
  const name: String = row === null ? '' : row.name;
  const art: Sprite = row === null ? -1 : row.art;
  const accent: Int = masteryAccent();
  const content: Int = effectContentH(mastery, windowW);
  const effectH: Int = effectBoxH(mastery, windowW, windowH);
  const over: Boolean = overflows(mastery, windowW, windowH);
  const passiveH: Int = passiveBoxH(mastery, passive, windowW, windowH);
  const folded: Boolean = collapsed(mastery, passive, windowW, windowH);
  const hasPassive: Boolean = passive !== -1;
  const state: Int = masteryState(mastery);
  return (
    <>
      <text
        x={10}
        y={9}
        w={{ fill: 150 }}
        h={16}
        text={`${colourTag(accent, 'u')}${name}</u>`}
        font={MasteryFonts.HEADING}
        color={accent}
        align="center"
        valign="top"
        shadow
      />
      <layer x={8} y={33} w={{ fill: 148 }} h={effectH}>
        <rect x={0} y={0} w="fill" h="fill" color={MasteryColour.BOX_OUTER} />
        <rect x={1} y={1} w={{ fill: 2 }} h={{ fill: 2 }} color={MasteryColour.BOX_INNER} />
        <layer
          ref={EFFECT_PANE}
          x={7}
          y={2}
          w={{ fill: 32 }}
          h={{ fill: 4 }}
          scrollHeight={content > effectH - 4 ? content : 0}
          scrollY={0}
        >
          <text
            x={0}
            y={6}
            w="fill"
            h={20}
            text="Combat Mastery Effect:"
            font={MasteryFonts.HEADING}
            color={accent}
            align="left"
            valign="top"
            shadow
          />
          <text
            x={0}
            y={26}
            w="fill"
            h={effectTextH(mastery, windowW)}
            text={descriptionOf(mastery)}
            font={MasteryFonts.BODY}
            color={accent}
            align="left"
            valign="top"
            lineHeight={15}
            shadow
          />
        </layer>
        <layer x={{ right: 2 }} y={2} w={16} h={{ fill: 4 }}>
          <ScrollbarVertical
            content={EFFECT_PANE}
            track={MasteryScrollbar.TRACK}
            capTopSprite={MasteryScrollbar.CAP_TOP}
            thumbSprite={MasteryScrollbar.THUMB}
            capBottomSprite={MasteryScrollbar.CAP_BOTTOM}
            arrowUp={MasteryScrollbar.ARROW_UP}
            arrowDown={MasteryScrollbar.ARROW_DOWN}
          />
        </layer>
      </layer>
      <layer x={8} y={over ? { bottom: 8 } : content + 41} w={{ fill: 148 }} h={passiveH}>
        <rect x={0} y={0} w="fill" h="fill" color={MasteryColour.BOX_OUTER} />
        <rect x={1} y={1} w={{ fill: 2 }} h={{ fill: 2 }} color={MasteryColour.BOX_INNER} />
        <text
          x={7}
          y={8}
          w={{ fill: 14 }}
          h={15}
          text={hasPassive ? 'Passive Effect:' : ''}
          font={MasteryFonts.HEADING}
          color={accent}
          align="left"
          valign="top"
          shadow
          hide={!hasPassive}
        />
        <text
          x={7}
          y={28}
          w={{ fill: 14 }}
          h={{ fill: 33 }}
          text={hasPassive ? (folded ? `${textDevice('Click', 'Tap')} to expand...` : passiveTextOf(passive)) : ''}
          font={MasteryFonts.BODY}
          color={accent}
          align="left"
          valign="top"
          lineHeight={15}
          shadow
          hide={!hasPassive}
        />
        <ExpandClick shown={hasPassive && folded} />
      </layer>
      <layer x={{ right: 7 }} y={7} w={120} h={{ fill: 15 }}>
        <sprite x="center" y={10} w={120} h={120} sprite={art} />
        <layer x={{ right: 0 }} y={{ bottom: 52 }} w={120} h={25}>
          <SelectButton state={state} name={name} />
        </layer>
        <layer x={{ right: 0 }} y={{ bottom: 20 }} w={120} h={25}>
          <SheetButton label="Back" subject="" colour={MasteryColour.WHITE} action={0} />
        </layer>
      </layer>
    </>
  );
}

function ExpandClick({ shown }: { shown: Boolean }): Component {
  const [hovered, setHovered] = useState(0);
  const [, setExtra] = useState(extraOpen);
  return (
    <rect
      x={0}
      y={0}
      w="fill"
      h="fill"
      fill
      color={MasteryColour.BLACK}
      transparency={hovered === 1 ? 220 : 255}
      hide={!shown}
      options={shown ? ['Expand'] : undefined}
      onMouseRepeat={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => {
        CS2.sound_effect(MasterySounds.SELECT, 1, 0);
        setExtra(1);
      }}
    />
  );
}

function SelectButton({ state, name }: { state: Int; name: String }): Component {
  const [hovered, setHovered] = useState(0);
  const [, setConfirm] = useState(confirmOpen);
  const mobile: Boolean = onMobile();
  if (state === 1) {
    return (
      <layer
        x={0}
        y={0}
        w="fill"
        h="fill"
        options={['Select']}
        optionSubject={`<col=ff981f>${name}</col>`}
        onMouseRepeat={mobile ? undefined : () => setHovered(1)}
        onMouseLeave={mobile ? undefined : () => setHovered(0)}
        onOptionSelect={() => {
          CS2.sound_effect(MasterySounds.SELECT, 1, 0);
          setHovered(0);
          setConfirm(1);
        }}
      >
        {hovered === 1 ? <StoneButtonPressed /> : <StoneButton />}
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="Select"
          font={MasteryFonts.BODY}
          color={hovered === 1 ? MasteryColour.HOVER : MasteryColour.SELECT}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    );
  }
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      options={[state === 2 ? 'Unlocked' : 'Locked']}
      onOptionSelect={() => masteryRefused(state)}
    >
      <StoneButtonPressed />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={state === 2 ? 'Unlocked' : 'Locked'}
        font={MasteryFonts.BODY}
        color={MasteryColour.LOCKED}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}

function SheetButton({
  label,
  subject,
  colour,
  action,
}: {
  label: String;
  subject: String;
  colour: Int;
  action: Int;
}): Component {
  const [hovered, setHovered] = useState(0);
  const [, setConfirm] = useState(confirmOpen);
  const mobile: Boolean = onMobile();
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      options={[label]}
      optionSubject={subject}
      onMouseRepeat={mobile ? undefined : () => setHovered(1)}
      onMouseLeave={mobile ? undefined : () => setHovered(0)}
      onOptionSelect={() => {
        if (action === 0) {
          masteryDetailBack();
        } else {
          CS2.sound_effect(MasterySounds.SELECT, 1, 0);
          if (action === 2) {
            setConfirm(0);
          }
        }
      }}
    >
      {hovered === 1 ? <StoneButtonPressed /> : <StoneButton />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={MasteryFonts.BODY}
        color={hovered === 1 ? MasteryColour.HOVER : colour}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}

export function MasteryConfirm(): Component {
  const [open] = useState(confirmOpen);
  const [mastery] = useState(detailMastery);
  const row = CombatMasteries.at(mastery);
  const name: String = row === null ? '' : row.name;
  const accent: Int = masteryAccent();
  return (
    <layer x={0} y={0} w="fill" h="fill" hide={open === 0} noClickThrough>
      <rect x={0} y={0} w="fill" h="fill" fill transparency={128} />
      <layer x="center" y="center" w={300} h={180}>
        <layer x="center" y="center" w={300} h={180}>
          <SteelBorder title={name} titleColor={accent} flags={1} />
        </layer>
        <text
          x="center"
          y={40}
          w={{ fill: 20 }}
          h={95}
          text={`Are you sure that you wish to unlock the <col=ffffff>${name}</col> Combat mastery?<br><br>You <col=ffffff>cannot</col> go back on this decision at any later point.`}
          font={MasteryFonts.BODY}
          color={accent}
          align="left"
          valign="top"
          lineHeight={15}
          shadow
        />
        <layer x={{ right: 10 }} y={{ bottom: 10 }} w={125} h={25}>
          <SheetButton label="Confirm" subject="<col=ff981f>Selection</col>" colour={MasteryColour.WHITE} action={1} />
        </layer>
        <layer x={10} y={{ bottom: 10 }} w={125} h={25}>
          <SheetButton label="Cancel" subject="" colour={MasteryColour.WHITE} action={2} />
        </layer>
      </layer>
    </layer>
  );
}

export function MasteryLoadingSheet(): Component {
  const [loading] = useState(masteryLoading);
  return (
    <layer x="center" y="center" w="fill" h="fill" hide={loading === 0} noClickThrough>
      <rect x="center" y="center" w="fill" h="fill" fill transparency={128} />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text="Loading..."
        font={MasteryFonts.HEADING}
        color={MasteryColour.WHITE}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}

export function ExtraOverlay({ windowW }: { windowW: Int }): Component {
  const [open, setOpen] = useState(extraOpen);
  const [passive] = useState(detailPassive);
  const text: String = passiveTextOf(passive);
  const mobile: Boolean = onMobile();
  const wide: Int = pageW(windowW) - 52;
  const narrow: Int = pageW(windowW) - 68;
  const wideH: Int = textLineCount(text, wide, MasteryFonts.BODY) * 15;
  const fits: Boolean = wideH <= 139;
  const textW: Int = Math.max(125, textWidth(text, fits ? wide : narrow, MasteryFonts.BODY));
  const narrowH: Int = textLineCount(text, narrow, MasteryFonts.BODY) * 15;
  const accent: Int = masteryAccent();
  return (
    <layer x="center" y="center" w="fill" h="fill" hide={open === 0} noClickThrough>
      <rect
        x={0}
        y={0}
        w="fill"
        h="fill"
        fill
        transparency={75}
        options={['Close']}
        onOptionSelect={() => {
          CS2.sound_effect(MasterySounds.SELECT, 1, 0);
          setOpen(0);
        }}
      />
      <layer
        x="center"
        y="center"
        noClickThrough
        w={fits ? textW + 22 : textW + 38}
        h={fits ? 57 + wideH : { fill: 30 }}
      >
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorder title={open === 1 ? 'Passive Effects' : ''} titleColor={accent} flags={1} />
        </layer>
        <layer x="center" y="center" w="fill" h="fill">
          <layer
            x={{ right: mobile ? 1 : 3 }}
            y={mobile ? 1 : 6}
            w={mobile ? 33 : 26}
            h={mobile ? 33 : 23}
            options={['Close']}
            onOptionSelect={() => {
              CS2.sound_effect(MasterySounds.SELECT, 1, 0);
              setOpen(0);
            }}
          >
            <sprite
              x="center"
              y="center"
              w={mobile ? 33 : 26}
              h={mobile ? 33 : 23}
              sprite={mobile ? 1731 : 535}
              hover={{ sprite: mobile ? 1731 : 536 }}
              tiling
            />
          </layer>
          <layer
            ref={EXTRA_PANE}
            x={8}
            y={{ bottom: 8 }}
            w={{ fill: fits ? 16 : 32 }}
            h={{ fill: 45 }}
            scrollHeight={fits ? 0 : narrowH + 12}
            scrollY={0}
          >
            <sprite x={0} y={0} w="fill" h="fill" sprite={897} tiling />
            <text
              x={3}
              y={6}
              w={textW}
              h={fits ? { fill: 6 } : narrowH + 12}
              text={text}
              font={MasteryFonts.BODY}
              color={accent}
              align="left"
              valign="top"
              lineHeight={15}
              shadow
            />
            <ThinBoxEntrypoint />
          </layer>
          <layer x={{ right: 8 }} y={{ bottom: 8 }} w={16} h={{ fill: 45 }} hide={fits}>
            {!fits && (
              <ScrollbarVertical
                content={EXTRA_PANE}
                track={MasteryScrollbar.TRACK}
                capTopSprite={MasteryScrollbar.CAP_TOP}
                thumbSprite={MasteryScrollbar.THUMB}
                capBottomSprite={MasteryScrollbar.CAP_BOTTOM}
                arrowUp={MasteryScrollbar.ARROW_UP}
                arrowDown={MasteryScrollbar.ARROW_DOWN}
              />
            )}
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
