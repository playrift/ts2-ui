      <SmithingCell slot={19} width={Grid.W} x={Grid.COL_3} y={Grid.ROW_3} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={20} width={Grid.W} x={Grid.COL_3} y={Grid.ROW_4} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={21} width={Grid.W} x={Grid.COL_4} y={Grid.ROW_0} w={Grid.W} h={Grid.H} />
