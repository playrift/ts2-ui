      <SmithingCell slot={9} width={Grid.W} x={Grid.COL_1} y={Grid.ROW_3} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={10} width={Grid.W} x={Grid.COL_1} y={Grid.ROW_4} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={11} width={Grid.W} x={Grid.COL_2} y={Grid.ROW_0} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={12} width={Grid.W} x={Grid.COL_2} y={Grid.ROW_1} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={13} width={Grid.W} x={Grid.COL_2} y={Grid.ROW_2} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={14} width={Grid.W} x={Grid.COL_2} y={Grid.ROW_3} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={15} width={Grid.W} x={Grid.COL_2} y={Grid.ROW_4} w={Grid.W} h={Grid.H} />
      <SmithingCell slot={16} width={Grid.W} x={Grid.COL_3} y={Grid.ROW_0} w={Grid.W} h={Grid.H} />
