import { createRef } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { SmokeAnims, SmokeCamera, SmokeGradient, SmokeModel } from './smokeoverlay.constants';

const smokeHaze = createRef('smokeoverlay_haze');

export function Smokeoverlay(): Component {
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onTimer={(event) =>
        modelTransparentDynamicZoom(
          event.component,
          smokeHaze,
          SmokeCamera.NEAR,
          SmokeCamera.FAR,
          SmokeCamera.OFFSET_X,
          SmokeCamera.OFFSET_Y,
          SmokeCamera.PITCH,
          SmokeCamera.YAW,
          SmokeCamera.ROLL,
        )
      }
    >
      <model
        ref={smokeHaze}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={SmokeModel.HAZE}
        anim={SmokeAnims.HAZE}
        zoom={SmokeCamera.NEAR}
      />

      <rect
        x="center"
        y="bottom"
        w="fill"
        h={SmokeGradient.HEIGHT}
        fill={true}
        color={SmokeGradient.COLOR}
        blendColor={SmokeGradient.BLEND}
        transparency={SmokeGradient.TRANSPARENCY}
        transparencyBottom={SmokeGradient.TRANSPARENCY_BOTTOM}
        fillMode={SmokeGradient.FILL_MODE}
      />
    </layer>
  );
}
