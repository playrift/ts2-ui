import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, TrailMapArt, TrailMapModel } from './trail-map20.constants';

export function TrailMap20(): Component {
  return (
    <>
      <model
        x={{ center: Layout.MODEL_X }}
        y="center"
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={TrailMapModel.MAP}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        offsetX={Camera.OFFSET_X}
        offsetY={Camera.OFFSET_Y}
      />

      <sprite
        x={{ center: Layout.CLOSE_X }}
        y={{ center: Layout.CLOSE_Y }}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={TrailMapArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, TrailMapArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TrailMapArt.CLOSE)}
      />
    </>
  );
}
