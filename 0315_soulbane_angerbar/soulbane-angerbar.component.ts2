import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { AngerBar, AngerColor, AngerFont, Layout, SegmentX, Wash } from './soulbane-angerbar.constants';

const timerHost = createRef('0315_soulbane_angerbar_timer_host');

const container = createRef('soulbane_angerbar_container1');

export function SoulbaneAngerbar(): Component {
  useInterval(() => overlayRelayout(timerHost, container, AngerBar.DODGE, Anchor.CENTRE, Anchor.TOP, 0), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={container} x="center" y={0} w={Layout.BOARD_W} h={Layout.BOARD_H}>
          {SegmentX.map((x) => (
            <layer x={x} y={Layout.SEGMENT_Y} w={Layout.SEGMENT_W} h={Layout.SEGMENT_H}>
              <rect
                x={0}
                y={0}
                w={Layout.BLOCK_W}
                h={Layout.BLOCK_H}
                color={AngerColor.SEGMENT}
                fill
                transparency={Wash.SEGMENT}
              />
            </layer>
          ))}

          <rect
            x={Layout.FRAME_LEFT_X}
            y={Layout.FRAME_UPRIGHT_Y}
            w={Layout.FRAME_UPRIGHT_W}
            h={Layout.FRAME_UPRIGHT_H}
            color={AngerColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RAIL_X}
            y={Layout.FRAME_BOTTOM_Y}
            w={Layout.FRAME_RAIL_W}
            h={Layout.FRAME_RAIL_H}
            color={AngerColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RIGHT_X}
            y={Layout.FRAME_UPRIGHT_Y}
            w={Layout.FRAME_UPRIGHT_W}
            h={Layout.FRAME_UPRIGHT_H}
            color={AngerColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RAIL_X}
            y={Layout.FRAME_TOP_Y}
            w={Layout.FRAME_RAIL_W}
            h={Layout.FRAME_RAIL_H}
            color={AngerColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_Y}
            w={Layout.CAPTION_W}
            h={Layout.CAPTION_H}
            font={AngerFont.CAPTION}
            text="Rage level"
            align="center"
            shadow
            color={AngerColor.CAPTION}
          />
        </layer>
      </layer>
    </layer>
  );
}
