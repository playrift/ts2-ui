import { useDerived } from 'ts2';
import { getWarningSetting, resetWarningToggleIcon } from '../lib/lib.helpers';
import { WarningSprites } from '../lib/lib.constants';

export function CwsWarningToggle({ message }: { message: Int }): Component {
  const setting = useDerived(() => getWarningSetting(message));
  return (
    <sprite
      w="fill"
      h="fill"
      sprite={setting === 7 ? WarningSprites.ICON_2 : WarningSprites.ICON_1}
      options={['Off/On']}
      onClick={(event) => resetWarningToggleIcon(event.component)}
    />
  );
}
