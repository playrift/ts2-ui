import { closeInterface, graphicSwapper, setWarningHoverColor } from '../lib/lib.helpers';
import { CwsWarningToggle } from './cws-warning-toggle.component';
import { Content, Frame, WarningArt, WarningColor, WarningFont } from './cws-warning.constants';

export function CwsWarning({
  message,
  body,
  answers = true,
  yes = '',
  no = '',
  again = "Don't ask me this again",
  yesOption = 'Yes',
  noOption = 'No',
  yesY = 157,
  noY = 189,
  yesH = 15,
  noH = 15,
  bodyX = 108,
  bodyY = 68,
  rowX = 107,
  rowY = 220,
  rowW = 270,
  rowH = 20,
  backdropH = 203,
  leftH = 154,
  rightH = 155,
  bottomY = 231,
  cornerBottomY = 219,
}: {
  message: Int;
  body: String;
  answers?: Boolean;
  yes?: String;
  no?: String;
  yesOption?: String;
  noOption?: String;
  yesY?: Int;
  noY?: Int;
  yesH?: Int;
  noH?: Int;
  again?: String;
  bodyX?: Int;
  bodyY?: Int;
  rowX?: Int;
  rowY?: Int;
  rowW?: Int;
  rowH?: Int;
  backdropH?: Int;
  leftH?: Int;
  rightH?: Int;
  bottomY?: Int;
  cornerBottomY?: Int;
}): Component {
  return (
    <>
      <sprite
        x={Frame.BACKDROP_X}
        y={Frame.BACKDROP_Y}
        w={Frame.BACKDROP_W}
        h={backdropH}
        sprite={WarningArt.BACKDROP}
        tiling
        optionSubject=" "
      />

      <sprite x={Frame.LEFT_X} y={Frame.LEFT_Y} w={Frame.LEFT_W} h={leftH} sprite={WarningArt.LEFT} tiling />

      <sprite
        x={Frame.CORNER_LEFT_X}
        y={Frame.CORNER_TOP_Y}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.TOP_LEFT}
      />

      <sprite x={Frame.RIGHT_X} y={Frame.RIGHT_Y} w={Frame.RIGHT_W} h={rightH} sprite={WarningArt.RIGHT} tiling />

      <sprite
        x={Frame.TOP_X}
        y={Frame.TOP_Y}
        w={Frame.TOP_W}
        h={Frame.TOP_H}
        sprite={WarningArt.TOP}
        tiling
        optionSubject=" "
      />

      <sprite
        x={Frame.BOTTOM_X}
        y={bottomY}
        w={Frame.BOTTOM_W}
        h={Frame.BOTTOM_H}
        sprite={WarningArt.BOTTOM}
        tiling
        optionSubject=" "
      />

      <sprite
        x={Frame.CORNER_LEFT_X}
        y={cornerBottomY}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.BOTTOM_LEFT}
      />

      <sprite
        x={Frame.CORNER_RIGHT_X}
        y={Frame.CORNER_TOP_Y}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.TOP_RIGHT}
      />

      <sprite
        x={Frame.CORNER_RIGHT_X}
        y={cornerBottomY}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.BOTTOM_RIGHT}
      />

      <sprite
        x={Frame.TITLE_BAR_X}
        y={Frame.TITLE_BAR_Y}
        w={Frame.TITLE_BAR_W}
        h={Frame.TITLE_BAR_H}
        sprite={WarningArt.TITLE_BAR}
        tiling
      />

      <sprite
        x={Frame.CORNER_LEFT_X}
        y={Frame.TITLE_CAP_Y}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.TITLE_LEFT}
      />
      <sprite
        x={Frame.CORNER_RIGHT_X}
        y={Frame.TITLE_CAP_Y}
        w={Frame.CORNER_W}
        h={Frame.CORNER_H}
        sprite={WarningArt.TITLE_RIGHT}
      />

      <sprite
        x={Frame.CLOSE_X}
        y={Frame.CLOSE_Y}
        w={Frame.CLOSE_W}
        h={Frame.CLOSE_H}
        sprite={WarningArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, WarningArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, WarningArt.CLOSE)}
      />

      <text
        x={Content.TITLE_X}
        y={Content.TITLE_Y}
        w={Content.TITLE_W}
        h={Content.TITLE_H}
        text="Warning!"
        font={WarningFont.TITLE}
        color={WarningColor.TITLE}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x={bodyX}
        y={bodyY}
        w={Content.BODY_W}
        h={Content.BODY_H}
        text={body}
        font={WarningFont.BODY}
        color={WarningColor.BODY}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={Content.TRIANGLE_LEFT_X}
        y={Content.TRIANGLE_Y}
        w={Content.TRIANGLE_W}
        h={Content.TRIANGLE_H}
        sprite={WarningArt.TRIANGLE}
      />
      <sprite
        x={Content.TRIANGLE_RIGHT_X}
        y={Content.TRIANGLE_Y}
        w={Content.TRIANGLE_W}
        h={Content.TRIANGLE_H}
        sprite={WarningArt.TRIANGLE}
      />

      {answers && (
        <>
          <text
            x={Content.OPTION_X}
            y={yesY}
            w={Content.OPTION_W}
            h={yesH}
            text={yes}
            font={WarningFont.BODY}
            color={WarningColor.OPTION}
            align="center"
            valign="middle"
            shadow
            options={[yesOption]}
            onMouseEnter={(event) => setWarningHoverColor(event.component, WarningColor.OPTION_HOVER)}
            onMouseLeave={(event) => setWarningHoverColor(event.component, WarningColor.OPTION)}
          />
          <text
            x={Content.OPTION_X}
            y={noY}
            w={Content.OPTION_W}
            h={noH}
            text={no}
            font={WarningFont.BODY}
            color={WarningColor.OPTION}
            align="center"
            valign="middle"
            shadow
            options={[noOption]}
            onMouseEnter={(event) => setWarningHoverColor(event.component, WarningColor.OPTION_HOVER)}
            onMouseLeave={(event) => setWarningHoverColor(event.component, WarningColor.OPTION)}
          />
        </>
      )}

      <layer x={rowX} y={rowY} w={rowW} h={rowH} hide>
        <text
          x={Content.LABEL_X}
          y={Content.LABEL_Y}
          w={Content.LABEL_W}
          h={Content.LABEL_H}
          text={again}
          font={WarningFont.BODY}
          color={WarningColor.TITLE}
          align="center"
          valign="middle"
          shadow
        />

        <layer x={Content.CHECK_X} y={Content.CHECK_Y} w={Content.CHECK_W} h={Content.CHECK_H}>
          <CwsWarningToggle message={message} />
        </layer>
      </layer>
    </>
  );
}
