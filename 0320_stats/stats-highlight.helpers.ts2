import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Skills } from './stats.constants';

export function skillHighlight(skill: Int): Int {
  if (skill === Skills.ATTACK) {
    return useServerState(Varbits.VARBIT_20175);
  }
  if (skill === Skills.STRENGTH) {
    return useServerState(Varbits.VARBIT_20161);
  }
  if (skill === Skills.RANGED) {
    return useServerState(Varbits.VARBIT_20183);
  }
  if (skill === Skills.MAGIC) {
    return useServerState(Varbits.VARBIT_20171);
  }
  if (skill === Skills.DEFENCE) {
    return useServerState(Varbits.VARBIT_20178);
  }
  if (skill === Skills.HITPOINTS) {
    return useServerState(Varbits.VARBIT_20165);
  }
  if (skill === Skills.PRAYER) {
    return useServerState(Varbits.VARBIT_20170);
  }
  if (skill === Skills.AGILITY) {
    return useServerState(Varbits.VARBIT_20162);
  }
  if (skill === Skills.HERBLORE) {
    return useServerState(Varbits.VARBIT_20181);
  }
  if (skill === Skills.THIEVING) {
    return useServerState(Varbits.VARBIT_20168);
  }
  if (skill === Skills.CRAFTING) {
    return useServerState(Varbits.VARBIT_20177);
  }
  if (skill === Skills.RUNECRAFT) {
    return useServerState(Varbits.VARBIT_20167);
  }
  if (skill === Skills.MINING) {
    return useServerState(Varbits.VARBIT_20166);
  }
  if (skill === Skills.SMITHING) {
    return useServerState(Varbits.VARBIT_20184);
  }
  if (skill === Skills.FISHING) {
    return useServerState(Varbits.VARBIT_20164);
  }
  if (skill === Skills.COOKING) {
    return useServerState(Varbits.VARBIT_20176);
  }
  if (skill === Skills.FIREMAKING) {
    return useServerState(Varbits.VARBIT_20163);
  }
  if (skill === Skills.WOODCUTTING) {
    return useServerState(Varbits.VARBIT_20169);
  }
  if (skill === Skills.FLETCHING) {
    return useServerState(Varbits.VARBIT_20180);
  }
  if (skill === Skills.SLAYER) {
    return useServerState(Varbits.VARBIT_20173);
  }
  if (skill === Skills.FARMING) {
    return useServerState(Varbits.VARBIT_20179);
  }
  if (skill === Skills.CONSTRUCTION) {
    return useServerState(Varbits.VARBIT_20174);
  }
  if (skill === Skills.HUNTER) {
    return useServerState(Varbits.VARBIT_20182);
  }
  if (skill === Skills.SAILING) {
    return useServerState(Varbits.VARBIT_20172);
  }
  return 0;
}
