import { useSkill, useSkillBase } from 'ts2';

import { Skills } from './stats.constants';

export function skillLevel(skill: Int): Int {
  if (skill === Skills.ATTACK) {
    return useSkill(Skills.ATTACK);
  }
  if (skill === Skills.DEFENCE) {
    return useSkill(Skills.DEFENCE);
  }
  if (skill === Skills.STRENGTH) {
    return useSkill(Skills.STRENGTH);
  }
  if (skill === Skills.HITPOINTS) {
    return useSkill(Skills.HITPOINTS);
  }
  if (skill === Skills.RANGED) {
    return useSkill(Skills.RANGED);
  }
  if (skill === Skills.PRAYER) {
    return useSkill(Skills.PRAYER);
  }
  if (skill === Skills.MAGIC) {
    return useSkill(Skills.MAGIC);
  }
  if (skill === Skills.COOKING) {
    return useSkill(Skills.COOKING);
  }
  if (skill === Skills.WOODCUTTING) {
    return useSkill(Skills.WOODCUTTING);
  }
  if (skill === Skills.FLETCHING) {
    return useSkill(Skills.FLETCHING);
  }
  if (skill === Skills.FISHING) {
    return useSkill(Skills.FISHING);
  }
  if (skill === Skills.FIREMAKING) {
    return useSkill(Skills.FIREMAKING);
  }
  if (skill === Skills.CRAFTING) {
    return useSkill(Skills.CRAFTING);
  }
  if (skill === Skills.SMITHING) {
    return useSkill(Skills.SMITHING);
  }
  if (skill === Skills.MINING) {
    return useSkill(Skills.MINING);
  }
  if (skill === Skills.HERBLORE) {
    return useSkill(Skills.HERBLORE);
  }
  if (skill === Skills.AGILITY) {
    return useSkill(Skills.AGILITY);
  }
  if (skill === Skills.THIEVING) {
    return useSkill(Skills.THIEVING);
  }
  if (skill === Skills.SLAYER) {
    return useSkill(Skills.SLAYER);
  }
  if (skill === Skills.FARMING) {
    return useSkill(Skills.FARMING);
  }
  if (skill === Skills.RUNECRAFT) {
    return useSkill(Skills.RUNECRAFT);
  }
  if (skill === Skills.HUNTER) {
    return useSkill(Skills.HUNTER);
  }
  if (skill === Skills.CONSTRUCTION) {
    return useSkill(Skills.CONSTRUCTION);
  }
  if (skill === Skills.SAILING) {
    return useSkill(Skills.SAILING);
  }
  return 0;
}

export function skillBaseLevel(skill: Int): Int {
  if (skill === Skills.ATTACK) {
    return useSkillBase(Skills.ATTACK);
  }
  if (skill === Skills.DEFENCE) {
    return useSkillBase(Skills.DEFENCE);
  }
  if (skill === Skills.STRENGTH) {
    return useSkillBase(Skills.STRENGTH);
  }
  if (skill === Skills.HITPOINTS) {
    return useSkillBase(Skills.HITPOINTS);
  }
  if (skill === Skills.RANGED) {
    return useSkillBase(Skills.RANGED);
  }
