import { totalLevel } from '../0712_account_summary_sidepanel/account-summary-sidepanel.helpers';
import { onMobile } from '../lib/lib.helpers';
import { StatsColor, StatsFonts, StatsLayout, StatsSprites } from './stats.constants';
import { TOTAL_ROW, hideStatsTip, showStatsTip, toggleStatsTip } from './stats-tooltip.component';

export function StatsTotalBar(): Component {
  const total: Int = totalLevel();
  const mobile: Boolean = onMobile();

  let toggle: String = '';
  if (mobile) {
    toggle = 'Toggle Total XP';
  }

  return (
    <layer x={0} y={StatsLayout.TOTAL_Y} w={StatsLayout.PANEL_W} h={StatsLayout.TOTAL_H}>
      <sprite x={72} y={0} w={StatsLayout.TOTAL_TILE} h={StatsLayout.TOTAL_TILE} sprite={StatsSprites.TOTAL_MIDDLE} />
      <sprite x={108} y={0} w={StatsLayout.TOTAL_TILE} h={StatsLayout.TOTAL_TILE} sprite={StatsSprites.TOTAL_MIDDLE} />
      <sprite x={144} y={0} w={StatsLayout.TOTAL_TILE} h={StatsLayout.TOTAL_TILE} sprite={StatsSprites.TOTAL_MIDDLE} />
      <sprite x={36} y={0} w={StatsLayout.TOTAL_TILE} h={StatsLayout.TOTAL_TILE} sprite={StatsSprites.TOTAL_MIDDLE} />
      <sprite
        x={StatsLayout.TOTAL_CAP_X}
        y={0}
        w={StatsLayout.TOTAL_TILE}
        h={StatsLayout.TOTAL_TILE}
        sprite={StatsSprites.TOTAL_LEFT}
      />
      <sprite
        x={{ right: StatsLayout.TOTAL_CAP_X }}
        y={0}
        w={StatsLayout.TOTAL_TILE}
        h={StatsLayout.TOTAL_TILE}
        sprite={StatsSprites.TOTAL_RIGHT}
      />
      <text
        x={StatsLayout.TOTAL_TEXT_X}
        y={StatsLayout.TOTAL_TEXT_Y}
        w="fill"
        h={{ fill: StatsLayout.TOTAL_TEXT_INSET_H }}
        text={`Total level: ${total}`}
        font={StatsFonts.LEVEL}
        color={StatsColor.LEVEL}
        align="center"
        valign="middle"
        shadow
        options={[toggle]}
        onMouseRepeat={() =>
          showStatsTip(TOTAL_ROW, totalAnchorX(), totalAnchorY(), StatsLayout.TOTAL_H - StatsLayout.TOTAL_TEXT_INSET_H)
        }
        onMouseLeave={() => hideStatsTip()}
        onOptionSelect={(event) => selectTotalOption(event.option)}
      />
    </layer>
  );
}

function totalAnchorX(): Int {
  return StatsLayout.TOTAL_TEXT_X;
}

function totalAnchorY(): Int {
  return StatsLayout.TOTAL_Y + StatsLayout.TOTAL_TEXT_Y;
}

function selectTotalOption(option: Int): void {
  if (option === 1) {
    toggleStatsTip(TOTAL_ROW, totalAnchorX(), totalAnchorY(), StatsLayout.TOTAL_H - StatsLayout.TOTAL_TEXT_INSET_H);
  }
}
