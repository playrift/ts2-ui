import { onMounted, useUniverse } from 'ts2';

import { StatsCells } from './stats-cells.data';
import { StatsCell } from './stats-cell.component';
import { StatsTotalBar } from './stats-total.component';
import { StatsTooltip, hideStatsTip } from './stats-tooltip.component';
import { StatsLayout, statsRef, statsTooltipRef } from './stats.constants';

export const statsUi = (): UI => (
  <ui ref={statsRef} w={StatsLayout.PANEL_W} h={StatsLayout.PANEL_H}>
    <Stats />
  </ui>
);

function Stats(): Component {
  const root = useUniverse();

  onMounted(() => hideStatsTip());
  return (
    <>
      {StatsCells.map((cell) => (
        <StatsCell skill={cell.skill} nudge={cell.nudge} x={cell.x} y={cell.y} height={cell.h} />
      ))}
      <StatsTotalBar />
      <layer ref={statsTooltipRef} x={0} y={0} w="fill" h="fill">
        <StatsTooltip root={root} />
      </layer>
    </>
  );
}
