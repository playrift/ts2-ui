import { Camera, JourneyColor, JourneyModel, Layout } from './swamp-boatjourney.constants';

export function SwampBoatJourney(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={JourneyColor.PLATE} fill={true} />

      <model
        x={Layout.model.x}
        y={Layout.model.y}
        w={Layout.model.size}
        h={Layout.model.size}
        model={JourneyModel.WATER}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <model
        x={Layout.model.x}
        y={Layout.model.y}
        w={Layout.model.size}
        h={Layout.model.size}
        model={JourneyModel.SHIP}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />
    </>
  );
}
