import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { LightBoxButton } from './light-box-button.component';
import { LightGrid } from './light-grid.component';
import {
  LightButtonBox,
  LightButtonsBottom,
  LightButtonsTop,
  LightPuzzleArt,
  LightPuzzleColors,
  LightPuzzleFonts,
} from './light-puzzle.constants';

export function LightPuzzle(): Component {
  return (
    <layer x="center" y="center" w="fill" h={{ fill: 26 }}>
      <SteelBorder
        x="center"
        y="center"
        w="fill"
        h="fill"
        title="Light box"
        titleColor={SteelborderColor.TITLE}
        flags={0}
      />

      <layer x="center" y={{ bottom: 5 }} w={{ fill: 10 }} h={{ fill: 38 }}>
        <layer x="center" y={{ bottom: 80 }} w={{ fill: 26 }} h={{ fill: 94 }}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={LightPuzzleArt.GRID_BACKING} />
          <rect w="fill" h="fill" color={LightPuzzleColors.BLACK} />
          <LightGrid />
        </layer>

        <layer y="bottom" w="fill" h={80}>
          <rect x="center" y="center" w="fill" h="fill" fill color={LightPuzzleColors.BLACK} transparency={255} />

          {LightButtonsTop.map((button) => (
            <layer x={button.x} y={LightButtonBox.Y} w={LightButtonBox.W} h={LightButtonBox.H}>
              <LightBoxButton />
            </layer>
          ))}

          {LightButtonsBottom.map((button) => (
            <layer x={button.x} y={{ bottom: LightButtonBox.Y }} w={LightButtonBox.W} h={LightButtonBox.H}>
              <LightBoxButton />
            </layer>
          ))}

          {LightButtonsTop.map((button) => (
            <layer x={button.x} y={LightButtonBox.Y} w={LightButtonBox.W} h={LightButtonBox.H}>
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                text={button.label}
                align="center"
                valign="middle"
                color={LightPuzzleColors.LETTER}
                font={LightPuzzleFonts.LETTER}
                hover={{ color: LightPuzzleColors.LETTER_HOVER }}
              />
            </layer>
          ))}

          {LightButtonsBottom.map((button) => (
            <layer x={button.x} y={{ bottom: LightButtonBox.Y }} w={LightButtonBox.W} h={LightButtonBox.H}>
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                text={button.label}
                align="center"
                valign="middle"
                color={LightPuzzleColors.LETTER}
                font={LightPuzzleFonts.LETTER}
                hover={{ color: LightPuzzleColors.LETTER_HOVER }}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
