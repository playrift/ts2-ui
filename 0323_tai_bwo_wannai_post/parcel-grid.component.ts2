import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { Grid, ParcelColors, ParcelInventories, ParcelItems, SlotFade } from './tai-bwo-wannai-post.constants';

export function ParcelGrid(): Component {
  const inv = useInventory(ParcelInventories.INV);

  return (
    <layer w="fill" h="fill">
      {inv.map((item, slot) =>
        item !== -1 ? (
          <sprite
            x={(slot % Grid.COLUMNS) * Grid.STRIDE_X}
            y={Grid.TOP + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
            w={Grid.SLOT_W}
            h={Grid.SLOT_H}
            item={item}
            itemCount={inv.count(slot)}
            transparency={SlotFade.HELD}
            outline={1}
            shadowColor={ParcelColors.SLOT_SHADOW}
            dragDeadZone={5}
            dragDeadTime={5}
            optionSubject={`<col=ff9040>${itemName(item)}</col>`}
            options={['Value', 'Pack-1', 'Pack-5', 'Pack-10', 'Pack-All', 'Pack-X', 'Examine']}
            onOptionSelect={(event) => {
              flashFor(event.self, SlotFade.PRESSED, SlotFade.HELD);
            }}
          />
        ) : (
          <sprite
            x={(slot % Grid.COLUMNS) * Grid.STRIDE_X}
            y={Grid.TOP + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
            w={Grid.SLOT_W}
            h={Grid.SLOT_H}
            item={ParcelItems.BLANK}
            itemCount={1}
            transparency={SlotFade.EMPTY}
            outline={1}
            shadowColor={ParcelColors.SLOT_SHADOW}
            dragDeadZone={5}
            dragDeadTime={5}
          />
        ),
      )}
    </layer>
  );
}
