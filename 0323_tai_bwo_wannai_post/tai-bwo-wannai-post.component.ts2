import { closeInterface } from '../lib/lib.helpers';
import { ParcelGrid } from './parcel-grid.component';
import {
  CloseBox,
  GridBox,
  Ornament,
  ParcelColors,
  ParcelFonts,
  ParcelSprites,
  Title,
  TITLE_TEXT,
} from './tai-bwo-wannai-post.constants';

export function TaiBwoWannaiPost(): Component {
  return (
    <>
      <text
        x="center"
        y={{ center: Title.DY }}
        w={Title.WIDTH}
        h={Title.HEIGHT}
        text={TITLE_TEXT}
        font={ParcelFonts.TITLE}
        color={ParcelColors.TITLE}
        shadow
      />

      <model
        x={Ornament.X}
        y={Ornament.Y}
        w={Ornament.SIZE}
        h={Ornament.SIZE}
        model={Ornament.MODEL}
        zoom={Ornament.ZOOM}
        pitch={Ornament.PITCH}
      />

      <layer x={GridBox.X} y={GridBox.Y} w={GridBox.WIDTH} h={GridBox.HEIGHT}>
        <ParcelGrid />
      </layer>

      <layer x={CloseBox.X} y={CloseBox.Y} w={CloseBox.WIDTH} h={CloseBox.HEIGHT}>
        <sprite
          x="center"
          y="center"
          w="fill"
          h="fill"
          sprite={ParcelSprites.CLOSE}
          hover={{ sprite: ParcelSprites.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />
      </layer>
    </>
  );
}
