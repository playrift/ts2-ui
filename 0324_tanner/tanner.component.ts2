import {
  BackingTiles,
  BottomEdge,
  InnerTopEdge,
  LeftEdge,
  RightEdge,
  TannerArt,
  TannerFont,
  TannerText,
  TanningSlots,
  TopEdge,
} from './tanner.constants';
import { TanningSlot } from './tanning-slot.component';

export function Tanner(): Component {
  return (
    <>
      {BackingTiles.map((row) => (
        <sprite x={row.x} y={row.y} w={88} h={60} sprite={TannerArt.TRADEBACKING} />
      ))}
      <sprite x={12} y={20} w={25} h={30} sprite={TannerArt.STEELBORDER_0} />
      {LeftEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TannerArt.MISCGRAPHICS_2} />
      ))}
      {RightEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TannerArt.STEELBORDER2_1} />
      ))}
      {BottomEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TannerArt.MISCGRAPHICS_3} />
      ))}
      {TopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TannerArt.STEELBORDER2_0} />
      ))}
      <sprite x={37} y={299} w={36} h={36} sprite={TannerArt.MISCGRAPHICS_3} />
      <sprite x={12} y={290} w={25} h={30} sprite={TannerArt.STEELBORDER_2} />
      <sprite x={475} y={20} w={25} h={30} sprite={TannerArt.STEELBORDER_1} />
      <sprite x={439} y={5} w={36} h={36} sprite={TannerArt.STEELBORDER2_0} />
      <sprite x={475} y={290} w={25} h={30} sprite={TannerArt.STEELBORDER_3} />
      <sprite x={288} y={34} w={36} h={36} sprite={TannerArt.STEELBORDER2_0} />
      <sprite x={439} y={299} w={36} h={36} sprite={TannerArt.MISCGRAPHICS_3} />
      {InnerTopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TannerArt.STEELBORDER2_0} />
      ))}
      <text
        x={15}
        y={25}
        w={477}
        h={24}
        text={TannerText.HEADING}
        font={TannerFont.B12_FULL}
        color={0xff981f}
        shadow
        align="center"
        valign="middle"
      />
      <sprite x={472} y={25} w={26} h={23} sprite={TannerArt.CLOSE_BUTTONS_0} />
      <layer x={465} y={22} w={32} h={32} hide>
        <sprite x={7} y={3} w={26} h={23} sprite={TannerArt.CLOSE_BUTTONS_1} />
      </layer>

      {TanningSlots.map((slot) => (
        <TanningSlot x={slot.x} y={slot.y} w={slot.w} inset={slot.inset} />
      ))}
    </>
  );
}
