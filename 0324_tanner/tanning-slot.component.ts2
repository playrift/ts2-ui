import { TannerFont, TannerText } from './tanner.constants';

export function TanningSlot({ x, y, w, inset }: { x: Int; y: Int; w: Int; inset: Int }): Component {
  return (
    <layer x={x} y={y} w={w} h={128}>
      <model x={inset} y={0} w={96} h={96} zoom={400} />

      <text
        x={inset}
        y={96}
        w={96}
        h={14}
        text={TannerText.HIDE}
        font={TannerFont.P11_FULL}
        color={0x00cfff}
        shadow
        align="center"
        valign="middle"
      />

      <text
        x={inset}
        y={111}
        w={96}
        h={14}
        text={TannerText.COST}
        font={TannerFont.P11_FULL}
        color={0x00cfff}
        shadow
        align="center"
        valign="middle"
      />

      <text x={inset} y={0} w={96} h={112} text="" font={TannerFont.P11_FULL} color={0xffff00} />
      <text x={inset} y={0} w={96} h={112} text="" font={TannerFont.P11_FULL} color={0xffff00} />
      <text x={inset} y={0} w={96} h={112} text="" font={TannerFont.P11_FULL} color={0xffff00} />
      <text x={inset} y={0} w={96} h={112} text="" font={TannerFont.P11_FULL} color={0xffff00} />
    </layer>
  );
}
