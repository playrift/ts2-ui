import {
  BackingTiles,
  BottomEdge,
  DartPegs,
  InnerTopEdge,
  LeftEdge,
  RightEdge,
  ShotSlots,
  TargetArt,
  TargetFont,
  TargetModel,
  TopEdge,
} from './target.constants';

export function Target(): Component {
  return (
    <>
      {BackingTiles.map((row) => (
        <sprite x={row.x} y={row.y} w={88} h={60} sprite={TargetArt.TRADEBACKING} />
      ))}
      <sprite x={12} y={20} w={25} h={30} sprite={TargetArt.STEELBORDER_0} />
      {LeftEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TargetArt.MISCGRAPHICS_2} />
      ))}
      {RightEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TargetArt.STEELBORDER2_1} />
      ))}
      {BottomEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TargetArt.MISCGRAPHICS_3} />
      ))}
      {TopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TargetArt.STEELBORDER2_0} />
      ))}
      <sprite x={37} y={299} w={36} h={36} sprite={TargetArt.MISCGRAPHICS_3} />
      <sprite x={12} y={290} w={25} h={30} sprite={TargetArt.STEELBORDER_2} />
      <sprite x={475} y={20} w={25} h={30} sprite={TargetArt.STEELBORDER_1} />
      <sprite x={439} y={5} w={36} h={36} sprite={TargetArt.STEELBORDER2_0} />
      <sprite x={475} y={290} w={25} h={30} sprite={TargetArt.STEELBORDER_3} />
      <sprite x={439} y={299} w={36} h={36} sprite={TargetArt.MISCGRAPHICS_3} />
      {InnerTopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TargetArt.STEELBORDER2_0} />
      ))}
      <sprite x={471} y={26} w={26} h={23} sprite={TargetArt.CLOSE_BUTTONS_0} />
      <layer x={465} y={22} w={32} h={32} hide>
        <sprite x={6} y={4} w={26} h={23} sprite={TargetArt.CLOSE_BUTTONS_1} />
      </layer>
      <model x={244} y={296} w={32} h={32} model={TargetModel.STAND} zoom={360} pitch={97} />
      <model x={253} y={172} w={25} h={25} model={TargetModel.PEG} zoom={400} pitch={100} yaw={150} />
      <text
        x={143}
        y={25}
        w={240}
        h={24}
        text="Target View"
        font={TargetFont.B12_FULL}
        color={0xffaa44}
        shadow
        align="center"
        valign="middle"
      />
      <model x={60} y={114} w={25} h={25} zoom={800} pitch={150} yaw={1200} />
      {DartPegs.map((row) => (
        <model x={row.x} y={row.y} w={25} h={25} model={TargetModel.PEG} zoom={400} pitch={100} yaw={150} />
      ))}
      <text x={19} y={86} w={67} h={15} text="Shots" font={TargetFont.P12_FULL} color={0xffaa44} shadow align="right" />
      <text
        x={387}
        y={147}
        w={79}
        h={17}
        text="Score:"
        font={TargetFont.P12_FULL}
        color={0xffaa44}
        shadow
        align="center"
      />
      <text x={420} y={169} w={17} h={14} text="%1" font={TargetFont.P12_FULL} color={0x00ff99} shadow align="center" />
      <text x={90} y={86} w={63} h={15} text="Left:" font={TargetFont.P12_FULL} color={0xffaa44} shadow />
      <text x={158} y={156} w={14} h={14} text="10" font={TargetFont.P12_FULL} color={0x00ff99} shadow />
      <text x={183} y={156} w={16} h={14} text="20" font={TargetFont.P12_FULL} color={0x00ccff} shadow />
      <text x={207} y={156} w={15} h={14} text="30" font={TargetFont.P12_FULL} color={0x00cc00} shadow />
      <text x={231} y={156} w={15} h={14} text="50" font={TargetFont.P12_FULL} color={0x0088ff} shadow />
      <model x={90} y={114} w={25} h={25} zoom={800} pitch={150} yaw={1200} />
      <text x={251} y={156} w={22} h={14} text="100" font={TargetFont.P12_FULL} color={0xff0000} shadow />
      {ShotSlots.map((row) => (
        <model x={row.x} y={row.y} w={25} h={25} zoom={800} pitch={150} yaw={1200} />
      ))}
      <text
        x={207}
        y={111}
        w={112}
        h={17}
        text="Missed!"
        font={TargetFont.B12_FULL}
        color={0xffff00}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
