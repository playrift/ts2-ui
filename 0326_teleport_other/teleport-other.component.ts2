      <sprite x={12} y={20} w={25} h={30} sprite={TeleportArt.STEELBORDER_0} />
      {LeftEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TeleportArt.MISCGRAPHICS_2} />
      ))}
      {RightEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TeleportArt.STEELBORDER2_1} />
      ))}
      {BottomEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TeleportArt.MISCGRAPHICS_3} />
      ))}
      {TopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TeleportArt.STEELBORDER2_0} />
      ))}
      <sprite x={37} y={299} w={36} h={36} sprite={TeleportArt.MISCGRAPHICS_3} />
      <sprite x={12} y={290} w={25} h={30} sprite={TeleportArt.STEELBORDER_2} />
      <sprite x={475} y={20} w={25} h={30} sprite={TeleportArt.STEELBORDER_1} />
      <sprite x={439} y={5} w={36} h={36} sprite={TeleportArt.STEELBORDER2_0} />
      <sprite x={475} y={290} w={25} h={30} sprite={TeleportArt.STEELBORDER_3} />
      <sprite x={439} y={299} w={36} h={36} sprite={TeleportArt.MISCGRAPHICS_3} />
      {InnerTopEdge.map((row) => (
        <sprite x={row.x} y={row.y} w={36} h={36} sprite={TeleportArt.STEELBORDER2_0} />
      ))}
      <text
        x={152}
        y={26}
        w={226}
        h={23}
        text="Teleport Option"
        font={TeleportFont.B12_FULL}
        color={0xf99b15}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={164}
        y={108}
        w={185}
        h={14}
        text="%1"
        font={TeleportFont.B12_FULL}
        color={0xf99b15}
        shadow
        align="center"
      />
      <text
        x={163}
        y={124}
        w={186}
        h={42}
        text="...wants to teleport you to..."
        font={TeleportFont.B12_FULL}
        color={0xffff00}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={163}
        y={168}
        w={187}
        h={15}
        text="%2"
        font={TeleportFont.B12_FULL}
        color={0xf99b15}
        shadow
        align="center"
      />
      <text
        x={162}
        y={224}
        w={187}
        h={27}
        text="Do you accept?"
        font={TeleportFont.B12_FULL}
        color={0xffff00}
        shadow
        align="center"
      />
      <sprite x={432} y={32} w={57} h={13} sprite={TeleportArt.SWORDDECOR_0} />
      <sprite x={24} y={32} w={57} h={13} sprite={TeleportArt.SWORDDECOR_1} />
      <layer x={160} y={255} w={87} h={52}>
