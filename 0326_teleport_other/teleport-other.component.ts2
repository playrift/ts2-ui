          valign="middle"
        />
        <sprite x={25} y={-11} w={36} h={36} sprite={TeleportArt.STEELBORDER2_0} />
        <sprite x={4} y={4} w={25} h={30} sprite={TeleportArt.STEELBORDER_0} />
        <sprite x={57} y={4} w={25} h={30} sprite={TeleportArt.STEELBORDER_1} />
        <sprite x={4} y={17} w={25} h={30} sprite={TeleportArt.STEELBORDER_2} />
        <sprite x={57} y={17} w={25} h={30} sprite={TeleportArt.STEELBORDER_3} />
        <sprite x={26} y={26} w={36} h={36} sprite={TeleportArt.MISCGRAPHICS_3} />
