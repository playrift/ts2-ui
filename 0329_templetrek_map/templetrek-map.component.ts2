import { TrekFlashMarkers } from './trek-flash-markers.component';
import { TrekArt, TrekColors, TrekFonts, TrekModel, TrekOps, TrekText } from './templetrek-map.constants';

const closeIcon = createRef('templetrek_map_close_icon');

const routeOnePanel = createRef('templetrek_map_route1_detail');
const routeTwoPanel = createRef('templetrek_map_route2_detail');
