      <model x={66} y={14} w={86} h={44} model={TrekModel.ROUTE_RIBBON} zoom={1106} pitch={459} yaw={2035} />
      <model x={64} y={86} w={79} h={38} model={TrekModel.ROUTE_RIBBON} zoom={1106} pitch={498} yaw={1005} />
      <model x={39} y={170} w={87} h={36} model={TrekModel.ROUTE_RIBBON} zoom={1106} pitch={474} />

      <model x={92} y={265} w={32} h={32} model={TrekModel.WALKER} zoom={728} pitch={483} />

      <text x={52} y={271} w={100} h={17} text={TrekText.PROMPT} font={TrekFonts.LABEL} color={TrekColors.PROMPT} />

