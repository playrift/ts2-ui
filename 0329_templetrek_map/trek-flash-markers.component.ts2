import { useServerState } from 'ts2';

import { FlashLayout, TempleTrekVarbits, TrekAnims, TrekMarkers, TrekModel } from './templetrek-map.constants';

export function TrekFlashMarkers(): Component {
  const flashing: Int = useServerState(TempleTrekVarbits.EVENT_FLASH);

  return (
    <layer w="fill" h="fill">
      {TrekMarkers.map((marker) => (
        <model
          x={marker.x}
          y={marker.y}
          w={FlashLayout.SIZE}
          h={FlashLayout.SIZE}
          model={flashing === marker.event ? TrekModel.FLASH : FlashLayout.NONE}
          anim={flashing === marker.event ? TrekAnims.FLASH : FlashLayout.NONE}
          zoom={FlashLayout.ZOOM}
          pitch={marker.pitch}
          yaw={marker.yaw}
        />
      ))}
    </layer>
  );
}
