import { Layout, SafeModel, SafeSprites } from './the-feud-safe.constants';

export function TheFeudSafe(): Component {
  return (
    <>
      <layer x={0} y={0} w={Layout.SPARE_W} h={Layout.SPARE_H} />

      <model
        x={Layout.SAFE_X}
        y={Layout.SAFE_Y}
        w={Layout.SAFE_SIZE}
        h={Layout.SAFE_SIZE}
        model={SafeModel.SAFE}
        zoom={Layout.SAFE_ZOOM}
        pitch={Layout.SAFE_PITCH}
        yaw={Layout.SAFE_YAW}
      />

      <layer x={Layout.RING_X} y={Layout.RING_Y} w={Layout.RING_W} h={Layout.RING_H}>
        {Layout.DIAL.map((position) => (
          <model
            x={position.x}
            y={position.y}
            w={position.w}
            h={position.h}
            model={SafeModel.DIAL}
            zoom={Layout.DIAL_ZOOM}
            pitch={position.pitch}
            yaw={position.yaw}
          />
        ))}

        <model
          x={Layout.RESET_X}
          y={Layout.RESET_Y}
          w={Layout.RESET_W}
          h={Layout.RESET_H}
          model={SafeModel.RESET}
          zoom={Layout.RESET_ZOOM}
          pitch={Layout.RESET_PITCH}
          yaw={Layout.RESET_YAW}
        />
      </layer>

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={SafeSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SafeSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
