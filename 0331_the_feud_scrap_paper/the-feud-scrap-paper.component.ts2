import { Layout, ScrapColors, ScrapFonts, ScrapModel, ScrapSprites, ScrapText } from './the-feud-scrap-paper.constants';

export function TheFeudScrapPaper(): Component {
  return (
    <>
      <layer x={Layout.SPARE_X} y={Layout.SPARE_Y} w={Layout.SPARE_SIZE} h={Layout.SPARE_SIZE} />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={ScrapModel.PAPER}
        zoom={ScrapModel.ZOOM}
        pitch={ScrapModel.PITCH}
        yaw={ScrapModel.YAW}
      />

      <text
        x={Layout.HEADING_X}
        y={Layout.HEADING_Y}
        w={Layout.HEADING_W}
        h={Layout.HEADING_H}
        text={ScrapText.HEADING}
        font={ScrapFonts.BODY}
        color={ScrapColors.INK}
        align="center"
      />

      <text
        x={Layout.LOCK_X}
        y={Layout.LOCK_Y}
        w={Layout.LOCK_W}
        h={Layout.LOCK_H}
        text={ScrapText.LOCK_LABEL}
        font={ScrapFonts.BODY}
        color={ScrapColors.INK}
        align="left"
      />

      <text
        x={Layout.LINE_X}
        y={Layout.LINE1_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        text={ScrapText.LINE}
        font={ScrapFonts.BODY}
        color={ScrapColors.INK}
        align="center"
      />

      <text
        x={Layout.LINE_X}
        y={Layout.LINE2_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        text={ScrapText.LINE}
        font={ScrapFonts.BODY}
        color={ScrapColors.INK}
        align="center"
      />

      <text
        x={Layout.LINE_X}
        y={Layout.LINE3_Y}
        w={Layout.LINE_W}
        h={Layout.LINE_H}
        text={ScrapText.LINE}
        font={ScrapFonts.BODY}
        color={ScrapColors.INK}
        align="center"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={ScrapSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ScrapSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
