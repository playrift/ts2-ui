import { createRef } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StaffSlot } from './staff-slot.component';
import { Staff, ThormacLayout, THORMAC_TITLE } from './thormac.constants';

const smokeSlot = createRef('thormac_slot_smoke');
const airSlot = createRef('thormac_slot_air');
const waterSlot = createRef('thormac_slot_water');
const earthSlot = createRef('thormac_slot_earth');
const fireSlot = createRef('thormac_slot_fire');
const lavaSlot = createRef('thormac_slot_lava');
const mudSlot = createRef('thormac_slot_mud');
const steamSlot = createRef('thormac_slot_steam');
const mistSlot = createRef('thormac_slot_mist');
const dustSlot = createRef('thormac_slot_dust');

export function Thormac(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={THORMAC_TITLE} />

      <layer x={ThormacLayout.GRID_X} y={ThormacLayout.GRID_Y} w={ThormacLayout.GRID_W} h={ThormacLayout.GRID_H}>
        <layer
          x={ThormacLayout.COL3}
          y={ThormacLayout.ROW1}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={smokeSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.SMOKE} slot={smokeSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL0}
          y={ThormacLayout.ROW0}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={airSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.AIR} slot={airSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL1}
          y={ThormacLayout.ROW0}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={waterSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.WATER} slot={waterSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL2}
          y={ThormacLayout.ROW0}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={earthSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.EARTH} slot={earthSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL3}
          y={ThormacLayout.ROW0}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={fireSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.FIRE} slot={fireSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL0}
          y={ThormacLayout.ROW1}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={lavaSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.LAVA} twin={Staff.LAVA_TWIN} slot={lavaSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL1}
          y={ThormacLayout.ROW1}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={mudSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.MUD} slot={mudSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL2}
          y={ThormacLayout.ROW1}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={steamSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.STEAM} twin={Staff.STEAM_TWIN} slot={steamSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL0}
          y={ThormacLayout.ROW2}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={mistSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.MIST} slot={mistSlot} />
        </layer>

        <layer
          x={ThormacLayout.COL1}
          y={ThormacLayout.ROW2}
          w={ThormacLayout.SLOT_W}
          h={ThormacLayout.SLOT_H}
          ref={dustSlot}
          options={['Enchant']}
        >
          <StaffSlot staff={Staff.DUST} slot={dustSlot} />
        </layer>
      </layer>
    </>
  );
}
