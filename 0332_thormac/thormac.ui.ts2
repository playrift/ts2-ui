import { createRef } from 'ts2';
import { Thormac } from './thormac.component';
import { ThormacLayout } from './thormac.constants';

const thormacRef = createRef('thormac');

export const thormacUi = (): UI => (
  <ui
    ref={thormacRef}
    x={ThormacLayout.ROOT_X}
    y={ThormacLayout.ROOT_Y}
    w={ThormacLayout.ROOT_W}
    h={ThormacLayout.ROOT_H}
  >
    <Thormac />
  </ui>
);
