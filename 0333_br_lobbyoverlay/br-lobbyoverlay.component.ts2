import { createRef, useInterval } from 'ts2';

import { opsound } from '../lib/lib.helpers';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import {
  BR_LIVE_TIER,
  BR_TEXT,
  BrFonts,
  BrLobbyDodge,
  BrLobbySideways,
  BrSprites,
  Layout,
  Rows,
  SETTINGS_OPSOUND_MASK,
} from './br-lobbyoverlay.constants';
import { drawSettings } from './br-lobbyoverlay.state';
import { SettingsButtonSkin } from './settings-button-skin.component';

const timerHost = createRef('0333_br_lobbyoverlay_timer_host');

const content = createRef('br_lobbyoverlay_content1');

export function BrLobbyOverlay(): Component {
  useInterval(
    () => overlayRelayout(timerHost, content, BrLobbyDodge.CONTENT, Anchor.RIGHT, Anchor.TOP, BrLobbySideways.FIXED),
    timerHost,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer
          ref={content}
          x={{ right: Layout.CONTENT_RIGHT }}
          y={Layout.CONTENT_Y}
          w={Layout.CONTENT_W}
          h={Layout.CONTENT_H}
        >
          <layer
            x="center"
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            noClickThrough
            options={['Settings']}
            onMouseRepeat={() => drawSettings(1)}
            onMouseLeave={() => drawSettings(0)}
            onOptionSelect={(event) => opsound(event.option, SETTINGS_OPSOUND_MASK)}
          >
            <SettingsButtonSkin />
          </layer>

          <layer x="center" y={0} w="fill" h={Layout.PANEL_H}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={BrSprites.BACKING}
              tiling
              transparency={Layout.BACKING_WASH}
            />

            <text
              x={Layout.LABEL_X}
              y={{ center: Rows.RANK.Y }}
              w={Rows.RANK.LABEL_W}
              h={Layout.ROW_H}
              text={Rows.RANK.LABEL}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />
            <text
              x="right"
              y={{ center: Rows.RANK.Y }}
              w={{ fill: Rows.RANK.VALUE_INSET }}
              h={Layout.ROW_H}
              text={Rows.RANK.VALUE}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />

            <text
              x={Layout.LABEL_X}
              y={{ center: Rows.COFFER.Y }}
              w={Rows.COFFER.LABEL_W}
              h={Layout.ROW_H}
              text={Rows.COFFER.LABEL}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />
            <text
              x="right"
              y={{ center: Rows.COFFER.Y }}
              w={{ fill: Rows.COFFER.VALUE_INSET }}
              h={Layout.ROW_H}
              text={Rows.COFFER.VALUE}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />

            <text
              x={Layout.LABEL_X}
              y={{ center: Rows.CASUAL.Y }}
              w={Rows.CASUAL.LABEL_W}
              h={Layout.ROW_H}
              text={Rows.CASUAL.LABEL}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />
            <text
              x="right"
              y={{ center: Rows.CASUAL.Y }}
              w={{ fill: Rows.CASUAL.VALUE_INSET }}
              h={Layout.ROW_H}
              text={Rows.CASUAL.VALUE}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />

            <text
              x={Layout.LABEL_X}
              y={{ center: Rows.COMPETITIVE.Y }}
              w={Rows.COMPETITIVE.LABEL_W}
              h={Layout.ROW_H}
              text={Rows.COMPETITIVE.LABEL}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />
            <text
              x="right"
              y={{ center: Rows.COMPETITIVE.Y }}
              w={{ fill: Rows.COMPETITIVE.VALUE_INSET }}
              h={Layout.ROW_H}
              text={Rows.COMPETITIVE.VALUE}
              contentType={BR_LIVE_TIER}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />

            <text
              x={Layout.LABEL_X}
              y={{ center: Rows.HIGH_STAKES.Y }}
              w={Rows.HIGH_STAKES.LABEL_W}
              h={Layout.ROW_H}
              text={Rows.HIGH_STAKES.LABEL}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />
            <text
              x="right"
              y={{ center: Rows.HIGH_STAKES.Y }}
              w={{ fill: Rows.HIGH_STAKES.VALUE_INSET }}
              h={Layout.ROW_H}
              text={Rows.HIGH_STAKES.VALUE}
              contentType={BR_LIVE_TIER}
              font={BrFonts.BODY}
              valign="middle"
              shadow
              color={BR_TEXT}
            />

            <ThinStoneBoxEntrypoint />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
