import { useState } from 'ts2';

import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { BrSprites, Layout } from './br-lobbyoverlay.constants';
import { brSettingsPressed } from './br-lobbyoverlay.state';

export function SettingsButtonSkin(): Component {
  const [pressed] = useState(brSettingsPressed);

  return (
    <layer w="fill" h="fill">
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}

      <sprite x="center" y="center" w={Layout.ICON_W} h={Layout.ICON_H} sprite={BrSprites.SETTINGS_ICON} />
    </layer>
  );
}
