import { Offer, TradeColors } from './trade-confirm.constants';
import { offerFont } from './trade-confirm.helpers';

export function OfferRow({
  line,
  x,
  y,
  w,
  twoColumns,
}: {
  line: String;
  x: Int;
  y: Int;
  w: Int;
  twoColumns: Boolean;
}): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={Offer.ROW_HEIGHT}
      text={line}
      font={offerFont(line, w, twoColumns)}
      color={TradeColors.ITEM}
      shadow
      align="center"
      valign="middle"
    />
  );
}
