import { CS2, intArray, stopTimer, useInterval, useInventory, useRef } from 'ts2';
import { clientClock } from '../lib/lib.engine';
import { Blink, FLASH_MS, Offer, OtherInventory, TradeColors, TradeInventories } from './trade-confirm.constants';
import { splitsIntoColumns, tradeSlotChangedAt } from './trade-confirm.helpers';

export function OtherFlashers(): Component {
  const trade = useInventory(TradeInventories.OFFER);
  const slots: Int = trade.size;
  const half: Int = (slots + 1) / 2;
  const flashingSince: Int = clientClock() - FLASH_MS;

  const item = intArray<Item>(28);
  const changed = intArray(28);
  const rank = intArray(28);
  const pending = intArray(28);

  let counted: Int = 0;
  let placed: Int = 0;
  let removed: Int = 0;
  let newest: Int = 0;
  let slot: Int = 0;
  while (slot < slots) {
    item[slot] = CS2.invother_item_get(OtherInventory.OFFER, slot);
    changed[slot] = tradeSlotChangedAt(slot);
    rank[slot] = placed;
    pending[slot] = removed;
    if (item[slot] !== -1) {
      placed = placed + 1;
      counted = counted + 1;
    } else if (changed[slot] > flashingSince) {
      counted = counted + 1;
      removed = removed + 1;
      if (changed[slot] > newest) {
        newest = changed[slot];
      }
    }
    slot = slot + 1;
  }

  const twoColumns: Boolean = splitsIntoColumns(counted, half);
  const barWidth: Int = twoColumns ? Offer.HALF : Offer.WIDTH;

  return (
    <layer w="fill" h="fill">
      {item.map(
        (offered, index) =>
          offered !== -1 &&
          changed[index] > flashingSince && (
            <FlashPair
              x={twoColumns && rank[index] % 2 === 1 ? Offer.HALF : 0}
              y={twoColumns ? (rank[index] / 2) * Offer.ROW_STEP : rank[index] * Offer.ROW_STEP}
              w={barWidth}
              changedAt={changed[index]}
            />
          ),
      )}

      {item.map(
        (offered, index) =>
          offered === -1 &&
          changed[index] > flashingSince && (
            <FlashPair
              x={twoColumns ? ((placed + pending[index]) % 2 === 0 ? Offer.HALF : Offer.WIDTH) : 0}
              y={
                twoColumns
                  ? ((placed + pending[index]) / 2) * Offer.ROW_STEP
                  : (placed + pending[index]) * Offer.ROW_STEP
              }
              w={barWidth}
              changedAt={newest}
            />
          ),
      )}
    </layer>
  );
}

function FlashPair({ x, y, w, changedAt }: { x: Int; y: Int; w: Int; changedAt: Int }): Component {
  const fillBar = useRef();
  const edgeBar = useRef();
  useInterval(() => fade(fillBar, changedAt), fillBar);
  useInterval(() => fade(edgeBar, changedAt), edgeBar);
  return (
    <>
      <rect
        ref={fillBar}
        x={x}
        y={y}
        w={w}
        h={Offer.FLASH_HEIGHT}
        fill
        color={TradeColors.FLASH_FILL}
        transparency={255}
      />
      <rect
        ref={edgeBar}
        x={x}
        y={y}
        w={w}
        h={Offer.FLASH_HEIGHT}
        fill={false}
        color={TradeColors.FLASH_EDGE}
        transparency={255}
      />
    </>
  );
}

function fade(bar: ComponentId, changedAt: Int): void {
  const now: Int = clientClock();
  const elapsed: Int = now - changedAt;
  if (elapsed >= FLASH_MS) {
    bar.transparency = 255;
    stopTimer(bar);
    return;
  }
  if (now % Blink.PERIOD >= Blink.OFF_FROM) {
    bar.transparency = 255;
    return;
  }
  bar.transparency = CS2.interpolate(0, elapsed, 0, FLASH_MS, 255);
}
