import { useServerState } from 'ts2';
import { TradeColors, TradeFonts, TradeVarbits } from './trade-confirm.constants';

export function RemovalWarning(): Component {
  const modified: Int = useServerState(TradeVarbits.OTHER_REMOVED);

  return (
    <text
      x={315}
      y={270}
      w={165}
      h={28}
      text={modified === 1 ? 'Trade modified' : ''}
      font={TradeFonts.SMALL}
      color={TradeColors.WARNING}
      shadow
      align="center"
      valign="middle"
    />
  );
}
