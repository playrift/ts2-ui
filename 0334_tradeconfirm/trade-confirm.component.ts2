import { closeInterface } from '../lib/lib.helpers';
import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { OtherFlashers } from './other-flashers.component';
import { OtherOffer } from './other-offer.component';
import { RemovalWarning } from './removal-warning.component';
import { YourOffer } from './your-offer.component';
import { Offer, Panel, TradeColors, TradeFonts, TradeSprites } from './trade-confirm.constants';

export function TradeConfirm(): Component {
  return (
    <>
      <rect
        x={{ center: Panel.SHADOW_OFFSET }}
        y={{ center: Panel.SHADOW_OFFSET }}
        w={Panel.WIDTH}
        h={Panel.HEIGHT}
        fill
        color={TradeColors.SHADOW}
        transparency={Panel.SHADOW_TRANSPARENCY}
      />

      <layer x="center" y="center" w={Panel.WIDTH} h={Panel.HEIGHT}>
        <layer x="center" y="center" w="fill" h="fill">
          <sprite x="center" y="center" w={{ fill: 4 }} h={{ fill: 4 }} sprite={TradeSprites.BACKING} tiling />
          <StoneBoxEntrypoint skin={StoneBoxSkin.ORNATE} />
        </layer>

        <text
          x="center"
          y={6}
          w="fill"
          h={16}
          font={TradeFonts.MEDIUM}
          color={TradeColors.TITLE}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x="center"
          y={22}
          w="fill"
          h={12}
          text="There is <col=ff0000>NO WAY<col=ffffff> to reverse a trade if you change your mind."
          font={TradeFonts.SMALL}
          color={TradeColors.EMPTY}
          shadow
          align="center"
          valign="middle"
        />

        <sprite x="center" y={23} w={{ fill: 10 }} h={32} sprite={TradeSprites.DIVIDER} tiling />
        <sprite x={0} y={25} w={32} h={32} sprite={TradeSprites.CORNER_TOP_LEFT} />
        <sprite x="right" y={25} w={32} h={32} sprite={TradeSprites.CORNER_TOP_RIGHT} />

        <sprite x={227} y={37} w={32} h={32} sprite={TradeSprites.SPINE_TOP} optionSubject=" " />

        <sprite x={228} y={273} w={32} h={32} sprite={TradeSprites.JOINT} />

        <sprite x={226} y={45} w={32} h={222} sprite={TradeSprites.SPINE} tiling />
        <sprite x={226} y={262} w={34} h={36} sprite={TradeSprites.SPINE} tiling />

        <rect x={175} y={276} w={65} h={22} fill color={TradeColors.BUTTON} options={['Accept']} />
        <rect x={246} y={276} w={65} h={22} fill color={TradeColors.BUTTON} options={['Decline']} />

        <sprite x={171} y={271} w={32} h={32} sprite={TradeSprites.BAR_LEFT} optionSubject=" " />
        <sprite x={283} y={271} w={32} h={32} sprite={TradeSprites.BAR_RIGHT} />
        <sprite x={203} y={257} w={32} h={32} sprite={TradeSprites.DIVIDER} />
        <sprite x={251} y={257} w={32} h={32} sprite={TradeSprites.DIVIDER} />
        <sprite x={226} y={258} w={32} h={32} sprite={TradeSprites.BAR_CENTRE} />
        <sprite x={159} y={273} w={32} h={32} sprite={TradeSprites.JOINT} />
        <sprite x={228} y={273} w={32} h={32} sprite={TradeSprites.JOINT} />
        <sprite x={297} y={273} w={32} h={32} sprite={TradeSprites.JOINT} />

        <text
          x={Offer.YOUR_X}
          y={42}
          w={Offer.WIDTH}
          h={24}
          font={TradeFonts.SMALL}
          color={TradeColors.HEADING}
          shadow
          align="center"
          valign="middle"
        />
        <text
          x={Offer.OTHER_X}
          y={42}
          w={Offer.WIDTH}
          h={24}
          font={TradeFonts.SMALL}
          color={TradeColors.HEADING}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x={174}
          y={278}
          w={67}
          h={20}
          text="Accept"
          font={TradeFonts.MEDIUM}
          color={TradeColors.ACCEPT}
          shadow
          align="center"
          valign="middle"
        />
        <text
          x={244}
          y={278}
          w={67}
          h={20}
          text="Decline"
          font={TradeFonts.MEDIUM}
          color={TradeColors.DECLINE}
          shadow
          align="center"
          valign="middle"
        />

        <OtherFlashers x={Offer.OTHER_X} y={Offer.TOP} w={Offer.WIDTH} h={Offer.HEIGHT} />
        <YourOffer x={Offer.YOUR_X} y={Offer.TOP} w={Offer.WIDTH} h={Offer.HEIGHT} />
        <OtherOffer x={Offer.OTHER_X} y={Offer.TOP} w={Offer.WIDTH} h={Offer.HEIGHT} />

        <text
          x={6}
          y={270}
          w={165}
          h={28}
          font={TradeFonts.LARGE}
          color={TradeColors.TITLE}
          shadow
          align="center"
          valign="middle"
          lineHeight={14}
        />

        <RemovalWarning />

        <sprite
          x={{ right: 9 }}
          y={9}
          w={16}
          h={16}
          sprite={TradeSprites.CLOSE}
          hover={{ sprite: TradeSprites.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />
      </layer>
    </>
  );
}
