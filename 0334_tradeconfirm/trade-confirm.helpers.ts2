    }
  }
  return 0;
}

export function offerText(item: Item, quantity: Int): String {
  if (item === -1 || quantity === 0) {
    return '';
  }
  if (quantity === 1) {
    return itemName(item);
  }
  if (quantity < 100000) {
    return `${itemName(item)}<col=ffffff> x <col=ffff00>${groupDigits(quantity, ',')}`;
  }
  if (quantity < 10000000) {
    return `${itemName(item)}<col=ffffff> x <col=ffffff>${groupDigits(quantity / 1000, ',')}K (${groupDigits(quantity, ',')})`;
  }
  return `${itemName(item)}<col=ffffff> x <col=00ff80>${groupDigits(quantity / 1000000, ',')}M (${groupDigits(quantity, ',')})`;
}

export function splitsIntoColumns(counted: Int, half: Int): Boolean {
  if (counted > half) {
    return true;
  }
  return false;
}

export function offerFont(line: String, columnWidth: Int, twoColumns: Boolean): Font {
  if (textWidth(line, Offer.MEASURE_WIDTH, TradeFonts.MEDIUM) > columnWidth) {
    return TradeFonts.SMALL;
  }
  if (twoColumns) {
    return TradeFonts.MEDIUM;
  }
  if (textWidth(line, Offer.MEASURE_WIDTH, TradeFonts.LARGE) > columnWidth) {
    return TradeFonts.MEDIUM;
  }
  return TradeFonts.LARGE;
}
