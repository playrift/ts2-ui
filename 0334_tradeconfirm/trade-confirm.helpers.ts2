export function tradeSlotChangedAt(slot: Int): Int {
  switch (slot) {
    case 0: {
      const [v] = useState(tradeSlot0Changed);
      return v;
    }
    case 1: {
      const [v] = useState(tradeSlot1Changed);
      return v;
