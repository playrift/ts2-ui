import { useServerState } from 'ts2';

import { ACCEPT_DELAY_CAP, TradeColors, TradeFonts, TradeVarbits } from './trademain.constants';
import { secondsOfPercent } from './trademain.helpers';

export function AcceptLabel(): Component {
  const delay: Int = useServerState(TradeVarbits.ACCEPT_DELAY);

  if (delay > 0) {
    return (
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={`Check offer!<br>${stringOf(Math.min(ACCEPT_DELAY_CAP, secondsOfPercent(delay)))}...`}
        font={TradeFonts.MEDIUM}
        color={TradeColors.ACCEPT_WAITING}
        shadow
        align="center"
        valign="middle"
      />
    );
  }

  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text="Accept"
      font={TradeFonts.MEDIUM}
      color={TradeColors.ACCEPT}
      shadow
      align="center"
      valign="middle"
    />
  );
}
