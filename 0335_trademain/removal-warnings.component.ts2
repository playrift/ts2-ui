import { useServerState } from 'ts2';

import { Column, Grid, TradeColors, TradeFonts, TradeVarbits } from './trademain.constants';

export function YourRemovalWarning(): Component {
  const modified: Int = useServerState(TradeVarbits.YOUR_REMOVED);

  return (
    <text
      x={Grid.YOUR_X}
      y={Column.WARN_Y}
      w={Column.W}
      h={Column.WARN_H}
      text={modified === 1 ? 'Trade modified' : ''}
      font={TradeFonts.SMALL}
      color={TradeColors.WARNING}
      shadow
      align="center"
    />
  );
}

export function OtherRemovalWarning(): Component {
  const modified: Int = useServerState(TradeVarbits.OTHER_REMOVED);

  return (
    <text
      x={Grid.OTHER_X}
      y={Column.WARN_Y}
      w={Column.W}
      h={Column.WARN_H}
      text={modified === 1 ? 'Trade modified' : ''}
      font={TradeFonts.SMALL}
      color={TradeColors.WARNING}
      shadow
      align="center"
    />
  );
}
