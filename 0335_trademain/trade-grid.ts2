import { Grid } from './trademain.constants';

export function gridRows(slots: Int): Int {
  const rows: Int = slots / Grid.COLUMNS;
  if (rows < Grid.MIN_ROWS) {
    return Grid.MIN_ROWS;
  }
  return rows;
}

export function gridRowGap(height: Int, rows: Int): Int {
  return (height - rows * Grid.CELL_H) / (rows - 1);
}

export function gridColumnGap(width: Int): Int {
  return (width - Grid.SLACK - Grid.COLUMNS * Grid.CELL_W) / (Grid.COLUMNS - 1);
}

export function cellX(slot: Int, columnGap: Int): Int {
  return Grid.FIRST_X + (slot % Grid.COLUMNS) * (columnGap + Grid.CELL_W);
}

export function cellY(slot: Int, rowGap: Int): Int {
  return (slot / Grid.COLUMNS) * (Grid.CELL_H + rowGap);
}
