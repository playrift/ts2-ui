import { closeInterface } from '../lib/lib.helpers';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { AcceptLabel } from './accept-label.component';
import { OtherOffer } from './other-offer.component';
import { OtherRemovalWarning, YourRemovalWarning } from './removal-warnings.component';
import { TradeTooltip } from './trade-tooltip.component';
import { YourOffer } from './your-offer.component';
import {
  Banner,
  Column,
  Grid,
  Middle,
  Panel,
  Plate,
  TradeColors,
  TradeFonts,
  TradeSprites,
} from './trademain.constants';

export function TradeMain(): Component {
  return (
    <>
      <rect
        x={{ center: Panel.SHADOW_OFFSET }}
        y={{ center: Panel.SHADOW_OFFSET }}
        w={Panel.WIDTH}
        h={Panel.HEIGHT}
        fill
        color={TradeColors.BLACK}
        transparency={Panel.SHADOW_TRANSPARENCY}
      />

      <layer x="center" y="center" w={Panel.WIDTH} h={Panel.HEIGHT}>
        <layer x="center" y="center" w="fill" h="fill">
          <StoneBorderEntrypoint title="" />
        </layer>

        <layer x="center" y="center" w="fill" h="fill">
          <layer x={Middle.X} y={Middle.Y} w={Middle.W} h={{ fill: Middle.H_INSET }}>
            <sprite x={32} y={11} w={34} h={{ fill: 22 }} sprite={TradeSprites.SPINE} tiling />

            <layer x={0} y={Plate.BOX_Y} w={Plate.BOX_W} h={Plate.BOX_H}>
              <rect
                x={Plate.BOX_FILL_X}
                y={Plate.BOX_FILL_Y}
                w={Plate.BOX_FILL_W}
                h={Plate.BOX_FILL_H}
                fill
                color={TradeColors.BLACK}
              />
              <text
                x="center"
                y="center"
                w={{ fill: Plate.BOX_TEXT_INSET }}
                h={{ fill: Plate.BOX_TEXT_INSET }}
                font={TradeFonts.SMALL}
                color={TradeColors.AMBER}
                shadow
                align="center"
                valign="middle"
              />
              <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
            </layer>

            <layer x="center" y={{ center: Plate.ACCEPT_DY }} w={Plate.W} h={Plate.H} options={['Accept']}>
              <rect
                x="center"
                y="center"
                w={{ fill: Plate.FILL_INSET }}
                h={{ fill: Plate.FILL_INSET }}
                fill
                color={TradeColors.BLACK}
              />
              <AcceptLabel />
              <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
            </layer>

            <layer
              x="center"
              y={{ center: Plate.DECLINE_DY }}
              w={Plate.W}
              h={Plate.H}
              options={['Decline']}
              onOptionSelect={() => closeInterface()}
            >
              <rect
                x="center"
                y="center"
                w={{ fill: Plate.FILL_INSET }}
                h={{ fill: Plate.FILL_INSET }}
                fill
                color={TradeColors.BLACK}
              />
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                text="Decline"
                font={TradeFonts.MEDIUM}
                color={TradeColors.DECLINE}
                shadow
                align="center"
                valign="middle"
              />
              <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
            </layer>

            <sprite x={33} y={2} w={32} h={32} sprite={TradeSprites.SPINE_CAP} />
            <sprite x={33} y={3} w={32} h={31} sprite={TradeSprites.SPINE_JOINT} />
            <sprite x={33} y={79} w={32} h={32} sprite={TradeSprites.SPINE_CAP} />
            <sprite x={33} y={95} w={32} h={31} sprite={TradeSprites.SPINE_JOINT} />
            <sprite x={33} y={159} w={32} h={32} sprite={TradeSprites.SPINE_CAP} />
            <sprite x={33} y={168} w={32} h={31} sprite={TradeSprites.SPINE_JOINT} />
            <sprite x={33} y={232} w={32} h={32} sprite={TradeSprites.SPINE_CAP} />
            <sprite x={34} y={246} w={32} h={32} sprite={TradeSprites.SPINE_FOOT} />
          </layer>

          <text
            x={Grid.YOUR_X}
            y={Column.HEAD_Y}
            w={Column.W}
            h={Column.HEAD_H}
            font={TradeFonts.SMALL}
            color={TradeColors.AMBER}
            shadow
            align="center"
            valign="middle"
          />

          <layer x={Grid.YOUR_X} y={Grid.TOP} w={Grid.WIDTH} h={Grid.HEIGHT}>
            <YourOffer />
          </layer>

          <YourRemovalWarning />

          <text
            x={Grid.OTHER_X}
            y={Column.HEAD_Y}
            w={Column.W}
            h={Column.HEAD_H}
            font={TradeFonts.SMALL}
            color={TradeColors.AMBER}
            shadow
            align="center"
            valign="middle"
          />

          <layer x={Grid.OTHER_X} y={Grid.TOP} w={Grid.WIDTH} h={Grid.HEIGHT}>
            <OtherOffer />
          </layer>

          <OtherRemovalWarning />

          <text
            x={0}
            y={Banner.STATUS_Y}
            w={Panel.WIDTH}
            h={Banner.STATUS_H}
            font={TradeFonts.MEDIUM}
            color={TradeColors.WHITE}
            shadow
            align="center"
            valign="middle"
          />

          <text
            x="center"
            y={Banner.TITLE_Y}
            w="fill"
            h={Banner.TITLE_H}
            font={TradeFonts.LARGE}
            color={TradeColors.AMBER}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>

      <layer w="fill" h="fill">
        <TradeTooltip />
      </layer>
    </>
  );
}
