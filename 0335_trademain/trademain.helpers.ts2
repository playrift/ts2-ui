export function secondsOfPercent(percent: Int): Int {
  const whole: Int = CS2.scale(60, 100, percent);
  if (((percent % 10) * 6) % 10 >= 5) {
    return whole + 1;
  }
  return whole;
}

export function tradeTipText(count: Int, price: Int): String {
  if (count <= 1) {
    return groupDigits(price, ',');
  }
  if (2147483647 / count < price) {
    return `${groupDigits(count, ',')} x ${groupDigits(price, ',')}`;
  }
  return `${groupDigits(count, ',')} x ${groupDigits(price, ',')}<br>= ${groupDigits(count * price, ',')}`;
}

export function tradeSlotCount(slot: Int, other: Int): Int {
  if (other === 1) {
    return CS2.invother_num_get(OtherInventory.OFFER, slot);
  }
  return CS2.inv_num_get(OtherInventory.OFFER, slot);
}

export function tradeSidePrice(slot: Int, other: Int): Int {
  if (other === 1) {
    return otherSlotPrice(slot);
  }
  return tradeSlotPrice(slot);
}
