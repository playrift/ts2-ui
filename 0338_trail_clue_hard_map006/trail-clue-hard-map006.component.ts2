import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { MapModel, TrailArt } from './trail-clue-hard-map006.constants';

export function TrailClueHardMap006(): Component {
  return (
    <>
      <model x={227} y={162} w={32} h={32} model={MapModel.SCROLL} zoom={599} pitch={520} yaw={1} />
      <model x={150} y={229} w={32} h={32} model={MapModel.MODEL_3388} zoom={531} pitch={493} yaw={18} />
      <model x={165} y={49} w={32} h={32} model={MapModel.MODEL_3388} zoom={531} pitch={527} yaw={515} />
      <model x={340} y={62} w={32} h={32} model={MapModel.MODEL_3388} zoom={531} pitch={578} yaw={1030} />
      <model x={228} y={115} w={32} h={32} model={MapModel.MODEL_11370} zoom={2279} pitch={512} />
      <model x={321} y={250} w={47} h={34} model={MapModel.MODEL_3388} zoom={531} pitch={512} yaw={1556} />
      <model x={358} y={130} w={32} h={32} model={MapModel.MODEL_11366} zoom={2023} pitch={512} />
      <model x={260} y={146} w={32} h={32} model={MapModel.MODEL_3389} zoom={1215} pitch={512} yaw={1778} />
      <model x={260} y={202} w={32} h={32} model={MapModel.MODEL_11370} zoom={2279} pitch={512} />
      <model x={187} y={59} w={32} h={32} model={MapModel.MODEL_11366} zoom={2023} pitch={512} />
      <model x={297} y={140} w={32} h={32} model={MapModel.MODEL_11370} zoom={1383} pitch={512} />
      <model x={213} y={248} w={32} h={32} model={MapModel.MODEL_11366} zoom={2023} pitch={512} />
      <sprite
        x={401}
        y={17}
        w={26}
        h={23}
        sprite={TrailArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, TrailArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TrailArt.CLOSE)}
      />
    </>
  );
}
