import { createRef, useInterval } from 'ts2';

import { layoutSailingHint } from './sailing-intro-hud.helpers';
import { HintColor, HintFonts, HintSprites, HintTransparency, Layout } from './sailing-intro-hud.constants';

const timerHost = createRef('0345_sailing_intro_hud_timer_host');

const universe = createRef('sailing_intro_hud_universe');
const dodger = createRef('sailing_intro_hud_dodger_hints');

export function SailingIntroHud(): Component {
  useInterval(() => layoutSailingHint(universe, dodger, timerHost), timerHost);

  return (
    <layer ref={universe} x="center" y="center" w="fill" h="fill">
      <layer ref={dodger} w="fill" h="fill">
        <layer x="center" y={{ bottom: Layout.HINT_MARGIN }} w={Layout.HINT_W} h={Layout.HINT_H} hide ref={timerHost}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.PLATE_INSET }}
            h={{ fill: Layout.PLATE_INSET }}
            sprite={HintSprites.BACKING}
            tiling
            transparency={HintTransparency.BACKING}
          />

          <rect
            x="center"
            y="center"
            w={{ fill: Layout.PLATE_INSET }}
            h={{ fill: Layout.PLATE_INSET }}
            color={HintColor.WASH}
            fill
            transparency={HintTransparency.WASH}
          />

          <rect x="center" y="center" w="fill" h="fill" color={HintColor.BORDER} />

          <text
            x="center"
            y={{ center: Layout.LINE_1_Y }}
            w={{ fill: Layout.LINE_INSET_W }}
            h={Layout.LINE_H}
            font={HintFonts.HINT}
            color={HintColor.TEXT}
            align="center"
            valign="middle"
            lineHeight={Layout.LINE_HEIGHT}
            shadow
          />

          <text
            x="center"
            y={{ center: Layout.LINE_2_Y }}
            w={{ fill: Layout.LINE_INSET_W }}
            h={Layout.LINE_H}
            font={HintFonts.HINT}
            color={HintColor.TEXT}
            align="center"
            valign="middle"
            lineHeight={Layout.LINE_HEIGHT}
            shadow
          />
        </layer>
      </layer>
    </layer>
  );
}
