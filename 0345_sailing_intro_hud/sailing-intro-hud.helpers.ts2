import { CS2 } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { onMobile } from '../lib/lib.helpers';
import { HintOverlay, HintWindow, Layout } from './sailing-intro-hud.constants';

export function layoutSailingHint(universe: ComponentId, dodger: ComponentId, hint: ComponentId): void {
  const mobile: Boolean = onMobile();

  if (CS2.window_mode_get() === HintWindow.FIXED || mobile) {
    if (mobile) {
      CS2.if_position_set(0, Layout.HINT_MARGIN_MOBILE, Anchor.CENTRE, Anchor.BOTTOM, hint);
    } else {
      CS2.if_position_set(0, Layout.HINT_MARGIN, Anchor.CENTRE, Anchor.BOTTOM, hint);
    }
    overlayInit(dodger, hint, HintOverlay.DODGE_COMPACT, Anchor.CENTRE, Anchor.BOTTOM, 1);
  } else if (CS2.if_width_get(universe) <= HintWindow.NARROW_W || CS2.if_height_get(universe) <= HintWindow.SHORT_H) {
    CS2.if_position_set(Layout.HINT_MARGIN, Layout.HINT_MARGIN, Anchor.LEFT, Anchor.TOP, hint);
    overlayInit(dodger, hint, HintOverlay.DODGE, Anchor.LEFT, Anchor.BOTTOM, 1);
  } else {
    CS2.if_position_set(0, Layout.HINT_MARGIN, Anchor.CENTRE, Anchor.TOP, hint);
    overlayInit(dodger, hint, HintOverlay.DODGE, Anchor.CENTRE, Anchor.TOP, 1);
  }
}
