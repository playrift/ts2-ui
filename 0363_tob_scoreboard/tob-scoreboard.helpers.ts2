import { predictServerState, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { TobTab } from './tob-scoreboard.constants';

export function tobSelectedTab(): Int {
  const tab: Int = useServerState(Varbits.TOB_SCOREBOARD_TAB);
  if (tab === TobTab.STORY) {
    return TobTab.STORY;
  }
  if (tab === TobTab.HARD) {
    return TobTab.HARD;
  }
  return TobTab.NORMAL;
}

export function selectTobTab(tab: Int): void {
  predictServerState(Varbits.TOB_SCOREBOARD_TAB, tab);
}
