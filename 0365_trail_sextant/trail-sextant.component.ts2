import {
  Camera,
  Layout,
  SextantArt,
  SextantColors,
  SextantFonts,
  SextantModel,
  SextantText,
} from './trail-sextant.constants';

export function TrailSextant(): Component {
  return (
    <>
      <model
        x={Layout.BACKING_X}
        y={Layout.BACKING_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.BACKING}
        zoom={Camera.BACKING.ZOOM}
        pitch={Camera.BACKING.PITCH}
      />

      <model
        x={Layout.EYEPIECE_X}
        y={Layout.EYEPIECE_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.HORIZON}
        zoom={Camera.HORIZON.ZOOM}
        pitch={Camera.HORIZON.PITCH}
      />

      <model
        x={Layout.EYEPIECE_X}
        y={Layout.EYEPIECE_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.SUN}
        zoom={Camera.SUN.ZOOM}
        pitch={Camera.SUN.PITCH}
      />

      <model
        x={Layout.EYEPIECE_X}
        y={Layout.EYEPIECE_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.VIEWER}
        zoom={Camera.VIEWER.ZOOM}
        pitch={Camera.VIEWER.PITCH}
      />

      <model
        x={Layout.TILT_UP_X}
        y={Layout.TILT_UP_Y}
        w={Layout.TILT_UP_W}
        h={Layout.TILT_UP_H}
        model={SextantModel.TILT_UP}
        zoom={Camera.TILT_UP.ZOOM}
        pitch={Camera.TILT_UP.PITCH}
        yaw={Camera.TILT_UP.YAW}
      />

      <model
        x={Layout.TILT_DOWN_X}
        y={Layout.TILT_DOWN_Y}
        w={Layout.TILT_DOWN_W}
        h={Layout.TILT_DOWN_H}
        model={SextantModel.TILT_DOWN}
        zoom={Camera.TILT_DOWN.ZOOM}
        pitch={Camera.TILT_DOWN.PITCH}
        yaw={Camera.TILT_DOWN.YAW}
      />

      <model
        x={Layout.ARM_RIGHT_X}
        y={Layout.ARM_RIGHT_Y}
        w={Layout.ARM_RIGHT_W}
        h={Layout.ARM_RIGHT_H}
        model={SextantModel.ARM_RIGHT}
        zoom={Camera.ARM_RIGHT.ZOOM}
        pitch={Camera.ARM_RIGHT.PITCH}
        yaw={Camera.ARM_RIGHT.YAW}
      />

      <model
        x={Layout.ARM_LEFT_X}
        y={Layout.ARM_LEFT_Y}
        w={Layout.ARM_LEFT_W}
        h={Layout.ARM_LEFT_H}
        model={SextantModel.ARM_LEFT}
        zoom={Camera.ARM_LEFT.ZOOM}
        pitch={Camera.ARM_LEFT.PITCH}
        yaw={Camera.ARM_LEFT.YAW}
      />

      <model
        x={Layout.INSTRUMENT_X}
        y={Layout.INSTRUMENT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.BACK}
        zoom={Camera.INSTRUMENT.ZOOM}
        pitch={Camera.INSTRUMENT.PITCH}
      />

      <model
        x={Layout.INSTRUMENT_X}
        y={Layout.INSTRUMENT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.ARM}
        zoom={Camera.INSTRUMENT.ZOOM}
        pitch={Camera.INSTRUMENT.PITCH}
      />

      <model
        x={Layout.INSTRUMENT_X}
        y={Layout.INSTRUMENT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SextantModel.FOREGROUND}
        zoom={Camera.INSTRUMENT.ZOOM}
        pitch={Camera.INSTRUMENT.PITCH}
      />

      <text
        x={Layout.LABEL_X}
        y={Layout.LABEL_Y}
        w={Layout.LABEL_W}
        h={Layout.LABEL_H}
        text={SextantText.GET_LOCATION}
        font={SextantFonts.LABEL}
        color={SextantColors.LABEL}
        shadow
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={SextantArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SextantArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
