import { CS2, predictServerState, useServerState } from 'ts2';

import { chatMessage, playSound, scaled } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { Sounds } from '../lib/game/sounds';
import { Varbits } from '../lib/game/varbits';
import { Catch, CameraWash, Gauge, Layout, TrawlerColor } from './trawler-overlay.constants';

export function waterFilledWidth(water: Int): Int {
  return scaled(Math.min(Gauge.WATER_MAX, Math.max(0, water)), Gauge.WATER_MAX, Layout.GAUGE_W);
}

export function activityClamped(activity: Int): Int {
  return Math.min(Gauge.ACTIVITY_MAX, Math.max(0, activity));
}

export function activityFilledWidth(activity: Int): Int {
  return scaled(activityClamped(activity), Gauge.ACTIVITY_MAX, Layout.GAUGE_W);
}

export function activityColor(activity: Int): Int {
  const clamped: Int = activityClamped(activity);
  if (clamped < Gauge.ACTIVITY_MID_AT) {
    return TrawlerColor.ACTIVITY_LOW;
  } else if (clamped < Gauge.ACTIVITY_HIGH_AT) {
    return TrawlerColor.ACTIVITY_MID;
  }
  return TrawlerColor.ACTIVITY_HIGH;
}

export function netLine(tentacles: Int, railPort: Int, railStarboard: Int, ripped: Int): string {
  if (tentacles > 0) {
    return 'Net: <col=dd0000>Kraken attack!</col>';
  }
  let rail: string = '';
  if (railPort !== 0 || railStarboard !== 0) {
    rail = ' - Rail: <col=dd0000>Broken!</col>';
  }
  if (ripped === 1) {
    return `Net: <col=dd0000>Ripped!</col>${rail}`;
  }
  return `Net: <col=00ff00>OK</col>${rail}`;
}

export function catchLine(caught: Int, activity: Int): string {
  const amount: Int = Math.min(
    Catch.LOTS,
    scaled(
      caught,
      Catch.FACTOR_BASE,
      CS2.interpolate(Catch.FACTOR_MIN, Catch.FACTOR_MAX, Catch.ACTIVITY_AT_MIN, Catch.ACTIVITY_AT_MAX, activity),
    ),
  );
  let tint: string = '<col=dd0000>';
  if (activity >= Gauge.ACTIVITY_MID_AT) {
    tint = '<col=ffffff>';
  }
  if (amount <= 0) {
    return `Catch: ${tint}Nothing`;
  } else if (amount < Catch.LOTS) {
    return `Catch: ${tint}${groupDigits(amount, ',')} fish`;
  }
  return 'Catch: Lots!';
}

export function timeLine(minutes: Int): string {
  if (minutes <= 0) {
    return 'Time left: Under 1 min';
  } else if (minutes === 1) {
    return 'Time left: 1 min';
  }
  return `Time left: ${stringOf(minutes)} mins`;
}

export function cameraEffectOn(atmosphericsDisabled: Int, setting: Int): Boolean {
  return atmosphericsDisabled !== 1 && setting !== 0;
}

export function cameraButtonWash(on: Boolean): Int {
  return on ? CameraWash.BUTTON_ON : CameraWash.DIMMED;
}

export function trawlerCameraOp(option: Int, value: Int, held: Int): Int {
  if (option !== 1) {
    return held;
  }
  const disabled: Int = useServerState(Varbits.OPTION_CAMERA_EFFECT_ATMOSPHERICS_DISABLED);
  if (disabled === 1) {
    playSound(Sounds.PILLORY_WRONG);
    chatMessage(
      'You have disabled all atmospheric camera effects in your settings. Turn them on to enable this button.',
    );
    return disabled;
  }
  playSound(Sounds.INTERFACE_SELECT1);
  predictServerState(Varbits.TRAWLER_CAMERA_STATIC, value);
  return disabled;
}
