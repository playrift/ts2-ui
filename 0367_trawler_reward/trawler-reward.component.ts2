import { createRef } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneBorderNoClose } from './stone-border-no-close.component';
import { setTransparency } from '../lib/lib.components';
import { Dimmer, Fade, RewardColor, RewardFont, RewardSprite } from './trawler-reward.constants';

const noclickSheet = createRef('trawler_reward_noclick');
const confirmDialogue = createRef('trawler_reward_confirmation');

function showDiscardConfirmation(): void {
  confirmDialogue.hide = false;
  noclickSheet.hide = false;
}

function hideDiscardConfirmation(): void {
  confirmDialogue.hide = true;
  noclickSheet.hide = true;
}

export function TrawlerReward(): Component {
  return (
    <>
      <StoneBorderNoClose title="Trawler Catch" />

      <layer x={0} y="bottom" w="fill" h={{ fill: 40 }}>
        <layer x="center" y={{ bottom: 11 }} w={{ fill: 22 }} h={45}>
          <layer x="right" y="bottom" w={40} h={40} options={['Bank-all']}>
            <sprite
              x={0}
              y={0}
              w={40}
              h={40}
              sprite={RewardSprite.TOOL_PLATE}
              onMouseEnter={(event) => setTransparency(event.component, Fade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, Fade.CLEAR)}
            />
            <sprite x="center" y="center" w={29} h={22} sprite={RewardSprite.ICON_BANK} />
          </layer>

          <DiscardAllButton />
        </layer>

        <layer x="center" y={15} w={{ fill: 90 }} h={{ fill: 110 }} />
      </layer>

      <ConfirmDialogue />
    </>
  );
}

function DiscardAllButton(): Component {
  return (
    <layer x={0} y="bottom" w={40} h={40} options={['Discard-all']} onOptionSelect={() => showDiscardConfirmation()}>
      <sprite
        x={0}
        y={0}
        w={40}
        h={40}
        sprite={RewardSprite.TOOL_PLATE}
        onMouseEnter={(event) => setTransparency(event.component, Fade.HOVER)}
        onMouseLeave={(event) => setTransparency(event.component, Fade.CLEAR)}
      />
      <sprite x="center" y="center" w={29} h={22} sprite={RewardSprite.ICON_DISCARD} />
    </layer>
  );
}

function ConfirmDialogue(): Component {
  return (
    <>
      <layer ref={noclickSheet} x={0} y={0} w="fill" h="fill" hide noClickThrough />

      <layer ref={confirmDialogue} x="center" y={{ bottom: 6 }} w={{ fill: 12 }} h={{ fill: 40 }} hide>
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={RewardColor.DIMMER}
          fill
          transparency={Dimmer.TRANSPARENCY}
        />

        <text
          x="center"
          y={30}
          w={128}
          h={20}
          text="Discard all items?"
          font={RewardFont.TITLE}
          color={RewardColor.TEXT}
          shadow
          align="center"
          valign="middle"
        />
        <text
          x="center"
          y={50}
          w={220}
          h={15}
          text="All items will be dropped on the floor."
          font={RewardFont.BODY}
          color={RewardColor.TEXT}
          shadow
          align="center"
        />

        <layer x="center" y={90} w={175} h={95}>
          <layer x="center" y={5} w={100} h={40} options={['Yes']}>
            <sprite
              x={0}
              y={0}
              w="fill"
              h="fill"
              sprite={RewardSprite.BUTTON_BACKING}
              onMouseEnter={(event) => setTransparency(event.component, Fade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, Fade.CLEAR)}
            />
            <StoneButtonEntrypoint />
            <text
              x="center"
              y="center"
              w={32}
              h={25}
              text="Yes"
              font={RewardFont.BUTTON}
              color={RewardColor.TEXT}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer x="center" y={50} w={100} h={40} options={['No']} onOptionSelect={() => hideDiscardConfirmation()}>
            <sprite
              x={0}
              y={0}
              w="fill"
              h="fill"
              sprite={RewardSprite.BUTTON_BACKING}
              onMouseEnter={(event) => setTransparency(event.component, Fade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, Fade.CLEAR)}
            />
            <StoneButtonEntrypoint />
            <text
              x="center"
              y="center"
              w={32}
              h={25}
              text="No"
              font={RewardFont.BUTTON}
              color={RewardColor.TEXT}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </>
  );
}
