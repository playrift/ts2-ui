import { predictServerState, useServerState } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, TrawlerArt, TrawlerFonts, TrawlerModel, TrawlerState } from './trawler-start.constants';

export function trawlerStartSetGraphic(component: ComponentId): void {
  if (useServerState(TrawlerState.INFOBOX) === 0) {
    component.sprite = TrawlerArt.UNCHECKED;
  } else {
    component.sprite = TrawlerArt.CHECKED;
  }
}

export function trawlerStartToggle(component: ComponentId): void {
  predictServerState(TrawlerState.INFOBOX, (useServerState(TrawlerState.INFOBOX) + 1) % 2);
  trawlerStartSetGraphic(component);
}

export function TrawlerStart(): Component {
  return (
    <>
      <model x={240} y={141} w={Layout.ICON} h={Layout.ICON} model={TrawlerModel.SHIP} zoom={472} pitch={484} yaw={3} />

      <model
        x={56}
        y={157}
        w={Layout.ICON}
        h={Layout.ICON}
        model={TrawlerModel.ROPE}
        zoom={899}
        pitch={155}
        yaw={2037}
      />
      <model
        x={55}
        y={191}
        w={Layout.ICON}
        h={Layout.ICON}
        model={TrawlerModel.SWAMP_PASTE}
        zoom={550}
        pitch={218}
        yaw={115}
      />
      <model
        x={53}
        y={246}
        w={Layout.ICON}
        h={Layout.ICON}
        model={TrawlerModel.BUCKET}
        zoom={700}
        pitch={148}
        yaw={1752}
      />
      <model x={48} y={75} w={Layout.ICON} h={Layout.ICON} model={TrawlerModel.AXE} zoom={700} pitch={511} yaw={1407} />
      <model
        x={53}
        y={116}
        w={Layout.ICON}
        h={Layout.ICON}
        model={TrawlerModel.HAMMER}
        zoom={648}
        pitch={454}
        yaw={116}
      />

      <text
        x={{ center: Layout.BODY_X }}
        y={156}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text="Use rope to repair the trawler's nets."
        font={TrawlerFonts.BODY}
        color={Layout.BODY_COLOR}
        lineHeight={Layout.BODY_LINE_HEIGHT}
        valign="middle"
        contentType={Layout.BODY_CONTENT_TYPE}
      />
      <text
        x={{ center: Layout.BODY_X }}
        y={195}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text="Use swamp paste to repair leaks in the ship's hull."
        font={TrawlerFonts.BODY}
        color={Layout.BODY_COLOR}
        lineHeight={Layout.BODY_LINE_HEIGHT}
        valign="middle"
        contentType={Layout.BODY_CONTENT_TYPE}
      />
      <text
        x={{ center: Layout.BODY_X }}
        y={234}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text="If all else fails you can always try and bail the water out as well!"
        font={TrawlerFonts.BODY}
        color={Layout.BODY_COLOR}
        lineHeight={Layout.BODY_LINE_HEIGHT}
        valign="middle"
        contentType={Layout.BODY_CONTENT_TYPE}
      />
      <text
        x={{ center: Layout.BODY_X }}
        y={78}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text="Use an axe to fend off Kraken attacks. Krakens will damage fixed nets."
        font={TrawlerFonts.BODY}
        color={Layout.BODY_COLOR}
        lineHeight={Layout.BODY_LINE_HEIGHT}
        valign="middle"
        contentType={Layout.BODY_CONTENT_TYPE}
      />
      <text
        x={{ center: Layout.BODY_X }}
        y={117}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text="Use a hammer to fix the railing once the Kraken has retreated or it will come back sooner!"
        font={TrawlerFonts.BODY}
        color={Layout.BODY_COLOR}
        lineHeight={Layout.BODY_LINE_HEIGHT}
        valign="middle"
        contentType={Layout.BODY_CONTENT_TYPE}
      />

      <text
        x="center"
        y={51}
        w={355}
        h={23}
        text="How to play:"
        font={TrawlerFonts.BODY}
        color={Layout.HEADING_COLOR}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        x={465}
        y={33}
        w={26}
        h={23}
        sprite={TrawlerArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, TrawlerArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TrawlerArt.CLOSE)}
      />

      <layer
        x="center"
        y={269}
        w={438}
        h={37}
        options={['Select']}
        onOptionSelect={(event) => trawlerStartToggle(event.component)}
      >
        <sprite x={{ center: -88 }} y={5} w={18} h={18} sprite={TrawlerArt.UNCHECKED} />

        <text
          x={{ center: 35 }}
          y={5}
          w={179}
          h={25}
          text="Do not show again"
          font={TrawlerFonts.BODY}
          color={Layout.HEADING_COLOR}
          shadow
        />
      </layer>
    </>
  );
