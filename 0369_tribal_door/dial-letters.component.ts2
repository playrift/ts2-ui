import { useRef, useServerState, useState, useWatch } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { DoorColors, DoorFonts } from './tribal-door.constants';
import { letterOf } from './tribal-door.helpers';
import { dialShownA, dialShownB, dialShownC, dialShownD } from './tribal-door.state';

export function DialLetters(): Component {
  const [codeA, setCodeA] = useState(dialShownA);
  const [codeB, setCodeB] = useState(dialShownB);
  const [codeC, setCodeC] = useState(dialShownC);
  const [codeD, setCodeD] = useState(dialShownD);

  const labelA = useRef();
  const labelB = useRef();
  const labelC = useRef();
  const labelD = useRef();

  useWatch(
    Varps.IF1,
    () => {
      setCodeA(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE1));
    },
    labelA,
  );
  useWatch(
    Varps.IF2,
    () => {
      setCodeB(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE2));
    },
    labelB,
  );
  useWatch(
    Varps.IF3,
    () => {
      setCodeC(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE3));
    },
    labelC,
  );
  useWatch(
    Varps.IF4,
    () => {
      setCodeD(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE4));
    },
    labelD,
  );

  return (
    <>
      <text
        ref={labelA}
        x={65}
        y={97}
        w={9}
        h={17}
        text={letterOf(codeA)}
        font={DoorFonts.TITLE}
        color={DoorColors.TEXT}
        shadow
        align="center"
      />
      <text
        ref={labelB}
        x={189}
        y={97}
        w={9}
        h={17}
        text={letterOf(codeB)}
        font={DoorFonts.TITLE}
        color={DoorColors.TEXT}
        shadow
        align="center"
      />
      <text
        ref={labelC}
        x={313}
        y={97}
        w={9}
        h={17}
        text={letterOf(codeC)}
        font={DoorFonts.TITLE}
        color={DoorColors.TEXT}
        shadow
        align="center"
      />
      <text
        ref={labelD}
        x={437}
        y={97}
        w={9}
        h={17}
        text={letterOf(codeD)}
        font={DoorFonts.TITLE}
        color={DoorColors.TEXT}
        shadow
        align="center"
      />
    </>
  );
}
