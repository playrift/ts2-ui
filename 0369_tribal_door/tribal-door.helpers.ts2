import { predictServerState, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { CodeLetters, RESTING_LETTER } from './tribal-door.constants';
import { dialShownA, dialShownB, dialShownC, dialShownD } from './tribal-door.state';

export enum Dial {
  A = 0,
  B = 1,
  C = 2,
  D = 3,
}

export function letterOf(code: Int): String {
  return CodeLetters.get(code) ?? RESTING_LETTER;
}

function stepDown(code: Int): Int {
  const next: Int = code - 1;
  return next === 0 ? 26 : next;
}

function stepUp(code: Int): Int {
  const next: Int = code + 1;
  return next === 27 ? 1 : next;
}

export function dialTurnLeft(dial: Dial): void {
  const [, setA] = useState(dialShownA);
  const [, setB] = useState(dialShownB);
  const [, setC] = useState(dialShownC);
  const [, setD] = useState(dialShownD);
  if (dial === Dial.A) {
    const next: Int = stepDown(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE1));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE1, next);
    setA(next);
  } else if (dial === Dial.B) {
    const next: Int = stepDown(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE2));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE2, next);
    setB(next);
  } else if (dial === Dial.C) {
    const next: Int = stepDown(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE3));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE3, next);
    setC(next);
  } else if (dial === Dial.D) {
    const next: Int = stepDown(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE4));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE4, next);
    setD(next);
  }
}

export function dialTurnRight(dial: Dial): void {
  const [, setA] = useState(dialShownA);
  const [, setB] = useState(dialShownB);
  const [, setC] = useState(dialShownC);
  const [, setD] = useState(dialShownD);
  if (dial === Dial.A) {
    const next: Int = stepUp(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE1));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE1, next);
    setA(next);
  } else if (dial === Dial.B) {
    const next: Int = stepUp(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE2));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE2, next);
    setB(next);
  } else if (dial === Dial.C) {
    const next: Int = stepUp(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE3));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE3, next);
    setC(next);
  } else if (dial === Dial.D) {
    const next: Int = stepUp(useServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE4));
    predictServerState(Varbits.TOTEMQUEST_COMBODOOR_CODE4, next);
    setD(next);
  }
}
