import { sessionState, useState } from 'ts2';

export const dialShownA = sessionState(0);
export const dialShownB = sessionState(0);
export const dialShownC = sessionState(0);
export const dialShownD = sessionState(0);

export function tribalDoorOpen(): void {
  const [, setA] = useState(dialShownA);
  const [, setB] = useState(dialShownB);
  const [, setC] = useState(dialShownC);
  const [, setD] = useState(dialShownD);
  setA(0);
  setB(0);
  setC(0);
  setD(0);
}
