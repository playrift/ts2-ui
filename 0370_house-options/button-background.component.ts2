import { Sprites } from './house-options.constants';

export function ButtonBackground(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={6} h={6} sprite={Sprites.BUTTON_NW} />
      <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={Sprites.BUTTON_N} tiling />
      <sprite x="right" y="top" w={6} h={6} sprite={Sprites.BUTTON_NE} />
      <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.BUTTON_W} tiling />
      <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={Sprites.BUTTON_C} tiling />
      <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={Sprites.BUTTON_E} tiling />
      <sprite x="left" y="bottom" w={6} h={6} sprite={Sprites.BUTTON_SW} />
      <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={Sprites.BUTTON_S} tiling />
      <sprite x="right" y="bottom" w={6} h={6} sprite={Sprites.BUTTON_SE} />
    </layer>
  );
}
