import { useRef, useServerState } from 'ts2';
import { Sprites, Varbits } from './house-options.constants';

export function DefaultBuildingModeRow(): Component {
  const defaultMode = useServerState(Varbits.TELEPORT_BUILDING_MODE);
  const onIcon = useRef();
  const offIcon = useRef();

  return (
    <>
      <sprite
        ref={onIcon}
        x={138}
        y={106}
        w={17}
        h={17}
        options={['On']}
        sprite={defaultMode === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
        onOptionSelect={() => {
          onIcon.sprite = Sprites.RADIO_SELECTED;
          offIcon.sprite = Sprites.RADIO_EMPTY;
        }}
      />
      <sprite
        ref={offIcon}
        x={{ right: 10 }}
        y={106}
        w={17}
        h={17}
        options={['Off']}
        sprite={defaultMode === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
        onOptionSelect={() => {
          offIcon.sprite = Sprites.RADIO_SELECTED;
          onIcon.sprite = Sprites.RADIO_EMPTY;
        }}
      />
    </>
  );
}
