import { useRef } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { BuildingModeRow } from './building-mode-row.component';
import { DefaultBuildingModeRow } from './default-building-mode-row.component';
import { DoorsRow } from './doors-row.component';
import { Colors, Fonts, Sprites } from './house-options.constants';
import { OptionButton } from './option-button.component';
import { TeleportRow } from './teleport-row.component';
import { ViewerButton } from './viewer-button.component';

export function HouseOptions(): Component {
  const closeButton = useRef();

  return (
    <>
      <text
        x={0}
        y={3}
        w={190}
        h={18}
        text="House Options"
        font={Fonts.TITLE}
        color={Colors.LABEL}
        shadow
        align="center"
      />

      <ViewerButton />

      <text
        x={{ right: 34 }}
        y={53}
        w={20}
        h={15}
        text="On"
        font={Fonts.SMALL}
        color={Colors.LABEL}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={{ right: 4 }}
        y={53}
        w={30}
        h={15}
        text="Off"
        font={Fonts.SMALL}
        color={Colors.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <text
        x="center"
        y={68}
        w={{ fill: 20 }}
        h={17}
        text="Building Mode"
        font={Fonts.BODY}
        color={Colors.LABEL}
        shadow
      />
      <BuildingModeRow />

      <text
        x="center"
        y={87}
        w={{ fill: 20 }}
        h={17}
        text="Teleport Inside"
        font={Fonts.BODY}
        color={Colors.LABEL}
        shadow
      />
      <TeleportRow />

      <text
        x="center"
        y={106}
        w={{ fill: 20 }}
        h={17}
        text="Default Building Mode"
        font={Fonts.BODY}
        color={Colors.LABEL}
        shadow
      />
      <DefaultBuildingModeRow />

      <text x="center" y={128} w={{ fill: 20 }} h={17} text="Doors" font={Fonts.BODY} color={Colors.LABEL} shadow />
      <DoorsRow />

      <OptionButton y={155} label="Expel Guests" />
      <OptionButton y={184} label="Call Servant" />
      <OptionButton y={213} label="Leave House" />

      <text x={0} y={241} w={190} h={16} font={Fonts.BODY} color={Colors.LABEL} shadow align="center" />

      <sprite
        ref={closeButton}
        x={163}
        y={7}
        w={26}
        h={23}
        sprite={Sprites.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, Sprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, Sprites.CLOSE)}
      />

      <layer x={0} y={0} w="fill" h="fill">
        <layer x={0} y={0} w={1} h={1} />
      </layer>
    </>
  );
}
