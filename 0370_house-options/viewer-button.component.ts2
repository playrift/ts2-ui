import { useRef, useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import { ButtonBackground } from './button-background.component';
import { Colors, Fonts, Sprites, Varbits } from './house-options.constants';

export function ViewerButton(): Component {
  const buildingMode = useServerState(Varbits.BUILDING_MODE);
  const label = useRef();

  return buildingMode === 1 ? (
    <layer
      x={10}
      y={25}
      w={105}
      h={40}
      options={['Viewer']}
      onMouseRepeat={() => {
        label.color = Colors.WHITE;
      }}
      onMouseLeave={(event) => {
        label.color = Colors.LABEL;
      }}
      onOptionSelect={(event) => opsound(event.option, 2)}
    >
      <ButtonBackground />
      <sprite x={-2} y="center" w={64} h={32} sprite={Sprites.VIEWER_ICON} />
      <text
        ref={label}
        x={{ right: 0 }}
        y="center"
        w={{ fill: 56 }}
        h="fill"
        text="Viewer"
        font={Fonts.BODY}
        color={Colors.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  ) : (
    <layer x={10} y={25} w={105} h={40} options={['Viewer']}>
      <ButtonBackground />
      <sprite x={-2} y="center" w={64} h={32} sprite={Sprites.VIEWER_ICON} />
      <text
        x={{ right: 0 }}
        y="center"
        w={{ fill: 56 }}
        h="fill"
        text="Viewer"
        font={Fonts.BODY}
        color={Colors.DIM}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
