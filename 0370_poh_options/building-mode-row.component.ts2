import { useRef, useServerState, useState, useWatch } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';
import { pohBuildingMode } from './poh-options.state';

export function BuildingModeRow(): Component {
  const [buildingMode, setBuildingMode] = useState(pohBuildingMode);
  const on = useRef();

  useWatch(
    Varbits.BUILDING_MODE,
    () => {
      setBuildingMode(useServerState(Varbits.BUILDING_MODE));
    },
    on,
  );

  return (
    <>
      <sprite
        ref={on}
        x={138}
        y={68}
        w={17}
        h={17}
        options={['On']}
        sprite={buildingMode === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
      />
      <sprite
        x={{ right: 10 }}
        y={68}
        w={17}
        h={17}
        options={['Off']}
        sprite={buildingMode === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
      />
    </>
  );
}
