import { useServerState } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';

export function BuildingModeRow(): Component {
  const buildingMode = useServerState(Varbits.BUILDING_MODE);

  return (
    <>
      <sprite
        x={138}
        y={68}
        w={17}
        h={17}
        options={['On']}
        sprite={buildingMode === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
      />
      <sprite
        x={{ right: 10 }}
        y={68}
        w={17}
        h={17}
        options={['Off']}
        sprite={buildingMode === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
      />
    </>
  );
}
