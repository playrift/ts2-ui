import { predictServerState, useRef, useServerState, useState, useWatch } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';
import { pohDefaultModeFace } from './poh-options.state';

export function DefaultBuildingModeRow(): Component {
  const [onLit, setOnLit] = useState(pohDefaultModeFace);
  const on = useRef();

  useWatch(
    Varbits.TELEPORT_BUILDING_MODE,
    () => {
      setOnLit(useServerState(Varbits.TELEPORT_BUILDING_MODE));
    },
    on,
  );

  return (
    <>
      <sprite
        ref={on}
        x={138}
        y={106}
        w={17}
        h={17}
        options={['On']}
        sprite={onLit === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
        onOptionSelect={() => {
          predictServerState(Varbits.TELEPORT_BUILDING_MODE, 1);
          setOnLit(1);
        }}
      />
      <sprite
        x={{ right: 10 }}
        y={106}
        w={17}
        h={17}
        options={['Off']}
        sprite={onLit === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
        onOptionSelect={() => {
          predictServerState(Varbits.TELE_TOGGLE, 0);
          setOnLit(0);
        }}
      />
    </>
  );
}
