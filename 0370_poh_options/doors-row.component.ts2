import { useRef, useServerState } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';
import { selectDoors } from './poh-options.helpers';

export function DoorsRow(): Component {
  const option = useServerState(Varbits.DOORS_OPTION);
  const closed = useRef();
  const open = useRef();
  const none = useRef();

  return (
    <>
      <sprite
        x={50}
        y={123}
        w={19}
        h={30}
        sprite={Sprites.DOOR_CLOSED}
        options={['Select']}
        onOptionSelect={() => selectDoors(0, closed, open, none)}
      />
      <sprite
        ref={closed}
        x={70}
        y={131}
        w={17}
        h={17}
        options={['Select']}
        onOptionSelect={() => selectDoors(0, closed, open, none)}
        sprite={option === 0 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
      />

      <sprite
        x={97}
        y={123}
        w={19}
        h={30}
        sprite={Sprites.DOOR_OPEN}
        options={['Select']}
        onOptionSelect={() => selectDoors(1, closed, open, none)}
      />
      <sprite
        ref={open}
        x={117}
        y={131}
        w={17}
        h={17}
        options={['Select']}
        onOptionSelect={() => selectDoors(1, closed, open, none)}
        sprite={option === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
      />

      <sprite
        x={143}
        y={123}
        w={19}
        h={30}
        sprite={Sprites.DOOR_NONE}
        options={['Select']}
        onOptionSelect={() => selectDoors(2, closed, open, none)}
      />
      <sprite
        ref={none}
        x={163}
        y={131}
        w={17}
        h={17}
        options={['Select']}
        onOptionSelect={() => selectDoors(2, closed, open, none)}
        sprite={option !== 0 && option !== 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
      />
    </>
  );
}
