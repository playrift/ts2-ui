import { ButtonBackground } from './button-background.component';
import { Colors, Fonts } from './poh-options.constants';

export function OptionButton({ y, label }: { y: Int; label: String }): Component {
  return (
    <layer x="center" y={y} w={{ fill: 20 }} h={27} options={[label]}>
      <ButtonBackground />
      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        text={label}
        font={Fonts.BODY}
        color={Colors.LABEL}
        hover={{ color: Colors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
