import { Sprites } from './poh-options.constants';

export function selectDoors(option: Int, closed: Ref, open: Ref, none: Ref): void {
  if (option === 0) {
    closed.sprite = Sprites.RADIO_SELECTED;
    open.sprite = Sprites.RADIO_EMPTY;
    none.sprite = Sprites.RADIO_EMPTY;
  } else {
    if (option === 1) {
      closed.sprite = Sprites.RADIO_EMPTY;
      open.sprite = Sprites.RADIO_SELECTED;
      none.sprite = Sprites.RADIO_EMPTY;
    } else {
      closed.sprite = Sprites.RADIO_EMPTY;
      open.sprite = Sprites.RADIO_EMPTY;
      none.sprite = Sprites.RADIO_SELECTED;
    }
  }
}
