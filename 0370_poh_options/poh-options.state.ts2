import { sessionState, useServerState, useState } from 'ts2';

import { Varbits } from './poh-options.constants';

export const pohBuildingMode = sessionState(0);
export const pohTeleportFace = sessionState(0);
export const pohDefaultModeFace = sessionState(0);
export const pohDoorsFace = sessionState(0);

export function pohOptionsOpen(): void {
  const [, setBuildingMode] = useState(pohBuildingMode);
  const [, setTeleport] = useState(pohTeleportFace);
  const [, setDefaultMode] = useState(pohDefaultModeFace);
  const [, setDoors] = useState(pohDoorsFace);
  setBuildingMode(useServerState(Varbits.BUILDING_MODE));
  setTeleport(useServerState(Varbits.TELE_TOGGLE));
  setDefaultMode(useServerState(Varbits.TELEPORT_BUILDING_MODE));
  setDoors(useServerState(Varbits.DOORS_OPTION));
}
