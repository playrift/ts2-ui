import { predictServerState, useRef, useServerState, useState, useWatch } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';
import { pohTeleportFace } from './poh-options.state';

export function TeleportRow(): Component {
  const [offLit, setOffLit] = useState(pohTeleportFace);
  const on = useRef();

  useWatch(
    Varbits.TELE_TOGGLE,
    () => {
      setOffLit(useServerState(Varbits.TELE_TOGGLE));
    },
    on,
  );

  return (
    <>
      <sprite
        ref={on}
        x={138}
        y={87}
        w={17}
        h={17}
        options={['On']}
        sprite={offLit === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
        onOptionSelect={() => {
          predictServerState(Varbits.TELE_TOGGLE, 0);
          setOffLit(0);
        }}
      />
      <sprite
        x={{ right: 10 }}
        y={87}
        w={17}
        h={17}
        options={['Off']}
        sprite={offLit === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
        onOptionSelect={() => {
          predictServerState(Varbits.TELE_TOGGLE, 1);
          setOffLit(0);
        }}
      />
    </>
  );
}
