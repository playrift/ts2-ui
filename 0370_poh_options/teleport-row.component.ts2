import { useRef, useServerState } from 'ts2';
import { Sprites, Varbits } from './poh-options.constants';

export function TeleportRow(): Component {
  const teleToggle = useServerState(Varbits.TELE_TOGGLE);
  const on = useRef();
  const offIcon = useRef();

  return (
    <>
      <sprite
        ref={on}
        x={138}
        y={87}
        w={17}
        h={17}
        options={['On']}
        sprite={teleToggle === 1 ? Sprites.RADIO_EMPTY : Sprites.RADIO_SELECTED}
        onOptionSelect={() => {
          on.sprite = Sprites.RADIO_SELECTED;
          offIcon.sprite = Sprites.RADIO_EMPTY;
        }}
      />
      <sprite
        ref={offIcon}
        x={{ right: 10 }}
        y={87}
        w={17}
        h={17}
        options={['Off']}
        sprite={teleToggle === 1 ? Sprites.RADIO_SELECTED : Sprites.RADIO_EMPTY}
        onOptionSelect={() => {
          offIcon.sprite = Sprites.RADIO_EMPTY;
          on.sprite = Sprites.RADIO_SELECTED;
        }}
      />
    </>
  );
}
