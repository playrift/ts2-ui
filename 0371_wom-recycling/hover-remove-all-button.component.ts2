import { useState } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';

export function HoverRemoveAllButton(): Component {
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      w="fill"
      h="fill"
      options={['Remove All']}
      onMouseOver={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedEntrypoint /> : <StoneButtonEntrypoint />}
    </layer>
  );
}
