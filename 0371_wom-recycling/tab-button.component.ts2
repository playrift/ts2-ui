import { predictServerState, useRef, useServerState } from 'ts2';
import { TabSprite, Varbits, WomColor, WomFont } from './wom-recycling.constants';
import { isSelectedTab } from './wom-recycling.helpers';

export function TabButton({ index, x, w, label }: { index: Int; x: Int; w: Int; label: String }): Component {
  const selectedTab = useServerState(Varbits.WOM_INTERFACE_TAB);
  const selected = isSelectedTab(selectedTab, index);
  const labelRef = useRef();

  return (
    <layer
      x={x}
      y={0}
      w={w}
      h="fill"
      options={['Select']}
      onOptionSelect={() => {
        predictServerState(Varbits.WOM_INTERFACE_TAB, index);
      }}
      onMouseOver={() => {
        labelRef.color = WomColor.HOVER;
      }}
      onMouseLeave={() => {
        labelRef.color = WomColor.LABEL;
      }}
    >
      <sprite x="left" y={0} w={20} h={20} sprite={selected ? TabSprite.LEFT_ON : TabSprite.LEFT_OFF} />
      <sprite
        x="center"
        y={0}
        w={{ fill: 40 }}
        h={20}
        sprite={selected ? TabSprite.MIDDLE_ON : TabSprite.MIDDLE_OFF}
        tiling
      />
      <sprite x="right" y={0} w={20} h={20} sprite={selected ? TabSprite.END_ON : TabSprite.END_OFF} />
      <text
        ref={labelRef}
        x={3}
        y={0}
        w={{ fill: 20 }}
        h="fill"
        text={label}
        font={WomFont.LABEL}
        color={WomColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
