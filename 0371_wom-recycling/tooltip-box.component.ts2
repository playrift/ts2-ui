import { CS2 } from 'ts2';

export function TooltipBox({
  text,
  width,
  x,
  fromBottom,
}: {
  text: String;
  width: Int;
  x: Int;
  fromBottom: Int;
}): Component {
  const boxWidth: Int = 4 + CS2.parawidth(text, width, 495);
  const boxHeight: Int = 7 + 12 * CS2.paraheight(text, width, 495);

  return (
    <layer x={x} y={{ bottom: fromBottom }} w={boxWidth} h={boxHeight}>
      <rect x="center" y="center" w="fill" h="fill" color={0xffffa0} fill />
      <rect x="center" y="center" w="fill" h="fill" color={0x000000} />
      <text
        x="center"
        y="bottom"
        w={{ fill: 4 }}
        h={{ fill: 1 }}
        text={text}
        align="left"
        valign="top"
        font={495}
        color={0x000000}
      />
    </layer>
  );
}
