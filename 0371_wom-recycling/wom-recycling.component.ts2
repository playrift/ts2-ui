import { useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { WomAnim, WomColor, WomFont, WomModel, WomScrollbar, WomSprite } from './wom-recycling.constants';
import { HoverFilledButton } from './hover-filled-button.component';
import { HoverRemoveAllButton } from './hover-remove-all-button.component';
import { TabButton } from './tab-button.component';

export function WomRecycling(): Component {
  const items = useRef();

  return (
    <layer w="fill" h="fill" x="center" y="center">
      <SteelBorderEntrypoint title="Wise Old Man's Recycling Centre" />

      <layer x="center" y={40} w={{ fill: 10 }} h={{ fill: 45 }}>
        <layer x={0} y={0} w="fill" h={20}>
          {CS2.map_members() && <TabButton index={0} x={0} w={50} label="All" />}
          {CS2.map_members() && <TabButton index={1} x={50} w={80} label="Members" />}
          <TabButton index={2} x={130} w={80} label="Free" />
        </layer>

        <layer x={0} y="bottom" w={32} h={32}>
          <model
            x={0}
            y="bottom"
            w={32}
            h={32}
            model={WomModel.BIN}
            zoom={5000}
            pitch={140}
            yaw={220}
            offsetX={15}
            offsetY={200}
          />
          <model
            x={0}
            y="bottom"
            w={32}
            h={32}
            model={WomModel.BIN}
            anim={WomAnim.SMOKE}
            zoom={5000}
            pitch={141}
            yaw={220}
            offsetX={15}
            offsetY={200}
          />
        </layer>

        <text
          x={{ right: 1 }}
          y={{ bottom: 1 }}
          w={70}
          h={28}
          text="Remove All"
          font={WomFont.LABEL}
          color={WomColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <layer x={{ right: 1 }} y={{ bottom: 1 }} w={70} h={28}>
          <HoverRemoveAllButton />
        </layer>

        <layer ref={items} x={0} y={32} w={{ fill: 16 }} h={{ fill: 64 }} />
        <layer x="right" y={32} w={16} h={{ fill: 64 }}>
          <ScrollbarVertical
            content={items}
            track={WomScrollbar.TRACK}
            capTopSprite={WomScrollbar.CAP_TOP}
            thumbSprite={WomScrollbar.THUMB}
            capBottomSprite={WomScrollbar.CAP_BOTTOM}
            arrowUp={WomScrollbar.ARROW_UP}
            arrowDown={WomScrollbar.ARROW_DOWN}
          />
        </layer>
      </layer>

      <layer x={0} y={0} w={512} h={334} />

      <layer x="center" y={30} w={{ fill: 10 }} h={{ fill: 35 }} hide noClickThrough>
        <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={WomSprite.BACKDROP} tiling />

        <layer x="center" y={85} w={{ fill: 140 }} h={{ fill: 160 }}>
          <ThinBoxEntrypoint>
            <sprite x="center" y="center" w="fill" h="fill" sprite={WomSprite.CONFIRM_BOX} tiling />
          </ThinBoxEntrypoint>

          <layer x="center" y={0} w={{ fill: 4 }} h={{ fill: 4 }}>
            <layer x={{ right: 30 }} y={{ bottom: 10 }} w={70} h={28}>
              <HoverFilledButton op="Confirm" />
            </layer>
            <layer x={30} y={{ bottom: 10 }} w={70} h={28}>
              <HoverFilledButton op="Decline" />
            </layer>

            <text
              x={{ right: 30 }}
              y={{ bottom: 10 }}
              w={70}
              h={28}
              text="Confirm"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x="center"
              y={14}
              w={250}
              h={28}
              text="Would you like to remove all of the items?"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x={30}
              y={{ bottom: 10 }}
              w={70}
              h={28}
              text="Decline"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
