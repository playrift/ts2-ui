import { onUpdated, predictServerState, useRef, useServerState, useState } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  TabSprite,
  Varbits,
  WomAnim,
  WomColor,
  WomFont,
  WomModel,
  WomScrollbar,
  WomSprite,
} from './wom-recycling.constants';
import { HoverFilledButton } from './hover-filled-button.component';
import { TooltipBox } from './tooltip-box.component';
import { HoverRemoveAllButton } from './hover-remove-all-button.component';
import { WomItemGrid, womGridHeight } from './item-grid.component';
import { freeWorld, paintTabs, tabWidth } from './wom-recycling.helpers';
import { membersWorld } from '../lib/lib.engine';

export function WomRecycling(): Component {
  const items = useRef();
  const [hovered, setHovered] = useState(0);
  const tab = useServerState(Varbits.WOM_INTERFACE_TAB);

  onUpdated(() => {
    items.scrollY = items.scrollY;
  });
  const allWidth: Int = tabWidth('All');
  const membersWidth: Int = tabWidth('Members');
  const freeWidth: Int = tabWidth('Free');

  const left0 = useRef();
  const middle0 = useRef();
  const right0 = useRef();
  const label0 = useRef();
  const left1 = useRef();
  const middle1 = useRef();
  const right1 = useRef();
  const label1 = useRef();
  const left2 = useRef();
  const middle2 = useRef();
  const right2 = useRef();
  const label2 = useRef();

  return (
    <layer w={{ fill: 40 }} h={{ fill: 40 }} x="center" y="center">
      <SteelBorderEntrypoint title="Wise Old Man's Recycling Centre" />

      <layer x="center" y={40} w={{ fill: 10 }} h={{ fill: 45 }}>
        <layer x={0} y={0} w="fill" h={20}>
          <layer
            x={0}
            y="center"
            w={allWidth}
            h="fill"
            hide={freeWorld()}
            options={['Select']}
            onOptionSelect={() => {
              predictServerState(Varbits.WOM_INTERFACE_TAB, 0);
              paintTabs(0, left0, middle0, right0, left1, middle1, right1, left2, middle2, right2);
            }}
            onMouseEnter={() => {
              label0.color = WomColor.HOVER;
            }}
            onMouseLeave={() => {
              label0.color = WomColor.LABEL;
            }}
          >
            <sprite ref={left0} x="left" y={0} w={20} h={20} sprite={TabSprite.LEFT_ON} />
            <sprite ref={middle0} x="center" y={0} w={{ fill: 40 }} h={20} sprite={TabSprite.MIDDLE_ON} tiling />
            <sprite ref={right0} x="right" y={0} w={20} h={20} sprite={TabSprite.END_ON} />
            <text
              ref={label0}
              x={3}
              y={0}
              w={{ fill: 20 }}
              h="fill"
              text="All"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer
            x={allWidth + freeWidth}
            y="center"
            w={membersWidth}
            h="fill"
            hide={freeWorld()}
            options={['Select']}
            onOptionSelect={() => {
              predictServerState(Varbits.WOM_INTERFACE_TAB, 1);
              paintTabs(1, left0, middle0, right0, left1, middle1, right1, left2, middle2, right2);
            }}
            onMouseEnter={() => {
              label1.color = WomColor.HOVER;
            }}
            onMouseLeave={() => {
              label1.color = WomColor.LABEL;
            }}
          >
            <sprite ref={left1} x="left" y={0} w={20} h={20} sprite={TabSprite.LEFT_ON} />
            <sprite ref={middle1} x="center" y={0} w={{ fill: 40 }} h={20} sprite={TabSprite.MIDDLE_ON} tiling />
            <sprite ref={right1} x="right" y={0} w={20} h={20} sprite={TabSprite.END_ON} />
            <text
              ref={label1}
              x={3}
              y={0}
              w={{ fill: 20 }}
              h="fill"
              text="Members"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer
            x={membersWorld() ? allWidth : 0}
            y="center"
            w={freeWidth}
            h="fill"
            options={['Select']}
            onOptionSelect={() => {
              predictServerState(Varbits.WOM_INTERFACE_TAB, 2);
              paintTabs(2, left0, middle0, right0, left1, middle1, right1, left2, middle2, right2);
            }}
            onMouseEnter={() => {
              label2.color = WomColor.HOVER;
            }}
            onMouseLeave={() => {
              label2.color = WomColor.LABEL;
            }}
          >
            <sprite ref={left2} x="left" y={0} w={20} h={20} sprite={TabSprite.LEFT_ON} />
            <sprite ref={middle2} x="center" y={0} w={{ fill: 40 }} h={20} sprite={TabSprite.MIDDLE_ON} tiling />
            <sprite ref={right2} x="right" y={0} w={20} h={20} sprite={TabSprite.END_ON} />
            <text
              ref={label2}
              x={3}
              y={0}
              w={{ fill: 20 }}
              h="fill"
              text="Free"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>

        <layer
          x={0}
          y="bottom"
          w={32}
          h={32}
          onMouseEnter={() => {
            setHovered(1);
          }}
          onMouseLeave={() => {
            setHovered(0);
          }}
        >
          <model
            x={0}
            y="bottom"
            w={32}
            h={32}
            model={WomModel.BIN}
            zoom={5000}
            pitch={140}
            yaw={220}
            offsetX={15}
            offsetY={200}
          />
          <model
            x={0}
            y="bottom"
            w={32}
            h={32}
            model={WomModel.BIN}
            anim={WomAnim.SMOKE}
            zoom={5000}
            pitch={141}
            yaw={220}
            offsetX={15}
            offsetY={200}
          />
        </layer>

        <text
          x={{ right: 1 }}
          y={{ bottom: 1 }}
          w={70}
          h={28}
          text="Remove All"
          font={WomFont.LABEL}
          color={WomColor.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <HoverRemoveAllButton x={{ right: 1 }} y={{ bottom: 1 }} w={70} h={28} />

        <layer
          ref={items}
          x={0}
          y={32}
          w={{ fill: 16 }}
          h={{ fill: 64 }}
          scrollHeight={womGridHeight(items.width, membersWorld(), tab)}
        >
          <WomItemGrid width={items.width} members={membersWorld()} tab={tab} />
        </layer>
        <layer x="right" y={32} w={16} h={{ fill: 64 }}>
          <ScrollbarVertical
            content={items}
            track={WomScrollbar.TRACK}
            capTopSprite={WomScrollbar.CAP_TOP}
            thumbSprite={WomScrollbar.THUMB}
            capBottomSprite={WomScrollbar.CAP_BOTTOM}
            arrowUp={WomScrollbar.ARROW_UP}
            arrowDown={WomScrollbar.ARROW_DOWN}
          />
        </layer>
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        {hovered === 1 && (
          <TooltipBox
            x={26}
            fromBottom={11}
            width={508}
            text="Drag items here from the recycling centre to remove them."
          />
        )}
      </layer>

      <layer x="center" y={30} w={{ fill: 10 }} h={{ fill: 35 }} hide noClickThrough>
        <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={WomSprite.BACKDROP} tiling />

        <layer x="center" y={85} w={{ fill: 140 }} h={{ fill: 160 }}>
          <ThinBoxEntrypoint>
            <sprite x="center" y="center" w="fill" h="fill" sprite={WomSprite.CONFIRM_BOX} tiling />
          </ThinBoxEntrypoint>

          <layer x="center" y={0} w={{ fill: 4 }} h={{ fill: 4 }}>
            <HoverFilledButton op="Confirm" x={{ right: 30 }} y={{ bottom: 10 }} w={70} h={28} />
            <HoverFilledButton op="Decline" x={30} y={{ bottom: 10 }} w={70} h={28} />

            <text
              x={{ right: 30 }}
              y={{ bottom: 10 }}
              w={70}
              h={28}
              text="Confirm"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x="center"
              y={14}
              w={250}
              h={28}
              text="Would you like to remove all of the items?"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x={30}
              y={{ bottom: 10 }}
              w={70}
              h={28}
              text="Decline"
              font={WomFont.LABEL}
              color={WomColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
