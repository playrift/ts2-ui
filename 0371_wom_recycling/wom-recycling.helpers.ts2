import { TabSprite, WomFont } from './wom-recycling.constants';
import { membersWorld, textWidth } from '../lib/lib.engine';

export function isSelectedTab(selected: Int, index: Int): Boolean {
  if (selected === index) {
    return true;
  }
  return false;
}

export function tabWidth(label: String): Int {
  return Math.max(40, 40 + textWidth(label, 400, WomFont.LABEL));
}

export function paintTabs(
  selected: Int,
  left0: Ref,
  middle0: Ref,
  right0: Ref,
  left1: Ref,
  middle1: Ref,
  right1: Ref,
  left2: Ref,
  middle2: Ref,
  right2: Ref,
): void {
  left0.sprite = selected === 0 ? TabSprite.LEFT_ON : TabSprite.LEFT_OFF;
  middle0.sprite = selected === 0 ? TabSprite.MIDDLE_ON : TabSprite.MIDDLE_OFF;
  right0.sprite = selected === 0 ? TabSprite.END_ON : TabSprite.END_OFF;
  left1.sprite = selected === 1 ? TabSprite.LEFT_ON : TabSprite.LEFT_OFF;
  middle1.sprite = selected === 1 ? TabSprite.MIDDLE_ON : TabSprite.MIDDLE_OFF;
  right1.sprite = selected === 1 ? TabSprite.END_ON : TabSprite.END_OFF;
  left2.sprite = selected === 2 ? TabSprite.LEFT_ON : TabSprite.LEFT_OFF;
  middle2.sprite = selected === 2 ? TabSprite.MIDDLE_ON : TabSprite.MIDDLE_OFF;
  right2.sprite = selected === 2 ? TabSprite.END_ON : TabSprite.END_OFF;
}

export function freeWorld(): Boolean {
  if (membersWorld()) {
    return false;
  }
  return true;
}
