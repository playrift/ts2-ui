export function journalSprite(look: Int, piece: Int): Sprite {
  if (look === JournalLook.HELD) {
    if (piece === 0) {
      return Sprites.TRADEBACKING_DARK;
    }
    if (piece === 1) {
      return Sprites.V2_STONE_BUTTON_IN_0;
    }
    if (piece === 2) {
      return Sprites.V2_STONE_BUTTON_IN_1;
    }
    if (piece === 3) {
      return Sprites.V2_STONE_BUTTON_IN_2;
    }
    if (piece === 4) {
      return Sprites.V2_STONE_BUTTON_IN_3;
    }
    if (piece === 5) {
      return Sprites.V2_STONE_BUTTON_IN_4;
    }
    if (piece === 6) {
      return Sprites.V2_STONE_BUTTON_IN_5;
    }
    if (piece === 7) {
      return Sprites.V2_STONE_BUTTON_IN_6;
    }
    return Sprites.V2_STONE_BUTTON_IN_7;
  }
  if (look === JournalLook.HOVER) {
    if (piece === 0) {
      return Sprites.TRADEBACKING_LIGHT;
    }
    if (piece === 1) {
      return Sprites.V2_STONE_BUTTON_OUT_0;
    }
    if (piece === 2) {
      return Sprites.V2_STONE_BUTTON_OUT_1;
    }
    if (piece === 3) {
      return Sprites.V2_STONE_BUTTON_OUT_2;
    }
    if (piece === 4) {
      return Sprites.V2_STONE_BUTTON_OUT_3;
    }
    if (piece === 5) {
      return Sprites.V2_STONE_BUTTON_OUT_4;
    }
    if (piece === 6) {
      return Sprites.V2_STONE_BUTTON_OUT_5;
    }
    if (piece === 7) {
      return Sprites.V2_STONE_BUTTON_OUT_6;
    }
    return Sprites.V2_STONE_BUTTON_OUT_7;
  }
  if (piece === 0) {
    return Sprites.TRADEBACKING;
  }
  if (piece === 1) {
    return Sprites.V2_STONE_BUTTON_0;
  }
  if (piece === 2) {
    return Sprites.V2_STONE_BUTTON_1;
  }
  if (piece === 3) {
    return Sprites.V2_STONE_BUTTON_2;
  }
  if (piece === 4) {
    return Sprites.V2_STONE_BUTTON_3;
  }
  if (piece === 5) {
    return Sprites.V2_STONE_BUTTON_4;
  }
  if (piece === 6) {
    return Sprites.V2_STONE_BUTTON_5;
  }
  if (piece === 7) {
    return Sprites.V2_STONE_BUTTON_6;
  }
  return Sprites.V2_STONE_BUTTON_7;
}

export const JournalLook = {
  REST: 0,
  HOVER: 1,
  HELD: 2,
} as const;

