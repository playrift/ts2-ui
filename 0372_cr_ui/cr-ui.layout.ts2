import { Layout } from './cr-ui.constants';

export const CR_MODULE_COUNT = 1;

export function crUiHasTabs(): Boolean {
  return CR_MODULE_COUNT > 1;
}

export function crUiMinWidth(): Int {
  return crUiHasTabs() ? 300 + Layout.TABS_W : 300;
}

export function crUiDefaultWidth(): Int {
  return crUiHasTabs() ? 400 + Layout.TABS_W : 400;
}

export function crUiMinHeight(): Int {
  return 200;
}

export function crUiDefaultHeight(): Int {
  return 314;
}

export function opacityToTransparency(percent: Int): Int {
  return 255 - (255 * percent) / 100;
}

export function summaryPieceTop(top: Int, h: Int): Int {
  const middle: Int = top + 5 + 16 / 2;
  if (h === 0) {
    return middle;
  }
  return middle - h / 2;
}

export function descriptionPieceTop(top: Int, h: Int): Int {
  const lineTop: Int = summaryPieceTop(top, 0) + 16 / 2 + 4;
  const middle: Int = lineTop + 12 / 2;
  if (h === 0) {
    return middle;
  }
  return middle - h / 2;
}

export function detailPieceTop(line: Int, lines: Int, top: Int, h: Int): Int {
  const first: Int = descriptionPieceTop(top, 0) + 12 / 2 + 5;
  let span: Int = 12 * lines;
  if (lines > 1) {
    span = span + 4 * (lines - 1);
  }
  const middle: Int = first + (12 + 4) * line + span / 2;
  if (h === 0) {
    return middle;
  }
  return middle - h / 2;
}

export function descriptionWidth(listWidth: Int): Int {
  return listWidth - 23 - 4;
}

export function descriptionCursorAt(x: Int): Int {
  return x - 23;
}

export function detailsWidth(listWidth: Int): Int {
  return listWidth - 23 - 4 - (80 + 3);
}
