import { createRef, useInterval, useWatch } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  CHAMPION_PLACEHOLDER,
  FightpitColor,
  FightpitFonts,
  FightpitVarps,
  Layout,
  TzhaarFightpit,
} from './tzhaar-fightpit.constants';
import { foesRemaining } from './tzhaar-fightpit.helpers';

const timerHost = createRef('0373_tzhaar_fightpit_timer_host');

const content = createRef('tzhaar_fightpit_content');

const foes = createRef('tzhaar_fightpit_foes');

export function TzhaarFightpit_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, TzhaarFightpit.DODGE, Anchor.CENTRE, Anchor.TOP, 0), timerHost);

  useWatch(FightpitVarps.FOES_REMAINING, (event) => foesRemaining(event.component), foes);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x="center" y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <text
            x="center"
            y={Layout.CHAMPION_Y}
            w={Layout.CHAMPION_W}
            h={Layout.CHAMPION_H}
            font={FightpitFonts.CHAMPION}
            text={CHAMPION_PLACEHOLDER}
            align="center"
            shadow
            color={FightpitColor.CHAMPION}
          />

          <layer x="center" y={Layout.ROW_Y} w={Layout.ROW_W} h={Layout.ROW_H}>
            <text
              x="center"
              y={Layout.FOES_Y}
              w="fill"
              h={Layout.FOES_H}
              font={FightpitFonts.FOES}
              text="Foes Remaining:"
              align="center"
              shadow
              color={FightpitColor.FOES}
              ref={foes}
              onLoad={(event) => foesRemaining(event.component)}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
