import { useServerState } from 'ts2';

import { FightpitVarps } from './tzhaar-fightpit.constants';

export function foesRemaining(label: ComponentId): void {
  const remaining: Int = useServerState(FightpitVarps.FOES_REMAINING);
  if (remaining < 1) {
    label.text = "You're the Winner!";
  } else {
    label.text = `Foes Remaining: ${remaining}`;
  }
}
