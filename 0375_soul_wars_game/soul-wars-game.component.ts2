import { createRef, useInterval } from 'ts2';

import { StonePanel } from '../0648_target_streaks/stone-panel.component';
import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, SoulWarsColor, SoulWarsDodge, SoulWarsFonts, SoulWarsSprites } from './soul-wars-game.constants';
import { ActivityBar, SiteBar, SiteFrame, SiteWash } from './soul-wars-game.parts';
import { Site, tickSoulWarsFlash } from './soul-wars-game.state';
import { SlimJoins } from './stone-panel-tinted.component';

const timerHost1 = createRef('0375_soul_wars_game_timer_host1');

const timerHost2 = createRef('0375_soul_wars_game_timer_host2');

const content = createRef('soul_wars_game_content');

export function SoulWarsGame(): Component {
  useInterval(() => tickSoulWarsFlash(), timerHost1);
  useInterval(() => overlayRelayout(timerHost2, content, SoulWarsDodge.WORD, Anchor.LEFT, Anchor.TOP, 0), timerHost2);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <layer x={0} y={0} w="fill" h="fill" ref={timerHost2}>
        <layer static ref={content} x={Layout.CONTENT_X} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <layer x={0} y={0} w={Layout.ACTIVITY_W} h={Layout.PLATE_H}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={SoulWarsSprites.BACKING}
              tiling
              transparency={Layout.BACKING_ALPHA}
            />
            <layer x="center" y="center" w={{ fill: Layout.WELL_INSET }} h={{ fill: Layout.WELL_INSET }}>
              <ActivityBar />
            </layer>
            <StonePanel divider={Layout.DIVIDER} />
            <SlimJoins />
          </layer>

          <layer x={Layout.STATS_X} y={0} w={Layout.STATS_W} h={Layout.PLATE_H}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={SoulWarsSprites.BACKING}
              tiling
              transparency={Layout.BACKING_ALPHA}
            />

            <layer x="center" y={Layout.ROW_Y_KILLS} w={{ fill: Layout.ROW_INSET_KILLS }} h={Layout.ROW_H}>
              <text
                x="center"
                y={0}
                w={{ fill: Layout.CAPTION_INSET }}
                h={Layout.CAPTION_H}
                font={SoulWarsFonts.LABEL}
                text="Avatar Kills"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.CAPTION}
              />
              <text
                x={{ center: -Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="0"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.BLUE}
              />
              <text
                x={{ center: Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="0"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.RED}
              />
            </layer>

            <layer x="center" y={Layout.ROW_Y_HEALTH} w={{ fill: Layout.ROW_INSET }} h={Layout.ROW_H}>
              <text
                x="center"
                y={0}
                w={{ fill: Layout.CAPTION_INSET }}
                h={Layout.CAPTION_H}
                font={SoulWarsFonts.LABEL}
                text="Avatar Health"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.CAPTION}
              />
              <text
                x={{ center: -Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="100%"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.BLUE}
              />
              <text
                x={{ center: Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="100%"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.RED}
              />
            </layer>

            <layer x="center" y={Layout.ROW_Y_STRENGTH} w={{ fill: Layout.ROW_INSET }} h={Layout.ROW_H}>
              <text
                x="center"
                y={0}
                w={{ fill: Layout.CAPTION_INSET }}
                h={Layout.CAPTION_H}
                font={SoulWarsFonts.LABEL}
                text="Avatar Strength"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.CAPTION}
              />
              <text
                x={{ center: -Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="100%"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.BLUE}
              />
              <text
                x={{ center: Layout.VALUE_DX }}
                y="bottom"
                w={Layout.VALUE_W}
                h={Layout.VALUE_H}
                font={SoulWarsFonts.LABEL}
                text="100%"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.RED}
              />
            </layer>

            <layer x="center" y={Layout.ROW_Y_TIME} w={{ fill: Layout.ROW_INSET }} h={Layout.ROW_H}>
              <text
                x={{ center: Layout.TIME_CAPTION_INSET }}
                y={0}
                w={{ fill: Layout.TIME_CAPTION_INSET }}
                h={Layout.CAPTION_H}
                font={SoulWarsFonts.LABEL}
                text="Time Left"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.CAPTION}
              />
              <text
                x="center"
                y="bottom"
                w={{ fill: Layout.TIME_VALUE_INSET }}
                h={Layout.CAPTION_H}
                font={SoulWarsFonts.LABEL}
                text="10:00"
                align="center"
                valign="middle"
                shadow
                color={SoulWarsColor.CAPTION}
              />
            </layer>

            <StonePanelEntrypoint divider={Layout.DIVIDER} />
          </layer>

          <layer x={Layout.SITE_X_WEST} y={Layout.SITE_Y} w={Layout.SITE_W} h={Layout.SITE_H}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={SoulWarsSprites.BACKING}
              tiling
              transparency={Layout.BACKING_ALPHA}
            />
            <layer x="center" y={Layout.WASH_Y} w={{ fill: Layout.WASH_INSET }} h={Layout.WASH_H}>
              <SiteWash site={Site.WEST} />
            </layer>
            <sprite x="center" y={Layout.WASH_Y} w={Layout.ICON} h={Layout.ICON} sprite={SoulWarsSprites.WEST} />
            <layer
              x="center"
              y={{ bottom: Layout.WASH_Y }}
              w={{ fill: Layout.BAR_INSET }}
              h={{ fill: Layout.BAR_H_INSET }}
            >
              <SiteBar site={Site.WEST} />
            </layer>
            <layer x={0} y={0} w="fill" h="fill">
              <SiteFrame site={Site.WEST} />
            </layer>
          </layer>

          <layer x={Layout.SITE_X_OBELISK} y={Layout.SITE_Y} w={Layout.SITE_W} h={Layout.SITE_H}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={SoulWarsSprites.BACKING}
              tiling
              transparency={Layout.BACKING_ALPHA}
            />
            <layer x="center" y={Layout.WASH_Y} w={{ fill: Layout.WASH_INSET }} h={Layout.WASH_H}>
              <SiteWash site={Site.OBELISK} />
            </layer>
            <sprite x="center" y={Layout.WASH_Y} w={Layout.ICON} h={Layout.ICON} sprite={SoulWarsSprites.OBELISK} />
            <layer
              x="center"
              y={{ bottom: Layout.WASH_Y }}
              w={{ fill: Layout.BAR_INSET }}
              h={{ fill: Layout.BAR_H_INSET }}
            >
              <SiteBar site={Site.OBELISK} />
            </layer>
            <layer x={0} y={0} w="fill" h="fill">
              <SiteFrame site={Site.OBELISK} />
            </layer>
          </layer>

          <layer x={Layout.SITE_X_EAST} y={Layout.SITE_Y} w={Layout.SITE_W} h={Layout.SITE_H}>
            <sprite
              x="center"
              y="center"
              w="fill"
              h="fill"
              sprite={SoulWarsSprites.BACKING}
              tiling
              transparency={Layout.BACKING_ALPHA}
            />
            <layer x="center" y={Layout.WASH_Y} w={{ fill: Layout.WASH_INSET }} h={Layout.WASH_H}>
              <SiteWash site={Site.EAST} />
            </layer>
            <sprite x="center" y={Layout.WASH_Y} w={Layout.ICON} h={Layout.ICON} sprite={SoulWarsSprites.EAST} />
            <layer
              x="center"
              y={{ bottom: Layout.WASH_Y }}
              w={{ fill: Layout.BAR_INSET }}
              h={{ fill: Layout.BAR_H_INSET }}
            >
              <SiteBar site={Site.EAST} />
            </layer>
            <layer x={0} y={0} w="fill" h="fill">
              <SiteFrame site={Site.EAST} />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
