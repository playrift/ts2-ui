import { stopTimer, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { clientClock } from '../lib/lib.engine';
import { Flash, SoulWarsColor } from './soul-wars-game.constants';

export enum Site {
  WEST = 0,
  OBELISK = 1,
  EAST = 2,
}

export function siteContested(site: Site): Int {
  switch (site) {
    case Site.WEST:
      return useServerState(Varbits.SOUL_WARS_WEST_GY_CONTESTED);
    case Site.OBELISK:
      return useServerState(Varbits.SOUL_WARS_OBELISK_CONTESTED);
    case Site.EAST:
      return useServerState(Varbits.SOUL_WARS_EAST_GY_CONTESTED);
  }
  return 0;
}

export function siteHolder(site: Site): Int {
  switch (site) {
    case Site.WEST:
      return useServerState(Varbits.SOUL_WARS_WEST_GY_HOLDER);
    case Site.OBELISK:
      return useServerState(Varbits.SOUL_WARS_OBELISK_HOLDER);
    case Site.EAST:
      return useServerState(Varbits.SOUL_WARS_EAST_GY_HOLDER);
  }
  return 0;
}

export function siteAlignment(site: Site): Int {
  switch (site) {
    case Site.WEST:
      return useServerState(Varbits.SOUL_WARS_WEST_GY_ALIGNMENT);
    case Site.OBELISK:
      return useServerState(Varbits.SOUL_WARS_OBELISK_ALIGNMENT);
    case Site.EAST:
      return useServerState(Varbits.SOUL_WARS_EAST_GY_ALIGNMENT);
  }
  return 0;
}

export function holderColor(holder: Int): Int {
  if (holder === 1) {
    return SoulWarsColor.TEAM_BLUE;
  }
  if (holder === 2) {
    return SoulWarsColor.TEAM_RED;
  }
  return SoulWarsColor.NEUTRAL;
}

export function siteFlash(
  frame: ComponentId,
  plain: ComponentId,
  blue: ComponentId,
  red: ComponentId,
  site: Site,
): void {
  const contested: Int = siteContested(site);
  if (contested !== 1 && contested !== 2) {
    plain.hide = false;
    blue.hide = true;
    red.hide = true;
    stopTimer(frame);
    return;
  }
  let lit: Int = 0;
  if (clientClock() % Flash.PERIOD >= Flash.HALF) {
    lit = contested;
  }
  plain.hide = lit !== 0;
  blue.hide = lit !== 1;
  red.hide = lit !== 2;
  frame.onTimer = () => siteFlash(frame, plain, blue, red, site);
}
