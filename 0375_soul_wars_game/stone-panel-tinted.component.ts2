import { Layout, SlimJoinSprite, StonePanelBlueSprite, StonePanelRedSprite } from './soul-wars-game.constants';

export function StonePanelBlue({ divider = 0 }: { divider?: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={16} y={-13} w={{ fill: 32 }} h={32} sprite={StonePanelBlueSprite.TOP} tiling />
      <sprite x={16} y={{ bottom: -12 }} w={{ fill: 32 }} h={32} sprite={StonePanelBlueSprite.BOTTOM} tiling />
      <sprite x={-14} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelBlueSprite.LEFT} tiling />
      <sprite x={{ right: -12 }} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelBlueSprite.RIGHT} tiling />

      <sprite x="left" y="top" w={32} h={32} sprite={StonePanelBlueSprite.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={StonePanelBlueSprite.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={StonePanelBlueSprite.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={StonePanelBlueSprite.BOTTOM_RIGHT} tiling />

      {divider >= 6 && (
        <sprite x="left" y={divider - 20} w="fill" h={32} sprite={StonePanelBlueSprite.DIVIDER} tiling />
      )}
      {divider >= 6 && (
        <sprite x="left" y={divider - 18} w={32} h={32} sprite={StonePanelBlueSprite.DIVIDER_LEFT} tiling />
      )}
      {divider >= 6 && (
        <sprite x="right" y={divider - 18} w={32} h={32} sprite={StonePanelBlueSprite.DIVIDER_RIGHT} tiling />
      )}
    </layer>
  );
}

export function StonePanelRed({ divider = 0 }: { divider?: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={16} y={-13} w={{ fill: 32 }} h={32} sprite={StonePanelRedSprite.TOP} tiling />
      <sprite x={16} y={{ bottom: -12 }} w={{ fill: 32 }} h={32} sprite={StonePanelRedSprite.BOTTOM} tiling />
      <sprite x={-14} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelRedSprite.LEFT} tiling />
      <sprite x={{ right: -12 }} y={16} w={32} h={{ fill: 32 }} sprite={StonePanelRedSprite.RIGHT} tiling />

      <sprite x="left" y="top" w={32} h={32} sprite={StonePanelRedSprite.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={StonePanelRedSprite.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={StonePanelRedSprite.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={StonePanelRedSprite.BOTTOM_RIGHT} tiling />

      {divider >= 6 && <sprite x="left" y={divider - 20} w="fill" h={32} sprite={StonePanelRedSprite.DIVIDER} tiling />}
      {divider >= 6 && (
        <sprite x="left" y={divider - 18} w={32} h={32} sprite={StonePanelRedSprite.DIVIDER_LEFT} tiling />
      )}
      {divider >= 6 && (
        <sprite x="right" y={divider - 18} w={32} h={32} sprite={StonePanelRedSprite.DIVIDER_RIGHT} tiling />
      )}
    </layer>
  );
}

export function SlimJoins(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={Layout.JOIN} h={Layout.JOIN} sprite={SlimJoinSprite.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={Layout.JOIN} h={Layout.JOIN} sprite={SlimJoinSprite.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={Layout.JOIN} h={Layout.JOIN} sprite={SlimJoinSprite.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={Layout.JOIN} h={Layout.JOIN} sprite={SlimJoinSprite.BOTTOM_RIGHT} tiling />
    </layer>
  );
}
