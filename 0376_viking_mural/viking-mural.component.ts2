import { Camera, Coins, Layout, MuralArt, MuralModel } from './viking-mural.constants';

export function VikingMural(): Component {
  return (
    <>
      <model
        x={Layout.RING_OUTER_X}
        y={Layout.RING_OUTER_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.RING_OUTER}
        zoom={Camera.RING_OUTER.ZOOM}
        pitch={Camera.RING_OUTER.PITCH}
        yaw={Camera.RING_OUTER.YAW}
      />

      <model
        x={Layout.JUGLID_X}
        y={Layout.JUGLID_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.JUGLID}
        zoom={Camera.JUGLID.ZOOM}
        pitch={Camera.JUGLID.PITCH}
        yaw={Camera.JUGLID.YAW}
      />

      <model
        x={Layout.RING_A_X}
        y={Layout.RING_A_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.RING}
        zoom={Camera.RING_A.ZOOM}
        pitch={Camera.RING_A.PITCH}
        yaw={Camera.RING_A.YAW}
      />

      <model
        x={Layout.RING_B_X}
        y={Layout.RING_B_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.RING}
        zoom={Camera.RING_B.ZOOM}
        pitch={Camera.RING_B.PITCH}
        yaw={Camera.RING_B.YAW}
      />

      <model
        x={Layout.RING_C_X}
        y={Layout.RING_C_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.RING}
        zoom={Camera.RING_C.ZOOM}
        pitch={Camera.RING_C.PITCH}
        yaw={Camera.RING_C.YAW}
      />

      <model
        x={Layout.SPHERE_FRONT_X}
        y={Layout.SPHERE_FRONT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.SPHERE}
        zoom={Camera.SPHERE_FRONT.ZOOM}
        pitch={Camera.SPHERE_FRONT.PITCH}
        yaw={Camera.SPHERE_FRONT.YAW}
      />

      <layer x={Layout.JUG_LAYER_X} y={Layout.JUG_LAYER_Y} w={Layout.JUG_LAYER_W} h={Layout.JUG_LAYER_H}>
        {Coins.map((coin) => (
          <model
            x={coin.x}
            y={coin.y}
            w={coin.w}
            h={coin.h}
            model={MuralModel.COIN}
            zoom={coin.zoom}
            pitch={coin.pitch}
            yaw={coin.yaw}
          />
        ))}
      </layer>

      <model
        x={Layout.SPHERE_BACK_X}
        y={Layout.SPHERE_BACK_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MuralModel.SPHERE}
        zoom={Camera.SPHERE_BACK.ZOOM}
        pitch={Camera.SPHERE_BACK.PITCH}
        yaw={Camera.SPHERE_BACK.YAW}
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={MuralArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={MuralArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
