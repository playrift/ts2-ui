import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Layout,
  VillageCameras,
  VillageColors,
  VillageCopy,
  VillageFonts,
  VillageModels,
  VillageOverlay,
} from './village-community-score.constants';
import { showFavourPercent } from './village-community-score.helpers';

const villComLayer = createRef('village_community_score_vill_com_layer1');

export function VillageCommunityScore(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, villComLayer, VillageOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer
          ref={villComLayer}
          x={{ right: Layout.PLATE_RIGHT }}
          y={Layout.PLATE_Y}
          w={Layout.PLATE_W}
          h={Layout.PLATE_H}
        >
          <model
            x={{ right: Layout.LEFT_RIGHT }}
            y={Layout.LEFT_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={VillageModels.LEFT}
            zoom={VillageCameras.LEFT_ZOOM}
            pitch={VillageCameras.LEFT_PITCH}
            yaw={VillageCameras.LEFT_YAW}
          />

          <model
            x={{ right: Layout.RIGHT_RIGHT }}
            y={Layout.RIGHT_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={VillageModels.RIGHT}
            zoom={VillageCameras.RIGHT_ZOOM}
            pitch={VillageCameras.RIGHT_PITCH}
            yaw={VillageCameras.RIGHT_YAW}
          />

          <text
            x={{ right: Layout.CAPTION_RIGHT }}
            y={Layout.CAPTION_Y}
            w={Layout.CAPTION_W}
            h={Layout.CAPTION_H}
            text={VillageCopy.CAPTION}
            font={VillageFonts.LABEL}
            align="center"
            valign="middle"
            shadow
            color={VillageColors.LABEL}
          />

          <text
            x={{ right: Layout.VALUE_RIGHT }}
            y={Layout.VALUE_Y}
            w={Layout.VALUE_W}
            h={Layout.VALUE_H}
            text=""
            font={VillageFonts.LABEL}
            shadow
            color={VillageColors.LABEL}
            onTimer={(event) => showFavourPercent(event.component)}
          />
        </layer>
      </layer>
    </layer>
  );
}
