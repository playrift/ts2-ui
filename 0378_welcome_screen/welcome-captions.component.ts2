import { useServerState, useState } from 'ts2';

import { playermember, recurringMembership } from '../lib/game/varcs';
import { textDevice } from '../lib/lib.helpers';
import { Button, Upper, WelcomeColors, WelcomeFonts, WelcomeVarps } from './welcome-screen.constants';
import { inboxText, lastLoginText, membershipPending, membershipText } from './welcome-screen.helpers';

export function LastLogin(): Component {
  const lastLogin: Int = useServerState(WelcomeVarps.LAST_LOGIN);

  return (
    <text
      x="center"
      y={Upper.LOGIN_Y}
      w={Upper.LINE_W}
      h={Upper.LINE_H}
      text={lastLoginText(lastLogin)}
      font={WelcomeFonts.BODY}
      color={WelcomeColors.INK}
      align="center"
    />
  );
}

export function InboxCaption(): Component {
  const unread: Int = useServerState(WelcomeVarps.UNREAD_MESSAGES);

  return (
    <text
      x={{ right: Button.CAPTION_RIGHT }}
      y="center"
      w={{ fill: Button.CAPTION_INSET }}
      h={{ fill: Button.WASH_INSET }}
      text={inboxText(unread)}
      font={WelcomeFonts.BODY}
      color={WelcomeColors.YELLOW}
      shadow
      align="center"
      valign="middle"
      lineHeight={Button.CAPTION_LINE}
    />
  );
}

export function MembershipCaption(): Component {
  const days: Int = useServerState(WelcomeVarps.MEMBERSHIP_DAYS);
  const [member] = useState(playermember);
  const [recurring] = useState(recurringMembership);

  if (membershipPending(days, member)) {
    return (
      <text
        x={{ right: Button.CAPTION_RIGHT }}
        y="center"
        w={{ fill: Button.CAPTION_INSET }}
        h={{ fill: Button.WASH_INSET }}
        text=""
        font={WelcomeFonts.BODY}
        color={WelcomeColors.YELLOW}
        shadow
        align="center"
        valign="middle"
        lineHeight={Button.CAPTION_LINE}
      />
    );
  }

  return (
    <text
      x={{ right: Button.CAPTION_RIGHT }}
      y="center"
      w={{ fill: Button.CAPTION_INSET }}
      h={{ fill: Button.WASH_INSET }}
      text={membershipText(days, member, recurring)}
      font={WelcomeFonts.BODY}
      color={WelcomeColors.YELLOW}
      shadow
      align="center"
      valign="middle"
      lineHeight={Button.CAPTION_LINE}
    />
  );
}

export function PlayCaption(): Component {
  return (
    <text
      x="right"
      y="center"
      w={{ fill: Button.PLAY_CAPTION_INSET }}
      h="fill"
      text={textDevice('CLICK HERE TO PLAY', 'TAP HERE TO PLAY')}
      font={WelcomeFonts.PLAY}
      color={WelcomeColors.WHITE}
      shadow
      align="center"
      valign="middle"
    />
  );
}
