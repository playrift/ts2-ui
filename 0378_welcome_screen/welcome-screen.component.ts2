import { createRef, useInterval } from 'ts2';

import { CrmLoadingIcon } from '../0284_membership_benefits_prompt/crm-loading-icon.component';
import { opsound } from '../lib/lib.helpers';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { InboxCaption, LastLogin, MembershipCaption, PlayCaption } from './welcome-captions.component';
import { WelcomeScenes } from './welcome-scenes.component';
import {
  Advert,
  Band,
  Button,
  Canvas,
  Upper,
  WELCOME_DODGE,
  WelcomeColors,
  WelcomeFonts,
  WelcomeModel,
  WelcomeSprites,
} from './welcome-screen.constants';
import { hideUnlessMobile } from './welcome-screen.helpers';

const timerHost = createRef('0378_welcome_screen_timer_host');

const dodger = createRef('welcome_screen_dodger');

const content = createRef('welcome_screen_content');

const storeWash = createRef('welcome_screen_store_wash');
const inboxWash = createRef('welcome_screen_inbox_wash');
const playWash = createRef('welcome_screen_play_wash');

export function WelcomeScreen(): Component {
  useInterval(() => welcomeInit(dodger, content), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <layer static ref={dodger} x="center" y="center" w="fill" h="fill">
        <layer static ref={content} x="center" y={Canvas.TOP} w={Canvas.W} h={Canvas.H}>
          <layer x={0} y={0} w={0} h={0} options={['Close']} />

          <layer x="center" y="bottom" w="fill" h={Band.H}>
            <model
              x="center"
              y={Band.ICON_Y}
              w={Band.ICON}
              h={Band.ICON}
              model={WelcomeModel.MESSAGE_ICON}
              zoom={692}
              pitch={512}
            />
            <text
              x={{ center: Band.MESSAGE_DX }}
              y={Band.MESSAGE_Y}
              w={Band.MESSAGE_W}
              h={Band.MESSAGE_H}
              font={WelcomeFonts.HEADING}
              color={WelcomeColors.INK}
              align="center"
              valign="middle"
              lineHeight={Band.MESSAGE_LINE}
            />
            <rect
              x={{ center: Band.MESSAGE_DX }}
              y={Band.LINK_Y}
              w={Band.MESSAGE_W}
              h={Band.LINK_H}
              fill
              color={WelcomeColors.WHITE}
              transparency={Band.INVISIBLE}
              hide
              options={['Open Link']}
            />

            <WelcomeScenes />

            <model x={Band.SLOT_X} y={Band.SLOT_Y} w={Band.SLOT} h={Band.SLOT} zoom={Band.SLOT_ZOOM} />
            <model x={{ right: Band.SLOT_X }} y={Band.SLOT_Y} w={Band.SLOT} h={Band.SLOT} zoom={Band.SLOT_ZOOM} />
          </layer>

          <layer x="center" y={0} w="fill" h={Upper.H}>
            <layer x="center" y={Upper.TITLE_Y} w={Upper.TITLE_W} h={Upper.TITLE_H}>
              <sprite
                x="center"
                y={Upper.SCROLL_Y}
                w={Upper.SCROLL_W}
                h={Upper.SCROLL_H}
                sprite={WelcomeSprites.TITLE_SCROLL}
              />
              <text
                x="center"
                y={Upper.HEADING_Y}
                w={Upper.LINE_W}
                h={Upper.LINE_H}
                text="Welcome to Old School RuneScape"
                font={WelcomeFonts.HEADING}
                color={WelcomeColors.INK}
                align="center"
              />
              <LastLogin />
            </layer>

            <layer
              x={{ right: Button.SIDE_X }}
              y={Button.Y}
              w={Button.SIDE_W}
              h={Button.H}
              options={['Open Store']}
              onMouseRepeat={() => hideUnlessMobile(0, storeWash)}
              onMouseLeave={() => hideUnlessMobile(1, storeWash)}
            >
              <sprite x="center" y="center" w={Button.SIDE_W} h={Button.H} sprite={WelcomeSprites.SIDE_BUTTON} />
              <layer
                static
                ref={storeWash}
                x="center"
                y="center"
                w={{ fill: Button.WASH_INSET }}
                h={{ fill: Button.WASH_INSET }}
                hide
              >
                <rect
                  x="center"
                  y="center"
                  w="fill"
                  h="fill"
                  fill
                  color={WelcomeColors.WHITE}
                  transparency={Button.WASH_TRANSPARENCY}
                />
              </layer>
              <sprite
                x={Button.ICON_X}
                y={{ center: Button.STORE_ICON_DY }}
                w={Button.STORE_ICON_W}
                h={Button.STORE_ICON_H}
                sprite={WelcomeSprites.COINS}
              />
              <MembershipCaption />
            </layer>

            <layer
              x={Button.SIDE_X}
              y={Button.Y}
              w={Button.SIDE_W}
              h={Button.H}
              options={['View Inbox']}
              onMouseRepeat={() => hideUnlessMobile(0, inboxWash)}
              onMouseLeave={() => hideUnlessMobile(1, inboxWash)}
            >
              <sprite x="center" y="center" w={Button.SIDE_W} h={Button.H} sprite={WelcomeSprites.SIDE_BUTTON} />
              <layer
                static
                ref={inboxWash}
                x="center"
                y="center"
                w={{ fill: Button.WASH_INSET }}
                h={{ fill: Button.WASH_INSET }}
                hide
              >
                <rect
                  x="center"
                  y="center"
                  w="fill"
                  h="fill"
                  fill
                  color={WelcomeColors.WHITE}
                  transparency={Button.WASH_TRANSPARENCY}
                />
              </layer>
              <sprite
                x={Button.ICON_X}
                y="center"
                w={Button.INBOX_ICON_W}
                h={Button.INBOX_ICON_H}
                sprite={WelcomeSprites.LETTER}
              />
              <InboxCaption />
            </layer>

            <layer
              x="center"
              y={Button.Y}
              w={Button.PLAY_W}
              h={Button.H}
              options={['Play']}
              onMouseRepeat={() => hideUnlessMobile(0, playWash)}
              onMouseLeave={() => hideUnlessMobile(1, playWash)}
              onOptionSelect={(event) => opsound(event.option, 2)}
            >
              <sprite x="center" y="center" w={Button.PLAY_W} h={Button.H} sprite={WelcomeSprites.PLAY_BUTTON} />
              <layer
                static
                ref={playWash}
                x="center"
                y="center"
                w={{ fill: Button.WASH_INSET }}
                h={{ fill: Button.WASH_INSET }}
                hide
              >
                <rect
                  x="center"
                  y="center"
                  w="fill"
                  h="fill"
                  fill
                  color={WelcomeColors.WHITE}
                  transparency={Button.WASH_TRANSPARENCY}
                />
              </layer>
              <sprite
                x={Button.ICON_X}
                y="center"
                w={Button.PLAY_ICON_W}
                h={Button.PLAY_ICON_H}
                sprite={WelcomeSprites.SWORDS}
              />
              <PlayCaption />
            </layer>

            <layer x={Advert.X} y={Advert.Y} w={Advert.W} h={Advert.H}>
              <sprite x="center" y="center" w="fill" h="fill" sprite={WelcomeSprites.ADVERT_BORDER} />
              <sprite x="center" y="center" w={{ fill: Advert.INSET }} h={{ fill: Advert.INSET }} />
              <layer x="center" y="center" w={{ fill: Advert.INSET }} h={{ fill: Advert.INSET }} />
              <rect
                x="center"
                y="center"
                w={{ fill: Advert.INSET }}
                h={{ fill: Advert.INSET }}
                fill
                color={WelcomeColors.WHITE}
                transparency={Button.WASH_TRANSPARENCY}
                hide
              />
              <layer x="center" y="center" w={{ fill: Advert.INSET }} h={{ fill: Advert.INSET }}>
                <rect x="center" y="center" w="fill" h="fill" fill color={WelcomeColors.INK} />
                <layer x="center" y="center" w="fill" h="fill">
                  <CrmLoadingIcon />
                </layer>
              </layer>
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}

export function welcomeInit(dodgerBox: ComponentId, contentBox: ComponentId): void {
  overlayInit(dodgerBox, contentBox, WELCOME_DODGE, Anchor.CENTRE, Anchor.TOP, 0);
}
