import { GoalColors, GoalFonts, GoalModels, GoalSprites, GoalText, Layout } from './werewolf-goal.constants';

export function WerewolfGoal(): Component {
  return (
    <>
      <model
        x={Layout.ARCH_X}
        y={Layout.ARCH_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={GoalModels.ARCH.id}
        zoom={GoalModels.ARCH.zoom}
        pitch={GoalModels.ARCH.pitch}
        yaw={GoalModels.ARCH.yaw}
      />

      <model
        x={Layout.POST_RIGHT_X}
        y={Layout.POST_RIGHT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={GoalModels.POST_RIGHT.id}
        zoom={GoalModels.POST_RIGHT.zoom}
        pitch={GoalModels.POST_RIGHT.pitch}
        yaw={GoalModels.POST_RIGHT.yaw}
      />

      <model
        x={Layout.POST_LEFT_X}
        y={Layout.POST_LEFT_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={GoalModels.POST_LEFT.id}
        zoom={GoalModels.POST_LEFT.zoom}
        pitch={GoalModels.POST_LEFT.pitch}
        yaw={GoalModels.POST_LEFT.yaw}
      />

      <text
        x={Layout.TIME_LABEL_X}
        y={Layout.TIME_LABEL_Y}
        w={Layout.TIME_LABEL_W}
        h={Layout.TIME_LABEL_H}
        text={GoalText.TIME_LABEL}
        font={GoalFonts.CAPTION}
        color={GoalColors.CAPTION}
        align="center"
        shadow
      />

      <text
        x={Layout.TIME_VALUE_X}
        y={Layout.TIME_VALUE_Y}
        w={Layout.TIME_VALUE_W}
        h={Layout.TIME_VALUE_H}
        text={GoalText.TIME_VALUE}
        font={GoalFonts.NUMBER}
        color={GoalColors.NUMBER}
        align="center"
        shadow
      />

      <text
        x={Layout.SCORE_VALUE_X}
        y={Layout.SCORE_VALUE_Y}
        w={Layout.SCORE_VALUE_W}
        h={Layout.SCORE_VALUE_H}
        text={GoalText.SCORE_VALUE}
        font={GoalFonts.NUMBER}
        color={GoalColors.NUMBER}
        align="center"
        shadow
      />

      <text
        x={Layout.SCORE_LABEL_X}
        y={Layout.SCORE_LABEL_Y}
        w={Layout.SCORE_LABEL_W}
        h={Layout.SCORE_LABEL_H}
        text={GoalText.SCORE_LABEL}
        font={GoalFonts.CAPTION}
        color={GoalColors.CAPTION}
        align="center"
        shadow
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={GoalSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={GoalSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
