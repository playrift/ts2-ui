import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, PlaqueArt, PlaqueColors, PlaqueFonts, PlaqueModels } from './cba-plaque.constants';

export function CbaPlaque(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={PlaqueModels.PLAQUE}
        zoom={Layout.MODEL_ZOOM}
        roll={Layout.MODEL_ROLL}
      />

      <text
        x={0}
        y={0}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        font={PlaqueFonts.TITLE}
        color={PlaqueColors.HEADING}
        align="center"
        valign="middle"
        shadow
      />

      <layer x={Layout.BODY_X} y={Layout.BODY_Y} w={Layout.BODY_W} h={Layout.BODY_H}>
        <text
          x={0}
          y={0}
          w={Layout.BODY_W}
          h={Layout.BODY_H}
          font={PlaqueFonts.BODY}
          color={PlaqueColors.HEADING}
          align="center"
          shadow
        />

        <text
          x={0}
          y={0}
          w={Layout.BODY_W}
          h={Layout.BODY_H}
          font={PlaqueFonts.BODY}
          color={PlaqueColors.WINNERS}
          align="center"
        />
      </layer>

      <layer x={Layout.SCROLLBAR_X} y={Layout.SCROLLBAR_Y} w={Layout.SCROLLBAR_W} h={Layout.SCROLLBAR_H} />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PlaqueArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, PlaqueArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, PlaqueArt.CLOSE)}
      />
    </>
  );
}
