            w={13}
            h={12}
            sprite={Sprites.FAVOURITE_ICONS_1}
            options={['Add Favourite']}
            hover={{ transparency: LogWash.ICON }}
          />
          <text
            static
            ref={row136}
            x={1}
            y={1}
            w={147}
            h={0}
            font={Fonts.P12_FULL}
            color={LogColor.ROW}
            shadow
            hide
            options={['Use code', 'Add Favourite']}
          />
          <sprite
            static
            ref={icon137}
            x={1}
            y={1}
            w={13}
            h={12}
            sprite={Sprites.FAVOURITE_ICONS_1}
            options={['Add Favourite']}
            hover={{ transparency: LogWash.ICON }}
          />
          <text
            static
            ref={row138}
            x={1}
            y={1}
            w={147}
            h={0}
            font={Fonts.P12_FULL}
            color={LogColor.ROW}
            shadow
            hide
            options={['Use code', 'Add Favourite']}
          />
          <sprite
            static
            ref={icon139}
            x={1}
            y={1}
            w={13}
            h={12}
            sprite={Sprites.FAVOURITE_ICONS_1}
            options={['Add Favourite']}
            hover={{ transparency: LogWash.ICON }}
          />
          <text
            static
            ref={row140}
            x={1}
            y={1}
            w={147}
            h={0}
            font={Fonts.P12_FULL}
            color={LogColor.CODE}
            shadow
            hide
            options={['Use code']}
            hover={{ color: LogColor.CODE_HOVER }}
          />
          <FairyLog />
        </layer>
        <layer x={168} y={40} w={16} h={215}>
          <FairyScrollbar />
        </layer>
      </layer>
      <layer w={190} h={261}>
        <layer w={190} h={40} onLoad={() => fairyLogOpen()}>
          <SortButton />
          <text
            y={-1}
            w={190}
            h={40}
            font={Fonts.Q8_FULL}
            color={LogColor.ROW}
            align="center"
            valign="middle"
            shadow
            text="Travel log"
          />
          <sprite
            x={6}
            y="center"
            w={29}
            h={22}
            sprite={Sprites.BANKBUTTONS_2}
            options={['Search']}
            onOptionSelect={(event) => fairyLogSearch(event.option, 1, 1)}
            hover={{ transparency: LogWash.SEARCH }}
          />
          <SteelFrameEntrypoint />
        </layer>
        <SteelFrameEntrypoint />
      </layer>
    </>
  );
}

function SortButton(): Component {
  const [lit, setLit] = useState(0);
  return (
    <layer
      x={164}
      y={10}
      w={20}
      h={20}
      onMouseEnter={() => setLit(1)}
      onMouseLeave={() => setLit(0)}
      onClick={() => fairyLogSortClick()}
    >
      <sprite x={6} y={4} w={7} h={5} sprite={Sprites.SORTARROWS_0} transparency={lit === 1 ? 0 : LogWash.ARROWS} />
      <sprite x={6} y={10} w={7} h={5} sprite={Sprites.SORTARROWS_1} transparency={lit === 1 ? 0 : LogWash.ARROWS} />
    </layer>
  );
}

function FairyScrollbar(): Component {
  const [extent] = useState(fairyringsExtent);
  const [paneHeight] = useState(fairyringsPaneHeight);
  return <LogScrollbar extent={extent} paneHeight={paneHeight} />;
}

function FairyLog(): Component {
  const [filter] = useState(fairyringsApplied);
  const [sort] = useState(fairyringsSort);
  const [revision] = useState(fairyringsRevision);
  const [timer] = useState(fairyringsSearchTimer);
  const [, setExtent] = useState(fairyringsExtent);
  const [, setPaneHeight] = useState(fairyringsPaneHeight);

  useInterval(timer === 1 ? () => fairyLogSearchTick() : undefined);

  let width: Int = widthOf(paneRef) - 20;
  if (width <= 0) {
    width = 143;
  }
  let y: Int = revision * 0;

  const faveText = intArray<ComponentId>(10, [
    fave141,
    fave142,
    fave143,
    fave144,
    fave145,
    fave146,
    fave147,
    fave148,
    fave149,
    fave150,
  ]);
  const faveCode = intArray<ComponentId>(10, [
    faveCode151,
    faveCode152,
    faveCode153,
    faveCode154,
    faveCode155,
    faveCode156,
    faveCode157,
    faveCode158,
    faveCode159,
    faveCode160,
  ]);
  const faveIcon = intArray<ComponentId>(10, [
    faveIcon161,
    faveIcon162,
    faveIcon163,
    faveIcon164,
    faveIcon165,
    faveIcon167,
    faveIcon168,
    faveIcon169,
    faveIcon170,
    faveIcon171,
  ]);
  let anyFave: Boolean = false;
  let k: Int = 0;
  while (k < 10) {
    const text: String = textOf(faveText[k]);
    if (CS2.string_length(text) > 0 && ringMatches(text, filter)) {
      const h: Int = ringRowHeight(text, width);
      placeComponent(faveText[k], 20, y, width, h);
      placeComponent(faveCode[k], 20, y, width, h);
      placeComponent(faveIcon[k], 2, y, 13, 12);
      y = y + h + 3;
      anyFave = true;
    } else {
      hideComponent(faveText[k], true);
      hideComponent(faveIcon[k], true);
      hideComponent(faveCode[k], true);
    }
    k = k + 1;
  }
  if (anyFave) {
    y = y + 3;
  }
  dividerRef.hide = !anyFave;
  favesRef.props = { w: 'fill', h: y };

  const rows = intArray<ComponentId>(64, [
    row12,
    row18,
    row16,
    row14,
    row36,
    row42,
    row40,
    row38,
    row28,
    row34,
    row32,
    row30,
    row20,
    row26,
    row24,
    row22,
    row108,
    row114,
    row112,
    row110,
    row132,
    row138,
    row136,
    row134,
    row124,
    row130,
    row128,
    row126,
    row116,
    row122,
    row120,
    row118,
    row76,
    row82,
    row80,
    row78,
    row100,
    row106,
    row104,
    row102,
    row92,
    row98,
    row96,
    row94,
    row84,
    row90,
    row88,
    row86,
    row44,
    row50,
    row48,
    row46,
    row68,
    row74,
    row72,
    row70,
    row60,
    row66,
    row64,
    row62,
    row52,
    row58,
    row56,
    row54,
  ]);
  const icons = intArray<ComponentId>(64, [
    icon13,
    icon19,
    icon17,
    icon15,
    icon37,
    icon43,
    icon41,
    icon39,
    icon29,
    icon35,
    icon33,
    icon31,
    icon21,
    icon27,
    icon25,
    icon23,
    icon109,
    icon115,
    icon113,
    icon111,
    icon133,
    icon139,
    icon137,
    icon135,
    icon125,
    icon131,
    icon129,
    icon127,
    icon117,
    icon123,
    icon121,
    icon119,
    icon77,
    icon83,
    icon81,
    icon79,
    icon101,
    icon107,
    icon105,
    icon103,
    icon93,
    icon99,
    icon97,
    icon95,
    icon85,
    icon91,
    icon89,
    icon87,
    icon45,
    icon51,
    icon49,
    icon47,
    icon69,
    icon75,
    icon73,
    icon71,
    icon61,
    icon67,
    icon65,
    icon63,
    icon53,
    icon59,
    icon57,
    icon55,
  ]);
  const order = intArray(64);
  const labelY = intArray(64);
  const labelH = intArray(64);
  let count: Int = 0;
  let i: Int = 0;
  while (i < RING_COUNT) {
    labelY[i] = -1;
    const text: String = textOf(rows[i]);
    if (CS2.string_length(text) > 0 && ringMatches(text, filter)) {
      hideComponent(rows[i], false);
      hideComponent(icons[i], false);
      let j: Int = count;
      while (j > 0 && ringKeyCompare(sort, textOf(rows[order[j - 1]]), order[j - 1], text, i) > 0) {
        order[j] = order[j - 1];
        j = j - 1;
      }
      order[j] = i;
      count = count + 1;
    } else {
      hideComponent(rows[i], true);
      hideComponent(icons[i], true);
    }
    i = i + 1;
  }
  let r: Int = 0;
  while (r < count) {
    const at: Int = order[r];
    const h: Int = ringRowHeight(textOf(rows[at]), width);
    placeComponent(icons[at], 2, y, 13, 12);
    placeComponent(rows[at], 20, y, width, h);
    labelY[at] = y;
    labelH[at] = h;
    y = y + h + 3;
    r = r + 1;
  }

  const last: String = textOf(row140);
  if (CS2.string_length(last) > 0 && ringMatches(last, filter)) {
    const h: Int = ringRowHeight(last, width);
    placeComponent(row140, 20, y, width, h);
    y = y + h + 3;
  } else {
    row140.hide = true;
  }
  if (y > 0) {
    y = y - 3;
  }

  const paneH: Int = heightOf(paneRef);
  if (y > paneH) {
    paneRef.scrollHeight = y;
    if (paneRef.scrollY > y - paneH) {
      paneRef.scrollY = y - paneH;
    }
  } else {
    paneRef.scrollHeight = 0;
    paneRef.scrollY = 0;
  }
  setExtent(y > paneH ? y : 0);
  setPaneHeight(paneH);
  const empty: Boolean = y <= 0;
  const labelsH: Int = y > paneH ? y : paneH;

  return (
    <layer w="fill" h={labelsH}>
      {labelY.map(
        (top, index) =>
          top >= 0 && (
            <text
              x={20}
              y={top}
              w={width}
              h={labelH[index]}
              font={Fonts.P12_FULL}
              color={LogColor.CODE}
              shadow
              text={ringCode(index)}
              hover={{ color: LogColor.CODE_HOVER }}
            />
          ),
      )}
      {empty && (
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          font={Fonts.P12_FULL}
          color={LogColor.ROW}
          align="center"
          valign="middle"
          shadow
          text="There are no fairy rings which go to that destination which you have access to."
        />
      )}
    </layer>
  );
}
