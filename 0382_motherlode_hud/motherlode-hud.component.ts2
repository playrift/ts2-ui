import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinStoneBox } from '../lib/thin-stone-box.component';
import {
  Layout,
  MotherlodeColor,
  MotherlodeFonts,
  MotherlodeHud,
  MotherlodeSprites,
  SACK_MODEL,
} from './motherlode-hud.constants';
import { motherlodeHudUpdate } from './motherlode-hud.helpers';

const timerHost1 = createRef('0382_motherlode_hud_timer_host1');

const timerHost2 = createRef('0382_motherlode_hud_timer_host2');

const data = createRef('motherlode_hud_data');

const payDirt = createRef('motherlode_hud_pay_dirt');

const deposits = createRef('motherlode_hud_deposits');

export function MotherlodeHud_(): Component {
  useInterval(() => motherlodeHudUpdate(payDirt, deposits), timerHost1);
  useInterval(() => overlayRelayout(timerHost2, data, MotherlodeHud.DODGE, Anchor.LEFT, Anchor.TOP, 1), timerHost2);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={data} x={Layout.PLATE_X} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite
            x="center"
            y={{ center: Layout.BACKING_Y }}
            w="fill"
            h="fill"
            sprite={MotherlodeSprites.BACKING}
            tiling
            transparency={Layout.BACKING_WASH}
          />

          <model
            x="center"
            y={{ bottom: Layout.SACK_Y }}
            w={Layout.SACK_W}
            h={Layout.SACK_H}
            model={SACK_MODEL}
            zoom={Layout.SACK_ZOOM}
            pitch={Layout.SACK_PITCH}
            offsetX={Layout.SACK_OFFSET_X}
            offsetY={Layout.SACK_OFFSET_Y}
          />

          <text
            ref={payDirt}
            x="center"
            y={{ center: Layout.COUNT_Y }}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            text="0"
            align="center"
            valign="middle"
            shadow
            font={MotherlodeFonts.COUNT}
            color={MotherlodeColor.WHITE}
          />

          <text
            ref={deposits}
            x="center"
            y={{ center: Layout.SPACE_Y }}
            w="fill"
            h={Layout.SPACE_H}
            text="Deposits left: 0"
            align="center"
            valign="middle"
            shadow
            font={MotherlodeFonts.BODY}
            color={MotherlodeColor.WHITE}
          />

          <ThinStoneBox />
        </layer>
      </layer>
    </layer>
  );
}
