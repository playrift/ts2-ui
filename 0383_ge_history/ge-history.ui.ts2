import { createRef } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ExchangeButton } from './exchange-button.component';
import { History } from './ge-history.constants';

const geHistory = createRef('ge_history');

export function GeHistory(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Grand Exchange Trade History" />

      <ExchangeButton x={History.BUTTON_X} y={History.BUTTON_Y} w={History.BUTTON_W} h={History.BUTTON_H} />

      <layer x={History.LIST_X} y={History.LIST_Y} w={{ fill: History.LIST_INSET_W }} h={History.LIST_H} />

      <layer x={{ right: History.BAR_RIGHT }} y={History.LIST_Y} w={History.BAR_W} h={History.LIST_H} />
    </>
  );
}

export const geHistoryUi = (): UI => (
  <ui ref={geHistory} w={History.ROOT_W} h={History.ROOT_H} x="center" y={History.ROOT_Y}>
    <GeHistory />
  </ui>
);
