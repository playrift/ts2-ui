import {
  Layout,
  MessageRows,
  ScrollColors,
  ScrollFonts,
  ScrollModel,
  ScrollSprites,
} from './wise-old-man-scroll.constants';

export function WiseOldManScroll(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={ScrollModel.PARCHMENT}
        zoom={ScrollModel.ZOOM}
        pitch={ScrollModel.PITCH}
      />

      {MessageRows.map((row) => (
        <text
          x={Layout.ROW_X}
          y={row.y}
          w={Layout.ROW_W}
          h={Layout.ROW_H}
          text={row.label}
          font={ScrollFonts.BODY}
          color={ScrollColors.INK}
        />
      ))}

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ScrollSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ScrollSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
