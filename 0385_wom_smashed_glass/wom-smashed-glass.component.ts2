import { createRef, useInterval } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { GlassCamera, GlassModel } from './wom-smashed-glass.constants';

const timerHost = createRef('0385_wom_smashed_glass_timer_host');

const smashedGlass = createRef('wom_smashed_glass_glass');

export function WomSmashedGlass(): Component {
  useInterval(
    () =>
      modelTransparentDynamicZoom(
        timerHost,
        smashedGlass,
        GlassCamera.NEAR,
        GlassCamera.FAR,
        GlassCamera.OFFSET_X,
        GlassCamera.OFFSET_Y,
        GlassCamera.PITCH,
        GlassCamera.YAW,
        GlassCamera.ROLL,
      ),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <model
        ref={smashedGlass}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={GlassModel.GLASS}
        zoom={GlassCamera.NEAR}
        pitch={GlassCamera.PITCH}
        yaw={GlassCamera.YAW}
      />
    </layer>
  );
}
