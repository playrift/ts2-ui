import { CS2 } from 'ts2';

import { TelescopeZoom } from './wom-telescope.constants';

export const telescopeSide = (height: Int): Int => {
  let clamped: Int = height;
  if (clamped < TelescopeZoom.MIN_HEIGHT) {
    clamped = TelescopeZoom.MIN_HEIGHT;
  } else if (clamped > TelescopeZoom.MAX_HEIGHT) {
    clamped = TelescopeZoom.MAX_HEIGHT;
  }
  return clamped;
};

export const telescopeZoom = (side: Int): Int => {
  const excess: Int = CS2.invpow(side - TelescopeZoom.MIN_HEIGHT, TelescopeZoom.ROOT);
  const full: Int = CS2.invpow(TelescopeZoom.MAX_HEIGHT - TelescopeZoom.MIN_HEIGHT, TelescopeZoom.ROOT);
  return TelescopeZoom.NEAR - CS2.interpolate(0, excess, 0, full, TelescopeZoom.SPAN);
};
