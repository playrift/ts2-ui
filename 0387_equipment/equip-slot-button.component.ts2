import { useInventory } from 'ts2';
import { Inventories, SlotColors, SlotIcons, SlotSprites } from './equipment.constants';
import { itemName } from '../lib/lib.engine';

export function EquipSlotButton({ x, y, slot }: { x: Int; y: Int; slot: Int }): Component {
  const worn = useInventory(Inventories.WORN);

  return (
    <layer x={x} y={y} w={36} h={36}>
      <sprite x="center" y="center" w={36} h={36} sprite={SlotSprites.PLATE} />

      {worn[slot] !== -1 ? (
        <sprite
          x={2}
          y={2}
          w={36}
          h={32}
          item={worn[slot]}
          itemCount={worn.count(slot)}
          outline={1}
          shadowColor={SlotColors.ITEM_SHADOW}
          optionSubject={itemName(worn[slot])}
          options={['Remove', '', '', '', '', '', '', '', '', 'Examine']}
          spellTarget
        />
      ) : (
        <sprite x="center" y="center" w={32} h={32} sprite={SlotIcons.get(slot) ?? -1} />
      )}
    </layer>
  );
}
