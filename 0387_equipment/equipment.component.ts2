import { EquipSlotButton } from './equip-slot-button.component';
import { ActionIcons, EquipSlot, SlotBackgroundSprites } from './equipment.constants';
import { StoneHoverButton } from './stone-hover-button.component';
import { membersWorld } from '../lib/lib.engine';

export function Equipment(): Component {
  return (
    <>
      <layer w="fill" h="fill">
        <layer x={7} y={208} w={40} h={40}>
          <StoneHoverButton op="View equipment stats" />
        </layer>
        <layer x={52} y={208} w={40} h={40}>
          <StoneHoverButton op="View guide prices" />
        </layer>
        <layer x={97} y={208} w={40} h={40}>
          <StoneHoverButton op="View items kept on death" />
        </layer>
        <layer x={142} y={208} w={40} h={40}>
          <StoneHoverButton op="Call follower" />
        </layer>

        <sprite x={77} y={39} w={36} h={124} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={21} y={118} w={36} h={45} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={133} y={118} w={36} h={45} sprite={SlotBackgroundSprites.NARROW} tiling />
        <sprite x={56} y={81} w={78} h={36} sprite={SlotBackgroundSprites.WIDE} tiling />
        <sprite x={71} y={42} w={48} h={36} sprite={SlotBackgroundSprites.WIDE} tiling />

        <EquipSlotButton x={77} y={4} slot={EquipSlot.HEAD} />
        <EquipSlotButton x={36} y={43} slot={EquipSlot.CAPE} />
        <EquipSlotButton x={77} y={43} slot={EquipSlot.AMULET} />
        <EquipSlotButton x={21} y={82} slot={EquipSlot.WEAPON} />
        <EquipSlotButton x={77} y={82} slot={EquipSlot.BODY} />
        <EquipSlotButton x={133} y={82} slot={EquipSlot.SHIELD} />
        <EquipSlotButton x={77} y={122} slot={EquipSlot.LEGS} />
        <EquipSlotButton x={21} y={162} slot={EquipSlot.HANDS} />
        <EquipSlotButton x={77} y={162} slot={EquipSlot.FEET} />
        <EquipSlotButton x={133} y={162} slot={EquipSlot.RING} />
        <EquipSlotButton x={118} y={43} slot={EquipSlot.AMMO} />

        {membersWorld() && (
          <layer x={118} y={4} w={36} h={36}>
            <layer w="fill" h="fill" />
            <layer w="fill" h="fill" />
          </layer>
        )}

        <layer x={18} y={4} w={36} h={36} />

        <layer x={118} y={4} w={36} h={36} />
        <sprite x={118} y={19} w={36} h={45} sprite={SlotBackgroundSprites.NARROW} tiling hide />
      </layer>

      <sprite x={10} y={210} w={32} h={32} sprite={ActionIcons.EQUIPMENT_STATS} />
      <sprite x={56} y={212} w={32} h={32} sprite={ActionIcons.GUIDE_PRICES} />
      <sprite x={99} y={211} w={34} h={34} sprite={ActionIcons.ITEMS_KEPT_ON_DEATH} />
      <sprite x={145} y={211} w={32} h={32} sprite={ActionIcons.CALL_FOLLOWER} />
    </>
  );
}
