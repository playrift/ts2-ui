import { useRef } from 'ts2';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { StoneButton } from '../lib/stone-button.component';

export function StoneHoverButton({ op }: { op: String }): Component {
  const base = useRef();
  const pressed = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      options={[op]}
      onMouseEnter={() => {
        base.hide = true;
        pressed.hide = false;
      }}
      onMouseLeave={() => {
        base.hide = false;
        pressed.hide = true;
      }}
    >
      <layer ref={base} w="fill" h="fill">
        <StoneButton />
      </layer>
      <layer ref={pressed} w="fill" h="fill" hide>
        <StoneButtonPressed />
      </layer>
    </layer>
  );
}
