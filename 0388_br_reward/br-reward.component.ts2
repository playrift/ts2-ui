import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { BrRewardArt, Layout, PlateFade } from './br-reward.constants';
import { setTransparency } from '../lib/lib.components';

export function BrReward(): Component {
  return (
    <>
      <StoneBorderEntrypoint title="Reward Chest" />

      <layer y="bottom" w="fill" h={{ fill: Layout.CONTENT_INSET }}>
        <layer x={{ center: Layout.BUTTONS_DX }} y="bottom" w={Layout.BUTTONS_W} h={Layout.BUTTONS_H}>
          <layer x="center" y="center" w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['Bank']}>
            <sprite
              w={Layout.BUTTON_W}
              h={Layout.BUTTON_H}
              sprite={BrRewardArt.BUTTON_PLATE}
              onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
            />
            <sprite x="center" y="center" w={Layout.ICON_W} h={Layout.ICON_H} sprite={BrRewardArt.BANK_ICON} />
          </layer>
        </layer>

        <layer x="center" y={Layout.REWARD_SLOT_Y} w={Layout.REWARD_SLOT_W} h={Layout.REWARD_SLOT_H} />
      </layer>
    </>
  );
}
