import { Layout, RunepouchAlpha, RunepouchArt, RunepouchInk } from './pvp-arena-runepouch.constants';
import { SteelFrame } from './steel-frame.component';

export function PvpArenaRunepouch(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={RunepouchInk.DIMMER}
        fill
        transparency={RunepouchAlpha.DIMMER}
      />

      <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
        <SteelFrame backdrop />

        <layer x="center" y="center" w={{ fill: Layout.CONTENT_INSET }} h={{ fill: Layout.CONTENT_INSET }}>
          <layer x={0} y={0} w={{ fill: Layout.RUNES_W_INSET }} h={{ fill: Layout.RUNES_H_INSET }}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={RunepouchArt.BACKING}
              tiling
              transparency={RunepouchAlpha.BACKING}
            />
          </layer>

          <layer x="right" y="center" w={Layout.PANE_W} h="fill" />

          <layer x="right" y="center" w={Layout.PANE_W} h="fill" />

          <layer x={Layout.SUBMIT_X} y="bottom" w={Layout.SUBMIT_W} h={Layout.SUBMIT_H} />
        </layer>
      </layer>
    </layer>
  );
}
