import { HangmanArt, HangmanColor, HangmanFonts, HangmanText, KEY_HEIGHT, Keys, Layout } from './poh-hangman.constants';

export function PohHangman(): Component {
  return (
    <>
      {Keys.map((key) => (
        <text
          x={key.x}
          y={key.y}
          w={key.w}
          h={KEY_HEIGHT}
          text={key.text}
          font={HangmanFonts.KEY}
          color={HangmanColor.LETTER}
          shadow
        />
      ))}

      <sprite
        x={Layout.PLATE_X}
        y={Layout.PLATE_Y}
        w={Layout.PLATE_W}
        h={Layout.PLATE_H}
        sprite={HangmanArt.GUESS_PLATE}
      />

      <text
        x={Layout.GUESS_X}
        y={Layout.GUESS_Y}
        w={Layout.GUESS_W}
        h={Layout.GUESS_H}
        text={HangmanText.GUESS}
        font={HangmanFonts.BODY}
        color={HangmanColor.GUESS}
        align="center"
        shadow
      />

      <text
        x={Layout.GUESSBOX_X}
        y={Layout.GUESSBOX_Y}
        w={Layout.GUESSBOX_W}
        h={Layout.GUESSBOX_H}
        text={HangmanText.GUESSBOX}
        font={HangmanFonts.KEY}
        color={HangmanColor.GUESSBOX}
        shadow
      />

      <text
        x={Layout.WORDBOX_X}
        y={Layout.WORDBOX_Y}
        w={Layout.WORDBOX_W}
        h={Layout.WORDBOX_H}
        text={HangmanText.WORDBOX}
        font={HangmanFonts.WORD}
        color={HangmanColor.WORD}
        shadow
      />

      <layer
        x={Layout.INSTRUCTIONS_LAYER_X}
        y={Layout.INSTRUCTIONS_LAYER_Y}
        w={Layout.INSTRUCTIONS_LAYER_W}
        h={Layout.INSTRUCTIONS_LAYER_H}
      >
        <text
          x={Layout.INSTRUCTIONS_X}
          y={Layout.INSTRUCTIONS_Y}
          w={Layout.INSTRUCTIONS_W}
          h={Layout.INSTRUCTIONS_H}
          text={HangmanText.INSTRUCTIONS}
          font={HangmanFonts.BODY}
          color={HangmanColor.WORD}
        />
      </layer>
    </>
  );
}
