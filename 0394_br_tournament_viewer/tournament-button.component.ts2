import { useInterval, useRef, useState } from 'ts2';

import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { clientClock, playSound } from '../lib/lib.engine';
import { BUTTON_COOLDOWN, ViewerColor, ViewerFonts, ViewerSounds } from './br-tournament-viewer.constants';

export function TournamentButton({ label }: { label: String }): Component {
  const timerHost = useRef();

  useInterval(() => {
    if (clientClock() >= pressedUntil) {
      setPressedUntil(0);
    }
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);

  const caption = useRef();

  if (pressedUntil !== 0) {
    return (
      <layer w="fill" h="fill" ref={timerHost}>
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={ViewerFonts.BODY}
          color={ViewerColor.PRESSED}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseEnter={() => {
        caption.color = ViewerColor.VALUE;
      }}
      onMouseLeave={() => {
        caption.color = ViewerColor.LABEL;
      }}
      onOptionSelect={() => {
        playSound(ViewerSounds.CLICK);
        setPressedUntil(clientClock() + BUTTON_COOLDOWN);
      }}
    >
      <ButtonBackground />
      <text
        ref={caption}
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={ViewerFonts.BODY}
        color={ViewerColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
