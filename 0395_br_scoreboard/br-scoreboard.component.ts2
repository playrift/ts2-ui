import { closeInterface, graphicSwapper } from '../lib/lib.helpers';

import { ScoreboardArt, ScoreboardColor, ScoreboardFonts, ScoreboardLayout } from './br-scoreboard.constants';

export function BrScoreboard(): Component {
  return (
    <layer w="fill" h="fill">
      <text
        x="center"
        y={0}
        w="fill"
        h={ScoreboardLayout.TITLE_H}
        font={ScoreboardFonts.TITLE}
        color={ScoreboardColor.TEXT}
        align="center"
        text="Last Man Standing"
      />

      <text
        x="center"
        y={ScoreboardLayout.WINS_Y}
        w={ScoreboardLayout.ROW_W}
        h={ScoreboardLayout.ROW_H}
        font={ScoreboardFonts.ROW}
        color={ScoreboardColor.TEXT}
        align="center"
      />

      <text
        x="center"
        y={ScoreboardLayout.KILLS_Y}
        w={ScoreboardLayout.ROW_W}
        h={ScoreboardLayout.ROW_H}
        font={ScoreboardFonts.ROW}
        color={ScoreboardColor.TEXT}
        align="center"
      />

      <text
        x="center"
        y={ScoreboardLayout.GAMES_Y}
        w={ScoreboardLayout.ROW_W}
        h={ScoreboardLayout.ROW_H}
        font={ScoreboardFonts.ROW}
        color={ScoreboardColor.TEXT}
        align="center"
      />

      <sprite
        x={{ right: ScoreboardLayout.CLOSE_RIGHT }}
        y={ScoreboardLayout.CLOSE_TOP}
        w={ScoreboardLayout.CLOSE_W}
        h={ScoreboardLayout.CLOSE_H}
        sprite={ScoreboardArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, ScoreboardArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, ScoreboardArt.CLOSE);
        }}
      />
    </layer>
  );
}
