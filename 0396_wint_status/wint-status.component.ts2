import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, WintColor, WintDodge, WintFonts, WintModel, WintSprites } from './wint-status.constants';
import { wintTimerCountdown } from './wint-status.helpers';

const timerHost1 = createRef('0396_wint_status_timer_host1');

const timerHost2 = createRef('0396_wint_status_timer_host2');

const status = createRef('wint_status_status');

export function WintStatus(): Component {
  useInterval(() => overlayRelayout(timerHost1, status, WintDodge.STATUS, Anchor.LEFT, Anchor.TOP, 1), timerHost1);
  useInterval(() => wintTimerCountdown(timerHost2), timerHost2);

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={status} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer x={0} y="bottom" w={Layout.ROSE_BOX} h={Layout.ROSE_BOX}>
            <sprite x="center" y="center" w={Layout.ROSE_DISC} h={Layout.ROSE_DISC} sprite={WintSprites.ROSE} />

            <model
              x="center"
              y={Layout.ARROW_Y}
              w={Layout.ARROW_BOX}
              h={Layout.ARROW_BOX}
              model={WintModel.NORTH_ARROW}
              zoom={Layout.ARROW_ZOOM}
              pitch={Layout.ARROW_PITCH}
              yaw={Layout.ARROW_YAW}
              offsetY={Layout.ARROW_OFFSET_Y}
            />

            <text
              x={Layout.POINTS_X}
              y={Layout.POINTS_Y}
              w={Layout.POINTS_W}
              h={Layout.POINTS_H}
              font={WintFonts.BODY}
              text="Points<br>0000"
              align="center"
              valign="middle"
              shadow
              color={WintColor.POINTS}
            />

            <sprite x={0} y="bottom" w={Layout.MARKER} h={Layout.MARKER} sprite={WintSprites.PYROMANCER} />
            <sprite x={0} y={0} w={Layout.MARKER} h={Layout.MARKER} sprite={WintSprites.PYROMANCER} />
            <sprite x="right" y={0} w={Layout.MARKER} h={Layout.MARKER} sprite={WintSprites.PYROMANCER} />
            <sprite x="right" y="bottom" w={Layout.MARKER} h={Layout.MARKER} sprite={WintSprites.PYROMANCER} />

            <sprite
              x={Layout.BRAZIER_INSET}
              y={{ bottom: Layout.BRAZIER_INSET }}
              w={Layout.MARKER}
              h={Layout.MARKER}
              sprite={WintSprites.BRAZIER}
            />
            <sprite
              x={Layout.BRAZIER_INSET}
              y={Layout.BRAZIER_INSET}
              w={Layout.MARKER}
              h={Layout.MARKER}
              sprite={WintSprites.BRAZIER}
            />
            <sprite
              x={{ right: Layout.BRAZIER_INSET }}
              y={Layout.BRAZIER_INSET}
              w={Layout.MARKER}
              h={Layout.MARKER}
              sprite={WintSprites.BRAZIER}
            />
            <sprite
              x={{ right: Layout.BRAZIER_INSET }}
              y={{ bottom: Layout.BRAZIER_INSET }}
              w={Layout.MARKER}
              h={Layout.MARKER}
              sprite={WintSprites.BRAZIER}
            />
          </layer>

          <layer x={0} y={0} w="fill" h={Layout.BAND_H}>
            <layer x={0} y={0} w={Layout.BAND_W} h={Layout.BAND_H}>
              <rect x="center" y="center" w="fill" h="fill" color={WintColor.WARMTH_BACK} fill />
              <rect x={0} y={0} w={{ fill: Layout.WARMTH_FILL_INSET }} h="fill" color={WintColor.WARMTH_FILL} fill />
              <rect x="center" y="center" w="fill" h="fill" color={WintColor.BLACK} />
            </layer>

            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              font={WintFonts.BODY}
              text="Your Warmth"
              align="center"
              valign="middle"
              color={WintColor.BLACK}
            />
          </layer>

          <layer x={0} y={Layout.ENERGY_BAND_Y} w={Layout.BAND_W} h={Layout.BAND_H}>
            <layer x="center" y="bottom" w="fill" h={Layout.BAND_H}>
              <rect x="center" y="center" w="fill" h="fill" color={WintColor.ENERGY_BACK} fill />
              <rect x={0} y={0} w="fill" h="fill" color={WintColor.ENERGY_FILL} fill />
              <rect x={0} y={0} w="fill" h="fill" color={WintColor.BLACK} />
            </layer>

            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              font={WintFonts.BODY}
              text="Wintertodt's Energy"
              align="center"
              valign="middle"
              color={WintColor.BLACK}
              ref={timerHost2}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
