import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  FairyRingArt,
  FairyRingColor,
  FairyRingFonts,
  FairyRingModel,
  FairyRingText,
  FairyRingVarbits,
  Layout,
  Ring,
  RingOneLetters,
  RingThreeLetters,
  RingTwoLetters,
  Transparency,
  Turn,
} from './fairyrings.constants';
import { useInterval, useWatch } from 'ts2';

import {
  dialOne,
  dialThree,
  dialTwo,
  ringOneA,
  ringOneB,
  ringOneC,
  ringOneD,
  ringThreeP,
  ringThreeQ,
  ringThreeR,
  ringThreeS,
  ringTwoI,
  ringTwoJ,
  ringTwoK,
  ringTwoL,
  rotateOneAcw,
  rotateOneCw,
  rotateThreeAcw,
  rotateThreeCw,
  rotateTwoAcw,
  rotateTwoCw,
} from './fairyrings.refs';
import { confirmFairyRing, stepFairyRingRotation, swapPlateColour, turnFairyRing } from './fairyrings.scripts';

export function FairyRings(): Component {
  useWatch(
    FairyRingVarbits.RING_1,
    (event) => stepFairyRingRotation(Ring.ONE, event.component, ringOneA, ringOneB, ringOneC, ringOneD),
    dialOne,
  );
  useWatch(
    FairyRingVarbits.RING_2,
    (event) => stepFairyRingRotation(Ring.TWO, event.component, ringTwoI, ringTwoJ, ringTwoK, ringTwoL),
    dialTwo,
  );
  useWatch(
    FairyRingVarbits.RING_3,
    (event) => stepFairyRingRotation(Ring.THREE, event.component, ringThreeP, ringThreeQ, ringThreeR, ringThreeS),
    dialThree,
  );

  useInterval(() => stepFairyRingRotation(Ring.ONE, dialOne, ringOneA, ringOneB, ringOneC, ringOneD), dialOne);
  useInterval(() => stepFairyRingRotation(Ring.TWO, dialTwo, ringTwoI, ringTwoJ, ringTwoK, ringTwoL), dialTwo);
  useInterval(
    () => stepFairyRingRotation(Ring.THREE, dialThree, ringThreeP, ringThreeQ, ringThreeR, ringThreeS),
    dialThree,
  );

  return (
    <>
      <rect
        w={Layout.BACKDROP_W}
        h={Layout.BACKDROP_H}
        fill
        color={FairyRingColor.BACKDROP}
        transparency={Transparency.BACKDROP}
      />

      <model
        x={Layout.TOP_RING_X}
        y={Layout.TOP_RING_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.RING}
        pitch={Camera.RING_PITCH}
        zoom={Camera.TOP_RING_ZOOM}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={FairyRingText.TITLE}
        font={FairyRingFonts.PLATE}
        color={FairyRingColor.TEXT}
        align="center"
        valign="middle"
      />

      <model
        ref={dialOne}
        x={Layout.DIAL_1_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.DIAL}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        ref={dialTwo}
        x={Layout.DIAL_2_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.DIAL}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        ref={dialThree}
        x={Layout.DIAL_3_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.DIAL}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        ref={ringOneA}
        x={Layout.DIAL_1_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingOneLetters.A}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringOneB}
        x={Layout.DIAL_1_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingOneLetters.B}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringOneC}
        x={Layout.DIAL_1_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingOneLetters.C}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringOneD}
        x={Layout.DIAL_1_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingOneLetters.D}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        ref={ringTwoI}
        x={Layout.DIAL_2_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingTwoLetters.I}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringTwoJ}
        x={Layout.DIAL_2_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingTwoLetters.J}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringTwoK}
        x={Layout.DIAL_2_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingTwoLetters.K}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringTwoL}
        x={Layout.DIAL_2_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingTwoLetters.L}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        ref={ringThreeP}
        x={Layout.DIAL_3_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingThreeLetters.P}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringThreeQ}
        x={Layout.DIAL_3_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingThreeLetters.Q}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringThreeR}
        x={Layout.DIAL_3_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingThreeLetters.R}
        zoom={Camera.DIAL_ZOOM}
      />
      <model
        ref={ringThreeS}
        x={Layout.DIAL_3_X}
        y={Layout.DIAL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RingThreeLetters.S}
        zoom={Camera.DIAL_ZOOM}
      />

      <model
        x={Layout.HUB_X}
        y={Layout.HUB_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.HUB}
        pitch={Camera.HUB_PITCH}
        zoom={Camera.DIAL_ZOOM}
      />

      <rect
        ref={rotateOneCw}
        x={Layout.HOTSPOT_1_CW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.ONE, Turn.CLOCKWISE)}
      />
      <rect
        ref={rotateOneAcw}
        x={Layout.HOTSPOT_1_ACW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate counter-clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.ONE, Turn.ANTICLOCKWISE)}
      />
      <rect
        ref={rotateTwoCw}
        x={Layout.HOTSPOT_2_CW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.TWO, Turn.CLOCKWISE)}
      />
      <rect
        ref={rotateTwoAcw}
        x={Layout.HOTSPOT_2_ACW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate counter-clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.TWO, Turn.ANTICLOCKWISE)}
      />
      <rect
        ref={rotateThreeCw}
        x={Layout.HOTSPOT_3_CW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.THREE, Turn.CLOCKWISE)}
      />
      <rect
        ref={rotateThreeAcw}
        x={Layout.HOTSPOT_3_ACW_X}
        y={Layout.HOTSPOT_Y}
        w={Layout.HOTSPOT_W}
        h={Layout.HOTSPOT_H}
        color={FairyRingColor.HOTSPOT}
        transparency={Transparency.HOTSPOT}
        options={['Rotate counter-clockwise']}
        onOptionSelect={(event) => turnFairyRing(event.option, Ring.THREE, Turn.ANTICLOCKWISE)}
      />

      <model
        x={Layout.BOTTOM_RING_X}
        y={Layout.BOTTOM_RING_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={FairyRingModel.RING}
        pitch={Camera.RING_PITCH}
        zoom={Camera.BOTTOM_RING_ZOOM}
      />

      <text
        x={Layout.CONFIRM_X}
        y={Layout.CONFIRM_Y}
        w={Layout.CONFIRM_W}
        h={Layout.CONFIRM_H}
        text={FairyRingText.CONFIRM}
        font={FairyRingFonts.PLATE}
        color={FairyRingColor.TEXT}
        align="center"
        valign="middle"
        options={['Confirm']}
        onOptionSelect={(event) => confirmFairyRing(event.option, event.component)}
        onMouseEnter={(event) => swapPlateColour(event.component, FairyRingColor.TEXT_HOVER)}
        onMouseLeave={(event) => swapPlateColour(event.component, FairyRingColor.TEXT)}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={FairyRingArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, FairyRingArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, FairyRingArt.CLOSE)}
      />
    </>
  );
}
