import { createRef } from 'ts2';
import { Layout } from './trr-display.constants';
import { TrrDisplay } from './trr-display.component';

const trrDisplayRef = createRef('trr_display');

export const trrDisplayUi = (): UI => (
  <ui ref={trrDisplayRef} w={Layout.ROOT_W} h={Layout.ROOT_H}>
    <TrrDisplay />
  </ui>
);
