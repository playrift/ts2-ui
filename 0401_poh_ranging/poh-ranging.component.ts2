import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Layout,
  PohRangingColor,
  PohRangingDodge,
  PohRangingFonts,
  PohRangingModel,
  RangingCells,
  RangingHeaders,
} from './poh-ranging.constants';

const display = createRef('poh_ranging_display1');

export function PohRanging(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, display, PohRangingDodge.DODGE, Anchor.CENTRE, Anchor.BOTTOM, 0)
        }
      >
        <layer ref={display} x="center" y="bottom" w={Layout.DISPLAY_W} h={Layout.DISPLAY_H}>
          <model
            x={Layout.TARGET_X}
            y={Layout.TARGET_BOTTOM_Y}
            w={Layout.TARGET_W}
            h={Layout.TARGET_H}
            model={PohRangingModel.TARGET_LOW}
            pitch={Layout.TARGET_PITCH}
            zoom={Layout.TARGET_ZOOM}
          />

          <model
            x={Layout.TARGET_X}
            y={Layout.TARGET_MIDDLE_Y}
            w={Layout.TARGET_W}
            h={Layout.TARGET_H}
            model={PohRangingModel.TARGET_LOW}
            pitch={Layout.TARGET_PITCH}
            zoom={Layout.TARGET_ZOOM}
          />

          <model
            x={Layout.TARGET_X}
            y={Layout.TARGET_TOP_Y}
            w={Layout.TARGET_W}
            h={Layout.TARGET_H}
            model={PohRangingModel.TARGET_HIGH}
            pitch={Layout.TARGET_PITCH}
            zoom={Layout.TARGET_ZOOM}
          />

          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_PLAYER_Y}
            w={Layout.CAPTION_PLAYER_W}
            h={Layout.CAPTION_PLAYER_H}
            text="PLAYER "
            font={PohRangingFonts.B12}
            shadow
            color={PohRangingColor.CAPTION}
          />

          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_SHOTS_Y}
            w={Layout.CAPTION_SHOTS_W}
            h={Layout.CAPTION_SHOTS_H}
            text="SHOTS"
            font={PohRangingFonts.B12}
            shadow
            color={PohRangingColor.CAPTION}
          />

          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_SCORE_Y}
            w={Layout.CAPTION_SCORE_W}
            h={Layout.CAPTION_SCORE_H}
            text="SCORE"
            font={PohRangingFonts.B12}
            shadow
            color={PohRangingColor.CAPTION}
          />

          {RangingCells.map((cell) => (
            <text
              x={cell.x}
              y={cell.y}
              w={Layout.CELL_W}
              h={Layout.CELL_H}
              text="-"
              font={PohRangingFonts.P12}
              shadow
              align="center"
              color={PohRangingColor.CELL}
            />
          ))}

          {RangingHeaders.map((header) => (
            <text
              x={header.x}
              y={Layout.HEADER_Y}
              w={Layout.HEADER_W}
              h={Layout.HEADER_H}
              font={PohRangingFonts.B12}
              align="center"
              color={PohRangingColor.HEADER}
            />
          ))}

          <text
            x={Layout.SPARE_X}
            y={Layout.SPARE_Y}
            w={Layout.SPARE_W}
            h={Layout.SPARE_H}
            font={PohRangingFonts.P12}
            color={PohRangingColor.CELL}
          />
        </layer>
      </layer>
    </layer>
  );
}
