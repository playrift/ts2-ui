import { useRef } from 'ts2';

import { graphicSwapper, opsound } from '../lib/lib.helpers';
import { CollectColors, CollectFonts, CollectSprites, OP_SOUND_MASK } from './ge-collect.constants';
import { anythingToCollect } from './ge-collect.helpers';

export function CollectButton({ caption, op }: { caption: String; op: String }): Component {
  const face = useRef();

  const live: Boolean = anythingToCollect();

  if (live) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[op]}
        onMouseRepeat={() => graphicSwapper(face, CollectSprites.BUTTON_OVER)}
        onMouseLeave={() => graphicSwapper(face, CollectSprites.BUTTON)}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <sprite ref={face} x={0} y={0} w="fill" h="fill" sprite={CollectSprites.BUTTON} />
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          font={CollectFonts.BUTTON}
          color={CollectColors.LABEL}
          shadow
          align="center"
          valign="middle"
          text={caption}
        />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" options={[op]}>
      <sprite x={0} y={0} w="fill" h="fill" sprite={CollectSprites.BUTTON} />
      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        font={CollectFonts.BUTTON}
        color={CollectColors.LABEL_DEAD}
        shadow
        align="center"
        valign="middle"
        text={caption}
      />
    </layer>
  );
}
