import { CS2, useInventory, useRef } from 'ts2';

import { Inventories } from '../lib/game/inventories';

import { flashFor } from '../lib/lib.components';
import { itemName } from '../lib/lib.engine';
import { graphicSwapper } from '../lib/lib.helpers';
import { GeOfferBar, GeOfferIcon, GeOfferModel } from '../0200_ge_viewonly/ge-offer-slot.component';
import { StonePanel } from '../0200_ge_viewonly/stone-panel.component';
import { Flash, GeColors, GeSprites, Slot } from '../0200_ge_viewonly/ge-viewonly.constants';
import { hideGeTooltip, showGeTooltip } from './ge-collect.state';

export function GeCollectSlot({
  held0,
  count0,
  held1,
  count1,
  slot,
}: {
  held0: Item;
  count0: Int;
  held1: Item;
  count1: Int;
  slot: Int;
}): Component {
  const leftPlinth = useRef();
  const rightPlinth = useRef();

  let notable0: Int = 0;
  if (held0 !== -1) {
    if (CS2.item_cert(held0) !== held0) {
      notable0 = 1;
    }
  }
  let notable1: Int = 0;
  if (held1 !== -1) {
    if (CS2.item_cert(held1) !== held1) {
      notable1 = 1;
    }
  }

  return (
    <>
      <sprite x={0} y={0} w="fill" h="fill" sprite={GeSprites.BACKING} tiling />

      <sprite
        ref={leftPlinth}
        x={Slot.PLINTH_LEFT_X}
        y={Slot.PLINTH_Y}
        w={Slot.PLINTH_W}
        h={Slot.PLINTH_H}
        sprite={GeSprites.ITEM_BACKDROP}
      />
      <sprite
        ref={rightPlinth}
        x={Slot.PLINTH_RIGHT_X}
        y={Slot.PLINTH_Y}
        w={Slot.PLINTH_W}
        h={Slot.PLINTH_H}
        sprite={GeSprites.ITEM_BACKDROP}
      />

      {held0 === -1 ? (
        <sprite
          x={Slot.ITEM_LEFT_X}
          y={Slot.ITEM_Y}
          w={Slot.ITEM_W}
          h={Slot.ITEM_H}
          outline={Slot.ITEM_OUTLINE}
          shadowColor={GeColors.ICON_SHADOW}
          hide
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : (
        <sprite
          x={Slot.ITEM_LEFT_X}
          y={Slot.ITEM_Y}
          w={Slot.ITEM_W}
          h={Slot.ITEM_H}
          outline={Slot.ITEM_OUTLINE}
          shadowColor={GeColors.ICON_SHADOW}
          item={held0}
          itemCount={count0}
          options={[
            notable0 === 1 ? (count0 === 1 ? 'Collect-item' : 'Collect-notes') : '',
            notable0 === 1 ? (count0 === 1 ? 'Collect-note' : 'Collect-items') : 'Collect',
            'Bank',
            '',
            '',
            '',
            '',
            '',
            '',
            'Examine',
          ]}
          optionSubject={`<col=ff9040>${itemName(held0)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
          onMouseRepeat={() => graphicSwapper(leftPlinth, GeSprites.ITEM_BACKDROP_OVER)}
          onMouseLeave={() => graphicSwapper(leftPlinth, GeSprites.ITEM_BACKDROP)}
        />
      )}

      {held1 === -1 ? (
        <sprite
          x={Slot.ITEM_RIGHT_X}
          y={Slot.ITEM_Y}
          w={Slot.ITEM_W}
          h={Slot.ITEM_H}
          outline={Slot.ITEM_OUTLINE}
          shadowColor={GeColors.ICON_SHADOW}
          hide
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : (
        <sprite
          x={Slot.ITEM_RIGHT_X}
          y={Slot.ITEM_Y}
          w={Slot.ITEM_W}
          h={Slot.ITEM_H}
          outline={Slot.ITEM_OUTLINE}
          shadowColor={GeColors.ICON_SHADOW}
          item={held1}
          itemCount={count1}
          options={[
            notable1 === 1 ? (count1 === 1 ? 'Collect-item' : 'Collect-notes') : '',
            notable1 === 1 ? (count1 === 1 ? 'Collect-note' : 'Collect-items') : 'Collect',
            'Bank',
            '',
            '',
            '',
            '',
            '',
            '',
            'Examine',
          ]}
          optionSubject={`<col=ff9040>${itemName(held1)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
          onMouseRepeat={() => graphicSwapper(rightPlinth, GeSprites.ITEM_BACKDROP_OVER)}
          onMouseLeave={() => graphicSwapper(rightPlinth, GeSprites.ITEM_BACKDROP)}
        />
      )}

      <StonePanel divider={-1} />

      <rect
        x={Slot.BAR_BORDER_X}
        y={Slot.BAR_BORDER_Y}
        w={Slot.BAR_BORDER_W}
        h={Slot.BAR_BORDER_H}
        color={GeColors.INK}
      />
      <rect
        x={Slot.BAR_X}
        y={Slot.BAR_Y}
        w={Slot.BAR_W}
        h={Slot.BAR_H}
        fill
        color={GeColors.INK}
        transparency={GeColors.FADE}
      />
      <GeOfferBar slot={slot} />
      <rect
        x={Slot.BAR_X}
        y={Slot.BAR_Y}
        w={Slot.BAR_W}
        h={Slot.BAR_TOP_H}
        fill
        color={GeColors.INK}
        transparency={GeColors.FADE}
      />
      <rect
        x={Slot.BAR_X}
        y={Slot.BAR_LEFT_Y}
        w={Slot.BAR_LEFT_W}
        h={Slot.BAR_LEFT_H}
        fill
        color={GeColors.INK}
        transparency={GeColors.FADE}
      />

      <rect
        x={Slot.ICON_X}
        y={Slot.BADGE_Y}
        w={Slot.BADGE_W}
        h={Slot.BADGE_H}
        fill
        color={GeColors.INK}
        transparency={GeColors.FADE}
      />
      <GeOfferIcon slot={slot} />

      <rect
        x={Slot.MODEL_X}
        y={Slot.BADGE_Y}
        w={Slot.BADGE_W}
        h={Slot.BADGE_H}
        fill
        color={GeColors.INK}
        transparency={GeColors.FADE}
      />
      <GeOfferModel slot={slot} />
    </>
  );
}

export function CollectSlot0(): Component {
  const container = useInventory(Inventories.TRADINGPOST_SELL_0);
  const held0: Item = container[0];
  const count0: Int = container.count(0);
  const held1: Item = container[1];
  const count1: Int = container.count(1);
  return (
    <layer x={0} y={0} w="fill" h="fill" onMouseRepeat={() => showGeTooltip(0)} onMouseLeave={() => hideGeTooltip()}>
      <GeCollectSlot slot={0} held0={held0} count0={count0} held1={held1} count1={count1} />
    </layer>
  );
}

