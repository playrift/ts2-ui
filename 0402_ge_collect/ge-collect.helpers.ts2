import { useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';

export function anythingToCollect(): Boolean {
  const inv0 = useInventory(Inventories.TRADINGPOST_SELL_0);
  const inv1 = useInventory(Inventories.TRADINGPOST_SELL_1);
  const inv2 = useInventory(Inventories.TRADINGPOST_SELL_2);
  const inv3 = useInventory(Inventories.TRADINGPOST_SELL_3);
  const inv4 = useInventory(Inventories.TRADINGPOST_SELL_4);
  const inv5 = useInventory(Inventories.TRADINGPOST_SELL_5);
  const inv6 = useInventory(Inventories.GE_COLLECT_6);
  const inv7 = useInventory(Inventories.GE_COLLECT_7);

  const a0: Int = inv0.count(0);
  const b0: Int = inv0.count(1);
  const a1: Int = inv1.count(0);
  const b1: Int = inv1.count(1);
  const a2: Int = inv2.count(0);
  const b2: Int = inv2.count(1);
  const a3: Int = inv3.count(0);
  const b3: Int = inv3.count(1);
  const a4: Int = inv4.count(0);
  const b4: Int = inv4.count(1);
  const a5: Int = inv5.count(0);
  const b5: Int = inv5.count(1);
  const a6: Int = inv6.count(0);
  const b6: Int = inv6.count(1);
  const a7: Int = inv7.count(0);
  const b7: Int = inv7.count(1);

  if (a0 > 0 || b0 > 0) {
    return true;
  }
  if (a1 > 0 || b1 > 0) {
    return true;
  }
  if (a2 > 0 || b2 > 0) {
    return true;
  }
  if (a3 > 0 || b3 > 0) {
    return true;
  }
  if (a4 > 0 || b4 > 0) {
    return true;
  }
  if (a5 > 0 || b5 > 0) {
    return true;
  }
  if (a6 > 0 || b6 > 0) {
    return true;
  }
  if (a7 > 0 || b7 > 0) {
    return true;
  }
  return false;
}
