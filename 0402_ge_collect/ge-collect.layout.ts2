import { Panel } from './ge-collect.constants';

export function slotBoxX(slot: Int): Int {
  if (slot === 0 || slot === 4) {
    return Panel.SLOT_NEAR;
  }
  if (slot === 1 || slot === 5) {
    return Panel.SLOT_MID;
  }
  if (slot === 2 || slot === 6) {
    return Panel.W - Panel.SLOT_W - Panel.SLOT_MID;
  }
  return Panel.W - Panel.SLOT_W - Panel.SLOT_NEAR;
}

export function slotBoxY(slot: Int): Int {
  return slot < 4 ? Panel.ROW_0 : Panel.ROW_1;
}
