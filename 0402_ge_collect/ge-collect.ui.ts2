import { createRef } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { CollectButton } from './collect-button.component';
import {
  CollectSlot0,
  CollectSlot1,
  CollectSlot2,
  CollectSlot3,
  CollectSlot4,
  CollectSlot5,
  CollectSlot6,
  CollectSlot7,
} from './ge-collect-slot.component';
import { GeCollectTooltip } from './ge-collect-tooltip.component';
import { CollectLabels, Panel } from './ge-collect.constants';
import { panel, tooltipHost } from './ge-collect.refs';

const geCollect = createRef('ge_collect');

export function GeCollect(): Component {
  return (
    <>
      <layer static ref={panel} x="center" y="center" w={Panel.W} h={Panel.H}>
        <SteelBorderEntrypoint title="Collection Box" />

        <CollectButton
          x={Panel.COLLECT_INV_X}
          y={Panel.COLLECT_Y}
          w={Panel.COLLECT_W}
          h={Panel.COLLECT_H}
          caption={CollectLabels.INVENTORY_TEXT}
          op={CollectLabels.INVENTORY_OP}
        />
        <CollectButton
          x={{ right: Panel.COLLECT_BANK_RIGHT }}
          y={Panel.COLLECT_Y}
          w={Panel.COLLECT_W}
          h={Panel.COLLECT_H}
          caption={CollectLabels.BANK_TEXT}
          op={CollectLabels.BANK_OP}
        />

        <CollectSlot0 x={Panel.SLOT_NEAR} y={Panel.ROW_0} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot1 x={Panel.SLOT_MID} y={Panel.ROW_0} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot2 x={{ right: Panel.SLOT_MID }} y={Panel.ROW_0} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot3 x={{ right: Panel.SLOT_NEAR }} y={Panel.ROW_0} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot4 x={Panel.SLOT_NEAR} y={Panel.ROW_1} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot5 x={Panel.SLOT_MID} y={Panel.ROW_1} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot6 x={{ right: Panel.SLOT_MID }} y={Panel.ROW_1} w={Panel.SLOT_W} h={Panel.SLOT_H} />
        <CollectSlot7 x={{ right: Panel.SLOT_NEAR }} y={Panel.ROW_1} w={Panel.SLOT_W} h={Panel.SLOT_H} />
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w={1} h={1} />

      <layer x={0} y={0} w="fill" h="fill">
        <GeCollectTooltip />
      </layer>
    </>
  );
}

export const geCollectUi = (): UI => (
  <ui ref={geCollect} w={Panel.ROOT_W} h={Panel.ROOT_H}>
    <GeCollect />
  </ui>
);
