import { useInventory, useServerState, useSkill } from 'ts2';

import { magicRuneCount, spellbookHasRunes } from '../lib/lib.magic';

import {
  Grid,
  TeletabBase,
  TeletabInventories,
  TeletabSkills,
  TeletabTitles,
  TeletabVarbits,
} from './teletabs-craft-if.constants';
import {
  TabletNames,
  TeletabAncient,
  TeletabArceuus,
  TeletabDemon,
  TeletabEagle,
  TeletabLunar,
  TeletabMahoganyDemon,
  TeletabMahoganyEagle,
  TeletabMarble,
  TeletabOak,
  TeletabTable,
  TeletabTeakDemon,
  TeletabTeakEagle,
} from './teletabs-craft-if.data';

export function teletabTablet(table: Int, slot: Int): Item {
  switch (table) {
    case TeletabTable.OAK: {
      return TeletabOak.at(slot) ?? -1;
    }
    case TeletabTable.EAGLE: {
      return TeletabEagle.at(slot) ?? -1;
    }
    case TeletabTable.DEMON: {
      return TeletabDemon.at(slot) ?? -1;
    }
    case TeletabTable.TEAK_EAGLE: {
      return TeletabTeakEagle.at(slot) ?? -1;
    }
    case TeletabTable.TEAK_DEMON: {
      return TeletabTeakDemon.at(slot) ?? -1;
    }
    case TeletabTable.MAHOGANY_EAGLE: {
      return TeletabMahoganyEagle.at(slot) ?? -1;
    }
    case TeletabTable.MAHOGANY_DEMON: {
      return TeletabMahoganyDemon.at(slot) ?? -1;
    }
    case TeletabTable.MARBLE: {
      return TeletabMarble.at(slot) ?? -1;
    }
    case TeletabTable.ANCIENT: {
      return TeletabAncient.at(slot) ?? -1;
    }
    case TeletabTable.LUNAR: {
      return TeletabLunar.at(slot) ?? -1;
    }
    case TeletabTable.ARCEUUS: {
      return TeletabArceuus.at(slot) ?? -1;
    }
  }
  return -1;
}

export function teletabRowCount(table: Int): Int {
  switch (table) {
    case TeletabTable.OAK: {
      return TeletabOak.length;
    }
    case TeletabTable.EAGLE: {
      return TeletabEagle.length;
    }
    case TeletabTable.DEMON: {
      return TeletabDemon.length;
    }
    case TeletabTable.TEAK_EAGLE: {
      return TeletabTeakEagle.length;
    }
    case TeletabTable.TEAK_DEMON: {
      return TeletabTeakDemon.length;
    }
    case TeletabTable.MAHOGANY_EAGLE: {
      return TeletabMahoganyEagle.length;
    }
    case TeletabTable.MAHOGANY_DEMON: {
      return TeletabMahoganyDemon.length;
    }
    case TeletabTable.MARBLE: {
      return TeletabMarble.length;
    }
    case TeletabTable.ANCIENT: {
      return TeletabAncient.length;
    }
    case TeletabTable.LUNAR: {
      return TeletabLunar.length;
    }
    case TeletabTable.ARCEUUS: {
      return TeletabArceuus.length;
    }
  }
  return 0;
}

export function teletabScrollExtent(table: Int, rows: Int): Int {
  if (table === -1) {
    return Grid.EXTENT;
  }
  let extent: Int = Grid.EXTENT;
  if (rows <= 18) {
    extent = extent - Grid.ROW_PITCH;
  }
  if (rows <= 15) {
    extent = extent - Grid.ROW_PITCH;
  }
  if (rows <= 12) {
    extent = extent - Grid.ROW_PITCH;
  }
  if (rows <= 9) {
    extent = extent - Grid.ROW_PITCH;
  }
  return extent;
}

export function tabletName(tablet: Item): String {
  return TabletNames.get(tablet) ?? '';
}

export function teletabBaseItem(spellbook: Int): Item {
  if (spellbook === TeletabBase.ARCEUUS_BOOK) {
    return TeletabBase.DARK_ESSENCE;
  }
  return TeletabBase.SOFT_CLAY;
}

export function teletabTitle(spellbook: Int): String {
  switch (spellbook) {
    case 1: {
      return TeletabTitles.ANCIENT;
    }
    case 2: {
      return TeletabTitles.LUNAR;
    }
    case 3: {
      return TeletabTitles.ARCEUUS;
    }
  }
  return TeletabTitles.STANDARD;
}

export function ingredientDx(drawn: Int, index: Int): Int {
  switch (drawn) {
    case 1: {
      return 0;
    }
    case 2: {
      return index === 0 ? -32 : 32;
    }
    case 3: {
      return index === 0 ? -56 : index === 1 ? 0 : 56;
    }
    case 4: {
      return index === 0 ? -86 : index === 1 ? -28 : index === 2 ? 28 : 86;
    }
  }
  return index === 0 ? -92 : index === 1 ? -46 : index === 2 ? 0 : index === 3 ? 46 : 92;
}

export function teletabSpellbook(): Int {
  return useServerState(TeletabVarbits.SPELLBOOK);
}

export function ingredientHeld(item: Item, base: Item, weapon: Item, shield: Item): Int {
  const inv = useInventory(TeletabInventories.INV);
  if (item === base) {
    return inv.total(item);
  }
  return magicRuneCount(item, weapon, shield);
}

export function tabletReady(spell: Item, weapon: Item, shield: Item): Int {
  if (useSkill(TeletabSkills.MAGIC) >= (spell.spellLevelreq ?? 1) && spellbookHasRunes(spell, weapon, shield)) {
    return 1;
  }
  return 0;
}
