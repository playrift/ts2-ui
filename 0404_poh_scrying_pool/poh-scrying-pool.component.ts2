import { createRef, useInterval } from 'ts2';

import { modelTransparentDynamicZoom } from '../lib/lib.models';
import { PoolAnims, PoolCamera, PoolModel, PoolTint } from './poh-scrying-pool.constants';

const timerHost = createRef('0404_poh_scrying_pool_timer_host');

const poolWiggler = createRef('poh_scrying_pool_wiggler');

export function PohScryingPool(): Component {
  useInterval(
    () =>
      modelTransparentDynamicZoom(
        timerHost,
        poolWiggler,
        PoolCamera.NEAR,
        PoolCamera.FAR,
        PoolCamera.OFFSET_X,
        PoolCamera.OFFSET_Y,
        PoolCamera.PITCH,
        PoolCamera.YAW,
        PoolCamera.ROLL,
      ),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <rect
        x="center"
        y={0}
        w="fill"
        h="fill"
        color={PoolTint.COLOR}
        fill={true}
        transparency={PoolTint.TRANSPARENCY}
      />

      <model
        ref={poolWiggler}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={PoolModel.WIGGLER}
        anim={PoolAnims.WIGGLER}
        zoom={PoolCamera.NEAR}
        offsetY={PoolCamera.OFFSET_Y}
      />
    </layer>
  );
}
