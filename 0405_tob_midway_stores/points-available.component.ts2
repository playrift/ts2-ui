import { useServerState } from 'ts2';

import { Layout, StoreColor, StoreFonts, StoreVarbits } from './tob-midway-stores.constants';

export function PointsAvailable(): Component {
  const points: Int = useServerState(StoreVarbits.POINTS);

  return (
    <text
      x="center"
      y="bottom"
      w="fill"
      h={Layout.POINTS_H}
      text={`Points Available: <col=ffffff>${stringOf(points)}</col>`}
      font={StoreFonts.BODY}
      color={StoreColor.TEXT}
      shadow
      align="center"
      valign="middle"
    />
  );
}
