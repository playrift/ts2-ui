import { itemName } from '../lib/lib.engine';
import { EXAMINE, Grid, OP_BASE_PREFIX, StoreColor, StoreItems, StoreShade } from './tob-midway-stores.constants';

export function SupplyCell({
  item,
  index,
  staminaStock,
  lastX,
}: {
  item: ItemName;
  index: Int;
  staminaStock: Int;
  lastX: Int;
}): Component {
  const x: Int = (Grid.ICON_W + Grid.GAP_X) * (index % Grid.COLS);
  const y: Int = (index / Grid.COLS) * (Grid.ICON_H + Grid.GAP_Y);
  const subject: String = `${OP_BASE_PREFIX}${itemName(item as Item)}`;

  if (item === StoreItems.STAMINA_POTION) {
    return (
      <sprite
        x={x}
        y={y}
        w={Grid.ICON_W}
        h={Grid.ICON_H}
        item={item}
        itemCount={staminaStock}
        transparency={staminaStock === 0 ? StoreShade.SOLD_OUT : StoreShade.AVAILABLE}
        options={['Value', 'Buy-1', '', '', '', '', '', '', '', EXAMINE]}
        optionSubject={subject}
        shadowColor={StoreColor.ICON_SHADOW}
        outline={1}
      />
    );
  }

  if (lastX !== 0) {
    return (
      <sprite
        x={x}
        y={y}
        w={Grid.ICON_W}
        h={Grid.ICON_H}
        item={item}
        itemCount={-1}
        options={['Value', 'Buy-1', `Buy-${stringOf(lastX)}`, 'Buy-All', 'Buy-X', '', '', '', '', EXAMINE]}
        optionSubject={subject}
        shadowColor={StoreColor.ICON_SHADOW}
        outline={1}
      />
    );
  }

  return (
    <sprite
      x={x}
      y={y}
      w={Grid.ICON_W}
      h={Grid.ICON_H}
      item={item}
      itemCount={-1}
      options={['Value', 'Buy-1', '', 'Buy-All', 'Buy-X', '', '', '', '', EXAMINE]}
      optionSubject={subject}
      shadowColor={StoreColor.ICON_SHADOW}
      outline={1}
    />
  );
}
