import { useServerState } from 'ts2';

import { SupplyCell } from './supply-cell.component';
import {
  Grid,
  Layout,
  StoreColor,
  StoreFonts,
  StorePrices,
  StoreStock,
  StoreVarbits,
} from './tob-midway-stores.constants';

export function SupplyGrid(): Component {
  const staminaStock: Int = useServerState(StoreVarbits.STAMINA_STOCK);
  const lastX: Int = useServerState(StoreVarbits.LAST_X);

  return (
    <layer x={Layout.GRID_X} y="center" w={Layout.GRID_W} h={Layout.GRID_H}>
      {StoreStock.map((item, index) => (
        <SupplyCell item={item} index={index} staminaStock={staminaStock} lastX={lastX} />
      ))}

      {StoreStock.map((item, index) => (
        <text
          x={(Grid.ICON_W + Grid.GAP_X) * (index % Grid.COLS)}
          y={Grid.COUNT_TOP + (index / Grid.COLS) * (Grid.ICON_W + Grid.GAP_Y)}
          w={Grid.COUNT_W}
          h={Grid.COUNT_H}
          text={stringOf(StorePrices.get(item as Item))}
          font={StoreFonts.BODY}
          color={StoreColor.TEXT}
          shadow
          align="center"
          valign="middle"
        />
      ))}
    </layer>
  );
}
