export function TobMidwayStores(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Theatre of Blood Supplies" />

      <layer x="center" y={Layout.STRIP_Y} w={{ fill: Layout.STRIP_W_INSET }} h={Layout.STRIP_H}>
        <model
          x={Layout.CHEST_LEFT_X}
          y={{ center: Layout.CHEST_LEFT_DY }}
          w={Layout.CHEST_W}
          h={Layout.CHEST_H}
          model={StoreModels.CHEST_LEFT}
          zoom={700}
          pitch={512}
          yaw={826}
          offsetX={-10}
          offsetY={5}
        />

        <model
          x={Layout.CHEST_RIGHT_X}
          y={{ center: Layout.CHEST_RIGHT_DY }}
          w={Layout.CHEST_W}
          h={Layout.CHEST_H}
          model={StoreModels.CHEST_RIGHT}
          zoom={600}
          pitch={512}
