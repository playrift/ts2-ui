import { useInventory } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { EXAMINE, Layout, NoteAngle, OP_BASE_PREFIX, StoreInventories } from './tob-midway-stores.constants';

export function VampyreNote(): Component {
  const chest = useInventory(StoreInventories.CHEST);
  const held: Item = chest[0];

  if (held !== -1) {
    return (
      <model
        x={Layout.NOTE_X}
        y={Layout.NOTE_Y}
        w={Layout.NOTE_W}
        h={Layout.NOTE_H}
        item={held}
        itemCount={-1}
        pitch={NoteAngle.PITCH}
        yaw={NoteAngle.YAW}
        zoom={NoteAngle.ZOOM}
        options={['Take', '', '', '', '', '', '', '', '', EXAMINE]}
        optionSubject={`${OP_BASE_PREFIX}${itemName(held)}`}
      />
    );
  }

  return (
    <model
      x={Layout.NOTE_X}
      y={Layout.NOTE_Y}
      w={Layout.NOTE_W}
      h={Layout.NOTE_H}
      pitch={NoteAngle.PITCH}
      yaw={NoteAngle.YAW}
      zoom={NoteAngle.ZOOM}
    />
  );
}
