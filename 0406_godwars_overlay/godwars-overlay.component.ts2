import { useInterval, useRef, useWatch } from 'ts2';

import { HelperBackgroundEntrypoint } from '../0710_helper_cox/helper-background.component';
import { Fonts } from '../lib/game/fonts';
import { Varbits } from '../lib/game/varbits';
import { GodwarsColor, Layout } from './godwars-overlay.constants';
import {
  godwarsDarknessStep,
  godwarsKillcountArmadyl,
  godwarsKillcountBandos,
  godwarsKillcountSaradomin,
  godwarsKillcountZamorak,
  godwarsKillcountZaros,
  godwarsOverlayInit,
  godwarsHideshow,
  nexFadeTimer,
  nexPlateHeight,
} from './godwars-overlay.helpers';
import { contents, darkness, dodger, fader, killsLayer, tintBox, universe } from './godwars-overlay.refs';

export function GodwarsOverlay(): Component {
  const armadyl = useRef();
  const bandos = useRef();
  const saradomin = useRef();
  const zamorak = useRef();
  const zaros = useRef();

  useInterval(() => godwarsHideshow(contents, fader), universe);
  useWatch(Varbits.FROZEN_DOOR, () => nexPlateHeight(killsLayer), universe);

  useInterval(() => nexFadeTimer(tintBox), tintBox);
  useInterval(() => godwarsDarknessStep(darkness), darkness);

  useWatch(Varbits.GODWARS_COUNTER_ARMADYL, (event) => godwarsKillcountArmadyl(event.component), armadyl);
  useWatch(Varbits.GODWARS_COUNTER_BANDOS, (event) => godwarsKillcountBandos(event.component), bandos);
  useWatch(Varbits.GODWARS_COUNTER_SARADOMIN, (event) => godwarsKillcountSaradomin(event.component), saradomin);
  useWatch(Varbits.GODWARS_COUNTER_ZAMORAK, (event) => godwarsKillcountZamorak(event.component), zamorak);
  useWatch(Varbits.GODWARS_COUNTER_ZAROS, (event) => godwarsKillcountZaros(event.component), zaros);

  return (
    <layer
      ref={universe}
      x="center"
      y="center"
      w="fill"
      h="fill"
      onLoad={() => godwarsOverlayInit(dodger, killsLayer, contents, fader)}
    >
      <layer ref={contents} x="center" y="center" w="fill" h="fill">
        <rect ref={tintBox} x={0} y={0} w="fill" h="fill" color={GodwarsColor.NEX_TINT} fill transparency={255} />

        <rect
          ref={darkness}
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={GodwarsColor.BLACK}
          fill
          transparency={255}
          onLoad={() => godwarsDarknessStep(darkness)}
        />

        <layer ref={dodger} x="center" y="center" w="fill" h="fill">
          <layer ref={killsLayer} x={Layout.PLATE_X} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H_NEX}>
            <layer x="center" y="center" w="fill" h="fill">
              <HelperBackgroundEntrypoint />
            </layer>

            <layer x="center" y="center" w={{ fill: Layout.COLUMN_INSET }} h={{ fill: Layout.COLUMN_INSET }}>
              <text
                x="center"
                y={0}
                w={{ fill: Layout.HEADING_INSET }}
                h={Layout.HEADING_H}
                font={Fonts.B12_FULL}
                text="Essence"
                align="center"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />

              <text
                x={Layout.NAME_X}
                y={Layout.ROW_Y_1}
                w={Layout.NAME_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="Armadyl"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />
              <text
                x={Layout.NAME_X}
                y={Layout.ROW_Y_2}
                w={Layout.NAME_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="Bandos"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />
              <text
                x={Layout.NAME_X}
                y={Layout.ROW_Y_3}
                w={Layout.NAME_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="Saradomin"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />
              <text
                x={Layout.NAME_X}
                y={Layout.ROW_Y_4}
                w={Layout.NAME_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="Zamorak"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />
              <text
                x={Layout.NAME_X}
                y={Layout.ROW_Y_5}
                w={Layout.NAME_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="Ancient"
                valign="middle"
                shadow
                color={GodwarsColor.LABEL}
              />

              <text
                ref={armadyl}
                x={{ right: Layout.COUNT_INSET }}
                y={Layout.ROW_Y_1}
                w={Layout.COUNT_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="0"
                align="right"
                valign="middle"
                shadow
                color={GodwarsColor.COUNT}
                onLoad={(event) => godwarsKillcountArmadyl(event.component)}
              />
              <text
                ref={bandos}
                x={{ right: Layout.COUNT_INSET }}
                y={Layout.ROW_Y_2}
                w={Layout.COUNT_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="0"
                align="right"
                shadow
                color={GodwarsColor.COUNT}
                onLoad={(event) => godwarsKillcountBandos(event.component)}
              />
              <text
                ref={saradomin}
                x={{ right: Layout.COUNT_INSET }}
                y={Layout.ROW_Y_3}
                w={Layout.COUNT_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="0"
                align="right"
                shadow
                color={GodwarsColor.COUNT}
                onLoad={(event) => godwarsKillcountSaradomin(event.component)}
              />
              <text
                ref={zamorak}
                x={{ right: Layout.COUNT_INSET }}
                y={Layout.ROW_Y_4}
                w={Layout.COUNT_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="0"
                align="right"
                shadow
                color={GodwarsColor.COUNT}
                onLoad={(event) => godwarsKillcountZamorak(event.component)}
              />
              <text
                ref={zaros}
                x={{ right: Layout.COUNT_INSET }}
                y={Layout.ROW_Y_5}
                w={Layout.COUNT_W}
                h={Layout.ROW_H}
                font={Fonts.P12_FULL}
                text="0"
                align="right"
                shadow
                color={GodwarsColor.COUNT}
                onLoad={(event) => godwarsKillcountZaros(event.component)}
              />
            </layer>
          </layer>
        </layer>

        <rect ref={fader} x="center" y="center" w="fill" h="fill" color={GodwarsColor.BLACK} fill transparency={255} />
      </layer>
    </layer>
  );
}
