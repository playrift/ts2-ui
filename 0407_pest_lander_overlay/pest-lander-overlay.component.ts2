import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  LanderBars,
  LanderColor,
  LanderFont,
  LanderModel,
  Layout,
  PestLanderDodge,
} from './pest-lander-overlay.constants';

const info = createRef('pest_lander_overlay_info2');

const banner = createRef('pest_lander_overlay_banner3');

export function PestLanderOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, info, PestLanderDodge.INFO, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={info} x={Layout.INFO_X} y={0} w={Layout.INFO_W} h={Layout.INFO_H}>
          <text
            x={0}
            y={0}
            w={Layout.LINE_W}
            h={Layout.LINE_H}
            font={LanderFont.P12}
            shadow
            color={LanderColor.LINE_1}
          />
          <text
            x={0}
            y={Layout.LINE_H}
            w={Layout.LINE_W}
            h={Layout.LINE_H}
            font={LanderFont.P12}
            shadow
            color={LanderColor.LINE_2}
          />
          <text
            x={0}
            y={Layout.LINE_H * 2}
            w={Layout.LINE_W}
            h={Layout.LINE_H}
            font={LanderFont.P12}
            shadow
            color={LanderColor.LINE_3}
          />
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, banner, PestLanderDodge.BANNER, Anchor.RIGHT, Anchor.BOTTOM, 0)
        }
      >
        <layer ref={banner} x="right" y="bottom" w={Layout.BANNER_W} h={Layout.BANNER_H}>
          <model
            x={{ right: Layout.MODEL_RIGHT }}
            y={{ bottom: Layout.MODEL_BOTTOM }}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={LanderModel.POINTS}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
            yaw={Layout.MODEL_YAW}
          />

          <layer
            x={{ right: Layout.STRIP_RIGHT }}
            y={{ bottom: Layout.STRIP_BOTTOM }}
            w={Layout.STRIP_W}
            h={Layout.STRIP_H}
          >
            {LanderBars.map((bar) => (
              <rect
                x={{ right: bar.right }}
                y="center"
                w={Layout.BAR_W}
                h="fill"
                color={LanderColor.BAR}
                fill
                transparency={bar.wash}
              />
            ))}
          </layer>

          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={{ bottom: Layout.TEXT_BOTTOM }}
            w={Layout.TEXT_W}
            h={Layout.TEXT_H}
            font={LanderFont.P12}
            shadow
            align="right"
            color={LanderColor.BANNER}
          />
        </layer>
      </layer>
    </layer>
  );
}
