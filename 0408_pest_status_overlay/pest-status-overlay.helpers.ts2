import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Activity, PestColor } from './pest-status-overlay.constants';

export function pestActivityUpdate(outline: ComponentId, bar: ComponentId): void {
  const counter: Int = useServerState(Varbits.PEST_ACTIVITY_COUNTER);
  if (counter > 0) {
    outline.color = PestColor.ACTIVITY_ON;
    bar.color = PestColor.ACTIVITY_ON;
    CS2.if_position_set(0, 0, 0, 1, bar);
    CS2.if_size_set(CS2.scale(counter, Activity.FULL, Activity.PROPORTION), 0, 2, 1, bar);
  } else {
    outline.color = PestColor.ACTIVITY_OFF;
    bar.color = PestColor.ACTIVITY_OFF;
    CS2.if_position_set(0, 0, 1, 1, bar);
    CS2.if_size_set(Activity.PIP_W, Activity.PIP_H, 0, 0, bar);
  }
}
