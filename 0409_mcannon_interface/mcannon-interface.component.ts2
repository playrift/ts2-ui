import {
  CannonCamera,
  CannonColor,
  CannonFonts,
  CannonModel,
  CannonSprites,
  INSTRUCTION,
  Layout,
} from './mcannon-interface.constants';

export function McannonInterface(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} fill color={CannonColor.BACKDROP} />

      <model
        x={Layout.TOOL_1_X}
        y={Layout.TOOL_Y}
        w={Layout.TOOL_1_W}
        h={Layout.TOOL_H}
        model={CannonModel.TOOL_1}
        zoom={CannonCamera.TOOL_1_ZOOM}
        pitch={CannonCamera.TOOL_1_PITCH}
        yaw={CannonCamera.TOOL_1_YAW}
      />

      <model
        x={Layout.TOOL_2_X}
        y={Layout.TOOL_Y}
        w={Layout.TOOL_2_W}
        h={Layout.TOOL_H}
        model={CannonModel.TOOL_2}
        zoom={CannonCamera.TOOL_2_ZOOM}
        pitch={CannonCamera.TOOL_2_PITCH}
        yaw={CannonCamera.TOOL_2_YAW}
      />

      <model
        x={Layout.TOOL_3_X}
        y={Layout.TOOL_Y}
        w={Layout.TOOL_3_W}
        h={Layout.TOOL_H}
        model={CannonModel.TOOL_3}
        zoom={CannonCamera.TOOL_3_ZOOM}
        pitch={CannonCamera.TOOL_3_PITCH}
      />

      <model
        x={Layout.MECHANISM_X}
        y={Layout.MECHANISM_Y}
        w={Layout.MECHANISM_W}
        h={Layout.MECHANISM_H}
        model={CannonModel.CASING}
        zoom={CannonCamera.MECHANISM_ZOOM}
        pitch={CannonCamera.MECHANISM_PITCH}
        yaw={CannonCamera.MECHANISM_YAW}
      />

      <model
        x={Layout.MECHANISM_X}
        y={Layout.MECHANISM_Y}
        w={Layout.MECHANISM_W}
        h={Layout.MECHANISM_H}
        model={CannonModel.MECHANISM}
        zoom={CannonCamera.MECHANISM_ZOOM}
        pitch={CannonCamera.MECHANISM_PITCH}
        yaw={CannonCamera.MECHANISM_YAW}
      />

      <text
        x={Layout.INSTRUCTION_X}
        y={Layout.INSTRUCTION_Y}
        w={Layout.INSTRUCTION_W}
        h={Layout.INSTRUCTION_H}
        text={INSTRUCTION}
        font={CannonFonts.BODY}
        color={CannonColor.BODY}
        shadow
        align="center"
        valign="top"
      />

      <model
        x={Layout.SAFETY_X}
        y={Layout.SAFETY_Y}
        w={Layout.SAFETY_W}
        h={Layout.SAFETY_H}
        zoom={CannonCamera.PART_ZOOM}
      />

      <model
        x={Layout.SPRING_X}
        y={Layout.SPRING_Y}
        w={Layout.SPRING_W}
        h={Layout.SPRING_H}
        zoom={CannonCamera.PART_ZOOM}
      />

      <model x={Layout.GEAR_X} y={Layout.GEAR_Y} w={Layout.GEAR_W} h={Layout.GEAR_H} zoom={CannonCamera.PART_ZOOM} />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CannonSprites.CLOSE}
      />

      <layer hide x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_W} h={Layout.HOVER_H}>
        <sprite
          x={Layout.HOVER_SPRITE_X}
          y={Layout.HOVER_SPRITE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CannonSprites.CLOSE_PRESSED}
        />
      </layer>
    </>
  );
}
