import { createRef } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  DefenceAnims,
  DefenceArt,
  DefenceColor,
  DefenceFonts,
  DefenceModel,
  HazardRows,
  Layout,
  ProjectileCamera,
} from './warguild-defence.constants';

const closeIcon = createRef('warguild_defence_close');

export function WarguildDefence(): Component {
  return (
    <>
      <model
        x={Layout.PROJECTILE_X}
        y={Layout.PROJECTILE_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={DefenceModel.PROJECTILE}
        pitch={ProjectileCamera.PITCH}
        yaw={ProjectileCamera.YAW}
        zoom={ProjectileCamera.ZOOM}
      />

      <layer
        x={Layout.COLUMN_X}
        y={Layout.COLUMN_Y}
        w={{ fill: Layout.COLUMN_W_INSET }}
        h={{ fill: Layout.COLUMN_H_INSET }}
      >
        {HazardRows.map((row) => (
          <model
            x={Layout.MODEL_X}
            y={row.modelY}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={row.model}
            anim={DefenceAnims.SPIN}
            pitch={row.pitch}
            yaw={row.yaw}
            zoom={row.zoom}
          />
        ))}

        <text
          x={{ center: Layout.HEADING_X_OFFSET }}
          y={Layout.HEADING_Y}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          font={DefenceFonts.HEADING}
          color={DefenceColor.HEADING}
          align="center"
          shadow
          text="Catapult Defence Game Key"
        />

        {HazardRows.map((row) => (
          <text
            x={Layout.CAPTION_X}
            y={row.textY}
            w={row.textW}
            h={row.textH}
            font={DefenceFonts.CAPTION}
            color={DefenceColor.CAPTION}
            shadow
            text={row.text}
          />
        ))}
      </layer>

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onMouseEnter={() => {
          graphicSwapper(closeIcon, DefenceArt.CLOSE_HOVER);
        }}
        onMouseLeave={() => {
          graphicSwapper(closeIcon, DefenceArt.CLOSE);
        }}
      >
        <sprite
          ref={closeIcon}
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={DefenceArt.CLOSE}
          onOptionSelect={() => closeInterface()}
        />
      </layer>
    </>
  );
}
