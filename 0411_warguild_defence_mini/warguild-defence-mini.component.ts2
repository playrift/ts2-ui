import { useState } from 'ts2';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { Anims, Colors, Fonts, Models, Style } from './warguild-defence-mini.constants';

export function WarguildDefenceMini(): Component {
  const [stabHover, setStabHover] = useState(0);
  const [crushHover, setCrushHover] = useState(0);
  const [slashHover, setSlashHover] = useState(0);
  const [magicHover, setMagicHover] = useState(0);
  const [selected, setSelected] = useState(Style.NONE);
  const [picks, setPicks] = useState(0);

  return (
    <>
      <StyleModel
        x={14}
        y={59}
        model={Models.STAB}
        zoom={426}
        pitch={39}
        yaw={1676}
        spinning={isStyle(selected, Style.STAB)}
        pick={picks}
      />
      <StyleModel
        x={14}
        y={108}
        model={Models.CRUSH}
        zoom={426}
        pitch={11}
        yaw={1619}
        spinning={isStyle(selected, Style.CRUSH)}
        pick={picks}
      />
      <StyleModel
        x={17}
        y={166}
        model={Models.SLASH}
        zoom={426}
        pitch={0}
        yaw={1950}
        spinning={isStyle(selected, Style.SLASH)}
        pick={picks}
      />
      <StyleModel
        x={14}
        y={225}
        model={Models.MAGIC}
        zoom={400}
        pitch={0}
        yaw={1573}
        spinning={isStyle(selected, Style.MAGIC)}
        pick={picks}
      />

      <text
        x={19}
        y={4}
        w={151}
        h={14}
        font={Fonts.TITLE}
        color={Colors.TITLE}
        shadow
        align="center"
        text="Defence style"
      />

      <layer
        x={66}
        y={27}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          setStabHover(1);
        }}
        onMouseLeave={() => {
          setStabHover(0);
        }}
        onOptionSelect={() => {
          setStabHover(0);
          setCrushHover(0);
          setSlashHover(0);
          setMagicHover(0);
          setSelected(Style.STAB);
          setPicks(picks + 1);
        }}
      >
        <layer w="fill" h="fill" hide={isOn(stabHover)}>
          <StoneButtonOutFilled />
        </layer>
        <layer w="fill" h="fill" hide={isOff(stabHover)}>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={27}
        w={106}
        h={46}
        font={Fonts.BUTTON}
        color={labelColor(selected, Style.STAB, Colors.STAB_INITIAL)}
        shadow
        align="center"
        valign="middle"
        text="Stab defence"
      />

      <layer
        x={66}
        y={83}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          setCrushHover(1);
        }}
        onMouseLeave={() => {
          setCrushHover(0);
        }}
        onOptionSelect={() => {
          setStabHover(0);
          setCrushHover(0);
          setSlashHover(0);
          setMagicHover(0);
          setSelected(Style.CRUSH);
          setPicks(picks + 1);
        }}
      >
        <layer w="fill" h="fill" hide={isOn(crushHover)}>
          <StoneButtonOutFilled />
        </layer>
        <layer w="fill" h="fill" hide={isOff(crushHover)}>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={83}
        w={106}
        h={46}
        font={Fonts.BUTTON}
        color={labelColor(selected, Style.CRUSH, Colors.UNSELECTED)}
        shadow
        align="center"
        valign="middle"
        text="Crush defence"
      />

      <layer
        x={66}
        y={139}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          setSlashHover(1);
        }}
        onMouseLeave={() => {
          setSlashHover(0);
        }}
        onOptionSelect={() => {
          setStabHover(0);
          setCrushHover(0);
          setSlashHover(0);
          setMagicHover(0);
          setSelected(Style.SLASH);
          setPicks(picks + 1);
        }}
      >
        <layer w="fill" h="fill" hide={isOn(slashHover)}>
          <StoneButtonOutFilled />
        </layer>
        <layer w="fill" h="fill" hide={isOff(slashHover)}>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={139}
        w={106}
        h={46}
        font={Fonts.BUTTON}
        color={labelColor(selected, Style.SLASH, Colors.UNSELECTED)}
        shadow
        align="center"
        valign="middle"
        text="Slash defence"
      />

      <layer
        x={66}
        y={196}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          setMagicHover(1);
        }}
        onMouseLeave={() => {
          setMagicHover(0);
        }}
        onOptionSelect={() => {
          setStabHover(0);
          setCrushHover(0);
          setSlashHover(0);
          setMagicHover(0);
          setSelected(Style.MAGIC);
          setPicks(picks + 1);
        }}
      >
        <layer w="fill" h="fill" hide={isOn(magicHover)}>
          <StoneButtonOutFilled />
        </layer>
        <layer w="fill" h="fill" hide={isOff(magicHover)}>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={196}
        w={106}
        h={46}
        font={Fonts.BUTTON}
        color={labelColor(selected, Style.MAGIC, Colors.UNSELECTED)}
        shadow
        align="center"
        valign="middle"
        text="Magic defence"
      />
    </>
  );
}

export function StyleModel({
  x,
  y,
  model,
  zoom,
  pitch,
  yaw,
  spinning,
  pick,
}: {
  x: Int;
  y: Int;
  model: Model;
  zoom: Int;
  pitch: Int;
  yaw: Int;
  spinning: Int;
  pick: Int;
}): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {pick % 2 === 0 ? (
        <model x={x} y={y} w={32} h={32} model={model} zoom={zoom} pitch={pitch} yaw={yaw} anim={spinAnim(spinning)} />
      ) : (
        <model x={x} y={y} w={32} h={32} model={model} zoom={zoom} pitch={pitch} yaw={yaw} anim={spinAnim(spinning)} />
      )}
    </layer>
  );
}

function isStyle(selected: Int, style: Int): Int {
  if (selected === style) {
    return 1;
  }
  return 0;
}

function isOn(flag: Int): Boolean {
  return flag !== 0;
}

function isOff(flag: Int): Boolean {
  return flag === 0;
}

function labelColor(selected: Int, style: Int, initial: Int): Int {
  if (selected === Style.NONE) {
    return initial;
  }
  if (selected === style) {
    return Colors.SELECTED;
  }
  return Colors.UNSELECTED;
}

function spinAnim(spinning: Int): Animation {
  if (spinning !== 0) {
    return Anims.SPIN;
  }
  return Anims.NONE;
}
