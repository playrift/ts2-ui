import { useRef } from 'ts2';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { Anims, Colors, Fonts, Models } from './warguild-defence-mini.constants';

const clearButton = (raised: Ref, pressed: Ref, label: Ref, model: Ref): void => {
  raised.hide = false;
  pressed.hide = true;
  label.color = Colors.UNSELECTED;
  model.anim = Anims.NONE;
};

export function WarguildDefenceMini(): Component {
  const stabOut = useRef();
  const stabIn = useRef();
  const crushOut = useRef();
  const crushIn = useRef();
  const slashOut = useRef();
  const slashIn = useRef();
  const magicOut = useRef();
  const magicIn = useRef();

  const stabModel = useRef();
  const crushModel = useRef();
  const slashModel = useRef();
  const magicModel = useRef();

  const stabText = useRef();
  const crushText = useRef();
  const slashText = useRef();
  const magicText = useRef();

  return (
    <>
      <model x={14} y={59} w={32} h={32} ref={stabModel} model={Models.STAB} zoom={426} pitch={39} yaw={1676} />
      <model x={14} y={108} w={32} h={32} ref={crushModel} model={Models.CRUSH} zoom={426} pitch={11} yaw={1619} />
      <model x={17} y={166} w={32} h={32} ref={slashModel} model={Models.SLASH} zoom={426} yaw={1950} />
      <model x={14} y={225} w={32} h={32} ref={magicModel} model={Models.MAGIC} zoom={400} yaw={1573} />

      <text
        x={19}
        y={4}
        w={151}
        h={14}
        font={Fonts.TITLE}
        color={Colors.TITLE}
        shadow
        align="center"
        text="Defence style"
      />

      <layer
        x={66}
        y={27}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          stabOut.hide = true;
          stabIn.hide = false;
        }}
        onMouseLeave={() => {
          stabOut.hide = false;
          stabIn.hide = true;
        }}
        onOptionSelect={() => {
          clearButton(stabOut, stabIn, stabText, stabModel);
          clearButton(crushOut, crushIn, crushText, crushModel);
          clearButton(slashOut, slashIn, slashText, slashModel);
          clearButton(magicOut, magicIn, magicText, magicModel);
          stabText.color = Colors.SELECTED;
          stabModel.anim = Anims.SPIN;
        }}
      >
        <layer ref={stabOut} w="fill" h="fill">
          <StoneButtonOutFilled />
        </layer>
        <layer ref={stabIn} w="fill" h="fill" hide>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={27}
        w={106}
        h={46}
        ref={stabText}
        font={Fonts.BUTTON}
        color={Colors.STAB_INITIAL}
        shadow
        align="center"
        valign="middle"
        text="Stab defence"
      />

      <layer
        x={66}
        y={83}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          crushOut.hide = true;
          crushIn.hide = false;
        }}
        onMouseLeave={() => {
          crushOut.hide = false;
          crushIn.hide = true;
        }}
        onOptionSelect={() => {
          clearButton(stabOut, stabIn, stabText, stabModel);
          clearButton(crushOut, crushIn, crushText, crushModel);
          clearButton(slashOut, slashIn, slashText, slashModel);
          clearButton(magicOut, magicIn, magicText, magicModel);
          crushText.color = Colors.SELECTED;
          crushModel.anim = Anims.SPIN;
        }}
      >
        <layer ref={crushOut} w="fill" h="fill">
          <StoneButtonOutFilled />
        </layer>
        <layer ref={crushIn} w="fill" h="fill" hide>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={83}
        w={106}
        h={46}
        ref={crushText}
        font={Fonts.BUTTON}
        color={Colors.UNSELECTED}
        shadow
        align="center"
        valign="middle"
        text="Crush defence"
      />

      <layer
        x={66}
        y={139}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          slashOut.hide = true;
          slashIn.hide = false;
        }}
        onMouseLeave={() => {
          slashOut.hide = false;
          slashIn.hide = true;
        }}
        onOptionSelect={() => {
          clearButton(stabOut, stabIn, stabText, stabModel);
          clearButton(crushOut, crushIn, crushText, crushModel);
          clearButton(slashOut, slashIn, slashText, slashModel);
          clearButton(magicOut, magicIn, magicText, magicModel);
          slashText.color = Colors.SELECTED;
          slashModel.anim = Anims.SPIN;
        }}
      >
        <layer ref={slashOut} w="fill" h="fill">
          <StoneButtonOutFilled />
        </layer>
        <layer ref={slashIn} w="fill" h="fill" hide>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={139}
        w={106}
        h={46}
        ref={slashText}
        font={Fonts.BUTTON}
        color={Colors.UNSELECTED}
        shadow
        align="center"
        valign="middle"
        text="Slash defence"
      />

      <layer
        x={66}
        y={196}
        w={106}
        h={46}
        options={['Select']}
        onMouseEnter={() => {
          magicOut.hide = true;
          magicIn.hide = false;
        }}
        onMouseLeave={() => {
          magicOut.hide = false;
          magicIn.hide = true;
        }}
        onOptionSelect={() => {
          clearButton(stabOut, stabIn, stabText, stabModel);
          clearButton(crushOut, crushIn, crushText, crushModel);
          clearButton(slashOut, slashIn, slashText, slashModel);
          clearButton(magicOut, magicIn, magicText, magicModel);
          magicText.color = Colors.SELECTED;
          magicModel.anim = Anims.SPIN;
        }}
      >
        <layer ref={magicOut} w="fill" h="fill">
          <StoneButtonOutFilled />
        </layer>
        <layer ref={magicIn} w="fill" h="fill" hide>
          <StoneButtonPressedFilled />
        </layer>
      </layer>
      <text
        x={66}
        y={196}
        w={106}
        h={46}
        ref={magicText}
        font={Fonts.BUTTON}
        color={Colors.UNSELECTED}
        shadow
        align="center"
        valign="middle"
        text="Magic defence"
      />
    </>
  );
}
