import { graphicSwapper } from '../lib/lib.helpers';
import {
  BODY_TEXT,
  DummyArt,
  DummyColor,
  DummyFonts,
  DummyModels,
  Layout,
  StyleLabels,
} from './warguild-dummy.constants';

export function WarguildDummy(): Component {
  return (
    <>
      {DummyModels.map((row) => (
        <model
          x={row.x}
          y={row.y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={row.model}
          pitch={row.pitch}
          yaw={row.yaw}
          zoom={row.zoom}
        />
      ))}

      <text
        x={Layout.HEADING_X}
        y={Layout.HEADING_Y}
        w={Layout.HEADING_W}
        h={Layout.HEADING_H}
        font={DummyFonts.HEADING}
        color={DummyColor.HEADING}
        align="center"
        shadow
        text="Attack Dummy Key"
      />

      <text
        x={StyleLabels.ACCURATE.x}
        y={StyleLabels.ACCURATE.y}
        w={StyleLabels.ACCURATE.w}
        h={StyleLabels.ACCURATE.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Accurate"
      />
      <text
        x={StyleLabels.SLASH.x}
        y={StyleLabels.SLASH.y}
        w={StyleLabels.SLASH.w}
        h={StyleLabels.SLASH.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Slash"
      />
      <text
        x={StyleLabels.AGGRESSIVE.x}
        y={StyleLabels.AGGRESSIVE.y}
        w={StyleLabels.AGGRESSIVE.w}
        h={StyleLabels.AGGRESSIVE.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Aggressive"
      />
      <text
        x={StyleLabels.CONTROLLED.x}
        y={StyleLabels.CONTROLLED.y}
        w={StyleLabels.CONTROLLED.w}
        h={StyleLabels.CONTROLLED.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="left"
        shadow
        text="Controlled"
      />
      <text
        x={StyleLabels.CRUSH.x}
        y={StyleLabels.CRUSH.y}
        w={StyleLabels.CRUSH.w}
        h={StyleLabels.CRUSH.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Crush"
      />
      <text
        x={StyleLabels.STAB.x}
        y={StyleLabels.STAB.y}
        w={StyleLabels.STAB.w}
        h={StyleLabels.STAB.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Stab"
      />
      <text
        x={StyleLabels.DEFENSIVE.x}
        y={StyleLabels.DEFENSIVE.y}
        w={StyleLabels.DEFENSIVE.w}
        h={StyleLabels.DEFENSIVE.h}
        font={DummyFonts.LABEL}
        color={DummyColor.LABEL}
        align="right"
        shadow
        text="Defensive "
      />

      <text
        x={Layout.BODY_X}
        y={Layout.BODY_Y}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        font={DummyFonts.LABEL}
        color={DummyColor.BODY}
        align="center"
        shadow
        text={BODY_TEXT}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={DummyArt.CLOSE}
        options={['Close']}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, DummyArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, DummyArt.CLOSE);
        }}
      />
    </>
  );
}
