import { useState } from 'ts2';

import { Bars, Fade, Layout, TotemArt, TotemFonts } from './nightmare-totems.constants';
import { TotemMeter } from './totem-meter.component';

export function NightmareTotems(): Component {
  const [fade, setFade] = useState(Fade.START);
  const alpha: Int = Math.max(0, fade - Fade.STEP);
  const fading: Boolean = alpha > 0 ? true : false;

  return (
    <layer w={Layout.HUD_W} h={Layout.HUD_H}>
      <layer w={Layout.HUD_W} h={Layout.HUD_H}>
        <rect
          x="center"
          y={1}
          w={{ fill: 2 }}
          h={{ fill: 2 }}
          color={Layout.BORDER_COLOR}
          transparency={alpha}
          onTimer={fading ? () => setFade(alpha) : undefined}
        />

        <sprite
          x="center"
          y="center"
          w={{ fill: 4 }}
          h={{ fill: 4 }}
          sprite={TotemArt.BACKING}
          tiling
          transparency={alpha}
        />

        <layer x={Layout.QUADRANT_X} y={Layout.QUADRANT_TOP_Y} w={Layout.QUADRANT_W} h={Layout.QUADRANT_H}>
          <text
            x="center"
            y={Layout.LABEL_Y}
            w="fill"
            h={Layout.LABEL_H}
            hide={fading}
            text="North West"
            font={TotemFonts.LABEL}
            color={Layout.LABEL_COLOR}
            shadow
            align="center"
            valign="middle"
          />
          <TotemMeter alpha={alpha} width={Bars.START} />
        </layer>

        <layer x={{ right: Layout.QUADRANT_X }} y={Layout.QUADRANT_TOP_Y} w={Layout.QUADRANT_W} h={Layout.QUADRANT_H}>
          <text
            x="center"
            y={Layout.LABEL_Y}
            w="fill"
            h={Layout.LABEL_H}
            hide={fading}
            text="North East"
            font={TotemFonts.LABEL}
            color={Layout.LABEL_COLOR}
            shadow
            align="center"
            valign="middle"
          />
          <TotemMeter alpha={alpha} width={Bars.START} />
        </layer>

        <layer x={Layout.QUADRANT_X} y={Layout.QUADRANT_BOTTOM_Y} w={Layout.QUADRANT_W} h={Layout.QUADRANT_H}>
          <text
            x="center"
            y={Layout.LABEL_Y}
            w="fill"
            h={Layout.LABEL_H}
            hide={fading}
            text="South West"
            font={TotemFonts.LABEL}
            color={Layout.LABEL_COLOR}
            shadow
            align="center"
            valign="middle"
          />
          <TotemMeter alpha={alpha} width={Bars.START} />
        </layer>

        <layer
          x={{ right: Layout.QUADRANT_X }}
          y={Layout.QUADRANT_BOTTOM_Y}
          w={Layout.QUADRANT_W}
          h={Layout.QUADRANT_H}
        >
          <text
            x="center"
            y={Layout.LABEL_Y}
            w="fill"
            h={Layout.LABEL_H}
            hide={fading}
            text="South East"
            font={TotemFonts.LABEL}
            color={Layout.LABEL_COLOR}
            shadow
            align="center"
            valign="middle"
          />
          <TotemMeter alpha={alpha} width={Bars.START} />
        </layer>
      </layer>
    </layer>
  );
}
