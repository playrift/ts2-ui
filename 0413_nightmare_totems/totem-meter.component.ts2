import { Layout } from './nightmare-totems.constants';

export function TotemMeter({ alpha, width }: { alpha: Int; width: Int }): Component {
  return (
    <layer y={Layout.METER_Y} w="fill" h={Layout.METER_H}>
      <rect x="center" y={1} w={{ fill: 2 }} h={{ fill: 2 }} color={Layout.BORDER_COLOR} transparency={alpha} />

      <rect
        x="center"
        y="center"
        w={{ fill: 4 }}
        h={{ fill: 4 }}
        fill
        color={Layout.TRACK_COLOR}
        transparency={alpha}
      />

      <rect
        x={Layout.FILL_X}
        y="center"
        w={width}
        h={{ fill: 4 }}
        fill
        color={Layout.FILL_COLOR}
        transparency={alpha}
      />
    </layer>
  );
}
