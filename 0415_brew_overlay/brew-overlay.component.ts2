import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  BrewAnim,
  BrewBottles,
  BrewColor,
  BrewCounters,
  BrewFonts,
  BrewHiddenIngredients,
  BrewIngredients,
  BrewLeftCounters,
  BrewLeftHolders,
  BrewLeftModels,
  BrewModel,
  BrewOverlayDodge,
  Layout,
} from './brew-overlay.constants';

const contentTop = createRef('brew_overlay_content_top3');

const contentLeft = createRef('brew_overlay_content_left4');

const contentRight = createRef('brew_overlay_content_right5');

export function BrewOverlay(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentTop, BrewOverlayDodge.PLATE, Anchor.LEFT, Anchor.TOP, 0)
        }
      >
        <layer ref={contentTop} x={0} y={0} w={Layout.TOP_W} h={Layout.TOP_H}>
          <layer x="center" y={0} w={Layout.STRIP_W} h={Layout.STRIP_H}>
            {BrewIngredients.map((row) => (
              <model
                x={row.x}
                y={row.y}
                w={Layout.MODEL_W}
                h={Layout.MODEL_H}
                model={row.model}
                pitch={row.pitch}
                yaw={row.yaw}
                zoom={row.zoom}
              />
            ))}

            {BrewHiddenIngredients.map((row) => (
              <layer hide x={row.x} y={row.y} w={row.w} h={row.h}>
                <model
                  x={row.mx}
                  y={row.my}
                  w={Layout.MODEL_W}
                  h={Layout.MODEL_H}
                  model={row.model}
                  pitch={row.pitch}
                  yaw={row.yaw}
                  zoom={row.zoom}
                />
              </layer>
            ))}

            <layer x={Layout.BOTTLE_BOX_X} y={Layout.BOTTLE_BOX_Y} w={Layout.BOTTLE_BOX_W} h={Layout.BOTTLE_BOX_H}>
              <model
                x={Layout.BOTTLE_X}
                y={Layout.BOTTLE_Y}
                w={Layout.MODEL_W}
                h={Layout.MODEL_H}
                model={15696}
                pitch={Layout.BOTTLE_PITCH}
                zoom={Layout.BOTTLE_ZOOM}
              />
            </layer>

            <layer hide x={Layout.BOTTLE_BOX_X} y={Layout.BOTTLE_BOX_Y} w={Layout.BOTTLE_BOX_W} h={Layout.BOTTLE_BOX_H}>
              <model
                x={Layout.BOTTLE_X}
                y={Layout.BOTTLE_Y}
                w={Layout.MODEL_W}
                h={Layout.MODEL_H}
                model={15670}
                pitch={Layout.BOTTLE_PITCH}
                zoom={Layout.BOTTLE_ZOOM}
              />
            </layer>

            {BrewBottles.map((bottle) => (
              <layer
                hide
                x={Layout.BOTTLE_BOX_X}
                y={Layout.BOTTLE_BOX_Y}
                w={Layout.BOTTLE_BOX_W}
                h={Layout.BOTTLE_BOX_H}
              >
                <model
                  x={Layout.BOTTLE_X}
                  y={Layout.BOTTLE_Y}
                  w={Layout.MODEL_W}
                  h={Layout.MODEL_H}
                  model={bottle.model}
                  anim={BrewAnim.BOTTLE_FLASH}
                  pitch={Layout.BOTTLE_PITCH}
                  zoom={bottle.zoom}
                />
              </layer>
            ))}

            {BrewCounters.map((counter) => (
              <text
                x={counter.x}
                y={counter.y}
                w={Layout.COUNT_W}
                h={Layout.COUNT_H}
                text="0"
                font={BrewFonts.B12}
                shadow
                color={BrewColor.COUNTER}
              />
            ))}
          </layer>
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentLeft, BrewOverlayDodge.PLATE, Anchor.LEFT, Anchor.TOP, 0)
        }
      >
        <layer ref={contentLeft} x={0} y={0} w={Layout.LEFT_W} h={Layout.LEFT_H}>
          <layer x={Layout.LEFT_BOX_X} y="25.79%" w={Layout.LEFT_BOX_W} h={Layout.LEFT_BOX_H}>
            {BrewLeftModels.map((row) => (
              <model
                x={row.x}
                y={row.y}
                w={Layout.MODEL_W}
                h={Layout.MODEL_H}
                model={row.model}
                pitch={row.pitch}
                yaw={row.yaw}
                zoom={row.zoom}
              />
            ))}

            {BrewLeftCounters.map((counter) => (
              <text
                x={Layout.LEFT_COUNT_X}
                y={counter.y}
                w={Layout.COUNT_W}
                h={Layout.COUNT_H}
                text="0"
                font={BrewFonts.B12}
                shadow
                color={BrewColor.COUNTER}
              />
            ))}

            {BrewLeftHolders.map((holder) => (
              <layer hide x="center" y="center" w="fill" h="fill">
                <model
                  x={holder.x}
                  y={holder.y}
                  w={holder.w}
                  h={holder.h}
                  model={BrewModel.LEFT_HOLDER}
                  pitch={327}
                  yaw={3}
                  zoom={400}
                />
              </layer>
            ))}
          </layer>
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentRight, BrewOverlayDodge.BANNER, Anchor.RIGHT, Anchor.BOTTOM, 0)
        }
      >
        <layer
          ref={contentRight}
          x={{ right: Layout.RIGHT_X }}
          y={{ bottom: Layout.RIGHT_Y }}
          w={Layout.RIGHT_W}
          h={Layout.RIGHT_H}
        >
          <layer x="right" y="bottom" w={Layout.BANNER_W} h={Layout.BANNER_H}>
            <model
              x="center"
              y={Layout.TROPHY_Y}
              w="fill"
              h={Layout.TROPHY_H}
              model={BrewModel.TROPHY}
              pitch={Layout.TROPHY_PITCH}
              yaw={Layout.TROPHY_YAW}
              zoom={Layout.TROPHY_ZOOM}
              offsetX={Layout.TROPHY_OFFSET_X}
            />

            <text
              x="center"
              y={0}
              w={Layout.TITLE_W}
              h={Layout.TITLE_H}
              text="Current Score"
              font={BrewFonts.P12}
              shadow
              align="center"
              valign="middle"
              color={BrewColor.YELLOW}
            />

            <text
              x={Layout.SCORE_RED_X}
              y={Layout.SCORE_Y}
              w={Layout.COUNT_W}
              h={Layout.COUNT_H}
              text="0"
              font={BrewFonts.B12}
              align="center"
              color={BrewColor.RED}
            />

            <text
              x={Layout.SCORE_BLUE_X}
              y={Layout.SCORE_Y}
              w={Layout.COUNT_W}
              h={Layout.COUNT_H}
              text="0"
              font={BrewFonts.B12}
              color={BrewColor.BLUE}
            />

            <text
              x={{ center: Layout.TIMER_CENTER }}
              y={{ bottom: Layout.TIMER_BOTTOM }}
              w="fill"
              h={Layout.TIMER_H}
              text="Time Left : 20 Mins"
              font={BrewFonts.P12}
              shadow
              align="center"
              color={BrewColor.YELLOW}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
