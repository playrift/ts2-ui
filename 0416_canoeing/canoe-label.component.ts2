import { CanoeColors, CanoeFonts } from './canoeing.constants';

export const CanoeLabel = ({ label, canoe }: { label: String; canoe: String }): Component => (
  <text
    x="center"
    y="center"
    w="fill"
    h="fill"
    text={label}
    font={CanoeFonts.LABEL}
    color={CanoeColors.LABEL}
    shadow
    align="center"
    valign="middle"
    options={[`Make<col=ff9040> ${canoe}`]}
  />
);
