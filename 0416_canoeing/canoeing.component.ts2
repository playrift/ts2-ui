import { useSkill } from 'ts2';

import { closeInterface } from '../lib/lib.helpers';
import { CanoeLabel } from './canoe-label.component';
import { CanoeAnims, CanoeArt, CanoeColors, CanoeFonts, CanoeLevels, CanoeModels, Skills } from './canoeing.constants';
import { chatMessage } from '../lib/lib.engine';

export function Canoeing(): Component {
  const woodcutting = useSkill(Skills.WOODCUTTING);

  if (woodcutting < CanoeLevels.OPEN) {
    closeInterface();
    chatMessage('You must have at least level 12 woodcutting to start making canoes.');
    return null;
  }

  return (
    <layer x="center" y="center" w={512} h={334}>
      <layer w="fill" h="fill">
        <model
          x={101}
          y={298}
          w={10}
          h={14}
          model={CanoeModels.WATER}
          anim={CanoeAnims.WATER}
          zoom={466}
          pitch={465}
          yaw={1647}
        />
        <model
          x={86}
          y={61}
          w={32}
          h={32}
          model={CanoeModels.WATER}
          anim={CanoeAnims.WATER}
          zoom={400}
          pitch={189}
          yaw={1654}
        />
        <model
          x={78}
          y={175}
          w={36}
          h={24}
          model={CanoeModels.WATER}
          anim={CanoeAnims.WATER}
          zoom={400}
          pitch={306}
          yaw={1642}
        />
        <model
          x={183}
          y={-9}
          w={32}
          h={32}
          model={CanoeModels.WATER}
          anim={CanoeAnims.WATER}
          zoom={400}
          pitch={198}
          yaw={1609}
        />
        <model x={166} y={18} w={32} h={32} model={CanoeModels.SCENERY} zoom={400} pitch={468} yaw={2035} />
      </layer>

      <layer w="fill" h="fill">
        <layer w={512} h={334}>
          <model
            x={91}
            y={88}
            w={32}
            h={32}
            model={CanoeModels.WAKE}
            anim={CanoeAnims.WAKE}
            zoom={1040}
            pitch={135}
            yaw={762}
          />
          <model
            x={53}
            y={134}
            w={32}
            h={32}
            model={CanoeModels.WAKE}
            anim={CanoeAnims.WAKE}
            zoom={1424}
            pitch={195}
            yaw={786}
          />
          <model
            x={13}
            y={162}
            w={32}
            h={32}
            model={CanoeModels.WAKE}
            anim={CanoeAnims.WAKE}
            zoom={1552}
            pitch={177}
            yaw={918}
          />
          <model
            x={84}
            y={24}
            w={32}
            h={32}
            model={CanoeModels.WAKE}
            anim={CanoeAnims.WAKE}
            zoom={783}
            pitch={159}
            yaw={726}
          />
        </layer>

        <layer x={473} y={13} w={26} h={23} options={['Close']} onOptionSelect={() => closeInterface()}>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={CanoeArt.CLOSE}
            hover={{ sprite: CanoeArt.CLOSE_HOVER }}
          />
        </layer>

        <layer x={130} y={287} w={380} h={15}>
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="WHAT SORT OF CANOE WOULD YOU LIKE TO MAKE ?"
            font={CanoeFonts.QUESTION}
            color={CanoeColors.QUESTION}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer x={150} y={22} w={295} h={80}>
          <model
            x={121}
            y={43}
            w={32}
            h={32}
            anim={CanoeAnims.BOBBING}
            model={woodcutting < CanoeLevels.WAKA ? CanoeModels.WAKA_LOCKED : CanoeModels.WAKA}
            zoom={656}
            pitch={81}
            yaw={150}
          />
          {woodcutting >= CanoeLevels.WAKA && <CanoeLabel label="A Waka." canoe="Waka canoe" />}
        </layer>

        <layer x={142} y={102} w={190} h={79}>
          <model
            x={83}
            y={21}
            w={32}
            h={32}
            anim={CanoeAnims.BOBBING}
            model={
              woodcutting < CanoeLevels.STABLE_DUGOUT ? CanoeModels.STABLE_DUGOUT_LOCKED : CanoeModels.STABLE_DUGOUT
            }
            zoom={912}
            pitch={162}
            yaw={1186}
          />
          {woodcutting >= CanoeLevels.STABLE_DUGOUT && (
            <CanoeLabel label="A Stable Dugout" canoe="Stable dugout canoe" />
          )}
        </layer>

        <layer x={96} y={158} w={122} h={121}>
          <model
            x={40}
            y={42}
            w={27}
            h={26}
            anim={CanoeAnims.BOBBING}
            model={woodcutting < CanoeLevels.DUGOUT ? CanoeModels.DUGOUT_LOCKED : CanoeModels.DUGOUT}
            zoom={856}
            pitch={171}
            yaw={348}
          />
          {woodcutting >= CanoeLevels.DUGOUT && <CanoeLabel label="A Dugout." canoe="Dugout canoe" />}
        </layer>

        <layer x={28} y={177} w={91} h={151}>
          <model
            x={27}
            y={46}
            w={29}
            h={27}
            model={CanoeModels.LOG}
            anim={CanoeAnims.BOBBING}
            zoom={1040}
            pitch={180}
            yaw={459}
          />
          <CanoeLabel label="A Log." canoe="Log canoe" />
        </layer>
      </layer>
    </layer>
  );
}
