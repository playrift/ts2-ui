import { BrewToolButton } from './brew-tool-button.component';
import { CloseButton } from './close-button.component';
import { BREW_TOOLS } from './brew-tools.data';

export function BrewTools(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={32}
        h={32}
        model={15707}
        zoom={465}
        pitch={512}
        yaw={4}
        offsetX={4}
        offsetY={-1}
      />
      <model x="center" y="center" w={32} h={32} model={15716} zoom={400} pitch={512} />

      {BREW_TOOLS.map((tool) => (
        <BrewToolButton
          label={tool.label}
          dx={tool.dx}
          dy={tool.dy}
          height={tool.height}
          take5={tool.take5}
          model={tool.model}
          modelH={tool.modelH}
          zoom={tool.zoom}
          pitch={tool.pitch}
          yaw={tool.yaw}
          offsetX={tool.offsetX}
          offsetY={tool.offsetY}
          counts={tool.counts}
        />
      ))}

      <CloseButton />
    </>
  );
}
