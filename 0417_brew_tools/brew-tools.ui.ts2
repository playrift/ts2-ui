import { createRef } from 'ts2';
import { BrewTools } from './brew-tools.component';
import { Panel } from './brew-tools.constants';

const brewToolsRef = createRef('brew_tools');

export const brewToolsUi = (): UI => (
  <ui ref={brewToolsRef} w={Panel.WIDTH} h={Panel.HEIGHT} x="center" y="center">
    <BrewTools />
  </ui>
);
