import { useRef } from 'ts2';
import { closeInterface, onMobile } from '../lib/lib.helpers';
import { BrewToolsSprites } from './brew-tools.constants';

export function CloseButton(): Component {
  const closeButton = useRef();

  return (
    <sprite
      ref={closeButton}
      x={{ right: 7 }}
      y={7}
      w={26}
      h={23}
      sprite={BrewToolsSprites.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={() => {
        if (!onMobile()) {
          closeButton.sprite = BrewToolsSprites.CLOSE_HOVER;
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          closeButton.sprite = BrewToolsSprites.CLOSE;
        }
      }}
    />
  );
}
