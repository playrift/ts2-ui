import { closeInterface, onMobile } from '../lib/lib.helpers';
import { BrewToolsSprites } from './brew-tools.constants';

export function CloseButton(): Component {
  return (
    <sprite
      x={{ right: 7 }}
      y={7}
      w={26}
      h={23}
      sprite={BrewToolsSprites.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={(event) => {
        if (!onMobile()) {
          event.self.sprite = BrewToolsSprites.CLOSE_HOVER;
        }
      }}
      onMouseLeave={(event) => {
        if (!onMobile()) {
          event.self.sprite = BrewToolsSprites.CLOSE;
        }
      }}
    />
  );
}
