import { useInventory } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import { BrewColors, BrewItems, BrewToolsFonts, BrewToolsInventories, Button } from './brew-tools.constants';

export function SupplyCounter({ item }: { item: Item }): Component {
  const worn = useInventory(BrewToolsInventories.WORN);
  const red = useInventory(BrewToolsInventories.RED_STORE);
  const blue = useInventory(BrewToolsInventories.BLUE_STORE);

  return (
    <text
      x="center"
      y="bottom"
      w={{ fill: Button.COUNTER_INSET }}
      h={Button.COUNTER_HEIGHT}
      text={supplyText(worn[0], red.total(item), blue.total(item))}
      font={BrewToolsFonts.LABEL}
      color={BrewColors.LABEL}
      shadow
      align="right"
      valign="middle"
    />
  );
}

function supplyText(hat: Item, redTotal: Int, blueTotal: Int): String {
  if (hat === BrewItems.RED_PIRATE_HAT) {
    return groupDigits(redTotal, ',');
  }
  if (hat === BrewItems.BLUE_PIRATE_HAT) {
    return groupDigits(blueTotal, ',');
  }
  return '';
}
