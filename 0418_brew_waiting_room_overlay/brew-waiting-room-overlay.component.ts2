import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  BrewLobbyColor,
  BrewLobbyDodge,
  BrewLobbyFonts,
  BrewLobbyModel,
  Layout,
} from './brew-waiting-room-overlay.constants';

const contents = createRef('brew_waiting_room_overlay_contents1');

export function BrewWaitingRoomOverlay(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contents, BrewLobbyDodge.DODGE, Anchor.RIGHT, Anchor.BOTTOM, 0)
        }
      >
        <layer ref={contents} x="right" y={{ bottom: Layout.PLATE_BOTTOM }} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x="center"
            y={{ bottom: Layout.TROPHY_BOTTOM }}
            w={Layout.TROPHY_W}
            h={Layout.TROPHY_H}
            model={BrewLobbyModel.TROPHY}
            pitch={Layout.TROPHY_PITCH}
            zoom={Layout.TROPHY_ZOOM}
          />

          <text
            x={{ right: Layout.COUNT_RED_RIGHT }}
            y={{ bottom: Layout.COUNT_BOTTOM }}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            text="0"
            font={BrewLobbyFonts.B12}
            color={BrewLobbyColor.RED}
          />

          <text
            x={{ right: Layout.COUNT_BLUE_RIGHT }}
            y={{ bottom: Layout.COUNT_BOTTOM }}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            text="0"
            font={BrewLobbyFonts.B12}
            color={BrewLobbyColor.BLUE}
          />

          <text
            x={{ center: Layout.CAPTION_CENTER }}
            y={{ bottom: Layout.CAPTION_BOTTOM }}
            w={Layout.CAPTION_W}
            h={Layout.CAPTION_H}
            text="Next Game In :"
            font={BrewLobbyFonts.P12}
            shadow
            align="center"
            color={BrewLobbyColor.ORANGE}
          />

          <text
            x={{ right: Layout.WAITING_RIGHT }}
            y={{ bottom: Layout.WAITING_BOTTOM }}
            w={Layout.WAITING_W}
            h={Layout.WAITING_H}
            text="Players waiting"
            font={BrewLobbyFonts.P12}
            align="center"
          />
        </layer>
      </layer>
    </layer>
  );
}
