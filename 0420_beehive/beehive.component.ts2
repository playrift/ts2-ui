import { closeInterface, graphicSwapper, opsound } from '../lib/lib.helpers';
import { BeehiveAnims, BeehiveArt, BeehiveFonts, BeehiveModel, Layout } from './beehive.constants';

export function Beehive(): Component {
  return (
    <layer x="center" y="center" w={490} h={332}>
      <rect
        x="center"
        y="center"
        w={Layout.SHEET_W}
        h={Layout.SHEET_H}
        fill
        color={Layout.SHEET_COLOR}
        transparency={Layout.SHEET_TRANSPARENCY}
      />

      <model x="center" y="center" w={32} h={32} model={BeehiveModel.HIVE} zoom={460} pitch={512} offsetY={2} />

      <text
        x={{ center: 144 }}
        y={45}
        w={128}
        h={130}
        text="Drag the spinning beehive parts into the right slots, then select <col=ff0000>Confirm</col>.<br><br>The <col=ff0000>example</col> below may help."
        font={BeehiveFonts.BODY}
        color={Layout.TEXT_COLOR}
        shadow
        lineHeight={14}
      />

      <layer x={{ center: 181 }} y={{ center: 72 }} w={70} h={127}>
        <model x="center" y={7} w={32} h={32} model={BeehiveModel.PART_LID} zoom={900} offsetX={1} />
        <model x="center" y={49} w={32} h={32} model={BeehiveModel.PART_BODY} zoom={900} />
        <model x="center" y={60} w={32} h={32} model={BeehiveModel.PART_ENTRANCE} zoom={900} />
        <model x="center" y={87} w={32} h={32} model={BeehiveModel.PART_LEGS} zoom={900} />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="EXAMPLE"
          font={BeehiveFonts.BODY}
          color={Layout.TEXT_COLOR}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <model
        x={47}
        y={40}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <model
        x={47}
        y={85}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <model
        x={47}
        y={130}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <model
        x={47}
        y={175}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />

      <text
        x="center"
        y={38}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        text="Lid"
        font={BeehiveFonts.SLOT}
        color={Layout.TEXT_COLOR}
        shadow
        align="center"
        valign="middle"
      />
      <model
        x="center"
        y={38}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <text
        x="center"
        y={83}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        text="Body"
        font={BeehiveFonts.SLOT}
        color={Layout.TEXT_COLOR}
        shadow
        align="center"
        valign="middle"
      />
      <model
        x="center"
        y={83}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <text
        x="center"
        y={131}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        text="Entrance"
        font={BeehiveFonts.SLOT}
        color={Layout.TEXT_COLOR}
        shadow
        align="center"
        valign="middle"
      />
      <model
        x="center"
        y={131}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />
      <text
        x="center"
        y={178}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        text="Legs"
        font={BeehiveFonts.SLOT}
        color={Layout.TEXT_COLOR}
        shadow
        align="center"
        valign="middle"
      />
      <model
        x="center"
        y={178}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        zoom={Layout.SLOT_ZOOM}
        dragTarget
        interactionDepth={1}
      />

      <layer
        x="center"
        y={{ center: 97 }}
        w={135}
        h={53}
        options={['Confirm']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      >
        <text
          x="right"
          y="center"
          w={{ fill: 55 }}
          h="fill"
          text="CONFIRM"
          font={BeehiveFonts.BUTTON}
          color={Layout.TEXT_COLOR}
          shadow
          align="center"
          valign="middle"
        />

        <model x={0} y="center" w={53} h={53} model={BeehiveModel.TICK} zoom={420} pitch={517} />

        <rect
          x={3}
          y="center"
          w={Layout.FLASH_W}
          h={Layout.FLASH_H}
          hide
          fill
          color={Layout.SHEET_COLOR}
          transparency={Layout.FLASH_TRANSPARENCY}
        />
      </layer>

      <sprite
        x={{ center: 219 }}
        y={9}
        w={26}
        h={23}
        sprite={BeehiveArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, BeehiveArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, BeehiveArt.CLOSE)}
      />

      <model x={0} y={0} w={30} h={30} model={BeehiveModel.BEE} anim={BeehiveAnims.BEE_FLY} zoom={1000} pitch={513} />
      <model
        x={0}
        y="bottom"
        w={30}
        h={30}
        model={BeehiveModel.BEE}
        anim={BeehiveAnims.BEE_FLY}
        zoom={1000}
        pitch={513}
      />
    </layer>
  );
}
