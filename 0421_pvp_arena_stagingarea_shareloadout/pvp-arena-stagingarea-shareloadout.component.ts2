import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import {
  Build,
  Layout,
  ShareLoadoutColor,
  ShareLoadoutFonts,
  ShareLoadoutSprites,
  WornSlot,
} from './pvp-arena-stagingarea-shareloadout.constants';
import { loadoutStatus } from './pvp-arena-stagingarea-shareloadout.state';
import { CopyLoadoutButton, LoadoutHint, RunePouchBox, SpellbookBox } from './loadout-side.component';
import { LoadoutGrid } from './loadout-grid.component';
import { LoadoutTab } from './loadout-tab.component';
import { LoadoutWornSlot } from './loadout-worn-slot.component';

export function PvpArenaStagingareaShareloadout(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="" />

      <text
        x="center"
        y={Layout.title.y}
        w={{ fill: Layout.title.inset }}
        h={Layout.title.h}
        text=""
        font={ShareLoadoutFonts.TITLE}
        color={ShareLoadoutColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      <layer
        x="center"
        y={{ bottom: Layout.body.bottom }}
        w={{ fill: Layout.body.inset }}
        h={{ fill: Layout.body.drop }}
      >
        <layer x="center" y={0} w={{ fill: Layout.tabs.inset }} h={Layout.tabs.h}>
          <layer x={0} y="center" w={Layout.tabs.w} h="fill">
            <LoadoutTab index={Build.MAX_MED} />
          </layer>
          <layer x={Layout.tabs.second} y="center" w={Layout.tabs.w} h="fill">
            <LoadoutTab index={Build.ZERKER} />
          </layer>
          <layer x={Layout.tabs.third} y="center" w={Layout.tabs.w} h="fill">
            <LoadoutTab index={Build.PURE} />
          </layer>
          <rect x="center" y="bottom" w="fill" h={Layout.rule.h} fill color={ShareLoadoutColor.RULE} />
        </layer>

        <layer x="center" y="bottom" w="fill" h={{ fill: Layout.content.drop }}>
          <layer x="right" y={0} w={{ fill: Layout.spellbook.inset }} h={Layout.spellbook.h}>
            <SpellbookBox />
          </layer>

          <layer x={0} y={{ bottom: Layout.runePouch.bottom }} w={Layout.runePouch.w} h={Layout.runePouch.h}>
            <RunePouchBox />
          </layer>

          <layer x={0} y={0} w={Layout.equipment.w} h={{ fill: Layout.equipment.drop }}>
            <sprite
              x="center"
              y="center"
              w={Layout.steel.spineW}
              h={{ fill: Layout.steel.spineDrop }}
              sprite={ShareLoadoutSprites.STEEL_V}
              tiling
            />
            <sprite
              x="center"
              y={Layout.steel.beltY}
              w={{ fill: Layout.steel.beltInset }}
              h={Layout.steel.beltH}
              sprite={ShareLoadoutSprites.STEEL_H}
              tiling
            />
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.steel.collarInset }}
              h={Layout.steel.collarH}
              sprite={ShareLoadoutSprites.STEEL_H}
              tiling
            />
            <sprite
              x={Layout.steel.pillarX}
              y={{ bottom: Layout.steel.pillarBottom }}
              w={Layout.steel.pillarW}
              h={{ fill: Layout.steel.pillarDrop }}
              sprite={ShareLoadoutSprites.STEEL_V}
              tiling
            />
            <sprite
              x={{ right: Layout.steel.pillarX }}
              y={{ bottom: Layout.steel.pillarBottom }}
              w={Layout.steel.pillarW}
              h={{ fill: Layout.steel.pillarDrop }}
              sprite={ShareLoadoutSprites.STEEL_V}
              tiling
            />

            <layer x="center" y={Layout.slot.edge} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.HEAD} />
            </layer>
            <layer x={Layout.slot.ammoX} y={Layout.slot.rowY} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.CAPE} />
            </layer>
            <layer x="center" y={Layout.slot.rowY} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.AMULET} />
            </layer>
            <layer x={Layout.slot.edge} y="center" w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.WEAPON} />
            </layer>
            <layer x="center" y="center" w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.BODY} />
            </layer>
            <layer x={{ right: Layout.slot.edge }} y="center" w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.SHIELD} />
            </layer>
            <layer x="center" y={{ bottom: Layout.slot.rowY }} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.LEGS} />
            </layer>
            <layer x={Layout.slot.edge} y={{ bottom: Layout.slot.edge }} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.HANDS} />
            </layer>
            <layer x="center" y={{ bottom: Layout.slot.edge }} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.FEET} />
            </layer>
            <layer
              x={{ right: Layout.slot.edge }}
              y={{ bottom: Layout.slot.edge }}
              w={Layout.slot.size}
              h={Layout.slot.size}
            >
              <LoadoutWornSlot slot={WornSlot.RING} />
            </layer>
            <layer x={{ right: Layout.slot.ammoX }} y={Layout.slot.rowY} w={Layout.slot.size} h={Layout.slot.size}>
              <LoadoutWornSlot slot={WornSlot.AMMO} />
            </layer>

            <ThinStoneBoxEntrypoint />
          </layer>

          <layer x={Layout.grid.x} y={0} w={Layout.grid.w} h={{ fill: Layout.grid.drop }}>
            <LoadoutGrid />
          </layer>

          <layer x="right" y={Layout.hint.y} w={{ fill: Layout.hint.inset }} h={{ fill: Layout.hint.drop }}>
            <LoadoutHint />
          </layer>

          <layer
            x={{ right: Layout.copy.right }}
            y={{ bottom: Layout.copy.bottom }}
            w={{ fill: Layout.copy.inset }}
            h={Layout.copy.h}
          >
            <CopyLoadoutButton />
          </layer>

          <text
            ref={loadoutStatus}
            x="center"
            y="bottom"
            w="fill"
            h={Layout.status.h}
            text=""
            font={ShareLoadoutFonts.BODY}
            color={ShareLoadoutColor.TEXT}
            shadow
            align="center"
            valign="bottom"
          />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill" />
    </>
  );
}
