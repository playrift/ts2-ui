export function loadoutWornItem(build: Int, slot: Int): Int {
  if (build === Build.ZERKER) {
    switch (slot) {
      case 0:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_HAT);
      case 1:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_BACK);
      case 2:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_FRONT);
      case 3:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_RHAND);
      case 4:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_TORSO);
      case 5:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_LHAND);
      case 7:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_LEGS);
      case 9:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_HANDS);
      case 10:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_FEET);
      case 12:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_RING);
      case 13:
        return useServerState(Varbits.PVPA_LOADOUT_B_WORN_QUIVER);
    }
    return 0;
  }
  if (build === Build.PURE) {
    switch (slot) {
      case 0:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_HAT);
      case 1:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_BACK);
      case 2:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_FRONT);
      case 3:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_RHAND);
      case 4:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_TORSO);
      case 5:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_LHAND);
      case 7:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_LEGS);
      case 9:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_HANDS);
      case 10:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_FEET);
      case 12:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_RING);
      case 13:
        return useServerState(Varbits.PVPA_LOADOUT_C_WORN_QUIVER);
    }
    return 0;
  }
  switch (slot) {
    case 0:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_HAT);
    case 1:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_BACK);
    case 2:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_FRONT);
    case 3:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_RHAND);
    case 4:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_TORSO);
    case 5:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_LHAND);
    case 7:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_LEGS);
    case 9:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_HANDS);
    case 10:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_FEET);
    case 12:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_RING);
    case 13:
      return useServerState(Varbits.PVPA_LOADOUT_A_WORN_QUIVER);
  }
  return 0;
}

export function buildSpellbook(build: Int): Int {
  if (build === Build.ZERKER) {
    return BuildSpellbooks.at(useServerState(ShareLoadoutVarbits.LOADOUT_B_SPELLBOOK)) ?? -1;
  }
  if (build === Build.PURE) {
    return BuildSpellbooks.at(useServerState(ShareLoadoutVarbits.LOADOUT_C_SPELLBOOK)) ?? -1;
  }
  return BuildSpellbooks.at(useServerState(ShareLoadoutVarbits.LOADOUT_A_SPELLBOOK)) ?? -1;
}

export function buildRunePouch(build: Int): Int {
  if (!pvpArenaWorld()) {
    return -1;
  }
  if (build === Build.ZERKER) {
    return useServerState(ShareLoadoutVarps.LOADOUT_B_RUNE_POUCH);
  }
  if (build === Build.PURE) {
    return useServerState(ShareLoadoutVarps.LOADOUT_C_RUNE_POUCH);
  }
  return useServerState(ShareLoadoutVarps.LOADOUT_A_RUNE_POUCH);
}

function statAt(
  index: Int,
  attack: Int,
  strength: Int,
  ranged: Int,
  magic: Int,
  defence: Int,
  hitpoints: Int,
  prayer: Int,
  other: Int,
): Int {
  if (index === 1) {
    return attack;
  }
  if (index === 2) {
    return strength;
  }
  if (index === 3) {
    return ranged;
  }
  if (index === 4) {
    return magic;
  }
  if (index === 5) {
    return defence;
  }
  if (index === 6) {
    return hitpoints;
  }
  if (index === 7) {
    return prayer;
  }
  return other;
}

export function itemBlocked(
  item: Item,
  attack: Int,
  strength: Int,
  ranged: Int,
  magic: Int,
  defence: Int,
  hitpoints: Int,
  prayer: Int,
  other: Int,
): Boolean {
  let blocked: Boolean = false;

  const skill1: Skill = param(item, Params.PARAM_434);
  if (skill1 !== -1) {
    if (
      param(item, Params.PARAM_436) >
      statAt(SkillIndex.get(skill1) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill2: Skill = param(item, Params.PARAM_435);
  if (skill2 !== -1) {
    if (
      param(item, Params.PARAM_437) >
      statAt(SkillIndex.get(skill2) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill3: Skill = param(item, Params.PARAM_191);
  if (skill3 !== -1) {
    if (
      param(item, Params.PARAM_613) >
      statAt(SkillIndex.get(skill3) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill4: Skill = param(item, Params.PARAM_579);
  if (skill4 !== -1) {
    if (
      param(item, Params.PARAM_614) >
      statAt(SkillIndex.get(skill4) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill5: Skill = param(item, Params.PARAM_610);
  if (skill5 !== -1) {
    if (
      param(item, Params.PARAM_615) >
      statAt(SkillIndex.get(skill5) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill6: Skill = param(item, Params.PARAM_611);
  if (skill6 !== -1) {
    if (
      param(item, Params.PARAM_616) >
      statAt(SkillIndex.get(skill6) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }
  const skill7: Skill = param(item, Params.PARAM_612);
  if (skill7 !== -1) {
    if (
      param(item, Params.PARAM_617) >
      statAt(SkillIndex.get(skill7) ?? -1, attack, strength, ranged, magic, defence, hitpoints, prayer, other)
    ) {
      blocked = true;
    }
  }

  return blocked;
}

export function ammoUnfirable(item: Item, max3: Int, max5: Int, max6: Int, max7: Int, max8: Int): Boolean {
  if (item.loadoutIteminfo! !== Ammo.IS_AMMUNITION) {
    return false;
  }
  const kind: Int = item.loadoutAmmotype!;
  const tier: Int = item.loadoutAmmoreq!;
  if (kind === Ammo.TYPE_3) {
    if (max3 < tier) {
      return true;
    }
  } else if (kind === Ammo.TYPE_5) {
    if (max5 < tier) {
      return true;
    }
  } else if (kind === Ammo.TYPE_M6) {
    if (max6 < tier) {
      return true;
    }
  } else if (kind === Ammo.TYPE_M7) {
    if (max7 < tier) {
      return true;
    }
  } else if (kind === Ammo.TYPE_M8) {
    if (max8 < tier) {
      return true;
    }
  }
  return false;
}

export function wornSlotDrawn(slot: Int): Boolean {
  if (slot === 6 || slot === 8 || slot === 11) {
    return false;
  }
  return true;
}
