    roomCell(16) === packed ||
    roomCell(17) === packed ||
    roomCell(18) === packed ||
    roomCell(19) === packed ||
    roomCell(20) === packed ||
    roomCell(21) === packed ||
    roomCell(22) === packed ||
    roomCell(23) === packed ||
    roomCell(24) === packed ||
    roomCell(25) === packed ||
    roomCell(26) === packed ||
    roomCell(27) === packed ||
    roomCell(28) === packed ||
    roomCell(29) === packed ||
    roomCell(30) === packed ||
    roomCell(31) === packed ||
    roomCell(32) === packed ||
    roomCell(33) === packed ||
    roomCell(34) === packed ||
    roomCell(35) === packed ||
    roomCell(36) === packed ||
    roomCell(37) === packed ||
    roomCell(38) === packed
  );
}

