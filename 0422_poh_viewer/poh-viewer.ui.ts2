import { useWatch } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import {
  Layout,
  ViewerVarbits,
  anticlockwiseRef,
  cancelRef,
  clockwiseRef,
  deleteRef,
  doneRef,
  frameRef,
  gfxRef,
  hintRef,
  layerButtonsRef,
  level0Ref,
  level1Ref,
  level2Ref,
  mapRef,
  moveRef,
  nameRef,
  neighbourERef,
  neighbourNRef,
  neighbourSRef,
  neighbourWRef,
  pohViewerRef,
  previewRef,
  rotateRef,
  sideContentRef,
  room01Ref,
  room02Ref,
  room03Ref,
  room04Ref,
  room05Ref,
  room06Ref,
  room07Ref,
  room08Ref,
  room09Ref,
  room10Ref,
  room11Ref,
  room12Ref,
  room13Ref,
  room14Ref,
  room15Ref,
  room16Ref,
  room17Ref,
  room18Ref,
  room19Ref,
  room20Ref,
  room21Ref,
  room22Ref,
  room23Ref,
  room24Ref,
  room25Ref,
  room26Ref,
  room27Ref,
  room28Ref,
  room29Ref,
  room30Ref,
  room31Ref,
  room32Ref,
  room33Ref,
  room34Ref,
  room35Ref,
  room36Ref,
  room37Ref,
  room38Ref,
} from './poh-viewer.constants';
import { pohViewerFloorWatch, pohViewerPreviewFollow } from './poh-viewer.map';
import { pohViewerSideUpdate } from './poh-viewer.side';

export function PohViewer(): Component {
  useWatch(ViewerVarbits.TYPE, () => pohViewerSideUpdate(), sideContentRef);
  useWatch(ViewerVarbits.TYPE, () => pohViewerPreviewFollow(), frameRef);
  useWatch(ViewerVarbits.TYPE, () => pohViewerFloorWatch(), layerButtonsRef);
  return (
    <layer x="center" y="center" w={Layout.BOUNDARY_W} h={Layout.BOUNDARY_H}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={297} tiling />
      <layer x={0} y="center" w={Layout.MAP_W} h={Layout.MAP_W}>
        <sprite x="center" y="center" w="fill" h="fill" sprite={1040} tiling />
        <layer ref={mapRef} x="center" y="center" w="fill" h="fill">
          <layer ref={room01Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room02Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room03Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room04Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room05Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room06Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room07Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room08Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room09Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room10Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room11Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room12Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room13Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room14Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room15Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room16Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room17Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room18Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room19Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room20Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room21Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room22Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room23Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room24Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room25Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room26Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room27Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room28Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room29Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room30Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room31Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room32Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room33Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room34Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room35Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room36Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room37Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={room38Ref} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} options={['*']} hide />
          <layer ref={previewRef} x={0} y={0} w={Layout.ROOM} h={Layout.ROOM} hide />
        </layer>
      </layer>
      <layer ref={frameRef} x={{ right: 0 }} y="center" w={{ fill: Layout.FRAME_W_INSET }} h="fill">
        <SteelBorderEntrypoint title="House Viewer" />
      </layer>
      <model
        x={Layout.PORTAL_X}
        y={Layout.PORTAL_Y}
        w={Layout.PORTAL_W}
        h={Layout.PORTAL_H}
        model={Layout.PORTAL_MODEL}
        anim={Layout.PORTAL_ANIM}
        zoom={Layout.PORTAL_ZOOM}
        pitch={Layout.PORTAL_PITCH}
        yaw={Layout.PORTAL_YAW}
        offsetX={Layout.PORTAL_OFFSET_X}
        offsetY={Layout.PORTAL_OFFSET_Y}
        options={['Go to Portal']}
      />
      <layer
        ref={sideContentRef}
        x={{ right: Layout.SIDE_INSET }}
        y={{ bottom: Layout.SIDE_INSET }}
        w={{ fill: Layout.SIDE_W_INSET }}
        h={{ fill: Layout.SIDE_H_INSET }}
        onLoad={() => pohViewerSideUpdate()}
      >
        <layer ref={layerButtonsRef} x="center" y={{ bottom: 0 }} w="fill" h={Layout.LAYER_BUTTONS_H}>
          <layer ref={level0Ref} x={0} y="center" w={Layout.FLOOR_BUTTON_W} h="fill" />
          <layer ref={level1Ref} x="center" y="center" w={Layout.FLOOR_BUTTON_W} h="fill" />
          <layer ref={level2Ref} x={{ right: 0 }} y="center" w={Layout.FLOOR_BUTTON_W} h="fill" />
        </layer>
        <text
          ref={nameRef}
          x="center"
          y={0}
          w="fill"
          h={Layout.NAME_H}
          font={495}
          color={0xff981f}
          align="center"
          shadow
        />
        <layer x="center" y={Layout.GFX_Y} w={Layout.GFX_BOX} h={Layout.GFX_BOX}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={1040} tiling />
          <rect x="center" y="center" w="fill" h="fill" color={0x000000} />
          <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={0x303030} />
          <rect
            ref={neighbourNRef}
            x="center"
            y={0}
            w={Layout.DOOR_LONG}
            h={Layout.DOOR_SHORT}
            color={0x9f0000}
            fill
            transparency={255}
          />
          <rect
            ref={neighbourSRef}
            x="center"
            y="bottom"
            w={Layout.DOOR_LONG}
            h={Layout.DOOR_SHORT}
            color={0x9f0000}
            fill
            transparency={255}
          />
          <rect
            ref={neighbourERef}
            x="right"
            y="center"
            w={Layout.DOOR_SHORT}
            h={Layout.DOOR_LONG}
            color={0x9f0000}
            fill
            transparency={255}
          />
          <rect
            ref={neighbourWRef}
            x={0}
            y="center"
            w={Layout.DOOR_SHORT}
            h={Layout.DOOR_LONG}
            color={0x9f0000}
            fill
            transparency={255}
          />
          <sprite ref={gfxRef} x="center" y="center" w={Layout.GFX} h={Layout.GFX} />
        </layer>
        <text
          ref={hintRef}
          x="center"
          y={Layout.HINT_Y}
          w="fill"
          h={{ fill: Layout.HINT_H_INSET }}
          font={495}
          color={0xff981f}
          align="center"
          valign="middle"
          shadow
        />
        <layer ref={moveRef} x={0} y={Layout.ROW1_Y} w={Layout.WIDE_W} h={Layout.BUTTON_H} options={['*']} />
        <layer
          ref={rotateRef}
          x={{ right: 0 }}
          y={Layout.ROW1_Y}
          w={Layout.WIDE_W}
          h={Layout.BUTTON_H}
          options={['*']}
        />
        <layer
          ref={clockwiseRef}
          x={{ right: Layout.CW_RIGHT }}
          y={Layout.ROW2_Y}
          w={Layout.SMALL}
          h={Layout.SMALL}
          options={['*']}
        />
        <layer
          ref={anticlockwiseRef}
          x={{ right: Layout.ACW_RIGHT }}
          y={Layout.ROW2_Y}
          w={Layout.SMALL}
          h={Layout.SMALL}
          options={['*']}
        />
        <layer ref={deleteRef} x={0} y={Layout.ROW2_Y} w={Layout.WIDE_W} h={Layout.BUTTON_H} options={['*']} />
        <layer
          ref={cancelRef}
          x={0}
          y={{ bottom: Layout.BOTTOM_Y }}
          w={Layout.BOTTOM_W}
          h={Layout.BUTTON_H}
          options={['*']}
        />
        <layer
          ref={doneRef}
          x={{ right: 0 }}
          y={{ bottom: Layout.BOTTOM_Y }}
          w={Layout.BOTTOM_W}
          h={Layout.BUTTON_H}
          options={['*']}
        />
      </layer>
      <SteelFrameEntrypoint />
    </layer>
  );
}

export const pohViewerUi = (): UI => (
  <ui ref={pohViewerRef} x="center" y="center" w="fill" h="fill">
    <PohViewer />
    <layer x={0} y={0} w={1} h={1} />
  </ui>
);
