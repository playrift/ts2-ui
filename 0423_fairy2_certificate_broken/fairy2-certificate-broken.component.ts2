import {
  BROKEN_CERTIFICATE_COLOR,
  BrokenCertificateFonts,
  BrokenCertificateModel,
  BrokenCertificateSprites,
  BrokenCertificateText,
  Camera,
  Layout,
} from './fairy2-certificate-broken.constants';

export function Fairy2CertificateBroken(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={BrokenCertificateModel.CERTIFICATE}
        zoom={Camera.ZOOM}
        yaw={Camera.YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={BrokenCertificateText.TITLE}
        font={BrokenCertificateFonts.HEADING}
        color={BROKEN_CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.ISSUER_X}
        y={Layout.ISSUER_Y}
        w={Layout.ISSUER_W}
        h={Layout.ISSUER_H}
        text={BrokenCertificateText.ISSUER}
        font={BrokenCertificateFonts.HEADING}
        color={BROKEN_CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.SIGNATURE_X}
        y={Layout.SIGNATURE_Y}
        w={Layout.SIGNATURE_W}
        h={Layout.SIGNATURE_H}
        text={BrokenCertificateText.SIGNATURE}
        font={BrokenCertificateFonts.SIGNATURE}
        color={BROKEN_CERTIFICATE_COLOR}
        shadow
        align="center"
        valign="top"
        lineHeight={Layout.SIGNATURE_LINE_HEIGHT}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={BrokenCertificateSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={BrokenCertificateSprites.CLOSE_OVER}
        />
      </layer>
    </layer>
  );
}
