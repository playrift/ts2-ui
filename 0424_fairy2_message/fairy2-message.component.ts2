import {
  Camera,
  Layout,
  MESSAGE_COLOR,
  MESSAGE_TEXT,
  MessageFont,
  MessageModel,
  MessageSprites,
} from './fairy2-message.constants';

export function Fairy2Message(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.PAPER_X}
        y={Layout.PAPER_Y}
        w={Layout.PAPER_W}
        h={Layout.PAPER_H}
        model={MessageModel.PAPER}
        zoom={Camera.ZOOM}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MessageSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={MessageSprites.CLOSE_OVER}
        />
      </layer>

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        text={MESSAGE_TEXT}
        font={MessageFont.LUNAR}
        color={MESSAGE_COLOR}
        shadow
        align="center"
        valign="top"
        lineHeight={Layout.TEXT_LINE_HEIGHT}
      />
    </layer>
  );
}
