import {
  Camera,
  Layout,
  SIGN_COLOR,
  SIGN_TEXT,
  SignFont,
  SignModel,
  SignSprites,
} from './fairy2-runetemple-sign.constants';

export function Fairy2RunetempleSign(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.BOARD_X}
        y={Layout.BOARD_Y}
        w={Layout.BOARD_SIZE}
        h={Layout.BOARD_SIZE}
        model={SignModel.BOARD}
        zoom={Camera.ZOOM}
        yaw={Camera.YAW}
      />

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        text={SIGN_TEXT}
        font={SignFont.LUNAR_LARGE}
        color={SIGN_COLOR}
        shadow
        align="center"
        valign="middle"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={SignSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SignSprites.CLOSE_OVER}
        />
      </layer>
    </layer>
  );
}
