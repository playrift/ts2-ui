import {
  Layout,
  ScrollColors,
  ScrollFonts,
  ScrollModel,
  ScrollSprites,
  ScrollText,
} from './scroll-godfather.constants';

export function ScrollGodfather(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={ScrollModel.VELLUM}
        zoom={ScrollModel.ZOOM}
        pitch={ScrollModel.PITCH}
      />

      <text
        x={Layout.OATH_1_X}
        y={Layout.OATH_1_Y}
        w={Layout.OATH_1_W}
        h={Layout.OATH_1_H}
        text={ScrollText.OATH_1}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.OATH_2_X}
        y={Layout.OATH_2_Y}
        w={Layout.OATH_2_W}
        h={Layout.OATH_2_H}
        text={ScrollText.OATH_2}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.OATH_3_X}
        y={Layout.OATH_3_Y}
        w={Layout.OATH_3_W}
        h={Layout.OATH_3_H}
        text={ScrollText.OATH_3}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.BLANK_1_X}
        y={Layout.BLANK_1_Y}
        w={Layout.BLANK_W}
        h={Layout.BLANK_H}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.SIGNED_X}
        y={Layout.SIGNED_Y}
        w={Layout.SIGNED_W}
        h={Layout.SIGNED_H}
        text={ScrollText.SIGNED}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.BLANK_2_X}
        y={Layout.BLANK_2_Y}
        w={Layout.BLANK_W}
        h={Layout.BLANK_H}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.SIGNATURE_X}
        y={Layout.SIGNATURE_Y}
        w={Layout.SIGNATURE_W}
        h={Layout.SIGNATURE_H}
        text={ScrollText.SIGNATURE}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <text
        x={Layout.BLANK_3_X}
        y={Layout.BLANK_3_Y}
        w={Layout.BLANK_W}
        h={Layout.BLANK_H}
        font={ScrollFonts.BODY}
        color={ScrollColors.INK}
        align="center"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ScrollSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ScrollSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
