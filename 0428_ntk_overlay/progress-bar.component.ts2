import { useRef, useServerState } from 'ts2';
import { Colors, Varbits } from './ntk-overlay.constants';
import { progressWidth } from './ntk-overlay.helpers';
import { clientClock } from '../lib/lib.engine';

export function ProgressBar(): Component {
  const count = useServerState(Varbits.NTK_PLAYER_TIMER_COUNT);
  const anchor: Int = clientClock();
  const fill = useRef();

  return (
    <layer x={14} y={46} w={182} h={7}>
      <rect w="fill" h="fill" color={Colors.BAR_EMPTY} fill />
      <rect
        ref={fill}
        w={progressWidth(count, 0)}
        h="fill"
        color={Colors.BAR_FULL}
        fill
        onTimer={() => {
          fill.width = progressWidth(count, clientClock() - anchor);
        }}
      />
    </layer>
  );
}
