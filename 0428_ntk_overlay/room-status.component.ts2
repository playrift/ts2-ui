import { useServerState } from 'ts2';
import { Colors, Fonts, Varbits } from './ntk-overlay.constants';

export function RoomStatus(): Component {
  const room = useServerState(Varbits.NTK_ROOM_NUMBER);
  const required = useServerState(Varbits.NTK_THIEVING_REQUIRED);

  return (
    <layer x="center" y={11} w={182} h={32}>
      <text
        w="fill"
        h="fill"
        text={`Room ${room} of 8<br>Thieving level required: ${required}`}
        font={Fonts.PLAIN_12}
        color={Colors.LABEL}
        shadow
      />
    </layer>
  );
}
