import { CS2 } from 'ts2';

import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { meslayerMode2, meslayerMode3 } from '../0162_chatbox/meslayer';
import { FriendRows } from './friend-list.component';
import { SortButton } from './sort-button.component';
import {
  ADD_FRIEND,
  DEL_FRIEND,
  FriendsColor,
  FriendsFonts,
  FriendsSort,
  FriendsSprites,
  HEADER,
  Layout,
  friendsListRef,
  headerRef,
  ignoreIconRef,
  ignoreRef,
  listContainerRef,
  loadingRef,
} from './friends.constants';

export function Friends(): Component {
  return (
    <>
      <layer
        static
        ref={ignoreRef}
        x={{ right: 0 }}
        y={0}
        w={Layout.IGNORE}
        h={Layout.IGNORE}
        options={['View Ignore List']}
        onMouseEnter={() => setTransparency(ignoreIconRef, Layout.IGNORE_HOVER)}
        onMouseLeave={() => setTransparency(ignoreIconRef, 0)}
        onLoad={() => friendsInit()}
      >
        <sprite
          static
          ref={ignoreIconRef}
          x={{ right: Layout.IGNORE_ICON_X }}
          y={Layout.IGNORE_ICON_Y}
          w={Layout.IGNORE_ICON_W}
          h={Layout.IGNORE_ICON_H}
          sprite={FriendsSprites.IGNORE_ICON}
        />
      </layer>

      <text
        static
        ref={headerRef}
        x={0}
        y={Layout.HEADER_Y}
        w={{ fill: Layout.HEADER_W_INSET }}
        h={Layout.HEADER_H}
        text={HEADER}
        font={FriendsFonts.TITLE}
        color={FriendsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <layer x="center" y={Layout.BOX_Y} w={{ fill: Layout.BOX_W_INSET }} h={{ fill: Layout.BOX_H_INSET }}>
        <layer
          static
          ref={listContainerRef}
          x="center"
          y="center"
          w={{ fill: Layout.INNER_INSET }}
          h={{ fill: Layout.INNER_INSET }}
        >
          <layer x="center" y={0} w="fill" h={Layout.SORT_ROW_H}>
            <layer x={Layout.SORT_NAME_X} y="center" w={Layout.SORT_W} h={{ fill: Layout.SORT_INSET }}>
              <SortButton first={FriendsSort.NAME_ASC} second={FriendsSort.NAME_DESC} idle={FriendsSort.NAME_ASC} />
            </layer>
            <layer x={Layout.SORT_RECENT_X} y="center" w={Layout.SORT_W} h={{ fill: Layout.SORT_INSET }}>
              <SortButton
                first={FriendsSort.RECENT_ASC}
                second={FriendsSort.RECENT_DESC}
                idle={FriendsSort.RECENT_DESC}
              />
            </layer>
            <layer x={Layout.SORT_WORLD_X} y="center" w={Layout.SORT_W} h={{ fill: Layout.SORT_INSET }}>
              <SortButton first={FriendsSort.WORLD_ASC} second={FriendsSort.WORLD_DESC} idle={FriendsSort.WORLD_ASC} />
            </layer>
            <layer
              x={{ right: Layout.SORT_LEGACY_RIGHT }}
              y="center"
              w={Layout.SORT_LEGACY_W}
              h={{ fill: Layout.SORT_INSET }}
            >
              <SortButton first={FriendsSort.LEGACY} second={FriendsSort.LEGACY_REVERSED} idle={FriendsSort.LEGACY} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>

          <layer
            static
            ref={friendsListRef}
            x={Layout.LIST_X}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={{ fill: Layout.LIST_W_INSET }}
            h={{ fill: Layout.LIST_H_INSET }}
          >
            <FriendRows />
          </layer>

          <layer
            x={{ right: Layout.BAR_RIGHT }}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={Layout.BAR_W}
            h={{ fill: Layout.LIST_H_INSET }}
          >
            <ScrollbarVertical
              content={friendsListRef}
              track={FriendsSprites.TRACK}
              capTopSprite={FriendsSprites.CAP_TOP}
              thumbSprite={FriendsSprites.THUMB}
              capBottomSprite={FriendsSprites.CAP_BOTTOM}
              arrowUp={FriendsSprites.ARROW_UP}
              arrowDown={FriendsSprites.ARROW_DOWN}
            />
          </layer>
        </layer>

        <text
          static
          ref={loadingRef}
          x="center"
          y={Layout.LOADING_Y}
          w={{ fill: Layout.LOADING_W_INSET }}
          h="50%"
          font={FriendsFonts.BODY}
          color={FriendsColor.WHITE}
          align="center"
          valign="middle"
          shadow
        />

        <SteelFrameEntrypoint />
      </layer>

      <sprite
        x={Layout.BUTTON_X}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={FriendsSprites.BUTTON_PLATE}
        options={['Add Friend']}
        onOptionSelect={meslayerMode2}
      />
      <text
        x={Layout.BUTTON_X}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text={ADD_FRIEND}
        font={FriendsFonts.BUTTON}
        color={FriendsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
      <sprite
        x={{ right: Layout.BUTTON_X }}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={FriendsSprites.BUTTON_PLATE}
        options={['Delete Friend']}
        onOptionSelect={meslayerMode3}
      />
      <text
        x={{ right: Layout.BUTTON_X }}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text={DEL_FRIEND}
        font={FriendsFonts.BUTTON}
        color={FriendsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <layer w={1} h={1} />
    </>
  );
}

export function friendsInit(): void {
  if (onMobile()) {
    sizeSquare(ignoreRef, Layout.IGNORE_MOBILE);
  } else {
    sizeSquare(ignoreRef, Layout.IGNORE);
  }
  headerRef.text = `${HEADER} - World ${CS2.tostring(CS2.map_world())}`;
}

function sizeSquare(component: ComponentId, size: Int): void {
  CS2.if_size_set(size, size, 0, 0, component);
}
