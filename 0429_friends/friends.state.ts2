import { CS2, useState } from 'ts2';

import { friendsPrevioussort, friendsSort } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { FriendsSort } from './friends.constants';
import { FriendsSortPairs } from './friends.data';

export function currentSort(): Int {
  const [stored] = useState(friendsSort);
  switch (stored) {
    case FriendsSort.LEGACY:
    case FriendsSort.LEGACY_REVERSED:
    case FriendsSort.NAME_ASC:
    case FriendsSort.NAME_DESC:
    case FriendsSort.RECENT_ASC:
    case FriendsSort.RECENT_DESC:
    case FriendsSort.WORLD_ASC:
    case FriendsSort.WORLD_DESC:
      return stored;
  }
  return FriendsSort.LEGACY;
}

export function chooseSort(sort: Int): void {
  playSound(Sounds.CLICK);
  const [current, setSort] = useState(friendsSort);
  const [, setPrevious] = useState(friendsPrevioussort);
  if (sort !== (FriendsSortPairs.at(current) ?? -1)) {
    setPrevious(current);
  }
  setSort(sort);
}
