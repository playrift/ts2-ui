import { useRef } from 'ts2';

import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { sortArrowHover } from '../0094_chatchannel_setup/chatchannel-setup.state';
import { FriendsSprites, SortArrow } from './friends.constants';
import { chooseSort, currentSort } from './friends.state';

export function SortButton({ first, second, idle }: { first: Int; second: Int; idle: Int }): Component {
  const arrow = useRef();
  const sort: Int = currentSort();

  let reversed: Int = 0;
  let owned: Int = 0;
  if (sort === second) {
    reversed = 1;
    owned = 1;
  } else if (sort === first) {
    owned = 1;
  }
  const rest: Int = owned === 1 ? SortArrow.OWNED : SortArrow.IDLE;
  const lit: Int = owned === 1 ? SortArrow.OWNED_HOVER : SortArrow.IDLE_HOVER;
  const chosen: Int = reversed === 1 ? first : owned === 1 ? second : idle;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => sortArrowHover(arrow, lit)}
      onMouseLeave={() => ccSetTrans(arrow, rest)}
      onClick={() => chooseSort(chosen)}
    >
      <sprite
        ref={arrow}
        x="center"
        y="center"
        w={SortArrow.SIZE_W}
        h={SortArrow.SIZE_H}
        sprite={reversed === 1 ? FriendsSprites.SORT_ARROW_REVERSED : FriendsSprites.SORT_ARROW}
        transparency={rest}
      />
    </layer>
  );
}
