import { CS2, useInventory } from 'ts2';
import { flashFor } from '../lib/lib.components';
import { itemName, membersWorld } from '../lib/lib.engine';
import {
  BLANK_ITEM,
  Grid,
  ItemSets,
  ItemSetsColor,
  ItemSetsInv,
  MEMBERS_ITEM,
  Transparency,
} from './itemsets-side.constants';

function isItemSet(item: Item): Boolean {
  if (ItemSets.get(item) === 1) {
    return true;
  }
  if (ItemSets.get(CS2.item_uncert(item)) === 1) {
    return true;
  }
  return false;
}

function UnpackableSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={Grid.OUTLINE}
      shadowColor={ItemSetsColor.SLOT_SHADOW}
      transparency={Transparency.UNPACKABLE}
      options={['Unpack', '', '', '', '', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={(event) => {
        flashFor(event.self, Transparency.FLASH, Transparency.UNPACKABLE);
      }}
    />
  );
}

function DimmedSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={Grid.OUTLINE}
      shadowColor={ItemSetsColor.SLOT_SHADOW}
      transparency={Transparency.DIMMED}
      options={['', '', '', '', '', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
    />
  );
}

function ItemSetsBlank({ slot }: { slot: Int }): Component {
  return (
    <sprite
      hide
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={BLANK_ITEM}
      itemCount={1}
      outline={Grid.OUTLINE}
      shadowColor={ItemSetsColor.SLOT_SHADOW}
    />
  );
}

function ItemSetsSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  if (item === -1) {
    return <ItemSetsBlank slot={slot} />;
  }
  if (!isItemSet(item)) {
    return <DimmedSlot item={item} count={count} slot={slot} />;
  }
  if (!membersWorld() && CS2.item_members(item) === MEMBERS_ITEM) {
    return <DimmedSlot item={item} count={count} slot={slot} />;
  }
  return <UnpackableSlot item={item} count={count} slot={slot} />;
}

export function ItemsetsSide(): Component {
  const bag = useInventory(ItemSetsInv.INV);

  return (
    <layer w="fill" h="fill">
      {bag.map((item, slot) => (
        <ItemSetsSlot item={item} count={bag.count(slot)} slot={slot} />
      ))}
    </layer>
  );
}
