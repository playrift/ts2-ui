import { CS2, Engine, intArray, useRef, useRerenderOn, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { scaled } from '../lib/lib.engine';
import { onMobile, textDevice } from '../lib/lib.helpers';
import {
  IGNORE_LIST_LOADING,
  IgnoreColor,
  IgnoreFonts,
  IgnoreRowLayout,
  IgnoreScrollbar,
  IgnoreSort,
  Layout,
} from './ignore.constants';
import { currentSort } from './ignore.state';
import { IgnoreRow } from './ignore-row.component';
import { SortButton } from './sort-button.component';

export function IgnoreBody(): Component {
  useRerenderOn(Engine.FRIENDS);

  const list = useRef();

  const mobile: Boolean = onMobile();
  const rowHeight: Int = mobile ? scaled(8, 5, IgnoreRowLayout.HEIGHT) : IgnoreRowLayout.HEIGHT;

  const count: Int = CS2.ignore_count();
  const hasName: Int = useServerState(Varbits.HAS_DISPLAYNAME_TRANSMITTER);

  let state: Int = 0;
  let message: String = '';
  if (count <= IGNORE_LIST_LOADING) {
    state = 1;
    if (hasName === 1) {
      message = 'Loading ignore list<br>Please wait...';
    } else {
      message = 'You must set a name<br>before using this.';
    }
  } else if (count === 0) {
    state = 2;
    message = `You may ignore users by using the button below, or by ${textDevice('right-clicking', 'long pressing')} on a message from them and selecting to add them to your ignore list.`;
  }

  const sort: Int = currentSort();
  if (state === 0) {
    CS2.ignorelist_sort_reset();
    if (sort === IgnoreSort.LEGACY_REVERSED) {
      CS2.ignorelist_sort_legacy(false);
    } else if (sort === IgnoreSort.NAME_ASC) {
      CS2.ignorelist_sort_name(true);
    } else if (sort === IgnoreSort.NAME_DESC) {
      CS2.ignorelist_sort_name(false);
    }
    CS2.ignorelist_sort_apply();
  }

  const live = intArray(IgnoreRowLayout.MAX_IGNORED);
  let at: Int = 0;
  while (at < IgnoreRowLayout.MAX_IGNORED) {
    live[at] = state === 0 && at < count ? 1 : 0;
    at = at + 1;
  }

  let extent: Int = 0;
  if (state === 0 && count >= 1) {
    extent = count * rowHeight + IgnoreRowLayout.TAIL_PAD;
  }

  let containerHidden: Boolean = true;
  if (state === 0) {
    containerHidden = false;
  }

  return (
    <>
      <layer
        x="center"
        y="center"
        w={{ fill: Layout.CONTAINER_INSET }}
        h={{ fill: Layout.CONTAINER_INSET }}
        hide={containerHidden}
      >
        <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
          <layer
            x={Layout.SORT_NAME_X}
            y="center"
            w={{ fill: Layout.SORT_NAME_INSET }}
            h={{ fill: Layout.HEADER_DROP }}
          >
            <SortButton first={IgnoreSort.NAME_ASC} second={IgnoreSort.NAME_DESC} />
          </layer>
          <layer
            x={{ right: Layout.SORT_LEGACY_RIGHT }}
            y="center"
            w={Layout.SORT_LEGACY_W}
            h={{ fill: Layout.HEADER_DROP }}
          >
            <SortButton first={IgnoreSort.LEGACY} second={IgnoreSort.LEGACY_REVERSED} />
          </layer>
          <ThinBoxEntrypoint />
        </layer>

        <layer
          ref={list}
          x={Layout.LIST_X}
          y={{ bottom: Layout.LIST_BOTTOM }}
          w={{ fill: Layout.LIST_INSET }}
          h={{ fill: Layout.LIST_DROP }}
          scrollHeight={extent}
        >
          {live.map(
            (row, index) =>
              row === 1 && (
                <IgnoreRow index={index} top={index * rowHeight} rowHeight={rowHeight} mobile={mobile ? 1 : 0} />
              ),
          )}
        </layer>

        <layer
          x={{ right: Layout.BAR_RIGHT }}
          y={{ bottom: Layout.LIST_BOTTOM }}
          w={Layout.BAR_W}
          h={{ fill: Layout.LIST_DROP }}
        >
          <ScrollbarVertical
            content={list}
            track={IgnoreScrollbar.TRACK}
            capTopSprite={IgnoreScrollbar.CAP_TOP}
            thumbSprite={IgnoreScrollbar.THUMB}
            capBottomSprite={IgnoreScrollbar.CAP_BOTTOM}
            arrowUp={IgnoreScrollbar.ARROW_UP}
            arrowDown={IgnoreScrollbar.ARROW_DOWN}
          />
        </layer>
      </layer>

      <text
        x="center"
        y={Layout.LOADING_Y}
        w={{ fill: Layout.LOADING_INSET }}
        h="50%"
        text={message}
        font={IgnoreFonts.BODY}
        color={IgnoreColor.NAME}
        align="center"
        valign="middle"
        shadow
      />
    </>
  );
}
