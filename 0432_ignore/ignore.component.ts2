import { CS2, useState } from 'ts2';

import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { IgnoreColor, IgnoreFonts, IgnoreSprites, Layout } from './ignore.constants';
import { IgnoreBody } from './ignore-list.component';
import { ignoreOpen, ignoreToggleSize } from './ignore.state';
import { meslayerMode4, meslayerMode5 } from '../0162_chatbox/meslayer';

export function Ignore(): Component {
  return (
    <>
      <layer x={0} y={0} w={1} h={1} onLoad={() => ignoreOpen()} />

      <layer x={0} y={0} w="fill" h="fill">
        <FriendsToggle />
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        <IgnoreTitle />
      </layer>

      <layer x="center" y={Layout.FRAME_Y} w={{ fill: Layout.FRAME_INSET }} h={{ fill: Layout.FRAME_DROP }}>
        <IgnoreBody />
        <SteelFrameEntrypoint />
      </layer>

      <sprite
        x={Layout.BUTTON_X}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={IgnoreSprites.BUTTON}
        options={['Add Name']}
        onOptionSelect={() => meslayerMode4()}
      />
      <text
        x={Layout.BUTTON_X}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text="Add Name"
        font={IgnoreFonts.CAPTION}
        color={IgnoreColor.CAPTION}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={{ right: Layout.BUTTON_X }}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        sprite={IgnoreSprites.BUTTON}
        options={['Delete Name']}
        onOptionSelect={() => meslayerMode5()}
      />
      <text
        x={{ right: Layout.BUTTON_X }}
        y={{ bottom: 0 }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
        text="Del Name"
        font={IgnoreFonts.CAPTION}
        color={IgnoreColor.CAPTION}
        align="center"
        valign="middle"
        shadow
      />

      <layer x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} />
    </>
  );
}

function FriendsToggle(): Component {
  const [hover, setHover] = useState(0);
  const [size] = useState(ignoreToggleSize);

  return (
    <layer
      x={{ right: 0 }}
      y={0}
      w={size}
      h={size}
      options={['View Friends List']}
      onMouseEnter={() => setHover(1)}
      onMouseLeave={() => setHover(0)}
    >
      <sprite
        x={{ right: Layout.FRIENDS_ICON_RIGHT }}
        y={Layout.FRIENDS_ICON_Y}
        w={Layout.FRIENDS_ICON_W}
        h={Layout.FRIENDS_ICON_H}
        sprite={IgnoreSprites.FRIENDS_ICON}
        transparency={hover === 1 ? Layout.FRIENDS_ICON_HOVER : Layout.FRIENDS_ICON_REST}
      />
    </layer>
  );
}

function IgnoreTitle(): Component {
  return (
    <text
      x={0}
      y={Layout.TITLE_Y}
      w={{ fill: Layout.TITLE_INSET }}
      h={Layout.TITLE_H}
      text={`Ignore List - World ${stringOf(CS2.map_world())}`}
      font={IgnoreFonts.TITLE}
      color={IgnoreColor.CAPTION}
      align="center"
      valign="middle"
      shadow
    />
  );
}
