import { sessionState, useState } from 'ts2';

import { ignoreSort } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import { IgnoreSort, Layout } from './ignore.constants';

export function currentSort(): Int {
  const [stored] = useState(ignoreSort);
  switch (stored) {
    case IgnoreSort.LEGACY:
    case IgnoreSort.LEGACY_REVERSED:
    case IgnoreSort.NAME_ASC:
    case IgnoreSort.NAME_DESC:
      return stored;
  }
  return IgnoreSort.LEGACY;
}

export function chooseSort(sort: Int): void {
  playSound(Sounds.CLICK);
  const [, setSort] = useState(ignoreSort);
  setSort(sort);
}

export const ignoreToggleSize = sessionState(21);

export function ignoreOpen(): void {
  const [, setSize] = useState(ignoreToggleSize);
  setSize(onMobile() ? Layout.FRIENDS_BUTTON_MOBILE : Layout.FRIENDS_BUTTON);
}
