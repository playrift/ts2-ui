import { useState } from 'ts2';

import { tooltipHide } from '../lib/tooltip.component';
import { IgnoreSprites, Layout, SortArrow } from './ignore.constants';
import { chooseSort, currentSort } from './ignore.state';

export function SortButton({ first, second }: { first: Int; second: Int }): Component {
  const sort: Int = currentSort();
  const [hover, setHover] = useState(0);

  let reversed: Int = 0;
  let owned: Int = 0;
  if (sort === second) {
    reversed = 1;
    owned = 1;
  } else if (sort === first) {
    owned = 1;
  }

  const rest: Int = owned === 1 ? SortArrow.ACTIVE : SortArrow.IDLE;
  const lit: Int = owned === 1 ? SortArrow.ACTIVE_HOVER : SortArrow.IDLE_HOVER;

  const next: Int = sort === first ? second : first;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => setHover(1)}
      onMouseLeave={() => {
        setHover(0);
        tooltipHide();
      }}
      onClick={() => chooseSort(next)}
    >
      <sprite
        x="center"
        y="center"
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        sprite={reversed === 1 ? IgnoreSprites.SORT_REVERSED : IgnoreSprites.SORT_DEFAULT}
        transparency={hover === 1 ? lit : rest}
      />
    </layer>
  );
}
