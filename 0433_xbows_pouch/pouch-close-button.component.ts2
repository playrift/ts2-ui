import { CS2, createRef } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { CloseButton, PouchArt } from './xbows-pouch.constants';

export function PouchCloseButton(): Component {
  return (
    <sprite
      x={{ right: CloseButton.X }}
      y={CloseButton.Y}
      w={CloseButton.W}
      h={CloseButton.H}
      sprite={PouchArt.CLOSE}
      ref={closeButton}
      options={['Close']}
      onLoad={() => bindPouchEscape()}
      onOptionSelect={() => closeInterface()}
      hover={{ sprite: PouchArt.CLOSE_HOVER }}
    />
  );
}

const closeButton = createRef('xbows_pouch_close');

function bindPouchEscape(): void {
  CS2.if_op_key_set(1, ESCAPE_KEY, 0, closeButton);
}

const ESCAPE_KEY = 13;
