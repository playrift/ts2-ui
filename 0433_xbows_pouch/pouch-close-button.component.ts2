import { closeInterface } from '../lib/lib.helpers';
import { CloseButton, PouchArt } from './xbows-pouch.constants';

export function PouchCloseButton(): Component {
  return (
    <sprite
      x={{ right: CloseButton.X }}
      y={CloseButton.Y}
      w={CloseButton.W}
      h={CloseButton.H}
      sprite={PouchArt.CLOSE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      hover={{ sprite: PouchArt.CLOSE_HOVER }}
    />
  );
}
