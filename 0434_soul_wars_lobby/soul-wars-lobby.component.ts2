import { createRef, useInterval } from 'ts2';

import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, LOBBY_LABEL, LobbyFont, LobbySprite, SoulWarsLobbyDodge } from './soul-wars-lobby.constants';

const timerHost = createRef('0434_soul_wars_lobby_timer_host');

const content = createRef('soul_wars_lobby_content1');

export function SoulWarsLobby(): Component {
  useInterval(
    () => overlayRelayout(timerHost, content, SoulWarsLobbyDodge.DODGE, Anchor.LEFT, Anchor.TOP, 1),
    timerHost,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={Layout.CONTENT_X} y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={LobbySprite.BACKING}
            tiling
            transparency={Layout.BACKING_WASH}
          />

          <layer x="center" y={Layout.TOP_ROW_Y} w={{ fill: Layout.ROW_INSET }} h={Layout.ROW_H}>
            <text
              x="center"
              y={0}
              w="fill"
              h={Layout.CELL_H}
              text="Players Waiting"
              font={LobbyFont.P12}
              shadow
              align="center"
              valign="middle"
              color={LOBBY_LABEL}
            />
            <text
              x="center"
              y="bottom"
              w="fill"
              h={Layout.CELL_H}
              text="0"
              font={LobbyFont.P12}
              shadow
              align="center"
              valign="middle"
              color={LOBBY_LABEL}
            />
          </layer>

          <layer x="center" y={{ bottom: Layout.BOTTOM_ROW_Y }} w={{ fill: Layout.ROW_INSET }} h={Layout.ROW_H}>
            <text
              x="center"
              y={0}
              w="fill"
              h={Layout.CELL_H}
              text="Next Game Start"
              font={LobbyFont.P12}
              shadow
              align="center"
              valign="middle"
              color={LOBBY_LABEL}
            />
            <text
              x="center"
              y="bottom"
              w="fill"
              h={Layout.CELL_H}
              text="-"
              font={LobbyFont.P12}
              shadow
              align="center"
              valign="middle"
              color={LOBBY_LABEL}
            />
          </layer>

          <StonePanelEntrypoint divider={-1} />
        </layer>
      </layer>
    </layer>
  );
}
