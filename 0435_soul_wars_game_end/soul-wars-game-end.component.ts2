import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  GameEndArt,
  GameEndColors,
  GameEndCopy,
  GameEndFonts,
  GameRows,
  Layout,
  PersonalRows,
} from './soul-wars-game-end.constants';
import { StatRow } from './stat-row.component';

export function SoulWarsGameEnd(): Component {
  return (
    <layer x={Layout.WINDOW_X} y={Layout.WINDOW_Y} w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
      <SteelBorderEntrypoint title={GameEndCopy.TITLE} />

      <layer
        x="center"
        y={{ bottom: Layout.COLUMN_BOTTOM }}
        w={{ fill: Layout.COLUMN_INSET_W }}
        h={{ fill: Layout.COLUMN_INSET_H }}
      >
        <layer x="center" y={Layout.BANNER_Y} w={{ fill: Layout.BANNER_INSET_W }} h={Layout.BANNER_H}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={GameEndArt.BACKING}
            tiling
          />

          <text
            x="center"
            y="center"
            w={Layout.BANNER_TEXT_W}
            h={Layout.BANNER_TEXT_H}
            text={GameEndCopy.RESULT}
            font={GameEndFonts.TITLE}
            align="center"
            valign="middle"
            shadow
            color={GameEndColors.RESULT}
          />

          <ThinBoxEntrypoint />
        </layer>

        <layer x={Layout.PANE_INSET} y={{ bottom: Layout.PANE_INSET }} w={Layout.PANE_W} h={Layout.PANE_H}>
          <ThinBoxEntrypoint />

          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={GameEndArt.BACKING}
            tiling
          />

          <text
            x="center"
            y={Layout.PANE_TITLE_Y}
            w="fill"
            h={Layout.PANE_TITLE_H}
            text={GameEndCopy.PERSONAL}
            font={GameEndFonts.TITLE}
            align="center"
            valign="middle"
            shadow
            color={GameEndColors.LABEL}
          />

          <line
            x="center"
            y={{ bottom: Layout.RULE_TOP_BOTTOM }}
            w={{ fill: Layout.RULE_OUTER_INSET }}
            h={0}
            color={GameEndColors.RULE_OUTER}
            lineWidth={Layout.RULE_WIDTH}
          />
          <line
            x="center"
            y={{ bottom: Layout.RULE_MID_BOTTOM }}
            w={{ fill: Layout.RULE_INNER_INSET }}
            h={0}
            color={GameEndColors.RULE_INNER}
            lineWidth={Layout.RULE_WIDTH}
          />
          <line
            x="center"
            y={{ bottom: Layout.RULE_LOW_BOTTOM }}
            w={{ fill: Layout.RULE_OUTER_INSET }}
            h={0}
            color={GameEndColors.RULE_OUTER}
            lineWidth={Layout.RULE_WIDTH}
          />

          {PersonalRows.map((row) => (
            <layer x="center" y={{ bottom: row.bottom }} w={{ fill: Layout.ROW_INSET_W }} h={Layout.PERSONAL_ROW_H}>
              <StatRow label={row.label} wash={row.wash} />
            </layer>
          ))}
        </layer>

        <layer x={{ right: Layout.PANE_INSET }} y={{ bottom: Layout.PANE_INSET }} w={Layout.PANE_W} h={Layout.PANE_H}>
          <ThinBoxEntrypoint />

          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={GameEndArt.BACKING}
            tiling
          />

          <text
            x="center"
            y={Layout.PANE_TITLE_Y}
            w="fill"
            h={Layout.PANE_TITLE_H}
            text={GameEndCopy.GAME}
            font={GameEndFonts.TITLE}
            align="center"
            valign="middle"
            shadow
            color={GameEndColors.LABEL}
          />

          <line
            x="center"
            y={{ bottom: Layout.RULE_TOP_BOTTOM }}
            w={{ fill: Layout.RULE_OUTER_INSET }}
            h={0}
            color={GameEndColors.RULE_OUTER}
            lineWidth={Layout.RULE_WIDTH}
          />
          <line
            x="center"
            y={{ bottom: Layout.RULE_MID_BOTTOM }}
            w={{ fill: Layout.RULE_INNER_INSET }}
            h={0}
            color={GameEndColors.RULE_INNER}
            lineWidth={Layout.RULE_WIDTH}
          />
          <line
            x="center"
            y={{ bottom: Layout.RULE_LOW_BOTTOM }}
            w={{ fill: Layout.RULE_OUTER_INSET }}
            h={0}
            color={GameEndColors.RULE_OUTER}
            lineWidth={Layout.RULE_WIDTH}
          />

          {GameRows.map((row) => (
            <layer x="center" y={row.y} w={{ fill: Layout.ROW_INSET_W }} h={Layout.GAME_ROW_H}>
              <StatRow label={row.label} wash={row.wash} />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
