import { GameEndColors, GameEndCopy, GameEndFonts, Layout } from './soul-wars-game-end.constants';

export function StatRow({ label, wash }: { label: String; wash: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={GameEndColors.ROW_WASH} fill transparency={wash} />

      <text
        x={Layout.CELL_INSET}
        y={0}
        w={Layout.CELL_W}
        h="fill"
        text={label}
        font={GameEndFonts.ROW}
        align="center"
        valign="middle"
        shadow
        color={GameEndColors.LABEL}
      />

      <text
        x={{ right: Layout.CELL_INSET }}
        y={0}
        w={Layout.CELL_W}
        h="fill"
        text={GameEndCopy.EMPTY_VALUE}
        font={GameEndFonts.ROW}
        align="center"
        valign="middle"
        shadow
        color={GameEndColors.RESULT}
      />
    </layer>
  );
}
