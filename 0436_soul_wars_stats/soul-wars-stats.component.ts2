import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Camera, Layout, SoulWarsStatsArt, SoulWarsStatsFont, SoulWarsStatsModel } from './soul-wars-stats.constants';

export function SoulWarsStats(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <model
        x="center"
        y={{ center: Layout.MODEL_Y_OFFSET }}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={SoulWarsStatsModel.BACKGROUND}
        zoom={Camera.ZOOM}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={SoulWarsStatsArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapperUnlessMobile(event.component, SoulWarsStatsArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapperUnlessMobile(event.component, SoulWarsStatsArt.CLOSE);
        }}
      />

      <text
        x="center"
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={SoulWarsStatsFont.BODY}
        align="center"
        lineHeight={Layout.TEXT_LINE_HEIGHT}
      />
    </layer>
  );
}
