import { createRef, useInterval } from 'ts2';

import { modelDynamicZoom } from '../lib/lib.models';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Layout,
  SmokeCamera,
  TemporossAnims,
  TemporossColor,
  TemporossDodge,
  TemporossFonts,
  TemporossModel,
  TemporossSprites,
} from './tempoross-hud.constants';

const timerHost1 = createRef('0437_tempoross_hud_timer_host1');

const timerHost2 = createRef('0437_tempoross_hud_timer_host2');

const smoke = createRef('tempoross_hud_smoke_img');

const status = createRef('tempoross_hud_status');

export function TemporossHud(): Component {
  useInterval(
    () =>
      modelDynamicZoom(
        timerHost1,
        smoke,
        SmokeCamera.NEAR,
        SmokeCamera.FAR,
        SmokeCamera.OFFSET_X,
        SmokeCamera.OFFSET_Y,
        SmokeCamera.PITCH,
        SmokeCamera.YAW,
        SmokeCamera.ROLL,
      ),
    timerHost1,
  );
  useInterval(() => overlayRelayout(timerHost2, status, TemporossDodge.WORD, Anchor.LEFT, Anchor.TOP, 1), timerHost2);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
        <layer x={0} y={0} w="fill" h="fill" hide>
          <rect x={0} y={0} w="fill" h="fill" color={TemporossColor.FADE} fill transparency={Layout.FADE_ALPHA} />
          <model
            ref={smoke}
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={TemporossModel.SMOKE}
            anim={TemporossAnims.SMOKE}
            zoom={SmokeCamera.NEAR}
          />
        </layer>

        <layer x={0} y={0} w={Layout.DODGER_W} h={Layout.DODGER_H} ref={timerHost2}>
          <layer static ref={status} x={Layout.STATUS_X} y={Layout.STATUS_Y} w={Layout.STATUS_W} h={Layout.STATUS_H}>
            <layer x={0} y={Layout.ROW_ENERGY_Y} w={Layout.ROW_W} h={Layout.ROW_H}>
              <layer x="center" y="bottom" w="fill" h={Layout.ROW_H}>
                <rect x="center" y="center" w="fill" h="fill" color={TemporossColor.ENERGY_BACK} fill />
                <rect x={0} y={0} w="50%" h="fill" color={TemporossColor.ENERGY} fill />
                <rect x={0} y={0} w="fill" h="fill" color={TemporossColor.OUTLINE} />
                <rect
                  x={Layout.GLOSS_X}
                  y={Layout.GLOSS_Y}
                  w={Layout.GLOSS_W}
                  h={Layout.GLOSS_H}
                  color={TemporossColor.GLOSS}
                  fill
                  transparency={Layout.GLOSS_ALPHA}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
              </layer>
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                font={TemporossFonts.BAR}
                text="Energy: 50%"
                align="center"
                valign="middle"
                color={TemporossColor.OUTLINE}
              />
            </layer>

            <layer x={0} y={Layout.ROW_ESSENCE_Y} w={Layout.ROW_W} h={Layout.ROW_H}>
              <layer x="center" y="bottom" w="fill" h={Layout.ROW_H}>
                <rect
                  x="center"
                  y="center"
                  w={Layout.ROW_W}
                  h={Layout.ROW_H}
                  color={TemporossColor.ESSENCE_BACK}
                  fill
                />
                <rect x={0} y={0} w="100%" h="fill" color={TemporossColor.ESSENCE} fill />
                <rect x={0} y={0} w="fill" h="fill" color={TemporossColor.OUTLINE} />
                <rect
                  x={Layout.GLOSS_X}
                  y={Layout.GLOSS_Y}
                  w={Layout.GLOSS_W}
                  h={Layout.GLOSS_H}
                  color={TemporossColor.GLOSS}
                  fill
                  transparency={Layout.GLOSS_ALPHA}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
              </layer>
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                font={TemporossFonts.BAR}
                text="Essence: 100%"
                align="center"
                valign="middle"
                color={TemporossColor.OUTLINE}
              />
            </layer>

            <layer x={0} y={Layout.ROW_STORM_Y} w={Layout.ROW_W} h={Layout.ROW_H}>
              <layer x="center" y="bottom" w="fill" h={Layout.ROW_H}>
                <rect x="center" y="center" w="fill" h="fill" color={TemporossColor.STORM_BACK} fill />
                <rect x={0} y={0} w="0%" h="fill" color={TemporossColor.STORM} fill />
                <rect x={0} y={0} w="fill" h="fill" color={TemporossColor.OUTLINE} />
                <rect
                  x={Layout.GLOSS_X}
                  y={Layout.GLOSS_Y}
                  w={Layout.GLOSS_W}
                  h={Layout.GLOSS_H_STORM}
                  color={TemporossColor.GLOSS}
                  fill
                  transparency={Layout.GLOSS_ALPHA_STORM}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH_RIGHT}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
                <rect
                  x={Layout.NOTCH}
                  y={Layout.NOTCH_BOTTOM}
                  w={Layout.NOTCH}
                  h={Layout.NOTCH}
                  color={TemporossColor.OUTLINE}
                />
              </layer>
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                font={TemporossFonts.BAR}
                text="Storm Intensity: 0%"
                align="center"
                valign="middle"
                color={TemporossColor.OUTLINE}
              />
            </layer>

            <layer x={Layout.SHIP_X} y={Layout.SHIP_Y} w={Layout.SHIP_W} h={Layout.SHIP_H}>
              <sprite x={27} y={14} w={Layout.FIRE} h={Layout.FIRE} sprite={TemporossSprites.FIRE} hide />
              <sprite x={68} y={40} w={Layout.FIRE} h={Layout.FIRE} sprite={TemporossSprites.FIRE} hide />
              <sprite x={5} y={41} w={Layout.FIRE} h={Layout.FIRE} sprite={TemporossSprites.FIRE} hide />
              <model
                x={6}
                y={36}
                w={Layout.MAST_W}
                h={Layout.MAST_H}
                model={TemporossModel.MAST}
                zoom={Layout.MAST_ZOOM}
                pitch={Layout.MAST_PITCH}
              />
              <model
                x={22}
                y={35}
                w={Layout.MAST_W}
                h={Layout.MAST_H_MID}
                model={TemporossModel.MAST}
                zoom={Layout.MAST_ZOOM}
                pitch={Layout.MAST_PITCH}
              />
              <sprite x="center" y="center" w={Layout.HULL} h={Layout.HULL} sprite={TemporossSprites.HULL} />
              <sprite x={47} y={67} w={Layout.FIRE} h={Layout.FIRE} sprite={TemporossSprites.FIRE} hide />
              <model
                x={28}
                y={9}
                w={Layout.MAST_W}
                h={Layout.MAST_H}
                model={TemporossModel.MAST}
                zoom={Layout.MAST_ZOOM}
                pitch={Layout.MAST_PITCH}
              />
              <model
                x={28}
                y={63}
                w={Layout.MAST_W}
                h={Layout.MAST_H}
                model={TemporossModel.MAST}
                zoom={Layout.MAST_ZOOM}
                pitch={Layout.MAST_PITCH}
              />
              <model
                x="center"
                y="center"
                w={Layout.SHIP_MODEL}
                h={Layout.SHIP_MODEL}
                model={TemporossModel.SHIP}
                zoom={Layout.SHIP_ZOOM}
                pitch={Layout.SHIP_PITCH}
                yaw={Layout.SHIP_YAW}
                offsetY={Layout.SHIP_OFFSET_Y}
              />
              <line
                x={60}
                y={35}
                w={Layout.LINE_W}
                h={Layout.LINE_H}
                color={TemporossColor.MAST_LINE}
                lineWidth={Layout.LINE_WIDTH}
                hide
              />
              <line
                x={17}
                y={35}
                w={Layout.LINE_W}
                h={Layout.LINE_H}
                color={TemporossColor.MAST_LINE}
                lineWidth={Layout.LINE_WIDTH}
                hide
              />
              <line
                x={39}
                y={62}
                w={Layout.LINE_W}
                h={Layout.LINE_H}
                color={TemporossColor.MAST_LINE}
                lineWidth={Layout.LINE_WIDTH}
                hide
              />
              <line
                x={39}
                y={8}
                w={Layout.LINE_W}
                h={Layout.LINE_H}
                color={TemporossColor.MAST_LINE}
                lineWidth={Layout.LINE_WIDTH}
                hide
              />
            </layer>

            <text
              x={{ center: Layout.POINTS_X }}
              y={{ bottom: Layout.POINTS_Y }}
              w={Layout.POINTS_W}
              h={Layout.POINTS_H}
              font={TemporossFonts.POINTS}
              text="Points: 0"
              align="center"
              shadow
              color={TemporossColor.POINTS}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
