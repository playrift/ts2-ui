import { createRef } from 'ts2';

import { graphicSwapper, opsound } from '../lib/lib.helpers';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, OPSOUND_MASK, SleddingHudDodge, SleddingSprites } from './sledding-hud.constants';

const exit = createRef('sledding_hud_exit1');

export function SleddingHud(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, exit, SleddingHudDodge.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer
          ref={exit}
          x={Layout.BUTTON_X}
          y={Layout.BUTTON_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Exit', 'Quick-exit']}
        >
          <sprite
            x={0}
            y={0}
            w={Layout.RING_W}
            h={Layout.RING_H}
            sprite={SleddingSprites.RING_REST}
            onMouseEnter={(event) => graphicSwapper(event.component, SleddingSprites.RING_LIT)}
            onMouseLeave={(event) => graphicSwapper(event.component, SleddingSprites.RING_REST)}
          />

          <sprite
            x={Layout.CROSS_X}
            y={Layout.CROSS_Y}
            w={Layout.CROSS_W}
            h={Layout.CROSS_H}
            sprite={SleddingSprites.CROSS_REST}
            dragDeadZone={Layout.CROSS_DRAG_DEAD_ZONE}
            onOptionSelect={(event) => opsound(event.option, OPSOUND_MASK)}
            onMouseEnter={(event) => graphicSwapper(event.component, SleddingSprites.CROSS_LIT)}
            onMouseLeave={(event) => graphicSwapper(event.component, SleddingSprites.CROSS_REST)}
          />
        </layer>
      </layer>
    </layer>
  );
}
