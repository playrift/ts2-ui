import { BattleMapAnims, BattleMapColors, BattleMapModels, Camera, Layout } from './eyeglo-battlemap.constants';

export function EyegloBattleMap(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={BattleMapColors.BACKDROP} />

      <model
        x={Layout.COMPASS_X}
        y={Layout.COMPASS_Y}
        w={Layout.COMPASS_W}
        h={Layout.COMPASS_H}
        model={BattleMapModels.COMPASS}
        zoom={Camera.COMPASS_ZOOM}
        pitch={Camera.COMPASS_PITCH}
        yaw={Camera.COMPASS_YAW}
      />

      <model
        x={Layout.MAP_BASE_X}
        y={Layout.MAP_BASE_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BattleMapModels.MAP_BASE}
        zoom={Camera.MAP_BASE_ZOOM}
        pitch={Camera.MAP_BASE_PITCH}
        yaw={Camera.MAP_BASE_YAW}
      />

      <model
        x={Layout.MAP_ANIM_X}
        y={Layout.MAP_ANIM_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BattleMapModels.MAP_ANIM_A}
        anim={BattleMapAnims.MAP}
        zoom={Camera.MAP_ANIM_A_ZOOM}
        pitch={Camera.MAP_ANIM_A_PITCH}
        yaw={Camera.MAP_ANIM_A_YAW}
      />

      <model
        x={Layout.MAP_ANIM_X}
        y={Layout.MAP_ANIM_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BattleMapModels.MAP_ANIM_B}
        anim={BattleMapAnims.MAP}
        zoom={Camera.MAP_ANIM_B_ZOOM}
        pitch={Camera.MAP_ANIM_B_PITCH}
        yaw={Camera.MAP_ANIM_B_YAW}
      />

      <model
        x={Layout.BANNER_X}
        y={Layout.BANNER_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={BattleMapModels.BANNER}
        zoom={Camera.BANNER_ZOOM}
        pitch={Camera.BANNER_PITCH}
        yaw={Camera.BANNER_YAW}
      />
    </>
  );
}
