import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { Copy, Layout, RewardsColour, RewardsFonts, TabArt } from './soul-wars-rewards.constants';
import { soulWarsRewardsShow } from './soul-wars-rewards.state';

export function RewardTabFace({
  tab,
  label,
  x,
  shown,
  selected,
}: {
  tab: Int;
  label: String;
  x: Int;
  shown: Boolean;
  selected: Boolean;
}): Component {
  const [hot, setHot] = useState(0);
  const mobile: Boolean = onMobile();
  const subject: String = `<col=ff9040>${label}</col>`;

  if (!shown) {
    return <layer x={x} w={Layout.TAB_W} h="fill" options={[Copy.VIEW]} optionSubject={subject} />;
  }

  const hoverable: Boolean = !selected && !mobile;
  const cap: Sprite = selected ? TabArt.SELECTED_CAP : hot === 1 ? TabArt.HOVER_CAP : TabArt.REST_CAP;
  const mid: Sprite = selected ? TabArt.SELECTED_MID : hot === 1 ? TabArt.HOVER_MID : TabArt.REST_MID;

  return (
    <layer
      x={x}
      w={Layout.TAB_W}
      h="fill"
      options={[Copy.VIEW]}
      optionSubject={subject}
      onMouseRepeat={
        hoverable
          ? () => {
              setHot(1);
            }
          : undefined
      }
      onMouseLeave={
        hoverable
          ? () => {
              setHot(0);
            }
          : undefined
      }
      onOptionSelect={
        selected
          ? undefined
          : () => {
              soulWarsRewardsShow(tab);
            }
      }
    >
      <sprite x={0} y={0} w={Layout.TAB_CAP_W} h={Layout.TAB_FACE_H} sprite={cap} />
      <sprite x={Layout.TAB_CAP_W} y={0} w={{ fill: Layout.TAB_MID_INSET }} h={Layout.TAB_FACE_H} sprite={mid} tiling />
      <sprite x="right" y={0} w={Layout.TAB_CAP_W} h={Layout.TAB_FACE_H} sprite={cap} hflip />
      <text
        x="center"
        y={Layout.TAB_TEXT_Y}
        w="fill"
        h={Layout.TAB_TEXT_H}
        font={RewardsFonts.BODY}
        shadow
        align="center"
        valign="middle"
        color={selected ? RewardsColour.TAB_SELECTED : RewardsColour.ORANGE}
        text={label}
      />
    </layer>
  );
}
