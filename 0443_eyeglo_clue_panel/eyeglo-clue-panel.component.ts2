import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Camera, CluePanelArt, CluePanelModels, Layout } from './eyeglo-clue-panel.constants';

export function EyegloCluePanel(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <model
          x={Layout.BOARD_X}
          y={Layout.BOARD_Y}
          w={Layout.BOARD_W}
          h={Layout.BOARD_H}
          model={CluePanelModels.BOARD}
          zoom={Camera.BOARD_ZOOM}
          pitch={Camera.BOARD_PITCH}
          yaw={Camera.BOARD_YAW}
        />

        <model
          x={Layout.CRATES_AB_X}
          y={Layout.CRATES_AB_Y}
          w={Layout.CRATE_BOX}
          h={Layout.CRATE_BOX}
          model={CluePanelModels.CRATES_A}
          zoom={Camera.CRATES_AB_ZOOM}
          pitch={Camera.CRATES_PITCH}
          yaw={Camera.CRATES_YAW}
        />

        <model
          x={Layout.CRATES_AB_X}
          y={Layout.CRATES_AB_Y}
          w={Layout.CRATE_BOX}
          h={Layout.CRATE_BOX}
          model={CluePanelModels.CRATES_B}
          zoom={Camera.CRATES_AB_ZOOM}
          pitch={Camera.CRATES_PITCH}
          yaw={Camera.CRATES_YAW}
        />

        <sprite
          x={Layout.CLOSE_X}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CluePanelArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseRepeat={(event) => graphicSwapperUnlessMobile(event.component, CluePanelArt.CLOSE_HOVER)}
          onDrag={(event) => graphicSwapperUnlessMobile(event.component, CluePanelArt.CLOSE)}
        />

        <model
          x={Layout.CRATES_C_X}
          y={Layout.CRATES_C_Y}
          w={Layout.CRATE_BOX}
          h={Layout.CRATE_BOX}
          model={CluePanelModels.CRATES_C}
          zoom={Camera.CRATES_C_ZOOM}
          pitch={Camera.CRATES_PITCH}
          yaw={Camera.CRATES_YAW}
        />
      </layer>
    </layer>
  );
}
