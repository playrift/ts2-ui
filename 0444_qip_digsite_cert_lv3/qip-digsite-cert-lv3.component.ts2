import {
  Camera,
  CertificateColors,
  CertificateFonts,
  CertificateModels,
  CertificateSprites,
  CertificateText,
  Layout,
} from './qip-digsite-cert-lv3.constants';

export function QipDigsiteCertLv3(): Component {
  return (
    <>
      <rect
        x={0}
        y={0}
        w={Layout.DIM_W}
        h={Layout.DIM_H}
        fill
        color={CertificateColors.DIM}
        transparency={Layout.DIM_TRANSPARENCY}
      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={CertificateModels.SCROLL}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={CertificateModels.ROSETTE}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={CertificateText.TITLE}
        font={CertificateFonts.TITLE}
        color={CertificateColors.INK}
        align="center"
      />

      <text
        x={Layout.AWARD_X}
        y={Layout.AWARD_Y}
        w={Layout.AWARD_W}
        h={Layout.AWARD_H}
        text={CertificateText.AWARD}
        font={CertificateFonts.BODY}
        color={CertificateColors.INK}
        align="center"
      />

      <text
        x={Layout.NAME_X}
        y={Layout.NAME_Y}
        w={Layout.NAME_W}
        h={Layout.NAME_H}
        text={CertificateText.NAME}
        font={CertificateFonts.BODY}
        color={CertificateColors.INK}
        align="center"
      />

      <text
        x={Layout.CITATION_X}
        y={Layout.CITATION_Y}
        w={Layout.CITATION_W}
        h={Layout.CITATION_H}
        text={CertificateText.CITATION}
        font={CertificateFonts.BODY}
        color={CertificateColors.INK}
        align="center"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CertificateSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={CertificateSprites.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
