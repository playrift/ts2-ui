import { useRef } from 'ts2';

import { CloseButton } from '../0735_league-3-fragments/close-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import {
  RankingColors,
  RankingFonts,
  RankingModels,
  ScrollbarSprites as Bar,
  Sections,
} from './league-rankings.constants';
import { RankingsRows } from './rankings-list.component';

export function LeagueRankings(): Component {
  const content = useRef();
  return (
    <layer x="center" y="center" w={480} h={314}>
      <model x="center" y="center" w="fill" h="fill" model={RankingModels.BACKDROP} zoom={525} />

      <CloseButton right={50} y={5} />

      <layer x="center" y={72} w={{ fill: 150 }} h={{ fill: 110 }}>
        <layer x="center" y={4} w={{ fill: 4 }} h={24}>
          <text
            x="center"
            y={1}
            w="fill"
            h="fill"
            align="center"
            valign="middle"
            shadow
            color={RankingColors.TEXT}
            font={RankingFonts.TITLE}
            text="League Top 100 Rankings"
          />
        </layer>

        <layer x="center" y={32} w={{ fill: 4 }} h={{ fill: 36 }}>
          <layer ref={content} x={2} y={2} w={{ fill: 20 }} h={{ fill: 4 }} scrollHeight={Sections.TOTAL}>
            <RankingsRows />
          </layer>

          <layer right={2} y={2} w={16} h={{ fill: 4 }}>
            <ScrollbarVertical
              content={content}
              track={Bar.TRACK}
              capTopSprite={Bar.CAP_TOP}
              thumbSprite={Bar.THUMB}
              capBottomSprite={Bar.CAP_BOTTOM}
              arrowUp={Bar.ARROW_UP}
              arrowDown={Bar.ARROW_DOWN}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
