import { Layout, League, RankingColors, RankingFonts } from './league-rankings.constants';
import { LeagueNames } from './league-names.data';
import { RankingsDivider } from './rankings-divider.component';

export function LeagueSection({ top, league }: { top: Int; league: League }): Component {
  return (
    <>
      <RankingsDivider y={top + Layout.DIVIDER_Y} />
      <text
        x={0}
        y={top + Layout.TITLE_Y}
        w="fill"
        h={Layout.TEXT_H}
        align="center"
        valign="middle"
        shadow
        color={RankingColors.TEXT}
        font={RankingFonts.TITLE}
        text={LeagueNames.get(league) ?? ''}
      />
      <RankingsDivider y={top + Layout.DIVIDER_2_Y} />
    </>
  );
}
