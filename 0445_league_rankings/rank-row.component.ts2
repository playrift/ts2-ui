import { groupDigits } from '../lib/lib.format';
import { Layout, RankingColors, RankingFonts } from './league-rankings.constants';

export function RankRow({ y, rank, points, name }: { y: Int; rank: Int; points: Int; name: String }): Component {
  if (points === 0) {
    return null;
  }
  return (
    <>
      <text
        x={Layout.RANK_X}
        y={y}
        w={Layout.RANK_W}
        h={Layout.TEXT_H}
        align="left"
        valign="middle"
        shadow
        color={RankingColors.TEXT}
        font={RankingFonts.ROW}
        text={`Rank ${stringOf(rank)}`}
      />
      <text
        x={Layout.POINTS_X}
        y={y}
        w={Layout.POINTS_W}
        h={Layout.TEXT_H}
        align="left"
        valign="middle"
        shadow
        color={RankingColors.TEXT}
        font={RankingFonts.ROW}
        text={`${groupDigits(points, ',')} points`}
      />
      <text
        x={Layout.NAME_X}
        y={y}
        w={{ fill: Layout.NAME_X }}
        h={Layout.TEXT_H}
        align="left"
        valign="middle"
        shadow
        color={RankingColors.TEXT}
        font={RankingFonts.ROW}
        text={name}
      />
    </>
  );
}
