import { Layout, RankingColors } from './league-rankings.constants';

export function RankingsDivider({ y }: { y: Int }): Component {
  return (
    <>
      <rect x="center" y={y} w={{ fill: Layout.DIVIDER_INSET }} h={1} fill color={RankingColors.DIVIDER_LIGHT} />
      <rect x="center" y={y + 1} w={{ fill: Layout.DIVIDER_INSET }} h={1} fill color={RankingColors.DIVIDER_DARK} />
    </>
  );
}
