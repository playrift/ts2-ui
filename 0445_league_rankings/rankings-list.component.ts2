import {
  Layout,
  League,
  League1Names,
  League1Points,
  League2Names,
  League2Points,
  League3Names,
  League3Points,
  League4Names,
  League4Points,
  League5Names,
  League5Points,
  Sections,
} from './league-rankings.constants';
import { LeagueSection } from './league-section.component';
import { RankRow } from './rank-row.component';

export function RankingsRows(): Component {
  return (
    <>
      <LeagueSection top={Sections.LEAGUE_1} league={League.ONE} />
      {League1Names.map((name, index) => (
        <RankRow
          y={Sections.LEAGUE_1 + Layout.ROWS_Y + index * Layout.ROW_HEIGHT}
          rank={index + 1}
          points={League1Points.at(index) ?? 0}
          name={name}
        />
      ))}

      <LeagueSection top={Sections.LEAGUE_2} league={League.TWO} />
      {League2Names.map((name, index) => (
        <RankRow
          y={Sections.LEAGUE_2 + Layout.ROWS_Y + index * Layout.ROW_HEIGHT}
          rank={index + 1}
          points={League2Points.at(index) ?? 0}
          name={name}
        />
      ))}

      <LeagueSection top={Sections.LEAGUE_3} league={League.THREE} />
      {League3Names.map((name, index) => (
        <RankRow
          y={Sections.LEAGUE_3 + Layout.ROWS_Y + index * Layout.ROW_HEIGHT}
          rank={index + 1}
          points={League3Points.at(index) ?? 0}
          name={name}
        />
      ))}

      <LeagueSection top={Sections.LEAGUE_4} league={League.FOUR} />
      {League4Names.map((name, index) => (
        <RankRow
          y={Sections.LEAGUE_4 + Layout.ROWS_Y + index * Layout.ROW_HEIGHT}
          rank={index + 1}
          points={League4Points.at(index) ?? 0}
          name={name}
        />
      ))}

      <LeagueSection top={Sections.LEAGUE_5} league={League.FIVE} />
      {League5Names.map((name, index) => (
        <RankRow
          y={Sections.LEAGUE_5 + Layout.ROWS_Y + index * Layout.ROW_HEIGHT}
          rank={index + 1}
          points={League5Points.at(index) ?? 0}
          name={name}
        />
      ))}
    </>
  );
}
