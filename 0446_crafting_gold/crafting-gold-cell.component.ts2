import { useInterval, useRef } from 'ts2';

import { Panel } from './crafting-gold.constants';
import { craftingGoldCell } from './crafting-gold.helpers';

export function CraftingGoldCell({
  x,
  gem,
  product,
  zoom,
  pitch,
  yaw,
  index,
  blank,
  highlight,
}: {
  x: Int;
  gem: ItemName;
  product: ItemName;
  zoom: Int;
  pitch: Int;
  yaw: Int;
  index: Int;
  blank: Item;
  highlight: ComponentId;
}): Component {
  const me = useRef();
  useInterval(() => craftingGoldCell(gem, product, blank, index, highlight, me), me);

  return (
    <model
      ref={me}
      x={x}
      y={Panel.CELL_Y}
      w={Panel.CELL}
      h={Panel.CELL}
      zoom={zoom}
      pitch={pitch}
      yaw={yaw}
      options={['Make']}
    />
  );
}
