import { SkillQuantityStrip } from '../lib/skillmain-quantity.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { CraftingGoldColors, CraftingGoldFonts, Panel, Strip } from './crafting-gold.constants';
import {
  AmuletCells,
  Blanks,
  BraceletCells,
  MouldModels,
  NecklaceCells,
  RingCells,
  Sections,
} from './crafting-gold.data';
import { craftingGoldCell, craftingMouldToggle } from './crafting-gold.helpers';
import {
  amuletsHighlight,
  amuletsPrompt,
  amuletsRow,
  braceletsHighlight,
  braceletsPrompt,
  braceletsRow,
  necklacesHighlight,
  necklacesPrompt,
  necklacesRow,
  ringsHighlight,
  ringsPrompt,
  ringsRow,
} from './crafting-gold.refs';

export function CraftingGold(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="What would you like to make?" />

      <text
        x={Panel.HEADING_X}
        y={Panel.SECTION_0}
        w={Panel.HEADING_W}
        h={Panel.HEADING_H}
        font={CraftingGoldFonts.HEADING}
        color={CraftingGoldColors.HEADING}
        shadow
        text={Sections.RINGS.title}
        onTimer={() => craftingMouldToggle(Sections.RINGS.mould, ringsPrompt, ringsRow)}
      />
      <layer ref={ringsPrompt} x={Panel.ROW_X} y={Panel.SECTION_0} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <model
          x={MouldModels.RINGS.x}
          y={MouldModels.RINGS.y}
          w={MouldModels.RINGS.w}
          h={MouldModels.RINGS.h}
          model={MouldModels.RINGS.model}
          zoom={MouldModels.RINGS.zoom}
          pitch={MouldModels.RINGS.pitch}
          yaw={MouldModels.RINGS.yaw}
        />
        <text
          x={Panel.PROMPT_X}
          y={Panel.PROMPT_Y}
          w={Panel.PROMPT_W}
          h={Panel.PROMPT_H}
          font={CraftingGoldFonts.PROMPT}
          color={CraftingGoldColors.PROMPT}
          shadow
          text={Sections.RINGS.prompt}
        />
      </layer>
      <layer ref={ringsRow} x={Panel.ROW_X} y={Panel.SECTION_0} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <layer x={0} y={0} w="fill" h="fill">
          <rect
            ref={ringsHighlight}
            x={0}
            y={0}
            w={0}
            h={0}
            hide
            fill
            color={CraftingGoldColors.HIGHLIGHT}
            transparency={CraftingGoldColors.FADE}
          />
        </layer>
        {RingCells.map((cell) => (
          <model
            x={cell.x}
            y={Panel.CELL_Y}
            w={Panel.CELL}
            h={Panel.CELL}
            zoom={cell.zoom}
            pitch={cell.pitch}
            yaw={cell.yaw}
            options={['Make']}
            onTimer={(event) =>
              craftingGoldCell(cell.gem, cell.product, Blanks.RINGS, cell.index, ringsHighlight, event.component)
            }
          />
        ))}
      </layer>

      <text
        x={Panel.HEADING_X}
        y={Panel.SECTION_1}
        w={Panel.HEADING_W}
        h={Panel.HEADING_H}
        font={CraftingGoldFonts.HEADING}
        color={CraftingGoldColors.HEADING}
        shadow
        text={Sections.NECKLACES.title}
        onTimer={() => craftingMouldToggle(Sections.NECKLACES.mould, necklacesPrompt, necklacesRow)}
      />
      <layer ref={necklacesPrompt} x={Panel.ROW_X} y={Panel.SECTION_1} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <model
          x={MouldModels.NECKLACES.x}
          y={MouldModels.NECKLACES.y}
          w={MouldModels.NECKLACES.w}
          h={MouldModels.NECKLACES.h}
          model={MouldModels.NECKLACES.model}
          zoom={MouldModels.NECKLACES.zoom}
          pitch={MouldModels.NECKLACES.pitch}
          yaw={MouldModels.NECKLACES.yaw}
        />
        <text
          x={Panel.PROMPT_X}
          y={Panel.PROMPT_Y}
          w={Panel.PROMPT_W}
          h={Panel.PROMPT_H}
          font={CraftingGoldFonts.PROMPT}
          color={CraftingGoldColors.PROMPT}
          shadow
          text={Sections.NECKLACES.prompt}
        />
      </layer>
      <layer ref={necklacesRow} x={Panel.ROW_X} y={Panel.SECTION_1} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <layer x={0} y={0} w="fill" h="fill">
          <rect
            ref={necklacesHighlight}
            x={0}
            y={0}
            w={0}
            h={0}
            hide
            fill
            color={CraftingGoldColors.HIGHLIGHT}
            transparency={CraftingGoldColors.FADE}
          />
        </layer>
        {NecklaceCells.map((cell) => (
          <model
            x={cell.x}
            y={Panel.CELL_Y}
            w={Panel.CELL}
            h={Panel.CELL}
            zoom={cell.zoom}
            pitch={cell.pitch}
            yaw={cell.yaw}
            options={['Make']}
            onTimer={(event) =>
              craftingGoldCell(
                cell.gem,
                cell.product,
                Blanks.NECKLACES,
                cell.index,
                necklacesHighlight,
                event.component,
              )
            }
          />
        ))}
      </layer>

      <text
        x={Panel.HEADING_X}
        y={Panel.SECTION_2}
        w={Panel.HEADING_W}
        h={Panel.HEADING_H}
        font={CraftingGoldFonts.HEADING}
        color={CraftingGoldColors.HEADING}
        shadow
        text={Sections.AMULETS.title}
        onTimer={() => craftingMouldToggle(Sections.AMULETS.mould, amuletsPrompt, amuletsRow)}
      />
      <layer ref={amuletsPrompt} x={Panel.ROW_X} y={Panel.SECTION_2} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <model
          x={MouldModels.AMULETS.x}
          y={MouldModels.AMULETS.y}
          w={MouldModels.AMULETS.w}
          h={MouldModels.AMULETS.h}
          model={MouldModels.AMULETS.model}
          zoom={MouldModels.AMULETS.zoom}
          pitch={MouldModels.AMULETS.pitch}
          yaw={MouldModels.AMULETS.yaw}
        />
        <text
          x={Panel.PROMPT_X}
          y={Panel.PROMPT_Y}
          w={Panel.PROMPT_W}
          h={Panel.PROMPT_H}
          font={CraftingGoldFonts.PROMPT}
          color={CraftingGoldColors.PROMPT}
          shadow
          text={Sections.AMULETS.prompt}
        />
      </layer>
      <layer ref={amuletsRow} x={Panel.ROW_X} y={Panel.SECTION_2} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <layer x={0} y={0} w="fill" h="fill">
          <rect
            ref={amuletsHighlight}
            x={0}
            y={0}
            w={0}
            h={0}
            hide
            fill
            color={CraftingGoldColors.HIGHLIGHT}
            transparency={CraftingGoldColors.FADE}
          />
        </layer>
        {AmuletCells.map((cell) => (
          <model
            x={cell.x}
            y={Panel.CELL_Y}
            w={Panel.CELL}
            h={Panel.CELL}
            zoom={cell.zoom}
            pitch={cell.pitch}
            yaw={cell.yaw}
            options={['Make']}
            onTimer={(event) =>
              craftingGoldCell(cell.gem, cell.product, Blanks.AMULETS, cell.index, amuletsHighlight, event.component)
            }
          />
        ))}
      </layer>

      <text
        x={Panel.HEADING_X}
        y={Panel.SECTION_3}
        w={Panel.HEADING_W}
        h={Panel.HEADING_H}
        font={CraftingGoldFonts.HEADING}
        color={CraftingGoldColors.HEADING}
        shadow
        text={Sections.BRACELETS.title}
        onTimer={() => craftingMouldToggle(Sections.BRACELETS.mould, braceletsPrompt, braceletsRow)}
      />
      <layer ref={braceletsPrompt} x={Panel.ROW_X} y={Panel.SECTION_3} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <model
          x={MouldModels.BRACELETS.x}
          y={MouldModels.BRACELETS.y}
          w={MouldModels.BRACELETS.w}
          h={MouldModels.BRACELETS.h}
          model={MouldModels.BRACELETS.model}
          zoom={MouldModels.BRACELETS.zoom}
          pitch={MouldModels.BRACELETS.pitch}
          yaw={MouldModels.BRACELETS.yaw}
        />
        <text
          x={Panel.PROMPT_X}
          y={Panel.PROMPT_Y}
          w={Panel.PROMPT_W}
          h={Panel.PROMPT_H}
          font={CraftingGoldFonts.PROMPT}
          color={CraftingGoldColors.PROMPT}
          shadow
          text={Sections.BRACELETS.prompt}
        />
      </layer>
      <layer ref={braceletsRow} x={Panel.ROW_X} y={Panel.SECTION_3} w={Panel.ROW_W} h={Panel.ROW_H} hide>
        <layer x={0} y={0} w={Panel.ROW_W} h={Panel.ROW_H}>
          <rect
            ref={braceletsHighlight}
            x={0}
            y={0}
            w={0}
            h={0}
            hide
            fill
            color={CraftingGoldColors.HIGHLIGHT}
            transparency={CraftingGoldColors.FADE}
          />
        </layer>
        {BraceletCells.map((cell) => (
          <model
            x={cell.x}
            y={Panel.CELL_Y}
            w={Panel.CELL}
            h={Panel.CELL}
            zoom={cell.zoom}
            pitch={cell.pitch}
            yaw={cell.yaw}
            options={['Make']}
            onTimer={(event) =>
              craftingGoldCell(
                cell.gem,
                cell.product,
                Blanks.BRACELETS,
                cell.index,
                braceletsHighlight,
                event.component,
              )
            }
          />
        ))}
      </layer>

      <layer x={{ right: Strip.X }} y={Strip.Y} w={Strip.W} h={Strip.H}>
        <SkillQuantityStrip dx={Strip.DX} dy={Strip.DY} declared={Strip.MATERIAL} />
      </layer>
    </>
  );
