import { CS2, useInventory, useServerState } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { itemName, membersWorld } from '../lib/lib.engine';
import { CraftingGoldColors, CraftingGoldItems, CraftingGoldVarbits, KEY_SPACE } from './crafting-gold.constants';

const enum Mode {
  ABS = 0,
}

export function craftingMouldToggle(mould: Item, prompt: ComponentId, row: ComponentId): void {
  const inv = useInventory(Inventories.INV);
  const held: Int = inv.total(mould);
  CS2.if_hide_set(held > 0 ? false : true, row);
  CS2.if_hide_set(held > 0 ? true : false, prompt);
}

export function craftingGoldCell(
  gem: ItemName,
  product: ItemName,
  blank: Item,
  index: Int,
  highlight: ComponentId,
  cell: ComponentId,
): void {
  const inv = useInventory(Inventories.INV);

  let need: ItemName = gem;
  let make: ItemName = product;
  if (gem === CraftingGoldItems.SLAYER_GEM && inv.total(CraftingGoldItems.ETERNAL_GEM) > 0) {
    need = CraftingGoldItems.ETERNAL_GEM;
    make = CraftingGoldItems.ETERNAL_RING;
  }

  let bars: Boolean = false;
  if (
    inv.total(CraftingGoldItems.GOLD_BAR) > 0 ||
    (membersWorld() && inv.total(CraftingGoldItems.PERFECT_GOLD_BAR) > 0)
  ) {
    bars = true;
  }

  if ((need === -1 || inv.total(need as Item) > 0) && bars) {
    const last: Int = useServerState(CraftingGoldVarbits.LAST_ITEM);
    const makeOp: String = `Make <col=ff9040>${itemName(make as Item)}</col>`;
    if (last === index && last !== 0) {
      CS2.if_hide_set(false, highlight);
      CS2.if_size_set(cell.width!, cell.height!, Mode.ABS, Mode.ABS, highlight);
      CS2.if_position_set(cell.x!, cell.y!, Mode.ABS, Mode.ABS, highlight);
      cell.options = [{ label: makeOp, hotkey: KEY_SPACE }];
    } else {
      cell.options = [makeOp];
    }
    cell.props = { item: make as Item, itemCount: 1 };
    return;
  }
  cell.props = { item: blank, itemCount: 1 };
  cell.options = [];
}

export const HIGHLIGHT_COLOR = CraftingGoldColors.HIGHLIGHT;
