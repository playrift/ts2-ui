import { Layout, OverlayModel, WaterTint } from './brain-water-overlay.constants';

export function BrainWaterOverlay(): Component {
  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={WaterTint.COLOR}
        fill={true}
        transparency={WaterTint.TRANSPARENCY}
      />

      <model
        x="center"
        y="center"
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={OverlayModel.HAZE}
        anim={OverlayModel.SMOKEOVERLAY}
        zoom={Layout.MODEL_ZOOM}
      />
    </>
  );
}
