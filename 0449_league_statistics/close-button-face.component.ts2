import { graphicSwapper, onMobile } from '../lib/lib.helpers';
import { CloseArt, Layout } from './league-statistics.constants';

export function CloseButtonFace(): Component {
  const mobile: Boolean = onMobile();
  return (
    <sprite
      x="center"
      y="center"
      w={mobile ? Layout.CLOSE_MOBILE : Layout.CLOSE_W}
      h={mobile ? Layout.CLOSE_MOBILE : Layout.CLOSE_H}
      sprite={mobile ? CloseArt.MOBILE : CloseArt.REST}
      tiling
      onMouseEnter={(event) => graphicSwapper(event.component, mobile ? CloseArt.MOBILE : CloseArt.HOVER)}
      onMouseLeave={(event) => graphicSwapper(event.component, mobile ? CloseArt.MOBILE : CloseArt.REST)}
    />
  );
}
