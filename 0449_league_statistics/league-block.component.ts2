import { groupDigits } from '../lib/lib.format';
import { leaguePoints, trophyLabel } from './league-statistics.helpers';
import { Rows } from './league-statistics.constants';
import { League, LeagueRow } from './leagues.data';
import { StatDivider } from './stat-divider.component';
import { StatLine } from './stat-line.component';

export function LeagueBlock({
  row,
  league,
  top,
  width,
}: {
  row: LeagueRow;
  league: League;
  top: Int;
  width: Int;
}): Component {
  const half: Int = width / 2;
  const headingTop: Int = top + Rows.DIVIDER;
  const labelTop: Int = headingTop + Rows.LINE + Rows.DIVIDER;
  const valueTop: Int = labelTop + Rows.LINE;

  return (
    <layer w="fill" h="fill">
      <StatDivider top={top} />
      <StatLine text={row.title} top={headingTop} left={0} width={width} heading />
      <StatDivider top={headingTop + Rows.LINE} />
      <StatLine text="League Points" top={labelTop} left={0} width={half} />
      <StatLine text={groupDigits(leaguePoints(league), ',')} top={valueTop} left={0} width={half} />
      <StatLine text="Trophy" top={labelTop} left={half} width={half} />
      <StatLine text={trophyLabel(league)} top={valueTop} left={half} width={half} />
    </layer>
  );
}
