import { closeInterface } from '../lib/lib.helpers';
import { CloseButtonFace } from './close-button-face.component';
import { Layout, LEAGUE_NAME, StatColors, StatFonts, StatModel } from './league-statistics.constants';
import { StatisticsPane } from './statistics-pane.component';

export function LeagueStatistics(): Component {
  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H}>
      <model x="center" y="center" w="fill" h="fill" model={StatModel.BACKGROUND} zoom={StatModel.ZOOM} />

      <layer
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <CloseButtonFace />
      </layer>

      <layer x="center" y={Layout.CONTENT_Y} w={{ fill: Layout.CONTENT_W_INSET }} h={{ fill: Layout.CONTENT_H_INSET }}>
        <layer x="center" y={Layout.HEADER_Y} w={{ fill: Layout.HEADER_W_INSET }} h={Layout.HEADER_H}>
          <text
            x="center"
            y={1}
            w="fill"
            h="fill"
            text={`League Statistics - ${LEAGUE_NAME}`}
            font={StatFonts.HEADING}
            color={StatColors.TEXT}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer x="center" y={Layout.PANE_Y} w={{ fill: Layout.PANE_W_INSET }} h={{ fill: Layout.PANE_H_INSET }}>
          <StatisticsPane />
        </layer>
      </layer>
    </layer>
  );
}
