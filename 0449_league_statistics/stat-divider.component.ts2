import { Rows, StatColors } from './league-statistics.constants';

export function StatDivider({ top }: { top: Int }): Component {
  return (
    <>
      <rect
        x="center"
        y={top + Rows.DIVIDER_RULE}
        w={{ fill: Rows.DIVIDER_INSET }}
        h={1}
        fill
        color={StatColors.DIVIDER_LIGHT}
      />
      <rect
        x="center"
        y={top + Rows.DIVIDER_RULE + 1}
        w={{ fill: Rows.DIVIDER_INSET }}
        h={1}
        fill
        color={StatColors.DIVIDER_DARK}
      />
    </>
  );
}
