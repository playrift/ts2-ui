import { Rows, StatColors, StatFonts } from './league-statistics.constants';

export function StatLine({
  text,
  top,
  left,
  width,
  heading = false,
}: {
  text: String;
  top: Int;
  left: Int;
  width: Int;
  heading?: Boolean;
}): Component {
  return (
    <text
      x={left}
      y={top}
      w={width}
      h={Rows.LINE}
      text={text}
      font={heading ? StatFonts.HEADING : StatFonts.BODY}
      color={StatColors.TEXT}
      align="center"
      valign="middle"
      shadow
    />
  );
}
