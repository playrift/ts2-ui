import { SpiritTreeAnims, SpiritTreeLayout, SpiritTreeModel } from './eyeglo-spirit-tree.constants';

export function EyegloSpiritTree(): Component {
  return (
    <>
      <model
        x={SpiritTreeLayout.SHADOW_X}
        y={SpiritTreeLayout.SHADOW_Y}
        w={SpiritTreeLayout.BOX}
        h={SpiritTreeLayout.BOX}
        model={SpiritTreeModel.SHADOW}
        anim={SpiritTreeAnims.SHADOW}
        zoom={SpiritTreeLayout.SHADOW_ZOOM}
        pitch={SpiritTreeLayout.SHADOW_PITCH}
        yaw={SpiritTreeLayout.SHADOW_YAW}
        transparent
      />

      <model
        x={SpiritTreeLayout.OVERLAY_X}
        y={SpiritTreeLayout.OVERLAY_Y}
        w={SpiritTreeLayout.BOX}
        h={SpiritTreeLayout.BOX}
        model={SpiritTreeModel.OVERLAY}
        anim={SpiritTreeAnims.OVERLAY}
        zoom={SpiritTreeLayout.OVERLAY_ZOOM}
        pitch={SpiritTreeLayout.OVERLAY_PITCH}
        transparent
      />
    </>
  );
}
