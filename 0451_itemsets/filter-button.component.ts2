import { predictServerState, useServerState, useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { ItemsetColor, ItemsetFonts, ItemsetLayout, ItemsetText, ItemsetVarbits } from './itemsets.constants';

export function toggleCraftableFilter(): void {
  const showing: Int = useServerState(ItemsetVarbits.SHOW_ONLY_CRAFTABLE);
  predictServerState(ItemsetVarbits.SHOW_ONLY_CRAFTABLE, 1 - showing);
}

export function FilterButton(): Component {
  const craftableOnly: Int = useServerState(ItemsetVarbits.SHOW_ONLY_CRAFTABLE);
  const [pressed, setPressed] = useState(0);

  const label: String = craftableOnly === 0 ? ItemsetText.SHOW_CRAFTABLE : ItemsetText.SHOW_ALL;
  const mobile: Boolean = onMobile();

  return (
    <layer
      w="fill"
      h="fill"
      options={['Filter']}
      onOptionSelect={() => toggleCraftableFilter()}
      onMouseEnter={mobile ? undefined : () => setPressed(1)}
      onMouseLeave={mobile ? undefined : () => setPressed(0)}
    >
      {pressed === 1 ? (
        <StoneButtonPressedFilled>
          <text
            x="center"
            y="center"
            w={{ fill: ItemsetLayout.BUTTON_LABEL_W_INSET }}
            h="fill"
            text={label}
            font={ItemsetFonts.BUTTON}
            color={ItemsetColor.LABEL}
            align="center"
            valign="middle"
            shadow
          />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonFilled>
          <text
            x="center"
            y="center"
            w={{ fill: ItemsetLayout.BUTTON_LABEL_W_INSET }}
            h="fill"
            text={label}
            font={ItemsetFonts.BUTTON}
            color={ItemsetColor.LABEL}
            align="center"
            valign="middle"
            shadow
          />
        </StoneButtonFilled>
      )}
    </layer>
  );
}
