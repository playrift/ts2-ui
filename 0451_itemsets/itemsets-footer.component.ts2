import { textDevice } from '../lib/lib.helpers';
import { ItemsetColor, ItemsetFonts, ItemsetLayout } from './itemsets.constants';

export function ItemsetsFooter(): Component {
  return (
    <text
      y={ItemsetLayout.FOOTER_Y}
      w={ItemsetLayout.FOOTER_W}
      h={ItemsetLayout.FOOTER_H}
      text={`${textDevice('Click', 'Tap')} on the sets above to pack your items into the set.<br>${textDevice('Click', 'Tap')} on sets in your inventory to unpack them.`}
      font={ItemsetFonts.BODY}
      color={ItemsetColor.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}
