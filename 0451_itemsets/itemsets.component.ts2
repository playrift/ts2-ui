import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { FilterButton } from './filter-button.component';
import { ItemsetsFooter } from './itemsets-footer.component';
import { SetGrid } from './set-grid.component';
import { ItemsetLayout, ItemsetText } from './itemsets.constants';

export function Itemsets(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={ItemsetText.TITLE} />

      <SetGrid />

      <layer
        x={ItemsetLayout.BUTTON_X}
        y={ItemsetLayout.BUTTON_Y}
        w={ItemsetLayout.BUTTON_W}
        h={ItemsetLayout.BUTTON_H}
      >
        <FilterButton />
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        <ItemsetsFooter />
      </layer>
    </>
  );
}
