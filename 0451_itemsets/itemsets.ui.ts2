import { createRef } from 'ts2';
import { Itemsets } from './itemsets.component';
import { ItemsetLayout } from './itemsets.constants';
import { setMobileFullscreen } from '../lib/lib.toplevel';

const itemsetsRef = createRef('itemsets');

export const itemsetsUi = (): UI => (
  <ui
    ref={itemsetsRef}
    w={ItemsetLayout.ROOT_W}
    h={ItemsetLayout.ROOT_H}
    x={ItemsetLayout.ROOT_X}
    y={ItemsetLayout.ROOT_Y}
  >
    <Itemsets />
    <layer x={0} y={0} w={0} h={0} onLoad={() => setMobileFullscreen(1)} />
  </ui>
);
