import { flashFor } from '../lib/lib.components';
import { itemName } from '../lib/lib.engine';
import { Fade, Grid, ItemsetColor, SetMode } from './itemsets.constants';

export function SetCell({ set, mode }: { set: ItemName; mode: Int }): Component {
  return (
    <sprite
      w={Grid.ICON_W}
      h={Grid.ICON_H}
      item={set}
      itemCount={1}
      itemCountMode="never"
      outline={1}
      shadowColor={ItemsetColor.ICON_SHADOW}
      transparency={mode === SetMode.PACKABLE ? Fade.PACK_REST : Fade.CONTENTS_REST}
      optionSubject={`<col=ff9040>${itemName(set as Item)}</col>`}
      options={[
        mode === SetMode.LOCKED ? '' : mode === SetMode.PACKABLE ? 'Pack' : 'Contents',
        '',
        '',
        '',
        '',
        '',
        '',
        '',
        '',
        'Examine',
      ]}
      onOptionSelect={
        mode === SetMode.LOCKED
          ? undefined
          : (event) => {
              flashFor(
                event.self,
                mode === SetMode.PACKABLE ? Fade.PACK_FLASH : Fade.CONTENTS_FLASH,
                mode === SetMode.PACKABLE ? Fade.PACK_REST : Fade.CONTENTS_REST,
              );
            }
      }
    />
  );
}
