import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { PaintingArt, PaintingCamera, PaintingLayout, PaintingModels } from './myq3-statue-painting.constants';

export function Myq3StatuePainting(): Component {
  return (
    <>
      <layer w="fill" h="fill">
        <model
          x={PaintingLayout.FRAME.X}
          y={PaintingLayout.FRAME.Y}
          w={PaintingLayout.FRAME.SIZE}
          h={PaintingLayout.FRAME.SIZE}
          model={PaintingModels.FRAME}
          zoom={PaintingCamera.FRAME.ZOOM}
          yaw={PaintingCamera.FRAME.YAW}
          offsetY={PaintingCamera.FRAME.OFFSET_Y}
        />

        <model
          x={PaintingLayout.SUBJECT.X}
          y={PaintingLayout.SUBJECT.Y}
          w={PaintingLayout.SUBJECT.SIZE}
          h={PaintingLayout.SUBJECT.SIZE}
          model={PaintingModels.STATUE}
          zoom={PaintingCamera.SUBJECT.ZOOM}
        />

        <model
          x={PaintingLayout.SUBJECT.X}
          y={PaintingLayout.SUBJECT.Y}
          w={PaintingLayout.SUBJECT.SIZE}
          h={PaintingLayout.SUBJECT.SIZE}
          model={PaintingModels.KEY}
          zoom={PaintingCamera.SUBJECT.ZOOM}
        />
      </layer>

      <layer
        x={PaintingLayout.CLOSE_BOX.X}
        y={PaintingLayout.CLOSE_BOX.Y}
        w={PaintingLayout.CLOSE_BOX.SIZE}
        h={PaintingLayout.CLOSE_BOX.SIZE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={PaintingLayout.CLOSE_ART.X}
          y={PaintingLayout.CLOSE_ART.Y}
          w={PaintingLayout.CLOSE_ART.W}
          h={PaintingLayout.CLOSE_ART.H}
          sprite={PaintingArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, PaintingArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, PaintingArt.CLOSE);
          }}
        />
      </layer>
    </>
  );
}
