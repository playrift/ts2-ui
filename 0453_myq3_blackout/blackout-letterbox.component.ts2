import { CS2, useOnResize, useUniverse } from 'ts2';

import { BAR_OPACITY, BlackoutColor, BlackoutModel, Letterbox } from './myq3-blackout.constants';

export function BlackoutLetterbox(): Component {
  const universe = useUniverse();
  useOnResize(universe);

  const width: Int = universe.width;
  const height: Int = universe.height;

  const clamped: Int = height < Letterbox.REF_H ? Letterbox.REF_H : height > Letterbox.MAX_H ? Letterbox.MAX_H : height;

  const zoom: Int =
    BlackoutModel.ZOOM_AT_REFERENCE -
    CS2.interpolate(
      0,
      Math.sqrt(clamped - Letterbox.REF_H),
      0,
      Math.sqrt(Letterbox.MAX_H - Letterbox.REF_H),
      BlackoutModel.ZOOM_TRAVEL,
    );

  const barH: Int = (height - clamped) / 2;
  const barHHidden: Boolean = height < clamped ? true : false;

  const refW: Int = CS2.interpolate(0, Letterbox.REF_W, 0, Letterbox.REF_H, clamped);
  const barW: Int = (width - refW) / 2;
  const barWHidden: Boolean = width < refW ? true : false;

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <model
        x={0}
        y={0}
        w="fill"
        h="fill"
        model={BlackoutModel.ID}
        anim={BlackoutModel.ANIM}
        transparent
        offsetX={0}
        offsetY={0}
        pitch={BlackoutModel.PITCH}
        yaw={0}
        roll={0}
        zoom={zoom}
      />

      <rect
        x="center"
        y={0}
        w="fill"
        h={barH}
        hide={barHHidden}
        color={BlackoutColor.BAR}
        fill
        transparency={BAR_OPACITY}
      />
      <rect
        x="center"
        y="bottom"
        w="fill"
        h={barH}
        hide={barHHidden}
        color={BlackoutColor.BAR}
        fill
        transparency={BAR_OPACITY}
      />
      <rect
        x={0}
        y="center"
        w={barW}
        h="fill"
        hide={barWHidden}
        color={BlackoutColor.BAR}
        fill
        transparency={BAR_OPACITY}
      />
      <rect
        x="right"
        y="center"
        w={barW}
        h="fill"
        hide={barWHidden}
        color={BlackoutColor.BAR}
        fill
        transparency={BAR_OPACITY}
      />
    </layer>
  );
}
