import { BoatMapModel, Camera, Layout } from './myq3-boat-map.constants';

export function Myq3BoatMap(): Component {
  return (
    <layer w="fill" h="fill">
      <rect x={0} y={0} w={Layout.BACKDROP_W} h={Layout.BACKDROP_H} color={0x000000} fill={true} />

      <layer x={0} y={0} w={Layout.MAP_W} h={Layout.MAP_H}>
        <model
          x={Layout.MODEL_X}
          y={Layout.MODEL_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={BoatMapModel.SCROLL}
          zoom={Camera.ZOOM}
          pitch={Camera.PITCH}
        />
        <model
          x={Layout.MODEL_X}
          y={Layout.MODEL_Y}
          w={Layout.MODEL_SIZE}
          h={Layout.MODEL_SIZE}
          model={BoatMapModel.BOAT}
          zoom={Camera.ZOOM}
          pitch={Camera.PITCH}
        />
      </layer>
    </layer>
  );
}
