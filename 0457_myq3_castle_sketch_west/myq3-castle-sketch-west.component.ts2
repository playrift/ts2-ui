import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { SketchArt, SketchCamera, SketchLayout, SketchModels } from './myq3-castle-sketch-west.constants';

export function Myq3CastleSketchWest(): Component {
  return (
    <layer x="center" y="center" w={SketchLayout.PANEL_W} h={SketchLayout.PANEL_H}>
      <model
        x={{ center: SketchLayout.MODEL_X }}
        y={{ center: SketchLayout.MODEL_Y }}
        w={SketchLayout.MODEL_SIZE}
        h={SketchLayout.MODEL_SIZE}
        model={SketchModels.WEST}
        zoom={SketchCamera.ZOOM}
        pitch={SketchCamera.PITCH}
      />

      <layer
        x={{ right: SketchLayout.CLOSE_RIGHT }}
        y={SketchLayout.CLOSE_TOP}
        w={SketchLayout.CLOSE_BOX}
        h={SketchLayout.CLOSE_BOX}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x="center"
          y="center"
          w={SketchLayout.CLOSE_W}
          h={SketchLayout.CLOSE_H}
          sprite={SketchArt.CLOSE}
          onMouseRepeat={(event) => {
            graphicSwapperUnlessMobile(event.component, SketchArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, SketchArt.CLOSE);
          }}
        />
      </layer>
    </layer>
  );
}
