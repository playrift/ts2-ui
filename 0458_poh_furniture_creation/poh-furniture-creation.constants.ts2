export function rowComponent(slot: Int): ComponentId {
  switch (slot) {
    case 1:
      return row01Ref;
    case 2:
      return row02Ref;
    case 3:
      return row03Ref;
    case 4:
      return row04Ref;
    case 5:
      return row05Ref;
    case 6:
      return row06Ref;
    case 7:
      return row07Ref;
    case 8:
      return row08Ref;
    case 9:
      return row09Ref;
    case 10:
      return row10Ref;
    case 11:
      return row11Ref;
    case 12:
      return row12Ref;
    case 13:
      return row13Ref;
    case 14:
      return row14Ref;
    case 15:
      return row15Ref;
    case 16:
      return row16Ref;
    case 17:
      return row17Ref;
    case 18:
      return row18Ref;
    case 19:
      return row19Ref;
    case 20:
      return row20Ref;
    case 21:
      return row21Ref;
    case 22:
      return row22Ref;
    case 23:
      return row23Ref;
    case 24:
      return row24Ref;
    case 25:
      return row25Ref;
    case 26:
      return row26Ref;
    case 27:
      return row27Ref;
    case 28:
      return row28Ref;
    case 29:
      return row29Ref;
    case 30:
      return row30Ref;
    case 31:
      return row31Ref;
  }
  return -1;
}
