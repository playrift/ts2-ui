import { useServerState } from 'ts2';

import { Layout, SlugAnims, SlugModels, SlugVarbits, SlugVarps } from './slug2-ressembling-torn-paper.constants';

export function pageAnimation(rot: Int, flipped: Int): Animation {
  if (rot === 1) {
    return flipped === 1 ? SlugAnims.NORTH : SlugAnims.NORTH_FLIPPED;
  }
  if (rot === 2) {
    return flipped === 1 ? SlugAnims.EAST : SlugAnims.EAST_FLIPPED;
  }
  if (rot === 3) {
    return flipped === 1 ? SlugAnims.SOUTH : SlugAnims.SOUTH_FLIPPED;
  }
  return flipped === 1 ? SlugAnims.WEST : SlugAnims.WEST_FLIPPED;
}

export function PageOne(): Component {
  const show: Int = useServerState(SlugVarbits.PIECE1_SHOW);
  const x: Int = useServerState(SlugVarps.FRAG1_XPOS);
  const y: Int = useServerState(SlugVarps.FRAG1_YPOS);
  const rot: Int = useServerState(SlugVarps.FRAG1_ROT);
  const flipped: Int = useServerState(SlugVarps.FRAG1_ZPOS);
  return (
    <layer x={x} y={y} w={Layout.STAGE_W} h={Layout.STAGE_H} hide={show === 1 ? false : true}>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={SlugModels.PAGE_ONE}
        anim={pageAnimation(rot, flipped)}
        zoom={Layout.MODEL_ZOOM}
        pitch={Layout.MODEL_PITCH}
      />
    </layer>
  );
}

