import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { BorderOne, BorderThree, BorderTwo, PageOne, PageThree, PageTwo } from './fragment-layers.component';
import {
  CAPTION_TEXT,
  Layout,
  SlugColors,
  SlugFonts,
  SlugModels,
  SlugSprites,
} from './slug2-ressembling-torn-paper.constants';

export function Slug2RessemblingTornPaper(): Component {
  return (
    <>
      <rect w="fill" h="fill" fill color={SlugColors.WASH} transparency={Layout.WASH_OPACITY} />

      <layer w="fill" h="fill">
        <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H} hide>
          <model
            x={Layout.SPARE_X}
            y={Layout.SPARE_Y}
            w={Layout.MODEL_SIZE}
            h={Layout.MODEL_SIZE}
            model={SlugModels.SPARE}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
          />
        </layer>

        <PageOne />
        <PageTwo />
        <PageThree />

        <BorderOne />
        <BorderTwo />
        <BorderThree />

        <layer x={0} y={Layout.CAPTION_STRIP_Y} w={Layout.STAGE_W} h={Layout.CAPTION_STRIP_H} hide>
          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_Y}
            w={Layout.CAPTION_W}
            h={Layout.CAPTION_H}
            text={CAPTION_TEXT}
            font={SlugFonts.CAPTION}
            color={SlugColors.CAPTION}
            align="center"
            shadow
          />
        </layer>
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={SlugSprites.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, SlugSprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, SlugSprites.CLOSE)}
      />
    </>
  );
}
