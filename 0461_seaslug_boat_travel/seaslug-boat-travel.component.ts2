import {
  BACKDROP_TRANSPARENCY,
  FerryAnimations,
  FerryCamera,
  FerryColor,
  FerryFonts,
  FerryModel,
  Layout,
  PlaceName,
} from './seaslug-boat-travel.constants';

export function SeaslugBoatTravel(): Component {
  return (
    <>
      <rect
        x={0}
        y={0}
        w={Layout.BACKDROP_W}
        h={Layout.BACKDROP_H}
        fill
        color={FerryColor.BACKDROP}
        transparency={BACKDROP_TRANSPARENCY}
      />

      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={FerryModel.MAP}
        zoom={FerryCamera.MAP_ZOOM}
        pitch={FerryCamera.MAP_PITCH}
        yaw={FerryCamera.MAP_YAW}
      />

      <text
        x={Layout.ISLAND_X}
        y={Layout.ISLAND_Y}
        w={Layout.ISLAND_W}
        h={Layout.ISLAND_H}
        text={PlaceName.ISLAND}
        font={FerryFonts.LABEL}
        color={FerryColor.LABEL}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.WITCHAVEN_X}
        y={Layout.WITCHAVEN_Y}
        w={Layout.WITCHAVEN_W}
        h={Layout.WITCHAVEN_H}
        text={PlaceName.WITCHAVEN}
        font={FerryFonts.LABEL}
        color={FerryColor.LABEL}
        shadow
        align="center"
        valign="top"
      />

      <text
        x={Layout.PLATFORM_X}
        y={Layout.PLATFORM_Y}
        w={Layout.PLATFORM_W}
        h={Layout.PLATFORM_H}
        text={PlaceName.PLATFORM}
        font={FerryFonts.LABEL}
        color={FerryColor.LABEL}
        shadow
        align="center"
        valign="top"
      />

      <layer hide x={Layout.LEG_LAYER_X} y={Layout.LEG_LAYER_Y} w={Layout.LEG_LAYER_W} h={Layout.LEG_LAYER_H}>
        <model
          x={Layout.BOAT_X}
          y={Layout.BOAT_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={FerryModel.BOAT}
          anim={FerryAnimations.WITCHAVEN_TO_PLATFORM}
          zoom={FerryCamera.MAP_ZOOM}
          pitch={FerryCamera.MAP_PITCH}
          yaw={FerryCamera.MAP_YAW}
        />
      </layer>

      <layer hide x={Layout.LEG_LAYER_X} y={Layout.LEG_LAYER_Y} w={Layout.LEG_LAYER_W} h={Layout.LEG_LAYER_H}>
        <model
          x={Layout.BOAT_X}
          y={Layout.BOAT_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={FerryModel.BOAT}
          anim={FerryAnimations.PLATFORM_TO_WITCHAVEN}
          zoom={FerryCamera.MAP_ZOOM}
          pitch={FerryCamera.MAP_PITCH}
          yaw={FerryCamera.MAP_YAW}
        />
      </layer>

      <layer hide x={Layout.LEG_LAYER_X} y={Layout.LEG_LAYER_Y} w={Layout.LEG_LAYER_W} h={Layout.LEG_LAYER_H}>
        <model
          x={Layout.BOAT_X}
          y={Layout.BOAT_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={FerryModel.BOAT}
          anim={FerryAnimations.PLATFORM_TO_ISLAND}
          zoom={FerryCamera.MAP_ZOOM}
          pitch={FerryCamera.MAP_PITCH}
          yaw={FerryCamera.MAP_YAW}
        />
      </layer>

      <layer hide x={Layout.LEG_LAYER_X} y={Layout.LEG_LAYER_Y} w={Layout.LEG_LAYER_W} h={Layout.LEG_LAYER_H}>
        <model
          x={Layout.BOAT_X}
          y={Layout.BOAT_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={FerryModel.BOAT}
          anim={FerryAnimations.ISLAND_TO_PLATFORM}
          zoom={FerryCamera.MAP_ZOOM}
          pitch={FerryCamera.MAP_PITCH}
          yaw={FerryCamera.MAP_YAW}
        />
      </layer>

      <layer hide x={Layout.LEG_LAYER_X} y={Layout.LEG_LAYER_Y} w={Layout.LEG_LAYER_W} h={Layout.LEG_LAYER_H}>
        <model
          x={Layout.ISLE_BOAT_X}
          y={Layout.ISLE_BOAT_Y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={FerryModel.BOAT}
          anim={FerryAnimations.WITCHAVEN_TO_ISLE}
          zoom={FerryCamera.ISLE_ZOOM}
        />
      </layer>
    </>
  );
}
