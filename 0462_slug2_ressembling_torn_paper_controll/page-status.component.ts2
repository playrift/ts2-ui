import { useServerState } from 'ts2';

import { Layout, SlugColors, SlugFonts, SlugVarps } from './slug2-ressembling-torn-paper-controll.constants';

export function PageStatus(): Component {
  const complete: Int = useServerState(SlugVarps.FRAGMENT_COMPLETE);

  if (complete === 0) {
    return (
      <text
        x={0}
        y={0}
        w="fill"
        h={Layout.ROW_HEIGHT}
        text="Show/Select"
        font={SlugFonts.HEADING}
        color={SlugColors.LABEL}
        valign="middle"
        shadow
      />
    );
  }

  return (
    <text
      x={0}
      y={0}
      w="fill"
      h="fill"
      text="Page has been complete!"
      font={SlugFonts.HEADING}
      color={SlugColors.LABEL}
      align="center"
      valign="middle"
      lineHeight={Layout.COMPLETE_LINE_HEIGHT}
      shadow
    />
  );
}
