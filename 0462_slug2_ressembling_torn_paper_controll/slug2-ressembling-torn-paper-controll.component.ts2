import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { FragmentRow } from './fragment-row.component';
import { PageStatus } from './page-status.component';
import { Layout, SlugItems, SlugModels } from './slug2-ressembling-torn-paper-controll.constants';

export function Slug2TornPaper(): Component {
  return (
    <layer x={0} y={0} w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <layer x={0} y={0} w="fill" h="fill" />

      <layer x={0} y={0} w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
        <model
          x={80}
          y={55}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.ROTATE}
          zoom={Layout.BUTTON_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          options={['Rotate the Fragment']}
        />

        <model
          x={80}
          y={15}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.ARROW}
          zoom={Layout.BUTTON_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          yaw={Layout.YAW_UP}
          options={['Move Fragment Up']}
        />
        <model
          x={121}
          y={55}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.ARROW}
          zoom={Layout.BUTTON_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          yaw={Layout.YAW_RIGHT}
          options={['Move Fragment Right']}
        />
        <model
          x={41}
          y={55}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.ARROW}
          zoom={Layout.BUTTON_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          yaw={Layout.YAW_LEFT}
          options={['Move Fragment Left']}
        />
        <model
          x={80}
          y={95}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.ARROW}
          zoom={Layout.BUTTON_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          yaw={Layout.YAW_DOWN}
          options={['Move Fragment Down']}
        />

        <model
          x={123}
          y={96}
          w={Layout.BUTTON_SIZE}
          h={Layout.BUTTON_SIZE}
          model={SlugModels.FLIP}
          zoom={Layout.FLIP_ZOOM}
          pitch={Layout.BUTTON_PITCH}
          yaw={Layout.YAW_DOWN}
          options={['Flip Fragment Over']}
        />

        <layer x={Layout.BOX_X} y={{ bottom: Layout.BOX_BOTTOM }} w={Layout.BOX_WIDTH} h={Layout.BOX_HEIGHT}>
          <SteelFrame backdrop />

          <layer x="center" y="center" w={{ fill: Layout.INNER_INSET }} h={{ fill: Layout.INNER_INSET }}>
            <PageStatus />

            <layer x={0} y={Layout.ROW_1_Y} w="fill" h={Layout.ROW_HEIGHT}>
              <FragmentRow index={1} item={SlugItems.PIECE_1} label="Piece 1" />
            </layer>
            <layer x={0} y={Layout.ROW_2_Y} w="fill" h={Layout.ROW_HEIGHT}>
              <FragmentRow index={2} item={SlugItems.PIECE_2} label="Piece 2" />
            </layer>
            <layer x={0} y={Layout.ROW_3_Y} w="fill" h={Layout.ROW_HEIGHT}>
              <FragmentRow index={3} item={SlugItems.PIECE_3} label="Piece 3" />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
