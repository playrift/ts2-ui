import { predictServerState, useInventory, useServerState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { Layout, SlugColors, SlugFonts, SlugInventory, SlugSprites, SlugVarbits } from './slug2-torn-paper.constants';

export function FragmentRow({ index, item, label }: { index: Int; item: Item; label: String }): Component {
  const inv = useInventory(SlugInventory.INV);

  const show1: Int = useServerState(SlugVarbits.PIECE1_SHOW);
  const select1: Int = useServerState(SlugVarbits.PIECE1_SELECT);
  const show2: Int = useServerState(SlugVarbits.PIECE2_SHOW);
  const select2: Int = useServerState(SlugVarbits.PIECE2_SELECT);
  const show3: Int = useServerState(SlugVarbits.PIECE3_SHOW);
  const select3: Int = useServerState(SlugVarbits.PIECE3_SELECT);

  let show: Int = show3;
  let select: Int = select3;
  if (index === 1) {
    show = show1;
    select = select1;
  } else if (index === 2) {
    show = show2;
    select = select2;
  }

  const mobile: Boolean = onMobile();

  const held: Int = inv.total(item);
  if (held <= 0) {
    return null;
  }

  return (
    <>
      <rect
        x={mobile ? Layout.SHOW_TOUCH_X : Layout.SHOW_X}
        y={mobile ? 0 : 'center'}
        w={mobile ? Layout.TOUCH_WIDTH : Layout.RADIO_SIZE}
        h={mobile ? 'fill' : Layout.RADIO_SIZE}
        fill
        transparency={255}
        options={[`Show Fragment ${index}`]}
        onOptionSelect={() => {
          if (index === 1) {
            predictServerState(SlugVarbits.PIECE1_SHOW, 1 - show1);
          } else if (index === 2) {
            predictServerState(SlugVarbits.PIECE2_SHOW, 1 - show2);
          } else {
            predictServerState(SlugVarbits.PIECE3_SHOW, 1 - show3);
          }
        }}
      />

      <sprite
        x={Layout.SHOW_X}
        y="center"
        w={Layout.RADIO_SIZE}
        h={Layout.RADIO_SIZE}
        sprite={show === 1 ? SlugSprites.RADIO_ON : SlugSprites.RADIO_OFF}
      />

      <rect
        x={mobile ? Layout.SELECT_TOUCH_X : Layout.SELECT_X}
        y={mobile ? 0 : 'center'}
        w={mobile ? Layout.TOUCH_WIDTH : Layout.RADIO_SIZE}
        h={mobile ? 'fill' : Layout.RADIO_SIZE}
        fill
        transparency={255}
        options={[`Select Fragment ${index}`]}
        onOptionSelect={() => {
          if (index === 1) {
            predictServerState(SlugVarbits.PIECE1_SELECT, 1 - select1);
          } else if (index === 2) {
            predictServerState(SlugVarbits.PIECE2_SELECT, 1 - select2);
          } else {
            predictServerState(SlugVarbits.PIECE3_SELECT, 1 - select3);
          }
        }}
      />

      <sprite
        x={Layout.SELECT_X}
        y="center"
        w={Layout.RADIO_SIZE}
        h={Layout.RADIO_SIZE}
        sprite={select === 1 ? SlugSprites.RADIO_ON : SlugSprites.RADIO_OFF}
      />

      <text
        x="right"
        y={0}
        w={{ fill: Layout.LABEL_INSET }}
        h="fill"
        text={label}
        font={SlugFonts.LABEL}
        color={SlugColors.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </>
  );
}
