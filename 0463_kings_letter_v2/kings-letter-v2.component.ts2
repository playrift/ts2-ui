import {
  Layout,
  LetterFonts,
  LetterModel,
  LetterSprites,
  ParchmentCamera,
  SealCamera,
} from './kings-letter-v2.constants';

export function KingsLetterV2(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.PARCHMENT_X}
        y={Layout.PARCHMENT_Y}
        w={Layout.PARCHMENT_W}
        h={Layout.PARCHMENT_H}
        model={LetterModel.PARCHMENT}
        zoom={ParchmentCamera.ZOOM}
        pitch={ParchmentCamera.PITCH}
      />

      <text
        x={Layout.BODY_X}
        y={Layout.BODY_Y}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        font={LetterFonts.LABEL}
        align="left"
        valign="even"
      />

      <text
        x={Layout.SIGNATURE_X}
        y={Layout.SIGNATURE_Y}
        w={Layout.SIGNATURE_W}
        h={Layout.SIGNATURE_H}
        font={LetterFonts.LABEL}
        align="center"
        valign="top"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={LetterSprites.CLOSE}
      />

      <layer hide x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_W} h={Layout.HOVER_H}>
        <sprite
          x={Layout.HOVER_SPRITE_X}
          y={Layout.HOVER_SPRITE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={LetterSprites.CLOSE_HOVER}
        />
      </layer>

      <model
        x={Layout.SEAL_X}
        y={Layout.SEAL_Y}
        w={Layout.SEAL_W}
        h={Layout.SEAL_H}
        model={LetterModel.SEAL}
        zoom={SealCamera.ZOOM}
        pitch={SealCamera.PITCH}
        yaw={SealCamera.YAW}
      />
    </layer>
  );
}
