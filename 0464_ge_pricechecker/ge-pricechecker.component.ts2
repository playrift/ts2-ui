import { graphicSwapper, opsound } from '../lib/lib.helpers';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { GeArt, GeColors, GeFonts, Layout, OP_SOUND_MASK, Pulse } from './ge-pricechecker.constants';
import { geOffersPulsate } from './ge-pricechecker.helpers';
import { PriceList } from './price-list.component';

export function GePriceChecker(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Grand Exchange guide prices" />

      <PriceList />

      <sprite
        x={Layout.STRIP_X}
        y={Layout.STRIP_Y}
        w={Layout.STRIP_W}
        h={Layout.STRIP_H}
        sprite={GeArt.FOOTER_STRIP}
        tiling
      />

      <layer
        x={Layout.SEARCH_X}
        y={Layout.SEARCH_Y}
        w={Layout.SEARCH_W}
        h={Layout.SEARCH_H}
        options={['Search for item']}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <sprite w={Layout.SEARCH_W} h={Layout.SEARCH_H} sprite={GeArt.SEARCH_PLATE} />

        <sprite
          w={Layout.SEARCH_W}
          h={Layout.SEARCH_H}
          sprite={GeArt.SEARCH_PULSE}
          transparency={255}
          onTimer={(event) => geOffersPulsate(event.component, Pulse.EPOCH, Pulse.FROM, Pulse.TO)}
        />

        <sprite
          x={Layout.WELL_X}
          y={Layout.WELL_Y}
          w={Layout.WELL_W}
          h={Layout.WELL_H}
          outline={1}
          shadowColor={GeColors.ICON_SHADOW}
        />

        <sprite w={Layout.ICON_W} h={Layout.ICON_H} sprite={GeArt.SEARCH_ICON} />
      </layer>

      <sprite
        x={Layout.ADD_X}
        y={Layout.ADD_Y}
        w={Layout.ADD_W}
        h={Layout.ADD_H}
        sprite={GeArt.ADD_ALL}
        options={['Add all']}
        onMouseEnter={(event) => graphicSwapper(event.component, GeArt.ADD_ALL_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, GeArt.ADD_ALL)}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      />

      <sprite
        x={Layout.GLYPH_X}
        y={Layout.GLYPH_Y}
        w={Layout.GLYPH_W}
        h={Layout.GLYPH_H}
        sprite={GeArt.ADD_ALL_GLYPH}
      />

      <text
        x={Layout.FOOTER_X}
        y={Layout.FOOTER_Y}
        w={Layout.FOOTER_W}
        h={Layout.FOOTER_H}
        text=""
        font={GeFonts.FOOTER}
        color={GeColors.FOOTER}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
