import { intArray, useInventory, useRef, useState } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import {
  slotinfo00,
  slotinfo01,
  slotinfo02,
  slotinfo03,
  slotinfo04,
  slotinfo05,
  slotinfo06,
  slotinfo07,
  slotinfo08,
  slotinfo09,
  slotinfo10,
  slotinfo11,
  slotinfo12,
  slotinfo13,
  slotinfo14,
  slotinfo15,
  slotinfo16,
  slotinfo17,
  slotinfo18,
  slotinfo19,
  slotinfo20,
  slotinfo21,
  slotinfo22,
  slotinfo23,
  slotinfo24,
  slotinfo25,
  slotinfo26,
  slotinfo27,
} from '../lib/game/varcs';
import { Fade, GeColors, GeFonts, GeInventories, GeScrollbar, Grid, Layout } from './ge-pricechecker.constants';
import { priceLabel } from './ge-pricechecker.helpers';

export function PriceList(): Component {
  const items = useRef();
  const offer = useInventory(GeInventories.OFFER);

  const [price00] = useState(slotinfo00);
  const [price01] = useState(slotinfo01);
  const [price02] = useState(slotinfo02);
  const [price03] = useState(slotinfo03);
  const [price04] = useState(slotinfo04);
  const [price05] = useState(slotinfo05);
  const [price06] = useState(slotinfo06);
  const [price07] = useState(slotinfo07);
  const [price08] = useState(slotinfo08);
  const [price09] = useState(slotinfo09);
  const [price10] = useState(slotinfo10);
  const [price11] = useState(slotinfo11);
  const [price12] = useState(slotinfo12);
  const [price13] = useState(slotinfo13);
  const [price14] = useState(slotinfo14);
  const [price15] = useState(slotinfo15);
  const [price16] = useState(slotinfo16);
  const [price17] = useState(slotinfo17);
  const [price18] = useState(slotinfo18);
  const [price19] = useState(slotinfo19);
  const [price20] = useState(slotinfo20);
  const [price21] = useState(slotinfo21);
  const [price22] = useState(slotinfo22);
  const [price23] = useState(slotinfo23);
  const [price24] = useState(slotinfo24);
  const [price25] = useState(slotinfo25);
  const [price26] = useState(slotinfo26);
  const [price27] = useState(slotinfo27);

  const prices = intArray(Grid.SLOTS, [
    price00,
    price01,
    price02,
    price03,
    price04,
    price05,
    price06,
    price07,
    price08,
    price09,
    price10,
    price11,
    price12,
    price13,
    price14,
    price15,
    price16,
    price17,
    price18,
    price19,
    price20,
    price21,
    price22,
    price23,
    price24,
    price25,
    price26,
    price27,
  ]);

  let lastRowY: Int = -1;
  let slot: Int = 0;
  while (slot < Grid.SLOTS) {
    if (offer[slot] !== -1) {
      lastRowY = (slot / Grid.COLUMNS) * Grid.ROW_H;
    }
    slot = slot + 1;
  }

  const extent: Int = lastRowY >= 0 ? lastRowY + Grid.ROW_H : 0;

  return (
    <>
      <layer
        ref={items}
        x={Layout.PANE_X}
        y={Layout.PANE_Y}
        w={Grid.PANE_W}
        h={Grid.PANE_H}
        scrollHeight={extent > Grid.PANE_H ? extent : 0}
      >
        {offer.map(
          (item, index) =>
            item !== -1 && (
              <>
                <sprite
                  x={(index % Grid.COLUMNS) * Grid.STRIDE_X + Grid.ITEM_DX}
                  y={(index / Grid.COLUMNS) * Grid.ROW_H}
                  w={Grid.ITEM_W}
                  h={Grid.ITEM_H}
                  item={item}
                  itemCount={offer.count(index)}
                  outline={1}
                  shadowColor={GeColors.ICON_SHADOW}
                  options={['Remove', 'Remove-5', 'Remove-10', 'Remove-All', 'Remove-X', '', '', '', '', 'Examine']}
                  optionSubject={`<col=ff9040>${itemName(item)}</col>`}
                  onOptionSelect={(event) => {
                    flashFor(event.self, Fade.PRESSED, Fade.REST);
                  }}
                />

                {offer.count(index) > 0 && (
                  <text
                    x={(index % Grid.COLUMNS) * Grid.STRIDE_X}
                    y={(index / Grid.COLUMNS) * Grid.ROW_H + Grid.LABEL_DY}
                    w={Grid.COL_W}
                    h={Grid.LABEL_H}
                    text={priceLabel(offer.count(index), prices[index])}
                    font={GeFonts.ROW}
                    color={GeColors.ROW_LABEL}
                    shadow
                    align="center"
                    valign="top"
                  />
                )}
              </>
            ),
        )}
      </layer>

      <layer x={Layout.BAR_X} y={Layout.PANE_Y} w={Layout.BAR_W} h={Grid.PANE_H}>
        <ScrollbarVertical
          content={items}
          track={GeScrollbar.TRACK}
          capTopSprite={GeScrollbar.CAP_TOP}
          thumbSprite={GeScrollbar.THUMB}
          capBottomSprite={GeScrollbar.CAP_BOTTOM}
          arrowUp={GeScrollbar.ARROW_UP}
          arrowDown={GeScrollbar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
