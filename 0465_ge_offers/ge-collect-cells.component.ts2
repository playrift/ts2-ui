import { CS2 } from 'ts2';

import { flashFor } from '../lib/lib.components';
import { itemName } from '../lib/lib.engine';
import { Collect, Flash, GeColors, GeSprites, Slots } from './ge-offers.constants';
import { cellCount, cellItem } from './ge-offers.helpers';
import { selectedSlot } from './ge-offers.state';

function notable(item: Item): Boolean {
  if (item === -1) {
    return false;
  }
  if (CS2.item_cert(item) === item) {
    return false;
  }
  return true;
}

export function GeCollectCells(): Component {
  const slot: Int = selectedSlot();
  let live: Boolean = false;
  if (slot >= 0) {
    if (slot < Slots.COUNT) {
      live = true;
    }
  }

  const itemA: Item = live ? cellItem(slot, 0) : -1;
  const countA: Int = live ? cellCount(slot, 0) : 0;
  const itemB: Item = live ? cellItem(slot, 1) : -1;
  const countB: Int = live ? cellCount(slot, 1) : 0;

  let singleA: Boolean = false;
  let manyA: Boolean = false;
  if (notable(itemA)) {
    if (countA === 1) {
      singleA = true;
    } else {
      manyA = true;
    }
  }
  let singleB: Boolean = false;
  let manyB: Boolean = false;
  if (notable(itemB)) {
    if (countB === 1) {
      singleB = true;
    } else {
      manyB = true;
    }
  }

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <sprite
        x={Collect.PLINTH_X}
        y={Collect.PLINTH_Y}
        w={Collect.PLINTH_W}
        h={Collect.PLINTH_H}
        sprite={GeSprites.ITEM_BACKDROP}
      />
      <sprite
        x={Collect.PLINTH_RIGHT_X}
        y={Collect.PLINTH_Y}
        w={Collect.PLINTH_W}
        h={Collect.PLINTH_H}
        sprite={GeSprites.ITEM_BACKDROP}
      />

      {itemA === -1 ? (
        <sprite
          x={Collect.CELL_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          hide
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : singleA ? (
        <sprite
          x={Collect.CELL_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemA}
          itemCount={countA}
          options={['Collect-item', 'Collect-note', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemA)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : manyA ? (
        <sprite
          x={Collect.CELL_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemA}
          itemCount={countA}
          options={['Collect-notes', 'Collect-items', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemA)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : (
        <sprite
          x={Collect.CELL_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemA}
          itemCount={countA}
          options={['', 'Collect', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemA)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      )}

      {itemB === -1 ? (
        <sprite
          x={Collect.CELL_RIGHT_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          hide
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : singleB ? (
        <sprite
          x={Collect.CELL_RIGHT_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemB}
          itemCount={countB}
          options={['Collect-item', 'Collect-note', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemB)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : manyB ? (
        <sprite
          x={Collect.CELL_RIGHT_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemB}
          itemCount={countB}
          options={['Collect-notes', 'Collect-items', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemB)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      ) : (
        <sprite
          x={Collect.CELL_RIGHT_X}
          y={Collect.CELL_Y}
          w={Collect.CELL_W}
          h={Collect.CELL_H}
          shadowColor={GeColors.ICON_SHADOW}
          outline={1}
          item={itemB}
          itemCount={countB}
          options={['', 'Collect', 'Bank', '', '', '', '', '', '', 'Examine']}
          optionSubject={`<col=ff9040>${itemName(itemB)}</col>`}
          onOptionSelect={(event) => flashFor(event.self, Flash.PRESSED, Flash.REST)}
        />
      )}
    </layer>
  );
}
