import { CS2 } from 'ts2';

import { textLineCount } from '../lib/lib.engine';
import { opsound } from '../lib/lib.helpers';
import { Desc, GeFonts, GeSprites } from './ge-offers.constants';
import { enhancedClient } from './ge-offers.helpers';

export function descText(desc: String = '', note: String = '', width: Int = 0): String {
  if (CS2.string_length(note) <= 0) {
    return desc;
  }
  if (enhancedClient()) {
    return desc;
  }
  if (textLineCount(desc, width, GeFonts.BODY) <= 2) {
    return `${desc}<br><br>${note}`;
  }
  return `${desc}<br>${note}`;
}

export function GeOfferDescBadge({ note = '' }: { note?: String }): Component {
  if (CS2.string_length(note) <= 0) {
    return null;
  }
  if (enhancedClient()) {
    return null;
  }
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <sprite
        x="center"
        y="center"
        w={Desc.ICON}
        h={Desc.ICON}
        sprite={GeSprites.INFO}
        transparency={Desc.ICON_REST}
        options={['Info']}
        onOptionSelect={(event) => opsound(event.option, Desc.OP_MASK)}
        onMouseRepeat={(event) => {
          event.self.transparency = Desc.ICON_OVER;
        }}
        onMouseLeave={(event) => {
          event.self.transparency = Desc.ICON_REST;
        }}
      />
    </layer>
  );
}
