import { useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Index } from './ge-offers.constants';
import { GeOfferSlot } from './ge-offer-slot.component';
import { GeOffersTopBar } from './ge-offers-top-bar.component';

export function GeOffersIndex(): Component {
  const inv0 = useInventory(Inventories.TRADINGPOST_SELL_0);
  const inv1 = useInventory(Inventories.TRADINGPOST_SELL_1);
  const inv2 = useInventory(Inventories.TRADINGPOST_SELL_2);
  const inv3 = useInventory(Inventories.TRADINGPOST_SELL_3);
  const inv4 = useInventory(Inventories.TRADINGPOST_SELL_4);
  const inv5 = useInventory(Inventories.TRADINGPOST_SELL_5);
  const inv6 = useInventory(Inventories.GE_COLLECT_6);
  const inv7 = useInventory(Inventories.GE_COLLECT_7);

  const a0: Item = inv0[0];
  const b0: Item = inv0[1];
  const a1: Item = inv1[0];
  const b1: Item = inv1[1];
  const a2: Item = inv2[0];
  const b2: Item = inv2[1];
  const a3: Item = inv3[0];
  const b3: Item = inv3[1];
  const a4: Item = inv4[0];
  const b4: Item = inv4[1];
  const a5: Item = inv5[0];
  const b5: Item = inv5[1];
  const a6: Item = inv6[0];
  const b6: Item = inv6[1];
  const a7: Item = inv7[0];
  const b7: Item = inv7[1];

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <GeOffersTopBar />

      <layer x={Index.SLOT_NEAR} y={Index.ROW_0} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={0} held0={a0} count0={inv0.count(0)} held1={b0} count1={inv0.count(1)} />
      </layer>
      <layer x={Index.SLOT_MID} y={Index.ROW_0} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={1} held0={a1} count0={inv1.count(0)} held1={b1} count1={inv1.count(1)} />
      </layer>
      <layer x={{ right: Index.SLOT_MID }} y={Index.ROW_0} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={2} held0={a2} count0={inv2.count(0)} held1={b2} count1={inv2.count(1)} />
      </layer>
      <layer x={{ right: Index.SLOT_NEAR }} y={Index.ROW_0} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={3} held0={a3} count0={inv3.count(0)} held1={b3} count1={inv3.count(1)} />
      </layer>
      <layer x={Index.SLOT_NEAR} y={Index.ROW_1} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={4} held0={a4} count0={inv4.count(0)} held1={b4} count1={inv4.count(1)} />
      </layer>
      <layer x={Index.SLOT_MID} y={Index.ROW_1} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={5} held0={a5} count0={inv5.count(0)} held1={b5} count1={inv5.count(1)} />
      </layer>
      <layer x={{ right: Index.SLOT_MID }} y={Index.ROW_1} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={6} held0={a6} count0={inv6.count(0)} held1={b6} count1={inv6.count(1)} />
      </layer>
      <layer x={{ right: Index.SLOT_NEAR }} y={Index.ROW_1} w={Index.SLOT_W} h={Index.SLOT_H}>
        <GeOfferSlot slot={7} held0={a7} count0={inv7.count(0)} held1={b7} count1={inv7.count(1)} />
      </layer>
    </layer>
  );
}
