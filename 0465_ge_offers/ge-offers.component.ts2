import { setTransparency } from '../lib/lib.components';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { GeCollectCells } from './ge-collect-cells.component';
import { GeBigButton } from './ge-big-button.component';
import { GeOfferDescBadge, descText } from './ge-offer-desc.component';
import { GeOffersIndex } from './ge-offers-index.component';
import { GeTooltip } from './ge-tooltip.component';
import { DETAIL_LINE, DETAIL_TEXT, GeFonts, GeSprites, HISTORY, Panel, Setup, Status } from './ge-offers.constants';
import { panel, tooltipHost } from './ge-offers.refs';
import { hasSelection, panelTitle, selectSlot, selectionIsEmpty } from './ge-offers.state';
import { StonePanelSprite } from './stone-panel.component';

function GeBorderTitle(): Component {
  const title: String = panelTitle();
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <SteelBorderEntrypoint title={title} />
    </layer>
  );
}

function GeBackButton(): Component {
  const selected: Boolean = hasSelection();
  let backHidden: Boolean = true;
  if (selected) {
    backHidden = false;
  }
  return (
    <sprite
      x={Panel.BACK_X}
      y={Panel.BACK_Y}
      w={Panel.BACK_W}
      h={Panel.BACK_H}
      sprite={GeSprites.BACK}
      hide={backHidden}
      transparency={0}
      options={['Back']}
      onOptionSelect={(event) => selectSlot(event.option, -1, -1, false)}
      onMouseEnter={(event) => setTransparency(event.component, 100)}
      onMouseLeave={(event) => setTransparency(event.component, 0)}
    />
  );
}

function GeIndexView(): Component {
  const selected: Boolean = hasSelection();
  let indexHidden: Boolean = false;
  if (selected) {
    indexHidden = true;
  }
  return (
    <layer x={Panel.VIEW_X} y={Panel.VIEW_Y} w={Panel.VIEW_W} h={Panel.VIEW_H} hide={indexHidden}>
      <GeOffersIndex />
    </layer>
  );
}

function GeStatusView(): Component {
  const selected: Boolean = hasSelection();
  const setup: Boolean = selectionIsEmpty();
  let statusHidden: Boolean = true;
  if (selected) {
    if (!setup) {
      statusHidden = false;
    }
  }
  return (
    <layer x={Panel.VIEW_X} y={Panel.VIEW_Y} w={Panel.VIEW_W} h={Panel.VIEW_H} hide={statusHidden}>
      <text
        x={Status.DESC_X}
        y={Status.DESC_Y}
        w={Status.DESC_W}
        h={Status.DESC_H}
        font={GeFonts.BODY}
        color={DETAIL_TEXT}
        shadow
        lineHeight={DETAIL_LINE}
        text={descText('', '', Status.DESC_W)}
      />
      <text
        x={Status.CAPTION_X}
        y={Status.CAPTION_Y}
        w={Status.CAPTION_W}
        h={Status.CAPTION_H}
        font={GeFonts.BODY}
        color={DETAIL_TEXT}
        shadow
        lineHeight={DETAIL_LINE}
        align="right"
        valign="middle"
      />
      <layer x={0} y={0} w={Status.BADGE} h={Status.BADGE} hide options={['*']}>
        <GeOfferDescBadge />
      </layer>
      <sprite
        x={Status.BACK_X}
        y={Status.BACK_Y}
        w={Status.BACK_W}
        h={Status.BACK_H}
        sprite={GeSprites.BACKING}
        tiling
      />
      <sprite x={0} y={Status.RULE_Y} w={Panel.VIEW_W} h={Status.RULE_H} sprite={StonePanelSprite.DIVIDER} tiling />
      <sprite
        x={Status.EDGE_X}
        y={Status.EDGE_Y}
        w={Status.EDGE_W}
        h={Status.EDGE_H}
        sprite={StonePanelSprite.RIGHT}
        tiling
      />
      <sprite
        x={Status.CAP_X}
        y={Status.CAP_Y}
        w={Status.CAP}
        h={Status.CAP}
        sprite={StonePanelSprite.DIVIDER_LEFT}
        angle2d={Status.CAP_ANGLE}
      />
      <layer x={Status.SUMMARY_X} y={Status.SUMMARY_Y} w={Status.SUMMARY_W} h={Status.SUMMARY_H} />
      <layer x={Status.CELLS_X} y={Status.CELLS_Y} w={Status.CELLS_W} h={Status.CELLS_H}>
        <GeCollectCells />
      </layer>
      <layer x={0} y={0} w={Panel.VIEW_W} h={Panel.VIEW_H} />
    </layer>
  );
}

function GeSetupView(): Component {
  const selected: Boolean = hasSelection();
  const setup: Boolean = selectionIsEmpty();
  let setupHidden: Boolean = true;
  if (selected) {
    if (setup) {
      setupHidden = false;
    }
  }
  return (
    <layer x={Panel.VIEW_X} y={Panel.VIEW_Y} w={Panel.VIEW_W} h={Panel.VIEW_H} hide={setupHidden}>
      <text
        x={Setup.DESC_X}
        y={Setup.DESC_Y}
        w={Setup.DESC_W}
        h={Setup.DESC_H}
        font={GeFonts.BODY}
        color={DETAIL_TEXT}
        shadow
        lineHeight={DETAIL_LINE}
        text={descText('', '', Setup.DESC_W)}
      />
      <text
        x={Setup.CAPTION_X}
        y={Setup.CAPTION_Y}
        w={Setup.CAPTION_W}
        h={Setup.CAPTION_H}
        font={GeFonts.BODY}
        color={DETAIL_TEXT}
        shadow
        lineHeight={DETAIL_LINE}
        align="right"
        valign="middle"
      />
      <layer x={0} y={0} w={Setup.BADGE} h={Setup.BADGE} hide options={['*']}>
        <GeOfferDescBadge />
      </layer>
      <layer x={Setup.CONFIRM_X} y={Setup.CONFIRM_Y} w={Setup.CONFIRM_W} h={Setup.CONFIRM_H} options={['Confirm']} />
      <sprite x={0} y={Setup.RULE_Y} w={Panel.VIEW_W} h={Setup.RULE_H} sprite={StonePanelSprite.DIVIDER} tiling />
    </layer>
  );
}

export function GeOffers(): Component {
  return (
    <>
      <layer static ref={panel} x="center" y="center" w={Panel.W} h={Panel.H}>
        <GeBorderTitle />

        <layer x={Panel.HISTORY_X} y={Panel.HISTORY_Y} w={Panel.HISTORY_W} h={Panel.HISTORY_H}>
          <GeBigButton label={HISTORY} />
        </layer>

        <GeBackButton />

        <GeIndexView />

        <GeStatusView />

        <GeSetupView />

        <layer x={0} y={0} w="fill" h="fill" />
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w="fill" h="fill">
        <GeTooltip />
      </layer>
    </>
  );
}
