import { Create, Index, Panel, Slot } from './ge-offers.constants';

export function slotBoxX(slot: Int): Int {
  if (slot === 0 || slot === 4) {
    return Index.SLOT_NEAR;
  }
  if (slot === 1 || slot === 5) {
    return Index.SLOT_MID;
  }
  if (slot === 2 || slot === 6) {
    return Panel.VIEW_W - Index.SLOT_W - Index.SLOT_MID;
  }
  return Panel.VIEW_W - Index.SLOT_W - Index.SLOT_NEAR;
}

export function slotBoxY(slot: Int): Int {
  return slot < 4 ? Index.ROW_0 : Index.ROW_1;
}

export function tipAnchorX(slot: Int, source: Int, ironman: Boolean): Int {
  const box: Int = slotBoxX(slot);
  if (source === 0) {
    return box;
  }
  if (source === 1) {
    return ironman ? box + (Slot.W - Create.SOLO_SIZE) / 2 : box + Create.BUY_X;
  }
  return box + Slot.W - Create.PAIR_W - Create.SELL_RIGHT;
}

export function tipAnchorY(slot: Int, source: Int, ironman: Boolean): Int {
  const box: Int = slotBoxY(slot);
  if (source === 0) {
    return box;
  }
  return ironman ? box + Create.SOLO_Y : box + Create.PAIR_Y;
}

export function tipAnchorH(source: Int, ironman: Boolean): Int {
  if (source === 0) {
    return Slot.H;
  }
  if (source === 1) {
    return ironman ? Create.SOLO_SIZE : Create.PAIR_H;
  }
  return Create.PAIR_H;
}
