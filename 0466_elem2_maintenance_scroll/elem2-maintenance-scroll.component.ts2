import { Layout, LetterCamera, ScrollModel, ScrollSprites, WritingCamera } from './elem2-maintenance-scroll.constants';

export function Elem2MaintenanceScroll(): Component {
  return (
    <layer w="fill" h="fill">
      <model
        x={Layout.LETTER_X}
        y={Layout.LETTER_Y}
        w={Layout.LETTER_W}
        h={Layout.LETTER_H}
        model={ScrollModel.LETTER}
        zoom={LetterCamera.ZOOM}
        pitch={LetterCamera.PITCH}
        yaw={LetterCamera.YAW}
      />

      <model
        x={Layout.WRITING_X}
        y={Layout.WRITING_Y}
        w={Layout.WRITING_W}
        h={Layout.WRITING_H}
        model={ScrollModel.WRITING}
        zoom={WritingCamera.ZOOM}
        pitch={WritingCamera.PITCH}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ScrollSprites.CLOSE}
      />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ScrollSprites.CLOSE_OVER}
        />
      </layer>
    </layer>
  );
}
