import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { GE_SLOTS } from './ge-offers-side.constants';

export function geOfferable(): Boolean {
  const slot: Int = useServerState(Varbits.GE_SELECTEDSLOT) - 1;
  if (slot < 0 || slot >= GE_SLOTS) {
    return true;
  }
  if (CS2.stockmarket_offer_empty_is(slot)) {
    if (useServerState(Varbits.GE_NEWOFFER_TYPE) === 1) {
      return true;
    }
    return false;
  }
  return true;
}
