import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ChampionsArt, ChampionsLayout, ChampionsScroll } from './champions-log.constants';

export function ChampionsLog(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={ChampionsScroll.W}
        h={ChampionsScroll.H}
        model={ChampionsScroll.MODEL}
        zoom={ChampionsScroll.ZOOM}
        pitch={ChampionsScroll.PITCH}
        yaw={ChampionsScroll.YAW}
        offsetX={ChampionsScroll.OFFSET_X}
      />

      <layer
        x={ChampionsLayout.LIST_X}
        y="center"
        w={{ fill: ChampionsLayout.LIST_W_INSET }}
        h={ChampionsLayout.LIST_H}
      />

      <layer x={{ right: ChampionsLayout.BAR_RIGHT }} y="center" w={ChampionsLayout.BAR_W} h={ChampionsLayout.BAR_H} />

      <sprite
        x={{ right: ChampionsLayout.CLOSE_RIGHT }}
        y={ChampionsLayout.CLOSE_Y}
        w={ChampionsLayout.CLOSE_W}
        h={ChampionsLayout.CLOSE_H}
        sprite={ChampionsArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, ChampionsArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, ChampionsArt.CLOSE)}
      />
    </>
  );
}
