import { createRef } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Buttons,
  Camera,
  Labels,
  Layout,
  Markers,
  MODEL,
  ZepArt,
  ZepColor,
  ZepFonts,
  ZepModel,
} from './zep-balloon-map.constants';
import { zepBalloonMapHover, zepBalloonMapHoverOne } from './zep-balloon-map.helpers';

const castle = createRef('zep_castle');
const wars = createRef('zep_wars');
const grand = createRef('zep_grand');
const tree = createRef('zep_tree');
const varrock = createRef('zep_varrock');
const entrana = createRef('zep_entrana');
const taverley = createRef('zep_taverley');
const crafting = createRef('zep_crafting');
const guild = createRef('zep_guild');

export function ZepBalloonMap(): Component {
  return (
    <>
      <rect x={0} y={0} w="fill" h="fill" color={ZepColor.GROUND} fill />

      <model
        x={Layout.BALLOON_X}
        y={Layout.BALLOON_LOWER_Y}
        w={MODEL}
        h={MODEL}
        model={ZepModel.BALLOON_LOWER}
        zoom={Camera.BALLOON.ZOOM}
        pitch={Camera.BALLOON.PITCH}
        yaw={Camera.BALLOON.YAW}
      />
      <model
        x={Layout.BALLOON_X}
        y={Layout.BALLOON_UPPER_Y}
        w={MODEL}
        h={MODEL}
        model={ZepModel.BALLOON_UPPER}
        zoom={Camera.BALLOON.ZOOM}
        pitch={Camera.BALLOON.PITCH}
        yaw={Camera.BALLOON.YAW}
      />

      <text
        ref={castle}
        x={Labels.CASTLE.x}
        y={Labels.CASTLE.y}
        w={MODEL}
        h={MODEL}
        text={Labels.CASTLE.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={wars}
        x={Labels.WARS.x}
        y={Labels.WARS.y}
        w={MODEL}
        h={MODEL}
        text={Labels.WARS.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={grand}
        x={Labels.GRAND.x}
        y={Labels.GRAND.y}
        w={MODEL}
        h={MODEL}
        text={Labels.GRAND.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
        lineHeight={Labels.GRAND.lineHeight}
      />
      <text
        ref={tree}
        x={Labels.TREE.x}
        y={Labels.TREE.y}
        w={MODEL}
        h={MODEL}
        text={Labels.TREE.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={varrock}
        x={Labels.VARROCK.x}
        y={Labels.VARROCK.y}
        w={MODEL}
        h={MODEL}
        text={Labels.VARROCK.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={entrana}
        x={Labels.ENTRANA.x}
        y={Labels.ENTRANA.y}
        w={MODEL}
        h={MODEL}
        text={Labels.ENTRANA.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={taverley}
        x={Labels.TAVERLEY.x}
        y={Labels.TAVERLEY.y}
        w={MODEL}
        h={MODEL}
        text={Labels.TAVERLEY.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={crafting}
        x={Labels.CRAFTING.x}
        y={Labels.CRAFTING.y}
        w={MODEL}
        h={MODEL}
        text={Labels.CRAFTING.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />
      <text
        ref={guild}
        x={Labels.GUILD.x}
        y={Labels.GUILD.y}
        w={MODEL}
        h={MODEL}
        text={Labels.GUILD.text}
        font={ZepFonts.LABEL}
        color={ZepColor.REST}
      />

      <model
        x={Layout.BALLOON_X}
        y={Layout.BALLOON_UPPER_Y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER_BALLOON.ZOOM}
        pitch={Camera.MARKER_BALLOON.PITCH}
        yaw={Camera.MARKER_BALLOON.YAW}
      />

      <sprite
        x={Buttons.CASTLE.x}
        y={Buttons.CASTLE.y}
        w={Buttons.CASTLE.w}
        h={Buttons.CASTLE.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHover(1, castle, wars)}
        onMouseLeave={() => zepBalloonMapHover(0, castle, wars)}
      />
      <sprite
        x={Buttons.GNOME.x}
        y={Buttons.GNOME.y}
        w={Buttons.GNOME.w}
        h={Buttons.GNOME.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHover(1, grand, tree)}
        onMouseLeave={() => zepBalloonMapHover(0, grand, tree)}
      />
      <sprite
        x={Buttons.CRAFTING.x}
        y={Buttons.CRAFTING.y}
        w={Buttons.CRAFTING.w}
        h={Buttons.CRAFTING.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHover(1, crafting, guild)}
        onMouseLeave={() => zepBalloonMapHover(0, crafting, guild)}
      />
      <sprite
        x={Buttons.ENTRANA.x}
        y={Buttons.ENTRANA.y}
        w={Buttons.ENTRANA.w}
        h={Buttons.ENTRANA.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHoverOne(1, entrana)}
        onMouseLeave={() => zepBalloonMapHoverOne(0, entrana)}
      />
      <sprite
        x={Buttons.TAVERLEY.x}
        y={Buttons.TAVERLEY.y}
        w={Buttons.TAVERLEY.w}
        h={Buttons.TAVERLEY.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHoverOne(1, taverley)}
        onMouseLeave={() => zepBalloonMapHoverOne(0, taverley)}
      />
      <sprite
        x={Buttons.VARROCK.x}
        y={Buttons.VARROCK.y}
        w={Buttons.VARROCK.w}
        h={Buttons.VARROCK.h}
        options={['Travel']}
        onMouseEnter={() => zepBalloonMapHoverOne(1, varrock)}
        onMouseLeave={() => zepBalloonMapHoverOne(0, varrock)}
      />

      <model
        x={Markers.CRAFTING.x}
        y={Markers.CRAFTING.y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER.ZOOM}
        pitch={Camera.MARKER.PITCH}
        yaw={Camera.MARKER.YAW}
      />
      <model
        x={Markers.VARROCK.x}
        y={Markers.VARROCK.y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER.ZOOM}
        pitch={Camera.MARKER.PITCH}
        yaw={Camera.MARKER.YAW}
      />
      <model
        x={Markers.TAVERLEY.x}
        y={Markers.TAVERLEY.y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER.ZOOM}
        pitch={Camera.MARKER.PITCH}
        yaw={Camera.MARKER.YAW}
      />
      <model
        x={Markers.GNOME.x}
        y={Markers.GNOME.y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER.ZOOM}
        pitch={Camera.MARKER.PITCH}
        yaw={Camera.MARKER.YAW}
      />
      <model
        x={Markers.CASTLE.x}
        y={Markers.CASTLE.y}
        w={MODEL}
        h={MODEL}
        zoom={Camera.MARKER.ZOOM}
        pitch={Camera.MARKER.PITCH}
        yaw={Camera.MARKER.YAW}
      />
      <model x={Markers.ENTRANA.x} y={Markers.ENTRANA.y} w={MODEL} h={MODEL} zoom={Camera.MARKER_ENTRANA.ZOOM} />

      <layer x={{ right: 0 }} y={0} w={Layout.CLOSE_HOLDER} h={Layout.CLOSE_HOLDER}>
        <sprite
          x={0}
          y={{ bottom: 0 }}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ZepArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapper(event.component, ZepArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.component, ZepArt.CLOSE)}
        />
      </layer>
    </>
  );
}
