import { ZepColor } from './zep-balloon-map.constants';

export function zepBalloonMapHover(lit: Int, first: ComponentId, second: ComponentId): void {
  if (lit === 1) {
    first.color = ZepColor.LIT;
    second.color = ZepColor.LIT;
  } else {
    first.color = ZepColor.REST;
    second.color = ZepColor.REST;
  }
}

export function zepBalloonMapHoverOne(lit: Int, only: ComponentId): void {
  if (lit === 1) {
    only.color = ZepColor.LIT;
  } else {
    only.color = ZepColor.REST;
  }
}
