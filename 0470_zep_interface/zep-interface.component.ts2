import { Banners, Cells, Layout, Mask, MASK_COLOR, SkyPanels, SkyStripes, ZepModel } from './zep-interface.constants';

export function ZepInterface(): Component {
  return (
    <>
      <rect
        x={SkyPanels.BODY.x}
        y={SkyPanels.BODY.y}
        w={SkyPanels.BODY.w}
        h={SkyPanels.BODY.h}
        color={SkyPanels.BODY.color}
        fill
      />
      <rect
        x={SkyPanels.TOP.x}
        y={SkyPanels.TOP.y}
        w={SkyPanels.TOP.w}
        h={SkyPanels.TOP.h}
        color={SkyPanels.TOP.color}
        fill
      />
      <rect
        x={SkyPanels.GROUND.x}
        y={SkyPanels.GROUND.y}
        w={SkyPanels.GROUND.w}
        h={SkyPanels.GROUND.h}
        color={SkyPanels.GROUND.color}
        fill
      />

      {SkyStripes.map((stripe) => (
        <rect x={Layout.COLUMN_X} y={stripe.y} w={Layout.COLUMN_W} h={Layout.STRIPE_H} color={stripe.color} fill />
      ))}

      {Cells.map((cell) => (
        <model x={cell.x} y={cell.y} w={Layout.CELL_W} h={Layout.CELL_H} zoom={ZepModel.CELL_ZOOM} />
      ))}

      <model
        x={Layout.PARKED_X}
        y={Layout.PARKED_Y}
        w={Layout.CELL_W}
        h={Layout.CELL_H}
        model={ZepModel.CELL_A}
        zoom={ZepModel.CELL_ZOOM}
      />
      <model
        x={Layout.PARKED_X}
        y={Layout.PARKED_Y}
        w={Layout.CELL_W}
        h={Layout.CELL_H}
        model={ZepModel.CELL_B}
        zoom={ZepModel.CELL_ZOOM}
      />

      {Mask.map((panel) => (
        <rect x={panel.x} y={panel.y} w={panel.w} h={panel.h} color={MASK_COLOR} fill />
      ))}

      {Banners.map((banner) => (
        <model
          x={banner.x}
          y={Layout.BANNER_Y}
          w={Layout.BANNER_W}
          h={Layout.BANNER_H}
          model={ZepModel.BANNER}
          zoom={ZepModel.BANNER_ZOOM}
        />
      ))}

      <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H} />
    </>
  );
}
