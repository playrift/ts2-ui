import { useServerState } from 'ts2';

import { Layout, Tip, ZepColor, ZepFonts, ZepVarbits } from './zep-interface-side.constants';
import { hideZepTip, showZepTip } from './zep-interface-side.state';

export function ZepSandbagCount(): Component {
  const sandbags: Int = useServerState(ZepVarbits.SANDBAGS);
  return (
    <layer w="fill" h="fill">
      <text
        x={0}
        y={0}
        w={Layout.count.w}
        h={Layout.count.h}
        text={stringOf(sandbags)}
        deferred
        font={ZepFonts.QUILL}
        color={ZepColor.COUNT}
        shadow
        align="left"
        valign="top"
        onMouseRepeat={() => showZepTip(Tip.SANDBAGS_LEFT)}
        onMouseLeave={() => hideZepTip()}
      />
    </layer>
  );
}

export function ZepLogCount(): Component {
  const logs: Int = useServerState(ZepVarbits.LOGS);
  return (
    <layer w="fill" h="fill">
      <text
        x={0}
        y={0}
        w={Layout.count.w}
        h={Layout.count.h}
        text={stringOf(logs)}
        deferred
        font={ZepFonts.QUILL}
        color={ZepColor.COUNT}
        shadow
        align="left"
        valign="top"
        onMouseRepeat={() => showZepTip(Tip.LOGS_LEFT)}
        onMouseLeave={() => hideZepTip()}
      />
    </layer>
  );
}
