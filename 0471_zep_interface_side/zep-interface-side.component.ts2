import { Layout, Text, Tip, ZepCamera, ZepColor, ZepFonts, ZepModel } from './zep-interface-side.constants';
import { hideZepTip, showZepTip } from './zep-interface-side.state';
import { ZepLogCount, ZepSandbagCount } from './zep-counter.component';
import { ZepTooltip } from './zep-tooltip.component';

function textColourSwapper(component: ComponentId, color: Int): void {
  component.color = color;
}

export function ZepInterfaceSide(): Component {
  return (
    <layer w="fill" h="fill">
      <text
        x="center"
        y={Layout.title.y}
        w="fill"
        h={Layout.title.h}
        text={Text.TITLE}
        font={ZepFonts.QUILL}
        color={ZepColor.HEADING}
        shadow
        align="center"
        valign="top"
      />

      <layer x="center" y={Layout.sandbagRow.y} w={{ fill: Layout.sandbagRow.inset }} h={Layout.sandbagRow.h}>
        <model x={22} y={16} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.SANDBAG} zoom={ZepCamera.SANDBAG_ZOOM} />
        <model x={42} y={-3} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.ARROW} zoom={ZepCamera.ARROW_ZOOM} />
        <model x={42} y={24} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.ARROW} zoom={ZepCamera.ARROW_ZOOM} />
        <text
          x={0}
          y={0}
          w={Layout.PLATE_W}
          h="fill"
          font={ZepFonts.PLATE}
          color={ZepColor.PLATE}
          shadow
          align="left"
          valign="top"
          options={['Sandbags']}
          onMouseRepeat={() => showZepTip(Tip.SANDBAGS)}
          onMouseLeave={() => hideZepTip()}
        />
        <text
          x={Layout.cross.x}
          y={Layout.cross.y}
          w={Layout.cross.w}
          h={Layout.cross.h}
          text={Text.CROSS}
          font={ZepFonts.QUILL}
          color={ZepColor.HEADING}
          shadow
          align="left"
          valign="top"
        />
        <layer x={Layout.count.x} y={Layout.count.y} w={Layout.count.w} h={Layout.count.h}>
          <ZepSandbagCount />
        </layer>
      </layer>

      <layer x="center" y={Layout.logRow.y} w={{ fill: Layout.logRow.inset }} h={Layout.logRow.h}>
        <model x={20} y={25} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.LOG} zoom={ZepCamera.LOG_ZOOM} />
        <model x={9} y={25} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.LOG} zoom={ZepCamera.LOG_ZOOM} />
        <model x={14} y={11} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.LOG} zoom={ZepCamera.LOG_ZOOM} />
        <model x={57} y={10} w={Layout.MODEL} h={Layout.MODEL} model={ZepModel.ARROW} zoom={ZepCamera.ARROW_ZOOM} />
        <text
          x={0}
          y={0}
          w={Layout.PLATE_W}
          h="fill"
          font={ZepFonts.PLATE}
          color={ZepColor.PLATE}
          shadow
          align="left"
          valign="top"
          options={['Logs']}
          onMouseRepeat={() => showZepTip(Tip.LOGS)}
          onMouseLeave={() => hideZepTip()}
        />
        <text
          x={Layout.cross.x}
          y={Layout.cross.y}
          w={Layout.cross.w}
          h={Layout.cross.h}
          text={Text.CROSS}
          font={ZepFonts.QUILL}
          color={ZepColor.HEADING}
          shadow
          align="left"
          valign="top"
        />
        <layer x={Layout.count.x} y={Layout.count.y} w={Layout.count.w} h={Layout.count.h}>
          <ZepLogCount />
        </layer>
      </layer>

      <layer
        x={Layout.button.x}
        y={Layout.button.y}
        w={Layout.WIDE}
        h={Layout.button.h}
        options={['Relax']}
        onMouseRepeat={() => showZepTip(Tip.RELAX)}
        onMouseLeave={() => hideZepTip()}
      >
        <text
          x={0}
          y="center"
          w="fill"
          h="fill"
          text={Text.RELAX}
          font={ZepFonts.QUILL}
          color={ZepColor.CAPTION}
          shadow
          align="left"
          valign="middle"
          onMouseRepeat={(event) => textColourSwapper(event.component, ZepColor.CAPTION_HOVER)}
          onMouseLeave={(event) => textColourSwapper(event.component, ZepColor.CAPTION)}
        />
        <model
          x="right"
          y="center"
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={ZepModel.RELAX_ARROW}
          zoom={ZepCamera.RELAX_ARROW_ZOOM}
        />
      </layer>

      <layer
        x={{ right: Layout.button.x }}
        y={Layout.button.y}
        w={Layout.WIDE}
        h={Layout.button.h}
        options={['Bail']}
        onMouseRepeat={() => showZepTip(Tip.BAIL)}
        onMouseLeave={() => hideZepTip()}
      >
        <model
          x="right"
          y="center"
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={ZepModel.BAIL_ICON}
          zoom={ZepCamera.BAIL_ZOOM}
          pitch={ZepCamera.BAIL_PITCH}
          yaw={ZepCamera.BAIL_YAW}
        />
        <text
          x={0}
          y="center"
          w="fill"
          h="fill"
          text={Text.BAIL}
          font={ZepFonts.QUILL}
          color={ZepColor.CAPTION}
          shadow
          align="left"
          valign="middle"
          onMouseRepeat={(event) => textColourSwapper(event.component, ZepColor.CAPTION_HOVER)}
          onMouseLeave={(event) => textColourSwapper(event.component, ZepColor.CAPTION)}
        />
      </layer>

      <layer
        x={Layout.tug.x}
        y={{ bottom: Layout.tug.bottom }}
        w={Layout.WIDE}
        h={Layout.tug.h}
        options={['Tug']}
        onMouseRepeat={() => showZepTip(Tip.TUG)}
        onMouseLeave={() => hideZepTip()}
      >
        <model
          x="center"
          y={{ center: -4 }}
          w={Layout.MODEL}
          h={Layout.CORD_H}
          model={ZepModel.TUG_CORD}
          zoom={ZepCamera.TUG_CORD_ZOOM}
        />
        <model
          x={{ center: 19 }}
          y={{ center: -4 }}
          w={Layout.MODEL}
          h={Layout.CORD_H}
          model={ZepModel.ARROW}
          zoom={ZepCamera.ARROW_ZOOM}
          pitch={ZepCamera.ARROW_DOWN_PITCH}
        />
      </layer>

      <layer
        x={{ right: Layout.tug.x }}
        y={{ bottom: Layout.tug.bottom }}
        w={Layout.WIDE}
        h={Layout.tug.h}
        options={['Emergency tug']}
        onMouseRepeat={() => showZepTip(Tip.EMERGENCY)}
        onMouseLeave={() => hideZepTip()}
      >
        <model
          x="center"
          y={{ center: -4 }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={ZepModel.EMERGENCY_CORD}
          zoom={ZepCamera.EMERGENCY_CORD_ZOOM}
        />
        <model
          x={{ center: 19 }}
          y={{ center: -20 }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={ZepModel.ARROW}
          zoom={ZepCamera.ARROW_ZOOM}
          pitch={ZepCamera.ARROW_DOWN_PITCH}
        />
        <model
          x={{ center: 19 }}
          y={{ center: 12 }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={ZepModel.ARROW}
          zoom={ZepCamera.ARROW_ZOOM}
          pitch={ZepCamera.ARROW_DOWN_PITCH}
        />
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        <ZepTooltip />
      </layer>
    </layer>
  );
}
