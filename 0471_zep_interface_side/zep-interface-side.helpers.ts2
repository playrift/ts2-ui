import { Layout, Tip } from './zep-interface-side.constants';

function wideButton(panelWidth: Int): Int {
  return (panelWidth * Layout.WIDE_PROPORTION) / Layout.PROPORTION_SCALE;
}

export function zepAnchorX(tip: Tip, panelWidth: Int): Int {
  if (tip === Tip.BAIL) {
    return panelWidth - wideButton(panelWidth) - Layout.button.x;
  }
  if (tip === Tip.EMERGENCY) {
    return panelWidth - wideButton(panelWidth) - Layout.tug.x;
  }
  if (tip === Tip.RELAX) {
    return Layout.button.x;
  }
  if (tip === Tip.TUG) {
    return Layout.tug.x;
  }
  if (tip === Tip.SANDBAGS) {
    return Layout.sandbagRow.inset / 2;
  }
  if (tip === Tip.LOGS) {
    return Layout.logRow.inset / 2;
  }
  return Layout.sandbagRow.inset / 2 + Layout.count.x;
}

export function zepAnchorY(tip: Tip, panelHeight: Int): Int {
  if (tip === Tip.RELAX) {
    return Layout.button.y;
  }
  if (tip === Tip.BAIL) {
    return Layout.button.y;
  }
  if (tip === Tip.TUG) {
    return panelHeight - Layout.tug.bottom - Layout.tug.h;
  }
  if (tip === Tip.EMERGENCY) {
    return panelHeight - Layout.tug.bottom - Layout.tug.h;
  }
  if (tip === Tip.SANDBAGS) {
    return Layout.sandbagRow.y;
  }
  if (tip === Tip.SANDBAGS_LEFT) {
    return Layout.sandbagRow.y + Layout.count.y;
  }
  if (tip === Tip.LOGS) {
    return Layout.logRow.y;
  }
  return Layout.logRow.y + Layout.count.y;
}

export function zepAnchorHeight(tip: Tip): Int {
  if (tip === Tip.TUG) {
    return Layout.tug.h;
  }
  if (tip === Tip.EMERGENCY) {
    return Layout.tug.h;
  }
  if (tip === Tip.SANDBAGS_LEFT) {
    return Layout.count.h;
  }
  if (tip === Tip.LOGS_LEFT) {
    return Layout.count.h;
  }
  return Layout.button.h;
}

export function zepTipText(tip: Tip): String {
  if (tip === Tip.RELAX) {
    return 'Move forward.';
  }
  if (tip === Tip.BAIL) {
    return "We're doomed.";
  }
  if (tip === Tip.TUG) {
    return 'Move down.';
  }
  if (tip === Tip.EMERGENCY) {
    return 'Move down more.';
  }
  if (tip === Tip.SANDBAGS) {
    return 'Move up more.';
  }
  if (tip === Tip.SANDBAGS_LEFT) {
    return 'Sandbags left.';
  }
  if (tip === Tip.LOGS) {
    return 'Move up.';
  }
  return 'Logs left.';
}
