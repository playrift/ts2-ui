import { CS2, sessionState, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { Tip, Tooltip } from './zep-interface-side.constants';

export const zepTip = sessionState(Tip.NONE);

function onEnhancedMobile(): Boolean {
  const type: Int = CS2.clienttype();
  if (useServerState(Varbits.OSM_SIMULATE) === 1) {
    if (type === 4 || type === 5 || type === 10) {
      return true;
    }
  }
  if (type === 7 || type === 8) {
    return true;
  }
  return false;
}

export function showZepTip(tip: Tip): void {
  const [, setTip] = useState(zepTip);
  if (onEnhancedMobile()) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(Tooltip.DWELL)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  setTip(tip);
  tooltipRaise();
}

export function hideZepTip(): void {
  const [, setTip] = useState(zepTip);
  tooltipHide();
  setTip(Tip.NONE);
}
