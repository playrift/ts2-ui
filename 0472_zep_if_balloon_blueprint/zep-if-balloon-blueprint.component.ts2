import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { BlueprintArt, BlueprintModel, Layout } from './zep-if-balloon-blueprint.constants';

export function ZepIfBalloonBlueprint(): Component {
  return (
    <>
      <model
        x={Layout.sheet.x}
        y={Layout.sheet.y}
        w={Layout.sheet.w}
        h={Layout.sheet.h}
        model={BlueprintModel.SHEET}
        zoom={BlueprintModel.SHEET_ZOOM}
        pitch={BlueprintModel.SHEET_PITCH}
      />

      <model
        x={Layout.balloon.x}
        y={Layout.balloon.y}
        w={Layout.balloon.w}
        h={Layout.balloon.h}
        model={BlueprintModel.BALLOON}
        zoom={BlueprintModel.BALLOON_ZOOM}
        pitch={BlueprintModel.BALLOON_PITCH}
      />

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={BlueprintArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, BlueprintArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, BlueprintArt.CLOSE)}
      />
    </>
  );
}
