import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, QuestDisplayArt, QuestDisplayColors, QuestDisplayFonts, QuestScroll } from './questdisplay.constants';

export function QuestDisplay(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={QuestScroll.BOX}
        h={QuestScroll.BOX}
        model={QuestScroll.MODEL}
        zoom={QuestScroll.ZOOM}
        pitch={QuestScroll.PITCH}
        yaw={QuestScroll.YAW}
        offsetX={QuestScroll.OFFSET_X}
      />

      <text
        x="center"
        y={0}
        w="fill"
        h={Layout.TITLE_H}
        font={QuestDisplayFonts.TITLE}
        color={QuestDisplayColors.INK}
        align="center"
        valign="middle"
        shadow
      />

      <layer x={Layout.PANE_X} y="center" w={{ fill: Layout.PANE_W_INSET }} h={Layout.PANE_H}>
        <layer x="center" y={0} w="fill" h={Layout.LIST_H} />
      </layer>

      <layer x={{ right: Layout.BAR_RIGHT }} y="center" w={Layout.BAR_W} h={Layout.BAR_H} />

      <text
        x="center"
        y={{ bottom: 0 }}
        w="fill"
        h={Layout.QP_H}
        font={QuestDisplayFonts.BODY}
        color={QuestDisplayColors.INK}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={QuestDisplayArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, QuestDisplayArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, QuestDisplayArt.CLOSE)}
      />
    </>
  );
}
