import { createRef } from 'ts2';
import { QuestDisplay } from './questdisplay.component';
import { Layout } from './questdisplay.constants';

const questdisplayRef = createRef('questdisplay');

export const questdisplayUi = (): UI => (
  <ui ref={questdisplayRef} w={Layout.ROOT_W} h={Layout.ROOT_H} x="center" y="center">
    <QuestDisplay />
  </ui>
);
