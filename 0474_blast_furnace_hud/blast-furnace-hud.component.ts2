import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinBox } from '../lib/thin-box.component';
import { CAPTION, HudArt, HudColor, HudFonts, HudOverlay, Layout } from './blast-furnace-hud.constants';
import { CofferCoins } from './coffer-coins.component';

const timerHost = createRef('0474_blast_furnace_hud_timer_host');

const display = createRef('blast_furnace_hud_display');

export function BlastFurnaceHud(): Component {
  useInterval(() => overlayRelayout(timerHost, display, HudOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
        <layer
          ref={display}
          x={{ right: Layout.DISPLAY_RIGHT }}
          y={Layout.DISPLAY_TOP}
          w={Layout.DISPLAY_W}
          h={Layout.DISPLAY_H}
        >
          <sprite x="center" y="center" w="fill" h="fill" sprite={HudArt.BACKING} tiling />

          <ThinBox>
            <text
              x="center"
              y="center"
              w="fill"
              h={{ fill: Layout.LABEL_INSET_H }}
              text={CAPTION}
              font={HudFonts.LABEL}
              color={HudColor.LABEL}
              shadow
              align="center"
              valign="top"
            />

            <CofferCoins x="center" y={{ bottom: Layout.COINS_BOTTOM }} w={Layout.COINS_W} h={Layout.COINS_H} />
          </ThinBox>
        </layer>
      </layer>
    </layer>
  );
}
