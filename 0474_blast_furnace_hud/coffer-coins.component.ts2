import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { HudColor, HudItems, Layout } from './blast-furnace-hud.constants';

export function CofferCoins(): Component {
  const coffer: Int = useServerState(Varbits.BLAST_FURNACE_COFFER);
  return (
    <sprite
      w="fill"
      h="fill"
      item={HudItems.COINS}
      itemCount={coffer}
      outline={Layout.COINS_OUTLINE}
      shadowColor={HudColor.ITEM_SHADOW}
    />
  );
}
