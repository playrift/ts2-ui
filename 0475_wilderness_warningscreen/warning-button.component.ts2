import { CS2 } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import {
  WarningButtonBox,
  WarningColors,
  WarningFonts,
  WarningScreenSprites,
} from './wilderness-warningscreen.constants';

export function WarningButton({ label }: { label: String }): Component {
  return (
    <layer
      options={[label]}
      onOptionSelect={(event) => {
        playSound(Sounds.CLICK);
        CS2.if_resume_pausebutton(event.component);
      }}
    >
      <sprite
        x="center"
        y="center"
        w="fill"
        h="fill"
        sprite={WarningScreenSprites.BUTTON}
        hover={{ sprite: WarningScreenSprites.BUTTON_HOVER }}
      />

      <text
        x="center"
        y="center"
        w={{ fill: WarningButtonBox.LABEL_INSET }}
        h={{ fill: WarningButtonBox.LABEL_INSET }}
        text={label}
        font={WarningFonts.HEADING}
        color={WarningColors.BUTTON_LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
