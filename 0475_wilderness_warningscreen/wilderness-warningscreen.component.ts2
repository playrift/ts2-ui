import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { WarningButton } from './warning-button.component';
import { WarningToggle } from './warning-toggle.component';
import {
  CornerModel,
  ENTER_LABEL,
  LEAVE_LABEL,
  Message,
  Panel,
  TitleIcon,
  Toggle,
  WarningButtonBox,
  WarningColors,
  WarningFonts,
  WarningScreenSprites,
} from './wilderness-warningscreen.constants';

export function WildernessWarningscreen(): Component {
  return (
    <>
      <rect
        x={{ center: Panel.SHADOW_OFFSET }}
        y={{ center: Panel.SHADOW_OFFSET }}
        w={Panel.WIDTH}
        h={Panel.HEIGHT}
        fill
        color={WarningColors.SHADOW}
        transparency={Panel.SHADOW_TRANSPARENCY}
      />

      <layer x="center" y="center" w={Panel.WIDTH} h={Panel.HEIGHT}>
        <rect x={0} y={0} w={0} h={0} hide />
        <rect x={0} y={0} w={0} h={0} hide />

        <layer x="center" y="center" w="fill" h="fill">
          <StoneBorderEntrypoint title="" />
        </layer>

        <sprite
          x={TitleIcon.INSET}
          y={TitleIcon.TOP}
          w={TitleIcon.SIZE}
          h={TitleIcon.SIZE}
          sprite={WarningScreenSprites.SKULL}
        />
        <sprite
          x={{ right: TitleIcon.INSET }}
          y={TitleIcon.TOP}
          w={TitleIcon.SIZE}
          h={TitleIcon.SIZE}
          sprite={WarningScreenSprites.SKULL}
        />

        <text
          x="center"
          y={TitleIcon.TOP}
          w="fill"
          h={TitleIcon.SIZE}
          text="WARNING!"
          font={WarningFonts.HEADING}
          color={WarningColors.TITLE}
          shadow
          align="center"
          valign="middle"
        />

        <model
          x={CornerModel.INSET_X}
          y={CornerModel.TOP_Y}
          w={CornerModel.TOP_SIZE}
          h={CornerModel.TOP_SIZE}
          model={CornerModel.LEFT}
          zoom={CornerModel.ZOOM}
          orthogonal
        />
        <model
          x={{ right: CornerModel.INSET_X }}
          y={CornerModel.TOP_Y}
          w={CornerModel.TOP_SIZE}
          h={CornerModel.TOP_SIZE}
          model={CornerModel.RIGHT}
          zoom={CornerModel.ZOOM}
          orthogonal
        />
        <model
          x={CornerModel.INSET_X}
          y={{ bottom: CornerModel.BOTTOM_Y }}
          w={CornerModel.BOTTOM_LEFT_W}
          h={CornerModel.BOTTOM_LEFT_H}
          model={CornerModel.LEFT}
          zoom={CornerModel.ZOOM}
        />
        <model
          x={{ right: CornerModel.INSET_X }}
          y={{ bottom: CornerModel.BOTTOM_Y }}
          w={CornerModel.BOTTOM_RIGHT_SIZE}
          h={CornerModel.BOTTOM_RIGHT_SIZE}
          model={CornerModel.RIGHT}
          zoom={CornerModel.ZOOM}
        />

        <text
          x="center"
          y={Message.TOP}
          w={Message.WIDTH}
          h={Message.HEIGHT}
          font={WarningFonts.BODY}
          color={WarningColors.BODY}
          shadow
          align="center"
          valign="middle"
        />

        <WarningButton
          x={WarningButtonBox.INSET_X}
          y={{ bottom: WarningButtonBox.BOTTOM }}
          w={WarningButtonBox.WIDTH}
          h={WarningButtonBox.HEIGHT}
          label={ENTER_LABEL}
        />
        <WarningButton
          x={{ right: WarningButtonBox.INSET_X }}
          y={{ bottom: WarningButtonBox.BOTTOM }}
          w={WarningButtonBox.WIDTH}
          h={WarningButtonBox.HEIGHT}
          label={LEAVE_LABEL}
        />

        <WarningToggle x="center" y={Toggle.TOP} w="fill" h={Toggle.HEIGHT} />
      </layer>
    </>
  );
}
