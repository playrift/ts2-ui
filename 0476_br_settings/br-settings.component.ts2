import { useUniverse } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { textLineCount } from '../lib/lib.engine';
import { BuildGrid } from './build-grid.component';
import { BrSettingsFonts, Copy, Layout, Palette } from './br-settings.constants';

export function BrSettings(): Component {
  const universe = useUniverse();

  const textWidth: Int = universe.width - Layout.CONTENT_INSET;
  const introH: Int = Layout.PARA_LINE * textLineCount(Copy.INTRO, textWidth, BrSettingsFonts.BODY) + Layout.PARA_PAD;
  const footerH: Int = Layout.PARA_LINE * textLineCount(Copy.FOOTER, textWidth, BrSettingsFonts.BODY) + Layout.PARA_PAD;

  return (
    <>
      <SteelBorderEntrypoint title="Last Man Standing Settings" />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET }}
        h={{ fill: Layout.FRAME_INSET }}
      >
        <text
          x="center"
          y={0}
          w="fill"
          h={introH}
          text={Copy.INTRO}
          font={BrSettingsFonts.BODY}
          color={Palette.GOLD}
          shadow
          align="left"
          valign="middle"
          lineHeight={Layout.PARA_LINE}
        />

        <layer x="center" y={introH} w={Layout.BOX_W} h={Layout.BOX_H}>
          <BuildGrid />
          <ThinStoneBoxEntrypoint />
        </layer>

        <text
          x="center"
          y="bottom"
          w="fill"
          h={footerH}
          text={Copy.FOOTER}
          font={BrSettingsFonts.BODY}
          color={Palette.GOLD}
          shadow
          align="left"
          valign="middle"
          lineHeight={Layout.PARA_LINE}
        />
      </layer>
    </>
  );
}
