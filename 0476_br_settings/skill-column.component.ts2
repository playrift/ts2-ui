import { Fade, Layout, Palette, BrSettingsFonts, SkillIcons } from './br-settings.constants';

const statLine = (value: Int): String => (value < 99 ? `<col=ffff00>${stringOf(value)}</col>` : stringOf(value));

export function SkillColumn({
  x,
  skill,
  divider = false,
  maxMed,
  zerker,
  pure,
}: {
  x: Int;
  skill: Skill;
  divider?: Boolean;
  maxMed: Int;
  zerker: Int;
  pure: Int;
}): Component {
  return (
    <>
      {divider && (
        <rect x={x} y="center" w={Layout.COLUMN_W} h="fill" color={Palette.WHITE} fill transparency={Fade.DIVIDER} />
      )}

      <sprite x={x} y={0} w={Layout.COLUMN_W} h={Layout.COLUMN_W} sprite={SkillIcons.get(skill) ?? -1} />

      <text
        x={x}
        y="bottom"
        w={Layout.COLUMN_W}
        h={{ fill: Layout.HEADER_H }}
        text={`${statLine(maxMed)}<br>${statLine(zerker)}<br>${statLine(pure)}`}
        font={BrSettingsFonts.STATS}
        color={Palette.GOLD}
        shadow
        align="center"
        valign="middle"
        lineHeight={Layout.ROW_H}
      />
    </>
  );
}
