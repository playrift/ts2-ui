import { useInventory } from 'ts2';
import { Colors, Fonts, Fur, FurInventory, Label } from './hunting-customfurs.constants';

export function FurLabels(): Component {
  const carried = useInventory(FurInventory.CARRIED);

  const polar: Int = carried.total(Fur.POLAR);
  const woodland: Int = carried.total(Fur.WOODLAND);
  const jungle: Int = carried.total(Fur.JUNGLE);
  const desert: Int = carried.total(Fur.DESERT);
  const silent: Int = carried.total(Fur.SILENT);
  const speedy: Int = carried.total(Fur.SPEEDY);
  const speedy2: Int = carried.total(Fur.SPEEDY2);
  const jaguarPerfect: Int = carried.total(Fur.JAGUAR_PERFECT);
  const jaguarShabby: Int = carried.total(Fur.JAGUAR_SHABBY);
  const leopardPerfect: Int = carried.total(Fur.LEOPARD_PERFECT);
  const leopardShabby: Int = carried.total(Fur.LEOPARD_SHABBY);
  const tigerPerfect: Int = carried.total(Fur.TIGER_PERFECT);
  const tigerShabby: Int = carried.total(Fur.TIGER_SHABBY);

  return (
    <>
      <text
        x={161}
        y={142}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Spotted kebbit"
        font={Fonts.BODY}
        color={speedy >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={322}
        y={142}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Dashing kebbit"
        font={Fonts.BODY}
        color={speedy2 >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={0}
        y={142}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Dark kebbit"
        font={Fonts.BODY}
        color={silent >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={161}
        y={70}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Graahk"
        font={Fonts.BODY}
        color={leopardPerfect >= 1 || leopardShabby >= 1 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={322}
        y={70}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Kyatt"
        font={Fonts.BODY}
        color={tigerPerfect >= 1 || tigerShabby >= 1 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={0}
        y={70}
        w={Label.WIDE}
        h={Label.HEIGHT}
        text="Larupia"
        font={Fonts.BODY}
        color={jaguarPerfect >= 1 || jaguarShabby >= 1 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={0}
        y={0}
        w={Label.NARROW}
        h={Label.HEIGHT}
        text="Polar kebbit"
        font={Fonts.BODY}
        color={polar >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={121}
        y={0}
        w={Label.NARROW}
        h={Label.HEIGHT}
        text="Common kebbit"
        font={Fonts.BODY}
        color={woodland >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={242}
        y={0}
        w={Label.NARROW}
        h={Label.HEIGHT}
        text="Feldip weasel"
        font={Fonts.BODY}
        color={jungle >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={363}
        y={0}
        w={121}
        h={Label.HEIGHT}
        text="Desert devil"
        font={Fonts.BODY}
        color={desert >= 2 ? Colors.LABEL_READY : Colors.LABEL_SHORT}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
