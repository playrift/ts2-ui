import { useRef } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { Colors, FADE_CYCLES, Layout, Transparency } from './hunting-customfurs.constants';

export function FurShopItem({ garment, left, top }: { garment: Item; left: Int; top: Int }): Component {
  const icon = useRef();

  return (
    <sprite
      ref={icon}
      x={left}
      y={top}
      w={Layout.ITEM_W}
      h={Layout.ITEM_H}
      item={garment}
      itemCount={-1}
      outline={1}
      shadowColor={Colors.ICON_SHADOW}
      options={['Value', 'Buy-1', 'Buy-5', 'Buy-10', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(garment)}</col>`}
      onOptionSelect={() => {
        flashFor(icon, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}
