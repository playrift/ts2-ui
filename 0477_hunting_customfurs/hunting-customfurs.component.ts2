import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { FooterHint } from './footer-hint.component';
import { FurLabels } from './fur-labels.component';
import { FurShopItem } from './fur-shop-item.component';
import { CamoWares, HatWares, SuitWares } from './hunting-customfurs.data';
import { Content, Frame, Layout, Sections } from './hunting-customfurs.constants';

export function HuntingCustomFurs(): Component {
  return (
    <>
      <SteelBorder
        x={Frame.X}
        y={Frame.Y}
        w={Frame.WIDTH}
        h={Frame.HEIGHT}
        title="Custom Fur Clothing"
        titleColor={SteelborderColor.TITLE}
        flags={0}
      />

      <layer x={Frame.X} y={Frame.Y} w={Frame.WIDTH} h={Frame.HEIGHT}>
        <layer y={Content.FOOTER_Y} w="fill" h={Content.FOOTER_HEIGHT}>
          <FooterHint />
        </layer>

        <layer y={Content.CHOICES_Y} w={Content.CHOICES_WIDTH} h={Content.CHOICES_HEIGHT}>
          <layer w="fill" h={{ fill: Content.LABELS_INSET }}>
            <FurLabels />
          </layer>

          <layer y={Content.ITEMS_Y} w="fill" h={{ fill: Content.ITEMS_INSET }}>
            {CamoWares.map((ware) => (
              <FurShopItem
                garment={ware.garment}
                left={
                  Layout.COLUMN_START +
                  ware.column * Sections.CAMO.COLUMN_WIDTH +
                  ware.position * Layout.ITEM_STRIDE +
                  Sections.CAMO.X_OFFSET
                }
                top={Sections.CAMO.Y}
              />
            ))}
            {SuitWares.map((ware) => (
              <FurShopItem
                garment={ware.garment}
                left={
                  Layout.COLUMN_START +
                  ware.column * Sections.SUITS.COLUMN_WIDTH +
                  ware.position * Layout.ITEM_STRIDE +
                  Sections.SUITS.X_OFFSET
                }
                top={Sections.SUITS.Y}
              />
            ))}
            {HatWares.map((ware) => (
              <FurShopItem
                garment={ware.garment}
                left={
                  Layout.COLUMN_START +
                  ware.column * Sections.HATS.COLUMN_WIDTH +
                  ware.position * Layout.ITEM_STRIDE +
                  Sections.HATS.X_OFFSET
                }
                top={Sections.HATS.Y}
              />
            ))}
          </layer>
        </layer>
      </layer>
    </>
  );
}
