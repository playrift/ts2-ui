import { useInventory } from 'ts2';
import { closeInterface } from '../lib/lib.helpers';
import { Caption, ImpBox, ImpBoxItem, ImpFont } from './bank-deposit-imp.constants';

export function ImpBoxCaption(): Component {
  const carried = useInventory(ImpBox.INV);
  const capacity: Int = carried.total(ImpBoxItem.FULL) * ImpBoxItem.FULL_WORTH + carried.total(ImpBoxItem.HALF);

  if (capacity <= 0) {
    closeInterface();
    return null;
  }

  return (
    <text
      x="center"
      y={{ bottom: Caption.BOTTOM }}
      w={{ fill: Caption.WIDTH_INSET }}
      h={Caption.HEIGHT}
      font={ImpFont.CAPTION}
      color={Caption.COLOR}
      shadow
      align="center"
      valign="middle"
      lineHeight={Caption.LINE_HEIGHT}
      text={
        capacity > 1
          ? `Select an item or stack of items to deposit.<br><col=ff7000>You can deposit up to ${capacity} items or stacks.`
          : 'Select an item or stack of items to deposit.<br><col=ff7000>You can deposit up to 1 item or stack.'
      }
    />
  );
}
