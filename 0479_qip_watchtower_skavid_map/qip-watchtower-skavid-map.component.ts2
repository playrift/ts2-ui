import { Camera, Layout, SkavidMapArt, SkavidMapColors, SkavidMapModel } from './qip-watchtower-skavid-map.constants';

export function QipWatchtowerSkavidMap(): Component {
  return (
    <>
      <rect x={0} y={0} w={Layout.BACKING_W} h={Layout.BACKING_H} fill color={SkavidMapColors.BACKING} />

      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MAP_SIZE}
        h={Layout.MAP_SIZE}
        model={SkavidMapModel.MAP}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={SkavidMapArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SkavidMapArt.CLOSE_HOVER}
        />
      </layer>
    </>
  );
}
