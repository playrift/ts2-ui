import {
  AnmaArt,
  AnmaButtons,
  AnmaCamera,
  AnmaColors,
  AnmaDials,
  AnmaModel,
  WASH_TRANSPARENCY,
} from './anma-rgb.constants';

export function AnmaRgb(): Component {
  return (
    <>
      <rect x={0} y={0} w={513} h={334} fill color={AnmaColors.WASH} transparency={WASH_TRANSPARENCY} />

      <rect x={81} y={5} w={361} h={276} fill color={AnmaColors.PANEL} />

      <sprite x={468} y={10} w={26} h={23} sprite={AnmaArt.CLOSE} />

      <layer x={467} y={9} w={29} h={26} hide>
        <sprite x={1} y={1} w={26} h={23} sprite={AnmaArt.CLOSE_HOVER} />
      </layer>

      {AnmaDials.map((dial) => (
        <layer x={84} y={7} w={356} h={271}>
          <model x={163} y={114} w={32} h={32} model={dial} zoom={AnmaCamera.DIAL.ZOOM} />
        </layer>
      ))}

      {AnmaButtons.map((button) => (
        <layer x={button.x} y={button.y} w={32} h={32}>
          <model
            x={0}
            y={button.dy}
            w={32}
            h={32}
            model={AnmaModel.BUTTON_ON}
            zoom={AnmaCamera.BUTTON.ZOOM}
            pitch={AnmaCamera.BUTTON.PITCH}
          />
        </layer>
      ))}

      {AnmaButtons.map((button) => (
        <layer x={button.x} y={button.y} w={32} h={32} hide>
          <model
            x={0}
            y={button.dy}
            w={32}
            h={32}
            model={AnmaModel.BUTTON_OFF}
            zoom={AnmaCamera.BUTTON.ZOOM}
            pitch={AnmaCamera.BUTTON.PITCH}
          />
        </layer>
      ))}
    </>
  );
}
