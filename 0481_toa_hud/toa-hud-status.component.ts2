import { useDerived } from 'ts2';

import { Health, Layout, ToaHudColor, ToaHudFonts, ToaHudSprites } from './toa-hud.constants';
import { hideSlotTip, showSlotTip } from './toa-hud-tooltip.component';
import {
  Slot,
  isMyself,
  myOrbHeight,
  name0,
  name1,
  name2,
  name3,
  name4,
  name5,
  name6,
  name7,
  partyName,
  slotHealth,
  slotPrimary,
} from './toa-hud.state';

export function ToaStatusCell({ slot, name, left, top }: { slot: Slot; name: String; left: Int; top: Int }): Component {
  const health: Int = useDerived(() => slotHealth(slot));
  const primary: Int = useDerived(() => slotPrimary(slot));
  const me: Boolean = isMyself(slot);

  let letter: String = partyName(name).substring(0, 1);
  if (me) {
    letter = 'Me';
  }

  let fill: Sprite = ToaHudSprites.ORB_FILL;
  if (primary === 1) {
    fill = ToaHudSprites.ORB_FILL_PRIMARY;
  }
  let filled: Int = Math.min(Layout.ORB, health - 1);
  if (me) {
    filled = myOrbHeight();
  }
  let ink: Int = ToaHudColor.LETTER;

  if (health === Health.OUTSIDE) {
    fill = ToaHudSprites.ORB_FILL_OUT;
    filled = Layout.ORB;
  } else if (health === Health.DEAD) {
    filled = 0;
    ink = ToaHudColor.LETTER_DEAD;
  }

  if (health === Health.EMPTY) {
    return null;
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => showSlotTip(name, left, top)} onMouseLeave={() => hideSlotTip()}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={ToaHudSprites.RING} />
      <sprite x="center" y="center" w={Layout.ORB} h={Layout.ORB} sprite={ToaHudSprites.ORB_BASE} />
      <layer x="center" y={{ bottom: Layout.ORB_BOTTOM }} w={Layout.ORB} h={filled}>
        <sprite x="center" y="bottom" w={Layout.ORB} h={Layout.ORB} sprite={fill} tiling />
      </layer>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={ToaHudFonts.LABEL}
        text={letter}
        align="center"
        valign="middle"
        shadow
        color={ink}
      />
    </layer>
  );
}

export function ToaStatusCell0({ left, top }: { left: Int; top: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <ToaStatusCell slot={Slot.S0} name={name0()} left={left} top={top} />
    </layer>
  );
}

