import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, ToaHudDodge } from './toa-hud.constants';
import { ToaHudDraw } from './toa-hud-draw.component';
import { ToaHudTooltip } from './toa-hud-tooltip.component';
import { content, tooltipHost } from './toa-hud.refs';

const timerHost = createRef('0481_toa_hud_timer_host');

export function ToaHud(): Component {
  useInterval(() => overlayRelayout(timerHost, content, ToaHudDodge.WORD, Anchor.LEFT, Anchor.TOP, 0), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
        <layer static ref={content} x={Layout.CONTENT_X} y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <ToaHudDraw />
        </layer>
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP}>
        <ToaHudTooltip />
      </layer>
    </layer>
  );
}
