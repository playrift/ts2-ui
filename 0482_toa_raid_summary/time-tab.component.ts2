import { onMounted, useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { ThinBox } from '../lib/thin-box.component';
import { Layout, SummaryFonts, TabColor, TabStyle, TimeTab } from './toa-raid-summary.constants';
import { hoverTimeTab, resetTimeTab, summaryTabHover, summaryTimeTab, unhoverTimeTab } from './toa-raid-summary.state';

export function RoomTimesTab({ tab, label }: { tab: Int; label: String }): Component {
  const [selected] = useState(summaryTimeTab);
  const [hovered] = useState(summaryTabHover);

  onMounted(() => {
    resetTimeTab();
  });

  let style: Int = TabStyle.REST;
  if (selected === tab) {
    style = TabStyle.SELECTED;
  } else if (hovered === tab) {
    style = TabStyle.HOVER;
  }

  let plate: Int = TabColor.PLATE_REST;
  if (style === TabStyle.HOVER) {
    plate = TabColor.PLATE_HOVER;
  } else if (style === TabStyle.SELECTED) {
    plate = TabColor.PLATE_SELECTED;
  }

  let ink: Int = TabColor.LABEL_REST;
  if (style === TabStyle.HOVER) {
    ink = TabColor.LABEL_HOVER;
  }

  if (onMobile()) {
    return (
      <layer w="fill" h="fill">
        <ThinBox />
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.TAB_PLATE_INSET }}
          h={{ fill: Layout.TAB_PLATE_INSET }}
          color={plate}
          fill
        />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          font={SummaryFonts.ROW}
          text={label}
          align="center"
          valign="middle"
          shadow
          color={ink}
        />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => hoverTimeTab(tab)} onMouseLeave={() => unhoverTimeTab()}>
      <ThinBox />
      <rect
        x="center"
        y="center"
        w={{ fill: Layout.TAB_PLATE_INSET }}
        h={{ fill: Layout.TAB_PLATE_INSET }}
        color={plate}
        fill
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={SummaryFonts.ROW}
        text={label}
        align="center"
        valign="middle"
        shadow
        color={ink}
      />
    </layer>
  );
}
