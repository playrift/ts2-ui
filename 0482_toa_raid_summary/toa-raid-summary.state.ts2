import { sessionState, useState } from 'ts2';

import { TimeTab } from './toa-raid-summary.constants';
import { bossTimesTable, pathTimesTable } from './toa-raid-summary.refs';

export const summaryTimeTab = sessionState(TimeTab.BOSSES);

export const summaryTabHover = sessionState(-1);

export function showTimeTab(tab: Int): void {
  const [, setTab] = useState(summaryTimeTab);
  if (tab === TimeTab.BOSSES) {
    setHidden(pathTimesTable, true);
    setHidden(bossTimesTable, false);
    setTab(TimeTab.BOSSES);
  } else if (tab === TimeTab.PATHS) {
    setHidden(pathTimesTable, false);
    setHidden(bossTimesTable, true);
    setTab(TimeTab.PATHS);
  }
}

function setHidden(component: ComponentId, hidden: Boolean): void {
  component.hide = hidden;
}

export function resetTimeTab(): void {
  showTimeTab(TimeTab.BOSSES);
}

export function hoverTimeTab(tab: Int): void {
  const [, setHover] = useState(summaryTabHover);
  setHover(tab);
}

export function unhoverTimeTab(): void {
  const [, setHover] = useState(summaryTabHover);
  setHover(-1);
}
