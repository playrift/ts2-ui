import { useServerState } from 'ts2';
import { AlchemyColor, AlchemyFonts, AlchemyVarbits, FREE_ALCHEMIES } from './lumbridge-alchemy.constants';

export function AlchemyCharges(): Component {
  const spent: Int = useServerState(AlchemyVarbits.SPENT);

  return (
    <text
      x="center"
      y="bottom"
      w="fill"
      h={{ fill: 250 }}
      text={`Charges: ${FREE_ALCHEMIES - spent}`}
      font={AlchemyFonts.FOOTER}
      color={spent < FREE_ALCHEMIES ? AlchemyColor.ORANGE : AlchemyColor.SPENT}
      shadow
      align="center"
      valign="bottom"
    />
  );
}
