import { useRef, useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import {
  AlchemyColor,
  AlchemyFonts,
  AlchemyIcons,
  AlchemyMode,
  AlchemyVarbits,
  OP_SOUND_MASK,
  Transparency,
} from './lumbridge-alchemy.constants';
import { setTransparency } from './settrans';

export function AlchemyModeSwitch(): Component {
  const mode: Int = useServerState(AlchemyVarbits.HIGH);
  const lowIdle = useRef();
  const highIdle = useRef();

  if (mode === AlchemyMode.HIGH) {
    return (
      <layer w="fill" h="fill">
        <sprite
          ref={lowIdle}
          x={0}
          y={0}
          w={24}
          h={24}
          sprite={AlchemyIcons.LOW_IDLE}
          options={['Low Alchemy']}
          onMouseRepeat={() => setTransparency(lowIdle, Transparency.HOVER)}
          onMouseLeave={() => setTransparency(lowIdle, Transparency.CLEAR)}
          onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
        />
        <sprite x={24} y={0} w={24} h={24} sprite={AlchemyIcons.HIGH_ACTIVE} options={['High Alchemy']} />
        <AlchemyHeading text="High Alchemy" />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill">
      <sprite x={0} y={0} w={24} h={24} sprite={AlchemyIcons.LOW_ACTIVE} options={['Low Alchemy']} />
      <sprite
        ref={highIdle}
        x={24}
        y={0}
        w={24}
        h={24}
        sprite={AlchemyIcons.HIGH_IDLE}
        options={['High Alchemy']}
        onMouseRepeat={() => setTransparency(highIdle, Transparency.HOVER)}
        onMouseLeave={() => setTransparency(highIdle, Transparency.CLEAR)}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      />
      <AlchemyHeading text="Low Alchemy" />
    </layer>
  );
}

function AlchemyHeading({ text }: { text: String }): Component {
  return (
    <text
      x="center"
      y={0}
      w="fill"
      h={22}
      text={text}
      font={AlchemyFonts.TITLE}
      color={AlchemyColor.ORANGE}
      shadow
      align="center"
      valign="middle"
    />
  );
}
