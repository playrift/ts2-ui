import { useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import {
  AlchemyColor,
  AlchemyFonts,
  AlchemyIcons,
  AlchemyMode,
  AlchemyVarbits,
  OP_SOUND_MASK,
  Transparency,
} from './lumbridge-alchemy.constants';
import { setTransparency } from '../lib/lib.components';

export function AlchemyModeSwitch(): Component {
  const mode: Int = useServerState(AlchemyVarbits.HIGH);
  if (mode === AlchemyMode.HIGH) {
    return (
      <layer w="fill" h="fill">
        <sprite
          x={0}
          y={0}
          w={24}
          h={24}
          sprite={AlchemyIcons.LOW_IDLE}
          options={['Low Alchemy']}
          onMouseRepeat={(event) => setTransparency(event.self, Transparency.HOVER)}
          onMouseLeave={(event) => setTransparency(event.self, Transparency.CLEAR)}
          onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
        />
        <sprite x={24} y={0} w={24} h={24} sprite={AlchemyIcons.HIGH_ACTIVE} options={['High Alchemy']} />
        <AlchemyHeading text="High Alchemy" />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill">
      <sprite x={0} y={0} w={24} h={24} sprite={AlchemyIcons.LOW_ACTIVE} options={['Low Alchemy']} />
      <sprite
        x={24}
        y={0}
        w={24}
        h={24}
        sprite={AlchemyIcons.HIGH_IDLE}
        options={['High Alchemy']}
        onMouseRepeat={(event) => setTransparency(event.self, Transparency.HOVER)}
        onMouseLeave={(event) => setTransparency(event.self, Transparency.CLEAR)}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      />
      <AlchemyHeading text="Low Alchemy" />
    </layer>
  );
}

function AlchemyHeading({ text }: { text: String }): Component {
  return (
    <text
      x="center"
      y={0}
      w="fill"
      h={22}
      text={text}
      font={AlchemyFonts.TITLE}
      color={AlchemyColor.ORANGE}
      shadow
      align="center"
      valign="middle"
    />
  );
}
