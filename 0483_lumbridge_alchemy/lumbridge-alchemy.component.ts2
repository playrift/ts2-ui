import { AlchemyCharges } from './alchemy-charges.component';
import { AlchemyItemGrid } from './alchemy-item-grid.component';
import { AlchemyModeSwitch } from './alchemy-mode-switch.component';
import { AlchemyArt, BoxInset, OP_SOUND_MASK } from './lumbridge-alchemy.constants';
import { opsound } from '../lib/lib.helpers';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';

export function LumbridgeAlchemy(): Component {
  return (
    <>
      <AlchemyModeSwitch />

      <sprite
        x={{ right: 3 }}
        y={3}
        w={16}
        h={16}
        sprite={AlchemyArt.CLOSE}
        hover={{ sprite: AlchemyArt.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      />

      <layer x="center" y={22} w={172} h={228}>
        <sprite
          x="center"
          y="center"
          w={{ fill: BoxInset.BACKING }}
          h={{ fill: BoxInset.BACKING }}
          sprite={AlchemyArt.BACKING}
          tiling
        />

        <layer x="center" y="center" w={{ fill: BoxInset.GRID }} h={{ fill: BoxInset.GRID }}>
          <AlchemyItemGrid />
        </layer>

        <ThinStoneBoxEntrypoint />
      </layer>

      <AlchemyCharges />
    </>
  );
}
