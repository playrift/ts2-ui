import { graphicSwapper } from '../lib/lib.helpers';
import {
  CallLabels,
  HornArt,
  HornColor,
  HornFonts,
  Layout,
  RoleModels,
  RoleRows,
  SLOT_PLACEHOLDER,
} from './barbassault-horn.constants';

function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function BarbassaultHorn(): Component {
  return (
    <>
      <rect w={Layout.PANE_W} h={Layout.PANE_H} color={HornColor.PANE} fill transparency={Layout.PANE_TRANSPARENCY} />

      {RoleRows.map((role) => (
        <text
          x={Layout.HEADING_X}
          y={role.headingY}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          font={HornFonts.HEADING}
          color={HornColor.TEXT}
          shadow
          text={role.heading}
        />
      ))}

      {RoleRows.map((role) => (
        <text
          x={Layout.SLOT_X}
          y={role.slotY}
          w={Layout.SLOT_W}
          h={Layout.SLOT_H}
          font={HornFonts.LABEL}
          color={HornColor.TEXT}
          shadow
          text={SLOT_PLACEHOLDER}
        />
      ))}

      {RoleModels.map((role) => (
        <model
          x={role.x}
          y={role.y}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={role.model}
          pitch={role.pitch}
          yaw={role.yaw}
          zoom={role.zoom}
        />
      ))}

      {CallLabels.map((call) => (
        <text
          x={Layout.CALL_X}
          y={call.y}
          w={call.w}
          h={Layout.CALL_H}
          font={HornFonts.LABEL}
          color={HornColor.TEXT}
          shadow
          options={['Call']}
          onMouseEnter={(event) => {
            textColourSwapper(event.component, HornColor.HOVER);
          }}
          onMouseLeave={(event) => {
            textColourSwapper(event.component, HornColor.TEXT);
          }}
          text={call.text}
        />
      ))}

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        font={HornFonts.TITLE}
        color={HornColor.TEXT}
        align="center"
        shadow
        text="Horn of Glory"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={HornArt.CLOSE}
        options={['Close']}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, HornArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, HornArt.CLOSE);
        }}
      />

      <text
        x={Layout.CAPTION_X}
        y={Layout.CAPTION_Y}
        w={Layout.CAPTION_W}
        h={Layout.CAPTION_H}
        font={HornFonts.LABEL}
        color={HornColor.TEXT}
        shadow
        text="Call out :"
      />
    </>
  );
}
