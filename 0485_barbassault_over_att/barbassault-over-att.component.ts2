import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BA_ORANGE, BarbassaultFonts, BarbassaultIcons, BarbassaultOverlay } from './barbassault-overlay.shared';
import { HIGHLIGHT, HIGHLIGHT_WASH, Layout } from './barbassault-over-att.constants';

const content = createRef('barbassault_over_att_content');

export function BarbassaultOverAtt_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, BarbassaultOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <rect
            x={{ right: Layout.HIGHLIGHT_RIGHT }}
            y={Layout.HIGHLIGHT_Y}
            w={Layout.HIGHLIGHT_W}
            h={Layout.HIGHLIGHT_H}
            color={HIGHLIGHT}
            fill
            transparency={HIGHLIGHT_WASH}
            hide
          />

          <sprite
            x={{ right: Layout.ICON_RIGHT }}
            y={Layout.WAVE_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={BarbassaultIcons.WAVE}
          />
          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={Layout.WAVE_TEXT_Y}
            w={Layout.WAVE_TEXT_W}
            h={Layout.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text="Wave 1"
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Layout.ICON_RIGHT }}
            y={Layout.HEAR_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={BarbassaultIcons.HEAR}
          />
          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={Layout.HEAR_TEXT_Y}
            w={Layout.HEAR_TEXT_W}
            h={Layout.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text="Controlled/"
            align="right"
            shadow
            color={BA_ORANGE}
          />
          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={Layout.HEAR_DETAIL_Y}
            w={Layout.HEAR_DETAIL_W}
            h={Layout.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text="Bullet/Wind"
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Layout.ICON_RIGHT }}
            y={Layout.SHOUT_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={BarbassaultIcons.SHOUT}
          />
          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={Layout.SHOUT_TEXT_Y}
            w={Layout.SHOUT_TEXT_W}
            h={Layout.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text="Green eggs"
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Layout.ICON_RIGHT }}
            y={Layout.ROLE_ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            sprite={BarbassaultIcons.COLLECTOR}
          />
          <text
            x={{ right: Layout.TEXT_RIGHT }}
            y={Layout.ROLE_TEXT_Y}
            w={Layout.ROLE_TEXT_W}
            h={Layout.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text="Collector"
            align="right"
            shadow
            color={BA_ORANGE}
          />
        </layer>
      </layer>
    </layer>
  );
}
