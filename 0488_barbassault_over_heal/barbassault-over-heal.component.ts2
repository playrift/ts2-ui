import { createRef } from 'ts2';

import {
  BA_ORANGE,
  BarbassaultFonts,
  BarbassaultIcons,
  BarbassaultOverlay,
} from '../0485_barbassault_over_att/barbassault-overlay.shared';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Board,
  BoardFonts,
  BOARD_INK,
  Card,
  CardText,
  ColumnRules,
  HealerBadge,
  HealerBoardDodge,
  HeadSlots,
  HIGHLIGHT,
  HIGHLIGHT_WASH,
  MedicAnim,
  MedicIcon,
  Players,
} from './barbassault-over-heal.constants';

const contentTop = createRef('barbassault_over_heal_content_top');

const contentBottom = createRef('barbassault_over_heal_content_bottom');

export function BarbassaultOverHeal(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentTop, BarbassaultOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0)
        }
      >
        <layer ref={contentTop} x="right" y={0} w={Card.PLATE_W} h={Card.PLATE_H}>
          <rect
            x={{ right: Card.HIGHLIGHT_RIGHT }}
            y={Card.HIGHLIGHT_Y}
            w={Card.HIGHLIGHT_W}
            h={Card.HIGHLIGHT_H}
            color={HIGHLIGHT}
            fill
            transparency={HIGHLIGHT_WASH}
            hide
          />

          <sprite
            x={{ right: Card.ICON_RIGHT }}
            y={Card.WAVE_ICON_Y}
            w={Card.ICON_W}
            h={Card.ICON_H}
            sprite={BarbassaultIcons.WAVE}
          />
          <text
            x={{ right: Card.TEXT_RIGHT }}
            y={Card.WAVE_TEXT_Y}
            w={Card.WAVE_TEXT_W}
            h={Card.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text={CardText.WAVE}
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Card.ICON_RIGHT }}
            y={Card.HEAR_ICON_Y}
            w={Card.ICON_W}
            h={Card.ICON_H}
            sprite={BarbassaultIcons.HEAR}
          />
          <text
            x={{ right: Card.TEXT_RIGHT }}
            y={Card.HEAR_TEXT_Y}
            w={Card.HEAR_TEXT_W}
            h={Card.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text={CardText.HEAR}
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Card.ICON_RIGHT }}
            y={Card.SHOUT_ICON_Y}
            w={Card.ICON_W}
            h={Card.ICON_H}
            sprite={BarbassaultIcons.SHOUT}
          />
          <text
            x={{ right: Card.TEXT_RIGHT }}
            y={Card.SHOUT_TEXT_Y}
            w={Card.SHOUT_TEXT_W}
            h={Card.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text={CardText.SHOUT}
            align="right"
            shadow
            color={BA_ORANGE}
          />

          <sprite
            x={{ right: Card.ICON_RIGHT }}
            y={Card.ROLE_ICON_Y}
            w={Card.ICON_W}
            h={Card.ICON_H}
            sprite={HealerBadge.DEFENDER}
          />
          <text
            x={{ right: Card.TEXT_RIGHT }}
            y={Card.ROLE_TEXT_Y}
            w={Card.ROLE_TEXT_W}
            h={Card.TEXT_H}
            font={BarbassaultFonts.OVERLAY}
            text={CardText.ROLE}
            align="right"
            shadow
            color={BA_ORANGE}
          />
        </layer>
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contentBottom, HealerBoardDodge.DODGE, Anchor.CENTRE, Anchor.BOTTOM, 0)
        }
      >
        <layer ref={contentBottom} x="center" y="bottom" w={Board.SHELL_W} h={Board.SHELL_H}>
          <layer x="center" y={{ bottom: Board.ROW_BOTTOM }} w={Board.ROW_W} h={Board.ROW_H}>
            <rect
              x="center"
              y="bottom"
              w="fill"
              h={Board.LOWER_BAND_H}
              color={BOARD_INK}
              fill
              transparency={Board.LOWER_BAND_WASH}
            />
            <rect
              x="center"
              y={0}
              w="fill"
              h={Board.UPPER_BAND_H}
              color={BOARD_INK}
              fill
              transparency={Board.UPPER_BAND_WASH}
            />

            <text
              x={Players.P1.nameX}
              y={Board.NAME_Y}
              w={Board.NAME_W}
              h={Board.NAME_H}
              font={BoardFonts.BOARD}
              text={Players.P1.name}
              align="center"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={Players.P1.hpX}
              y={Board.HP_Y}
              w={Players.P1.hpW}
              h={Board.HP_H}
              font={BoardFonts.BOARD}
              text={Players.P1.hp}
              shadow
              color={BA_ORANGE}
            />
            <layer hide x={Players.P1.layerX} y="bottom" w={Board.MEDIC_LAYER_W} h={Board.MEDIC_LAYER_H}>
              <model
                x={Board.MEDIC_ICON_X}
                y="bottom"
                w={Board.MEDIC_ICON_W}
                h={Board.MEDIC_ICON_H}
                model={MedicIcon.MODEL}
                anim={MedicAnim.FLASH}
                zoom={MedicIcon.ZOOM}
              />
            </layer>

            <text
              x={Players.P2.nameX}
              y={Board.NAME_Y}
              w={Board.NAME_W}
              h={Board.NAME_H}
              font={BoardFonts.BOARD}
              text={Players.P2.name}
              align="center"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={Players.P2.hpX}
              y={Board.HP_Y}
              w={Players.P2.hpW}
              h={Board.HP_H}
              font={BoardFonts.BOARD}
              text={Players.P2.hp}
              shadow
              color={BA_ORANGE}
            />
            <layer hide x={Players.P2.layerX} y="bottom" w={Board.MEDIC_LAYER_W} h={Board.MEDIC_LAYER_H}>
              <model
                x={Board.MEDIC_ICON_X}
                y="bottom"
                w={Board.MEDIC_ICON_W}
                h={Board.MEDIC_ICON_H}
                model={MedicIcon.MODEL}
                anim={MedicAnim.FLASH}
                zoom={MedicIcon.ZOOM}
              />
            </layer>

            <text
              x={Players.P3.nameX}
              y={Board.NAME_Y}
              w={Board.NAME_W}
              h={Board.NAME_H}
              font={BoardFonts.BOARD}
              text={Players.P3.name}
              align="center"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={Players.P3.hpX}
              y={Board.HP_Y}
              w={Players.P3.hpW}
              h={Board.HP_H}
              font={BoardFonts.BOARD}
              text={Players.P3.hp}
              shadow
              color={BA_ORANGE}
            />
            <layer hide x={Players.P3.layerX} y="bottom" w={Board.MEDIC_LAYER_W} h={Board.MEDIC_LAYER_H}>
              <model
                x={Board.MEDIC_ICON_X}
                y="bottom"
                w={Board.MEDIC_ICON_W}
                h={Board.MEDIC_ICON_H}
                model={MedicIcon.MODEL}
                anim={MedicAnim.FLASH}
                zoom={MedicIcon.ZOOM}
              />
            </layer>

            <text
              x={Players.P4.nameX}
              y={Board.NAME_Y}
              w={Board.NAME_W}
              h={Board.NAME_H}
              font={BoardFonts.BOARD}
              text={Players.P4.name}
              align="center"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={Players.P4.hpX}
              y={Board.HP_Y}
              w={Players.P4.hpW}
              h={Board.HP_H}
              font={BoardFonts.BOARD}
              text={Players.P4.hp}
              shadow
              color={BA_ORANGE}
            />
            <layer hide x={Players.P4.layerX} y="bottom" w={Board.MEDIC_LAYER_W} h={Board.MEDIC_LAYER_H}>
              <model
                x={Board.MEDIC_ICON_X}
                y="bottom"
                w={Board.MEDIC_ICON_W}
                h={Board.MEDIC_ICON_H}
                model={MedicIcon.MODEL}
                anim={MedicAnim.FLASH}
                zoom={MedicIcon.ZOOM}
              />
            </layer>

            <rect x="center" y={0} w="fill" h={Board.RULE_H} color={BOARD_INK} />
            <rect x="center" y="bottom" w="fill" h={Board.RULE_H} color={BOARD_INK} />

            {ColumnRules.map((rule) => (
              <rect x={rule.x} y="center" w={Board.COLUMN_RULE_W} h="fill" color={BOARD_INK} />
            ))}

            {HeadSlots.map((slot) => (
              <model x={slot.x} y="bottom" w={Board.HEAD_W} h={Board.HEAD_H} zoom={Board.HEAD_ZOOM} />
            ))}
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
