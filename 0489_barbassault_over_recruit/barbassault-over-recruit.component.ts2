import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  BA_ORANGE,
  BarbassaultFonts,
  BarbassaultIcons,
  BarbassaultOverlay,
} from '../0485_barbassault_over_att/barbassault-overlay.shared';
import { Layout, RecruitRows } from './barbassault-over-recruit.constants';

const timerHost = createRef('0489_barbassault_over_recruit_timer_host');

const content = createRef('barbassault_over_recruit_content');

export function BarbassaultOverRecruit_(): Component {
  useInterval(
    () => overlayRelayout(timerHost, content, BarbassaultOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0),
    timerHost,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <text
            x={{ right: Layout.HEADING_RIGHT }}
            y={Layout.HEADING_Y}
            w={Layout.HEADING_W}
            h={Layout.HEADING_H}
            font={BarbassaultFonts.OVERLAY}
            text="# Players in room:"
            align="center"
            shadow
            color={BA_ORANGE}
          />

          {RecruitRows.map((row) => (
            <text
              x={{ right: Layout.LABEL_RIGHT }}
              y={row.labelY}
              w={Layout.LABEL_W}
              h={Layout.ROW_H}
              font={BarbassaultFonts.OVERLAY}
              text={row.label}
              shadow
              color={BA_ORANGE}
            />
          ))}

          {RecruitRows.map((row) => (
            <text
              x={{ right: Layout.COUNT_RIGHT }}
              y={row.labelY}
              w={Layout.COUNT_W}
              h={Layout.ROW_H}
              font={BarbassaultFonts.OVERLAY}
              text="0"
              shadow
              color={BA_ORANGE}
            />
          ))}

          {RecruitRows.map((row) => (
            <layer
              x={{ right: Layout.ARROW_LAYER_RIGHT }}
              y={row.arrowY}
              w={Layout.ARROW_LAYER_W}
              h={Layout.ARROW_LAYER_H}
              hide
            >
              <sprite
                x={Layout.ARROW_X}
                y={row.arrowIconY}
                w={Layout.ARROW_W}
                h={Layout.ARROW_H}
                sprite={BarbassaultIcons.ARROW}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
