import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  BoardCamera,
  HONOUR_ROWS,
  LEVEL_ROWS,
  Layout,
  NEXT_ROWS,
  RewardSlots,
  RoleNames,
  StatArt,
  StatColor,
  StatFonts,
  StatModel,
} from './barbassault-playerstat.constants';

export function BarbassaultPlayerstat(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={StatModel.BOARD}
        zoom={BoardCamera.ZOOM}
        offsetY={BoardCamera.OFFSET_Y}
      />

      <text
        x={Layout.HEADING_X}
        y={Layout.HEADING_Y}
        w={Layout.HEADING_W}
        h={Layout.HEADING_H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        align="right"
        shadow
        text="Player status for:"
      />

      <text
        x={Layout.ROLE_HEAD_X}
        y={Layout.ROLE_HEAD_Y}
        w={Layout.ROLE_HEAD_W}
        h={Layout.ROLE_HEAD_H}
        font={StatFonts.LABEL}
        color={StatColor.ROLE_HEAD}
        shadow
        text="Role"
      />

      <text
        x={Layout.HONOUR_HEAD_X}
        y={Layout.HONOUR_HEAD_Y}
        w={Layout.HONOUR_HEAD_W}
        h={Layout.HONOUR_HEAD_H}
        font={StatFonts.LABEL}
        color={StatColor.HONOUR_HEAD}
        align="center"
        shadow
        text="Current honour points"
      />

      {RoleNames.map((role) => (
        <text
          x={Layout.ROLE_X}
          y={role.y}
          w={role.w}
          h={Layout.ROLE_H}
          font={StatFonts.LABEL}
          color={StatColor.TEXT}
          shadow
          text={role.text}
        />
      ))}

      <text
        x={Layout.NEXT_HEAD_X}
        y={Layout.NEXT_HEAD_Y}
        w={Layout.NEXT_HEAD_W}
        h={Layout.NEXT_HEAD_H}
        font={StatFonts.LABEL}
        color={StatColor.NEXT_HEAD}
        align="center"
        shadow
        text="Points for next level"
      />

      {NEXT_ROWS.map((y) => (
        <text
          x={Layout.COL_NEXT}
          y={y}
          w={Layout.DIGIT_W}
          h={Layout.DIGIT_H}
          font={StatFonts.LABEL}
          color={StatColor.TEXT}
          shadow
          text="0"
        />
      ))}

      <text
        x={Layout.LEVEL_HEAD_X}
        y={Layout.LEVEL_HEAD_Y}
        w={Layout.LEVEL_HEAD_W}
        h={Layout.LEVEL_HEAD_H}
        font={StatFonts.LABEL}
        color={StatColor.LEVEL_HEAD}
        shadow
        text="Level"
      />

      {LEVEL_ROWS.map((y) => (
        <text
          x={Layout.COL_LEVEL}
          y={y}
          w={Layout.DIGIT_W}
          h={Layout.DIGIT_H}
          font={StatFonts.LABEL}
          color={StatColor.TEXT}
          shadow
          text="0"
        />
      ))}

      <text
        x={Layout.NAME_X}
        y={Layout.NAME_Y}
        w={Layout.NAME_W}
        h={Layout.NAME_H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        shadow
      />

      {HONOUR_ROWS.map((y) => (
        <text
          x={Layout.COL_HONOUR}
          y={y}
          w={Layout.DIGIT_W}
          h={Layout.DIGIT_H}
          font={StatFonts.LABEL}
          color={StatColor.TEXT}
          shadow
          text="0"
        />
      ))}

      <text
        x={Layout.WAVE_LABEL_X}
        y={Layout.WAVE_Y}
        w={Layout.WAVE_LABEL_W}
        h={Layout.DIGIT_H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        shadow
        text="Current wave :"
      />
      <text
        x={Layout.WAVE_VALUE_X}
        y={Layout.WAVE_Y}
        w={Layout.DIGIT_W}
        h={Layout.DIGIT_H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        shadow
        text="0"
      />

      <text
        x={Layout.REWARD_HEAD_X}
        y={Layout.REWARD_HEAD_Y}
        w={Layout.REWARD_HEAD_W}
        h={Layout.REWARD_HEAD_H}
        font={StatFonts.LABEL}
        color={StatColor.REWARD_HEAD}
        align="center"
        shadow
        text="Reward next level"
      />

      <text
        x={RewardSlots.X}
        y={RewardSlots.Y_1}
        w={RewardSlots.W}
        h={RewardSlots.H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        shadow
        text={RewardSlots.PLACEHOLDER}
      />
      <text
        x={RewardSlots.X}
        y={RewardSlots.Y_2}
        w={RewardSlots.W}
        h={RewardSlots.H}
        font={StatFonts.LABEL}
        color={StatColor.REWARD_ROW_2}
        shadow
        text={RewardSlots.PLACEHOLDER}
      />
      <text
        x={RewardSlots.X}
        y={RewardSlots.Y_3}
        w={RewardSlots.W}
        h={RewardSlots.H_3}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        valign="middle"
        shadow
        text={RewardSlots.PLACEHOLDER}
      />
      <text
        x={RewardSlots.X}
        y={RewardSlots.Y_4}
        w={RewardSlots.W}
        h={RewardSlots.H}
        font={StatFonts.LABEL}
        color={StatColor.TEXT}
        shadow
        text={RewardSlots.PLACEHOLDER}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={StatArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, StatArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, StatArt.CLOSE);
        }}
      />
    </>
  );
}
