import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { HonourPoints } from './honour-points.component';
import { RewardList } from './reward-list.component';
import { RewardColor, RewardFonts, RewardFrame, RewardModelIds } from './barbassault-reward-shop.constants';

export function BarbassaultRewardShop(): Component {
  return (
    <>
      <layer x={RewardFrame.ROOT_X} y={RewardFrame.ROOT_Y} w={RewardFrame.ROOT_W} h={RewardFrame.ROOT_H}>
        <SteelBorderEntrypoint title="Barbarian Assault Reward Shop" />
      </layer>

      <layer x={RewardFrame.ROOT_X} y={RewardFrame.ROOT_Y} w={RewardFrame.ROOT_W} h={RewardFrame.ROOT_H}>
        <RewardList />
      </layer>

      <text
        x={RewardFrame.HEADING_X}
        y={RewardFrame.HEADING_Y}
        w={RewardFrame.HEADING_W}
        h={RewardFrame.HEADING_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text="Select your reward"
      />

      <model
        x={RewardFrame.ICON_X}
        y={RewardFrame.ICON_Y}
        w={RewardFrame.ICON_W}
        h={RewardFrame.ICON_H}
        model={RewardModelIds.ACCEPT_ICON}
        zoom={RewardFrame.ICON_ZOOM}
        pitch={RewardFrame.ICON_PITCH}
        yaw={RewardFrame.ICON_YAW}
      />

      <text
        x={RewardFrame.ACCEPT_TEXT_X}
        y={RewardFrame.ACCEPT_TEXT_Y}
        w={RewardFrame.ACCEPT_TEXT_W}
        h={RewardFrame.ACCEPT_TEXT_H}
        font={RewardFonts.BUTTON}
        color={RewardColor.LABEL}
        shadow
        valign="middle"
        text=" Accept"
      />

      <rect
        x={RewardFrame.ACCEPT_X}
        y={RewardFrame.ACCEPT_Y}
        w={RewardFrame.ACCEPT_W}
        h={RewardFrame.ACCEPT_H}
        color={RewardColor.OLIVE}
        options={['Accept']}
        onMouseEnter={(event) => {
          event.self.color = RewardColor.HOVER;
        }}
        onMouseLeave={(event) => {
          event.self.color = RewardColor.OLIVE;
        }}
        onOptionSelect={(event) => {
          event.self.color = RewardColor.OLIVE;
        }}
      />

      <text
        x={RewardFrame.LABEL_LEFT_X}
        y={RewardFrame.ROW_TOP_LEFT_Y}
        w={RewardFrame.LABEL_W}
        h={RewardFrame.LABEL_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text="Attacker Honour Points:"
      />
      <text
        x={RewardFrame.LABEL_LEFT_X}
        y={RewardFrame.ROW_BOTTOM_LEFT_Y}
        w={RewardFrame.LABEL_W}
        h={RewardFrame.LABEL_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text="Defender Honour Points:"
      />
      <text
        x={RewardFrame.LABEL_RIGHT_X}
        y={RewardFrame.ROW_TOP_RIGHT_Y}
        w={RewardFrame.LABEL_W}
        h={RewardFrame.LABEL_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text="Collector Honour Points:"
      />
      <text
        x={RewardFrame.LABEL_RIGHT_X}
        y={RewardFrame.ROW_BOTTOM_RIGHT_Y}
        w={RewardFrame.LABEL_W}
        h={RewardFrame.LABEL_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text="Healer Honour Points:"
      />

      <HonourPoints />
    </>
  );
}
