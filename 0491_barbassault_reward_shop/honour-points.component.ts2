        y={RewardFrame.ROW_BOTTOM_LEFT_Y}
        w={RewardFrame.VALUE_W}
        h={RewardFrame.VALUE_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text={stringOf(defenderPoints())}
      />

      <text
        x={RewardFrame.VALUE_RIGHT_X}
        y={RewardFrame.ROW_TOP_RIGHT_Y}
        w={RewardFrame.VALUE_W}
        h={RewardFrame.VALUE_H}
        font={RewardFonts.BODY}
        color={RewardColor.LABEL}
        shadow
        text={stringOf(collectorPoints())}
