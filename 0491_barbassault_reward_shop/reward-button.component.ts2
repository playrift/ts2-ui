import { predictServerState } from 'ts2';
import { rewardBuyable, rewardDescription } from './reward-strings';
import { RewardColor, RewardLayout, RewardVarps } from './barbassault-reward-shop.constants';

export function RewardButton({
  row,
  att,
  col,
  def,
  heal,
  selected,
  unlocks,
  kills,
  gambleWord,
}: {
  row: Int;
  att: Int;
  col: Int;
  def: Int;
  heal: Int;
  selected: Int;
  unlocks: Int;
  kills: Int;
  gambleWord: String;
}): Component {
  const step: Int = RewardLayout.ROW_STEP * (row - 1);

  const subject: String = `<col=ff9040>${rewardDescription(row, att, col, def, heal, gambleWord)}</col>`;

  const buyable: Int = rewardBuyable(row, unlocks, kills);

  return selected === row ? (
    <rect
      x={RewardLayout.BUTTON_X}
      y={RewardLayout.BUTTON_Y + step}
      w={RewardLayout.BUTTON_W}
      h={RewardLayout.BUTTON_H}
      color={RewardColor.SELECTED}
      options={['Select']}
      optionSubject={subject}
      onOptionSelect={(event) => {
        if (buyable === 1) {
          predictServerState(RewardVarps.SELECTED, row);
        } else {
          event.self.color = RewardColor.OLIVE;
        }
      }}
    />
  ) : (
    <rect
      x={RewardLayout.BUTTON_X}
      y={RewardLayout.BUTTON_Y + step}
      w={RewardLayout.BUTTON_W}
      h={RewardLayout.BUTTON_H}
      color={RewardColor.OLIVE}
      options={['Select']}
      optionSubject={subject}
      onMouseEnter={(event) => {
        event.self.color = RewardColor.HOVER;
      }}
      onMouseLeave={(event) => {
        event.self.color = RewardColor.OLIVE;
      }}
      onOptionSelect={(event) => {
        if (buyable === 1) {
          predictServerState(RewardVarps.SELECTED, row);
        } else {
          event.self.color = RewardColor.OLIVE;
        }
      }}
    />
  );
}
