import { hasBit } from '../lib/lib.engine';
import { stringFindAndReplace } from './string-find-and-replace';
import { RewardNames, RewardQueenGate, RewardRows, RoleLevel } from './barbassault-reward-shop.constants';

export function roleLevelOf(row: Int, att: Int, col: Int, def: Int, heal: Int): Int {
  if (row === RewardRows.ATTACKER) {
    return att;
  }
  if (row === RewardRows.COLLECTOR) {
    return col;
  }
  if (row === RewardRows.DEFENDER) {
    return def;
  }
  return heal;
}

export function roleWordOf(row: Int): String {
  if (row === RewardRows.ATTACKER) {
    return 'Attacker';
  }
  if (row === RewardRows.COLLECTOR) {
    return 'Collector';
  }
  if (row === RewardRows.DEFENDER) {
    return 'Defender';
  }
  return 'Healer';
}

export function rewardDescription(row: Int, att: Int, col: Int, def: Int, heal: Int, gambleWord: String): String {
  if (row > RewardRows.LAST_ROLE) {
    return stringFindAndReplace(RewardNames.get(row), 'XXXX', gambleWord);
  }

  const level: Int = roleLevelOf(row, att, col, def, heal);
  const role: String = roleWordOf(row);
  if (level < RoleLevel.MASTERED) {
    return `${role} level up to ${stringOf(level + 1)}`;
  }
  return `${role} level up complete`;
}

export function rewardBuyable(row: Int, unlocks: Int, kills: Int): Int {
  return hasBit(unlocks, row - 1) && (!RewardQueenGate.get(row) || kills > 0) ? 1 : 0;
}
