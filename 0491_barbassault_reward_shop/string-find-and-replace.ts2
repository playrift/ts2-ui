import { CS2 } from 'ts2';

export function stringFindAndReplace(subject: String, search: String, replacement: String): String {
  if (CS2.compare(search, replacement) === 0) {
    return subject;
  }

  const searchLength: Int = search.length;
  if (searchLength <= 0) {
    return subject;
  }

  let out: String = subject;
  let at: Int = out.indexOf(search, 0);
  while (at !== -1) {
    const total: Int = out.length;
    out = `${out.substring(0, at)}${replacement}${out.substring(at + searchLength, total)}`;
    at = out.indexOf(search, 0);
  }
  return out;
}
