import { predictServerState, useServerState, useState } from 'ts2';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import {
  SoulWarsClanGamesColor,
  SoulWarsClanGamesFont,
  SoulWarsClanGamesSound,
  SoulWarsClanGamesVarbits,
} from './soul-wars-clan-games.constants';

export function acceptChallenge(): void {
  playSound(SoulWarsClanGamesSound.CONFIRM);
  predictServerState(SoulWarsClanGamesVarbits.CLAN_CHALLENGE_ACCEPT, 1);
}

export function ConfirmButton(): Component {
  const accepted: Int = useServerState(SoulWarsClanGamesVarbits.CLAN_CHALLENGE_ACCEPT);
  const mobile: Boolean = onMobile();
  const [hovered, setHovered] = useState(0);

  const label: String = accepted === 1 ? 'Waiting' : 'Confirm';
  const color: Int = accepted === 1 ? SoulWarsClanGamesColor.WAITING : SoulWarsClanGamesColor.LABEL;
  const op: String = accepted === 1 ? '' : 'Confirm';

  return (
    <layer
      options={[op]}
      onOptionSelect={() => acceptChallenge()}
      onMouseRepeat={() => {
        if (!mobile) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          setHovered(0);
        }
      }}
    >
      {accepted === 1 || hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}

      <text
        w="fill"
        h="fill"
        text={label}
        font={SoulWarsClanGamesFont.BODY}
        color={color}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
