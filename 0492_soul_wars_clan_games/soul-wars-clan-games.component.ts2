export function SoulWarsClanGames(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <SteelBorderEntrypoint title="" />

      <text
        x="center"
        y={Layout.TITLE_Y}
        w={{ fill: Layout.TITLE_W_INSET }}
        h={Layout.TITLE_H}
        font={SoulWarsClanGamesFont.TITLE}
        color={SoulWarsClanGamesColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <layer
        x={Layout.DISPLAY_X}
        y={Layout.DISPLAY_Y}
        w={{ fill: Layout.DISPLAY_W_INSET }}
        h={{ fill: Layout.DISPLAY_H_INSET }}
      >
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
