import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import {
  Board,
  Columns,
  HideyHolesColor,
  HideyHolesFonts,
  HideyHolesSprites,
  Panel,
  Tab,
} from './hidey-holes.constants';

const Pages = [
  { top: Board.PANE_TOP },
  { top: Board.PANE_TOP },
  { top: Board.PANE_TOP },
  { top: Board.PANE_TOP_LOW },
  { top: Board.PANE_TOP_LOW },
  { top: Board.PANE_TOP_LOW },
] as const;

const Tabs = [{ x: 0 }, { x: 80 }, { x: 160 }, { x: 240 }, { x: 320 }, { x: 400 }] as const;

export function HideyHoles(): Component {
  return (
    <layer x="center" y="center" w={Panel.W} h={{ fill: Panel.H_INSET }}>
      <layer x="center" y="center" w="fill" h="fill">
        <StoneBorderEntrypoint title="STASH Units" />
      </layer>

      <layer x="center" y={Board.TOP} w={{ fill: Board.W_INSET }} h={{ fill: Board.H_INSET }}>
        <sprite x="center" y="bottom" w="fill" h={{ fill: Board.HEADER_H }} sprite={HideyHolesSprites.BACKING} tiling />

        {Pages.map((page) => (
          <>
            <layer x={2} y={page.top} w={{ fill: Board.PANE_W_INSET }} h={{ fill: Board.PANE_H_INSET }} />
            <layer x={{ right: Board.BAR_INSET }} y={Board.PANE_TOP} w={Board.BAR_W} h={{ fill: Board.PANE_H_INSET }} />
          </>
        ))}

        <rect x="center" y="bottom" w="fill" h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <rect x="center" y={Columns.UNDERLINE_Y} w="fill" h={Columns.UNDERLINE_H} color={HideyHolesColor.RULE} />

        <text
          x={2}
          y={Board.HEADER_H}
          w={Columns.NARROW_W}
          h={Columns.HEAD_H}
          text="Built"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />
        <rect x={43} y="bottom" w={Columns.RULE_W} h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <text
          x={44}
          y={Board.HEADER_H}
          w={Columns.NARROW_W}
          h={Columns.HEAD_H}
          text="Filled"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />
        <rect x={85} y="bottom" w={Columns.RULE_W} h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <text
          x={86}
          y={Board.HEADER_H}
          w={Columns.WIDE_W}
          h={Columns.HEAD_H}
          text="Location"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />
        <rect x={232} y="bottom" w={Columns.RULE_W} h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <text
          x={234}
          y={Board.HEADER_H}
          w={Columns.NARROW_W}
          h={Columns.HEAD_H}
          text="Built"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />
        <rect x={275} y="bottom" w={Columns.RULE_W} h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <text
          x={276}
          y={Board.HEADER_H}
          w={Columns.NARROW_W}
          h={Columns.HEAD_H}
          text="Filled"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />
        <rect x={317} y="bottom" w={Columns.RULE_W} h={{ fill: Board.HEADER_H }} color={HideyHolesColor.RULE} />
        <text
          x={318}
          y={Board.HEADER_H}
          w={Columns.WIDE_W}
          h={Columns.HEAD_H}
          text="Location"
          font={HideyHolesFonts.HEAD}
          color={HideyHolesColor.HEAD}
          shadow
          align="center"
          valign="middle"
        />

        {Tabs.map((tab) => (
          <layer x={tab.x} y={0} w={Tab.W} h={Tab.H} />
        ))}
      </layer>
    </layer>
  );
}
