import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BA_ORANGE, BarbassaultOverlay } from '../0485_barbassault_over_att/barbassault-overlay.shared';
import { Layout, TimerFonts } from './barbassault-timer-overlay.constants';

const timerHost = createRef('0494_barbassault_timer_overlay_timer_host');

const xpDropDodger = createRef('barbassault_timer_overlay_xpdropdodger');

export function BarbassaultTimerOverlay_(): Component {
  useInterval(
    () => overlayRelayout(timerHost, xpDropDodger, BarbassaultOverlay.DODGE, Anchor.RIGHT, Anchor.TOP, 0),
    timerHost,
  );

  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={xpDropDodger} w="fill" h="fill">
          <layer x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
            <text
              x="right"
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              font={TimerFonts.VALUE}
              text="XX"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={{ right: Layout.LABEL_RIGHT }}
              y={Layout.LABEL_Y}
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              font={TimerFonts.LABEL}
              text="Time until next wave:"
              align="right"
              shadow
              color={BA_ORANGE}
            />
            <text
              x={{ right: Layout.HINT_RIGHT }}
              y={Layout.HINT_Y}
              w={Layout.HINT_W}
              h={Layout.HINT_H}
              font={TimerFonts.LABEL}
              text="(exit room to cancel)"
              shadow
              color={BA_ORANGE}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
