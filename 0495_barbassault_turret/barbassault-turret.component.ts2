import { graphicSwapper } from '../lib/lib.helpers';
import { textColourSwapper } from './barbassault-turret.helpers';
import {
  Buttons,
  Columns,
  Layout,
  Omega,
  TurretArt,
  TurretColor,
  TurretFont,
  TurretModel,
  TurretText,
} from './barbassault-turret.constants';

export function BarbassaultTurret(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill" noClickThrough>
      <text
        x={0}
        y={0}
        w={Layout.empty.W}
        h={Layout.empty.H}
        text={TurretText.EMPTY}
        font={TurretFont.EMPTY}
        align="center"
        valign="middle"
      />

      <layer x={0} y={0} w={Layout.buttons.W} h={Layout.buttons.H} hide>
        {Columns.map((column) => (
          <>
            <model
              x={column.lidX}
              y={column.lidY}
              w={Layout.MODEL_BOX}
              h={Layout.MODEL_BOX}
              model={column.lid}
              zoom={Layout.HOPPER_ZOOM}
            />
            <model
              x={column.poisonX}
              y={column.poisonY}
              w={Layout.MODEL_BOX}
              h={Layout.MODEL_BOX}
              model={TurretModel.POISON}
              zoom={Layout.EGG_ZOOM}
            />
            <text
              x={column.poisonCountX}
              y={column.poisonCountY}
              w={Layout.count.W}
              h={Layout.count.H}
              font={TurretFont.BUTTON}
              color={TurretColor.REST}
              shadow
              align="center"
              valign="middle"
            />
            <model
              x={column.explosiveX}
              y={column.explosiveY}
              w={Layout.MODEL_BOX}
              h={Layout.MODEL_BOX}
              model={TurretModel.EXPLOSIVE}
              zoom={Layout.EGG_ZOOM}
            />
            <text
              x={column.explosiveCountX}
              y={column.explosiveCountY}
              w={Layout.count.W}
              h={Layout.count.H}
              font={TurretFont.BUTTON}
              color={TurretColor.REST}
              shadow
              align="center"
              valign="middle"
            />
            <model
              x={column.stunX}
              y={column.stunY}
              w={Layout.MODEL_BOX}
              h={Layout.MODEL_BOX}
              model={TurretModel.STUN}
              zoom={Layout.EGG_ZOOM}
            />
            <text
              x={column.stunCountX}
              y={column.stunCountY}
              w={Layout.count.W}
              h={Layout.count.H}
              font={TurretFont.BUTTON}
              color={TurretColor.REST}
              shadow
              align="center"
              valign="middle"
            />
          </>
        ))}

        <model
          x={Omega.LID_X}
          y={Omega.LID_Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={TurretModel.HOPPER_QUEEN}
          zoom={Layout.QUEEN_ZOOM}
        />
        <model
          x={Omega.EGG_X}
          y={Omega.EGG_Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={TurretModel.OMEGA}
          zoom={Layout.EGG_ZOOM}
        />
        <text
          x={Omega.COUNT_X}
          y={Omega.COUNT_Y}
          w={Layout.count.W}
          h={Layout.count.H}
          font={TurretFont.BUTTON}
          color={TurretColor.REST}
          shadow
          align="center"
          valign="middle"
        />

        {Buttons.map((button) => (
          <text
            x={button.x}
            y={button.y}
            w={Layout.button.W}
            h={Layout.button.H}
            text={button.label}
            font={TurretFont.BUTTON}
            color={TurretColor.REST}
            shadow
            valign="middle"
            options={[button.option]}
            optionSubject={button.role}
            onMouseEnter={(event) => textColourSwapper(event.component, TurretColor.HOVER)}
            onMouseLeave={(event) => textColourSwapper(event.component, TurretColor.REST)}
          />
        ))}

        <text
          x={Omega.BUTTON_X}
          y={Omega.BUTTON_Y}
          w={Layout.button.W}
          h={Layout.button.H}
          text={TurretText.OMEGA}
          font={TurretFont.BUTTON}
          color={TurretColor.REST}
          shadow
          valign="middle"
          options={[Omega.OPTION]}
          optionSubject={Omega.ROLE}
          onMouseEnter={(event) => textColourSwapper(event.component, TurretColor.HOVER)}
          onMouseLeave={(event) => textColourSwapper(event.component, TurretColor.REST)}
        />
      </layer>

      <sprite
        x={Layout.close.X}
        y={Layout.close.Y}
        w={Layout.close.W}
        h={Layout.close.H}
        sprite={TurretArt.CLOSE}
        options={['Close']}
        onMouseEnter={(event) => graphicSwapper(event.component, TurretArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TurretArt.CLOSE)}
      />
    </layer>
  );
}
