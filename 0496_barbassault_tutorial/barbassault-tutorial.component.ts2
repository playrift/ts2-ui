import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  CloseSprites,
  Layout,
  TutorialColors,
  TutorialHeadingFont,
  TutorialModels,
  TutorialRows,
} from './barbassault-tutorial.constants';
import { TutorialRow } from './tutorial-row.component';

export function BarbassaultTutorial(): Component {
  return (
    <>
      <model
        x={TutorialModels.CENTREPIECE.x}
        y={TutorialModels.CENTREPIECE.y}
        w={TutorialModels.CENTREPIECE.size}
        h={TutorialModels.CENTREPIECE.size}
        model={TutorialModels.CENTREPIECE.model}
        zoom={TutorialModels.CENTREPIECE.zoom}
        pitch={TutorialModels.CENTREPIECE.pitch}
      />

      <text
        x={Layout.HEADING.x}
        y={Layout.HEADING.y}
        w={Layout.HEADING.w}
        h={Layout.HEADING.h}
        text="Tutorial Progress"
        font={TutorialHeadingFont.HEADING}
        color={TutorialColors.HEADING}
        shadow
        align="center"
        valign="middle"
      />

      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R1.y}
        step={TutorialRows.R1.step}
        label={TutorialRows.R1.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R2.y}
        step={TutorialRows.R2.step}
        label={TutorialRows.R2.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R3.y}
        step={TutorialRows.R3.step}
        label={TutorialRows.R3.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R4.y}
        step={TutorialRows.R4.step}
        label={TutorialRows.R4.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R5.y}
        step={TutorialRows.R5.step}
        label={TutorialRows.R5.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R6.y}
        step={TutorialRows.R6.step}
        label={TutorialRows.R6.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R7.y}
        step={TutorialRows.R7.step}
        label={TutorialRows.R7.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R8.y}
        step={TutorialRows.R8.step}
        label={TutorialRows.R8.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R9.y}
        step={TutorialRows.R9.step}
        label={TutorialRows.R9.label}
      />
      <TutorialRow
        x={0}
        y={0}
        w="fill"
        h="fill"
        top={TutorialRows.R10.y}
        step={TutorialRows.R10.step}
        label={TutorialRows.R10.label}
      />

      <model
        x={TutorialModels.FLANK.leftX}
        y={TutorialModels.FLANK.y}
        w={TutorialModels.FLANK.size}
        h={TutorialModels.FLANK.size}
        model={TutorialModels.FLANK.model}
        zoom={TutorialModels.FLANK.zoom}
      />
      <model
        x={TutorialModels.FLANK.rightX}
        y={TutorialModels.FLANK.y}
        w={TutorialModels.FLANK.size}
        h={TutorialModels.FLANK.size}
        model={TutorialModels.FLANK.model}
        zoom={TutorialModels.FLANK.zoom}
      />

      <sprite
        x={Layout.CLOSE.x}
        y={Layout.CLOSE.y}
        w={Layout.CLOSE.w}
        h={Layout.CLOSE.h}
        sprite={CloseSprites.REST}
        options={['Close']}
        onMouseEnter={(event) => graphicSwapper(event.component, CloseSprites.HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.REST)}
        onOptionSelect={() => closeInterface()}
      />
    </>
  );
}
