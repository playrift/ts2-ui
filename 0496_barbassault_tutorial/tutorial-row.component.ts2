import { useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import {
  Layout,
  TUTORIAL_OP_MASK,
  TutorialColors,
  TutorialFonts,
  TutorialVarbits,
} from './barbassault-tutorial.constants';
import { setTextColor } from './barbassault-tutorial.helpers';

export function TutorialRow({ top, step, label }: { top: Int; step: Int; label: String }): Component {
  const progress: Int = useServerState(TutorialVarbits.PROGRESS);
  const locked: Boolean = progress < step;
  const current: Boolean = progress === step;
  const restoreColor: Int = current ? TutorialColors.CURRENT : TutorialColors.DONE;

  return (
    <text
      x={Layout.ROW.x}
      y={top}
      w={Layout.ROW.w}
      h={Layout.ROW.h}
      text={label}
      font={TutorialFonts.ROW}
      color={locked ? TutorialColors.LOCKED : restoreColor}
      shadow
      align="center"
      options={['View tutorial']}
      onMouseRepeat={locked ? undefined : (event) => setTextColor(event.self, TutorialColors.HOVER)}
      onMouseLeave={locked ? undefined : (event) => setTextColor(event.self, restoreColor)}
      onOptionSelect={locked ? undefined : (event) => opsound(event.option, TUTORIAL_OP_MASK)}
    />
  );
}
