import { useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import {
  Layout,
  TUTORIAL_OP_MASK,
  TutorialColors,
  TutorialFonts,
  TutorialVarbits,
} from './barbassault-tutorial.constants';
import { setTextColor } from './barbassault-tutorial.helpers';

export function TutorialRow({ top, step, label }: { top: Int; step: Int; label: String }): Component {
  const progress: Int = useServerState(TutorialVarbits.PROGRESS);

  if (progress < step) {
    return (
      <text
        x={Layout.ROW.x}
        y={top}
        w={Layout.ROW.w}
        h={Layout.ROW.h}
        text={label}
        font={TutorialFonts.ROW}
        color={TutorialColors.LOCKED}
        shadow
        align="center"
        options={['View tutorial']}
      />
    );
  }

  if (progress === step) {
    return (
      <text
        x={Layout.ROW.x}
        y={top}
        w={Layout.ROW.w}
        h={Layout.ROW.h}
        text={label}
        font={TutorialFonts.ROW}
        color={TutorialColors.CURRENT}
        shadow
        align="center"
        options={['View tutorial']}
        onMouseRepeat={(event) => setTextColor(event.self, TutorialColors.HOVER)}
        onMouseLeave={(event) => setTextColor(event.self, TutorialColors.CURRENT)}
        onOptionSelect={(event) => opsound(event.option, TUTORIAL_OP_MASK)}
      />
    );
  }

  return (
    <text
      x={Layout.ROW.x}
      y={top}
      w={Layout.ROW.w}
      h={Layout.ROW.h}
      text={label}
      font={TutorialFonts.ROW}
      color={TutorialColors.DONE}
      shadow
      align="center"
      options={['View tutorial']}
      onMouseRepeat={(event) => setTextColor(event.self, TutorialColors.HOVER)}
      onMouseLeave={(event) => setTextColor(event.self, TutorialColors.DONE)}
      onOptionSelect={(event) => opsound(event.option, TUTORIAL_OP_MASK)}
    />
  );
}
