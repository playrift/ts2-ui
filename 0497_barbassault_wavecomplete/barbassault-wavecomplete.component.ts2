import { createRef } from 'ts2';
import { graphicSwapper } from '../lib/lib.helpers';
import {
  Advanced,
  Camera,
  CELL_H,
  CELL_W,
  COUNT_X,
  CountCells,
  INDIVIDUAL_POINT_X,
  IndividualPointCells,
  Layout,
  LevelUp,
  MODEL,
  Queen,
  RowLabels,
  Simple,
  TEAM_POINT_X,
  TeamPointCells,
  WaveArt,
  WaveColor,
  WaveFonts,
  WaveModel,
} from './barbassault-wavecomplete.constants';
import { textColourSwapper } from './barbassault-wavecomplete.helpers';

const levelUpText = createRef('barbassault_level_up_txt');

export function BarbassaultWavecomplete(): Component {
  return (
    <>
      <model
        x={Layout.SCROLL_X}
        y={Layout.SCROLL_Y}
        w={MODEL}
        h={MODEL}
        model={WaveModel.SCROLL}
        zoom={Camera.SCROLL.ZOOM}
        pitch={Camera.SCROLL.PITCH}
      />

      <model
        x={Layout.HORN_X}
        y={Layout.HORN_Y}
        w={MODEL}
        h={MODEL}
        model={WaveModel.HORN}
        zoom={Camera.HORN.ZOOM}
        pitch={Camera.HORN.PITCH}
        yaw={Camera.HORN.YAW}
      />

      <model x={Layout.AXE_X} y={Layout.AXE_Y} w={MODEL} h={MODEL} model={WaveModel.AXE} zoom={Camera.AXE.ZOOM} />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text="Wave Complete!"
        font={WaveFonts.HEADING}
        color={WaveColor.BODY}
        shadow
        align="center"
      />
      <text
        x={Layout.REWARD_X}
        y={Layout.REWARD_Y}
        w={Layout.REWARD_W}
        h={Layout.REWARD_H}
        text="Reward: "
        font={WaveFonts.HEADING}
        color={WaveColor.BODY}
        shadow
        align="center"
      />

      <layer hide x={Layout.ADVANCED_X} y={Layout.ADVANCED_Y} w={Layout.ADVANCED_W} h={Layout.ADVANCED_H}>
        {RowLabels.map((row) => (
          <text
            x={row.x}
            y={row.y}
            w={row.w}
            h={CELL_H}
            text={row.text}
            font={WaveFonts.BODY}
            color={WaveColor.BODY}
            shadow
          />
        ))}

        {CountCells.map((y) => (
          <text x={COUNT_X} y={y} w={CELL_W} h={CELL_H} text="0" font={WaveFonts.BODY} color={WaveColor.BODY} shadow />
        ))}

        <text
          x={Advanced.TOTAL_LABEL.x}
          y={Advanced.TOTAL_LABEL.y}
          w={Advanced.TOTAL_LABEL.w}
          h={Advanced.TOTAL_LABEL.h}
          text="Total"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
        />

        {TeamPointCells.map((cell) => (
          <text
            x={TEAM_POINT_X}
            y={cell.y}
            w={CELL_W}
            h={CELL_H}
            text="0"
            font={WaveFonts.BODY}
            color={cell.color}
            shadow
          />
        ))}

        <text
          x={Advanced.TEAM_TOTAL.x}
          y={Advanced.TEAM_TOTAL.y}
          w={CELL_W}
          h={CELL_H}
          text="0"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
        />

        <text
          x={Advanced.HASH.x}
          y={Advanced.HASH.y}
          w={Advanced.HASH.w}
          h={Advanced.HASH.h}
          text="#"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
        />
        <text
          x={Advanced.TEAM_HEADING.x}
          y={Advanced.TEAM_HEADING.y}
          w={Advanced.TEAM_HEADING.w}
          h={Advanced.TEAM_HEADING.h}
          text="Team Honour Points"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <text
          x={Advanced.ROLE_LABEL.x}
          y={Advanced.ROLE_LABEL.y}
          w={Advanced.ROLE_LABEL.w}
          h={Advanced.ROLE_LABEL.h}
          text="Role:"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />
        <text
          x={Advanced.ROLE.x}
          y={Advanced.ROLE.y}
          w={Advanced.ROLE.w}
          h={Advanced.ROLE.h}
          text="None"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        {IndividualPointCells.map((cell) => (
          <text
            x={INDIVIDUAL_POINT_X}
            y={cell.y}
            w={CELL_W}
            h={CELL_H}
            text="0"
            font={WaveFonts.BODY}
            color={WaveColor.BODY}
            shadow
          />
        ))}

        <text
          x={Advanced.INDIVIDUAL_TOTAL.x}
          y={Advanced.INDIVIDUAL_TOTAL.y}
          w={CELL_W}
          h={CELL_H}
          text="0"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
        />

        <text
          x={Advanced.REWARD_LABEL.x}
          y={Advanced.REWARD_LABEL.y}
          w={Advanced.REWARD_LABEL.w}
          h={Advanced.REWARD_LABEL.h}
          text="Honour Points reward :"
          font={WaveFonts.HEADING}
          color={WaveColor.BODY}
          shadow
        />
        <text
          x={Advanced.REWARD.x}
          y={Advanced.REWARD.y}
          w={Advanced.REWARD.w}
          h={Advanced.REWARD.h}
          text="0"
          font={WaveFonts.HEADING}
          color={WaveColor.BODY}
          shadow
        />

        <text
          x={Advanced.ROLE_TOTAL_LABEL.x}
          y={Advanced.ROLE_TOTAL_LABEL.y}
          w={Advanced.ROLE_TOTAL_LABEL.w}
          h={Advanced.ROLE_TOTAL_LABEL.h}
          text="Total Honour Points in role:"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />
        <text
          x={Advanced.ROLE_TOTAL.x}
          y={Advanced.ROLE_TOTAL.y}
          w={Advanced.ROLE_TOTAL.w}
          h={Advanced.ROLE_TOTAL.h}
          text="0"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <text
          x={Advanced.INDIVIDUAL_HEADING.x}
          y={Advanced.INDIVIDUAL_HEADING.y}
          w={Advanced.INDIVIDUAL_HEADING.w}
          h={Advanced.INDIVIDUAL_HEADING.h}
          text="Individual Honour Points"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
        />

        <text
          x={Advanced.SIMPLE_SWITCH.x}
          y={Advanced.SIMPLE_SWITCH.y}
          w={Advanced.SIMPLE_SWITCH.w}
          h={Advanced.SIMPLE_SWITCH.h}
          text="Simple breakdown"
          font={WaveFonts.HEADING}
          color={WaveColor.BODY}
          shadow
          align="center"
          options={['Simple']}
          onMouseRepeat={(event) => textColourSwapper(event.component, WaveColor.LIT)}
          onMouseLeave={(event) => textColourSwapper(event.component, WaveColor.BODY)}
        />
      </layer>

      <layer hide x={Layout.QUEEN_X} y={Layout.QUEEN_Y} w={Layout.QUEEN_W} h={Layout.QUEEN_H}>
        <text
          x={Queen.TITLE.x}
          y={Queen.TITLE.y}
          w={Queen.TITLE.w}
          h={Queen.TITLE.h}
          text="The Queen is dead!"
          font={WaveFonts.HEADING}
          color={WaveColor.BODY}
          shadow
          align="center"
          valign="middle"
        />
        <text
          x={Queen.REWARD_LABEL.x}
          y={Queen.REWARD_LABEL.y}
          w={Queen.REWARD_LABEL.w}
          h={Queen.REWARD_LABEL.h}
          text="Reward:"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />
        <text
          x={Queen.REWARDS.x}
          y={Queen.REWARDS.y}
          w={Queen.REWARDS.w}
          h={Queen.REWARDS.h}
          text="--Points output--"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />
      </layer>

      <layer x={Layout.SIMPLE_X} y={Layout.SIMPLE_Y} w={Layout.SIMPLE_W} h={Layout.SIMPLE_H}>
        <text
          x={Simple.ROLE.x}
          y={Simple.ROLE.y}
          w={Simple.ROLE.w}
          h={Simple.ROLE.h}
          text="-Role-"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <text
          x={Simple.REWARD_LABEL.x}
          y={Simple.REWARD_LABEL.y}
          w={Simple.REWARD_LABEL.w}
          h={Simple.REWARD_LABEL.h}
          text="Honour Points Reward:"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />
        <text
          x={Simple.POINTS.x}
          y={Simple.POINTS.y}
          w={Simple.POINTS.w}
          h={Simple.POINTS.h}
          text="0"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <text
          x={Simple.ROLE_TOTAL.x}
          y={Simple.ROLE_TOTAL.y}
          w={Simple.ROLE_TOTAL.w}
          h={Simple.ROLE_TOTAL.h}
          text="0"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <text
          x={Simple.ADVANCED_SWITCH.x}
          y={Simple.ADVANCED_SWITCH.y}
          w={Simple.ADVANCED_SWITCH.w}
          h={Simple.ADVANCED_SWITCH.h}
          text="Advanced Breakdown"
          font={WaveFonts.HEADING}
          color={WaveColor.BODY}
          shadow
          align="center"
          options={['Advanced']}
          onMouseRepeat={(event) => textColourSwapper(event.component, WaveColor.LIT)}
          onMouseLeave={(event) => textColourSwapper(event.component, WaveColor.BODY)}
        />

        <text
          x={Simple.ROLE_TOTAL_LABEL.x}
          y={Simple.ROLE_TOTAL_LABEL.y}
          w={Simple.ROLE_TOTAL_LABEL.w}
          h={Simple.ROLE_TOTAL_LABEL.h}
          text="Total Honour Points in role:"
          font={WaveFonts.BODY}
          color={WaveColor.BODY}
          shadow
          align="center"
        />

        <layer x={LevelUp.HOLDER.x} y={LevelUp.HOLDER.y} w={LevelUp.HOLDER.w} h={LevelUp.HOLDER.h}>
          <model
            x={LevelUp.PLATE.x}
            y={LevelUp.PLATE.y}
            w={LevelUp.PLATE.w}
            h={LevelUp.PLATE.h}
            model={WaveModel.LEVEL_UP_DULL}
            zoom={Camera.LEVEL_UP.ZOOM}
            options={['Level-up']}
          />
          <text
            x={LevelUp.CAPTION.x}
            y={LevelUp.CAPTION.y}
            w={LevelUp.CAPTION.w}
            h={LevelUp.CAPTION.h}
            text={LevelUp.TEXT}
            font={WaveFonts.HEADING}
            color={WaveColor.LEVEL_UP_DULL}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer hide x={LevelUp.HOLDER.x} y={LevelUp.HOLDER.y} w={LevelUp.HOLDER.w} h={LevelUp.HOLDER.h}>
          <model
            x={LevelUp.PLATE.x}
            y={LevelUp.PLATE.y}
            w={LevelUp.PLATE.w}
            h={LevelUp.PLATE.h}
            model={WaveModel.LEVEL_UP}
            zoom={Camera.LEVEL_UP.ZOOM}
            options={['Level-up']}
            onMouseEnter={() => textColourSwapper(levelUpText, WaveColor.LIT)}
            onMouseLeave={() => textColourSwapper(levelUpText, WaveColor.BODY)}
          />
          <text
            ref={levelUpText}
            x={LevelUp.CAPTION.x}
            y={LevelUp.CAPTION.y}
            w={LevelUp.CAPTION.w}
            h={LevelUp.CAPTION.h}
            text={LevelUp.TEXT}
            font={WaveFonts.HEADING}
            color={WaveColor.BODY}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={WaveArt.CLOSE}
        options={['Close']}
        onMouseEnter={(event) => graphicSwapper(event.component, WaveArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, WaveArt.CLOSE)}
      />
    </>
  );
}
