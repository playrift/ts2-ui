import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  LETTER,
  Layout,
  ScrollArt,
  ScrollColors,
  ScrollFonts,
  ScrollModels,
} from './contact-scroll-blood.constants';

export function ContactScrollBlood(): Component {
  return (
    <>
      <model
        x="center"
        y={{ center: Layout.PARCHMENT_CENTER_Y }}
        w={Layout.PARCHMENT_W}
        h={Layout.PARCHMENT_H}
        model={ScrollModels.PARCHMENT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={{ center: Layout.ROLLER_RIGHT_CENTER_X }}
        y={{ center: Layout.ROLLER_RIGHT_CENTER_Y }}
        w={Layout.ROLLER_SIZE}
        h={Layout.ROLLER_SIZE}
        model={ScrollModels.ROLLER_RIGHT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={{ center: Layout.ROLLER_LEFT_CENTER_X }}
        y={{ center: Layout.ROLLER_LEFT_CENTER_Y }}
        w={Layout.ROLLER_SIZE}
        h={Layout.ROLLER_SIZE}
        model={ScrollModels.ROLLER_LEFT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ScrollArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, ScrollArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, ScrollArt.CLOSE)}
      />

      <text
        x={{ center: Layout.TEXT_CENTER_X }}
        y={{ center: Layout.TEXT_CENTER_Y }}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        text={LETTER}
        font={ScrollFonts.LETTER}
        color={ScrollColors.INK}
        align="center"
        lineHeight={Layout.TEXT_LINE_HEIGHT}
      />
    </>
  );
}
