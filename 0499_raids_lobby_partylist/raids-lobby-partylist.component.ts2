import { useServerState } from 'ts2';

import { BoardButton } from '../lib/board-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Varps } from '../lib/game/varps';
import { resetRaidsPartyList } from './raids-lobby-partylist.helpers';
import {
  Copy,
  Layout,
  RaidsPartylistColor,
  RaidsPartylistFonts,
  RaidsPartylistScrollbar,
  RaidsPartylistSlots,
  RaidsPartylistSprites,
  listRef,
} from './raids-lobby-partylist.constants';

export function RaidsLobbyPartylist(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H} onLoad={() => resetRaidsPartyList()}>
      <SteelBorderEntrypoint title={Copy.TITLE} />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET_W }}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <layer x="center" y={0} w="fill" h={{ fill: Layout.LIST_BOX_INSET_H }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={RaidsPartylistSprites.BACKING}
            tiling
          />

          <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
            <layer x={Layout.COL_MEMBERS_X} y="center" w={Layout.COL_MEMBERS_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_SIZE_X} y="center" w={Layout.COL_SIZE_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_LEADER_X} y="center" w={Layout.COL_LEADER_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_COMBAT_X} y="center" w={Layout.COL_COMBAT_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_TOTAL_X} y="center" w={Layout.COL_TOTAL_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_SCALING_X} y="center" w={Layout.COL_SCALING_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer x={Layout.COL_CM_X} y="center" w={Layout.COL_CM_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <layer right={Layout.COL_AGE_RIGHT} y="center" w={Layout.COL_AGE_W} h={{ fill: Layout.HEADER_INSET_H }} />
            <ThinBoxEntrypoint />
          </layer>

          <layer
            ref={listRef}
            x={Layout.LIST_X}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={{ fill: Layout.LIST_INSET_W }}
            h={{ fill: Layout.LIST_INSET_H }}
          >
            {RaidsPartylistSlots.map(() => (
              <layer x="center" y={0} w="fill" h={Layout.ROW_H} hide />
            ))}
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={Copy.LOADING}
              font={RaidsPartylistFonts.BODY}
              color={RaidsPartylistColor.LOADING}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            right={Layout.SCROLLBAR_RIGHT}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={Layout.SCROLLBAR_W}
            h={{ fill: Layout.LIST_INSET_H }}
          >
            <ScrollbarVertical
              content={listRef}
              track={RaidsPartylistScrollbar.TRACK}
              capTopSprite={RaidsPartylistScrollbar.CAP_TOP}
              thumbSprite={RaidsPartylistScrollbar.THUMB}
              capBottomSprite={RaidsPartylistScrollbar.CAP_BOTTOM}
              arrowUp={RaidsPartylistScrollbar.ARROW_UP}
              arrowDown={RaidsPartylistScrollbar.ARROW_DOWN}
            />
          </layer>

          <ThinBoxEntrypoint />
        </layer>

        <layer x={Layout.REFRESH_X} y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H} hide>
          <BoardButton label={Copy.REFRESH} />
        </layer>

        <layer right={Layout.MYPARTY_RIGHT} y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H} hide>
          <RaidsMyPartyButton />
        </layer>
      </layer>
    </layer>
  );
}

export function RaidsMyPartyButton(): Component {
  const partyHeld: Int = useServerState(Varps.RAIDS_PARTY_GROUPHOLDER);
  return (
    <layer w="fill" h="fill">
      <BoardButton label={partyHeld !== -1 ? Copy.MY_PARTY : Copy.MAKE_PARTY} />
    </layer>
  );
}
