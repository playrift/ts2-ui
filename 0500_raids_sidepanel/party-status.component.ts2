import { useServerState } from 'ts2';

import { Copy, Layout, SidepanelColor, SidepanelFonts, SidepanelVarbits } from './raids-sidepanel.constants';

export function PartyStatus(): Component {
  const size: Int = useServerState(SidepanelVarbits.PARTY_SIZE);
  const combat: Int = useServerState(SidepanelVarbits.HIGHEST_COMBAT);
  const scaled: Int = useServerState(SidepanelVarbits.PARTY_SIZE_SCALED);
  const progress: Int = useServerState(SidepanelVarbits.PROGRESS);
  const leader: Int = useServerState(SidepanelVarbits.IS_LEADER);
  const mapPool: Int = useServerState(SidepanelVarbits.MAP_POOL);

  const head: String = `Party size: <col=ffffff>${stringOf(size)}</col>  Combat level: <col=ffffff>${stringOf(combat)}</col>`;
  const line: String = scaled > size ? `${head}<br>Scaled party size: <col=ffffff>${stringOf(scaled)}</col>` : head;

  const status: String =
    progress === 0
      ? leader === 1
        ? ''
        : Copy.WAITING
      : progress === 1
        ? Copy.UPPER
        : progress === 2
          ? mapPool === 2
            ? Copy.MIDDLE
            : Copy.LOWER
          : progress === 3
            ? Copy.LOWER
            : progress === 4
              ? Copy.BOTTOM
              : Copy.GET_OUT;

  return (
    <>
      <text
        x="center"
        y={Layout.STATUS_Y}
        w={{ fill: Layout.STATUS_INSET_W }}
        h={Layout.PARTY_SIZE_H}
        text={line}
        font={SidepanelFonts.SMALL}
        color={SidepanelColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y={{ bottom: Layout.STATUS_Y }}
        w={{ fill: Layout.STATUS_INSET_W }}
        h={{ fill: Layout.PROGRESS_INSET_H }}
        text={status}
        font={SidepanelFonts.BODY}
        color={SidepanelColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
