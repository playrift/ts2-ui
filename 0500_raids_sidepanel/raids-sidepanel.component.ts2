import { setTransparency } from '../lib/lib.components';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBox } from '../lib/thin-box.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { MemberRows } from './member-list.component';
import {
  Copy,
  Layout,
  SidepanelBar,
  SidepanelColor,
  SidepanelFonts,
  SidepanelSort,
  SidepanelSprites,
  SidepanelVarps,
} from './raids-sidepanel.constants';
import {
  infoBox,
  memberList,
  refreshButton,
  requestingLabel,
  scrollbar,
  sortCombat,
  sortHeader,
  sortName,
  sortTotal,
  startButton,
  tooltipHost,
} from './raids-sidepanel.refs';
import { raidsSidepanelRefresh } from './raids-sidepanel.state';
import { PartyStatus } from './party-status.component';
import { SortButton } from './sort-button.component';
import { StartRaidButton } from './start-raid-button.component';

export function RaidsSidepanel(): Component {
  return (
    <>
      <text
        x={Layout.TITLE_X}
        y={0}
        w={{ fill: Layout.TITLE_INSET }}
        h={Layout.TITLE_H}
        text={Copy.TITLE}
        font={SidepanelFonts.TITLE}
        color={SidepanelColor.LABEL}
        shadow
        valign="middle"
      />

      <sprite
        ref={refreshButton}
        x={{ right: Layout.REFRESH_RIGHT }}
        y={Layout.REFRESH_Y}
        w={Layout.REFRESH_W}
        h={Layout.REFRESH_H}
        sprite={SidepanelSprites.REFRESH}
        outline={1}
        options={[Copy.REFRESH]}
        onOptionSelect={(event) =>
          raidsSidepanelRefresh(event.option, memberList, scrollbar, refreshButton, sortHeader, requestingLabel)
        }
        onMouseRepeat={(event) => setTransparency(event.component, Layout.REFRESH_HOVER)}
        onMouseLeave={(event) => setTransparency(event.component, Layout.REFRESH_REST)}
      />

      <layer
        x="center"
        y={Layout.LIST_PANEL_Y}
        w={{ fill: Layout.LIST_PANEL_INSET_W }}
        h={{ fill: Layout.LIST_PANEL_INSET_H }}
      >
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKING_INSET }}
          h={{ fill: Layout.BACKING_INSET }}
          sprite={SidepanelSprites.BACKING_DARK}
          tiling
        />

        <text
          ref={requestingLabel}
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={Copy.REQUESTING}
          font={SidepanelFonts.BODY}
          color={SidepanelColor.LABEL}
          shadow
          align="center"
          valign="middle"
          hide
        />

        <layer ref={sortHeader} x="center" y={0} w="fill" h={Layout.HEADER_H}>
          <layer
            ref={sortName}
            x={Layout.SORT_NAME_X}
            y="center"
            w={{ fill: Layout.SORT_NAME_INSET }}
            h={{ fill: Layout.HEADER_COLUMN_INSET_H }}
          >
            <SortButton first={SidepanelSort.NAME_ASC} second={SidepanelSort.NAME_DESC} />
          </layer>

          <layer
            ref={sortCombat}
            x={{ right: Layout.SORT_COMBAT_RIGHT }}
            y="center"
            w={Layout.SORT_COMBAT_W}
            h={{ fill: Layout.HEADER_COLUMN_INSET_H }}
          >
            <SortButton first={SidepanelSort.COMBAT_ASC} second={SidepanelSort.COMBAT_DESC} />
          </layer>

          <layer
            ref={sortTotal}
            x={{ right: Layout.SORT_TOTAL_RIGHT }}
            y="center"
            w={Layout.SORT_TOTAL_W}
            h={{ fill: Layout.HEADER_COLUMN_INSET_H }}
          >
            <SortButton first={SidepanelSort.TOTAL_ASC} second={SidepanelSort.TOTAL_DESC} />
          </layer>

          <ThinBoxEntrypoint />
        </layer>

        <layer
          static
          ref={memberList}
          x={Layout.LIST_X}
          y={{ bottom: Layout.LIST_BOTTOM }}
          w={{ fill: Layout.LIST_INSET_W }}
          h={{ fill: Layout.LIST_INSET_H }}
        >
          <MemberRows />
        </layer>

        <layer
          ref={scrollbar}
          x={{ right: Layout.BAR_RIGHT }}
          y={{ bottom: Layout.LIST_BOTTOM }}
          w={Layout.BAR_W}
          h={{ fill: Layout.LIST_INSET_H }}
        >
          <ScrollbarVertical
            content={memberList}
            track={SidepanelBar.TRACK}
            capTopSprite={SidepanelBar.CAP_TOP}
            thumbSprite={SidepanelBar.THUMB}
            capBottomSprite={SidepanelBar.CAP_BOTTOM}
            arrowUp={SidepanelBar.ARROW_UP}
            arrowDown={SidepanelBar.ARROW_DOWN}
          />
        </layer>

        <ThinBoxEntrypoint />
      </layer>

      <layer
        ref={infoBox}
        x="center"
        y={{ bottom: Layout.INFO_BOTTOM }}
        w={{ fill: Layout.INFO_INSET_W }}
        h={Layout.INFO_H}
      >
        <sprite x="center" y="center" w="fill" h="fill" sprite={SidepanelSprites.BACKING} tiling />

        <ThinBox />

        <PartyStatus />

        <layer static ref={startButton} x="center" y={{ bottom: Layout.START_BOTTOM }} w="fill" h={Layout.START_H}>
          <StartRaidButton />
        </layer>
      </layer>

      <layer static ref={tooltipHost} x={0} y={0} w={Layout.TOOLTIP_HOST} h={Layout.TOOLTIP_HOST} />
    </>
  );
}
