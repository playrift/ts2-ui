import { useRef } from 'ts2';

import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { Layout, SidepanelSprites, SortArrow } from './raids-sidepanel.constants';
import { chooseSort, currentSort, sortArrowHover } from './raids-sidepanel.state';

export function SortButton({ first, second }: { first: Int; second: Int }): Component {
  const arrow = useRef();
  const sort: Int = currentSort();

  let reversed: Int = 0;
  let owned: Int = 0;
  if (sort === second) {
    reversed = 1;
    owned = 1;
  } else if (sort === first) {
    owned = 1;
  }

  const rest: Int = owned === 1 ? SortArrow.ACTIVE : SortArrow.IDLE;
  const lit: Int = owned === 1 ? SortArrow.ACTIVE_HOVER : SortArrow.IDLE_HOVER;

  const next: Int = sort === first ? second : first;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => sortArrowHover(arrow, lit)}
      onMouseLeave={() => ccSetTrans(arrow, rest)}
      onClick={() => chooseSort(next)}
    >
      <sprite
        ref={arrow}
        x="center"
        y="center"
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        sprite={reversed === 1 ? SidepanelSprites.SORT_REVERSED : SidepanelSprites.SORT_DEFAULT}
        transparency={rest}
      />
    </layer>
  );
}
