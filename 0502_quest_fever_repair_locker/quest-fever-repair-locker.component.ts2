import {
  Banners,
  Camera,
  HitBoxes,
  Layout,
  LockerArt,
  LockerColor,
  LockerFonts,
  LockerModel,
  Parts,
  SLOT_SIZE,
} from './quest-fever-repair-locker.constants';

export function QuestFeverRepairLocker(): Component {
  return (
    <>
      <model
        x={Layout.BACKDROP_X}
        y={Layout.BACKDROP_Y}
        w={SLOT_SIZE}
        h={SLOT_SIZE}
        model={LockerModel.BACKDROP}
        zoom={Camera.BACKDROP.ZOOM}
        pitch={Camera.BACKDROP.PITCH}
        yaw={Camera.BACKDROP.YAW}
      />

      <model
        x={Layout.RACK_X}
        y={Layout.RACK_Y}
        w={SLOT_SIZE}
        h={SLOT_SIZE}
        model={LockerModel.RACK}
        zoom={Camera.RACK.ZOOM}
        pitch={Camera.RACK.PITCH}
        yaw={Camera.RACK.YAW}
      />

      <layer x={Layout.OBJECTS_X} y={Layout.OBJECTS_Y} w={Layout.OBJECTS_W} h={Layout.OBJECTS_H}>
        {Parts.map((part) => (
          <model
            x={part.x}
            y={part.y}
            w={SLOT_SIZE}
            h={SLOT_SIZE}
            model={part.model}
            zoom={part.zoom}
            pitch={part.pitch}
            yaw={part.yaw}
          />
        ))}
      </layer>

      {HitBoxes.map((box) => (
        <text
          x={box.x}
          y={box.y}
          w={box.w}
          h={box.h}
          text=""
          font={LockerFonts.HITBOX}
          color={LockerColor.HITBOX}
          shadow
        />
      ))}

      {Banners.map((banner) => (
        <layer x={banner.x} y={banner.y} w={banner.w} h={banner.h} hide>
          <model
            x={banner.modelX}
            y={banner.modelY}
            w={SLOT_SIZE}
            h={SLOT_SIZE}
            model={LockerModel.SCROLL}
            zoom={Camera.SCROLL.ZOOM}
            pitch={Camera.SCROLL.PITCH}
          />
          <text
            x={banner.textX}
            y={banner.textY}
            w={SLOT_SIZE}
            h={SLOT_SIZE}
            text={banner.text}
            font={LockerFonts.BANNER}
            color={LockerColor.CAPTION}
            align={banner.align}
            valign={banner.valign}
          />
        </layer>
      ))}

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={LockerArt.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_LIT_X}
          y={Layout.CLOSE_LIT_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={LockerArt.CLOSE_LIT}
        />
      </layer>
    </>
  );
}
