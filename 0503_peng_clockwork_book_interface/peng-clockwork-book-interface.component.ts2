import {
  BookColor,
  BookFonts,
  BookModel,
  BookSprites,
  BookText,
  Layout,
} from './peng-clockwork-book-interface.constants';

export function PengClockworkBookInterface(): Component {
  return (
    <>
      <model
        x={Layout.BOOK_X}
        y={Layout.BOOK_Y}
        w={Layout.BOOK_SIZE}
        h={Layout.BOOK_SIZE}
        model={BookModel.BOOK}
        zoom={Layout.BOOK_ZOOM}
        pitch={Layout.BOOK_PITCH}
      />

      <layer x={Layout.BAND_X} y={Layout.BAND_Y} w={Layout.BAND_W} h={Layout.BAND_H} />

      <model
        x={Layout.PENGUIN_X}
        y={Layout.PENGUIN_Y}
        w={Layout.PENGUIN_SIZE}
        h={Layout.PENGUIN_SIZE}
        model={BookModel.PENGUIN}
        zoom={Layout.PENGUIN_ZOOM}
        yaw={Layout.PENGUIN_YAW}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={BookText.TITLE}
        font={BookFonts.BODY}
        color={BookColor.TITLE}
        shadow={true}
        align="center"
        valign="middle"
      />

      <sprite x={Layout.CLOSE_X} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={BookSprites.CLOSE} />

      <layer x={Layout.HOVER_X} y={Layout.HOVER_Y} w={Layout.HOVER_SIZE} h={Layout.HOVER_SIZE} hide>
        <sprite
          x={Layout.CLOSE_OVER_X}
          y={Layout.CLOSE_OVER_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={BookSprites.CLOSE_HOVER}
        />
      </layer>

      <text
        x={Layout.BODY_X}
        y={Layout.BODY_Y}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        text={BookText.BODY}
        font={BookFonts.BODY}
        color={BookColor.BODY}
      />

      <text
        x={Layout.HEAD_X}
        y={Layout.HEAD_Y}
        w={Layout.HEAD_W}
        h={Layout.HEAD_H}
        text={BookText.CALLOUT_HEAD}
        font={BookFonts.BODY}
        color={BookColor.CALLOUT}
      />
      <text
        x={Layout.SYSTEM_X}
        y={Layout.SYSTEM_Y}
        w={Layout.SYSTEM_W}
        h={Layout.SYSTEM_H}
        text={BookText.CALLOUT_SYSTEM}
        font={BookFonts.BODY}
        color={BookColor.CALLOUT}
      />

      <model
        x={Layout.MECHANISM_X}
        y={Layout.MECHANISM_Y}
        w={Layout.MECHANISM_SIZE}
        h={Layout.MECHANISM_SIZE}
        model={BookModel.MECHANISM}
        zoom={Layout.MECHANISM_ZOOM}
        pitch={Layout.MECHANISM_PITCH}
      />

      <text
        x={Layout.MECH_LABEL_X}
        y={Layout.MECH_LABEL_Y}
        w={Layout.MECH_LABEL_W}
        h={Layout.MECH_LABEL_H}
        text={BookText.CALLOUT_MECHANISM}
        font={BookFonts.BODY}
        color={BookColor.CALLOUT}
      />

      <model
        x={Layout.NOTE_MODEL_X}
        y={Layout.NOTE_MODEL_Y}
        w={Layout.NOTE_MODEL_W}
        h={Layout.NOTE_MODEL_H}
        model={BookModel.NOTE}
        zoom={Layout.NOTE_MODEL_ZOOM}
        pitch={Layout.NOTE_MODEL_PITCH}
        yaw={Layout.NOTE_MODEL_YAW}
      />

      <text
        x={Layout.NOTE_X}
        y={Layout.NOTE_Y}
        w={Layout.NOTE_W}
        h={Layout.NOTE_H}
        text={BookText.NOTE}
        font={BookFonts.HANDWRITING}
        color={BookColor.HANDWRITING}
        lineHeight={Layout.NOTE_LINE_HEIGHT}
      />

      <model
        x={Layout.CLIP_X}
        y={Layout.CLIP_Y}
        w={Layout.CLIP_SIZE}
        h={Layout.CLIP_SIZE}
        model={BookModel.PAPERCLIP}
        zoom={Layout.CLIP_ZOOM}
        pitch={Layout.CLIP_PITCH}
        yaw={Layout.CLIP_YAW}
      />

      <rect
        x={Layout.RULE_LOW_X}
        y={Layout.RULE_LOW_Y}
        w={Layout.RULE_LOW_W}
        h={Layout.RULE_LOW_H}
        color={BookColor.RULE}
        fill={true}
      />
      <rect
        x={Layout.RULE_HIGH_X}
        y={Layout.RULE_HIGH_Y}
        w={Layout.RULE_HIGH_W}
        h={Layout.RULE_HIGH_H}
        color={BookColor.RULE_DARK}
        fill={true}
      />
    </>
  );
}
