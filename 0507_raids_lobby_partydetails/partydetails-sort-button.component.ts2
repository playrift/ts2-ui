import { useRef, useState } from 'ts2';

import { raidsListsortDetails } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import {
  Layout,
  PartydetailsSounds,
  PartydetailsSprites,
  PartydetailsTransparency,
} from './raids-lobby-partydetails.constants';
import { normalisedSort } from './raids-lobby-partydetails.helpers';

export function PartydetailsSortButton({ ascending, descending }: { ascending: Int; descending: Int }): Component {
  const arrow = useRef();
  const [sortSetting, setSort] = useState(raidsListsortDetails);
  const sort: Int = normalisedSort(sortSetting);

  const state: Int = sort === descending ? 2 : sort === ascending ? 1 : 0;
  const rest: Int = state === 0 ? PartydetailsTransparency.ARROW_INACTIVE : PartydetailsTransparency.ARROW_ACTIVE;
  const hover: Int =
    state === 0 ? PartydetailsTransparency.ARROW_INACTIVE_HOVER : PartydetailsTransparency.ARROW_ACTIVE_HOVER;
  const next: Int = state === 1 ? descending : ascending;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        arrow.transparency = hover;
      }}
      onMouseLeave={() => {
        arrow.transparency = rest;
      }}
      onClick={() => {
        playSound(PartydetailsSounds.CLICK);
        setSort(next);
      }}
    >
      <sprite
        ref={arrow}
        x="center"
        y="center"
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        sprite={state === 2 ? PartydetailsSprites.SORT_DESC : PartydetailsSprites.SORT_ASC}
        transparency={rest}
      />
    </layer>
  );
}
