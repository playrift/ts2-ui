import { BoardButton } from '../lib/board-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { PartydetailsLabelRow } from './partydetails-label-row.component';
import { PartydetailsRows } from './partydetails-rows.component';
import { PartydetailsSortButton } from './partydetails-sort-button.component';
import { PartydetailsStats } from './partydetails-stats.component';
import { PartydetailsTimer } from './partydetails-timer.component';
import {
  Copy,
  LabelKind,
  Layout,
  PartyRole,
  PartydetailsModels,
  PartydetailsScrollbar,
  PartydetailsSprites,
  SortMode,
  listRef,
  sortComlevelRef,
  sortNameRef,
  sortSkilltotalRef,
} from './raids-lobby-partydetails.constants';
import { AdvertiseLabel, PartydetailsSetup } from './raids-lobby-partydetails.data';
import { resetRaidsPartyDetails } from './raids-lobby-partydetails.helpers';

export function RaidsLobbyPartydetails(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H} onLoad={() => resetRaidsPartyDetails()}>
      <SteelBorderEntrypoint title={PartydetailsSetup.TITLE} />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET_W }}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <layer x={0} y={0} w={{ fill: Layout.LIST_COLUMN_INSET_W }} h="fill">
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={PartydetailsSprites.BACKING}
            tiling
          />

          <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
            <layer
              ref={sortNameRef}
              x={Layout.COL_NAME_X}
              y="center"
              w={Layout.COL_NAME_W}
              h={{ fill: Layout.HEADER_INSET_H }}
            >
              <PartydetailsSortButton ascending={SortMode.NAME_ASC} descending={SortMode.NAME_DESC} />
            </layer>
            <layer
              ref={sortComlevelRef}
              x={Layout.COL_COMBAT_X}
              y="center"
              w={Layout.COL_COMBAT_W}
              h={{ fill: Layout.HEADER_INSET_H }}
            >
              <PartydetailsSortButton ascending={SortMode.COMBAT_ASC} descending={SortMode.COMBAT_DESC} />
            </layer>
            <layer
              ref={sortSkilltotalRef}
              x={Layout.COL_SKILL_X}
              y="center"
              w={Layout.COL_SKILL_W}
              h={{ fill: Layout.HEADER_INSET_H }}
            >
              <PartydetailsSortButton ascending={SortMode.SKILL_ASC} descending={SortMode.SKILL_DESC} />
            </layer>
            <layer
              right={Layout.COL_KILL_RIGHT}
              y="center"
              w={{ fill: Layout.COL_KILL_INSET_W }}
              h={{ fill: Layout.HEADER_INSET_H }}
            >
              <PartydetailsSortButton ascending={SortMode.KILL_ASC} descending={SortMode.KILL_DESC} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>

          <layer
            ref={listRef}
            x={Layout.LIST_X}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={{ fill: Layout.LIST_INSET_W }}
            h={{ fill: Layout.LIST_INSET_H }}
          >
            <PartydetailsRows />
          </layer>

          <layer
            right={Layout.SCROLLBAR_RIGHT}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={Layout.SCROLLBAR_W}
            h={{ fill: Layout.LIST_INSET_H }}
          >
            <ScrollbarVertical
              content={listRef}
              track={PartydetailsScrollbar.TRACK}
              capTopSprite={PartydetailsScrollbar.CAP_TOP}
              thumbSprite={PartydetailsScrollbar.THUMB}
              capBottomSprite={PartydetailsScrollbar.CAP_BOTTOM}
              arrowUp={PartydetailsScrollbar.ARROW_UP}
              arrowDown={PartydetailsScrollbar.ARROW_DOWN}
            />
          </layer>

          <ThinBoxEntrypoint />
        </layer>

        <layer right={0} y={0} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.PARTY_SIZE} label={Copy.PREFERRED_SIZE} />
        </layer>

        <layer right={0} y={Layout.LABEL_ROW_STEP} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.MIN_COMBAT} label={Copy.PREFERRED_COMBAT} />
        </layer>

        <layer right={0} y={Layout.LABEL_ROW_STEP * 2} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.MIN_SKILLTOTAL} label={Copy.PREFERRED_SKILLTOTAL} />
        </layer>

        <layer right={0} y={Layout.LABEL_ROW_STEP * 3} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.SCALING} label={Copy.SCALING} />
        </layer>

        <layer right={0} y={Layout.LABEL_ROW_STEP * 4} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.CHALLENGE} label={Copy.CHALLENGE} />
        </layer>

        <layer right={0} y={Layout.LABEL_ROW_STEP * 5} w={Layout.LABEL_ROW_W} h={Layout.LABEL_ROW_H}>
          <LabelRowBackdrop />
          <PartydetailsLabelRow kind={LabelKind.MAP_POOL} label={Copy.MAP_LAYOUT} />
        </layer>

        <model
          right={0}
          y={{ bottom: Layout.MODEL_BOTTOM }}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={PartydetailsModels.RAID}
          zoom={Layout.MODEL_ZOOM}
          yaw={Layout.MODEL_YAW}
          offsetY={Layout.MODEL_OFFSET_Y}
        />

        <layer right={0} y={{ bottom: Layout.TIMER_BOTTOM }} w={Layout.TIMER_W} h={Layout.TIMER_H}>
          <PartydetailsTimer />
        </layer>

        <layer right={0} y={Layout.STATS_Y} w={Layout.STATS_W} h={Layout.STATS_H}>
          <PartydetailsStats />
        </layer>

        {PartydetailsSetup.ROLE !== PartyRole.OWNER ? (
          <layer
            right={Layout.BUTTON_PAIR_RIGHT}
            y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            hide
          />
        ) : PartydetailsSetup.ADVERTISED === 1 ? (
          <layer
            right={Layout.BUTTON_PAIR_RIGHT}
            y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
          >
            <BoardButton label={Copy.DELIST} />
          </layer>
        ) : PartydetailsSetup.ADVERTISE_COUNT > 0 ? (
          <layer
            right={Layout.BUTTON_PAIR_RIGHT}
            y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
          >
            <BoardButton label={AdvertiseLabel} />
          </layer>
        ) : (
          <layer
            right={Layout.BUTTON_PAIR_RIGHT}
            y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }}
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
          >
            <BoardButton label={Copy.ADVERTISE_NONE} />
          </layer>
        )}

        {PartydetailsSetup.ROLE === PartyRole.OWNER ? (
          <layer right={0} y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
            <BoardButton label={Copy.DISBAND} />
          </layer>
        ) : (
          <layer right={0} y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} hide />
        )}

        {PartydetailsSetup.ROLE === PartyRole.OWNER ? (
          <layer right={0} y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }} w={Layout.JOIN_W} h={Layout.BUTTON_H} hide />
        ) : PartydetailsSetup.ROLE === PartyRole.MEMBER ? (
          <layer right={0} y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }} w={Layout.JOIN_W} h={Layout.BUTTON_H}>
            <BoardButton label={Copy.LEAVE} />
          </layer>
        ) : (
          <layer right={0} y={{ bottom: Layout.BUTTON_TOP_ROW_BOTTOM }} w={Layout.JOIN_W} h={Layout.BUTTON_H}>
            <BoardButton label={Copy.JOIN} />
          </layer>
        )}

        <layer right={Layout.BUTTON_PAIR_RIGHT} y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
          <BoardButton label={Copy.BACK} />
        </layer>

        <layer right={0} y="bottom" w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
          <BoardButton label={Copy.REFRESH} />
        </layer>
      </layer>
    </layer>
  );
}

function LabelRowBackdrop(): Component {
  return (
    <>
      <sprite
        x="center"
        y="center"
        w={{ fill: Layout.BACKDROP_INSET_W }}
        h={Layout.BACKDROP_H}
        sprite={PartydetailsSprites.BACKDROP_MID}
        tiling
      />
      <sprite
        x={0}
        y="center"
        w={Layout.BACKDROP_CAP_W}
        h={Layout.BACKDROP_H}
        sprite={PartydetailsSprites.BACKDROP_LEFT}
        tiling
      />
      <sprite
        right={0}
        y="center"
        w={Layout.BACKDROP_CAP_W}
        h={Layout.BACKDROP_H}
        sprite={PartydetailsSprites.BACKDROP_RIGHT}
        tiling
      />
    </>
  );
}
