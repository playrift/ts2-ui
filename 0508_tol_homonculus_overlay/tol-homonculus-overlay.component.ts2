import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  CentreArrow,
  HiddenArrows,
  HomonculusCamera,
  HomonculusFonts,
  HomonculusModel,
  HOMONCULUS_YELLOW,
  Labels,
  Layout,
  TolHomonculusDodge,
} from './tol-homonculus-overlay.constants';

const container = createRef('tol_homonculus_overlay_container');

export function TolHomonculusOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, container, TolHomonculusDodge.DODGE, Anchor.CENTRE, Anchor.BOTTOM, 0)
        }
      >
        <layer
          ref={container}
          x="center"
          y={{ bottom: Layout.CONTAINER_BOTTOM }}
          w={Layout.CONTAINER_W}
          h={Layout.CONTAINER_H}
        >
          <text
            x="center"
            y={Layout.TITLE_Y}
            w="fill"
            h={Layout.TITLE_H}
            text={Labels.TITLE}
            font={HomonculusFonts.LABEL}
            color={HOMONCULUS_YELLOW}
            align="center"
            shadow
          />

          <model
            x={Layout.HOMONCULUS_X}
            y={Layout.HEAD_Y}
            w={Layout.HEAD_W}
            h={Layout.HEAD_H}
            model={HomonculusModel.HOMONCULUS}
            zoom={HomonculusCamera.HEAD_ZOOM}
            pitch={HomonculusCamera.HOMONCULUS_PITCH}
          />

          <layer x={Layout.MAGIC_HOLDER_X} y={Layout.HEAD_Y} w={Layout.END_HOLDER_W} h={Layout.END_HOLDER_H}>
            <model
              x={Layout.END_HEAD_X}
              y={0}
              w={Layout.HEAD_W}
              h={Layout.HEAD_H}
              model={HomonculusModel.MAGIC}
              zoom={HomonculusCamera.HEAD_ZOOM}
              pitch={HomonculusCamera.END_PITCH}
            />
          </layer>

          <layer x={Layout.LOGIC_HOLDER_X} y={Layout.HEAD_Y} w={Layout.END_HOLDER_W} h={Layout.END_HOLDER_H}>
            <model
              x={Layout.END_HEAD_X}
              y={0}
              w={Layout.HEAD_W}
              h={Layout.HEAD_H}
              model={HomonculusModel.LOGIC}
              zoom={HomonculusCamera.HEAD_ZOOM}
              pitch={HomonculusCamera.END_PITCH}
            />
          </layer>

          <text
            x={Layout.MAGIC_LABEL_X}
            y={Layout.LABEL_Y}
            w={Layout.MAGIC_LABEL_W}
            h={Layout.LABEL_H}
            text={Labels.MAGIC}
            font={HomonculusFonts.LABEL}
            color={HOMONCULUS_YELLOW}
            shadow
          />
          <text
            x={Layout.LOGIC_LABEL_X}
            y={Layout.LABEL_Y}
            w={Layout.LOGIC_LABEL_W}
            h={Layout.LABEL_H}
            text={Labels.LOGIC}
            font={HomonculusFonts.LABEL}
            color={HOMONCULUS_YELLOW}
            align="right"
            shadow
          />

          <layer x={CentreArrow.x} y={CentreArrow.y} w={Layout.ARROW_W} h={Layout.ARROW_H}>
            <model
              x={0}
              y={0}
              w={Layout.ARROW_W}
              h={Layout.ARROW_H}
              model={HomonculusModel.ARROW}
              zoom={HomonculusCamera.ARROW_ZOOM}
            />
          </layer>

          {HiddenArrows.map((arrow) => (
            <layer hide x={arrow.x} y={arrow.y} w={Layout.ARROW_W} h={Layout.ARROW_H}>
              <model
                x={0}
                y={0}
                w={Layout.ARROW_W}
                h={Layout.ARROW_H}
                model={HomonculusModel.ARROW}
                zoom={HomonculusCamera.ARROW_ZOOM}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
