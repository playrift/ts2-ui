import { closeInterface, graphicSwapper, opsound } from '../lib/lib.helpers';
import { Layout, PipeArt, PipeModel } from './tol-pipe-machine.constants';

export function modelSwapper(component: ComponentId, model: Model): void {
  component.model = model;
}

export function TolPipeMachine(): Component {
  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={Layout.WASH_COLOR}
        transparency={Layout.WASH_TRANSPARENCY}
      />

      <model x={173} y={156} w={Layout.ICON} h={Layout.ICON} model={PipeModel.MACHINE} zoom={1050} />

      <layer x={66} y={16} w={256} h={261}>
        <model x={18} y={19} w={Layout.ICON} h={Layout.ICON} model={PipeModel.DIAGRAM_UPRIGHT} zoom={1050} />
        <model x={80} y={19} w={Layout.ICON} h={Layout.ICON} model={PipeModel.DIAGRAM_CROSS} zoom={1050} />
        <model x={140} y={19} w={Layout.ICON} h={Layout.ICON} model={PipeModel.DIAGRAM_UPRIGHT} zoom={1050} />
        <model x={201} y={19} w={Layout.ICON} h={Layout.ICON} model={PipeModel.DIAGRAM_CROSS} zoom={1050} />
        <model x={105} y={214} w={Layout.ICON} h={Layout.ICON} model={PipeModel.DIAGRAM_OUTLET} zoom={1050} />
      </layer>

      <model
        x={410}
        y={153}
        w={65}
        h={161}
        model={PipeModel.PIECE_TALL}
        zoom={1050}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      />
      <model
        x={356}
        y={30}
        w={35}
        h={89}
        model={PipeModel.PIECE_THIN}
        zoom={1050}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      />
      <model
        x={323}
        y={230}
        w={44}
        h={95}
        model={PipeModel.PIECE_BENT}
        zoom={1050}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      />
      <model
        x={449}
        y={62}
        w={58}
        h={63}
        model={PipeModel.PIECE_SHORT}
        zoom={1050}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      />
      <model
        x={327}
        y={171}
        w={53}
        h={60}
        model={PipeModel.PIECE_VALVE}
        zoom={1042}
        options={['Select']}
        onOptionSelect={(event) => opsound(event.option, Layout.OP_SOUND_MASK)}
      />

      <sprite
        x={{ right: 9 }}
        y={6}
        w={26}
        h={23}
        sprite={PipeArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, PipeArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, PipeArt.CLOSE)}
      />

      <layer x={237} y={280} w={42} h={45} options={['Rotate']}>
        <model
          x={4}
          y={3}
          w={Layout.ICON}
          h={Layout.ICON}
          model={PipeModel.ROTATE}
          zoom={1256}
          pitch={54}
          yaw={2002}
          onMouseRepeat={(event) => modelSwapper(event.component, PipeModel.ROTATE_LIT)}
          onMouseLeave={(event) => modelSwapper(event.component, PipeModel.ROTATE)}
        />
      </layer>

      <layer x={101} y={275} w={56} h={34} options={['Move left']}>
        <model
          x={15}
          y={1}
          w={Layout.ICON}
          h={Layout.ICON}
          model={PipeModel.MOVE_LEFT}
          zoom={1000}
          onMouseRepeat={(event) => modelSwapper(event.component, PipeModel.MOVE_LEFT_LIT)}
          onMouseLeave={(event) => modelSwapper(event.component, PipeModel.MOVE_LEFT)}
        />
      </layer>

      <layer x={103} y={308} w={56} h={29} options={['Move right']}>
        <model
          x={24}
          y={-5}
          w={Layout.ICON}
          h={Layout.ICON}
          model={PipeModel.MOVE_RIGHT}
          zoom={1000}
          onMouseRepeat={(event) => modelSwapper(event.component, PipeModel.MOVE_RIGHT_LIT)}
          onMouseLeave={(event) => modelSwapper(event.component, PipeModel.MOVE_RIGHT)}
        />
      </layer>

      <layer x={167} y={276} w={30} h={55} options={['Move up']}>
        <model
          x={1}
          y={15}
          w={Layout.ICON}
          h={Layout.ICON}
          model={PipeModel.MOVE_UP}
          zoom={1000}
          onMouseRepeat={(event) => modelSwapper(event.component, PipeModel.MOVE_UP_LIT)}
          onMouseLeave={(event) => modelSwapper(event.component, PipeModel.MOVE_UP)}
        />
      </layer>

      <layer x={199} y={277} w={29} h={56} options={['Move down']}>
        <model
          x={-4}
          y={12}
          w={Layout.ICON}
          h={Layout.ICON}
          model={PipeModel.MOVE_DOWN}
          zoom={1000}
          onMouseRepeat={(event) => modelSwapper(event.component, PipeModel.MOVE_DOWN_LIT)}
          onMouseLeave={(event) => modelSwapper(event.component, PipeModel.MOVE_DOWN)}
        />
      </layer>
    </>
  );
}
