type AreaInfoRow = {
  overview: String;
  keyInfo: String;
  unlocks: String;
  drops: String;
};

export const AreaInfo = listOf<AreaInfoRow>([
  {
    overview:
      'The Misthalin area covers the entire Kingdom of Misthalin as well as Fossil Island.<br><br>Instances of areas in Misthalin and underground areas with an entrance in Misthalin will also be included.<br><br>Access to Al Kharid, Port Sarim and the western exit of Barbarian Village is blocked by magical barriers.<br><br>All transportation and teleportation through Charter Ships, Customs Officers, Gnome Gliders, Fairy Rings, Balloons, or any other transport system will require you to have unlocked access to the area your destination is in.<br><br>The following travel options are restricted unless you have access to the appropriate area:<br><br>- The gate between Lumbridge and Al Kharid<br>- The entrance to the Kalphite Hive from Dorgesh-Kaan Dungeon<br>- The grapple shortcut between Lumbridge and Al Kharid<br>- The stepping stone between Lumbridge Swamp and the Kalphite Lair<br>- The under-wall shortcut between Draynor Village and Port Sarim<br>- The underground sections of the Paterdomus Temple<br>- The railing shortcut between the Paterdomus Temple and Canifis<br><br>',
    keyInfo:
      "Notable Settlements:<br><br>- Barbarian Village<br>- Draynor Village<br>- Edgeville<br>- Fossil Island<br>- Lumbridge<br>- The Digsite<br>- Varrock<br>- Isle of Souls and Soul Wars<br>- Dorgesh-Kaan<br>- Lithkren Vault (if the Fremennik Province is unlocked)<br><br>Notable combat-related activities:<br><br>- Bryophyta<br>- Edgeville Dungeon<br>- Fossil Island Wyverns<br>- Lumbridge Swamp Caves<br>- Obor<br>- Stronghold of Security<br>- Scurrius the Rat King<br>- Tormented Demons<br>- Soul Wars<br><br>Notable non-combat activities:<br><br>- Champions' Guild<br>- Draynor Village Rooftop Agility Course<br>- Fossil Island Herbiboar<br>- Fossil Island Hardwood Tree Patches<br>- Fossil Island Sulliusceps Woodcutting<br>- Fossil Island Volcanic Mine<br>- Fossil Island Birdhouse spots<br>- Puro-Puro Implings<br>- Earth and Water Altars<br>- Varrock Rooftop Agility Course<br>- Lumbridge and Varrock Tree Patches<br><br>Examiners will provide a level 3 certificate on request.<br><br>The following Misthalin shop stocks have been modified:<br><br>- Pestle and Mortars and Fishing Bait have been added to the Lumbridge General Store<br><br>",
    unlocks:
      "The following quests and their pre-reqs are automatically completed but will not reward any completion XP:<br><br>- Dragon Slayer<br>- Druidic Ritual<br>- Elemental Workshop I<br>- Tears of Guthix<br>- Bone Voyage<br>- Fairytale II - Cure a Queen<br>- Death to the Dorgeshuun<br>- Gertrude's Cat<br>- Romeo and Juliet<br>- A Soul's Bane<br>- Defender of Varrock (This does not complete pre-reqs)<br><br>Players can enter the Ancient Guthixian Temple from the Chasm of Tears without WGS completed.<br><br>The following tasks in the Lumbridge and Draynor Achievement Diary are automatically completed:<br><br>Easy Tasks:<br>- Catch some Anchovies in Al Kharid<br>- Mine some iron ore at the Al Kharid mine<br><br>Medium Tasks:<br>- Complete a lap of the Al Kharid Rooftop Course<br>- Grapple across the River Lum<br>- Craft some Lava Runes at the Fire Altar in Al Kharid<br>- Purchase an upgraded device from Ava<br><br>Hard Tasks:<br>- Cast Bones to Peaches in Al Kharid Palace<br>- Collect 100 tears from Tears of Guthix<br>- Recharge your Prayer at the Emir's Arena with Smite activated<br>- Purchase some Barrows Gloves from the Culinaromancer's Chest<br>- Take the train from Dorgesh-Kaan to Keldagrim<br><br>Elite Tasks:<br>- Chop some Magic Logs at the Mage Training Arena<br>- Perform the Quest Point Cape emote in the Wise Old Man's house<br><br>The following tasks in the Varrock Diary are automatically completed:<br><br>Medium Tasks:<br>- Select a colour for your kitten<br>- Use the Spirit Tree in the north-eastern corner of Grand Exchange<br>- Pick a White Tree Fruit<br>- Use the balloon to travel from Varrock<br><br>Hard Tasks:<br>- Trade furs with the Fancy Dress Seller for a Spottier Cape and equip it<br>- Teleport to Paddewwa<br><br>Elite Tasks:<br>- Use Lunar magic to make 20 Mahogany Planks in the Varrock Lumber Yard.<br>- Smith and fletch ten Rune Darts while in Varrock.<br>- Create a Summer Pie in the Cooks' Guild.<br><br>- Mahogany homes tutorial is completed.",
    drops:
      "The drops listed below are affected by the drop rate modifier perks granted by passive Relic unlocks.<br><br>Drop rates affected are always rounded down and are not tied to area unlocks, this list represents the key drops affected in Misthalin.<br><br>- Wyvern Visage from all sources<br>- Draconic Visage from all sources<br>- Dragon Limbs from all sources<br>- Dragon Metal Slice from Adamant dragons<br>- Dragon metal Lump from Rune dragons<br>- Hill Giant Club from Obor<br>- Bryophyta's Essence from Bryophyta<br>- Beginner clue unique rewards<br>- Easy clue unique rewards<br>- Medium clue unique rewards<br>- Hard clue unique rewards<br>- Elite clue unique rewards<br>- Master clue unique rewards<br>- All unique rewards from Superior Slayer Creatures<br>- Dragon pickaxes from all sources<br>- All unique rewards from Tormented demons<br>- All unique rewards from Scurrius<br>- Broken Zombie Axe from Armoured Zombies<br><br>",
  },
  {
    overview:
      'The Karamja area covers the entire island of Karamja along with the island of Crandor and the Realm of the Fisher King.<br><br>Instances of areas in Karamja and underground areas with an entrance in Karamja will also be included.<br><br>When purchasing a Player Owned House from an Estate Agent your house will be placed in Brimhaven so that Construction can be trained from level 1.<br><br>All transportation and teleportation through Charter Ships, Customs Officers, Gnome Gliders, Fairy Rings, Balloons and other forms of transport will require you to have unlocked access to the area your destination is in.<br><br>',
    keyInfo:
      "Notable Settlements:<br><br>- Brimhaven<br>- Karamja Shipyard<br>- Musa Point<br>- Shilo Village<br>- Tai Bwo Wannai<br>- Mor-Ul-Rek<br><br>Notable combat-related activities:<br><br>- Brimhaven Dungeon<br>- Tai Bwo Wannai Dungeon<br>- The Fight Caves<br>- The Fight Pits<br>- Tzhaar-Ket-Rak's Challenges<br>- The Inferno<br>- Tzhaar Creatures<br><br>Notable non-combat activities:<br><br>- Brimhaven Agility Arena<br>- Brimhaven House Portal<br>- Calquat Tree Patch<br>- Infernal Eel Fishing<br>- Fruit Tree Patch<br>- Karambwan Fishing<br>- Nature Altar<br>- Tai Bwo Wannai Cleanup<br>- Teak and Mahogany Woodcutting<br>- Tzhaar Pickpocketing<br>- Tzhaar Gem Shop Thieving<br><br><br>",
    unlocks:
      'The following quests and their pre-reqs are automatically completed but will not reward any completion XP:<br><br>- Shilo Village<br><br>The following tasks in the Karamja Achievement Diary are automatically completed:<br><br>Easy Tasks:<br>- Travel to Port Sarim via the dock, east of Musa Point<br>- Travel to Ardougne via the port near Brimhaven<br><br>Medium Tasks:<br>- Use the Gnome Glider to travel to Karamja<br>- Charter a ship from the shipyard in the far east of Karamja<br>- Charter the Lady of the Waves from south of Cairn Isle to Port Khazard<br><br>Hard Tasks:<br>- Eat an oomlie wrap<br>- Collect 5 palm leaves<br>- Kill a deathwing in the Viyeldi Caves under the Kharazi Jungle<br><br>Elite Tasks:<br>- Create an Anti-venom Potion whilst standing in the Horseshoe Mine<br><br>Additionally, Tzhaar-Ket-Rak will let you do all of his challenges immediately.<br><br>',
    drops:
      'The drops listed below are affected by the drop rate modifier perks granted by passive Relic unlocks.<br><br>Drop rates affected are always rounded down and are not tied to area unlocks. This list represents the key drops affected in Karamja.<br><br>- All Tzhaar equipment from various Tzhaar<br>- Obsidian Helmet, Platelegs and Platebody from TzHaar-Ket<br>- Draconic Visage from all sources<br>- All unique rewards from Superior Slayer Creatures<br>- Gout Tuber<br><br><br>',
  },
  {
    overview:
      'The Kandarin area covers the entire Kingdom of Kandarin along with the Feldip Hills, Ape Atoll and Crash Island.<br><br>Instances of areas in Kandarin and underground areas with an entrance in Kandarin are also included (with the exception of Taverley Dungeon and the Underground Pass).<br><br>Access to the Nightmare Zone is restricted. To obtain Nightmare Zone points speak to Dominic Onion and purchase them for 1 GP each.<br><br>Access to White Wolf Mountain and the Fremennik Province bridge will be blocked by magical barriers.<br><br>All transportation and teleportation via Charter Ships, Customs Officers, Gnome Gliders, Fairy Rings, Balloons and all other transport systems will require you to have unlocked access to the area your destination is in.<br><br>The following travel options are restricted unless you have access to the appropriate area:<br><br>- The Underground Pass between Ardougne and Isafdar<br>- The underground tunnel between Catherby and Taverley<br>- The grapple shortcut between Catherby and Taverley<br>- The log shortcut between Sinclair Mansion and the Fremennik Province<br>- The gates between Kandarin and Tirannwn at Arandar<br>- The basalt shortcut between the Barbarian Outpost and the Lighthouse<br>- The doors between the Mourner Headquarters and the Temple of Light<br><br>',
    keyInfo:
      "Notable Settlements:<br><br>- Ape Atoll<br>- Ardougne<br>- Barbarian Outpost<br>- Catherby<br>- Corsair Cove<br>- Gu'Tanoth<br>- Myths Guild<br>- Piscatoris Fishing Colony<br>- Port Khazard<br>- Seers' Village<br>- Tree Gnome Stronghold<br>- Tree Gnome Village<br>- Yanille<br><br>Notable combat-related activities:<br><br>- Ancient Cavern<br>- Ape Atoll Monkeys<br>- Barbarian Assault<br>- Castle Wars<br>- Demonic Gorillas<br>- Kraken<br>- Stronghold Slayer Cave<br>- Smoke Devils<br>- Thermonuclear Smoke Devil<br>- Waterfall Dungeon<br>- Poison Waste Dungeon<br><br>Notable non-combat activities:<br><br>- Ardougne Market Thieving<br>- Ardougne Rooftop Agility Course<br>- Ardougne & Catherby Allotment Patches<br>- Catherby, Gnome Stronghold & Tree Gnome Stronghold Fruit Tree Patches<br>- Barbarian Fishing<br>- Barbarian Agility Training<br>- Catherby Fishing<br>- Chompy Bird Hunting<br>- Feldip Hills Hunter Training<br>- Fishing Trawler<br>- Gnome Stronghold Agility Training<br>- Gnome Stronghold Tree Patch<br>- Fishing Guild<br>- Myths' Guild<br>- Piscatoris Hunter Training Grounds<br>- Ourania Altar<br>- Wrath Altar<br>- Seers' Village Rooftop Agility Course<br>- Spirit Tree Access<br>- Tower of Life<br>- Yanille House Portal<br><br>- Wrath Talisman has been added to the East Ardougne General Store",
    unlocks:
      "The following quests and their pre-reqs are automatically completed but will not reward any completion XP:<br><br>- Elemental Workshop II<br>- Hand in the Sand<br>- Monkey Madness II<br>- Swan Song<br>- King's Ransom<br>- Dragon slayer II<br>- Recipe for Disaster (Freeing Skrach Uglogwee)<br><br>The following tasks in the Kandarin Achievement Diary are automatically completed:<br><br>Medium Tasks:<br>- Use the Grapple Shortcut to get from the Water Obelisk to Catherby beach<br>- Create a Mind helmet<br><br>Hard Tasks:<br>- Charge a water orb<br>- Kill a shadow hound in the Shadow Dungeon<br><br>Elite Tasks:<br>- Fish and cook 5 sharks in Catherby using the Cooking Gauntlets<br>- Teleport to Catherby<br><br>The following tasks in the Western Provinces Achievement Diary are automatically completed:<br><br>Easy Tasks:<br>- Complete a novice game of Pest Control<br>- Teleport to Pest Control using the minigame teleports<br><br>Medium Tasks:<br>- Complete an intermediate game of Pest Control<br><br>Hard Tasks:<br>- Complete a veteran game of Pest Control<br>- Place an Isafdar painting in your Player Owned House Quest Hall<br><br>Elite Tasks:<br>- Equip any complete Void set<br><br>The following tasks in the Ardougne Achievement Diary are automatically completed:<br><br>Easy Tasks:<br>- Enter the combat training camp north of West Ardougne<br>- Use the Ardougne lever to teleport to the Wilderness<br><br>Medium Tasks:<br>- Travel to Castle Wars by hot air balloon<br>- Equip an Iban's Upgraded Staff or upgrade an Iban's Staff<br><br>Hard Tasks:<br>- Recharge some jewellery at the totem pole in the Legends' Guild<br>- Smith a Dragon Square Shield in West Ardougne<br>- Craft some Death Runes at the Death Altar<br><br>Elite Tasks:<br>- Imbue a Salve Amulet at Nightmare Zone or equip a Salve Amulet(i)<br>- Cast Ice Barrage on another player within Castle Wars<br><br>The following bars will be automatically completed on Alfred Grimhand's Barcrawl:<br><br>- Blue Moon Inn in Varrock<br>- Jolly Boar Inn near Varrock<br>- The Rising Sun in Falador<br>- The Rusty Anchor in Port Sarim<br><br>The following Combat Achievements are automatically completed:<br><br>- Hitting them Where it Hurts<br><br>",
    drops:
      "The drops listed below are affected by the drop rate modifier perks granted by passive Relic unlocks.<br><br>Drop rates affected are always rounded down and are not tied to area unlocks. This list represents the key drops affected in Kandarin.<br><br>- Angler's Outfit from Fishing Trawler<br>- Zenyte Shards and Ballista components from Glough's Experiments<br>- Monkey Tails from Maniacal Monkey Hunting<br>- Trident of the Seas and Kraken Tentacles from all sources<br>- Occult Necklaces from all sources<br>- Smoke Battlestaves from all sources<br>- Dragon Chainbodies from all sources<br>- Dragon Full Helmets from all sources<br>- Warped Sceptre from Warped Creatures<br>- All unique rewards from Superior Slayer Creatures<br>- Smouldering Stone from Hellhounds<br><br><br>",
