import { useInterval, useState } from 'ts2';

import { SlideshowFrames } from './trailblazer-areas.data';

export function Slideshow({ from, count }: { from: Int; count: Int }): Component {
  const [frame, setFrame] = useState(0);

  useInterval(
    () => {
      if (frame + 1 >= count) {
        setFrame(0);
        return;
      }
      setFrame(frame + 1);
    },
    { everyMs: 5000 },
  );

  return (
    <>
      <sprite w="fill" h="fill" sprite={SlideshowFrames.at(from + frame) ?? -1} />
      <sprite w="fill" h="fill" transparency={255} />
    </>
  );
}
