import { sessionState, useState } from 'ts2';

import { leagueAreaDetailsCurrentSubtab, leagueAreaDetailsCurrentTab } from '../lib/game/varcs';

import { playSound } from '../lib/lib.engine';

import { AreaSounds } from './trailblazer-areas.constants';
import { areaSelected } from './trailblazer-areas.helpers';

export const HoveredRegion = sessionState(-1);

export function hoverRegion(region: Int): void {
  const [, setHovered] = useState(HoveredRegion);
  setHovered(region);
}

export function unhoverRegion(): void {
  const [, setHovered] = useState(HoveredRegion);
  setHovered(-1);
}

export const LoadingShown = sessionState(0);

export function clickRegion(region: Int, tutorial: Int): void {
  if (region !== 2 && tutorial < 9 && !areaSelected(2)) {
    playSound(AreaSounds.REFUSE);
    return;
  }
  playSound(AreaSounds.SELECT);
  const [, setLoading] = useState(LoadingShown);
  setLoading(1);
  unhoverRegion();
}

export function echoRefused(): void {
  playSound(AreaSounds.REFUSE);
}

export function selectSound(): void {
  playSound(AreaSounds.SELECT);
}

export function pickTab(strip: Int, which: Int): void {
  selectSound();
  if (strip === 0) {
    const [, setTab] = useState(leagueAreaDetailsCurrentTab);
    setTab(which);
    const [, setSubtab] = useState(leagueAreaDetailsCurrentSubtab);
    setSubtab(0);
    return;
  }
  const [, setSub] = useState(leagueAreaDetailsCurrentSubtab);
  setSub(which);
}
