import { TrailblazerAreas } from './trailblazer-areas.component';
import { Layout, tooltipRef, trailblazerAreasRef } from './trailblazer-areas.constants';

export const trailblazerAreasUi = (): UI => (
  <ui ref={trailblazerAreasRef} x="center" y="center">
    <TrailblazerAreas />
    <TrailblazerAreasTooltip />
  </ui>
);

function TrailblazerAreasTooltip(): Component {
  return <layer ref={tooltipRef} x={{ center: Layout.TOOLTIP_X }} y={{ center: Layout.TOOLTIP_Y }} w="fill" h="fill" />;
}
