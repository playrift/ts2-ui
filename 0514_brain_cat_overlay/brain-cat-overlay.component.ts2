import {
  BackdropCamera,
  BackdropY,
  CatCamera,
  OverlayAnim,
  OverlayColor,
  OverlayModel,
} from './brain-cat-overlay.constants';

export function BrainCatOverlay(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={OverlayColor.PLATE} fill={true} />

      <model
        x="center"
        y={BackdropY.PROPORTION}
        w="fill"
        h="fill"
        model={OverlayModel.BACKDROP}
        zoom={BackdropCamera.ZOOM}
        pitch={BackdropCamera.PITCH}
      />

      <model
        x="center"
        y="bottom"
        w="fill"
        h="fill"
        model={OverlayModel.CAT}
        anim={OverlayAnim.CAT}
        zoom={CatCamera.ZOOM}
        pitch={CatCamera.PITCH}
        yaw={CatCamera.YAW}
        offsetY={CatCamera.OFFSET_Y}
      />
    </>
  );
}
