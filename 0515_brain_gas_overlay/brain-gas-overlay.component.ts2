import { GasTint, Layout, OverlayModel } from './brain-gas-overlay.constants';

export function BrainGasOverlay(): Component {
  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={GasTint.COLOR}
        fill={true}
        transparency={GasTint.TRANSPARENCY}
      />

      <model
        x="center"
        y="center"
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={OverlayModel.HAZE}
        anim={OverlayModel.SMOKEOVERLAY}
        zoom={Layout.MODEL_ZOOM}
      />
    </>
  );
}
