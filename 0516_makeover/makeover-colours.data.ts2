export function colourSetSize(set: Int): Int {
  if (set === ColourSet.HAIR) {
    return 30;
  }
  if (set === ColourSet.CLOTHES) {
    return 29;
  }
  if (set === ColourSet.BOTTOMS) {
    return 29;
  }
  if (set === ColourSet.SHOES) {
    return 6;
  }
  return 0;
}
