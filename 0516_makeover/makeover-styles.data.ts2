export function styleSetSize(set: Int): Int {
  if (set === StyleSet.HAIR) {
    return 57;
  }
  if (set === StyleSet.FACIAL_HAIR) {
    return 15;
  }
  if (set === StyleSet.TORSO) {
    return 20;
  }
  if (set === StyleSet.SLEEVES) {
    return 17;
  }
  if (set === StyleSet.BOTTOMS) {
    return 22;
  }
  if (set === StyleSet.SHOES) {
    return 2;
  }
  if (set === StyleSet.WRISTWEAR) {
    return 2;
  }
  return 0;
}
