export const Labels = {
  TITLE: 'Makeover',
  APPLY: 'Apply',
  CONFIRM: 'Confirm',
  PREVIEW: 'Preview',
  COLOUR: 'Colour',
  TOGGLE: 'Toggle',
  BUTTON_SUBJECT: '<col=ff9040>Style',
  SPIN: '<col=ff9040>Spin',
  ZOOM: '<col=ff9040>Zoom',
  TEMPLATE_TEXT: 'Wind braids',
};

export function styleSubject(category: Int): String {
  if (category === 0) {
    return '<col=ff9040>Hairstyle';
  }
  if (category === 1) {
    return '<col=ff9040>Facial Hairstyle';
  }
  if (category === 6) {
    return '<col=ff9040>Shoes';
  }
  if (category === 7) {
    return '<col=ff9040>Wristwear';
  }
  return '<col=ff9040>Clothes';
}

export function styleSetFor(category: Int): Int {
  if (category === 0) {
    return StyleSet.HAIR;
  }
  if (category === 1) {
    return StyleSet.FACIAL_HAIR;
  }
  if (category === 4) {
    return StyleSet.SLEEVES;
  }
  if (category === 5) {
    return StyleSet.BOTTOMS;
  }
  if (category === 6) {
    return StyleSet.SHOES;
  }
  if (category === 7) {
    return StyleSet.WRISTWEAR;
  }
  return StyleSet.TORSO;
}

export function colourSetFor(category: Int): Int {
  if (category === 0 || category === 1) {
    return ColourSet.HAIR;
  }
  if (category === 5) {
    return ColourSet.BOTTOMS;
  }
  if (category === 6) {
    return ColourSet.SHOES;
  }
  if (category === 7) {
    return ColourSet.NONE;
  }
  return ColourSet.CLOTHES;
}

export function wideGrid(category: Int): Boolean {
  if (category === 6 || category === 7) {
    return true;
  }
  return false;
}
