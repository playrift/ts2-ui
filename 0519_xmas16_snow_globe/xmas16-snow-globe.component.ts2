import { CloseButton } from '../0883_mm_formulas/close-button.component';
import { GlobeModel, Layout } from './xmas16-snow-globe.constants';

export function Xmas16SnowGlobe(): Component {
  return (
    <>
      <layer x="right" y={0} w={Layout.CLOSE_BOX} h={Layout.CLOSE_BOX}>
        <CloseButton w={Layout.CLOSE_W} h={Layout.CLOSE_H} />
      </layer>

      <model
        x={Layout.GLOBE_X}
        y={Layout.GLOBE_Y}
        w={Layout.GLOBE_BOX}
        h={Layout.GLOBE_BOX}
        model={GlobeModel.SNOW_GLOBE}
        zoom={Layout.GLOBE_ZOOM}
        pitch={Layout.GLOBE_PITCH}
        yaw={Layout.GLOBE_YAW}
      />
    </>
  );
}
