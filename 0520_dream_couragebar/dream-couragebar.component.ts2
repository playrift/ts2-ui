import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { CourageBar, CourageColor, CourageFont, Layout, SegmentX, Wash } from './dream-couragebar.constants';

const timerHost = createRef('0520_dream_couragebar_timer_host');

const container = createRef('dream_couragebar_container1');

export function DreamCouragebar(): Component {
  useInterval(() => overlayRelayout(timerHost, container, CourageBar.DODGE, Anchor.CENTRE, Anchor.TOP, 0), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={container} x="center" y={0} w={Layout.BOARD_W} h={Layout.BOARD_H}>
          {SegmentX.map((x) => (
            <layer x={x} y={Layout.SEGMENT_Y} w={Layout.SEGMENT_W} h={Layout.SEGMENT_H} hide>
              <rect
                x={0}
                y={0}
                w={Layout.BLOCK_W}
                h={Layout.BLOCK_H}
                color={CourageColor.SEGMENT}
                fill
                transparency={Wash.SEGMENT}
              />
            </layer>
          ))}

          <rect
            x={Layout.FRAME_LEFT_X}
            y={Layout.FRAME_UPRIGHT_Y}
            w={Layout.FRAME_UPRIGHT_W}
            h={Layout.FRAME_UPRIGHT_H}
            color={CourageColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RAIL_X}
            y={Layout.FRAME_BOTTOM_Y}
            w={Layout.FRAME_RAIL_W}
            h={Layout.FRAME_RAIL_H}
            color={CourageColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RIGHT_X}
            y={Layout.FRAME_UPRIGHT_Y}
            w={Layout.FRAME_UPRIGHT_W}
            h={Layout.FRAME_UPRIGHT_H}
            color={CourageColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <rect
            x={Layout.FRAME_RAIL_X}
            y={Layout.FRAME_TOP_Y}
            w={Layout.FRAME_RAIL_W}
            h={Layout.FRAME_RAIL_H}
            color={CourageColor.FRAME}
            fill
            transparency={Wash.FRAME}
          />

          <text
            x={Layout.CAPTION_X}
            y={Layout.CAPTION_Y}
            w={Layout.CAPTION_W}
            h={Layout.CAPTION_H}
            font={CourageFont.CAPTION}
            text="Cyrisus's Courage"
            align="center"
            shadow
            color={CourageColor.CAPTION}
          />
        </layer>
      </layer>
    </layer>
  );
}
