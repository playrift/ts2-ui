      <sprite x={12} y={20} w={482} h={295} sprite={Frame.BACKDROP} tiling />
      <sprite x={5} y={13} w={32} h={32} sprite={Frame.TOP_LEFT} />
      <sprite x={5} y={34} w={32} h={32} sprite={Frame.COLLAR_LEFT} />
      <sprite x={-8} y={55} w={37} h={243} sprite={Frame.LEFT} tiling />
      <sprite x={469} y={34} w={32} h={32} sprite={Frame.COLLAR_RIGHT} />
