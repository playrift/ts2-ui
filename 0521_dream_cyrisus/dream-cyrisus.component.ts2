      <rect x={200} y={164} w={Layout.LAMP_W} h={Layout.LAMP_H} color={Palette.LAMP_HOUSING} fill transparency={225} />
      <rect x={149} y={168} w={Layout.LAMP_W} h={Layout.LAMP_H} color={Palette.LAMP_HOUSING} fill transparency={200} />
