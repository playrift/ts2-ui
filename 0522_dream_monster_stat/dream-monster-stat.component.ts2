import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  DreamMonsterArt,
  DreamMonsterColor,
  DreamMonsterFonts,
  Layout,
  TITLE_TEXT,
} from './dream-monster-stat.constants';
import { DreamMonsterPanes } from './dream-monster-panes.component';
import { DreamMonsterTabs } from './dream-monster-tabs.component';

export function DreamMonsterStat(): Component {
  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={DreamMonsterArt.BACKING} tiling />

      <layer x={Layout.panel.x} y={Layout.panel.y} w={{ fill: Layout.panel.inset }} h={{ fill: Layout.panel.inset }}>
        <line x="center" y={Layout.RULE_Y} w="fill" h={0} color={DreamMonsterColor.RULE} lineWidth={1} />

        <text
          x={0}
          y={0}
          w={Layout.title.w}
          h={Layout.title.h}
          text={TITLE_TEXT}
          font={DreamMonsterFonts.TITLE}
          color={DreamMonsterColor.TITLE}
          shadow
          align="left"
          valign="top"
        />

        <layer x={0} y={Layout.strip.y} w="fill" h={Layout.strip.h}>
          <DreamMonsterTabs />
        </layer>

        <sprite
          x={{ right: Layout.close.right }}
          y={Layout.close.y}
          w={Layout.close.w}
          h={Layout.close.h}
          sprite={DreamMonsterArt.CLOSE}
          options={['Close']}
          onClick={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapper(event.component, DreamMonsterArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.component, DreamMonsterArt.CLOSE)}
        />

        <layer x={0} y={Layout.well.y} w="fill" h={{ fill: Layout.well.inset }}>
          <DreamMonsterPanes />
        </layer>
      </layer>
    </>
  );
}
