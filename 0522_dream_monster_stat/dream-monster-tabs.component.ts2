import { useState } from 'ts2';

import { DreamMonsterArt, Layout, Tab, Tabs } from './dream-monster-stat.constants';
import { dreamMonsterTab, selectDreamTab } from './dream-monster-stat.state';

export function DreamMonsterTabs(): Component {
  const [selected] = useState(dreamMonsterTab);
  const lit: Tab = selected === Tab.NONE ? Tab.MONSTER : selected;

  return (
    <layer w="fill" h="fill">
      {Tabs.map((entry) => (
        <layer
          x={entry.x}
          y={0}
          w={Layout.TAB_W}
          h={Layout.TAB_H}
          options={['Select']}
          onOptionSelect={() => selectDreamTab(entry.tab)}
        >
          <sprite
            x="center"
            y="center"
            w={Layout.TAB_W}
            h={Layout.TAB_H}
            sprite={entry.tab === lit ? DreamMonsterArt.TAB_SELECTED : DreamMonsterArt.TAB_REST}
          />
          <sprite x="center" y="center" w={Layout.ICON} h={Layout.ICON} sprite={entry.icon} />
        </layer>
      ))}
    </layer>
  );
}
