import { useRef } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { Layout, StatCells, StatsArt, StatsBar, StatsColor, StatsFonts } from './dream-player-stats.constants';

export function DreamPlayerStats(): Component {
  const list = useRef();

  return (
    <>
      <layer
        ref={list}
        x={Layout.LIST_X}
        y={Layout.LIST_Y}
        w={Layout.LIST_W}
        h={Layout.LIST_H}
        scrollHeight={Layout.LIST_SCROLL_H}
      >
        {StatCells.map((cell) => (
          <>
            <sprite x={cell.x} y={cell.y} w={Layout.ICON_W} h={Layout.ICON_H} sprite={cell.icon} />
            <text
              x={cell.x + Layout.CURRENT_DX}
              y={cell.y + Layout.CURRENT_DY}
              w={Layout.CURRENT_W}
              h={Layout.CURRENT_H}
              text={Layout.LEVEL_TEXT}
              font={StatsFonts.LEVEL}
              color={StatsColor.LEVEL}
              align="right"
              valign="top"
            />
            <text
              x={cell.x + Layout.MAX_DX}
              y={cell.y + Layout.MAX_DY}
              w={Layout.MAX_W}
              h={Layout.MAX_H}
              text={Layout.LEVEL_TEXT}
              font={StatsFonts.LEVEL}
              color={StatsColor.LEVEL}
              align="left"
              valign="top"
            />
            <text
              x={cell.x + Layout.SLASH_DX}
              y={cell.y + Layout.SLASH_DY}
              w={Layout.SLASH_W}
              h={Layout.SLASH_H}
              text={Layout.SLASH_TEXT}
              font={StatsFonts.SLASH}
              color={StatsColor.LEVEL}
              align="left"
              valign="top"
            />
          </>
        ))}
      </layer>

      <layer x={Layout.BAR_X} y={Layout.BAR_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
        <ScrollbarVertical
          content={list}
          track={StatsBar.TRACK}
          capTopSprite={StatsBar.CAP_TOP}
          thumbSprite={StatsBar.THUMB}
          capBottomSprite={StatsBar.CAP_BOTTOM}
          arrowUp={StatsBar.ARROW_UP}
          arrowDown={StatsBar.ARROW_DOWN}
        />
      </layer>

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={Layout.TITLE_TEXT}
        font={StatsFonts.TITLE}
        color={StatsColor.TITLE}
        align="center"
        valign="top"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={StatsArt.CLOSE}
        options={['Close']}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, StatsArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, StatsArt.CLOSE)}
      />

      <layer x={Layout.OLD_CLOSE_X} y={Layout.OLD_CLOSE_Y} w={Layout.OLD_CLOSE_W} h={Layout.OLD_CLOSE_H} hide>
        <sprite x={0} y={0} w={Layout.OLD_CLOSE_W} h={Layout.OLD_CLOSE_H} sprite={StatsArt.OLD_CLOSE} />
      </layer>
    </>
  );
}
