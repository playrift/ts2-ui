import { DreamTitleColor, DreamTitleFade, DreamTitleFont, Layout } from './dream-title.constants';

export function DreamTitle(): Component {
  return (
    <>
      <rect
        x="center"
        y={{ bottom: Layout.bar.bottom }}
        w={{ fill: Layout.bar.fillInset }}
        h={Layout.bar.h}
        fill
        color={DreamTitleColor.BAR}
        transparency={DreamTitleFade.BAR}
      />

      <text
        x="center"
        y={{ bottom: Layout.title.bottom }}
        w={Layout.title.w}
        h={Layout.title.h}
        font={DreamTitleFont.TITLE}
        color={DreamTitleColor.INK}
        shadow
        align="center"
      />

      <text
        x="center"
        y={{ bottom: Layout.description.bottom }}
        w={Layout.description.w}
        h={Layout.description.h}
        font={DreamTitleFont.DESCRIPTION}
        color={DreamTitleColor.INK}
        shadow
        align="center"
      />
    </>
  );
}
