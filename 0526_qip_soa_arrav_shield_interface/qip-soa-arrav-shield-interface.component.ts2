import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  ArravShieldArt,
  ArravShieldColor,
  ArravShieldFont,
  ArravShieldModel,
  Camera,
  Layout,
} from './qip-soa-arrav-shield-interface.constants';

export function QipSoaArravShieldInterface(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={ArravShieldModel.CERTIFICATE}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={ArravShieldFont.BODY}
        color={ArravShieldColor.INK}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={ArravShieldArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => {
          graphicSwapper(event.component, ArravShieldArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, ArravShieldArt.CLOSE);
        }}
      />
    </layer>
  );
}
