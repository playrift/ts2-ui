import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Layout,
  LowerCamera,
  LOWER_SLOTS,
  UpperCamera,
  UPPER_SLOTS,
  VmDigsiteArt,
  VmDigsiteColor,
  VmDigsiteFont,
} from './vm-digsite.constants';

export function VmDigsite(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={VmDigsiteColor.CARD} />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={VmDigsiteArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, VmDigsiteArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, VmDigsiteArt.CLOSE)}
      />

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={VmDigsiteFont.CAPTION}
        color={VmDigsiteColor.INK}
        valign="middle"
        shadow
      />

      {UPPER_SLOTS.map(() => (
        <model
          x={Layout.UPPER_SLOT_X}
          y={Layout.UPPER_SLOT_Y}
          w={Layout.SLOT_W}
          h={Layout.SLOT_H}
          zoom={UpperCamera.ZOOM}
          pitch={UpperCamera.PITCH}
          yaw={UpperCamera.YAW}
        />
      ))}

      {LOWER_SLOTS.map(() => (
        <model
          x={Layout.LOWER_SLOT_X}
          y={Layout.LOWER_SLOT_Y}
          w={Layout.SLOT_W}
          h={Layout.SLOT_H}
          zoom={LowerCamera.ZOOM}
          pitch={LowerCamera.PITCH}
          yaw={LowerCamera.YAW}
        />
      ))}

      <text
        x={Layout.LABEL_X}
        y={Layout.FOOTER_Y}
        w={Layout.LABEL_W}
        h={Layout.FOOTER_H}
        text="Display number"
        font={VmDigsiteFont.FOOTER}
        color={VmDigsiteColor.INK}
        align="right"
        shadow
      />

      <text
        x={Layout.NUMBER_X}
        y={Layout.FOOTER_Y}
        w={Layout.NUMBER_W}
        h={Layout.FOOTER_H}
        font={VmDigsiteFont.FOOTER}
        color={VmDigsiteColor.INK}
        shadow
      />
    </>
  );
}
