import { CS2, sessionState, useState } from 'ts2';

import { chatMessage } from '../lib/lib.engine';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { onEnhancedMobile } from '../0134_settings/settings.helpers';
import { onEnhancedAny } from '../0091_clanwars_setup/clanwars-setup.helpers';

import { SUMMARY_MODEL, SummaryLayout } from './league-summary.constants';

export const summaryMasteriesShown = sessionState(0);

export function leagueSummaryShowMasteries(): void {
  const [, setShown] = useState(summaryMasteriesShown);
  setShown(1);
}

export function leagueSummaryModelAt(zoom: Int, x: Int, y: Int): void {
  CS2.if_model_angle_set(0, 0, 0, 0, 0, zoom, SUMMARY_MODEL);
  CS2.if_position_set(x, y, 1, 1, SUMMARY_MODEL);
}

export function leagueSummaryModelAtYX(zoom: Int, y: Int, x: Int): void {
  CS2.if_model_angle_set(0, 0, 0, 0, 0, zoom, SUMMARY_MODEL);
  CS2.if_position_set(x, y, 1, 1, SUMMARY_MODEL);
}

export const summaryTip = sessionState(-1);

export function summaryTipShow(tip: Int): void {
  if (onEnhancedMobile()) {
    return;
  }
  if (onEnhancedAny()) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(SummaryLayout.TIP_DWELL)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  const [, setTip] = useState(summaryTip);
  setTip(tip);
  tooltipRaise();
}

export function summaryTipHide(): void {
  tooltipHide();
  const [, setTip] = useState(summaryTip);
  setTip(-1);
}

export function summaryTipMessage(text: String): void {
  chatMessage(`${text}.`);
}
