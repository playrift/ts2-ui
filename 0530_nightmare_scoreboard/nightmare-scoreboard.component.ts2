import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  NightmareArt,
  NightmareColor,
  NightmareFonts,
  NightmareModel,
  VALUE_PLACEHOLDER,
} from './nightmare-scoreboard.constants';

export function NightmareScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={NightmareModel.BACKDROP}
        zoom={Camera.ZOOM}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={NightmareArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, NightmareArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, NightmareArt.CLOSE);
          }}
        />
      </layer>

      <layer x={{ center: Layout.PANEL_X_OFFSET }} y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_W_INSET }} h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="The Nightmare Statistics"
          />
        </layer>

        <layer
          x="center"
          y={{ bottom: Layout.BODY_BAND_BOTTOM }}
          w={{ fill: Layout.BODY_BAND_W_INSET }}
          h={Layout.BODY_BAND_H}
        >
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_1_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Personal Killcount"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_1_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_2_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Personal Deaths"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_2_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_3_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Personal Best Time"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_3_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_1_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Global Killcount"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_1_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_2_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Global Deaths"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_2_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_3_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.HEADING}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text="Global Best Time"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_3_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={NightmareFonts.VALUE}
            color={NightmareColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />
        </layer>
      </layer>
    </>
  );
}
