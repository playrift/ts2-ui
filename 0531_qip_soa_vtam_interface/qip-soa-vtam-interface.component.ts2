import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { VtamArt, VtamCamera, VtamLayout, VtamModels } from './qip-soa-vtam-interface.constants';

export function QipSoaVtamInterface(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={VtamLayout.PANEL_W} h={VtamLayout.PANEL_H}>
        <model
          x="center"
          y="center"
          w={VtamLayout.MODEL_SIZE}
          h={VtamLayout.MODEL_SIZE}
          model={VtamModels.DIAGRAM}
          orthogonal={true}
          zoom={VtamCamera.ZOOM}
          pitch={VtamCamera.PITCH}
        />

        <sprite
          x={{ right: VtamLayout.CLOSE_RIGHT }}
          y={VtamLayout.CLOSE_TOP}
          w={VtamLayout.CLOSE_W}
          h={VtamLayout.CLOSE_H}
          sprite={VtamArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseRepeat={(event) => {
            graphicSwapper(event.component, VtamArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapper(event.component, VtamArt.CLOSE);
          }}
        />
      </layer>
    </layer>
  );
}
