import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Kudos, KudosColor, KudosFonts, KudosOverlay } from './vm-kudos.constants';
import { vmKudosUpdate } from './vm-kudos.helpers';

const timerHost1 = createRef('0532_vm_kudos_timer_host1');

const kudosBox = createRef('vm_kudos_box');

const kudosLabel = createRef('vm_kudos_label');

const kudosCounter = createRef('vm_kudos_counter');

export function VmKudos(): Component {
  useInterval(
    () => overlayRelayout(timerHost1, kudosBox, KudosOverlay.DODGE, Anchor.LEFT, Anchor.TOP, KudosOverlay.SIDEWAYS),
    timerHost1,
  );
  useInterval(() => vmKudosUpdate(kudosLabel, kudosCounter), kudosBox);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={kudosBox} x={0} y={0} w={Kudos.BOX_W} h={Kudos.BOX_H}>
          <text
            ref={kudosLabel}
            x={Kudos.TEXT_X}
            y={Kudos.TEXT_Y}
            w={0}
            h={Kudos.TEXT_H}
            align="left"
            valign="middle"
            shadow
            font={KudosFonts.LABEL}
            color={KudosColor.TEXT}
          />

          <text
            ref={kudosCounter}
            x={Kudos.TEXT_X}
            y={Kudos.TEXT_Y}
            w={0}
            h={Kudos.TEXT_H}
            align="right"
            valign="middle"
            shadow
            font={KudosFonts.COUNT}
            color={KudosColor.TEXT}
          />
        </layer>
      </layer>
    </layer>
  );
}
