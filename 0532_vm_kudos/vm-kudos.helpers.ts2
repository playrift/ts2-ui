import { CS2, useServerState } from 'ts2';

import { textWidth } from '../lib/lib.engine';
import { KUDOS_TOTAL, Kudos, KudosFonts, KudosVarbits, LABEL } from './vm-kudos.constants';

const enum SizeMode {
  ABS = 0,
}

export function vmKudosUpdate(label: ComponentId, counter: ComponentId): void {
  const kudos: Int = useServerState(KudosVarbits.KUDOS);
  let value: String = `${stringOf(kudos)}/${stringOf(KUDOS_TOTAL)}`;
  if (kudos >= KUDOS_TOTAL) {
    value = `<col=00ff00>${value}</col>`;
  }
  const width: Int =
    textWidth(LABEL, Kudos.MEASURE_WIDTH, KudosFonts.LABEL) +
    Kudos.GAP +
    textWidth(value, Kudos.MEASURE_WIDTH, KudosFonts.COUNT);

  CS2.if_size_set(width, Kudos.TEXT_H, SizeMode.ABS, SizeMode.ABS, label);
  CS2.if_size_set(width, Kudos.TEXT_H, SizeMode.ABS, SizeMode.ABS, counter);
  label.text = LABEL;
  counter.text = value;
}
