import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  AnswerY,
  CreatureZoom,
  Layout,
  MuseumArt,
  MuseumColors,
  MuseumFonts,
  MuseumText,
} from './vm-natural-history.constants';

export function VmNaturalHistory(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={MuseumColors.BACKDROP} />

      {CreatureZoom.map((zoom) => (
        <model
          x={Layout.CREATURE_X}
          y={Layout.CREATURE_Y}
          w={Layout.CREATURE_SIZE}
          h={Layout.CREATURE_SIZE}
          zoom={zoom}
          pitch={Layout.CREATURE_PITCH}
          yaw={Layout.CREATURE_YAW}
        />
      ))}

      <text
        x={Layout.NUMBER_LABEL_X}
        y={Layout.NUMBER_LABEL_Y}
        w={Layout.NUMBER_LABEL_W}
        h={Layout.NUMBER_LABEL_H}
        text={MuseumText.NUMBER_LABEL}
        font={MuseumFonts.LABEL}
        color={MuseumColors.AMBER}
        align="right"
        shadow
      />

      <text
        x={Layout.NUMBER_X}
        y={Layout.NUMBER_Y}
        w={Layout.NUMBER_W}
        h={Layout.NUMBER_H}
        font={MuseumFonts.LABEL}
        color={MuseumColors.AMBER}
        shadow
      />

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PANE_H} hide>
        <text
          x={0}
          y={0}
          w={Layout.BLURB_W}
          h={Layout.BLURB_H}
          font={MuseumFonts.BODY}
          color={MuseumColors.AMBER}
          valign="middle"
          shadow
        />
      </layer>

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PANE_H} hide>
        <text
          x={Layout.QUESTION_X}
          y={Layout.QUESTION_Y}
          w={Layout.QUESTION_W}
          h={Layout.QUESTION_H}
          font={MuseumFonts.BODY}
          color={MuseumColors.AMBER}
          shadow
        />
        {AnswerY.map((y) => (
          <text
            x={Layout.ANSWER_X}
            y={y}
            w={Layout.ANSWER_W}
            h={Layout.ANSWER_H}
            font={MuseumFonts.BODY}
            color={MuseumColors.AMBER}
            shadow
            options={['Ok']}
          />
        ))}
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MuseumArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, MuseumArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, MuseumArt.CLOSE)}
      />
    </>
  );
}
