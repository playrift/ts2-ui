import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  BACKDROP_COLOR,
  DISPLAY_LABEL,
  ExhibitSlots,
  LateSlots,
  Layout,
  MapLabels,
  SLOT_SIZE,
  TimelineArt,
  TimelineColor,
  TimelineFonts,
} from './vm-timeline.constants';

export function VmTimeline(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" fill color={BACKDROP_COLOR} />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={TimelineArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, TimelineArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, TimelineArt.CLOSE);
        }}
      />

      <text
        x={Layout.BODY_X}
        y={Layout.BODY_Y}
        w={Layout.BODY_W}
        h={Layout.BODY_H}
        font={TimelineFonts.BODY}
        color={TimelineColor.TEXT}
        shadow
        valign="middle"
      />

      {ExhibitSlots.map((slot) => (
        <model x={slot.x} y={slot.y} w={SLOT_SIZE} h={SLOT_SIZE} pitch={slot.pitch} yaw={slot.yaw} zoom={slot.zoom} />
      ))}

      <layer w={Layout.MAP_TEXT_W} h={Layout.MAP_TEXT_H} hide>
        {MapLabels.map((label) => (
          <text
            x={label.x}
            y={label.y}
            w={label.w}
            h={label.h}
            text={label.text}
            font={TimelineFonts.LABEL}
            color={TimelineColor.TEXT}
            shadow
            align="center"
          />
        ))}
      </layer>

      {LateSlots.map((slot) => (
        <model x={slot.x} y={slot.y} w={SLOT_SIZE} h={SLOT_SIZE} pitch={slot.pitch} yaw={slot.yaw} zoom={slot.zoom} />
      ))}

      <text
        x={Layout.DISPLAY_LABEL_X}
        y={Layout.DISPLAY_LABEL_Y}
        w={Layout.DISPLAY_LABEL_W}
        h={Layout.DISPLAY_LABEL_H}
        text={DISPLAY_LABEL}
        font={TimelineFonts.DISPLAY}
        color={TimelineColor.TEXT}
        shadow
        align="right"
      />

      <text
        x={Layout.DISPLAY_VALUE_X}
        y={Layout.DISPLAY_VALUE_Y}
        w={Layout.DISPLAY_VALUE_W}
        h={Layout.DISPLAY_VALUE_H}
        font={TimelineFonts.DISPLAY}
        color={TimelineColor.TEXT}
        shadow
      />
    </>
  );
}
