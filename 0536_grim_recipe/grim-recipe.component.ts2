import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, RecipeArt, RecipeColors, RecipeFonts, RecipeModels } from './grim-recipe.constants';

export function GrimRecipe(): Component {
  return (
    <>
      <layer x={Layout.SHEET_X} y={Layout.SHEET_Y} w={Layout.SHEET_W} h={Layout.SHEET_H}>
        <model
          x={Layout.PARCHMENT_X}
          y={Layout.PARCHMENT_Y}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={RecipeModels.PARCHMENT}
          zoom={Camera.PARCHMENT_ZOOM}
          pitch={Camera.PARCHMENT_PITCH}
          yaw={Camera.PARCHMENT_YAW}
        />
      </layer>

      <layer x={Layout.COPY_X} y={Layout.COPY_Y} w={Layout.COPY_W} h={Layout.COPY_H}>
        <text
          x={Layout.TITLE_X}
          y={Layout.TITLE_Y}
          w={Layout.TITLE_W}
          h={Layout.TITLE_H}
          text="Shrink-Me-Quick Recipe"
          font={RecipeFonts.BODY}
          color={RecipeColors.INK}
        />

        <text
          x={Layout.BODY_X}
          y={Layout.BODY_Y}
          w={Layout.BODY_W}
          h={Layout.BODY_H}
          text={
            '1x leaf of tarromin,                        1x shrunken ogleroot.                                                                 Mix the tarromin in a vial of water, then add the shrunken ogleroot. Drink when standing within an area prepared with glyphs for this potion to have full effect. Take one dose only, for a new perspective on the world...'
          }
          font={RecipeFonts.BODY}
          color={RecipeColors.INK}
        />
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={RecipeArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, RecipeArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, RecipeArt.CLOSE)}
      />

      <model
        x={Layout.STILL_X}
        y={Layout.STILL_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={RecipeModels.STILL}
        zoom={Camera.STILL_ZOOM}
        pitch={Camera.STILL_PITCH}
        yaw={Camera.STILL_YAW}
      />
    </>
  );
}
