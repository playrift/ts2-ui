import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  BoxCamera,
  LEGEND_FIRST_X,
  Layout,
  LegendKeys,
  MusicArt,
  MusicColor,
  MusicFonts,
  MusicModel,
  NoteHeads,
  SheetCamera,
  StaffLines,
  TuneNotes,
} from './grim-sheet-music.constants';

export function GrimSheetMusic(): Component {
  return (
    <>
      <model
        x={Layout.SHEET_X}
        y={Layout.SHEET_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MusicModel.SHEET}
        pitch={SheetCamera.PITCH}
        yaw={SheetCamera.YAW}
        zoom={SheetCamera.ZOOM}
      />

      {StaffLines.map((line) => (
        <rect x={line.x} y={line.y} w={Layout.STAFF_W} h={Layout.STAFF_H} color={MusicColor.INK} fill />
      ))}

      <sprite x={Layout.CLEF_X} y={Layout.CLEF_Y} w={Layout.CLEF_W} h={Layout.CLEF_H} sprite={MusicArt.CLEF} />

      <sprite x={109} y={28} w={Layout.NOTE_W} h={Layout.NOTE_H} sprite={MusicArt.NOTE_FIRST} />

      {NoteHeads.map((note) => (
        <sprite x={note.x} y={note.y} w={Layout.NOTE_W} h={Layout.NOTE_H} sprite={MusicArt.NOTE} />
      ))}

      {TuneNotes.map((note) => (
        <text
          x={note.x}
          y={Layout.TUNE_Y}
          w={Layout.LETTER_W}
          h={Layout.LETTER_H}
          font={MusicFonts.NOTE}
          color={MusicColor.INK}
          shadow
          text={note.text}
        />
      ))}

      <model
        x={Layout.BOX_X}
        y={Layout.BOX_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={MusicModel.BOX}
        pitch={BoxCamera.PITCH}
        yaw={BoxCamera.YAW}
        zoom={BoxCamera.ZOOM}
      />

      <text
        x={LEGEND_FIRST_X}
        y={Layout.LEGEND_Y}
        w={Layout.LETTER_W}
        h={Layout.LETTER_H}
        font={MusicFonts.KEY}
        color={MusicColor.INK}
        shadow
        text="C"
      />

      {LegendKeys.map((key) => (
        <text
          x={key.x}
          y={Layout.LEGEND_Y}
          w={Layout.LETTER_W}
          h={Layout.LETTER_H}
          font={MusicFonts.KEY}
          color={MusicColor.INK}
          align="center"
          shadow
          text={key.text}
        />
      ))}

      <text
        x={Layout.REGISTER_X}
        y={Layout.UPPER_Y}
        w={Layout.LETTER_W}
        h={Layout.LETTER_H}
        font={MusicFonts.KEY}
        color={MusicColor.INK}
        text="UPPER"
      />
      <text
        x={Layout.REGISTER_X}
        y={Layout.LOWER_Y}
        w={Layout.LETTER_W}
        h={Layout.LETTER_H}
        font={MusicFonts.KEY}
        color={MusicColor.INK}
        text="LOWER"
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MusicArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, MusicArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, MusicArt.CLOSE);
        }}
      />
    </>
  );
}
