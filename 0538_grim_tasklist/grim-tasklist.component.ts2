import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, TaskListArt, TaskListColors, TaskListFonts, TaskListModels } from './grim-tasklist.constants';

export function GrimTaskList(): Component {
  return (
    <>
      <layer x={Layout.SHEET_X} y={Layout.SHEET_Y} w={Layout.SHEET_W} h={Layout.SHEET_H}>
        <model
          x={Layout.PARCHMENT_X}
          y={Layout.PARCHMENT_Y}
          w={Layout.PARCHMENT_BOX}
          h={Layout.PARCHMENT_BOX}
          model={TaskListModels.PARCHMENT}
          zoom={Camera.PARCHMENT_ZOOM}
          pitch={Camera.PARCHMENT_PITCH}
          yaw={Camera.PARCHMENT_YAW}
        />
      </layer>

      <layer x={Layout.COPY_X} y={Layout.COPY_Y} w={Layout.COPY_W} h={Layout.COPY_H}>
        <text
          x={Layout.HEADING_X}
          y={Layout.HEADING_Y}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          text="Things to do:"
          font={TaskListFonts.BODY}
          color={TaskListColors.INK}
        />

        <text
          x={Layout.BODY_X}
          y={Layout.BODY_Y}
          w={Layout.BODY_W}
          h={Layout.BODY_H}
          text={
            "Take out the rubbish<br>Buy a new record for the gramophone<br>Check shrunken ogleroot supply<br>Feed ogleroots to my darlings<br>Wash the bedsheets<br>Hang out the washing<br>Practise the piano<br>Terrorise the little brat with the ball again<br>Trim hedges in the garden<br>Floss warts<br>Plot revenge on Fritz's murderer"
          }
          font={TaskListFonts.BODY}
          color={TaskListColors.INK}
        />
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={TaskListArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, TaskListArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TaskListArt.CLOSE)}
      />
    </>
  );
}
