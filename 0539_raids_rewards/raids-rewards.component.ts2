import { useRef } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { opsound } from '../lib/lib.helpers';
import { setTransparencyUnlessMobile } from './raids-rewards.helpers';
import { RaidsRewardsGrid } from './raids-rewards-grid.component';
import { ChestHighlight, ChestOpSound, ChestSprites, Content, Grid, RewardModels } from './raids-rewards.constants';

export function RaidsRewards(): Component {
  const bankIcon = useRef();
  const inventoryIcon = useRef();
  const discardIcon = useRef();

  return (
    <>
      <SteelBorderEntrypoint title="Rewards" />

      <layer x="center" y={{ bottom: Content.BOTTOM }} w={{ fill: Content.INSET_X }} h={{ fill: Content.INSET_Y }}>
        <model
          x={0}
          y={{ center: Grid.BOX_Y_OFFSET }}
          w={125}
          h={130}
          model={RewardModels.CHEST}
          zoom={RewardModels.CHEST_ZOOM}
          yaw={RewardModels.CHEST_YAW}
          offsetY={RewardModels.CHEST_OFFSET_Y}
        />

        <model
          x="right"
          y={{ center: Grid.BOX_Y_OFFSET }}
          w={100}
          h={130}
          model={RewardModels.DECOR}
          zoom={RewardModels.DECOR_ZOOM}
          pitch={RewardModels.DECOR_PITCH}
          yaw={RewardModels.DECOR_YAW}
          offsetX={RewardModels.DECOR_OFFSET_X}
          offsetY={RewardModels.DECOR_OFFSET_Y}
        />

        <RaidsRewardsGrid
          x={Grid.BOX_X}
          y={{ center: Grid.BOX_Y_OFFSET }}
          w={Grid.BOX_WIDTH}
          h={{ fill: Grid.BOX_HEIGHT_INSET }}
        />

        <sprite
          x={{ right: 40 }}
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Bank-all']}
          onMouseEnter={() => setTransparencyUnlessMobile(bankIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparencyUnlessMobile(bankIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.BANK)}
        />
        <sprite ref={bankIcon} x={{ right: 43 }} y={{ bottom: 7 }} w={29} h={22} sprite={ChestSprites.BANK_ICON} />

        <sprite
          x="right"
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['Take-all']}
          onMouseEnter={() => setTransparencyUnlessMobile(inventoryIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparencyUnlessMobile(inventoryIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.INVENTORY)}
        />
        <sprite
          ref={inventoryIcon}
          x={{ right: 5 }}
          y={{ bottom: 7 }}
          w={29}
          h={22}
          sprite={ChestSprites.INVENTORY_ICON}
        />

        <sprite
          x={0}
          y="bottom"
          w={36}
          h={36}
          sprite={ChestSprites.BUTTON}
          options={['', '', '', '', '', 'Discard-all']}
          onMouseEnter={() => setTransparencyUnlessMobile(discardIcon, ChestHighlight.HOVER)}
          onMouseLeave={() => setTransparencyUnlessMobile(discardIcon, ChestHighlight.IDLE)}
          onOptionSelect={(event) => opsound(event.option, ChestOpSound.DISCARD)}
        />
        <sprite ref={discardIcon} x={3} y={{ bottom: 7 }} w={29} h={22} sprite={ChestSprites.DISCARD_ICON} />
      </layer>
    </>
  );
}
