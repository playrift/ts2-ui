import { predictServerState, useServerState, useState } from 'ts2';

import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { itemName } from '../lib/lib.engine';
import { Colors, ExchangeEnums, ExchangeFonts, ExchangeVarbits } from './elnocks-exchange.constants';

export function ConfirmButton(): Component {
  const selected: Int = useServerState(ExchangeVarbits.SELECTED);
  const [held, setHeld] = useState(0);

  if (selected === 0) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonPressedFilled />
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          text="Select an item"
          font={ExchangeFonts.LABEL}
          color={Colors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  const chosen: ItemName = ExchangeEnums.REWARDS.get(selected) ?? -1;

  return (
    <layer w="fill" h="fill">
      {held === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        text={
          chosen !== -1
            ? `Confirm: <col=ffffff>${itemName(chosen as Item)} x${stringOf(ExchangeEnums.REWARD_COUNTS.get(chosen) ?? 1)}`
            : 'Confirm'
        }
        font={ExchangeFonts.LABEL}
        color={Colors.LABEL}
        shadow
        align="center"
        valign="middle"
        options={['Confirm']}
        onMouseRepeat={() => setHeld(1)}
        onMouseLeave={() => setHeld(0)}
      />
    </layer>
  );
}
