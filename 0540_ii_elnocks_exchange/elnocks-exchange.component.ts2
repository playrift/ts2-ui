import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ConfirmButton } from './confirm-button.component';
import { Frame } from './elnocks-exchange.constants';
import { PriceList } from './price-list.component';
import { RewardList } from './reward-list.component';
import { RowStripes } from './row-stripes.component';

export function ElnocksExchange(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Elnock's Exchange" />

      <layer x="center" y={{ center: Frame.BODY_DY }} w={{ fill: Frame.BODY_W_INSET }} h={{ fill: Frame.BODY_H_INSET }}>
        <layer x={0} y={0} w="fill" h={{ fill: Frame.BOX_H_INSET }}>
          <layer x={0} y={0} w={Frame.STRIPES_W} h={Frame.STRIPES_H}>
            <RowStripes />
          </layer>

          <layer x="right" y={0} w={{ fill: Frame.PRICE_W_INSET }} h="fill">
            <PriceList />
          </layer>

          <layer x={0} y={0} w={{ fill: Frame.BUY_W_INSET }} h="fill">
            <RewardList />
          </layer>

          <ThinBoxEntrypoint />
        </layer>

        <layer x="center" y="bottom" w={Frame.CONFIRM_W} h={Frame.CONFIRM_H}>
          <ConfirmButton />
        </layer>
      </layer>
    </>
  );
}
