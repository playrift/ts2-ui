import { useUniverse } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { Colors, ExchangeFonts, ExchangeRewardCounts, ExchangeRewards, Layout } from './elnocks-exchange.constants';

export const EXCHANGE_ROWS = [1, 2, 3, 4];

export function RewardList(): Component {
  const universe = useUniverse();
  const rowHeight: Int = universe.height / Layout.ROWS;
  const width: Int = universe.width;

  return (
    <>
      {EXCHANGE_ROWS.map((key, index) => (
        <RewardRow item={ExchangeRewards.get(key) ?? -1} rowY={rowHeight * index} rowHeight={rowHeight} width={width} />
      ))}
    </>
  );
}

function RewardRow({
  item,
  rowY,
  rowHeight,
  width,
}: {
  item: ItemName;
  rowY: Int;
  rowHeight: Int;
  width: Int;
}): Component {
  return (
    <>
      {item !== -1 && (
        <>
          <sprite
            x={width / 2 - Layout.REWARD_ICON_HALF}
            y={Layout.REWARD_ICON_Y + rowY}
            w={Layout.REWARD_ICON}
            h={Layout.REWARD_ICON}
            item={item}
            itemCount={1}
            outline={1}
          />

          <text
            x={0}
            y={Layout.REWARD_LABEL_Y + rowY}
            w={width}
            h={Layout.REWARD_LABEL_H}
            text={`${itemName(item as Item)} x${stringOf(ExchangeRewardCounts.get(item) ?? 1)}`}
            font={ExchangeFonts.LABEL}
            color={Colors.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </>
      )}

      <text
        x={width - Layout.EQUALS_RIGHT}
        y={rowY + (rowHeight / 2 - Layout.GLYPH_HALF)}
        w={Layout.GLYPH}
        h={Layout.GLYPH}
        text="="
        font={ExchangeFonts.OPERATOR}
        color={Colors.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
