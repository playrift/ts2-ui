import { predictServerState, useUniverse } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { ccSetTransparency } from './cc-settrans';
import { Colors, ExchangeRewards, ExchangeVarbits, Layout, Stripe } from './elnocks-exchange.constants';
import { EXCHANGE_ROWS } from './reward-list.component';

export function selectReward(key: Int): void {
  predictServerState(ExchangeVarbits.SELECTED, key);
}

export function RowStripes(): Component {
  const universe = useUniverse();
  const rowHeight: Int = universe.height / Layout.ROWS;
  const width: Int = universe.width;
  const mobile: Boolean = onMobile();

  return (
    <>
      {EXCHANGE_ROWS.map((key, index) => (
        <>
          {mobile ? (
            <rect
              x={0}
              y={rowHeight * index}
              w={width}
              h={index === Layout.ROWS - 1 ? rowHeight + 1 : rowHeight}
              fill
              color={Colors.STRIPE}
              transparency={index % 2 === 0 ? Stripe.EVEN_ROW : Stripe.ODD_ROW}
              options={[`Select <col=ff981f>${itemName(ExchangeRewards.get(key) as Item)}`]}
              onOptionSelect={() => selectReward(key)}
            />
          ) : (
            <rect
              x={0}
              y={rowHeight * index}
              w={width}
              h={index === Layout.ROWS - 1 ? rowHeight + 1 : rowHeight}
              fill
              color={Colors.STRIPE}
              transparency={index % 2 === 0 ? Stripe.EVEN_ROW : Stripe.ODD_ROW}
              options={[`Select <col=ff981f>${itemName(ExchangeRewards.get(key) as Item)}`]}
              onOptionSelect={() => selectReward(key)}
              onMouseRepeat={(event) => ccSetTransparency(event.component, event.subId, Stripe.HOVER)}
              onMouseLeave={(event) =>
                ccSetTransparency(event.component, event.subId, index % 2 === 0 ? Stripe.EVEN_ROW : Stripe.ODD_ROW)
              }
            />
          )}

          {index < Layout.ROWS - 1 && (
            <>
              <rect
                x="center"
                y={rowHeight * (index + 1)}
                w={{ fill: Layout.DIVIDER_W_INSET }}
                h={Layout.DIVIDER_H}
                fill
                color={Colors.DIVIDER_DARK}
              />
              <rect
                x="center"
                y={rowHeight * (index + 1) + 1}
                w={{ fill: Layout.DIVIDER_W_INSET }}
                h={Layout.DIVIDER_H}
                fill
                color={Colors.DIVIDER_LIGHT}
              />
            </>
          )}
        </>
      ))}
    </>
  );
}
