import { Layout, PrayerbookSprites } from './prayerbook.constants';

export function FilterPanelFrame(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={16} y={-13} w={{ fill: 32 }} h={32} sprite={PrayerbookSprites.SLIM_TOP} tiling />
      <sprite x={16} y={{ bottom: -12 }} w={{ fill: 32 }} h={32} sprite={PrayerbookSprites.SLIM_BOTTOM} tiling />
      <sprite x={-13} y={16} w={32} h={{ fill: 32 }} sprite={PrayerbookSprites.SLIM_LEFT} tiling />
      <sprite x={{ right: -12 }} y={16} w={32} h={{ fill: 32 }} sprite={PrayerbookSprites.SLIM_RIGHT} tiling />
      <sprite x="left" y="top" w={32} h={32} sprite={PrayerbookSprites.SLIM_NW} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={PrayerbookSprites.SLIM_NE} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={PrayerbookSprites.SLIM_SW} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={PrayerbookSprites.SLIM_SE} tiling />
      <sprite x={0} y={Layout.MENU_FRAME_H - 20} w="fill" h={32} sprite={PrayerbookSprites.SLIM_DIVIDER} tiling />
      <sprite x={0} y={Layout.MENU_FRAME_H - 18} w={32} h={32} sprite={PrayerbookSprites.SLIM_DIVIDER_LEFT} tiling />
      <sprite
        x={{ right: 0 }}
        y={Layout.MENU_FRAME_H - 18}
        w={32}
        h={32}
        sprite={PrayerbookSprites.SLIM_DIVIDER_RIGHT}
        tiling
      />
    </layer>
  );
}
