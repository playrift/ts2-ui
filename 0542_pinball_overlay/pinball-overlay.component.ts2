import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, PinballColor, PinballOverlay, PinballOverlayFonts } from './pinball-overlay.constants';
import { pinballScore } from './pinball-overlay.helpers';

const content = createRef('pinball_overlay_content1');

export function PinballOverlay_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={PinballColor.WASH}
        fill
        transparency={PinballColor.WASH_TRANSPARENCY}
      />

      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, PinballOverlay.DODGE, Anchor.RIGHT, Anchor.BOTTOM, 0)
        }
      >
        <text
          ref={content}
          x="right"
          y="bottom"
          w={Layout.SCORE_W}
          h={Layout.SCORE_H}
          font={PinballOverlayFonts.SCORE}
          text=""
          align="center"
          valign="middle"
          shadow
          color={PinballColor.LABEL}
          onTimer={(event) => pinballScore(event.component)}
        />
      </layer>
    </layer>
  );
}
