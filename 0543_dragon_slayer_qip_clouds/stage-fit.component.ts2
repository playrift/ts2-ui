import { useUniverse } from 'ts2';
import { fitToStage } from './stage-fit';

export function StageFitBackdrop({ panel, color }: { panel: Ref; color: Int }): Component {
  const universe = useUniverse();

  fitToStage(universe, panel);
  universe.onResize = () => {
    fitToStage(universe, panel);
  };

  return <rect x="center" y="center" w="fill" h="fill" fill color={color} />;
}
