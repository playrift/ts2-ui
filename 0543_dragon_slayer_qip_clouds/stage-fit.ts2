import { CS2 } from 'ts2';
import { Holder } from './dragon-slayer-qip-clouds.constants';

export function fitToStage(stage: Ref, panel: Ref): void {
  const width: Int = stage.width;
  const height: Int = stage.height;

  if (width > Holder.MAX_W) {
    if (height > Holder.MAX_H) {
      CS2.if_size_set(Holder.MAX_W, Holder.MAX_H, 0, 0, panel);
    } else {
      CS2.if_size_set(Holder.MAX_W, 0, 0, 1, panel);
    }
  } else if (height > Holder.MAX_H) {
    CS2.if_size_set(0, Holder.MAX_H, 1, 0, panel);
  } else {
    CS2.if_size_set(0, 0, 1, 1, panel);
  }
}
