import { createRef } from 'ts2';
import { Elvarg, ElvargAnim, ElvargModel, ELVARG_X_CENTER_OFFSET } from './dragon-slayer-qip-elvarg.constants';

const dragonSlayerQipElvarg = createRef('dragon_slayer_qip_elvarg');

export function DragonSlayerQipElvarg(): Component {
  return (
    <model
      x={{ center: ELVARG_X_CENTER_OFFSET }}
      y={{ center: '0%' }}
      w={Elvarg.BOX}
      h={Elvarg.BOX}
      model={ElvargModel.ELVARG}
      anim={ElvargAnim.FLY}
      zoom={Elvarg.ZOOM}
      pitch={Elvarg.PITCH}
      yaw={Elvarg.YAW}
    />
  );
}

export const dragonSlayerQipElvargUi = (): UI => (
  <ui ref={dragonSlayerQipElvarg}>
    <DragonSlayerQipElvarg />
  </ui>
);
