import { createRef } from 'ts2';
import { StageFitBackdrop } from '../0543_dragon_slayer_qip_clouds/stage-fit.component';
import { ElvargAnim, Cloud, Elvarg, Holder, Sky, SkyBand, SkyColors } from './dragon-slayer-qip-elvarg-fly.constants';

const sky = createRef('dragon_slayer_qip_elvarg_fly_sky');

export function DragonSlayerQipElvargFly(): Component {
  return (
    <>
      <StageFitBackdrop panel={sky} color={SkyColors.VOID} />

      <layer static ref={sky} x="center" y="center" w={Holder.W} h={Holder.H}>
        <rect w={Sky.BAND_W} color={SkyColors.RULE} />

        <rect x="center" y="bottom" w={Sky.BAND_W} h="fill" fill color={SkyColors.BAND_0} />

        {SkyBand.map((band) => (
          <rect x="center" y={{ bottom: band.up }} w={Sky.BAND_W} h={band.h} fill color={band.color} />
        ))}

        {Cloud.map((cloud) => (
          <model x={cloud.x} y={cloud.y} w={Sky.MODEL_BOX} h={Sky.MODEL_BOX} model={cloud.model} zoom={cloud.zoom} />
        ))}

        <model
          x={Elvarg.x}
          y={Elvarg.y}
          w={Sky.MODEL_BOX}
          h={Sky.MODEL_BOX}
          model={Elvarg.model}
          zoom={Elvarg.zoom}
          pitch={Elvarg.pitch}
          yaw={Elvarg.yaw}
          anim={ElvargAnim.FLY}
        />
      </layer>
    </>
  );
}
