import { createRef } from 'ts2';
import { StageFitBackdrop } from '../0543_dragon_slayer_qip_clouds/stage-fit.component';
import { ElvargAnim, Flyer, Holder, Sky, SkyBand, SkyColors } from './dragon-slayer-qip-elvarg-fly.constants';

const sky = createRef('dragon_slayer_qip_elvarg_fly_sky');

export function DragonSlayerQipElvargFly(): Component {
  return (
    <>
      <StageFitBackdrop panel={sky} color={SkyColors.VOID} />

      <layer static ref={sky} x="center" y="center" w={Holder.W} h={Holder.H}>
        <rect w={Sky.BAND_W} color={SkyColors.RULE} />

        <rect x="center" y="bottom" w={Sky.BAND_W} h="fill" fill color={SkyColors.BAND_0} />

        <rect x="center" y={{ bottom: SkyBand.B1.up }} w={Sky.BAND_W} h={SkyBand.B1.h} fill color={SkyBand.B1.color} />
        <rect x="center" y={{ bottom: SkyBand.B2.up }} w={Sky.BAND_W} h={SkyBand.B2.h} fill color={SkyBand.B2.color} />
        <rect x="center" y={{ bottom: SkyBand.B3.up }} w={Sky.BAND_W} h={SkyBand.B3.h} fill color={SkyBand.B3.color} />
        <rect x="center" y={{ bottom: SkyBand.B4.up }} w={Sky.BAND_W} h={SkyBand.B4.h} fill color={SkyBand.B4.color} />
        <rect x="center" y={{ bottom: SkyBand.B5.up }} w={Sky.BAND_W} h={SkyBand.B5.h} fill color={SkyBand.B5.color} />
        <rect x="center" y={{ bottom: SkyBand.B6.up }} w={Sky.BAND_W} h={SkyBand.B6.h} fill color={SkyBand.B6.color} />
        <rect x="center" y={{ bottom: SkyBand.B7.up }} w={Sky.BAND_W} h={SkyBand.B7.h} fill color={SkyBand.B7.color} />
        <rect x="center" y={{ bottom: SkyBand.B8.up }} w={Sky.BAND_W} h={SkyBand.B8.h} fill color={SkyBand.B8.color} />
        <rect x="center" y={{ bottom: SkyBand.B9.up }} w={Sky.BAND_W} h={SkyBand.B9.h} fill color={SkyBand.B9.color} />
        <rect
          x="center"
          y={{ bottom: SkyBand.B10.up }}
          w={Sky.BAND_W}
          h={SkyBand.B10.h}
          fill
          color={SkyBand.B10.color}
        />
        <rect
          x="center"
          y={{ bottom: SkyBand.B11.up }}
          w={Sky.BAND_W}
          h={SkyBand.B11.h}
          fill
          color={SkyBand.B11.color}
        />

        <model
          x={Flyer.CLOUD_A.x}
          y={Flyer.CLOUD_A.y}
          w={Sky.MODEL_BOX}
          h={Sky.MODEL_BOX}
          model={Flyer.CLOUD_A.model}
          zoom={Flyer.CLOUD_A.zoom}
        />
        <model
          x={Flyer.CLOUD_B.x}
          y={Flyer.CLOUD_B.y}
          w={Sky.MODEL_BOX}
          h={Sky.MODEL_BOX}
          model={Flyer.CLOUD_B.model}
          zoom={Flyer.CLOUD_B.zoom}
        />
        <model
          x={Flyer.CLOUD_C.x}
          y={Flyer.CLOUD_C.y}
          w={Sky.MODEL_BOX}
          h={Sky.MODEL_BOX}
          model={Flyer.CLOUD_C.model}
          zoom={Flyer.CLOUD_C.zoom}
        />

        <model
          x={Flyer.ELVARG.x}
          y={Flyer.ELVARG.y}
          w={Sky.MODEL_BOX}
          h={Sky.MODEL_BOX}
          model={Flyer.ELVARG.model}
          zoom={Flyer.ELVARG.zoom}
          pitch={Flyer.ELVARG.pitch}
          yaw={Flyer.ELVARG.yaw}
          anim={ElvargAnim.FLY}
        />
      </layer>
    </>
  );
}
