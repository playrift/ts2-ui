import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, MapArt, MapModels } from './dragon-slayer-qip-map.constants';

export function DragonSlayerQipMap(): Component {
  return (
    <>
      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MAP_W}
        h={Layout.MAP_H}
        model={MapModels.STATE_1}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        offsetX={Camera.OFFSET_X}
        offsetY={Camera.OFFSET_Y}
      />

      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MAP_W}
        h={Layout.MAP_H}
        model={MapModels.STATE_2}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        offsetX={Camera.OFFSET_X}
        offsetY={Camera.OFFSET_Y}
      />

      <model
        x={Layout.MAP_X}
        y={Layout.MAP_Y}
        w={Layout.MAP_W}
        h={Layout.MAP_H}
        model={MapModels.STATE_3}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        offsetX={Camera.OFFSET_X}
        offsetY={Camera.OFFSET_Y}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MapArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, MapArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, MapArt.CLOSE)}
      />
    </>
  );
}
