      <sprite x={210} y={0} w={Stone.ICON_W} h={Stone.H} sprite={magicIcon} hide={magicHidden} />
    </>
  );
}

function BottomTabs(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const channelsTab: Int = useServerState(Varbits.SIDE_CHANNELS_TAB_SELECTED);
  const ironman: Int = useServerState(Varbits.IRONMAN);
  const friendsPanel: Int = useServerState(Varbits.FRIENDS_PANEL);

  let channelsLabel: String = SideChannelLabels.get(channelsTab) ?? 'Chat-channel';
  let channelsIcon: Sprite = SideChannelIcons.get(channelsTab) ?? 781;
  const ironmanGroup: Boolean = ironman === 4 || ironman === 5 || ironman === 6;
  if (ironmanGroup && (channelsTab === 4 || channelsTab === 5 || channelsTab === 6)) {
    channelsLabel = SideChannelLabels.get(ironman) ?? 'Chat-channel';
    channelsIcon = SideChannelIcons.get(ironman) ?? 781;
  }
  let ironmanOp: String = '';
  if (ironmanGroup && channelsTab !== ironman) {
    ironmanOp = SideChannelLabels.get(ironman) ?? 'Chat-channel';
  }
  const channel0: String = channelsTab !== 0 ? 'Chat-channel' : '';
  const channel1: String = channelsTab !== 1 ? (SideChannelLabels.get(1) ?? '') : '';
  const channel2: String = channelsTab !== 2 ? (SideChannelLabels.get(2) ?? '') : '';
  const channel3: String = channelsTab !== 3 ? (SideChannelLabels.get(3) ?? '') : '';

  const friendsFirst: String = friendsPanel === 0 ? 'Friends List' : 'Ignore List';
  const friendsSecond: String = friendsPanel === 0 ? 'Ignore List' : 'Friends List';
  const friendsIcon: Sprite = friendsPanel === 0 ? Sprites.SIDEICONS_INTERFACE_8 : Sprites.SIDEICONS_INTERFACE_9;

  const channelsHidden: Boolean = tabHidden(Panel.CHANNELS);
  const accountHidden: Boolean = tabHidden(Panel.ACCOUNT);
  const friendsHidden: Boolean = tabHidden(Panel.FRIENDS);
  const logoutHidden: Boolean = tabHidden(Panel.LOGOUT);
  const settingsHidden: Boolean = tabHidden(Panel.SETTINGS);
  const emotesHidden: Boolean = tabHidden(Panel.EMOTES);
  const musicHidden: Boolean = tabHidden(Panel.MUSIC);

  return (
    <>
      <sprite
        x={3}
        y={0}
        w={Stone.WIDE}
        h={Stone.H}
        sprite={stoneSprite(Panel.CHANNELS, Sprites.SIDE_STONE_HIGHLIGHTS_2)}
        hide={channelsHidden}
        options={[channelsLabel, ironmanOp, channel0, channel1, channel2, channel3]}
        onOptionSelect={(event) => fixedTabOp(Panel.CHANNELS, event.option)}
      />
      <sprite
        x={74}
        y={0}
        w={Stone.WIDE}
        h={Stone.H}
        tiling
        sprite={stoneSprite(Panel.ACCOUNT, Sprites.SIDE_STONE_HIGHLIGHTS_4)}
        hide={accountHidden}
        options={[SidePanelOps.at(Panel.ACCOUNT) ?? '', 'Account', 'Community', 'Useful links']}
        onOptionSelect={(event) => fixedTabOp(Panel.ACCOUNT, event.option)}
      />
      <sprite
        x={41}
        y={0}
        w={Stone.NARROW}
        h={Stone.H}
        tiling
        sprite={stoneSprite(Panel.FRIENDS, Sprites.SIDE_STONE_HIGHLIGHTS_4)}
        hide={friendsHidden}
        options={[friendsFirst, friendsSecond]}
        onOptionSelect={(event) => fixedTabOp(Panel.FRIENDS, event.option)}
      />
      <sprite
        x={107}
        y={0}
        w={Stone.NARROW}
        h={Stone.H}
        tiling
        sprite={stoneSprite(Panel.LOGOUT, Sprites.SIDE_STONE_HIGHLIGHTS_4)}
        hide={logoutHidden}
        options={[SidePanelOps.at(Panel.LOGOUT) ?? '', 'World Switcher']}
        onOptionSelect={(event) => fixedTabOp(Panel.LOGOUT, event.option)}
      />
      <sprite
        x={140}
        y={0}
        w={Stone.NARROW}
        h={Stone.H}
        tiling
        sprite={stoneSprite(Panel.SETTINGS, Sprites.SIDE_STONE_HIGHLIGHTS_4)}
        hide={settingsHidden}
        options={[SidePanelOps.at(Panel.SETTINGS) ?? '', 'Controls', 'Audio', 'Display']}
        onOptionSelect={(event) => fixedTabOp(Panel.SETTINGS, event.option)}
      />
      <sprite
        x={173}
        y={0}
        w={Stone.NARROW}
        h={Stone.H}
        tiling
        sprite={stoneSprite(Panel.EMOTES, Sprites.SIDE_STONE_HIGHLIGHTS_4)}
        hide={emotesHidden}
        options={[SidePanelOps.at(Panel.EMOTES) ?? '']}
        onOptionSelect={(event) => fixedTabOp(Panel.EMOTES, event.option)}
      />
      <sprite
        x={206}
        y={0}
        w={Stone.WIDE}
        h={Stone.H}
        sprite={stoneSprite(Panel.MUSIC, Sprites.SIDE_STONE_HIGHLIGHTS_3)}
        hide={musicHidden}
        options={[SidePanelOps.at(Panel.MUSIC) ?? '']}
        onOptionSelect={(event) => fixedTabOp(Panel.MUSIC, event.option)}
      />
      <sprite x={7} y={0} w={Stone.ICON_W} h={Stone.H} sprite={channelsIcon} hide={channelsHidden} />
      <sprite x={74} y={0} w={Stone.ICON_W} h={Stone.H} sprite={Sprites.SIDE_ICONS_22} hide={accountHidden} />
      <sprite x={41} y={0} w={Stone.ICON_W} h={Stone.H} sprite={friendsIcon} hide={friendsHidden} />
      <sprite x={107} y={0} w={Stone.ICON_W} h={Stone.H} sprite={Sprites.SIDE_ICONS_10} hide={logoutHidden} />
      <sprite x={140} y={0} w={Stone.ICON_W} h={Stone.H} sprite={Sprites.SIDE_ICONS_11} hide={settingsHidden} />
      <sprite x={173} y={0} w={Stone.ICON_W} h={Stone.H} sprite={Sprites.SIDE_ICONS_12} hide={emotesHidden} />
      <sprite x={207} y={0} w={Stone.ICON_W} h={Stone.H} sprite={Sprites.SIDE_ICONS_13} hide={musicHidden} />
    </>
  );
}

export function CompassOps(): Component {
  const state: Int = useServerState(Varbits.MINIMAP_STATE);
  let live: Boolean = true;
  if (state === 3 || state === 4 || state === 5) {
    live = false;
  }
  return (
    <>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        options={live ? ['Look North', 'Look East', 'Look South', 'Look West'] : undefined}
        onOptionSelect={live ? (event) => compassOp(event.option) : undefined}
      />
    </>
  );
}

export function GravestoneTimer(): Component {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const tliHide: Int = useServerState(Varbits.GRAVESTONE_TLI_HIDE);
  const [ticks] = useState(graveTicks);
  const [elapsed] = useState(graveElapsed);
  let shown: Boolean = true;
  if (duration <= 0 || tliHide === 1) {
    shown = false;
  }
  const hidden: Boolean = !shown;
  let long: Boolean = false;
  if (duration > Grave.LONG) {
    long = true;
  }
  let label: String = '---';
  let colour: Int = Grave.DIM;
  if (shown && !long) {
    let total: Int = ticks;
    if (total === -1) {
      total = duration * Grave.TICKS_PER_UNIT;
    }
    const seconds: Int = Math.max(1, (total - elapsed) / Grave.PER_SECOND);
    const minutes: Int = seconds / 60;
    const rest: Int = seconds % 60;
    label = rest >= 10 ? `${minutes}:${rest}` : `${minutes}:0${rest}`;
    colour = tobHudNameFlasher();
  }
  useWatch(Varbits.GRAVESTONE_DURATION, () => graveResynch());
  useInterval(() => {
    const [start] = useState(graveStart);
    const [, setElapsed] = useState(graveElapsed);
    if (start !== -1) {
      setElapsed(Math.min(clientClock() - start, Grave.MAX_STEP));
    }
  });
  return (
    <>
      <sprite
        x="center"
        y={Grave.ICON_Y}
        w={Grave.ICON_SIZE}
        h={Grave.ICON_SIZE}
        sprite={Sprites.MOD_ICONS_INTERFACE_21}
        hide={hidden}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        align="center"
        valign="bottom"
        shadow
        color={colour}
        text={label}
        hide={hidden}
      />
    </>
  );
}

function graveResynch(): void {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const [, setTicks] = useState(graveTicks);
  const [, setStart] = useState(graveStart);
  const [, setElapsed] = useState(graveElapsed);
  if (duration <= 0 || duration > Grave.LONG) {
    setTicks(-1);
    setStart(-1);
    setElapsed(0);
    return;
  }
  setTicks(duration * Grave.TICKS_PER_UNIT);
  setStart(clientClock());
  setElapsed(0);
}

export function EhcHooks(): Component {
  const enhanced: Boolean = enhancedAny();
  return (
    <>
      {enhanced && (
        <>
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
        </>
      )}
    </>
  );
}
