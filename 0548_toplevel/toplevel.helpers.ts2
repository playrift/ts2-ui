import { CS2, useServerState, useState } from 'ts2';

import { cameraDoZoom, zoomPositionSlider } from '../0016_oculus/oculus.camera';
import { Sprites } from '../lib/game/sprites';
import { Varbits } from '../lib/game/varbits';
import {
  cameraZoomBig,
  cameraZoomBigMax,
  cameraZoomBigMin,
  cameraZoomSmall,
  cameraZoomSmallMax,
  cameraZoomSmallMin,
  osmSidepanelOnLeft,
  toplevelMainmodalBgColour,
  toplevelMainmodalBgTrans,
  toplevelPanel,
} from '../lib/game/varcs';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { HelperFlags, Panel, helperContentRef, helperDodgerRef } from './toplevel.constants';

export function desktopToplevelInit(layout: Int, hasTabs: Boolean): void {
  const [panel, setPanel] = useState(toplevelPanel);
  if (panel <= 0 && !deselectsOpenTab(layout)) {
    setPanel(Panel.INVENTORY);
  }
  const [, setBgColour] = useState(toplevelMainmodalBgColour);
  const [, setBgTrans] = useState(toplevelMainmodalBgTrans);
  setBgColour(-1);
  setBgTrans(-1);
  zoomPositionSlider();
  if (layout === ToplevelComponents.SPECTATOR) {
    CS2.show_mouseover_text_set(false);
    CS2.show_mouse_cross_set(false);
    CS2.show_loading_messages_set(false);
  } else {
    CS2.show_mouseover_text_set(true);
    CS2.show_mouse_cross_set(true);
    CS2.show_loading_messages_set(true);
  }
  CS2.feedback_sprite_set(Sprites.CROSS, false);
  CS2.feedback_show_popup_text_set(false);
  const [selected] = useState(toplevelPanel);
  switchSidePanel(selected, 0, hasTabs);
}

export function fixedToplevelInit(): void {
  desktopToplevelInit(ToplevelComponents.FIXED, true);
}

export function deselectsOpenTab(layout: Int): Boolean {
  if (layout === ToplevelComponents.PRE_EOC) {
    return true;
  }
  return false;
}

export function fixedHelperInit(): void {
  if (onMobile()) {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.MOBILE, Anchor.LEFT, Anchor.TOP, 1);
  } else {
    overlayInit(helperDodgerRef, helperContentRef, HelperFlags.DESKTOP, Anchor.LEFT, Anchor.TOP, 1);
  }
}

export function switchSidePanel(panel: Int, onLeft: Int, hasTabs: Boolean): void {
  const [, setPanel] = useState(toplevelPanel);
  const [, setOnLeft] = useState(osmSidepanelOnLeft);
  if (hasTabs && panel >= 0 && panel < Panel.COUNT) {
    setPanel(panel);
  } else {
    setPanel(Panel.NONE);
  }
  setOnLeft(onLeft);
}

export function fixedTabOp(panel: Int, option: Int): void {
  if (option !== 1) {
    return;
  }
  switchSidePanel(panel, 0, true);
}

export function desktopFov(clamp: Int, layout: Int): void {
  if (clamp !== 0) {
    if (clamp === 2) {
      CS2.viewport_fov_set(512, 220);
      CS2.viewport_clampfov(0, 0, 0, 0);
    } else if (clamp === 3) {
      CS2.viewport_fov_set(256, 256);
      if (layout === ToplevelComponents.FIXED) {
        CS2.viewport_clampfov(512, 512, 512, 512);
      } else {
        CS2.viewport_clampfov(192, 656, 448, 512);
      }
    } else {
      CS2.viewport_fov_set(256, 256);
      CS2.viewport_clampfov(512, 512, 512, 512);
    }
    CS2.cam_follow_height_set(50);
    return;
  }
  CS2.viewport_clampfov(0, 0, 0, 0);
  const [small] = useState(cameraZoomSmall);
  const [big] = useState(cameraZoomBig);
  const [smallMin] = useState(cameraZoomSmallMin);
  const [smallMax] = useState(cameraZoomSmallMax);
  const [bigMin] = useState(cameraZoomBigMin);
  const [bigMax] = useState(cameraZoomBigMax);
  if (small >= smallMin && small <= smallMax && big >= bigMin && big <= bigMax) {
    cameraDoZoom(small, big);
  } else {
    cameraDoZoom(512, 512);
  }
}

export function wikiMinimapMask(): Boolean {
  if (useServerState(Varbits.WIKI_ICON_DISABLED) === 1) {
    return false;
  }
  if (useServerState(Varbits.ORBS_DISABLED) === 1 && !onMobile()) {
    return false;
  }
  return true;
}
