import { graphicSwapper } from '../lib/lib.helpers';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { KillLogArt, KillLogColor, KillLogFonts, Layout, WASH_TRANSPARENCY } from './kill-log.constants';
import { dismissKillLogConfirm } from './kill-log.helpers';
import { confirmationLayer, noClick } from './kill-log.refs';

export function KillLog(): Component {
  return (
    <layer x={Layout.ROOT_XY} y={Layout.ROOT_XY} w={{ fill: Layout.ROOT_INSET }} h={{ fill: Layout.ROOT_INSET }}>
      <layer x={0} y={0} w="fill" h="fill">
        <StoneBorderEntrypoint title="" />
      </layer>

      <layer x={Layout.CONTENTS_X} y={0} w={{ fill: Layout.CONTENTS_W_INSET }} h={{ fill: Layout.CONTENTS_H_INSET }}>
        <text
          x="center"
          y={0}
          w={{ fill: Layout.TITLE_W_INSET }}
          h={Layout.TITLE_H}
          text="This is a title!"
          font={KillLogFonts.HEADING}
          color={KillLogColor.TITLE}
          shadow
          align="center"
          valign="middle"
        />

        <layer x="right" y={Layout.PANE_Y} w={Layout.SCROLLBAR_W} h={{ fill: Layout.PANE_H_INSET }} />

        <layer x={0} y={Layout.PANE_Y} w={{ fill: Layout.PANE_W_INSET }} h={{ fill: Layout.PANE_H_INSET }}>
          <rect
            x={Layout.RULE_X}
            y={Layout.RULE_Y}
            w={{ fill: Layout.RULE_W_INSET }}
            h={Layout.RULE_H}
            color={KillLogColor.RULE}
          />

          <rect x={Layout.COL_RULE_1_X} y={0} w={Layout.COL_RULE_W} h="fill" color={KillLogColor.RULE} />

          <rect x={Layout.COL_RULE_2_X} y={0} w={Layout.COL_RULE_W} h="fill" color={KillLogColor.RULE} />

          <text
            x={0}
            y={0}
            w={Layout.NAME_W}
            h={Layout.HEAD_H}
            text="Monster"
            font={KillLogFonts.HEADING}
            color={KillLogColor.LABEL}
            shadow
          />

          <text
            x={Layout.KILLS_X}
            y={0}
            w={Layout.KILLS_W}
            h={Layout.HEAD_H}
            text="Kills"
            font={KillLogFonts.HEADING}
            color={KillLogColor.LABEL}
            shadow
            align="right"
          />

          <text
            x={Layout.STREAK_X}
            y={0}
            w={Layout.STREAK_W}
            h={Layout.HEAD_H}
            text="Streak"
            font={KillLogFonts.HEADING}
            color={KillLogColor.LABEL}
            shadow
            align="right"
          />

          <layer x={0} y={Layout.ROWS_Y} w="fill" h={{ fill: Layout.ROWS_H_INSET }} />
          <layer x={0} y={Layout.ROWS_Y} w={Layout.NAME_W} h={{ fill: Layout.ROWS_H_INSET }} />
          <layer x={Layout.KILLS_X} y={Layout.ROWS_Y} w={Layout.KILLS_W} h={{ fill: Layout.ROWS_H_INSET }} />
          <layer x={Layout.STREAK_X} y={Layout.ROWS_Y} w={Layout.STREAK_W} h={{ fill: Layout.ROWS_H_INSET }} />
          <layer x={Layout.RESET_COL_X} y={Layout.ROWS_Y} w={Layout.RESET_COL_W} h={{ fill: Layout.ROWS_H_INSET }} />

          <layer static ref={noClick} x="center" y="center" w="fill" h="fill" noClickThrough hide>
            <rect
              x="center"
              y="center"
              w="fill"
              h="fill"
              color={KillLogColor.WASH}
              fill
              transparency={WASH_TRANSPARENCY}
            />

            <layer
              static
              ref={confirmationLayer}
              x={{ right: Layout.CONFIRM_RIGHT }}
              y={Layout.CONFIRM_Y}
              w={Layout.CONFIRM_W}
              h={Layout.CONFIRM_H}
              hide
            >
              <layer x="center" y="center" w="fill" h="fill">
                <sprite x={0} y={0} w="fill" h="fill" sprite={KillLogArt.BACKDROP} tiling />
              </layer>

              <rect
                x={0}
                y={0}
                w={{ fill: Layout.INNER_BORDER_INSET }}
                h={{ fill: Layout.INNER_BORDER_INSET }}
                color={KillLogColor.INNER_BORDER}
              />

              <rect x="center" y="center" w="fill" h="fill" color={KillLogColor.RULE} />

              <text
                x="center"
                y={Layout.RESET_TEXT_Y}
                w="fill"
                h={{ fill: Layout.RESET_TEXT_H_INSET }}
                text="Reset streak:<br>Monster"
                font={KillLogFonts.BODY}
                color={KillLogColor.LABEL}
                shadow
                align="center"
                valign="middle"
              />

              <layer
                x={Layout.TICK_INSET}
                y={{ bottom: Layout.TICK_INSET }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
                options={['Confirm Reset']}
                onOptionSelect={() => dismissKillLogConfirm()}
              >
                <sprite
                  x={Layout.TICK_GFX_XY}
                  y={Layout.TICK_GFX_XY}
                  w={Layout.TICK_GFX}
                  h={Layout.TICK_GFX}
                  sprite={KillLogArt.CONFIRM_REST}
                  onMouseEnter={(event) => graphicSwapper(event.component, KillLogArt.CONFIRM_HOVER)}
                  onMouseLeave={(event) => graphicSwapper(event.component, KillLogArt.CONFIRM_REST)}
                />
              </layer>

              <layer
                x={{ right: Layout.TICK_INSET }}
                y={{ bottom: Layout.TICK_INSET }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
                options={['Cancel Reset']}
                onOptionSelect={() => dismissKillLogConfirm()}
              >
                <sprite
                  x={Layout.TICK_GFX_XY}
                  y={Layout.TICK_GFX_XY}
                  w={Layout.TICK_GFX}
                  h={Layout.TICK_GFX}
                  sprite={KillLogArt.CANCEL_REST}
                  onMouseEnter={(event) => graphicSwapper(event.component, KillLogArt.CANCEL_HOVER)}
                  onMouseLeave={(event) => graphicSwapper(event.component, KillLogArt.CANCEL_REST)}
                />
              </layer>
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
