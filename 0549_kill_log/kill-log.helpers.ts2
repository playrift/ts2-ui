import { playSound } from '../lib/lib.engine';
import { KillLogSounds } from './kill-log.constants';
import { confirmationLayer, noClick } from './kill-log.refs';

export function hideKillLogConfirm(): void {
  noClick.hide = true;
  confirmationLayer.hide = true;
}

export function dismissKillLogConfirm(): void {
  playSound(KillLogSounds.CLICK);
  hideKillLogConfirm();
}
