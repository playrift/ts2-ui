import { CS2, intArray, useInventory, useRef, useUniverse } from 'ts2';
import { itemName, playSound } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import {
  DonatableItems,
  Grid,
  Layout,
  SharedInventory,
  SharedInventoryId,
  StorageColors,
  StorageFonts,
  StorageSounds,
  StorageSprites,
  Transparency,
} from './raids-storage-shared.constants';

function SharedSlot({ item, count, rank }: { item: Item; count: Int; rank: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (rank % Grid.COLUMNS) * Grid.STRIDE_X}
      y={(rank / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={StorageColors.SLOT_SHADOW}
      transparency={Transparency.CLEAR}
      options={['Withdraw', 'Withdraw-5', 'Withdraw-10', 'Withdraw-All', 'Withdraw-X', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={(event) => {
        if (event.option === 10) {
          return;
        }
        playSound(StorageSounds.SELECT);
        flashFor(event.self, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}

export function SharedItems(): Component {
  const storage = useInventory(SharedInventory.STORAGE);
  const pane = useRef();
  const universe = useUniverse();

  const counts = intArray(Grid.ROWS);
  const rank = intArray(Grid.ROWS);
  let placed: Int = 0;
  let lastRowY: Int = 0;
  let row: Int = 0;
  let candidate: Item = DonatableItems.at(row) ?? -1;
  while (candidate !== -1) {
    const held: Int = CS2.invother_total(SharedInventoryId.STORAGE, candidate);
    counts[row] = held;
    rank[row] = placed;
    if (held > 0) {
      lastRowY = (placed / Grid.COLUMNS) * Grid.STRIDE_Y;
      placed = placed + 1;
    }
    row = row + 1;
    candidate = DonatableItems.at(row) ?? -1;
  }

  const extent: Int = lastRowY + Grid.H;
  const paneHeight: Int = universe.height - Layout.PANE_H_INSET;

  let occupied: Int = 0;
  let slot: Int = storage.size;
  while (slot > 0) {
    slot = slot - 1;
    if (CS2.invother_num_get(SharedInventoryId.STORAGE, slot) > 0) {
      occupied = occupied + 1;
    }
  }

  return (
    <>
      <text
        x={Layout.COUNT_X}
        y={Layout.COUNT_Y}
        w={Layout.COUNT_W}
        h={Layout.COUNT_H}
        text={`${occupied}`}
        font={StorageFonts.SMALL}
        color={StorageColors.LABEL}
        shadow
        align="center"
        valign="top"
      />

      <layer
        ref={pane}
        x={Layout.PANE_X}
        y={{ bottom: Layout.PANE_Y }}
        w={{ fill: Layout.PANE_W_INSET }}
        h={{ fill: Layout.PANE_H_INSET }}
        scrollHeight={extent > paneHeight ? extent : 0}
      >
        {DonatableItems.map(
          (item, index) => counts[index] > 0 && <SharedSlot item={item} count={counts[index]} rank={rank[index]} />,
        )}
      </layer>

      <layer
        x={{ right: Layout.BAR_X }}
        y={{ bottom: Layout.PANE_Y }}
        w={Layout.BAR_W}
        h={{ fill: Layout.PANE_H_INSET }}
      >
        <ScrollbarVertical
          content={pane}
          track={StorageSprites.BAR_TRACK}
          capTopSprite={StorageSprites.BAR_CAP_TOP}
          thumbSprite={StorageSprites.BAR_THUMB}
          capBottomSprite={StorageSprites.BAR_CAP_BOTTOM}
          arrowUp={StorageSprites.BAR_ARROW_UP}
          arrowDown={StorageSprites.BAR_ARROW_DOWN}
        />
      </layer>
    </>
  );
}
