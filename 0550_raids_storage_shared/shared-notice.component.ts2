import { useServerState } from 'ts2';
import { IronmanType, isGroupIronman } from '../0551_raids_storage_side/raids-storage-side.helpers';
import { Layout, SharedVarbits, StorageColors, StorageFonts } from './raids-storage-shared.constants';

function noticeLine(ironman: Int, sharing: Int): String {
  if (ironman === IronmanType.NONE) {
    return (
      'Items donated here may be retrieved by <col=ff0000>other</col> party-members,<br>' +
      'or <col=ff0000>may be lost</col> if the party dissolves.'
    );
  }
  if (ironman === IronmanType.ULTIMATE || sharing === 0) {
    return (
      'As an <col=ff0000>Ironman</col> you <col=ff0000>cannot retrieve</col> items<br>' +
      'once you have donated them to the party.'
    );
  }
  if (isGroupIronman(ironman)) {
    return (
      'As an <col=ff0000>Ironman</col> you <col=ff0000>may retrieve</col> items<br>' +
      'as everyone present is in your group.'
    );
  }
  return (
    'As an <col=ff0000>Ironman</col> you <col=ff0000>may retrieve</col> items<br>' +
    'as you have embarked on this raid alone.'
  );
}

export function SharedNotice(): Component {
  const ironman: Int = useServerState(SharedVarbits.IRONMAN);
  const sharing: Int = useServerState(SharedVarbits.IRON_SHARING);

  return (
    <text
      x="center"
      y={Layout.NOTICE_Y}
      w={{ fill: Layout.NOTICE_W_INSET }}
      h={Layout.NOTICE_H}
      text={noticeLine(ironman, sharing)}
      font={StorageFonts.BODY}
      color={StorageColors.WHITE}
      shadow
      align="center"
      valign="middle"
    />
  );
}
