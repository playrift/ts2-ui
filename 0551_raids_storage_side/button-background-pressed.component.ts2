import { StorageSprites } from './raids-storage-side.constants';

export function ButtonBackgroundPressed(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={6} h={6} sprite={StorageSprites.PRESSED_NW} />
      <sprite x={6} y="top" w={{ fill: 12 }} h={6} sprite={StorageSprites.PRESSED_N} tiling />
      <sprite x="right" y="top" w={6} h={6} sprite={StorageSprites.PRESSED_NE} />
      <sprite x="left" y={6} w={6} h={{ fill: 12 }} sprite={StorageSprites.PRESSED_W} tiling />
      <sprite x={6} y={6} w={{ fill: 12 }} h={{ fill: 12 }} sprite={StorageSprites.PRESSED_C} tiling />
      <sprite x="right" y={6} w={6} h={{ fill: 12 }} sprite={StorageSprites.PRESSED_E} tiling />
      <sprite x="left" y="bottom" w={6} h={6} sprite={StorageSprites.PRESSED_SW} />
      <sprite x={6} y="bottom" w={{ fill: 12 }} h={6} sprite={StorageSprites.PRESSED_S} tiling />
      <sprite x="right" y="bottom" w={6} h={6} sprite={StorageSprites.PRESSED_SE} />
    </layer>
  );
}
