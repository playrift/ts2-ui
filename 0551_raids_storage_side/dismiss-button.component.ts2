import { createRef, useInterval, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from './button-background-pressed.component';
import { Overlay, PRESS_CYCLES, StorageColors, StorageFonts, StorageSounds } from './raids-storage-side.constants';

const timerHost = createRef('0551_raids_storage_side_timer_host');

const DISMISS = 'Dismiss';

export function DismissButton(): Component {
  useInterval(() => {
    if (clientClock() < pressedUntil) {
      return;
    }
    setPressedUntil(0);
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);

  if (pressedUntil !== 0) {
    return (
      <layer
        x="center"
        y={{ bottom: Overlay.BUTTON_Y }}
        w={Overlay.BUTTON_W}
        h={Overlay.BUTTON_H}
        options={[DISMISS]}
        ref={timerHost}
      >
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="---"
          font={StorageFonts.BODY}
          color={StorageColors.WHITE}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      x="center"
      y={{ bottom: Overlay.BUTTON_Y }}
      w={Overlay.BUTTON_W}
      h={Overlay.BUTTON_H}
      options={[DISMISS]}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(StorageSounds.SELECT);
        setPressedUntil(clientClock() + PRESS_CYCLES);
      }}
    >
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={DISMISS}
        font={StorageFonts.BODY}
        color={StorageColors.LABEL}
        hover={{ color: StorageColors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
