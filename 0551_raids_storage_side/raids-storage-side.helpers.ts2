import { DonatableItems } from './raids-storage-side.constants';

export enum IronmanType {
  NONE = 0,
  ULTIMATE = 2,
  GROUP = 4,
  HARDCORE_GROUP = 5,
  UNRANKED_GROUP = 6,
}

export function isGroupIronman(type: Int): Boolean {
  if (type === IronmanType.GROUP) {
    return true;
  }
  if (type === IronmanType.HARDCORE_GROUP) {
    return true;
  }
  if (type === IronmanType.UNRANKED_GROUP) {
    return true;
  }
  return false;
}

export function isDonatable(item: Item): Boolean {
  let found: Boolean = false;
  let index: Int = 0;
  let candidate: Item = DonatableItems.at(index);
  while (!found && candidate !== -1) {
    if (candidate === item) {
      found = true;
    }
    index = index + 1;
    candidate = DonatableItems.at(index);
  }
  return found;
}
