import { useServerState } from 'ts2';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { DismissButton } from './dismiss-button.component';
import { IronmanType, isGroupIronman } from './raids-storage-side.helpers';
import {
  Overlay,
  StorageColors,
  StorageFonts,
  StorageSprites,
  StorageVarbits,
  Transparency,
} from './raids-storage-side.constants';

function warningLine(ironman: Int): String {
  if (ironman === IronmanType.NONE) {
    return (
      'Items donated here may be retrieved by <col=ff0000>other</col> party-members, ' +
      'or <col=ff0000>may be lost</col> if the party dissolves.'
    );
  }
  if (ironman === IronmanType.ULTIMATE) {
    return (
      'As an <col=ff0000>Ironman</col> you <col=ff0000>cannot retrieve</col> items ' +
      'once you have donated them to the party.'
    );
  }
  if (isGroupIronman(ironman)) {
    return (
      'As an <col=ff0000>Ironman</col> you <col=ff0000>may only retrieve items</col> ' +
      'if you embark on raids with only your group.'
    );
  }
  return (
    'As an <col=ff0000>Ironman</col> you <col=ff0000>may only retrieve items</col> ' + 'if you embark on raids alone.'
  );
}

export function WarningOverlay(): Component {
  const dismissed: Int = useServerState(StorageVarbits.WARNING_DISMISSED);
  const privateStorage: Int = useServerState(StorageVarbits.PRIVATE_STORAGE);
  const ironman: Int = useServerState(StorageVarbits.IRONMAN);

  if (dismissed === 1 || privateStorage === 1) {
    return null;
  }

  return (
    <layer w="fill" h="fill" noClickThrough>
      <rect
        x="center"
        y="center"
        w={{ fill: Overlay.DIM_OUTER_INSET }}
        h={{ fill: Overlay.DIM_OUTER_INSET }}
        fill
        color={StorageColors.DIM}
        transparency={Transparency.DIM}
      />
      <rect
        x="center"
        y="center"
        w={{ fill: Overlay.DIM_INNER_INSET }}
        h={{ fill: Overlay.DIM_INNER_INSET }}
        fill
        color={StorageColors.DIM}
        transparency={Transparency.DIM}
      />

      <layer x="center" y="center" w={Overlay.BOX_W} h={Overlay.BOX_H}>
        <sprite w="fill" h="fill" sprite={StorageSprites.BACKING} tiling />
        <text
          x="center"
          y={Overlay.TEXT_Y}
          w={{ fill: Overlay.TEXT_INSET_X }}
          h={{ fill: Overlay.TEXT_INSET_Y }}
          text={warningLine(ironman)}
          font={StorageFonts.BODY}
          color={StorageColors.WHITE}
          shadow
          align="center"
          valign="middle"
        />
        <DismissButton />
        <SteelFrameEntrypoint />
      </layer>
    </layer>
  );
}
