import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Layout, TelescopeAnims, TelescopeArt, TelescopeColors, TelescopeModels } from './qip-obs-telescope.constants';

export function QipObsTelescope(): Component {
  return (
    <>
      <rect x={Layout.VOID_X} y={Layout.VOID_Y} w={Layout.VOID_W} h={Layout.VOID_H} fill color={TelescopeColors.VOID} />

      <rect
        x={Layout.BAND_1_X}
        y={Layout.BAND_1_Y}
        w={Layout.BAND_1_W}
        h={Layout.BAND_1_H}
        fill
        color={TelescopeColors.BAND_1}
      />

      <rect
        x={Layout.BAND_2_X}
        y={Layout.BAND_2_Y}
        w={Layout.BAND_2_W}
        h={Layout.BAND_2_H}
        fill
        color={TelescopeColors.BAND_2}
      />

      <rect
        x={Layout.BAND_3_X}
        y={Layout.BAND_3_Y}
        w={Layout.BAND_3_W}
        h={Layout.BAND_3_H}
        fill
        color={TelescopeColors.BAND_3}
      />

      <rect
        x={Layout.BAND_4_X}
        y={Layout.BAND_4_Y}
        w={Layout.BAND_4_W}
        h={Layout.BAND_4_H}
        fill
        color={TelescopeColors.BAND_4}
      />

      <rect
        x={Layout.BAND_5_X}
        y={Layout.BAND_5_Y}
        w={Layout.BAND_5_W}
        h={Layout.BAND_5_H}
        fill
        color={TelescopeColors.BAND_5}
      />

      <model
        x={Layout.VIEWFINDER_X}
        y={Layout.VIEWFINDER_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={TelescopeModels.VIEWFINDER}
        zoom={Layout.VIEWFINDER_ZOOM}
        pitch={Layout.MODEL_PITCH}
      />

      <model
        x={Layout.STARS_X}
        y={Layout.STARS_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={TelescopeModels.STARS}
        anim={TelescopeAnims.STARS}
        zoom={Layout.STARS_ZOOM}
        pitch={Layout.MODEL_PITCH}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={TelescopeArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapper(event.component, TelescopeArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TelescopeArt.CLOSE)}
      />
    </>
  );
}
