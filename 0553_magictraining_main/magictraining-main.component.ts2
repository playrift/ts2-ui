import { createRef, useInterval } from 'ts2';

import {
  Layout,
  MainArrows,
  MainColor,
  MainFonts,
  MainModel,
  MainRows,
  MainRowYs,
} from './magictraining-main.constants';
import { magictrainingAlchInit } from './magictraining.overlay';

const timerHost = createRef('0553_magictraining_main_timer_host');

const dodger = createRef('magictraining_main_dodger');

const contents = createRef('magictraining_main_contents');

export function MagicTrainingMain_(): Component {
  useInterval(() => magictrainingAlchInit(dodger, contents), timerHost);

  return (
    <layer w="fill" h="fill" ref={timerHost}>
      <layer ref={dodger} w="fill" h="fill">
        <layer ref={contents} x="right" y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <model
            x={{ right: Layout.ARENA_RIGHT }}
            y={Layout.ARENA_Y}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={MainModel.ARENA}
            zoom={Layout.ARENA_ZOOM}
            pitch={Layout.ARENA_PITCH}
          />

          <text
            x={{ right: Layout.TITLE_RIGHT }}
            y={Layout.TITLE_Y}
            w={Layout.TITLE_W}
            h={Layout.TITLE_H}
            font={MainFonts.TITLE}
            text="Magic Training Arena"
            align="center"
            valign="middle"
            shadow
            color={MainColor.TITLE}
          />

          <text
            x={Layout.HEADER_X}
            y={Layout.HEADER_Y}
            w={Layout.HEADER_W}
            h={Layout.HEADER_H}
            font={MainFonts.ROW}
            text="Pizazz Points"
            align="center"
            shadow
            color={MainColor.LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={MainRows.TELE_Y}
            w={Layout.LABEL_W}
            h={Layout.ROW_H_TALL}
            font={MainFonts.ROW}
            text="Telekinetic:"
            valign="middle"
            shadow
            color={MainColor.LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={MainRows.ALCH_Y}
            w={Layout.LABEL_W}
            h={Layout.ROW_H}
            font={MainFonts.ROW}
            text="Alchemist:"
            shadow
            color={MainColor.LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={MainRows.ENCH_Y}
            w={Layout.LABEL_W}
            h={Layout.ROW_H}
            font={MainFonts.ROW}
            text="Enchantment:"
            shadow
            color={MainColor.LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={MainRows.GRAVE_Y}
            w={Layout.LABEL_W}
            h={Layout.ROW_H}
            font={MainFonts.ROW}
            text="Graveyard:"
            valign="middle"
            shadow
            color={MainColor.LABEL}
          />

          {MainRowYs.map((y) => (
            <text
              x={{ right: Layout.VALUE_RIGHT }}
              y={y}
              w={Layout.VALUE_W}
              h={Layout.ROW_H}
              font={MainFonts.ROW}
              text="999"
              align="right"
              shadow
              color={MainColor.VALUE}
            />
          ))}

          {MainArrows.map((arrow) => (
            <layer x={arrow.x} y={arrow.y} w={Layout.ARROW_W} h={Layout.ARROW_H} hide>
              <model
                w={Layout.ARROW_W}
                h={Layout.ARROW_H}
                model={MainModel.ARROW}
                zoom={Layout.ARROW_ZOOM}
                pitch={arrow.pitch}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
