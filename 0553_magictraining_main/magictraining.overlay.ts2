import { Anchor, overlayInit } from '../lib/lib.overlay';

export enum MagicTrainingDodge {
  TOP = 36582,

  BOTTOM = 36578,
}

export function magictrainingAlchInit(dodger: ComponentId, content: ComponentId): void {
  overlayInit(dodger, content, MagicTrainingDodge.TOP, Anchor.RIGHT, Anchor.TOP, 0);
}

export function magictrainingOtherInit(
  dodgerTop: ComponentId,
  dodgerBottom: ComponentId,
  contentTop: ComponentId,
  contentBottom: ComponentId,
): void {
  overlayInit(dodgerTop, contentTop, MagicTrainingDodge.TOP, Anchor.RIGHT, Anchor.TOP, 0);
  overlayInit(dodgerBottom, contentBottom, MagicTrainingDodge.BOTTOM, Anchor.RIGHT, Anchor.BOTTOM, 0);
}
