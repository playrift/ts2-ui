export function PianoBase(): Component {
  const progress: Int = useServerState(PianoVars.PROGRESS);
  return (
    <model
      x={Layout.MODEL_X}
      y={{ center: Layout.MODEL_Y }}
      w={Layout.MODEL_BOX}
      h={Layout.MODEL_BOX}
      model={progress >= PianoProgress.PLAYED ? PianoModels.BASE_PLAYED : PianoModels.BASE}
      zoom={Camera.ZOOM}
      pitch={Camera.PITCH}
    />
  );
}
