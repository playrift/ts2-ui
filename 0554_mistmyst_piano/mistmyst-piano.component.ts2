            color={PianoColors.LABEL}
            shadow
            align="center"
            valign="bottom"
            options={[Keys.E1.option]}
            onMouseEnter={() => modelSwapper(keyE1, Keys.E1.lit)}
            onMouseLeave={() => modelSwapper(keyE1, Keys.E1.rest)}
          />
          <text
            x={Keys.F1.x}
            y={{ center: Layout.KEY_Y }}
            w={Layout.KEY_W}
            h={Layout.KEY_H}
            text={Keys.F1.note}
            font={PianoFonts.LABEL}
            color={PianoColors.LABEL}
            shadow
            align="center"
