            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.E2.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyF2}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.F2.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyG2}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.G2.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyA2}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.A2.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyB2}
