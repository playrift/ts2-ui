            text={Keys.B1.note}
            font={PianoFonts.LABEL}
            color={PianoColors.LABEL}
            shadow
            align="center"
            valign="bottom"
            options={[Keys.B1.option]}
            onMouseEnter={() => modelSwapper(keyB1, Keys.B1.lit)}
            onMouseLeave={() => modelSwapper(keyB1, Keys.B1.rest)}
          />
          <text
            x={Keys.C2.x}
            y={{ center: Layout.KEY_Y }}
            w={Layout.KEY_W}
            h={Layout.KEY_H}
            text={Keys.C2.note}
            font={PianoFonts.LABEL}
            color={PianoColors.LABEL}
            shadow
            align="center"
            valign="bottom"
            options={[Keys.C2.option]}
            onMouseEnter={() => modelSwapper(keyC2, Keys.C2.lit)}
            onMouseLeave={() => modelSwapper(keyC2, Keys.C2.rest)}
          />
          <text
            x={Keys.D2.x}
            y={{ center: Layout.KEY_Y }}
            w={Layout.KEY_W}
            h={Layout.KEY_H}
            text={Keys.D2.note}
            font={PianoFonts.LABEL}
            color={PianoColors.LABEL}
            shadow
            align="center"
            valign="bottom"
            options={[Keys.D2.option]}
            onMouseEnter={() => modelSwapper(keyD2, Keys.D2.lit)}
            onMouseLeave={() => modelSwapper(keyD2, Keys.D2.rest)}
          />
          <text
            x={Keys.E2.x}
            y={{ center: Layout.KEY_Y }}
