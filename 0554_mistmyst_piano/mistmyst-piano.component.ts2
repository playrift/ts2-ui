  Layout,
  PianoColors,
  PianoFonts,
  PianoModels,
  PianoProgress,
  PianoSprites,
  PianoVars,
} from './mistmyst-piano.constants';
import { modelSwapper } from './mistmyst-piano.helpers';

const keyC1 = createRef('mistmyst_piano_key_c1');
const keyD1 = createRef('mistmyst_piano_key_d1');
const keyE1 = createRef('mistmyst_piano_key_e1');
const keyF1 = createRef('mistmyst_piano_key_f1');
const keyG1 = createRef('mistmyst_piano_key_g1');
const keyA1 = createRef('mistmyst_piano_key_a1');
const keyB1 = createRef('mistmyst_piano_key_b1');
const keyC2 = createRef('mistmyst_piano_key_c2');
const keyD2 = createRef('mistmyst_piano_key_d2');
const keyE2 = createRef('mistmyst_piano_key_e2');
const keyF2 = createRef('mistmyst_piano_key_f2');
