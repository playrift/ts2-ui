            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
        </layer>

        <layer x={0} y="center" w="fill" h="fill">
          <model
            ref={keyC1}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.C1.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyD1}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.D1.rest}
