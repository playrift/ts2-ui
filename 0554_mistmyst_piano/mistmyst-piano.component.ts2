            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyG1}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.G1.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
          <model
            ref={keyA1}
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={Keys.A1.rest}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
