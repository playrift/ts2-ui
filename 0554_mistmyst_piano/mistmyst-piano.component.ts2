            w={Layout.KEY_W}
            h={Layout.KEY_H}
            text={Keys.C1.note}
            font={PianoFonts.LABEL}
            color={PianoColors.LABEL}
            shadow
            align="center"
            valign="bottom"
            options={[Keys.C1.option]}
            onMouseEnter={() => modelSwapper(keyC1, Keys.C1.lit)}
            onMouseLeave={() => modelSwapper(keyC1, Keys.C1.rest)}
          />
          <text
