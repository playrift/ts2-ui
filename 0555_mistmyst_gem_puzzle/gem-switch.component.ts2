import { useState } from 'ts2';

import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { GemSkin } from './mistmyst-gem-puzzle.constants';

export function GemSwitch(): Component {
  const [skin, setSkin] = useState(GemSkin.RESTING);

  if (skin === GemSkin.PRESSED) {
    return (
      <layer
        w="fill"
        h="fill"
        onMouseRepeat={() => setSkin(GemSkin.PRESSED)}
        onMouseLeave={() => setSkin(GemSkin.LEFT)}
      >
        <StoneButtonPressedFilled />
      </layer>
    );
  }

  if (skin === GemSkin.LEFT) {
    return (
      <layer
        w="fill"
        h="fill"
        onMouseRepeat={() => setSkin(GemSkin.PRESSED)}
        onMouseLeave={() => setSkin(GemSkin.LEFT)}
      >
        <StoneButtonOutFilled />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => setSkin(GemSkin.PRESSED)} onMouseLeave={() => setSkin(GemSkin.LEFT)}>
      <StoneButtonEntrypoint />
    </layer>
  );
}
