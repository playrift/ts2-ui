import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { GemSwitch } from './gem-switch.component';
import {
  GemColors,
  GemFonts,
  GemModels,
  GemSwitches,
  Layout,
  PanelTitle,
  TallyRows,
} from './mistmyst-gem-puzzle.constants';

export function MistmystGemPuzzle(): Component {
  return (
    <>
      <StoneBorderEntrypoint title={PanelTitle} />

      <layer
        x="center"
        y={{ center: Layout.BODY_DY }}
        w={{ fill: Layout.BODY_INSET_W }}
        h={{ fill: Layout.BODY_INSET_H }}
      >
        {GemSwitches.map((gem) => (
          <layer
            x={gem.right === 1 ? { right: Layout.COL_RIGHT } : Layout.COL_LEFT}
            y={gem.y}
            w={Layout.SWITCH_W}
            h={Layout.SWITCH_H}
            options={[gem.option]}
          >
            <GemSwitch />
            <text
              x={{ center: Layout.LABEL_DX }}
              y="center"
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              text={gem.label}
              font={GemFonts.LABEL}
              color={GemColors.LABEL}
              align="center"
              valign="middle"
              shadow
            />
            <model
              x={0}
              y={0}
              w={Layout.GEM}
              h={Layout.GEM}
              model={gem.model}
              zoom={Layout.GEM_ZOOM}
              pitch={Layout.GEM_PITCH}
              offsetY={Layout.GEM_OFFSET_Y}
            />
          </layer>
        ))}

        <layer
          x={{ right: Layout.TALLY_RIGHT }}
          y={{ center: Layout.TALLY_DY }}
          w={Layout.TALLY_W}
          h={{ fill: Layout.TALLY_INSET_H }}
        >
          <layer x="center" y="center" w="fill" h={Layout.ROWS_H}>
            {TallyRows.map((row) => (
              <text
                x={Layout.CAPTION_X}
                y={row.y}
                w={Layout.CAPTION}
                h={Layout.CAPTION}
                text={row.caption}
                font={GemFonts.CAPTION}
                color={GemColors.LABEL}
                align="center"
                valign="middle"
                shadow
                optionSubject="v"
              />
            ))}
            {TallyRows.map((row) => (
              <model
                x="right"
                y={row.y}
                w={Layout.SLOT_W}
                h={Layout.SLOT_H}
                model={GemModels.SLOT_EMPTY}
                zoom={Layout.SLOT_ZOOM}
                pitch={Layout.SLOT_PITCH}
              />
            ))}
          </layer>
        </layer>
      </layer>
    </>
  );
}
