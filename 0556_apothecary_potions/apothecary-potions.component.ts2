        optionSubject="<col=ff9040>Energy potion</col>"
        onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      >
        <PressableStoneSkin x="center" y="center" />
        <model
          x="center"
          y="center"
