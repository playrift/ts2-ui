import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Layout,
  LostPropertyArt,
  LostPropertyColors,
  LostPropertyCopy,
  LostPropertyFonts,
  LostPropertyModels,
} from './lost-property.constants';

export function LostProperty(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={LostPropertyModels.BOARD}
        zoom={Layout.MODEL_ZOOM}
        pitch={Layout.MODEL_PITCH}
        offsetX={Layout.MODEL_OFFSET_X}
        offsetY={Layout.MODEL_OFFSET_Y}
      />

      <text
        x="center"
        y={Layout.TITLE_Y}
        w="fill"
        h={Layout.TITLE_H}
        text={LostPropertyCopy.TITLE}
        font={LostPropertyFonts.TITLE}
        color={LostPropertyColors.TITLE}
        align="center"
      />

      <layer x="center" y={Layout.LIST_Y} w={Layout.LIST_W} h={Layout.LIST_H} />

      <layer x={{ right: Layout.SCROLLBAR_RIGHT }} y={Layout.LIST_Y} w={16} h={Layout.LIST_H} />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={LostPropertyArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, LostPropertyArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, LostPropertyArt.CLOSE)}
      />
    </>
  );
}
