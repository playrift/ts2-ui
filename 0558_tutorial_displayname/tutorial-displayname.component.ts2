import { CS2, useState } from 'ts2';

import { displaynameInput, displaynameInputLast } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';
import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { ProgressPips } from '../0929_tutorial_player_experience/progress-pips.component';
import { chatDefaultStopInput } from '../0608_fossil_mushtrees/chatdefault-input';
import { NameBox } from './name-box.component';
import { NameButtons } from './name-buttons.component';
import { rememberLookUpFace } from './tutorial-displayname.input';
import {
  BORDER_FLAGS,
  DisplaynameColor,
  DisplaynameFonts,
  EXPLANATION,
  HEADING,
  HINT,
  Layout,
  PIPS_DONE,
  SET_NAME,
  TITLE,
  mainRef,
} from './tutorial-displayname.constants';

export function TutorialDisplayname(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough onLoad={() => tutorialDisplaynameInit()} />

      <layer static ref={mainRef} x="center" y={Layout.MAIN_Y} w={Layout.MAIN_W} h={Layout.MAIN_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorder title={TITLE} titleColor={SteelborderColor.TITLE} flags={BORDER_FLAGS} />
          <ProgressPips done={PIPS_DONE} />
        </layer>

        <layer
          x="center"
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_W_INSET }}
          h={{ fill: Layout.CONTENT_H_INSET }}
        >
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.EXPLAIN_H}
            text={EXPLANATION}
            font={DisplaynameFonts.BODY}
            color={DisplaynameColor.LABEL}
            shadow
          />
          <text
            x="center"
            y={Layout.HEADING_Y}
            w="fill"
            h={Layout.HEADING_H}
            text={HEADING}
            font={DisplaynameFonts.BOLD}
            color={DisplaynameColor.LABEL}
            shadow
            align="center"
          />
          <NameBox />
          <text
            x="center"
            y={Layout.HINT_Y}
            w="fill"
            h={Layout.HINT_H}
            text={HINT}
            font={DisplaynameFonts.BODY}
            color={DisplaynameColor.LABEL}
            shadow
            align="center"
            valign="middle"
          />
          <layer x={0} y={Layout.SUGGEST_Y} w="fill" h={Layout.SUGGEST_H} hide>
            <text
              x="left"
              y={0}
              w={Layout.SUGGEST_W}
              h="fill"
              font={DisplaynameFonts.BODY}
              color={DisplaynameColor.LABEL}
              shadow
              align="center"
              valign="middle"
              options={[SET_NAME]}
              onMouseRepeat={(event) => textColourSwapper(event.self, DisplaynameColor.WHITE)}
              onMouseLeave={(event) => textColourSwapper(event.self, DisplaynameColor.LABEL)}
            />
            <text
              x="center"
              y={0}
              w={Layout.SUGGEST_W}
              h="fill"
              font={DisplaynameFonts.BODY}
              color={DisplaynameColor.LABEL}
              shadow
              align="center"
              valign="middle"
              options={[SET_NAME]}
              onMouseRepeat={(event) => textColourSwapper(event.self, DisplaynameColor.WHITE)}
              onMouseLeave={(event) => textColourSwapper(event.self, DisplaynameColor.LABEL)}
            />
            <text
              x="right"
              y={0}
              w={Layout.SUGGEST_W}
              h="fill"
              font={DisplaynameFonts.BODY}
              color={DisplaynameColor.LABEL}
              shadow
              align="center"
              valign="middle"
              options={[SET_NAME]}
              onMouseRepeat={(event) => textColourSwapper(event.self, DisplaynameColor.WHITE)}
              onMouseLeave={(event) => textColourSwapper(event.self, DisplaynameColor.LABEL)}
            />
          </layer>
          <NameButtons />
        </layer>
      </layer>
    </>
  );
}

export function tutorialDisplaynameInit(): void {
  if (onMobile()) {
    positionMain(mainRef, Layout.MAIN_Y_MOBILE);
  }
  chatDefaultStopInput();
  rememberLookUpFace();
  const [last] = useState(displaynameInputLast);
  const [, setInput] = useState(displaynameInput);
  setInput(last);
}

function positionMain(component: ComponentId, y: Int): void {
  CS2.if_position_set(0, y, 1, 0, component);
}

export function textColourSwapper(who: ComponentId, colour: Int): void {
  who.color = colour;
}
