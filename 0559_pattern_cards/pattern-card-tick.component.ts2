import { useServerState } from 'ts2';

import { hasBit } from '../lib/lib.engine';
import { Layout, PatternSprites, PatternVarbits } from './pattern-cards.constants';

export function PatternCardTick({ card }: { card: Int }): Component {
  const selected: Int = useServerState(PatternVarbits.CARD_OVERVIEW);

  return (
    <sprite
      x={{ right: Layout.TICK_INSET }}
      y={{ bottom: Layout.TICK_INSET }}
      w={Layout.TICK}
      h={Layout.TICK}
      sprite={PatternSprites.TICK}
      hide={hasBit(selected, card) ? false : true}
    />
  );
}
