import { closeInterface } from '../lib/lib.helpers';
import { modelSwapperUnlessMobile } from '../0103_pattern_next/pattern-next.helpers';
import { PatternCardTick } from './pattern-card-tick.component';
import { PatternConfirmButton } from './pattern-confirm.component';
import { CARD_SLOTS, Layout, Palette, PatternFade, PatternFonts, PatternModel } from './pattern-cards.constants';
import { togglePatternCard } from './pattern-cards.helpers';

export function PatternCards(): Component {
  return (
    <>
      <rect x={16} y={327} w={486} h={4} color={Palette.RULE} fill transparency={PatternFade.RULE} />
      <rect x={498} y={312} w={4} h={15} color={Palette.RULE} fill transparency={PatternFade.RULE} />
      <rect x={489} y={6} w={4} h={305} color={Palette.RULE} fill transparency={PatternFade.RULE} />

      <model
        x={Layout.DEVICE_X}
        y={Layout.DEVICE_Y}
        w={Layout.MODEL}
        h={Layout.MODEL}
        model={PatternModel.DEVICE}
        zoom={Layout.DEVICE_ZOOM}
      />

      <model
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.MODEL}
        h={Layout.MODEL}
        model={PatternModel.CLOSE}
        zoom={Layout.CLOSE_ZOOM}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => modelSwapperUnlessMobile(event.component, PatternModel.CLOSE_HOVER)}
        onMouseLeave={(event) => modelSwapperUnlessMobile(event.component, PatternModel.CLOSE)}
      />

      <layer x={0} y={0} w={Layout.GRID_W} h={Layout.GRID_H}>
        {CARD_SLOTS.map((slot) => (
          <model
            x={slot.x}
            y={slot.y}
            w={Layout.MODEL}
            h={Layout.MODEL}
            model={PatternModel.CARD_BACK}
            zoom={Layout.MODEL_BACK_ZOOM}
          />
        ))}
      </layer>

      {CARD_SLOTS.map((slot) => (
        <model x={slot.x} y={slot.y} w={Layout.MODEL} h={Layout.MODEL} zoom={Layout.MODEL_FACE_ZOOM} />
      ))}

      <layer x={0} y={0} w={Layout.GRID_W} h={Layout.GRID_H}>
        {CARD_SLOTS.map((slot) => (
          <model
            x={slot.x}
            y={slot.y}
            w={Layout.MODEL}
            h={Layout.MODEL}
            model={PatternModel.CARD_FRAME}
            zoom={Layout.MODEL_FRAME_ZOOM}
          />
        ))}
      </layer>

      {CARD_SLOTS.map((slot, card) => (
        <layer
          x={slot.x + Layout.CARD_DX}
          y={slot.y + Layout.CARD_DY}
          w={Layout.CARD_W}
          h={Layout.CARD_H}
          options={['Select']}
          onOptionSelect={(event) => togglePatternCard(event.option, card)}
        >
          <PatternCardTick card={card} />
        </layer>
      ))}

      <text
        x={Layout.PROMPT_X}
        y={Layout.PROMPT_Y}
        w={Layout.PROMPT_W}
        h={Layout.PROMPT_H}
        font={PatternFonts.LIVE}
        color={Palette.TEXT}
        align="center"
        shadow
      />

      <PatternConfirmButton x={Layout.BUTTON_X} y={Layout.BUTTON_Y} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
    </>
  );
}
