import { CS2, predictServerState, useServerState } from 'ts2';

import { hasBit, playSound } from '../lib/lib.engine';
import { PatternCards, PatternSounds, PatternVarbits } from './pattern-cards.constants';

export function togglePatternCard(op: Int, card: Int): void {
  if (op !== 1) {
    return;
  }
  playSound(PatternSounds.TURN_CARD);
  const selected: Int = useServerState(PatternVarbits.CARD_OVERVIEW);
  if (hasBit(selected, card)) {
    predictServerState(PatternVarbits.CARD_OVERVIEW, CS2.bit_clear(selected, card));
    return;
  }
  predictServerState(PatternVarbits.CARD_OVERVIEW, CS2.bit_set(selected, card));
}

export function selectedCardCount(selected: Int): Int {
  let count: Int = 0;
  let card: Int = 0;
  while (card < PatternCards.COUNT) {
    if (hasBit(selected, card)) {
      count = count + 1;
    }
    card = card + 1;
  }
  return count;
}

export function confirmPrompt(chosen: Int): String {
  if (chosen === 0) {
    return '<col=9f9f9f>Select 3 more</col>';
  }
  if (chosen === 1) {
    return '<col=9f9f9f>Select 2 more</col>';
  }
  if (chosen === 2) {
    return '<col=9f9f9f>Select 1 more</col>';
  }
  return '<col=9f9f9f>Too many cards!</col>';
}
