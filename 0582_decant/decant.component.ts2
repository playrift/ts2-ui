import { closeInterface } from '../lib/lib.helpers';
import { DecantButton } from './decant-button.component';
import { DecantColors, DecantFonts, DecantLayout, DecantPots, DecantSprites } from './decant.constants';

const DOSES = [
  { dx: DecantLayout.SLOT_1_X, item: DecantPots.ONE_DOSE, label: '1 dose', key: '1' },
  { dx: DecantLayout.SLOT_2_X, item: DecantPots.TWO_DOSES, label: '2 doses', key: '2' },
  { dx: DecantLayout.SLOT_3_X, item: DecantPots.THREE_DOSES, label: '3 doses', key: '3' },
  { dx: DecantLayout.SLOT_4_X, item: DecantPots.FOUR_DOSES, label: '4 doses', key: '4' },
];

export function Decant(): Component {
  return (
    <>
      <layer w={DecantLayout.PANEL_WIDTH} h={DecantLayout.PANEL_HEIGHT}>
        <sprite
          right={DecantLayout.CLOSE_INSET}
          y={0}
          w={DecantLayout.CLOSE_SIZE}
          h={DecantLayout.CLOSE_SIZE}
          sprite={DecantSprites.CLOSE}
          hover={{ sprite: DecantSprites.CLOSE_HOVER }}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />

        <text
          x="center"
          y={0}
          w="fill"
          h={DecantLayout.TITLE_HEIGHT}
          font={DecantFonts.LABEL}
          color={DecantColors.TEXT}
          align="center"
          valign="middle"
          text="Decant all potions to:"
        />

        {DOSES.map((dose) => (
          <layer
            x={{ center: dose.dx }}
            y={{ bottom: DecantLayout.BUTTON_BOTTOM }}
            w={DecantLayout.BUTTON_WIDTH}
            h={DecantLayout.BUTTON_HEIGHT}
            continueOp
          >
            <DecantButton item={dose.item} label={dose.label} keyChar={dose.key} />
          </layer>
        ))}
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <layer w={DecantLayout.MARKER} h={DecantLayout.MARKER} />
      </layer>
    </>
  );
}
