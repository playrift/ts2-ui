import { useRef } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import {
  DoomsayerArt,
  DoomsayerBar,
  DoomsayerCells,
  DoomsayerColor,
  DoomsayerFonts,
  Layout,
} from './cws-doomsayer.constants';
import { DoomsayerToggle } from './doomsayer-toggle.component';

export function CwsDoomsayer(): Component {
  const grid = useRef();

  return (
    <>
      <rect
        x={Layout.SHADE_X}
        y={Layout.SHADE_Y}
        w={Layout.SHADE_W}
        h={Layout.SHADE_H}
        fill
        color={DoomsayerColor.SHADE}
        transparency={Layout.SHADE_TRANSPARENCY}
      />

      <sprite
        x={Layout.BACKDROP_X}
        y={Layout.BACKDROP_Y}
        w={Layout.BACKDROP_W}
        h={Layout.BACKDROP_H}
        sprite={DoomsayerArt.BACKDROP}
        tiling
      />

      <sprite
        x={Layout.LEFT_X}
        y={Layout.LEFT_Y}
        w={Layout.LEFT_W}
        h={Layout.LEFT_H}
        sprite={DoomsayerArt.LEFT}
        tiling
      />

      <sprite
        x={Layout.CORNER_LEFT_X}
        y={Layout.CORNER_TOP_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.TOP_LEFT}
      />

      <sprite
        x={Layout.RIGHT_X}
        y={Layout.RIGHT_Y}
        w={Layout.RIGHT_W}
        h={Layout.RIGHT_H}
        sprite={DoomsayerArt.RIGHT}
        tiling
      />

      <sprite x={Layout.TOP_X} y={Layout.TOP_Y} w={Layout.TOP_W} h={Layout.TOP_H} sprite={DoomsayerArt.TOP} tiling />

      <sprite
        x={Layout.BOTTOM_X}
        y={Layout.BOTTOM_Y}
        w={Layout.BOTTOM_W}
        h={Layout.BOTTOM_H}
        sprite={DoomsayerArt.BOTTOM}
        tiling
      />

      <sprite
        x={Layout.CORNER_LEFT_X}
        y={Layout.CORNER_BOTTOM_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.BOTTOM_LEFT}
      />

      <sprite
        x={Layout.CORNER_RIGHT_X}
        y={Layout.CORNER_TOP_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.TOP_RIGHT}
      />

      <sprite
        x={Layout.CORNER_RIGHT_X}
        y={Layout.CORNER_BOTTOM_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.BOTTOM_RIGHT}
      />

      <sprite
        x={Layout.TITLE_BAR_X}
        y={Layout.TITLE_BAR_Y}
        w={Layout.TITLE_BAR_W}
        h={Layout.TITLE_BAR_H}
        sprite={DoomsayerArt.TITLE_BAR}
        tiling
      />

      <sprite
        x={Layout.CORNER_LEFT_X}
        y={Layout.TITLE_CAP_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.TITLE_LEFT}
      />
      <sprite
        x={Layout.CORNER_RIGHT_X}
        y={Layout.TITLE_CAP_Y}
        w={Layout.CORNER}
        h={Layout.CORNER}
        sprite={DoomsayerArt.TITLE_RIGHT}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={DoomsayerArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, DoomsayerArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, DoomsayerArt.CLOSE)}
      />

      <text
        x={Layout.TITLE_X}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        text={Layout.TITLE_TEXT}
        font={DoomsayerFonts.TITLE}
        color={DoomsayerColor.ORANGE}
        align="center"
        valign="top"
        shadow
      />

      <text
        x={Layout.STRAY_X}
        y={Layout.STRAY_Y}
        w={Layout.STRAY_W}
        h={Layout.STRAY_H}
        text={Layout.STRAY_TEXT}
        font={DoomsayerFonts.BODY}
        color={DoomsayerColor.ORANGE}
        align="left"
        valign="top"
        shadow
      />

      <layer
        ref={grid}
        x={Layout.GRID_X}
        y={Layout.GRID_Y}
        w={Layout.GRID_W}
        h={Layout.GRID_H}
        scrollWidth={Layout.GRID_SCROLL_W}
        scrollHeight={Layout.GRID_SCROLL_H}
      >
        {DoomsayerCells.map((cell) => (
          <layer x={cell.x} y={cell.y} w={Layout.CELL_W} h={Layout.CELL_H}>
            <DoomsayerToggle
              message={cell.message}
              label={cell.label}
              labelDx={cell.labelDx}
              labelDy={cell.labelDy}
              subject={cell.subject}
            />
          </layer>
        ))}
      </layer>

      <layer x={Layout.BAR_X} y={Layout.BAR_Y} w={Layout.BAR_W} h={Layout.BAR_H} optionSubject={Layout.BAR_SUBJECT}>
        <ScrollbarVertical
          content={grid}
          track={DoomsayerBar.TRACK}
          capTopSprite={DoomsayerBar.CAP_TOP}
          thumbSprite={DoomsayerBar.THUMB}
          capBottomSprite={DoomsayerBar.CAP_BOTTOM}
          arrowUp={DoomsayerBar.ARROW_UP}
          arrowDown={DoomsayerBar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
