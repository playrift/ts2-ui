import { useDerived } from 'ts2';
import { getWarningSetting } from '../lib/lib.helpers';
import { DoomsayerColor, DoomsayerFonts, Layout, ToggleSprites } from './cws-doomsayer.constants';

export function DoomsayerToggle({
  message,
  label,
  labelDx = 2,
  labelDy = 2,
  subject = '',
}: {
  message: Int;
  label: String;
  labelDx?: Int;
  labelDy?: Int;
  subject?: String;
}): Component {
  const setting = useDerived(() => getWarningSetting(message));

  return (
    <>
      <sprite
        x={0}
        y={0}
        w="fill"
        h="fill"
        optionSubject={subject}
        sprite={
          setting === 7 ? ToggleSprites.SETTING_7 : setting === 6 ? ToggleSprites.SETTING_6 : ToggleSprites.OTHERWISE
        }
      />

      <text
        x={labelDx}
        y={labelDy}
        w={Layout.LABEL_W}
        h={Layout.LABEL_H}
        text={label}
        font={DoomsayerFonts.LABEL}
        color={
          setting === 7 ? DoomsayerColor.SETTING_7 : setting === 6 ? DoomsayerColor.SETTING_6 : DoomsayerColor.OTHERWISE
        }
        align="center"
        valign="middle"
        shadow
        options={['Toggle']}
      />
    </>
  );
}
