import { ConfirmDestroyColor, ConfirmDestroyFonts, ConfirmDestroyModel, Layout } from './confirmdestroy.constants';

export function ConfirmDestroy(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <layer x={Layout.yes.x} y={Layout.yes.y} w={Layout.yes.w} h={Layout.yes.h}>
          <model
            x={0}
            y="center"
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={ConfirmDestroyModel.YES}
            zoom={ConfirmDestroyModel.YES_ZOOM}
            pitch={ConfirmDestroyModel.YES_PITCH}
          />
        </layer>

        <layer x={Layout.no.x} y={Layout.no.y} w={Layout.no.w} h={Layout.no.h}>
          <model
            x={0}
            y="center"
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            model={ConfirmDestroyModel.NO}
            zoom={ConfirmDestroyModel.NO_ZOOM}
            pitch={ConfirmDestroyModel.NO_PITCH}
            yaw={ConfirmDestroyModel.NO_YAW}
          />
        </layer>

        <sprite
          x={Layout.item.x}
          y={Layout.item.y}
          w={Layout.item.w}
          h={Layout.item.h}
          outline={1}
          shadowColor={ConfirmDestroyColor.ITEM_SHADOW}
        />

        <text
          x="center"
          y="bottom"
          w="fill"
          h={Layout.WARNING_H}
          font={ConfirmDestroyFonts.WARNING}
          color={ConfirmDestroyColor.WARNING}
          align="center"
          valign="middle"
        />
      </layer>

      <text
        x={Layout.name.x}
        y={Layout.name.y}
        w={Layout.name.w}
        h={Layout.name.h}
        font={ConfirmDestroyFonts.ITEM_NAME}
        align="left"
        valign="middle"
      />
    </>
  );
}
