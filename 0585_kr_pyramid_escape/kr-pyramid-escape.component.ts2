      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={PyramidModels.GROUP_1}
        anim={PyramidAnims.CLIMB}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={PyramidModels.GROUP_2}
        anim={PyramidAnims.CLIMB}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={PyramidModels.GROUP_3}
        anim={PyramidAnims.CLIMB}
