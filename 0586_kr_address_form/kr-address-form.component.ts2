import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  AddressFormArt,
  AddressFormColor,
  AddressFormFont,
  AddressFormModel,
  Camera,
  HEADING_TEXT,
  Layout,
} from './kr-address-form.constants';

export function KrAddressForm(): Component {
  return (
    <>
      <model
        x={Layout.FORM_X}
        y={Layout.FORM_Y}
        w={Layout.FORM_W}
        h={Layout.FORM_H}
        model={AddressFormModel.PARCHMENT}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <text
        x={Layout.HEADING_X}
        y={Layout.HEADING_Y}
        w={Layout.HEADING_W}
        h={Layout.HEADING_H}
        font={AddressFormFont.QUILL}
        color={AddressFormColor.INK}
        align="center"
        valign="middle"
        text={HEADING_TEXT}
      />

      <rect
        x={Layout.RULE_X}
        y={Layout.RULE_1_Y}
        w={Layout.RULE_W}
        h={Layout.RULE_H}
        color={AddressFormColor.INK}
        fill={true}
      />

      <rect
        x={Layout.RULE_X}
        y={Layout.RULE_2_Y}
        w={Layout.RULE_W}
        h={Layout.RULE_H}
        color={AddressFormColor.INK}
        fill={true}
      />

      <rect
        x={Layout.RULE_X}
        y={Layout.RULE_3_Y}
        w={Layout.RULE_W}
        h={Layout.RULE_H}
        color={AddressFormColor.INK}
        fill={true}
      />

      <rect
        x={Layout.SIGNATURE_X}
        y={Layout.SIGNATURE_Y}
        w={Layout.SIGNATURE_W}
        h={Layout.SIGNATURE_H}
        color={AddressFormColor.INK}
        fill={true}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={AddressFormArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, AddressFormArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, AddressFormArt.CLOSE);
        }}
      />
    </>
  );
}
