import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  KrScrapPaperArt,
  KrScrapPaperColor,
  KrScrapPaperCopy,
  KrScrapPaperFont,
  KrScrapPaperModel,
  Layout,
} from './kr-scrap-paper.constants';

export function KrScrapPaper(): Component {
  return (
    <>
      <model
        x={Layout.model.x}
        y={Layout.model.y}
        w={Layout.model.w}
        h={Layout.model.h}
        model={KrScrapPaperModel.PAPER}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <text
        x={Layout.text.x}
        y={Layout.text.y}
        w={Layout.text.w}
        h={Layout.text.h}
        text={KrScrapPaperCopy.BODY}
        optionSubject={KrScrapPaperCopy.SUBJECT}
        font={KrScrapPaperFont.BODY}
        color={KrScrapPaperColor.INK}
        align="right"
        valign="middle"
      />

      <sprite
        x={Layout.close.x}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={KrScrapPaperArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, KrScrapPaperArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, KrScrapPaperArt.CLOSE)}
      />
    </>
  );
}
