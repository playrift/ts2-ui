import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Ink, Layout, PicklockArt, PicklockFonts, PinModel, PinSlots, Selectors } from './kr-picklock.constants';
import { krMouseleaveColour, textColourSwapper } from './kr-picklock.helpers';
import { TumblerHeight } from './tumbler-height.component';

export function KrPicklock(): Component {
  return (
    <>
      <rect w="fill" h="fill" x="center" y="center" color={Ink.BACKDROP} fill />

      <model x={251} y={128} w={44} h={44} model={PinModel.LOCK} zoom={516} pitch={2031} yaw={123} />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PicklockArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, PicklockArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, PicklockArt.CLOSE)}
      />

      <text
        x={32}
        y={13}
        w={151}
        h={15}
        font={PicklockFonts.SMALL}
        color={Ink.LEGEND_FIRST}
        shadow
        valign="middle"
        text="Correct tumbler and height"
      />
      <text
        x={32}
        y={32}
        w={151}
        h={15}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        valign="middle"
        text="Correct height, wrong tumbler"
      />
      <text
        x={32}
        y={49}
        w={151}
        h={15}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        valign="middle"
        text="Wrong height, wrong tumbler"
      />

      <text
        x={438}
        y={126}
        w={56}
        h={48}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        align="center"
        valign="middle"
        text="Selected tumbler height"
      />

      <TumblerHeight x={345} y={99} w={100} h={100} />

      <text x={100} y={285} w={37} h={16} font={PicklockFonts.SMALL} color={Ink.LABEL} shadow text="Tumbler" />
      <text x={5} y={157} w={32} h={32} font={PicklockFonts.SMALL} color={Ink.LABEL} shadow text="Guess" />

      <rect x={55} y={80} w={125} h={175} color={Ink.PANEL} fill transparency={200} />
      <rect x={11} y={8} w={174} h={62} color={Ink.PANEL} fill transparency={200} />

      <model x={371} y={48} w={52} h={77} model={PinModel.ARROW} zoom={600} options={['Up']} />
      <model x={371} y={178} w={52} h={72} model={PinModel.ARROW} zoom={600} roll={1024} options={['Down']} />

      <text
        x={331}
        y={269}
        w={98}
        h={34}
        font={PicklockFonts.LARGE}
        color={Ink.LABEL}
        shadow
        align="center"
        valign="middle"
        text="Try Lock"
        options={['Check']}
        onMouseEnter={(event) => textColourSwapper(event.component, Ink.HOVER)}
        onMouseLeave={(event) => textColourSwapper(event.component, Ink.LABEL)}
      />

      <text
        x={62}
        y={251}
        w={15}
        h={24}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        align="center"
        valign="middle"
        text="1"
      />
      <text
        x={94}
        y={251}
        w={15}
        h={24}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL_ALT}
        shadow
        align="center"
        valign="middle"
        text="2"
      />
      <text
        x={126}
        y={251}
        w={15}
        h={24}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        align="center"
        valign="middle"
        text="3"
      />
      <text
        x={158}
        y={251}
        w={15}
        h={24}
        font={PicklockFonts.SMALL}
        color={Ink.LABEL}
        shadow
        align="center"
        valign="middle"
        text="4"
      />

      <text x={228} y={222} w={72} h={17} font={PicklockFonts.SMALL} color={Ink.LABEL} shadow text="Select a tumbler" />

      {Selectors.map((selector) => (
        <text
          x={selector.x}
          y={238}
          w={20}
          h={30}
          font={PicklockFonts.LARGE}
          color={Ink.LABEL}
          shadow
          align="center"
          valign="middle"
          text={selector.label}
          options={['Select']}
          onMouseEnter={(event) => textColourSwapper(event.component, Ink.HOVER)}
          onMouseLeave={(event) => krMouseleaveColour(selector.tumbler, event.component)}
        />
      ))}

      {PinSlots.map((slot) => (
        <model x={slot.x} y={slot.y} w={Layout.PIN} h={Layout.PIN} zoom={Layout.PIN_ZOOM} />
      ))}

      <model
        x={14}
        y={12}
        w={Layout.PIN}
        h={Layout.PIN}
        model={PinModel.CORRECT}
        zoom={Layout.PIN_ZOOM}
        pitch={Layout.LEGEND_PITCH}
      />
      <model
        x={14}
        y={30}
        w={Layout.PIN}
        h={Layout.PIN}
        model={PinModel.RIGHT_HEIGHT}
        zoom={Layout.PIN_ZOOM}
        pitch={Layout.LEGEND_PITCH}
      />
      <model
        x={14}
        y={48}
        w={Layout.PIN}
        h={Layout.PIN}
        model={PinModel.WRONG}
        zoom={Layout.PIN_ZOOM}
        pitch={Layout.LEGEND_PITCH}
      />
    </>
  );
}
