import { useServerState } from 'ts2';
import { Ink, KrVarbits } from './kr-picklock.constants';

export function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function krMouseleaveColour(tumbler: Int, component: ComponentId): void {
  if (useServerState(KrVarbits.CURRENT) === tumbler) {
    component.color = Ink.SELECTED;
  } else {
    component.color = Ink.LABEL;
  }
}

export function tumblerHeight(): Int {
  switch (useServerState(KrVarbits.CURRENT)) {
    case 1:
      return useServerState(KrVarbits.TUMBLER_1);
    case 2:
      return useServerState(KrVarbits.TUMBLER_2);
    case 3:
      return useServerState(KrVarbits.TUMBLER_3);
    case 4:
      return useServerState(KrVarbits.TUMBLER_4);
  }
  return 0;
}
