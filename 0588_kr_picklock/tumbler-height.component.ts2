import { Ink, PicklockFonts } from './kr-picklock.constants';
import { tumblerHeight } from './kr-picklock.helpers';

export function TumblerHeight(): Component {
  const height: Int = tumblerHeight();
  const label: String = `${stringOf(height)}/5`;

  return (
    <text
      w="fill"
      h="fill"
      font={PicklockFonts.LARGE}
      color={Ink.LABEL}
      shadow
      align="center"
      valign="middle"
      text={label}
    />
  );
}
