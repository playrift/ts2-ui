import { useServerState } from 'ts2';
import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { rgbToHex } from '../0259_area_task/area-task.helpers';
import { DisplayNameStatusValue, DisplayNameVarbits } from './displayname.constants';

export function bondsHidden(): Boolean {
  if (onMobile() && useServerState(DisplayNameVarbits.MOBILE_BONDS_BLOCKED) === 1) {
    return true;
  }
  return false;
}

export function bondsGone(blocked: Boolean, hasBonds: Int): Boolean {
  if (blocked && hasBonds === 0) {
    return true;
  }
  return false;
}

export function nameLookedUp(status: Int): Boolean {
  if (status === DisplayNameStatusValue.AVAILABLE || status === DisplayNameStatusValue.CHANGING) {
    return true;
  }
  return false;
}

export function checkEnabled(status: Int): Boolean {
  if (status === DisplayNameStatusValue.READY || status === DisplayNameStatusValue.AVAILABLE) {
    return true;
  }
  return false;
}

export function changeEnabled(status: Int, permitChange: Int, changedThisSession: Int): Boolean {
  if (status === DisplayNameStatusValue.AVAILABLE && permitChange === 1 && changedThisSession === 0) {
    return true;
  }
  return false;
}

export function flashStatus(target: ComponentId): void {
  let level: Int = clientClock() % 80;
  if (level > 40) {
    level = 80 - level;
  }
  level = level + 100;
  target.color = rgbToHex(level, level, level);
}
