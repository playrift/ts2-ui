import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { closeInterface, onMobile } from '../lib/lib.helpers';
import { closeOnEscape } from '../0877_wgs_rune_door/close-on-escape';
import { ComponentType, PosMode, SizeMode, TextAlign } from './poh-jewellery-box.constants';

export const enum SteelArt {
  TRADEBACKING = 297,
  TOP_LEFT = 310,
  TOP_RIGHT = 311,
  BOTTOM_LEFT = 312,
  BOTTOM_RIGHT = 313,
  LEFT = 172,
  RIGHT = 315,
  TOP = 314,
  BOTTOM = 173,
  TITLE_PLATE = 2546,
  RESIZE = 2523,
  CLOSE = 535,
  CLOSE_HOVER = 536,
  CLOSE_MOBILE = 1731,
}

const TITLE_FONT = 496;
const TITLE_COLOUR = 0xff981f;
const ESCAPE = 13;

export function createGraphic(
  container: ComponentId,
  index: Int,
  sprite: Sprite,
  x: Int,
  y: Int,
  xMode: Int,
  yMode: Int,
  w: Int,
  h: Int,
  wMode: Int,
  hMode: Int,
  tiling: Boolean,
): void {
  CS2.cc_create(container, ComponentType.SPRITE, index, false);
  CS2.cc_position_set(x, y, xMode, yMode);
  CS2.cc_size_set(w, h, wMode, hMode);
  CS2.cc_sprite_set(sprite);
  CS2.cc_tiling_set(tiling);
}

export function thinBox(container: ComponentId, index: Int): Int {
  CS2.cc_create(container, ComponentType.RECTANGLE, index, false);
  CS2.cc_position_set(0, 0, PosMode.ABS_CENTRE, PosMode.ABS_CENTRE);
  CS2.cc_size_set(0, 0, SizeMode.MINUS, SizeMode.MINUS);
  CS2.cc_fill_set(false);
  CS2.cc_colour_set(0x0e0e0c);
  CS2.cc_create(container, ComponentType.RECTANGLE, index + 1, false);
  CS2.cc_position_set(0, 0, PosMode.ABS_CENTRE, PosMode.ABS_CENTRE);
  CS2.cc_size_set(2, 2, SizeMode.MINUS, SizeMode.MINUS);
  CS2.cc_fill_set(false);
  CS2.cc_colour_set(0x474745);
  return index + 2;
}

export function steelBorder(container: ComponentId, title: String, flags: Int): void {
  CS2.cc_all_delete(container);

  createGraphic(
    container,
    0,
    SteelArt.TRADEBACKING,
    0,
    0,
    PosMode.ABS_CENTRE,
    PosMode.ABS_CENTRE,
    2,
    2,
    SizeMode.MINUS,
    SizeMode.MINUS,
    true,
  );
  if (CS2.testbit(flags, 3)) {
    CS2.cc_transparency_set(120);
  } else {
    CS2.cc_transparency_set(0);
  }

  CS2.cc_create(container, ComponentType.TEXT, 1, false);
  CS2.cc_position_set(0, 6, PosMode.ABS_CENTRE, PosMode.ABS_TOP);
  CS2.cc_size_set(12, 24, SizeMode.MINUS, SizeMode.ABS);
  CS2.cc_text_align_set(TextAlign.CENTRE, TextAlign.CENTRE, 0);
  CS2.cc_colour_set(TITLE_COLOUR);
  CS2.cc_text_shadow_set(true);
  CS2.cc_text_font_set(TITLE_FONT);
  CS2.cc_text_set(title);

  createGraphic(
    container,
    2,
    SteelArt.TOP_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    25,
    30,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    3,
    SteelArt.TOP_RIGHT,
    0,
    0,
    PosMode.ABS_RIGHT,
    PosMode.ABS_TOP,
    25,
    30,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    4,
    SteelArt.BOTTOM_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_BOTTOM,
    25,
    30,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    5,
    SteelArt.BOTTOM_RIGHT,
    0,
    0,
    PosMode.ABS_RIGHT,
    PosMode.ABS_BOTTOM,
    25,
    30,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    6,
    SteelArt.LEFT,
    -15,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_CENTRE,
    36,
    60,
    SizeMode.ABS,
    SizeMode.MINUS,
    true,
  );
  createGraphic(
    container,
    7,
    SteelArt.RIGHT,
    -15,
    0,
    PosMode.ABS_RIGHT,
    PosMode.ABS_CENTRE,
    36,
    60,
    SizeMode.ABS,
    SizeMode.MINUS,
    true,
  );
  createGraphic(
    container,
    8,
    SteelArt.TOP,
    0,
    -15,
    PosMode.ABS_CENTRE,
    PosMode.ABS_TOP,
    50,
    36,
    SizeMode.MINUS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    9,
    SteelArt.BOTTOM,
    0,
    -15,
    PosMode.ABS_CENTRE,
    PosMode.ABS_BOTTOM,
    50,
    36,
    SizeMode.MINUS,
    SizeMode.ABS,
    true,
  );
  if (CS2.testbit(flags, 2)) {
    createGraphic(container, 10, -1, 0, 0, 0, 0, 0, 0, 0, 0, true);
  } else {
    createGraphic(
      container,
      10,
      SteelArt.TITLE_PLATE,
      0,
      14,
      PosMode.ABS_CENTRE,
      PosMode.ABS_TOP,
      10,
      26,
      SizeMode.MINUS,
      SizeMode.ABS,
      true,
    );
  }

  let next: Int = 11;
  if (!CS2.testbit(flags, 0)) {
    drawCloseButton(container, next);
    next = next + 1;
  }
  if (CS2.testbit(flags, 1)) {
    createGraphic(
      container,
      next,
      SteelArt.RESIZE,
      0,
      0,
      PosMode.ABS_RIGHT,
      PosMode.ABS_BOTTOM,
      8,
      8,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
  }
}

function drawCloseButton(container: ComponentId, index: Int): void {
  let rest: Sprite = SteelArt.CLOSE;
  let hover: Sprite = SteelArt.CLOSE_HOVER;
  let x: Int = 3;
  let y: Int = 6;
  let w: Int = 26;
  let h: Int = 23;
  if (onMobile()) {
    rest = SteelArt.CLOSE_MOBILE;
    hover = SteelArt.CLOSE_MOBILE;
    x = 1;
    y = 1;
    w = 33;
    h = 33;
  }
  createGraphic(
    container,
    index,
    rest,
    x,
    y,
    PosMode.ABS_RIGHT,
    PosMode.ABS_TOP,
    w,
    h,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  CS2.cc_on_mouseleave_set(() => swapSprite(container, index, rest));
  CS2.cc_on_mouseover_set(() => swapSprite(container, index, hover));
  CS2.cc_op_set(1, 'Close');
  CS2.cc_onop_set(() => closeInterface());
  CS2.cc_on_key_set((event) => closeButtonKey(event.keyCode, container, index));
}

export function swapSprite(container: ComponentId, index: Int, sprite: Sprite): void {
  if (CS2.cc_find(container, index)) {
    CS2.cc_sprite_set(sprite);
  }
}

export function closeButtonKey(keyCode: Int, container: ComponentId, index: Int): void {
  if (closeOnEscape(keyCode)) {
    return;
  }
  if (keyCode === ESCAPE && useServerState(Varbits.KEYBINDING_ESC_TO_CLOSE) === 1) {
    CS2.if_triggerop(container, index, 1);
  }
}
