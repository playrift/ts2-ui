import { CS2, createRef } from 'ts2';

import { closeInterface } from '../lib/lib.helpers';
import { QuiverAmmoSlot } from './quiver-ammo-slot.component';
import { QuiverArt, QuiverColors, QuiverFonts, QuiverModel } from './dizanas-quiver.constants';

export function DizanasQuiver(): Component {
  return (
    <>
      <layer w="fill" h="fill">
        <layer x={10} y={5} w={{ fill: 20 }} h={250}>
          <model
            x="center"
            y="center"
            w="fill"
            h="fill"
            model={QuiverModel.MODEL}
            pitch={QuiverModel.PITCH}
            yaw={QuiverModel.YAW}
            zoom={QuiverModel.ZOOM}
            offsetX={QuiverModel.OFFSET_X}
            offsetY={QuiverModel.OFFSET_Y}
          />

          <layer x="center" y="center" w="fill" h="fill">
            <text
              x="center"
              y={134}
              w="fill"
              h={15}
              hide
              text="<u=FF9933>Bolt slot"
              font={QuiverFonts.LABEL}
              color={QuiverColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />

            <layer y={137} w="fill" h={40}>
              <sprite x={{ center: -5 }} y="center" w={36} h={36} sprite={QuiverArt.SLOT_PLATE} />
              <QuiverAmmoSlot />
            </layer>
          </layer>

          <text
            x="center"
            y={5}
            w="fill"
            h={15}
            text="<u=FF9933>Dizana's Quiver"
            font={QuiverFonts.LABEL}
            color={QuiverColors.LABEL}
            shadow
            align="center"
            valign="middle"
          />

          <layer x="center" y={{ center: 111 }} w="fill" h="fill">
            <text
              x="center"
              y="center"
              w="fill"
              h={30}
              text="Charges: 0"
              font={QuiverFonts.CHARGES}
              color={QuiverColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>

      <sprite
        ref={closeButton}
        x={{ right: 2 }}
        y={2}
        w={26}
        h={23}
        sprite={QuiverArt.CLOSE}
        hover={{ sprite: QuiverArt.CLOSE_HOVER }}
        options={['Close']}
        onLoad={() => bindQuiverEscape()}
        onOptionSelect={() => closeInterface()}
      />
    </>
  );
}

const closeButton = createRef('dizanas_quiver_close');

function bindQuiverEscape(): void {
  CS2.if_op_key_set(1, ESCAPE_KEY, 0, closeButton);
}

const ESCAPE_KEY = 13;
