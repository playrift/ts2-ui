import { defineEngineHooks } from 'ts2';

import { worldmapIconTooltip, worldmapIntermapJump, worldmapTooltipHide } from './worldmap.helpers';

export default defineEngineHooks({
  worldmapElementOp1: (e: WorldMapElementEvent) => worldmapIntermapJump(e.element, e.coord),
  worldmapElementHover: (e: WorldMapElementEvent) => worldmapIconTooltip(e.element, e.x, e.y),
  worldmapElementLeave: (e: WorldMapElementEvent) => worldmapTooltipHide(e.x, e.y),
});
