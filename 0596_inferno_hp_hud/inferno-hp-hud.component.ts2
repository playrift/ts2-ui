import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { InfernoColor, InfernoFont, InfernoHud, InfernoSprite, Layout, Plate } from './inferno-hp-hud.constants';
import { infernoHudPos, infernoHudUpdate } from './inferno-hp-hud.helpers';

const universe = createRef('inferno_hp_hud_universe');
const dodger = createRef('inferno_hp_hud_dodger0');
const hp = createRef('inferno_hp_hud_hp1');
const nameArea = createRef('inferno_hp_hud_name_area2');
const creatureName = createRef('inferno_hp_hud_creature_name5');
const healthBarBack = createRef('inferno_hp_hud_health_bar_back');
const healthBarRemaining = createRef('inferno_hp_hud_health_bar_remaining4');
const hpBarText = createRef('inferno_hp_hud_hp_bar_text3');

export function InfernoHpHud(): Component {
  return (
    <layer
      ref={universe}
      w="fill"
      h="fill"
      onTimer={(event) =>
        infernoHudPos(event.component, hp, nameArea, creatureName, hpBarText, healthBarRemaining, healthBarBack)
      }
    >
      <layer
        ref={dodger}
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, hp, InfernoHud.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={hp} x={0} y={0} w={Plate.DEFAULT_W} h={Plate.H}>
          <layer ref={nameArea} x={0} y={0} w={Layout.NAME_W} h={Layout.NAME_H}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={InfernoSprite.BACKING}
              tiling
            />

            <text
              ref={creatureName}
              x={Layout.NAME_X}
              y="center"
              w="fill"
              h="fill"
              font={InfernoFont.LABEL}
              text="TzKal-Zuk"
              valign="middle"
              shadow
              color={InfernoColor.NAME}
            />

            <ThinBoxEntrypoint />
          </layer>

          <layer x="center" y="bottom" w="fill" h={Layout.BAR_H}>
            <rect
              ref={healthBarBack}
              x="center"
              y="center"
              w={{ fill: Layout.FILL_INSET }}
              h={{ fill: Layout.FILL_INSET }}
              color={InfernoColor.EMPTY}
              fill
            />

            <rect
              ref={healthBarRemaining}
              x={Layout.REMAINING_X}
              y="center"
              w={{ fill: Layout.FILL_INSET }}
              h={{ fill: Layout.FILL_INSET }}
              color={InfernoColor.REMAINING}
              fill
            />

            <text
              ref={hpBarText}
              x="center"
              y="center"
              w="fill"
              h="fill"
              font={InfernoFont.LABEL}
              text="- / -"
              align="center"
              valign="middle"
              color={InfernoColor.LABEL}
              onTimer={() => infernoHudUpdate(hpBarText, healthBarRemaining, healthBarBack)}
            />

            <ThinBoxEntrypoint />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
