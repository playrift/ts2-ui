import { onMounted, onUpdated, useOnResize, useServerState, useUniverse, useWatch } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  InfernoColor,
  InfernoFont,
  InfernoHud,
  InfernoSprite,
  Layout,
  Plate,
  dodgerRef,
  hpRef,
  universeRef,
} from './inferno-hp-hud.constants';
import { clampBase, filledPx, healthLabel, plateWidth } from './inferno-hp-hud.helpers';

export function InfernoHpHud(): Component {
  return (
    <layer ref={universeRef} w="fill" h="fill">
      <InfernoLayout />

      <layer
        ref={dodgerRef}
        onLoad={() => overlayInit(dodgerRef, hpRef, InfernoHud.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
        w="fill"
        h="fill"
      >
        <layer static ref={hpRef} x={0} y={0} w={Plate.DEFAULT_W} h={Plate.H}>
          <layer x={0} y={0} w={Layout.NAME_W} h={Layout.NAME_H}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={InfernoSprite.BACKING}
              tiling
            />

            <text
              x={Layout.NAME_X}
              y="center"
              w="fill"
              h="fill"
              font={InfernoFont.LABEL}
              text="TzKal-Zuk"
              valign="middle"
              shadow
              color={InfernoColor.NAME}
            />

            <ThinBoxEntrypoint />
          </layer>

          <layer x="center" y="bottom" w="fill" h={Layout.BAR_H}>
            <rect
              x="center"
              y="center"
              w={{ fill: Layout.FILL_INSET }}
              h={{ fill: Layout.FILL_INSET }}
              color={InfernoColor.EMPTY}
              fill
            />

            <InfernoBar />

            <ThinBoxEntrypoint />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}

function InfernoLayout(): Component {
  const stage = useUniverse();
  useOnResize(stage);
  const width: Int = plateWidth(stage.width);

  onMounted(() => sizePlate(width));
  onUpdated(() => sizePlate(width));

  return <layer x={0} y={0} w={0} h={0} />;
}

function sizePlate(width: Int): void {
  hpRef.props = { w: width, h: Plate.H };
}

function InfernoBar(): Component {
  const bar = useUniverse();
  useOnResize(bar);
  const barWidth: Int = bar.width - Layout.FILL_INSET;

  const health: Int = useServerState(Varbits.INFERNO_ZUK_HP);
  const base: Int = useServerState(Varbits.INFERNO_ZUK_BASE_HP);
  const remaining: Int = filledPx(health, Math.max(base, 1), barWidth);

  onMounted(() => clampBase());
  useWatch(Varbits.INFERNO_ZUK_HP, () => clampBase());

  return (
    <>
      <rect
        x={Layout.REMAINING_X}
        y="center"
        w={remaining}
        h={{ fill: Layout.FILL_INSET }}
        color={InfernoColor.REMAINING}
        fill
      />

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={InfernoFont.LABEL}
        text={healthLabel(health, base)}
        align="center"
        valign="middle"
        color={InfernoColor.LABEL}
      />
    </>
  );
}
