import { predictServerState, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { scaled } from '../lib/lib.engine';
import { Plate } from './inferno-hp-hud.constants';

export function plateWidth(stage: Int): Int {
  return Math.min(Math.max(scaled(1, Plate.SHARE, stage), Plate.MIN_W), Plate.MAX_W);
}

export function filledPx(health: Int, base: Int, barWidth: Int): Int {
  let filled: Int = scaled(health, base, barWidth);
  if (filled === 0 && health > 0) {
    filled = 1;
  }
  if (filled === barWidth && health < base) {
    filled = filled - 1;
  }
  return filled;
}

export function healthLabel(health: Int, base: Int): String {
  return `${health} / ${base}`;
}

export function clampBase(): void {
  predictServerState(Varbits.INFERNO_ZUK_BASE_HP, Math.max(useServerState(Varbits.INFERNO_ZUK_BASE_HP), 1));
}
