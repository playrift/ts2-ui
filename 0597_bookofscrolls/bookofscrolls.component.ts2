import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ScrollCell } from './scroll-cell.component';
import { CellAt, Cell, Frame, ScrollArt, ScrollColors, ScrollFonts, ScrollModel } from './bookofscrolls.constants';

export function Bookofscrolls(): Component {
  return (
    <>
      <model
        x={{ center: Frame.BOOK_DX }}
        y={{ center: Frame.BOOK_DY }}
        w={Frame.BOOK_SIZE}
        h={Frame.BOOK_SIZE}
        model={ScrollModel.BOOK}
        zoom={ScrollModel.ZOOM}
        pitch={ScrollModel.PITCH}
      />

      <layer x="center" y="center" w="fill" h="fill">
        <sprite
          x={{ right: Frame.CLOSE_RIGHT }}
          y={Frame.CLOSE_TOP}
          w={Frame.CLOSE_W}
          h={Frame.CLOSE_H}
          sprite={ScrollArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapper(event.component, ScrollArt.CLOSE_LIT)}
          onMouseLeave={(event) => graphicSwapper(event.component, ScrollArt.CLOSE)}
        />

        <text
          x={Frame.TITLE_X}
          y={Frame.TITLE_Y}
          w={Frame.TITLE_W}
          h={Frame.TITLE_H}
          text="Master Scroll Book"
          align="center"
          shadow
          font={ScrollFonts.TITLE}
          color={ScrollColors.TITLE}
        />

        <ScrollCell
          x={CellAt.NARDAH.X}
          y={CellAt.NARDAH.Y}
          label="Nardah"
          subject="<col=FF981F>Nardah teleport scroll"
        />
        <ScrollCell
          x={CellAt.DIGSITE.X}
          y={CellAt.DIGSITE.Y}
          label="Digsite"
          subject="<col=FF981F>Digsite teleport scroll"
        />
        <ScrollCell
          x={CellAt.FELDIP.X}
          y={CellAt.FELDIP.Y}
          label="Feldip Hills"
          subject="<col=FF981F>Feldip Hills teleport scroll"
        />
        <ScrollCell
          x={CellAt.LUNAR.X}
          y={CellAt.LUNAR.Y}
          label="Lunar Isle"
          subject="<col=FF981F>Lunar Isle teleport scroll"
        />
        <ScrollCell
          x={CellAt.MORTTON.X}
          y={CellAt.MORTTON.Y}
          label="Mort'ton"
          subject="<col=FF981F>Mort'ton teleport scroll"
        />
        <ScrollCell
          x={CellAt.PEST.X}
          y={CellAt.PEST.Y}
          label="Pest Control"
          subject="<col=FF981F>Pest Control teleport scroll"
        />
        <ScrollCell
          x={CellAt.PISCATORIS.X}
          y={CellAt.PISCATORIS.Y}
          w={52}
          labelW={52}
          label="Piscatoris"
          subject="<col=FF981F>Piscatoris teleport scroll"
        />
        <ScrollCell
          x={CellAt.TAIBWO.X}
          y={CellAt.TAIBWO.Y}
          label="Tai Bwo Wannai"
          subject="<col=FF981F>Tai Bwo Wannai teleport scroll"
        />
        <ScrollCell
          x={CellAt.IORWERTH.X}
          y={CellAt.IORWERTH.Y}
          label="Iorwerth Camp"
          subject="<col=FF981F>Iorwerth camp teleport scroll"
        />
        <ScrollCell
          x={CellAt.MOSLES.X}
          y={CellAt.MOSLES.Y}
          iconX={-5}
          label="Mos Le' Harmless"
          subject="<col=FF981F>Mos Le'Harmless teleport scroll"
        />
        <ScrollCell
          x={CellAt.LUMBERYARD.X}
          y={CellAt.LUMBERYARD.Y}
          label="Lumber-yard"
          subject="<col=FF981F>Lumberyard teleport scroll"
        />
        <ScrollCell
          x={CellAt.ZULANDRA.X}
          y={CellAt.ZULANDRA.Y}
          label="Zul-andra"
          subject="<col=FF981F>Zul-Andra teleport scroll"
        />
        <ScrollCell
          x={CellAt.KEYMASTER.X}
          y={CellAt.KEYMASTER.Y}
          label="Key Master"
          subject="<col=FF981F>Key Master teleport scroll"
        />
        <ScrollCell
          x={CellAt.REVENANTS.X}
          y={CellAt.REVENANTS.Y}
          extraOption="Config"
          label="Revenant caves"
          subject="<col=FF981F>Revenant cave teleport scroll"
        />
        <ScrollCell
          x={CellAt.WATSON.X}
          y={CellAt.WATSON.Y}
          label="Watson"
          subject="<col=FF981F>Watson teleport scroll"
        />
        <ScrollCell
          x={CellAt.GUTHIXIAN.X}
          y={CellAt.GUTHIXIAN.Y}
          label="Guthixian Temple"
          subject="<col=FF981F>Guthixian Temple teleport scroll"
        />
        <ScrollCell
          x={CellAt.SPIDER.X}
          y={CellAt.SPIDER.Y}
          label="Spider Cave"
          subject="<col=FF981F>Spider Cave teleport scroll"
        />
        <ScrollCell x={CellAt.WYRM.X} y={CellAt.WYRM.Y} label="Colossal Wyrm" />
        <ScrollCell
          x={CellAt.CHASM.X}
          y={CellAt.CHASM.Y}
          label="Chasm of Fire"
          subject="<col=FF981F>Chasm of Fire teleport scroll"
        />
      </layer>
    </>
  );
}
