import { Cell, ScrollColors, ScrollFonts } from './bookofscrolls.constants';

export function ScrollCell({
  x,
  y,
  label,
  subject = '',
  w = 50,
  labelW = 50,
  iconX = 0,
  extraOption = '',
}: {
  x: Int;
  y: Int;
  label: String;
  subject?: String;
  w?: Int;
  labelW?: Int;
  iconX?: Int;
  extraOption?: String;
}): Component {
  return (
    <layer
      x={x}
      y={y}
      w={w}
      h={Cell.H}
      options={['Activate', 'Set as default', 'Remove', extraOption]}
      optionSubject={subject}
    >
      <model x={iconX} y={Cell.ICON_Y} w={Cell.ICON} h={Cell.ICON} zoom={Cell.ICON_ZOOM} />

      <text
        x={0}
        y={Cell.COUNT_Y}
        w={Cell.COUNT_W}
        h={Cell.COUNT_H}
        align="right"
        shadow
        font={ScrollFonts.CELL}
        color={ScrollColors.LABEL}
      />

      <text
        x={0}
        y={0}
        w={labelW}
        h={Cell.LABEL_H}
        text={label}
        shadow
        font={ScrollFonts.CELL}
        color={ScrollColors.LABEL}
      />
    </layer>
  );
}
