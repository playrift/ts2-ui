import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BlastColor, BlastMiningFonts, BlastMiningHud, Layout } from './blast-mining-hud.constants';
import { blastMiningHudTick } from './blast-mining-hud.helpers';

const timerHost1 = createRef('0598_lovakengj_blast_mining_hud_timer_host1');

const data = createRef('lovakengj_blast_mining_hud_data');

const modelCoal = createRef('lovakengj_blast_mining_hud_coal');
const modelGold = createRef('lovakengj_blast_mining_hud_gold');
const modelMithril = createRef('lovakengj_blast_mining_hud_mithril');
const modelAddy = createRef('lovakengj_blast_mining_hud_addy');
const modelRune = createRef('lovakengj_blast_mining_hud_rune');

const textCoal = createRef('lovakengj_blast_mining_hud_text_coal');
const textGold = createRef('lovakengj_blast_mining_hud_text_gold');
const textMithril = createRef('lovakengj_blast_mining_hud_text_mithril');
const textAddy = createRef('lovakengj_blast_mining_hud_text_addy');
const textRune = createRef('lovakengj_blast_mining_hud_text_rune');

export function BlastMiningHud_(): Component {
  useInterval(() => overlayRelayout(timerHost1, data, BlastMiningHud.DODGE, Anchor.CENTRE, Anchor.TOP, 0), timerHost1);
  useInterval(
    () =>
      blastMiningHudTick(
        modelCoal,
        modelGold,
        modelMithril,
        modelAddy,
        modelRune,
        textCoal,
        textGold,
        textMithril,
        textAddy,
        textRune,
      ),
    data,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
        <layer ref={data} x="center" y={Layout.STRIP_Y} w={Layout.STRIP_W} h={Layout.STRIP_H}>
          <model ref={modelCoal} x={0} y={0} w={Layout.MODEL_W} h={Layout.MODEL_H} zoom={Layout.MODEL_ZOOM} />
          <model
            ref={modelGold}
            x={Layout.COLUMN}
            y={0}
            w={Layout.MODEL_W}
            h={Layout.MODEL_H}
            zoom={Layout.MODEL_ZOOM}
          />
          <model ref={modelMithril} x={80} y={0} w={Layout.MODEL_W} h={Layout.MODEL_H} zoom={Layout.MODEL_ZOOM} />
          <model ref={modelAddy} x={120} y={0} w={Layout.MODEL_W} h={Layout.MODEL_H} zoom={Layout.MODEL_ZOOM} />
          <model ref={modelRune} x={160} y={0} w={Layout.MODEL_W} h={Layout.MODEL_H} zoom={Layout.MODEL_ZOOM} />

          <text
            ref={textCoal}
            x={0}
            y={Layout.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            align="center"
            shadow
            font={BlastMiningFonts.COUNT}
            color={BlastColor.COUNT}
          />
          <text
            ref={textGold}
            x={Layout.COLUMN}
            y={Layout.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            align="center"
            shadow
            font={BlastMiningFonts.COUNT}
            color={BlastColor.COUNT}
          />
          <text
            ref={textMithril}
            x={80}
            y={Layout.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            align="center"
            shadow
            font={BlastMiningFonts.COUNT}
            color={BlastColor.COUNT}
          />
          <text
            ref={textAddy}
            x={120}
            y={Layout.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            align="center"
            shadow
            font={BlastMiningFonts.COUNT}
            color={BlastColor.COUNT}
          />
          <text
            ref={textRune}
            x={160}
            y={Layout.COUNT_Y}
            w={Layout.COUNT_W}
            h={Layout.COUNT_H}
            align="center"
            shadow
            font={BlastMiningFonts.COUNT}
            color={BlastColor.COUNT}
          />
        </layer>
      </layer>
    </layer>
  );
}
