import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { BlastColor, BlastOre, FULL_AT } from './blast-mining-hud.constants';

export function blastMiningCount(count: ComponentId, amount: Int): void {
  CS2.if_text_set(stringOf(amount), count);
  if (amount >= FULL_AT) {
    CS2.if_colour_set(BlastColor.FULL, count);
  } else {
    CS2.if_colour_set(BlastColor.COUNT, count);
  }
}

export function blastMiningHudUpdate(
  coal: ComponentId,
  gold: ComponentId,
  mithril: ComponentId,
  addy: ComponentId,
  rune: ComponentId,
): void {
  blastMiningCount(coal, useServerState(Varbits.LOVAKENGJ_ORE_COAL_BIGGER));
  blastMiningCount(gold, useServerState(Varbits.LOVAKENGJ_ORE_GOLD_BIGGER));
  blastMiningCount(mithril, useServerState(Varbits.LOVAKENGJ_ORE_MITHRIL_BIGGER));
  blastMiningCount(addy, useServerState(Varbits.LOVAKENGJ_ORE_ADAMANTITE_BIGGER));
  blastMiningCount(rune, useServerState(Varbits.LOVAKENGJ_ORE_RUNITE_BIGGER));
}

export function blastMiningOres(
  coal: ComponentId,
  gold: ComponentId,
  mithril: ComponentId,
  addy: ComponentId,
  rune: ComponentId,
): void {
  CS2.if_item_nonum_set(BlastOre.COAL, 0, coal);
  CS2.if_item_nonum_set(BlastOre.GOLD, 0, gold);
  CS2.if_item_nonum_set(BlastOre.MITHRIL, 0, mithril);
  CS2.if_item_nonum_set(BlastOre.ADAMANTITE, 0, addy);
  CS2.if_item_nonum_set(BlastOre.RUNITE, 0, rune);
}

export function blastMiningHudTick(
  coal: ComponentId,
  gold: ComponentId,
  mithril: ComponentId,
  addy: ComponentId,
  rune: ComponentId,
  textCoal: ComponentId,
  textGold: ComponentId,
  textMithril: ComponentId,
  textAddy: ComponentId,
  textRune: ComponentId,
): void {
  blastMiningOres(coal, gold, mithril, addy, rune);
  blastMiningHudUpdate(textCoal, textGold, textMithril, textAddy, textRune);
}
