import { scaled } from '../lib/lib.engine';
import { Layout, WildwarsMax } from './wildwars-hud.constants';

export function hitpointBarWidth(hp: Int): Int {
  let width: Int = scaled(hp, WildwarsMax.HITPOINTS, Layout.BAR_W);
  if (width === 0 && hp > 0) {
    width = 1;
  }
  if (width === Layout.BAR_W && hp < WildwarsMax.HITPOINTS) {
    width = Layout.BAR_W - 1;
  }
  if (width > Layout.BAR_W) {
    width = Layout.BAR_W;
  }
  return width;
}
