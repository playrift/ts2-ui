import { KudosColors, KudosFonts, Layout } from './vm-kudos-info.constants';

export function KudosHeading({
  top,
  title,
  blurb,
  blurbHeight,
}: {
  top: Int;
  title: String;
  blurb: String;
  blurbHeight: Int;
}): Component {
  return (
    <>
      <text
        x={Layout.HEADING_X}
        y={top}
        w={{ fill: Layout.MEASURE_INSET }}
        h={Layout.HEADING_H}
        text={title}
        font={KudosFonts.HEADING}
        color={KudosColors.PENDING}
        align="left"
        valign="top"
        shadow
      />
      <text
        x={Layout.HEADING_X}
        y={top + Layout.HEADING_H}
        w={{ fill: Layout.MEASURE_INSET }}
        h={blurbHeight}
        text={blurb}
        font={KudosFonts.BODY}
        color={KudosColors.PENDING}
        align="left"
        valign="top"
        shadow
      />
    </>
  );
}
