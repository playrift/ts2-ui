import { KudosAmounts, KudosSubtitles, KudosTitles } from './vm-kudos-info.constants';
import { kudosQuestStatus, kudosStatus } from './vm-kudos-status';

export function kudosRowText(row: Int): String {
  const title: String = `${stringOf(KudosAmounts.at(row))} - ${KudosTitles.at(row)}`;
  const subtitle: String = KudosSubtitles.get(row);

  if (kudosStatus(row)) {
    if (subtitle.length !== 0) {
      return `<str=ffffff>${title}<br><str=ffffff>${subtitle}`;
    }
    return `<str=ffffff>${title}`;
  }
  if (subtitle.length !== 0) {
    if (kudosQuestStatus(row)) {
      return `${title}<br><str=ffffff>${subtitle}`;
    }
    return `${title}<br>${subtitle}`;
  }
  return title;
}
