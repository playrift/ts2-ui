import { useRef, useUniverse } from 'ts2';
import { textLineCount } from '../lib/lib.engine';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { KudosHeading } from './kudos-heading.component';
import { kudosRowText } from './kudos-row-text';
import {
  KudosAmounts,
  KudosBar,
  KudosColors,
  KudosFonts,
  Layout,
  Section,
  SectionBlurbs,
  SectionRows,
  SectionTitles,
  Stripe,
} from './vm-kudos-info.constants';
import { kudosStatus } from './vm-kudos-status';

export function VmKudosInfo(): Component {
  const universe = useUniverse();
  const list = useRef();

  const measure: Int = universe.width - Layout.MEASURE_TOTAL_INSET;

  const blurb0: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.DIGSITE), measure, KudosFonts.BODY);
  const blurb1: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.NATURAL_HISTORY), measure, KudosFonts.BODY);
  const blurb2: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.TIMELINE), measure, KudosFonts.BODY);
  const blurb3: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.FOSSIL_ISLAND), measure, KudosFonts.BODY);
  const blurb4: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.CAMDOZAAL), measure, KudosFonts.BODY);
  const blurb5: Int = Layout.LINE * textLineCount(SectionBlurbs.get(Section.SALVAGE), measure, KudosFonts.BODY);

  const head0: Int = Layout.TOP;
  const rows0: Int = head0 + Layout.HEADING_H + blurb0;
  const head1: Int = rows0 + SectionRows.DIGSITE * Layout.STEP_1 + Layout.SECTION_GAP;
  const rows1: Int = head1 + Layout.HEADING_H + blurb1;
  const head2: Int = rows1 + SectionRows.NATURAL_HISTORY * Layout.STEP_1 + Layout.SECTION_GAP;
  const rows2: Int = head2 + Layout.HEADING_H + blurb2;
  const head3: Int = rows2 + SectionRows.TIMELINE * Layout.STEP_2 + Layout.SECTION_GAP;
  const rows3: Int = head3 + Layout.HEADING_H + blurb3;
  const head4: Int = rows3 + SectionRows.FOSSIL_ISLAND * Layout.STEP_1 + Layout.SECTION_GAP;
  const rows4: Int = head4 + Layout.HEADING_H + blurb4;
  const head5: Int = rows4 + SectionRows.CAMDOZAAL * Layout.STEP_1 + Layout.SECTION_GAP;
  const rows5: Int = head5 + Layout.HEADING_H + blurb5;
  const extent: Int = rows5 + SectionRows.SALVAGE * Layout.STEP_1;

  return (
    <layer x="center" y="center" w={{ fill: Layout.ROOT_W_INSET }} h={{ fill: Layout.ROOT_H_INSET }}>
      <StoneBorderEntrypoint title="Kudos List" />

      <layer
        x={Layout.PANE_X}
        y={{ bottom: Layout.PANE_Y }}
        w={{ fill: Layout.PANE_W_INSET }}
        h={{ fill: Layout.PANE_H_INSET }}
      >
        <layer ref={list} x={0} y={0} w={{ fill: Layout.BAR_W }} h="fill" scrollHeight={extent}>
          <layer w="fill" h="fill">
            {KudosAmounts.map(
              (amount: Int, row: Int) =>
                stripedRow(row) && (
                  <rect
                    x="center"
                    y={rowTop(row, rows0, rows1, rows2, rows3, rows4, rows5)}
                    w="fill"
                    h={Layout.ROW_LINE * textLineCount(kudosRowText(row), measure, KudosFonts.BODY)}
                    fill
                    color={KudosColors.STRIPE}
                    transparency={Stripe.TRANSPARENCY}
                  />
                ),
            )}
          </layer>

          <layer w="fill" h="fill">
            <KudosHeading
              top={head0}
              blurbHeight={blurb0}
              title={SectionTitles.get(Section.DIGSITE)}
              blurb={SectionBlurbs.get(Section.DIGSITE)}
            />
            <KudosHeading
              top={head1}
              blurbHeight={blurb1}
              title={SectionTitles.get(Section.NATURAL_HISTORY)}
              blurb={SectionBlurbs.get(Section.NATURAL_HISTORY)}
            />
            <KudosHeading
              top={head2}
              blurbHeight={blurb2}
              title={SectionTitles.get(Section.TIMELINE)}
              blurb={SectionBlurbs.get(Section.TIMELINE)}
            />
            <KudosHeading
              top={head3}
              blurbHeight={blurb3}
              title={SectionTitles.get(Section.FOSSIL_ISLAND)}
              blurb={SectionBlurbs.get(Section.FOSSIL_ISLAND)}
            />
            <KudosHeading
              top={head4}
              blurbHeight={blurb4}
              title={SectionTitles.get(Section.CAMDOZAAL)}
              blurb={SectionBlurbs.get(Section.CAMDOZAAL)}
            />
            <KudosHeading
              top={head5}
              blurbHeight={blurb5}
              title={SectionTitles.get(Section.SALVAGE)}
              blurb={SectionBlurbs.get(Section.SALVAGE)}
            />
          </layer>

          {KudosAmounts.map((amount: Int, row: Int) =>
            kudosStatus(row) ? (
              <text
                x={Layout.ROW_X}
                y={rowTop(row, rows0, rows1, rows2, rows3, rows4, rows5)}
                w={{ fill: Layout.ROW_INSET }}
                h={Layout.ROW_LINE * textLineCount(kudosRowText(row), measure, KudosFonts.BODY)}
                text={kudosRowText(row)}
                font={KudosFonts.BODY}
                color={KudosColors.DONE}
                align="left"
                valign="middle"
                shadow
              />
            ) : (
              <text
                x={Layout.ROW_X}
                y={rowTop(row, rows0, rows1, rows2, rows3, rows4, rows5)}
                w={{ fill: Layout.ROW_INSET }}
                h={Layout.ROW_LINE * textLineCount(kudosRowText(row), measure, KudosFonts.BODY)}
                text={kudosRowText(row)}
                font={KudosFonts.BODY}
                color={KudosColors.PENDING}
                align="left"
                valign="middle"
                shadow
              />
            ),
          )}
        </layer>

        <layer x={{ right: 0 }} y={0} w={Layout.BAR_W} h="fill">
          <ScrollbarVertical
            content={list}
            track={KudosBar.TRACK}
            capTopSprite={KudosBar.CAP_TOP}
            thumbSprite={KudosBar.THUMB}
            capBottomSprite={KudosBar.CAP_BOTTOM}
            arrowUp={KudosBar.ARROW_UP}
            arrowDown={KudosBar.ARROW_DOWN}
          />
        </layer>
      </layer>
    </layer>
  );
}

function rowTop(
  row: Int,
  digsite: Int,
  naturalHistory: Int,
  timeline: Int,
  fossil: Int,
  camdozaal: Int,
  salvage: Int,
): Int {
  if (row < Section.NATURAL_HISTORY) {
    return digsite + Layout.STEP_1 * row;
  }
  if (row < Section.TIMELINE) {
    return naturalHistory + Layout.STEP_1 * (row - Section.NATURAL_HISTORY);
  }
  if (row < Section.FOSSIL_ISLAND) {
    return timeline + Layout.STEP_2 * (row - Section.TIMELINE);
  }
  if (row < Section.CAMDOZAAL) {
    return fossil + Layout.STEP_1 * (row - Section.FOSSIL_ISLAND);
  }
  if (row < Section.SALVAGE) {
    return camdozaal + Layout.STEP_1 * (row - Section.CAMDOZAAL);
  }
  return salvage + Layout.STEP_1 * (row - Section.SALVAGE);
}

function sectionOf(row: Int): Int {
  if (row < Section.NATURAL_HISTORY) {
    return Section.DIGSITE;
  }
  if (row < Section.TIMELINE) {
    return Section.NATURAL_HISTORY;
  }
  if (row < Section.FOSSIL_ISLAND) {
    return Section.TIMELINE;
  }
  if (row < Section.CAMDOZAAL) {
    return Section.FOSSIL_ISLAND;
  }
  if (row < Section.SALVAGE) {
    return Section.CAMDOZAAL;
  }
  return Section.SALVAGE;
}

function stripedRow(row: Int): Boolean {
  if ((row - sectionOf(row)) % 2 === 0) {
    return true;
  }
  return false;
}
