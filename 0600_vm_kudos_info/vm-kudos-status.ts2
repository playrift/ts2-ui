import { useServerState } from 'ts2';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { FossilDisplayOfRow, Section } from './vm-kudos-info.constants';

export function kudosStatus(row: Int): Boolean {
  if (row === 0 && useServerState(Varbits.VM_DIGSITE_COIN_SARA) === 1) {
    return true;
  }
  if (row === 1 && useServerState(Varbits.VM_DIGSITE_COIN_SENN) === 1) {
    return true;
  }
  if (row === 2 && useServerState(Varbits.VM_DIGSITE_SYMBOL_ANC) === 1) {
    return true;
  }
  if (row === 3 && useServerState(Varbits.VM_DIGSITE_SYMBOL_OLD) === 1) {
    return true;
  }
  if (row === 4 && useServerState(Varbits.VM_DIGSITE_POTTERY) === 1) {
    return true;
  }

  if (row === 5 && useServerState(Varbits.VM_NATHIS_DRAGON_DISPLAY) === 3) {
    return true;
  }
  if (row === 6 && useServerState(Varbits.VM_NATHIS_WYVERN_DISPLAY) === 3) {
    return true;
  }
  if (row === 7 && useServerState(Varbits.VM_NATHIS_TORTOISE_DISPLAY) === 3) {
    return true;
  }
  if (row === 8 && useServerState(Varbits.VM_NATHIS_LIZARD_DISPLAY) === 3) {
    return true;
  }
  if (row === 9 && useServerState(Varbits.VM_NATHIS_LEECH_DISPLAY) === 3) {
    return true;
  }
  if (row === 10 && useServerState(Varbits.VM_NATHIS_CAMEL_DISPLAY) === 3) {
    return true;
  }
  if (row === 11 && useServerState(Varbits.VM_NATHIS_MOLE_DISPLAY) === 3) {
    return true;
  }
  if (row === 12 && useServerState(Varbits.VM_NATHIS_PENGUIN_DISPLAY) === 3) {
    return true;
  }
  if (row === 13 && useServerState(Varbits.VM_NATHIS_TERRORBIRD_DISPLAY) === 3) {
    return true;
  }
  if (row === 14 && useServerState(Varbits.VM_NATHIS_KALPHITE_DISPLAY) === 3) {
    return true;
  }
  if (row === 15 && useServerState(Varbits.VM_NATHIS_MONKEY_DISPLAY) === 3) {
    return true;
  }
  if (row === 16 && useServerState(Varbits.VM_NATHIS_SEASLUG_DISPLAY) === 3) {
    return true;
  }
  if (row === 17 && useServerState(Varbits.VM_NATHIS_SNAKE_DISPLAY) === 3) {
    return true;
  }
  if (row === 18 && useServerState(Varbits.VM_NATHIS_SNAIL_DISPLAY) === 3) {
    return true;
  }

  if (row === 19 && useServerState(Varbits.VM_STAFF_OF_ARMADYL) > 0) {
    return true;
  }
  if (row === 20 && useServerState(Varbits.VM_STAFF_OF_ARMADYL) === 2) {
    return true;
  }
  if (row === 21 && useServerState(Varbits.VM_SOA) === 1) {
    return true;
  }
  if (row === 22 && useServerState(Varbits.VM_OBSERVATORY) === 1) {
    return true;
  }
  if (row === 23 && useServerState(Varbits.VM_EXCALIBUR) === 1) {
    return true;
  }
  if (row === 24 && useServerState(Varbits.VM_SILVERLIGHT) === 1) {
    return true;
  }
  if (row === 25 && useServerState(Varbits.VM_GLIDER) === 1) {
    return true;
  }
  if (row === 26 && useServerState(Varbits.VM_ROBERT) === 1) {
    return true;
  }
  if (row === 27 && useServerState(Varbits.VM_LATHAS) === 1) {
    return true;
  }
  if (row === 28 && useServerState(Varbits.VM_SALVEKNIGHTS) > 0) {
    return true;
  }
  if (row === 29 && useServerState(Varbits.VM_SALVEKNIGHTS) === 2) {
    return true;
  }
  if (row === 30 && useServerState(Varbits.VM_ARDY) === 1) {
    return true;
  }
  if (row === 31 && useServerState(Varbits.VM_SUROK) === 1) {
    return true;
  }
  if (row === 32 && useServerState(Varbits.VM_RUNES) === 1) {
    return true;
  }

  if (
    row >= Section.FOSSIL_ISLAND &&
    row < Section.CAMDOZAAL &&
    fossilDisplayBuilt(FossilDisplayOfRow.get(row) ?? -1) === 1
  ) {
    return true;
  }

  if (row === 70 && useServerState(Varbits.CAMDOZAAL_MUSEUM_RELIC_1) === 1) {
    return true;
  }
  if (row === 71 && useServerState(Varbits.CAMDOZAAL_MUSEUM_RELIC_2) === 1) {
    return true;
  }
  if (row === 72 && useServerState(Varbits.CAMDOZAAL_MUSEUM_RELIC_3) === 1) {
    return true;
  }
  if (row === 73 && useServerState(Varbits.CAMDOZAAL_MUSEUM_RELIC_4) === 1) {
    return true;
  }
  if (row === 74 && useServerState(Varbits.CAMDOZAAL_MUSEUM_RELIC_5) === 1) {
    return true;
  }

  if (row === 33 && useServerState(Varbits.VM_DOV) === 1) {
    return true;
  }

  if (row === 75 && useServerState(Varbits.SALVAGING_RARE_RUSTY_LOCKET_CLAIMED) === 1) {
    return true;
  }
  if (row === 76 && useServerState(Varbits.SALVAGING_RARE_MOULDY_BLOCK_CLAIMED) === 1) {
    return true;
  }
  if (row === 77 && useServerState(Varbits.SALVAGING_RARE_DULL_KNIFE_CLAIMED) === 1) {
    return true;
  }
  if (row === 78 && useServerState(Varbits.SALVAGING_RARE_BROKEN_COMPASS_CLAIMED) === 1) {
    return true;
  }
  if (row === 79 && useServerState(Varbits.SALVAGING_RARE_RUSTY_COIN_CLAIMED) === 1) {
    return true;
  }
  if (row === 80 && useServerState(Varbits.SALVAGING_RARE_BROKEN_SEXTANT_CLAIMED) === 1) {
    return true;
  }
  if (row === 81 && useServerState(Varbits.SALVAGING_RARE_SMASHED_MIRROR_CLAIMED) === 1) {
    return true;
  }
  if (row === 82 && useServerState(Varbits.SALVAGING_RARE_MOULDY_DOLL_CLAIMED) === 1) {
    return true;
  }

  return false;
}

export function fossilDisplayBuilt(display: Int): Int {
  switch (display) {
    case 1:
      if (useServerState(Varbits.FOSSIL_VM_DISPLAY_1_STATE) === 5) {
        return 1;
      }
      break;
    case 2:
      if (useServerState(Varbits.FOSSIL_VM_DISPLAY_2_STATE) === 5) {
        return 1;
      }
      break;
