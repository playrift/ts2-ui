export function kudosQuestStatus(row: Int): Boolean {
  if (row === 19 && (useServerState(Varps.IKOV) === 80 || useServerState(Varps.IKOV) === 90)) {
    return true;
  }
  if (row === 20 && useServerState(Varbits.SECRET_GHOST6_BACKSTORY) === 1) {
    return true;
  }
  if (row === 21 && (useServerState(Varps.PHOENIXGANG) === 10 || useServerState(Varps.BLACKARMGANG) === 4)) {
    return true;
  }
  if (row === 22 && (useServerState(Varps.ITGRONIGEN) === 7 || useServerState(Varps.ITGRONIGEN) === 8)) {
    return true;
  }
  if (row === 23 && useServerState(Varps.ARTHUR) === 7) {
    return true;
  }
  if (row === 24 && useServerState(Varbits.DEMONSLAYER_MAIN) === 3) {
    return true;
  }
  if (row === 25 && useServerState(Varps.GRANDTREE) === 160) {
    return true;
  }
  if (row === 26 && useServerState(Varbits.TWOCATS_QUEST) === 70) {
    return true;
  }
  if (row === 27 && useServerState(Varbits.MAKINGHISTORY_PROG) > 3) {
    return true;
  }
  if (row === 28 && useServerState(Varps.PRIESTPERIL) > 59) {
    return true;
  }
  if (row === 29 && useServerState(Varbits.MYREQUE_2_QUEST) > 420) {
    return true;
  }
  if (row === 30 && useServerState(Varps.HAZEELCULTQUEST) === 9) {
    return true;
  }
  if (row === 31 && useServerState(Varbits.SUROK_QUEST) === 150) {
    return true;
  }
  if (row === 32 && useServerState(Varps.RUNEMYSTERIES) === 6) {
    return true;
  }
  if (row === 33 && useServerState(Varbits.DOV) >= 56) {
    return true;
  }
  return false;
}
