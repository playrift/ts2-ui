function WifiIcon(): Component {
  const [online] = useState(wifiOnline);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  let connected: Boolean = false;
  if (online === -1) {
    connected = CS2.mobile_wifiavailable();
  } else if (online === 1) {
    connected = true;
  }
  let collapsed: Boolean = false;
  if (minimapToggle !== 0) {
    collapsed = true;
  }
  useInterval(() => {
    if (clientClock() % StatusPoll.WIFI_CYCLES === 0) {
      const [, setOnline] = useState(wifiOnline);
      setOnline(CS2.mobile_wifiavailable() ? 1 : 0);
    }
  });
  onMounted(() => placeWifi(collapsed));
  onUpdated(() => placeWifi(collapsed));
  return (
    <sprite
      x="center"
      y="center"
      w="fill"
      h="fill"
      sprite={connected ? Sprites.OSM_STATUS_ICONS_7 : Sprites.OSM_STATUS_ICONS_5}
    />
  );
}

function placeWifi(collapsed: Boolean): void {
  if (collapsed) {
    wifiRef.props = { x: { right: 11 }, y: 7 };
  } else {
    wifiRef.props = { x: { right: Frame.WIFI_RIGHT }, y: Frame.WIFI_Y };
  }
}

function BatteryIcon(): Component {
  const [level] = useState(batteryLevel);
  const [charging] = useState(batteryCharging);
  const [until] = useState(batteryPercentUntil);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  let percent: Int = level;
  if (level === -1) {
    percent = CS2.mobile_batterylevel();
  }
  let bolt: Boolean = false;
  if (charging === -1) {
    bolt = CS2.mobile_batterycharging();
  } else if (charging === 1) {
    bolt = true;
  }
  const boltHidden: Boolean = !bolt;
  let icon: Sprite = Sprites.OSM_STATUS_ICONS_3;
  if (percent > StatusPoll.HIGH) {
    icon = Sprites.OSM_STATUS_ICONS_0;
  } else if (percent > StatusPoll.MID) {
    icon = Sprites.OSM_STATUS_ICONS_1;
  } else if (percent > StatusPoll.LOW) {
    icon = Sprites.OSM_STATUS_ICONS_2;
  }
  let showingPercent: Boolean = false;
  if (until !== -1) {
    showingPercent = true;
  }
  let collapsed: Boolean = false;
  if (minimapToggle !== 0) {
    collapsed = true;
  }

  useInterval(() => {
    const [deadline, setDeadline] = useState(batteryPercentUntil);
    if (deadline !== -1 && clientClock() >= deadline) {
      setDeadline(-1);
    }
    if (clientClock() % StatusPoll.BATTERY_CYCLES === 0) {
      const [, setLevel] = useState(batteryLevel);
      const [, setCharging] = useState(batteryCharging);
      setLevel(CS2.mobile_batterylevel());
      setCharging(CS2.mobile_batterycharging() ? 1 : 0);
    }
  });
  onMounted(() => placeBattery(collapsed));
  onUpdated(() => placeBattery(collapsed));

  return (
    <>
      {showingPercent ? (
        <>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={Sprites.OSM_STATUS_ICONS_4}
            onClick={() => batteryTap()}
          />
          <text
            x={{ center: -1 }}
            y="center"
            w="fill"
            h="fill"
            font={Fonts.P11_FULL}
            color={FrameColor.WHITE}
            align="center"
            valign="middle"
            text={`${Math.min(100, Math.max(0, percent))}`}
          />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w="fill" h="fill" sprite={icon} onClick={() => batteryTap()} />
          <sprite x="center" y="center" w="fill" h="fill" sprite={Sprites.OSM_STATUS_ICONS_6} hide={boltHidden} />
        </>
      )}
    </>
  );
}

function placeBattery(collapsed: Boolean): void {
  if (collapsed) {
    batteryRef.props = { x: { right: 10 }, y: 30 };
  } else {
    batteryRef.props = { x: { right: Frame.BATTERY_RIGHT }, y: Frame.BATTERY_Y };
  }
}

function batteryTap(): void {
  const [until, setUntil] = useState(batteryPercentUntil);
  const [, setLevel] = useState(batteryLevel);
  CS2.sound_effect(Sounds.INTERFACE_SELECT1, 1, 0);
  if (until === -1) {
    setLevel(CS2.mobile_batterylevel());
    setUntil(clientClock() + StatusPoll.BATTERY_SHOW_CYCLES);
  } else {
    setUntil(-1);
  }
}

function ChatToggleFace(): Component {
  const [disabled] = useState(osmChatboxDisabled);
  let off: Boolean = false;
