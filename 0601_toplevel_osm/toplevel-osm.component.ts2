        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 4}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={combatIcon}
        hide={combatHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 5}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={journalIcon}
        hide={journalHidden}
      />
      <sprite x="center" y={Frame.EXPAND_ICON_Y} w={Frame.ICON_W} h={Frame.ICON_H} sprite={expandIcon} />
    </>
  );
}

