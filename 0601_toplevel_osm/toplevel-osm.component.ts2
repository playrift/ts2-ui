      <sprite
        x="center"
        y={Frame.STONE_PITCH}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 2}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 3}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 4}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 5}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 6}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
      />
