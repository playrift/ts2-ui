function GameframeWatch(): Component {
  useWatch(Engine.SUB_CHANGE, () => gameframeSubChanged());
  return <layer x={0} y={0} w={0} h={0} />;
}

function CutsceneLayout(): Component {
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const buffBarHidden: Int = useServerState(Varbits.BUFF_BAR_HIDDEN);
  const osmMinimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  const hideSide: Boolean = cutsceneHidesSide();

  let inCutscene: Boolean = false;
  if (cutscene === 1) {
    inCutscene = true;
  }
  let mapHidden: Boolean = false;
  if (cutscene !== 0) {
    mapHidden = true;
  }
  let compassHidden: Boolean = false;
  if (cutscene === 1 || fovClamp !== 0) {
    compassHidden = true;
  }
  let buffBarShown: Boolean = false;
  if (buffBarHidden === 0 && cutscene === 0) {
    buffBarShown = true;
  }
  let chatAtBottom: Boolean = false;
  if (cutscene === 1 && fovClamp === 3) {
    chatAtBottom = true;
  }
  let minimapHidden: Boolean = false;
  if (osmMinimapToggle !== 0) {
    minimapHidden = true;
  }
  onMounted(() =>
    cutsceneHides(inCutscene, mapHidden, compassHidden, buffBarShown, chatAtBottom, hideSide, minimapHidden),
  );
  onUpdated(() =>
    cutsceneHides(inCutscene, mapHidden, compassHidden, buffBarShown, chatAtBottom, hideSide, minimapHidden),
  );
  return <layer x={0} y={0} w={0} h={0} />;
}

function cutsceneHides(
  inCutscene: Boolean,
  mapHidden: Boolean,
  compassHidden: Boolean,
  buffBarShown: Boolean,
  chatAtBottom: Boolean,
  hideSide: Boolean,
  minimapHidden: Boolean,
): void {
  mapContainerRef.hide = mapHidden;
  compassclickRef.hide = compassHidden;
  buffBarRef.hide = !buffBarShown;
  pmContainerRef.hide = inCutscene;
  statBoostsHudRef.hide = inCutscene;
  helperRef.hide = inCutscene;
  hpbarHudRef.hide = inCutscene;
  mouseoverRef.hide = inCutscene;
  sideLeftChatRef.hide = inCutscene;
  hotkeysRef.hide = inCutscene;
  wifiRef.hide = inCutscene;
  batteryRef.hide = inCutscene;
  sideRightTabsRef.hide = hideSide;
  mapMinimapRef.hide = minimapHidden;
  if (chatAtBottom) {
    chatContainerRef.props = { x: 'center', y: { bottom: 5 } };
  } else {
    chatContainerRef.props = { x: 0, y: 0 };
  }
  applyClientSettings();
  applySavedZoom();
}

function ViewportLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const fovClamp: Int = useServerState(Varbits.FOV_CLAMP);
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  const xpdropsPosition: Int = useServerState(Varbits.XPDROPS_POSITION);

  const frameW: Int = controlRef.width!;
  const frameH: Int = controlRef.height!;
  clampDeadSides();
  const [deadSides] = useState(osmDeadsides);
  const safeW: Int = safeZoneWidth(deadSides, frameW);
  const safeH: Int = safeZoneHeight();
  const insetW: Int = Math.max(0, frameW - safeW);
  const insetH: Int = Math.max(0, frameH - safeH);

  applyFov(fovClamp);
  const [viewW, viewH] = CS2.viewport_effective_size_get();

  let left: Int = Inset.LEFT;
  let top: Int = Inset.TOP;
  let right: Int = Inset.RIGHT;
  let bottom: Int = Inset.BOTTOM;
  let frontW: Int = viewW - insetW;
  let frontH: Int = viewH - insetH;
  if (fovClamp !== 0) {
    const spareW: Int = Math.max(0, frameW - viewW);
    const spareH: Int = Math.max(0, frameH - viewH);
    frontW = viewW - Math.max(0, insetW - spareW);
    frontH = viewH - Math.max(0, insetH - spareH);
    const shiftX: Int = (spareW - insetW) / 2;
    const shiftY: Int = (spareH - insetH) / 2;
    left = Math.max(0, left - shiftX);
    right = Math.max(0, right - shiftX);
    top = Math.max(0, top - shiftY);
    bottom = Math.max(0, bottom - shiftY);
  }

  let minimapW: Int = 0;
  if (cutscene === 0) {
    minimapW = minimapToggle === 0 ? MinimapInset.OPEN : MinimapInset.COLLAPSED;
  }
  let debugY: Int = 0;
  if (CS2.if_sub_has(xpDropsRef) && xpdropsPosition === 0) {
    debugY = MinimapInset.DEBUG_UNDER_XPDROPS;
  }
  let debugRight: Int = 0;
  if (cutscene === 0) {
    debugRight = minimapW + MinimapInset.DEBUG_PAD;
  }
  const xpDropsInset: Int = minimapToggle === 0 ? MinimapInset.OPEN : MinimapInset.COLLAPSED;

  onMounted(() =>
    placeViewport(viewW, viewH, frontW, frontH, left, top, right, bottom, debugRight, debugY, xpDropsInset),
  );
  onUpdated(() =>
    placeViewport(viewW, viewH, frontW, frontH, left, top, right, bottom, debugRight, debugY, xpDropsInset),
  );
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeViewport(
  viewW: Int,
  viewH: Int,
  frontW: Int,
  frontH: Int,
  left: Int,
  top: Int,
  right: Int,
  bottom: Int,
  debugRight: Int,
  debugY: Int,
  xpDropsInset: Int,
): void {
  viewportTrackerBackRef.props = { w: viewW, h: viewH };
  viewportTrackerFrontRef.props = { w: frontW, h: frontH };
  hudContainerBackRef.props = { x: left, y: top, w: { fill: left + right }, h: { fill: top + bottom } };
  hudContainerFrontRef.props = { x: left, y: top, w: { fill: left + right }, h: { fill: top + bottom } };
  mainmodalRef.props = { w: Frame.MODAL_W, h: Frame.MODAL_H };
  debugRef.props = { x: { right: debugRight }, y: debugY };
  xpDropsRef.props = { w: { fill: xpDropsInset }, h: 'fill' };
}

function SafeZoneLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  clampDeadSides();
  const [deadSides] = useState(osmDeadsides);
  const frameW: Int = controlRef.width!;
  const safeLeft: Int = Math.max(CS2.safearea_minx_get(), scaled(deadSides, 16384, frameW));
  const safeTop: Int = CS2.safearea_miny_get();
  const width: Int = safeZoneWidth(deadSides, frameW);
  const height: Int = safeZoneHeight();

  onMounted(() => placeSafeZone(safeLeft, safeTop, width, height));
  onUpdated(() => placeSafeZone(safeLeft, safeTop, width, height));
  return <layer x={0} y={0} w={0} h={0} />;
}

function safeZoneWidth(deadSides: Int, frameW: Int): Int {
  const side: Int = scaled(deadSides, 16384, frameW);
  const safeLeft: Int = Math.max(CS2.safearea_minx_get(), side);
  const safeRight: Int = Math.min(CS2.safearea_maxx_get(), frameW - side);
  return Math.max(Frame.SAFEZONE_MIN_W, safeRight - safeLeft);
}

function safeZoneHeight(): Int {
  return CS2.safearea_maxy_get() - CS2.safearea_miny_get();
}

function placeSafeZone(x: Int, y: Int, w: Int, h: Int): void {
  safezoneRef.props = { x: x, y: y, w: w, h: h };
}

function SafeZoneBlockers(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  clampDeadSides();
  const [deadSides] = useState(osmDeadsides);
  const frameW: Int = universe.width;
  const side: Int = scaled(deadSides, 16384, frameW);
  const safeLeft: Int = Math.max(CS2.safearea_minx_get(), side);
  const safeTop: Int = CS2.safearea_miny_get();
  const safeRight: Int = Math.min(CS2.safearea_maxx_get(), frameW - side);
  const safeBottom: Int = CS2.safearea_maxy_get();
  return (
    <>
      <text x="center" y={0} w="fill" h={safeTop} font={Fonts.P11_FULL} noClickThrough onClick={() => opsound(0, 0)} />
      <text
        x="center"
        y="bottom"
        w="fill"
        h={{ fill: safeBottom }}
        font={Fonts.P11_FULL}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
      <text x={0} y="center" w={safeLeft} h="fill" font={Fonts.P11_FULL} noClickThrough onClick={() => opsound(0, 0)} />
      <text
        x="right"
        y="center"
        w={{ fill: safeRight }}
        h="fill"
        font={Fonts.P11_FULL}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
    </>
  );
}

function SidePanelLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  useRerenderOn(Engine.SUB_CHANGE);
  const [panel] = useState(toplevelPanel);
  const width: Int = stripWidth();
  const onLeft: Boolean = sideContainerOnLeft();
  const shown: Boolean = sideContainerShown();
  const modalUp: Boolean = CS2.if_sub_has(sidemodalRef);
  const warning: Boolean = tapToDropWarning();
  const [expansionDisabled] = useState(osmTabExpansionDisabled);
  let tall: Boolean = false;
  if (gameframeRef.height! >= Frame.TALL_FROM) {
    tall = true;
  }
  let blockingCollapsed: Boolean = false;
  if (expansionDisabled === 1) {
    blockingCollapsed = true;
  }

  let openSlot: ComponentId = -1;
  if (panel >= 0 && panel < Panel.COUNT) {
    const slot: ComponentId = SideSlots.at(panel) ?? -1;
    if (slot !== -1 && CS2.if_sub_has(slot)) {
      openSlot = slot;
    }
  }

  onMounted(() => placeSide(openSlot, modalUp, shown, tall, width, onLeft, blockingCollapsed, warning));
  onUpdated(() => placeSide(openSlot, modalUp, shown, tall, width, onLeft, blockingCollapsed, warning));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeSide(
  openSlot: ComponentId,
  modalUp: Boolean,
  shown: Boolean,
  tall: Boolean,
  width: Int,
  onLeft: Boolean,
  blockingCollapsed: Boolean,
  warning: Boolean,
): void {
  side0Ref.hide = openSlot !== side0Ref;
  side1Ref.hide = openSlot !== side1Ref;
  side2Ref.hide = openSlot !== side2Ref;
  side3Ref.hide = openSlot !== side3Ref;
  side4Ref.hide = openSlot !== side4Ref;
  side5Ref.hide = openSlot !== side5Ref;
  side6Ref.hide = openSlot !== side6Ref;
  side7Ref.hide = openSlot !== side7Ref;
  side8Ref.hide = openSlot !== side8Ref;
  side9Ref.hide = openSlot !== side9Ref;
  side10Ref.hide = openSlot !== side10Ref;
  side11Ref.hide = openSlot !== side11Ref;
  side12Ref.hide = openSlot !== side12Ref;
  side13Ref.hide = openSlot !== side13Ref;
  sidePanelsRef.hide = modalUp;
  sidecrmRef.hide = modalUp;
  tabsLeftRef.hide = modalUp;
  tabsRightRef.hide = modalUp;
  logoutContainerRef.hide = modalUp;
  sideContainerRef.hide = !shown;
  sideContainerWarningRef.hide = !warning;
  if (tall) {
    if (onLeft) {
      sideContainerRef.props = { x: Strip.COLLAPSED_W, y: { center: Strip.TALL_CENTRE } };
    } else {
      sideContainerRef.props = { x: { right: width }, y: { center: Strip.TALL_CENTRE } };
    }
    sideRightTabsRef.props = { x: 'right', y: { center: Strip.TALL_CENTRE }, w: width, h: Frame.STRIP_H };
  } else {
    if (onLeft) {
      sideContainerRef.props = { x: Strip.COLLAPSED_W, y: { bottom: Strip.SHORT_BOTTOM } };
    } else {
      sideContainerRef.props = { x: { right: width }, y: { bottom: Strip.SHORT_BOTTOM } };
    }
    sideRightTabsRef.props = { x: 'right', y: { bottom: Strip.SHORT_BOTTOM }, w: width, h: Frame.STRIP_H };
  }
  if (blockingCollapsed) {
    tabsBlockingRef.props = { w: 'fill', h: 'fill' };
  } else {
    tabsBlockingRef.props = { w: 0, h: 'fill' };
  }
  touchDodgers();
  touchBuffBarDodgers();
}

function HotkeysLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  const [dropdown] = useState(osmHotkeysDropdown);
  let tall: Boolean = false;
  if (gameframeRef.height! >= Frame.TALL_FROM) {
    tall = true;
  }
  let open: Boolean = false;
  if (dropdown === 0) {
    open = true;
  }
  onMounted(() => placeHotkeys(open, tall));
  onUpdated(() => placeHotkeys(open, tall));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeHotkeys(open: Boolean, tall: Boolean): void {
  const height: Int = open ? Hotkeys.OPEN_H : Hotkeys.DROPDOWN_H;
  if (tall) {
    hotkeysRef.props = {
      x: 0,
      y: { center: open ? Hotkeys.TALL_OPEN_Y : Hotkeys.TALL_DROPDOWN_Y },
      w: Frame.HOTKEYS_W,
      h: height,
    };
  } else {
    hotkeysRef.props = { x: 0, y: { bottom: Hotkeys.SHORT_BOTTOM }, w: Frame.HOTKEYS_W, h: height };
  }
}

function PopoutLayout(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  const state: Int = popoutState();
  let tall: Boolean = false;
  if (gameframeRef.height! >= Frame.TALL_FROM) {
    tall = true;
  }
  onMounted(() => placePopout(state, tall));
  onUpdated(() => placePopout(state, tall));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placePopout(state: Int, tall: Boolean): void {
  if (state === 1) {
    popoutRef.props = {
      x: 0,
      y: { bottom: Frame.POPOUT_BOTTOM },
      w: Frame.POPOUT_REST_W,
      h: { fill: Frame.POPOUT_H_INSET },
    };
  } else if (state === 2) {
    popoutRef.props = {
      x: 0,
      y: tall ? { center: 184 } : { bottom: Frame.POPOUT_BOTTOM },
      w: Frame.POPOUT_REST_W,
      h: 86,
    };
  } else {
    popoutRef.props = {
      x: 0,
      y: tall ? { center: Frame.POPOUT_TALL_Y } : { bottom: Frame.POPOUT_BOTTOM },
      w: Frame.POPOUT_REST_W,
      h: Frame.POPOUT_REST_H,
    };
  }
}

function MultiwayLayout(): Component {
  const multiway: Int = useServerState(Varbits.MULTIWAY_INDICATOR);
  const singlewayPlus: Int = useServerState(Varbits.SINGLEWAY_PLUS_INDICATOR);
  const td: Int = useServerState(Varbits.TD_MULTIWAY_INDICATOR);
  const cutscene: Int = useServerState(Varbits.CUTSCENE_STATUS);
  const minimapToggle: Int = useServerState(Varbits.OSM_MINIMAP_TOGGLE);
  let sprite: Sprite = NoSprite.NONE;
  let shown: Boolean = false;
  if (multiway === 1 && cutscene === 0) {
    sprite = Sprites.OVERLAY_MULTIWAY;
    shown = true;
  } else if (singlewayPlus === 1 && cutscene === 0) {
    sprite = Sprites.OVERLAY_SINGLEWAY_PLUS;
    shown = true;
  } else if (td > 0 && cutscene === 0) {
    if (td === 1) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_0;
    } else if (td === 2) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_1;
    } else if (td === 3) {
      sprite = Sprites.OVERLAY_TD_MULTIWAY_2;
    }
    shown = true;
  }
  let collapsed: Boolean = false;
  if (minimapToggle !== 0) {
    collapsed = true;
  }
  onMounted(() => placeMultiway(sprite, shown, collapsed));
  onUpdated(() => placeMultiway(sprite, shown, collapsed));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeMultiway(sprite: Sprite, shown: Boolean, collapsed: Boolean): void {
  if (sprite !== NoSprite.NONE) {
    multiwayIconRef.sprite = sprite;
  }
  multiwayIconRef.hide = !shown;
  if (collapsed) {
    multiwayIconRef.props = { x: { right: 111 }, y: 76 };
    gravestoneRef.props = { x: { right: 109 }, y: 99 };
  } else {
    multiwayIconRef.props = { x: { right: 140 }, y: 177 };
    gravestoneRef.props = { x: { right: 163 }, y: 176 };
  }
}

function SideBackdrop(): Component {
  const transparent: Int = useServerState(Varbits.SIDE_TRANSPARENCY);
  let dark: Boolean = false;
  if (transparent === 1) {
    dark = true;
  }
  onMounted(() => placeBackdrop(dark));
  onUpdated(() => placeBackdrop(dark));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeBackdrop(dark: Boolean): void {
  if (dark) {
    sideBackgroundRef.props = { sprite: Sprites.TRADEBACKING_DARK, transparency: 0 };
  } else {
    sideBackgroundRef.props = { sprite: Sprites.TRADEBACKING_LIGHT, transparency: 150 };
  }
}

function ModalLayout(): Component {
  const front = useUniverse();
  useOnResize(front);
  useRerenderOn(Engine.SUB_CHANGE);
  const frontW: Int = front.width;
  const frontH: Int = front.height;
  const modalW: Int = Frame.MODAL_W;
  const modalH: Int = Frame.MODAL_H;
  const x: Int = modalX(modalW, modalH, frontW, frontH);
  const y: Int = modalY(modalH, frontH);
  const centred: Boolean = modalCentred(modalW, modalH, frontW, frontH);
  const fromTop: Boolean = chatboxOff();
  onMounted(() => placeModal(x, y, centred, fromTop));
  onUpdated(() => placeModal(x, y, centred, fromTop));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeModal(x: Int, y: Int, centred: Boolean, fromTop: Boolean): void {
  if (fromTop) {
    mainmodalRef.props = { x: x, y: y };
  } else if (centred) {
    mainmodalRef.props = { x: 'center', y: { center: y } };
  } else {
    mainmodalRef.props = { x: x, y: { center: y } };
  }
  touchDodgers();
}

function ModalBackdrop(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const [colour] = useState(toplevelMainmodalBgColour);
  const [trans] = useState(toplevelMainmodalBgTrans);
  let shown: Boolean = false;
  if (trans === 0 && CS2.if_sub_has(mainmodalRef)) {
    shown = true;
  }
  return <>{shown && <rect x="center" y="center" w="fill" h="fill" color={colour} fill transparency={0} />}</>;
}

function EhcHooks(): Component {
  const enhanced: Boolean = enhancedAny();
  return (
    <>
      {enhanced && (
        <>
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
          <rect x={0} y={0} w={1} h={1} transparency={255} />
        </>
      )}
    </>
  );
}

