function LeftTabs(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const prayerbook: Int = useServerState(Varbits.PRAYERBOOK);
  const spellbook: Int = useServerState(Varbits.SPELLBOOK);
  const sailing: Int = useServerState(Varbits.SAILING_SIDEPANEL_VISIBLE);
  const journalTab: Int = useServerState(Varbits.SIDE_JOURNAL_TAB);
  const leagueType: Int = useServerState(Varbits.LEAGUE_TYPE);
  const [expansionDisabled] = useState(osmTabExpansionDisabled);

  const combatLabel: String = sailing === 1 ? 'Sailing Options' : 'Combat Options';
  const combatIcon: Sprite = sailing === 1 ? Sprites.SIDEICONS_INTERFACE_67 : Sprites.SIDEICONS_INTERFACE_0;

  const fifth: Int = fifthTab();
  let journalIcon: Sprite = JournalTabIcons.at(journalTab) ?? 2309;
  let journalOp6: String = '';
  let journalOp5: String = '';
  if (fifth === FifthTab.FSW || fifth === FifthTab.LEAGUES || fifth === FifthTab.DEADMAN) {
    if (journalTab === 4) {
      journalIcon = LeagueJournalIcons.get(leagueType) ?? journalIcon;
    } else {
      journalOp6 = JournalTabLabels.at(4) ?? '';
    }
  } else if (fifth === FifthTab.PATHS) {
    if (journalTab !== 3) {
      journalOp5 = JournalTabLabels.at(3) ?? '';
    }
  }
  const journalOp2: String = journalTab !== 0 ? (JournalTabLabels.at(0) ?? '') : '';
  const journalOp3: String = journalTab !== 1 ? (JournalTabLabels.at(1) ?? '') : '';
  const journalOp4: String = journalTab !== 2 ? (JournalTabLabels.at(2) ?? '') : '';

  const prayerIcon: Sprite = prayerbook === 1 ? Sprites.SIDEICONS_INTERFACE_56 : Sprites.SIDEICONS_INTERFACE_5;
  let magicIcon: Sprite = Sprites.SIDEICONS_INTERFACE_6;
  if (spellbook === 1) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_19;
  } else if (spellbook === 2) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_20;
  } else if (spellbook === 3) {
    magicIcon = Sprites.SIDEICONS_INTERFACE_21;
  }

  const expandLabel: String = expansionDisabled === 1 ? 'Show More' : 'Show Less';
  const expandIcon: Sprite = expansionDisabled === 1 ? Sprites.SIDE_ICONS_42 : Sprites.SIDE_ICONS_41;

  const inventoryHidden: Boolean = tabHidden(Panel.INVENTORY);
  const equipmentHidden: Boolean = tabHidden(Panel.EQUIPMENT);
  const prayerHidden: Boolean = tabHidden(Panel.PRAYER);
  const magicHidden: Boolean = tabHidden(Panel.MAGIC);
  const combatHidden: Boolean = tabHidden(Panel.COMBAT);
  const journalHidden: Boolean = tabHidden(Panel.JOURNAL);

  return (
    <>
      <sprite
        x="center"
        y={0}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.INVENTORY)}
        hide={inventoryHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.INVENTORY) ?? '']}
        onOptionSelect={(event) => sideTabOp(Panel.INVENTORY, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.EQUIPMENT)}
        hide={equipmentHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.EQUIPMENT) ?? '']}
        onOptionSelect={(event) => sideTabOp(Panel.EQUIPMENT, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 2}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.PRAYER)}
        hide={prayerHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.PRAYER) ?? '', '']}
        onOptionSelect={(event) => sideTabOp(Panel.PRAYER, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 3}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.MAGIC)}
        hide={magicHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.MAGIC) ?? '', '']}
        onOptionSelect={(event) => sideTabOp(Panel.MAGIC, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 4}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.COMBAT)}
        hide={combatHidden}
        noClickThrough
        options={[combatLabel]}
        onOptionSelect={(event) => sideTabOp(Panel.COMBAT, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 5}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.JOURNAL)}
        hide={journalHidden}
        noClickThrough
        options={[JournalTabLabels.at(journalTab) ?? '', journalOp2, journalOp3, journalOp4, journalOp5, journalOp6]}
        onOptionSelect={(event) => sideTabOp(Panel.JOURNAL, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 6}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={Sprites.TLI_BUTTON01_SQUARE_40X40_0}
        noClickThrough
        options={[expandLabel]}
        onOptionSelect={() => toggleTabExpansion()}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={Sprites.SIDE_ICONS_3}
        hide={inventoryHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={Sprites.SIDE_ICONS_4}
        hide={equipmentHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 2}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={prayerIcon}
        hide={prayerHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 3}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={magicIcon}
        hide={magicHidden}
      />
