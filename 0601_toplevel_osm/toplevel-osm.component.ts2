}

function CompassOps(): Component {
  const state: Int = useServerState(Varbits.MINIMAP_STATE);
  let live: Boolean = true;
  if (state === 3 || state === 4 || state === 5) {
    live = false;
  }
  return (
    <>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        options={live ? ['Look North', 'Look East', 'Look South', 'Look West'] : undefined}
        onOptionSelect={live ? (event) => compassOp(event.option) : undefined}
      />
    </>
  );
}

function GravestoneTimer(): Component {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const tliHide: Int = useServerState(Varbits.GRAVESTONE_TLI_HIDE);
  const [ticks] = useState(graveTicks);
  const [elapsed] = useState(graveElapsed);
  let shown: Boolean = true;
  if (duration <= 0 || tliHide === 1) {
    shown = false;
  }
  const hidden: Boolean = !shown;
  let long: Boolean = false;
  if (duration > Grave.LONG) {
    long = true;
  }
  let label: String = '---';
  let colour: Int = Grave.DIM;
  if (shown && !long) {
    let total: Int = ticks;
    if (total === -1) {
      total = duration * Grave.TICKS_PER_UNIT;
    }
    const seconds: Int = Math.max(1, (total - elapsed) / Grave.PER_SECOND);
    const minutes: Int = seconds / 60;
    const rest: Int = seconds % 60;
    label = rest >= 10 ? `${minutes}:${rest}` : `${minutes}:0${rest}`;
    colour = tobHudNameFlasher();
  }
  useWatch(Varbits.GRAVESTONE_DURATION, () => graveResynch());
  useInterval(() => {
    const [start] = useState(graveStart);
    const [, setElapsed] = useState(graveElapsed);
    if (start !== -1) {
      setElapsed(Math.min(clientClock() - start, Grave.MAX_STEP));
    }
  });
  return (
    <>
      <sprite
        x="center"
        y={Grave.ICON_Y}
        w={Grave.ICON_SIZE}
        h={Grave.ICON_SIZE}
        sprite={Sprites.MOD_ICONS_INTERFACE_21}
        hide={hidden}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={Fonts.P11_FULL}
        align="center"
        valign="bottom"
        shadow
        color={colour}
        text={label}
        hide={hidden}
      />
    </>
  );
}

function graveResynch(): void {
  const duration: Int = useServerState(Varbits.GRAVESTONE_DURATION);
  const [, setTicks] = useState(graveTicks);
  const [, setStart] = useState(graveStart);
  const [, setElapsed] = useState(graveElapsed);
  if (duration <= 0 || duration > Grave.LONG) {
    setTicks(-1);
    setStart(-1);
    setElapsed(0);
    return;
  }
  setTicks(duration * Grave.TICKS_PER_UNIT);
  setStart(clientClock());
  setElapsed(0);
}

function SideContainerFrame(): Component {
  const steel: Int = useServerState(Varbits.SIDE_CONTAINER_STEEL);
  let stone: Boolean = true;
  if (steel !== 0) {
    stone = false;
  }
  onMounted(() => sizeSideContainer(stone));
  onUpdated(() => sizeSideContainer(stone));
  return <>{stone ? <StoneBox skin={StoneBoxSkin.ORNATE} /> : <SteelFrame backdrop={false} />}</>;
}

function sizeSideContainer(stone: Boolean): void {
  if (stone) {
    sideContainerRef.props = { w: Frame.SIDE_CONTAINER_W, h: Frame.SIDE_CONTAINER_H };
  } else {
    sideContainerRef.props = { w: Frame.SIDE_CONTAINER_STEEL_W, h: Frame.SIDE_CONTAINER_STEEL_H };
  }
}
