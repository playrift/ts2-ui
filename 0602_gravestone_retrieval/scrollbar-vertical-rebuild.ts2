import { ARROW, CAP, MIN_THUMB } from '../lib/lib.constants';
import { scaled } from '../lib/lib.engine';

export function scrollbarThumbHeight(barHeight: Int, contentHeight: Int, contentScrollHeight: Int): Int {
  const view: Int = Math.max(1, contentHeight);
  const extent: Int = Math.max(view, contentScrollHeight);
  const track: Int = Math.max(MIN_THUMB, barHeight - ARROW * 2);
  return Math.max(MIN_THUMB, Math.min(track, scaled(view, extent, track)));
}

export const REBUILT_CAP = CAP;
