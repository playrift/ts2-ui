import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { SailingColor } from './fossilquest-sailing-overlay.constants';

const enum SizeMode {
  ABS = 0,
  MINUS = 1,
}

export function fossilquestProgress(filled: ComponentId, empty: ComponentId, bar: ComponentId): void {
  const width: Int = CS2.if_width_get(bar);
  const progress: Int = useServerState(Varbits.FOSSILQUEST_SAILING_PROGRESS);
  const done: Int = CS2.interpolate(0, width, 0, 100, progress);
  CS2.if_size_set(done, 0, SizeMode.ABS, SizeMode.MINUS, filled);
  CS2.if_size_set(width - done, 0, SizeMode.ABS, SizeMode.MINUS, empty);
  if (done < width / 4) {
    CS2.if_colour_set(SailingColor.LOW, filled);
  } else if (done < width / 2) {
    CS2.if_colour_set(SailingColor.MID, filled);
  } else {
    CS2.if_colour_set(SailingColor.HIGH, filled);
  }
}
