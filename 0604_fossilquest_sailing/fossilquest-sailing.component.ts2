import {
  Camera,
  Headings,
  Layout,
  SailingArt,
  SailingColor,
  SailingFont,
  SailingModel,
  SailingOps,
  ThrottleHigh,
  ThrottleLow,
  ThrottleMid,
} from './fossilquest-sailing.constants';

export function FossilquestSailing(): Component {
  return (
    <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <layer x={{ right: Layout.ABORT_RIGHT }} y={Layout.ABORT_Y} w={Layout.ABORT_SIZE} h={Layout.ABORT_SIZE}>
        <sprite
          x="center"
          y="center"
          w={Layout.ABORT_BUTTON_SIZE}
          h={Layout.ABORT_BUTTON_SIZE}
          sprite={SailingArt.ABORT_BUTTON}
          options={[SailingOps.ABORT]}
        />
        <sprite
          x="center"
          y="center"
          w={Layout.ABORT_ICON_SIZE}
          h={Layout.ABORT_ICON_SIZE}
          sprite={SailingArt.ABORT_ICON}
        />
      </layer>

      <layer x={0} y={0} w={Layout.CONTROLS_W} h={Layout.CONTROLS_H}>
        <layer x={0} y={Layout.BEARING_Y} w={Layout.SECTION_W} h={Layout.SECTION_H}>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.HEADING_H}
            text={Headings.BEARING}
            font={SailingFont.HEADING}
            color={SailingColor.HEADING}
            shadow
            align="center"
          />
          <model
            x="center"
            y={Layout.NEEDLE_Y}
            w={Layout.NEEDLE_SIZE}
            h={Layout.NEEDLE_SIZE}
            model={SailingModel.TRUE_NORTH}
            zoom={Camera.TRUE_NORTH.ZOOM}
            pitch={Camera.TRUE_NORTH.PITCH}
          />
          <sprite
            x="center"
            y={{ center: Layout.BEARING_OFFSET_Y }}
            w={Layout.BEARING_SIZE}
            h={Layout.BEARING_SIZE}
            sprite={SailingArt.BEARING}
            angle2d={Layout.BEARING_ANGLE}
            vflip
          />
        </layer>

        <layer x={0} y={Layout.THROTTLE_Y} w={Layout.SECTION_W} h={Layout.SECTION_H}>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.HEADING_H}
            text={Headings.THROTTLE}
            font={SailingFont.HEADING}
            color={SailingColor.HEADING}
            shadow
            align="center"
          />
          <sprite
            x={{ right: Layout.THROTTLE_ARROW_RIGHT }}
            y={Layout.INCREASE_Y}
            w={Layout.THROTTLE_ARROW_SIZE}
            h={Layout.THROTTLE_ARROW_SIZE}
            sprite={SailingArt.THROTTLE_ARROW}
            options={[SailingOps.INCREASE]}
          />
          <sprite
            x={{ right: Layout.THROTTLE_ARROW_RIGHT }}
            y={{ bottom: Layout.DECREASE_BOTTOM }}
            w={Layout.THROTTLE_ARROW_SIZE}
            h={Layout.THROTTLE_ARROW_SIZE}
            sprite={SailingArt.THROTTLE_ARROW}
            angle2d={Layout.DECREASE_ANGLE}
            options={[SailingOps.DECREASE]}
          />

          <layer
            x="center"
            y={{ center: Layout.GAUGE_OFFSET_Y }}
            w={{ fill: Layout.GAUGE_INSET_W }}
            h={{ fill: Layout.GAUGE_INSET_H }}
          >
            <layer x="center" y="center" w="fill" h="fill" hide>
              {ThrottleHigh.map((bar) => (
                <rect
                  x="center"
                  y={{ bottom: bar.y }}
                  w={{ fill: bar.inset }}
                  h={Layout.BAR_H}
                  fill
                  color={bar.color}
                />
              ))}
            </layer>

            <layer x="center" y="center" w="fill" h="fill" hide>
              {ThrottleMid.map((bar) => (
                <rect
                  x="center"
                  y={{ bottom: bar.y }}
                  w={{ fill: bar.inset }}
                  h={Layout.BAR_H}
                  fill
                  color={bar.color}
                />
              ))}
            </layer>

            <layer x="center" y="center" w="fill" h="fill">
              {ThrottleLow.map((bar) => (
                <rect
                  x="center"
                  y={{ bottom: bar.y }}
                  w={{ fill: bar.inset }}
                  h={Layout.BAR_H}
                  fill
                  color={bar.color}
                />
              ))}
            </layer>
          </layer>
        </layer>

        <layer x={0} y={Layout.DIRECTION_Y} w={Layout.SECTION_W} h={Layout.SECTION_H}>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.HEADING_H}
            text={Headings.DIRECTION}
            font={SailingFont.HEADING}
            color={SailingColor.HEADING}
            shadow
            align="center"
          />
          <sprite
            x="center"
            y={{ center: Layout.DIRECTION_OFFSET_Y }}
            w={Layout.DIRECTION_SIZE}
            h={Layout.DIRECTION_SIZE}
            sprite={SailingArt.DIRECTION}
            angle2d={Layout.DIRECTION_ANGLE}
          />
          <model
            x={{ right: Layout.WHEEL_X }}
            y={Layout.WHEEL_Y}
            w={Layout.WHEEL_SIZE}
            h={Layout.WHEEL_SIZE}
            model={SailingModel.STEER_RIGHT}
            zoom={Camera.STEER_RIGHT.ZOOM}
            pitch={Camera.STEER_RIGHT.PITCH}
            yaw={Camera.STEER_RIGHT.YAW}
            roll={Camera.STEER_RIGHT.ROLL}
            options={[SailingOps.STEER_RIGHT]}
          />
          <model
            x={Layout.WHEEL_X}
            y={Layout.WHEEL_Y}
            w={Layout.WHEEL_SIZE}
            h={Layout.WHEEL_SIZE}
            model={SailingModel.STEER_LEFT}
            zoom={Camera.STEER_LEFT.ZOOM}
            pitch={Camera.STEER_LEFT.PITCH}
            yaw={Camera.STEER_LEFT.YAW}
            roll={Camera.STEER_LEFT.ROLL}
            options={[SailingOps.STEER_LEFT]}
          />
        </layer>
      </layer>
    </layer>
  );
}
