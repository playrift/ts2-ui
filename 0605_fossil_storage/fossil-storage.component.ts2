import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { FossilBoard } from './fossil-storage-board.component';
import { ButtonHover, FossilArt, Frame, Panes } from './fossil-storage.constants';

export function FossilStorage(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Frame.ROOT_INSET }} h={{ fill: Frame.ROOT_INSET }}>
      <StoneBorderEntrypoint title="Fossil Storage" />

      <layer x="center" y={Frame.CONTENT_Y} w={{ fill: Frame.CONTENT_W_INSET }} h={{ fill: Frame.CONTENT_H_INSET }}>
        <layer x="right" y="bottom" w={Frame.BUTTONS_W} h={Frame.BUTTONS_H}>
          <sprite w={Frame.BUTTON} h={Frame.BUTTON} sprite={FossilArt.BUTTON} options={['Withdraw All']} />
          <sprite
            x={Frame.ICON_X}
            y={Frame.ICON_Y}
            w={Frame.ICON_W}
            h={Frame.ICON_H}
            sprite={FossilArt.WITHDRAW_ICON}
            hover={{ transparency: ButtonHover.OVER }}
          />
          <sprite x="right" w={Frame.BUTTON} h={Frame.BUTTON} sprite={FossilArt.BUTTON} options={['Deposit All']} />
          <sprite
            x={{ right: Frame.ICON_X }}
            y={Frame.ICON_Y}
            w={Frame.ICON_W}
            h={Frame.ICON_H}
            sprite={FossilArt.DEPOSIT_ICON}
            hover={{ transparency: ButtonHover.OVER }}
          />
        </layer>

        <layer w={{ fill: Panes.BODY_INSET }} h="fill">
          <FossilBoard />
        </layer>

        <layer x="right" w={Panes.BAR_W} h="fill" />
      </layer>
    </layer>
  );
}
