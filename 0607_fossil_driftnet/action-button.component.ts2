import { useInterval, useRef, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { Confirm, Content, DriftnetSound, Fade, PRESS_CYCLES } from './fossil-driftnet.constants';
import { DriftnetConfirm } from './fossil-driftnet.state';

export function ActionButton({ label, icon, opens = 0 }: { label: String; icon: Sprite; opens?: Int }): Component {
  const timerHost = useRef();

  useInterval(() => {
    if (clientClock() < pressedUntil) {
      return;
    }
    if (opens !== Confirm.NONE && raised !== Confirm.NONE) {
      return;
    }
    setPressedUntil(0);
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);
  const [raised, setRaised] = useState(DriftnetConfirm);
  const iconCell = useRef();

  if (pressedUntil !== 0) {
    return (
      <layer w="fill" h="fill" ref={timerHost}>
        <ButtonBackgroundPressed />
        <sprite
          x="center"
          y="center"
          w={Content.ICON_WIDTH}
          h={Content.ICON_HEIGHT}
          sprite={icon}
          transparency={Fade.CLEAR}
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        ccSetTrans(iconCell, Fade.DIM);
      }}
      onMouseLeave={() => {
        ccSetTrans(iconCell, Fade.CLEAR);
      }}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(DriftnetSound.CLICK);
        setPressedUntil(clientClock() + PRESS_CYCLES);
        if (opens !== Confirm.NONE) {
          setRaised(opens);
        }
      }}
    >
      <ButtonBackground />
      <sprite
        ref={iconCell}
        x="center"
        y="center"
        w={Content.ICON_WIDTH}
        h={Content.ICON_HEIGHT}
        sprite={icon}
        transparency={Fade.CLEAR}
      />
    </layer>
  );
}
