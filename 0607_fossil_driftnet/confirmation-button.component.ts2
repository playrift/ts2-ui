import { useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { Confirm, DriftnetColor, DriftnetFont, DriftnetSound } from './fossil-driftnet.constants';
import { DriftnetConfirm } from './fossil-driftnet.state';

export function ConfirmationButton({ label }: { label: String }): Component {
  const [pressed, setPressed] = useState(0);
  const [, setRaised] = useState(DriftnetConfirm);

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => setPressed(1)}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(DriftnetSound.CLICK);
        setRaised(Confirm.NONE);
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={DriftnetFont.BUTTON}
        color={DriftnetColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
