import { onMounted, useState } from 'ts2';
import { ConfirmationButton } from './confirmation-button.component';
import { BANK_FEE, Confirm, Confirmation, Dimmer, DriftnetColor, DriftnetFont } from './fossil-driftnet.constants';
import { DriftnetConfirm } from './fossil-driftnet.state';

function confirmMessage(raised: Int): String {
  if (raised === Confirm.DISCARD) {
    return "Are you sure you want to <col=ff0000>destroy</col><br>everything you've caught?";
  }
  return `Pay ${stringOf(BANK_FEE)} numulites to <col=ffffff>bank</col><br>everything you've caught?`;
}

function sheetDown(raised: Int): Boolean {
  if (raised === Confirm.NONE) {
    return true;
  }
  return false;
}

function buttonDown(raised: Int, mine: Int): Boolean {
  if (raised === mine) {
    return false;
  }
  return true;
}

export function DriftnetConfirmation(): Component {
  const [raised, setRaised] = useState(DriftnetConfirm);

  onMounted(() => {
    setRaised(Confirm.NONE);
  });

  return (
    <layer x="center" y="center" w="fill" h="fill" hide={sheetDown(raised)} noClickThrough>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={DriftnetColor.DIMMER}
        fill
        transparency={Dimmer.TRANSPARENCY}
      />

      <text
        x="center"
        y={Confirmation.MESSAGE_TOP}
        w="fill"
        h={Confirmation.MESSAGE_HEIGHT}
        text={confirmMessage(raised)}
        font={DriftnetFont.MESSAGE}
        color={DriftnetColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />

      <ConfirmationButton
        label="Discard all"
        x={{ center: Confirmation.BUTTON_LEFT }}
        y={Confirmation.BUTTON_TOP}
        w={Confirmation.BUTTON_WIDTH}
        h={Confirmation.BUTTON_HEIGHT}
        hide={buttonDown(raised, Confirm.DISCARD)}
      />

      <ConfirmationButton
        label="Bank all"
        x={{ center: Confirmation.BUTTON_LEFT }}
        y={Confirmation.BUTTON_TOP}
        w={Confirmation.BUTTON_WIDTH}
        h={Confirmation.BUTTON_HEIGHT}
        hide={buttonDown(raised, Confirm.BANK)}
      />

      <ConfirmationButton
        label="Cancel"
        x={{ center: Confirmation.BUTTON_RIGHT }}
        y={Confirmation.BUTTON_TOP}
        w={Confirmation.BUTTON_WIDTH}
        h={Confirmation.BUTTON_HEIGHT}
      />
    </layer>
  );
}
