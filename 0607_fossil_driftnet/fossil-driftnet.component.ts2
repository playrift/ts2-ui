import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { ActionButton } from './action-button.component';
import { DriftnetConfirmation } from './driftnet-confirmation.component';
import { Confirm, Content, Dimmer, DriftnetColor, DriftnetSprite, Panel } from './fossil-driftnet.constants';

export function FossilDriftnet(): Component {
  return (
    <>
      <rect
        x={{ center: Panel.SHADOW_OFFSET }}
        y={{ center: Panel.SHADOW_OFFSET }}
        w={{ fill: Panel.WIDTH_INSET }}
        h={{ fill: Panel.HEIGHT_INSET }}
        color={DriftnetColor.DIMMER}
        fill
        transparency={Dimmer.TRANSPARENCY}
      />

      <layer x="center" y="center" w={{ fill: Panel.WIDTH_INSET }} h={{ fill: Panel.HEIGHT_INSET }}>
        <StoneBorderEntrypoint title="Drift Net" />

        <layer
          x="center"
          y={{ bottom: Content.BOTTOM }}
          w={{ fill: Content.WIDTH_INSET }}
          h={{ fill: Content.HEIGHT_INSET }}
        >
          <layer
            x="center"
            y={Content.CATCH_TOP}
            w={{ fill: Content.CATCH_WIDTH_INSET }}
            h={{ fill: Content.CATCH_HEIGHT_INSET }}
          />

          <layer x="center" y="bottom" w="fill" h={Content.TOOLBAR_HEIGHT}>
            <ActionButton
              label="Discard all"
              icon={DriftnetSprite.ICON_DISCARD}
              opens={Confirm.DISCARD}
              x={0}
              y="center"
              w={Content.BUTTON}
              h={Content.BUTTON}
            />
            <ActionButton
              label="Bank all"
              icon={DriftnetSprite.ICON_BANK}
              opens={Confirm.BANK}
              x="center"
              y="center"
              w={Content.BUTTON}
              h={Content.BUTTON}
            />
            <ActionButton
              label="Take all"
              icon={DriftnetSprite.ICON_TAKE}
              x="right"
              y="center"
              w={Content.BUTTON}
              h={Content.BUTTON}
            />
          </layer>

          <DriftnetConfirmation />
        </layer>
      </layer>
    </>
  );
}
