import { CS2, useState } from 'ts2';

import { snapshotOpen } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';
import { mesLayerRef } from '../0162_chatbox/chatbox.constants';
import { chatDefaultSetOnKey, keyboardHide, meslayerClose } from '../0162_chatbox/meslayer';

export function chatDefaultStopInput(): void {
  const [, setSnapshot] = useState(snapshotOpen);
  setSnapshot(1);
  if (!CS2.if_hide_get(mesLayerRef)) {
    meslayerClose(true, true, true);
  }
  chatDefaultSetOnKey(0);
}

export function chatDefaultRestoreInput(): void {
  chatDefaultSetOnKey(1);
  const [, setSnapshot] = useState(snapshotOpen);
  setSnapshot(0);
  if (onMobile()) {
    keyboardHide();
  }
}
