import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { chatDefaultStopInput } from './chatdefault-input';
import { Layout, MushtreeCamera, MushtreeColor, MushtreeFonts, MushtreeModel } from './fossil-mushtrees.constants';
import { MushtreeButton } from './mushtree-button.component';

export function FossilMushtrees(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" onLoad={() => chatDefaultStopInput()}>
        <StoneBorderEntrypoint title="Mycelium Transportation System" />
      </layer>

      <layer x="center" y={Layout.COLUMN_Y} w={{ fill: Layout.COLUMN_W_INSET }} h={{ fill: Layout.COLUMN_H_INSET }}>
        <MushtreeRow row={0} keys="1" />
        <MushtreeRow row={1} keys="2" />
        <MushtreeRow row={2} keys="3" />
        <MushtreeRow row={3} keys="4" />
      </layer>
    </>
  );
}

function MushtreeRow({ row, keys }: { row: Int; keys: String }): Component {
  return (
    <layer x={Layout.BUTTON_X} y={Layout.BUTTON_Y0 + row * Layout.BUTTON_PITCH} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
      <MushtreeButton keys={keys} />
      <text
        x={Layout.LABEL_X}
        y="center"
        w={Layout.LABEL_W}
        h="fill"
        font={MushtreeFonts.LABEL}
        color={MushtreeColor.LABEL}
        shadow
        valign="middle"
      />
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={MushtreeModel.MUSHTREE}
        zoom={MushtreeCamera.ZOOM}
        pitch={MushtreeCamera.PITCH}
        yaw={MushtreeCamera.YAW}
      />
    </layer>
  );
}
