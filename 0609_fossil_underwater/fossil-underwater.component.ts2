import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { FossilColor, FossilFonts, FossilUnderwater, Layout } from './fossil-underwater.constants';
import { fossilUnderwaterTick } from './fossil-underwater.state';

const oxygenLayer = createRef('fossil_underwater_oxygen_layer');

const oxygenBar = createRef('fossil_underwater_oxygen_bar');

const oxygenLevel = createRef('fossil_underwater_oxygen_level');

const warningLayer = createRef('fossil_underwater_warning_layer');

export function FossilUnderwater_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" />

      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, oxygenLayer, FossilUnderwater.DODGE, Anchor.CENTRE, Anchor.TOP, 0)
        }
      >
        <layer ref={oxygenLayer} x="center" y={Layout.METER_Y} w={Layout.METER_W} h={Layout.METER_H}>
          <rect x={0} y="center" w="fill" h="fill" color={FossilColor.RED} fill />

          <rect
            ref={oxygenBar}
            x={Layout.BAR_X}
            y={Layout.BAR_Y}
            w={{ fill: Layout.BAR_INSET_W }}
            h={{ fill: Layout.BAR_INSET_H }}
            color={FossilColor.OXYGEN}
            fill
          />

          <rect x="center" y="center" w="fill" h="fill" color={FossilColor.BLACK} />

          <text
            ref={oxygenLevel}
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="Oxygen Level: "
            align="center"
            valign="middle"
            font={FossilFonts.LABEL}
            color={FossilColor.BLACK}
            onTimer={() => fossilUnderwaterTick(oxygenBar, oxygenLevel, warningLayer)}
          />
        </layer>
      </layer>

      <rect
        ref={warningLayer}
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={FossilColor.RED}
        fill
        transparency={255}
        hide
      />

      <rect x="center" y="center" w="fill" h="fill" color={FossilColor.BLACK} fill transparency={255} hide />
    </layer>
  );
}
