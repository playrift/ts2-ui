import { createRef, onMounted, useInterval, useOnResize, useServerState, useState, useUniverse, useWatch } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { fossilOxygenWarning } from '../lib/game/varcs';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Flash, FossilColor, FossilFonts, FossilUnderwater, Layout } from './fossil-underwater.constants';
import { flashStep, fossilOxygenLevel, oxygenBarPx, oxygenCaption } from './fossil-underwater.helpers';
import { fossilFlashAlpha, fossilOxygenLabel } from './fossil-underwater.state';

const timerHost1 = createRef('0609_fossil_underwater_timer_host1');

const oxygenLayer = createRef('fossil_underwater_oxygen_layer');

export function FossilUnderwater_(): Component {
  return (
    <layer
      w="fill"
      h="fill"
      onLoad={() => overlayRelayout(timerHost1, oxygenLayer, FossilUnderwater.DODGE, Anchor.CENTRE, Anchor.TOP, 0)}
    >
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
        <layer static ref={oxygenLayer} x="center" y={Layout.METER_Y} w={Layout.METER_W} h={Layout.METER_H}>
          <rect x={0} y="center" w="fill" h="fill" color={FossilColor.RED} fill />

          <OxygenMeter />
        </layer>
      </layer>

      <WarningFlash />

      <rect x="center" y="center" w="fill" h="fill" color={FossilColor.BLACK} fill transparency={255} hide />
    </layer>
  );
}

function OxygenMeter(): Component {
  const meter = useUniverse();
  useOnResize(meter);
  const oxygen: Int = useServerState(Varbits.FOSSIL_UNDERWATER_OXYGEN);
  const [lastCaption] = useState(fossilOxygenLabel);
  let caption: String = lastCaption;
  if (oxygen !== 0) {
    caption = oxygenCaption(oxygen);
  }

  onMounted(() => fossilOxygenLevel());
  useWatch(Varbits.FOSSIL_UNDERWATER_OXYGEN, () => fossilOxygenLevel());

  return (
    <>
      <rect
        x={Layout.BAR_X}
        y={Layout.BAR_Y}
        w={oxygenBarPx(oxygen, meter.width)}
        h={{ fill: Layout.BAR_INSET_H }}
        color={FossilColor.OXYGEN}
        fill
      />

      <rect x="center" y="center" w="fill" h="fill" color={FossilColor.BLACK} />

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={caption}
        align="center"
        valign="middle"
        font={FossilFonts.LABEL}
        color={FossilColor.BLACK}
      />
    </>
  );
}

function WarningFlash(): Component {
  const [warned] = useState(fossilOxygenWarning);
  const [alpha] = useState(fossilFlashAlpha);
  const oxygen: Int = useServerState(Varbits.FOSSIL_UNDERWATER_OXYGEN);
  let hidden: Boolean = true;
  if (warned === 1 || (oxygen > 0 && oxygen < Flash.ARM_AT)) {
    hidden = false;
  }

  useInterval(() => flashStep());

  return (
    <rect x="center" y="center" w="fill" h="fill" color={FossilColor.RED} fill transparency={alpha} hide={hidden} />
  );
}
