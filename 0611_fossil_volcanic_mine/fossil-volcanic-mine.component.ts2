import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, MineColor, MineDodge, MineFonts, MineWash } from './fossil-volcanic-mine.constants';
import { volcanicMineUpdateHud } from './fossil-volcanic-mine.helpers';
import {
  chamberA,
  chamberB,
  chamberC,
  mainInfo,
  players,
  points,
  stability,
  ventA,
  ventB,
  ventC,
  ventChambersInfo,
} from './fossil-volcanic-mine.refs';

const timerHost1 = createRef('0611_fossil_volcanic_mine_timer_host1');

const timerHost2 = createRef('0611_fossil_volcanic_mine_timer_host2');

const timerHost3 = createRef('0611_fossil_volcanic_mine_timer_host3');

export function FossilVolcanicMine(): Component {
  useInterval(() => volcanicMineUpdateHud(), timerHost1);
  useInterval(() => overlayRelayout(timerHost2, mainInfo, MineDodge.LEFT, Anchor.LEFT, Anchor.CENTRE, 1), timerHost2);
  useInterval(
    () => overlayRelayout(timerHost3, ventChambersInfo, MineDodge.RIGHT, Anchor.RIGHT, Anchor.CENTRE, 0),
    timerHost3,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost1}>
      <rect x="center" y="center" w="fill" h="fill" color={MineColor.FADE} fill transparency={MineWash.FADE} hide />

      <layer w="fill" h="fill" ref={timerHost2}>
        <layer ref={mainInfo} x={Layout.MAIN_X} y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
          <layer x={0} y={0} w={Layout.NON_PADDED_W} h={Layout.MAIN_H}>
            <rect x="center" y="center" w="fill" h="fill" color={MineColor.PLATE} transparency={MineWash.BORDER} />
            <rect
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              color={MineColor.PLATE}
              fill
              transparency={MineWash.BACKING}
            />

            <text
              x={Layout.ROW_INSET}
              y={Layout.TIME_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Time Remaining"
              shadow
              color={MineColor.HEADING}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.TIME_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="10:00"
              shadow
              color={MineColor.VALUE}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.POINTS_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Points"
              shadow
              color={MineColor.HEADING}
            />
            <text
              ref={points}
              x={Layout.ROW_INSET}
              y={Layout.POINTS_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="0"
              shadow
              color={MineColor.VALUE}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.STABILITY_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Mine Stability"
              shadow
              color={MineColor.HEADING}
            />
            <text
              ref={stability}
              x={Layout.ROW_INSET}
              y={Layout.STABILITY_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="100%"
              shadow
              color={MineColor.VALUE}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.PLAYERS_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Players in Mine"
              shadow
              color={MineColor.HEADING}
            />
            <text
              ref={players}
              x={Layout.ROW_INSET}
              y={Layout.PLAYERS_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="0"
              shadow
              color={MineColor.VALUE}
            />
          </layer>
        </layer>
      </layer>

      <layer x={0} y={0} w={Layout.RIGHT_DODGER_W} h={Layout.RIGHT_DODGER_H} ref={timerHost3}>
        <layer ref={ventChambersInfo} x={{ right: Layout.VENT_X }} y="center" w={Layout.VENT_W} h={Layout.VENT_H}>
          <rect x="center" y="center" w="fill" h="fill" color={MineColor.PLATE} transparency={MineWash.BORDER} />
          <rect
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            color={MineColor.PLATE}
            fill
            transparency={MineWash.BACKING}
          />

          <text
            x={{ right: Layout.ROW_INSET }}
            y={Layout.VENTS_TITLE_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="Vent Status"
            align="right"
            shadow
            color={MineColor.HEADING}
            optionSubject="c"
          />
          <text
            ref={ventA}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.VENT_A_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="A: 50%"
            align="right"
            shadow
            color={MineColor.VALUE}
          />
          <text
            ref={ventB}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.VENT_B_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="B: 50%"
            align="right"
            shadow
            color={MineColor.VALUE}
          />
          <text
            ref={ventC}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.VENT_C_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="C: 50%"
            align="right"
            shadow
            color={MineColor.VALUE}
          />

          <text
            x={{ right: Layout.ROW_INSET }}
            y={Layout.CHAMBERS_TITLE_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="Chamber Status"
            align="right"
            shadow
            color={MineColor.HEADING}
            optionSubject="c"
          />
          <text
            ref={chamberA}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.CHAMBER_A_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="A: Unblocked"
            align="right"
            shadow
            color={MineColor.VALUE}
          />
          <text
            ref={chamberB}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.CHAMBER_B_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="B: Unblocked"
            align="right"
            shadow
            color={MineColor.VALUE}
          />
          <text
            ref={chamberC}
            x={{ right: Layout.ROW_INSET }}
            y={Layout.CHAMBER_C_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="C: Unblocked"
            align="right"
            shadow
            color={MineColor.VALUE}
          />
        </layer>
      </layer>
    </layer>
  );
}
