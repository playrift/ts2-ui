import { createRef, useServerState } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { Layout, MineColor, MineDodge, MineFonts, MineVarbits, MineWash } from './fossil-volcanic-mine.constants';
import { chamberLabel, pointsLabel, stabilityLabel, ventLabel } from './fossil-volcanic-mine.helpers';
import { mainInfo, ventChambersInfo } from './fossil-volcanic-mine.refs';

const timerHost2 = createRef('0611_fossil_volcanic_mine_timer_host2');

const timerHost3 = createRef('0611_fossil_volcanic_mine_timer_host3');

export function FossilVolcanicMine(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={MineColor.FADE} fill transparency={MineWash.FADE} hide />

      <layer
        w="fill"
        h="fill"
        ref={timerHost2}
        onLoad={() => overlayInit(timerHost2, mainInfo, MineDodge.LEFT, Anchor.LEFT, Anchor.CENTRE, 1)}
      >
        <layer ref={mainInfo} x={Layout.MAIN_X} y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
          <layer x={0} y={0} w={Layout.NON_PADDED_W} h={Layout.MAIN_H}>
            <rect x="center" y="center" w="fill" h="fill" color={MineColor.PLATE} transparency={MineWash.BORDER} />
            <rect
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              color={MineColor.PLATE}
              fill
              transparency={MineWash.BACKING}
            />

            <text
              x={Layout.ROW_INSET}
              y={Layout.TIME_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Time Remaining"
              shadow
              color={MineColor.HEADING}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.TIME_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="10:00"
              shadow
              color={MineColor.VALUE}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.POINTS_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Points"
              shadow
              color={MineColor.HEADING}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.STABILITY_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Mine Stability"
              shadow
              color={MineColor.HEADING}
            />
            <text
              x={Layout.ROW_INSET}
              y={Layout.PLAYERS_TITLE_Y}
              w="fill"
              h={Layout.ROW_H}
              font={MineFonts.BODY}
              text="Players in Mine"
              shadow
              color={MineColor.HEADING}
            />
            <MainInfoValues />
          </layer>
        </layer>
      </layer>

      <layer
        x={0}
        y={0}
        w={Layout.RIGHT_DODGER_W}
        h={Layout.RIGHT_DODGER_H}
        ref={timerHost3}
        onLoad={() => overlayInit(timerHost3, ventChambersInfo, MineDodge.RIGHT, Anchor.RIGHT, Anchor.CENTRE, 0)}
      >
        <layer ref={ventChambersInfo} x={{ right: Layout.VENT_X }} y="center" w={Layout.VENT_W} h={Layout.VENT_H}>
          <rect x="center" y="center" w="fill" h="fill" color={MineColor.PLATE} transparency={MineWash.BORDER} />
          <rect
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            color={MineColor.PLATE}
            fill
            transparency={MineWash.BACKING}
          />

          <text
            x={{ right: Layout.ROW_INSET }}
            y={Layout.VENTS_TITLE_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="Vent Status"
            align="right"
            shadow
            color={MineColor.HEADING}
            optionSubject="c"
          />
          <text
            x={{ right: Layout.ROW_INSET }}
            y={Layout.CHAMBERS_TITLE_Y}
            w={Layout.VENT_ROW_W}
            h={Layout.ROW_H}
            font={MineFonts.BODY}
            text="Chamber Status"
            align="right"
            shadow
            color={MineColor.HEADING}
            optionSubject="c"
          />
          <VentChamberValues />
        </layer>
      </layer>
    </layer>
  );
}

function MainInfoValues(): Component {
  const earned: Int = useServerState(MineVarbits.TEMP_PTS);
  const startedLate: Int = useServerState(MineVarbits.STARTED_LATE);
  const stable: Int = useServerState(MineVarbits.CURRENT_STABILITY);
  const playerCount: Int = useServerState(MineVarbits.NUMBERPLAYERS);
  return (
    <>
      <text
        x={Layout.ROW_INSET}
        y={Layout.POINTS_Y}
        w="fill"
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        shadow
        color={MineColor.VALUE}
        text={pointsLabel(earned, startedLate)}
      />
      <text
        x={Layout.ROW_INSET}
        y={Layout.STABILITY_Y}
        w="fill"
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        shadow
        color={MineColor.VALUE}
        text={stabilityLabel(stable)}
      />
      <text
        x={Layout.ROW_INSET}
        y={Layout.PLAYERS_Y}
        w="fill"
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        shadow
        color={MineColor.VALUE}
        text={stringOf(playerCount)}
      />
    </>
  );
}

function VentChamberValues(): Component {
  const progress: Int = useServerState(MineVarbits.PROGRESS_STATUS);
  const ventA: Int = useServerState(MineVarbits.VENTA_STATUS);
  const ventB: Int = useServerState(MineVarbits.VENTB_STATUS);
  const ventC: Int = useServerState(MineVarbits.VENTC_STATUS);
  const chambers: Int = useServerState(MineVarbits.CHAMBER_STATUS);
  return (
    <>
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.VENT_A_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={ventLabel('A', progress, ventA)}
      />
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.VENT_B_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={ventLabel('B', progress, ventB)}
      />
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.VENT_C_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={ventLabel('C', progress, ventC)}
      />
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.CHAMBER_A_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={chamberLabel('A', progress, chambers, 0)}
      />
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.CHAMBER_B_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={chamberLabel('B', progress, chambers, 1)}
      />
      <text
        x={{ right: Layout.ROW_INSET }}
        y={Layout.CHAMBER_C_Y}
        w={Layout.VENT_ROW_W}
        h={Layout.ROW_H}
        font={MineFonts.BODY}
        align="right"
        shadow
        color={MineColor.VALUE}
        text={chamberLabel('C', progress, chambers, 2)}
      />
    </>
  );
}
