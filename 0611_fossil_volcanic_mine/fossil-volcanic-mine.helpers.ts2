import { hasBit } from '../lib/lib.engine';
import { MineRules } from './fossil-volcanic-mine.constants';

export function volcanicMineVentColour(status: Int): String {
  let distance: Int = status - MineRules.VENT_IDEAL;
  if (distance < 0) {
    distance = 0 - distance;
  }
  if (distance <= MineRules.VENT_GREEN) {
    return `<col=00ff00>${stringOf(status)}%</col>`;
  }
  if (distance <= MineRules.VENT_AMBER) {
    return `<col=ffff00>${stringOf(status)}%</col>`;
  }
  return `<col=ff0000>${stringOf(status)}%</col>`;
}

export function volcanicMineChamberColour(blocked: Boolean): String {
  if (blocked === true) {
    return '<col=ff0000>Blocked</col>';
  }
  return '<col=00ff00>Unblocked</col>';
}

export function ventLabel(letter: String, progress: Int, reading: Int): String {
  if (progress >= MineRules.RUN_STARTED && reading !== MineRules.VENT_UNKNOWN) {
    return `${letter}: ${volcanicMineVentColour(reading)}`;
  }
  return `${letter}: -%`;
}

export function chamberLabel(letter: String, progress: Int, bits: Int, bit: Int): String {
  if (progress < MineRules.RUN_STARTED) {
    return `${letter}: -`;
  }
  return `${letter}: ${volcanicMineChamberColour(hasBit(bits, bit))}`;
}

export function pointsLabel(points: Int, startedLate: Int): String {
  if (startedLate === 0) {
    return stringOf(points);
  }
  return `<col=ff0000>${stringOf(points)}</col>`;
}

export function stabilityLabel(stable: Int): String {
  if (stable < MineRules.STABILITY_RED) {
    return `<col=ff0000>${stringOf(stable)}%</col>`;
  } else if (stable < MineRules.STABILITY_AMBER) {
    return `<col=ffff00>${stringOf(stable)}%</col>`;
  }
  return `<col=00ff00>${stringOf(stable)}%</col>`;
}
