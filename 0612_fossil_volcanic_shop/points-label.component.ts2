import { onUpdated, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { Colors, Frame, ShopFonts, ShopSounds, ShopVarps } from './fossil-volcanic-shop.constants';

export function PointsLabel(): Component {
  const points: Int = useServerState(ShopVarps.POINTS);

  onUpdated(() => {
    playSound(ShopSounds.POINTS_CHANGED);
  });

  return (
    <text
      x="center"
      y={{ bottom: Frame.POINTS_BOTTOM }}
      w={{ fill: Frame.POINTS_W_INSET }}
      h={Frame.POINTS_H}
      text={`Points: <col=ffa82f>${groupDigits(points, ',')}</col>`}
      font={ShopFonts.NAME}
      color={Colors.NAME}
      shadow
      align="center"
      valign="bottom"
    />
  );
}
