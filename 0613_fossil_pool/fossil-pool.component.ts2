import { useInventory } from 'ts2';

import { CloseButton } from '../0883_mm_formulas/close-button.component';
import { Inventories } from '../lib/game/inventories';
import { FossilItems, FossilKind, Layout, PoolArt, PoolColor, PoolFonts } from './fossil-pool.constants';
import { poolLabelColour } from './fossil-pool.helpers';
import { StoneHoverSkin } from './stone-hover-skin.component';

export function FossilPool(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="center" y="center" w="fill" h="fill" sprite={PoolArt.BACKING} tiling />

      <layer x={{ right: Layout.CLOSE_INSET }} y={Layout.CLOSE_INSET} w={Layout.CLOSE_BOX} h={Layout.CLOSE_BOX}>
        <CloseButton w={Layout.CLOSE_W} h={Layout.CLOSE_H} />
      </layer>

      <text
        x="center"
        y={Layout.TITLE_Y}
        w={{ fill: Layout.TITLE_INSET_W }}
        h={Layout.TITLE_H}
        text="Fossil Pool"
        align="center"
        shadow
        font={PoolFonts.TITLE}
        color={PoolColor.LABEL}
      />

      <layer
        x={Layout.SLOT_INSET_X}
        y={Layout.SLOT_TOP_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <SlotFace kind={FossilKind.SMALL} label="Small Fossil" icon={FossilItems.SMALL_1} />
      </layer>

      <layer x="center" y={Layout.SLOT_TOP_Y} w={Layout.SLOT_W} h={Layout.SLOT_H} options={['Add to Pool']}>
        <SlotFace kind={FossilKind.MEDIUM} label="Medium Fossil" icon={FossilItems.MEDIUM_1} />
      </layer>

      <layer
        x={{ right: Layout.SLOT_INSET_X }}
        y={Layout.SLOT_TOP_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <SlotFace kind={FossilKind.LARGE} label="Large Fossil" icon={FossilItems.LARGE_1} />
      </layer>

      <layer
        x={Layout.SLOT_INSET_X}
        y={Layout.SLOT_BOTTOM_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <SlotFace kind={FossilKind.PLANT} label="Plant Fossil" icon={FossilItems.PLANT_1} />
      </layer>

      <layer x="center" y={Layout.SLOT_BOTTOM_Y} w={Layout.SLOT_W} h={Layout.SLOT_H} options={['Add to Pool']}>
        <SlotFace kind={FossilKind.UNID} label="Un-id Fossil" icon={FossilItems.SMALL_UNID} />
      </layer>

      <layer
        x={{ right: Layout.SLOT_INSET_X }}
        y={Layout.SLOT_BOTTOM_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <SlotFace kind={FossilKind.RARE} label="Rare Fossil" icon={FossilItems.RARE_1} />
      </layer>

      <layer x="center" y="bottom" w="fill" h={Layout.FOOTER_H}>
        <layer
          x={{ right: Layout.BUTTON_RIGHT }}
          y={Layout.BUTTON_TOP_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Add to pool']}
        >
          <ButtonFace kind={FossilKind.CALCITE} label="Add Calcium" />
        </layer>

        <layer x={Layout.BAR_X} y={Layout.BAR_TOP_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
          <rect x={0} y="center" w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>

        <layer
          x={{ right: Layout.BUTTON_RIGHT }}
          y={Layout.BUTTON_BOTTOM_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Add to pool']}
        >
          <ButtonFace kind={FossilKind.PYROPHOSPHITE} label="Add Phosphate" />
        </layer>

        <layer x={Layout.BAR_X} y={Layout.BAR_BOTTOM_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
          <rect x={0} y={0} w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>

        <layer x={Layout.COUNTER_X} y={Layout.COUNTER_Y} w={{ fill: Layout.COUNTER_INSET_W }} h={Layout.COUNTER_H}>
          <rect x={0} y="center" w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="0/28"
            align="center"
            valign="middle"
            shadow
            font={PoolFonts.COUNTER}
            color={PoolColor.COUNTER}
          />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>
      </layer>
    </layer>
  );
}

function SlotFace({ kind, label, icon }: { kind: FossilKind; label: String; icon: Item }): Component {
  const inv = useInventory(Inventories.INV);

  let carried: Int = 0;
  if (kind === FossilKind.SMALL) {
    carried =
      inv.total(FossilItems.SMALL_1) +
      inv.total(FossilItems.SMALL_2) +
      inv.total(FossilItems.SMALL_3) +
      inv.total(FossilItems.SMALL_4) +
      inv.total(FossilItems.SMALL_5) +
      inv.total(FossilItems.SMALL_UNID);
  } else if (kind === FossilKind.MEDIUM) {
    carried =
      inv.total(FossilItems.MEDIUM_1) +
      inv.total(FossilItems.MEDIUM_2) +
      inv.total(FossilItems.MEDIUM_3) +
      inv.total(FossilItems.MEDIUM_4) +
      inv.total(FossilItems.MEDIUM_5) +
      inv.total(FossilItems.MEDIUM_UNID);
  } else if (kind === FossilKind.LARGE) {
    carried =
      inv.total(FossilItems.LARGE_1) +
      inv.total(FossilItems.LARGE_2) +
      inv.total(FossilItems.LARGE_3) +
      inv.total(FossilItems.LARGE_4) +
      inv.total(FossilItems.LARGE_5) +
      inv.total(FossilItems.LARGE_UNID);
  } else if (kind === FossilKind.PLANT) {
    carried =
      inv.total(FossilItems.PLANT_1) +
      inv.total(FossilItems.PLANT_2) +
      inv.total(FossilItems.PLANT_3) +
      inv.total(FossilItems.PLANT_4) +
      inv.total(FossilItems.PLANT_5);
  } else if (kind === FossilKind.RARE) {
    carried =
      inv.total(FossilItems.RARE_1) +
      inv.total(FossilItems.RARE_2) +
      inv.total(FossilItems.RARE_3) +
      inv.total(FossilItems.RARE_4) +
      inv.total(FossilItems.RARE_5) +
      inv.total(FossilItems.RARE_UNID);
  } else {
    carried =
      inv.total(FossilItems.SMALL_UNID) +
      inv.total(FossilItems.MEDIUM_UNID) +
      inv.total(FossilItems.LARGE_UNID) +
      inv.total(FossilItems.RARE_UNID);
  }

  return (
    <>
      <text
        x="center"
        y="bottom"
        w="fill"
        h={Layout.SLOT_LABEL_H}
        text={label}
        align="center"
        valign="middle"
        shadow
        font={PoolFonts.LABEL}
        color={poolLabelColour(carried)}
      />
      <sprite
        x="center"
        y={Layout.SLOT_ICON_Y}
        w={Layout.SLOT_ICON_W}
        h={Layout.SLOT_ICON_H}
        item={icon}
        itemCount={0}
        itemCountMode="never"
      />
      <StoneHoverSkin />
    </>
  );
}

function ButtonFace({ kind, label }: { kind: FossilKind; label: String }): Component {
  const inv = useInventory(Inventories.INV);
  const carried: Int =
    kind === FossilKind.CALCITE ? inv.total(FossilItems.CALCITE) : inv.total(FossilItems.PYROPHOSPHITE);

  return (
    <>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        align="center"
        valign="middle"
        shadow
        font={PoolFonts.LABEL}
        color={poolLabelColour(carried)}
      />
      <StoneHoverSkin />
    </>
  );
}
