import { createRef, useInterval } from 'ts2';

import { CloseButton } from '../0883_mm_formulas/close-button.component';
import { Layout, PoolArt, PoolColor, PoolFonts } from './fossil-pool.constants';
import { fossilPoolInit } from './fossil-pool.helpers';
import { StoneHoverSkin } from './stone-hover-skin.component';

const timerHost = createRef('0613_fossil_pool_timer_host');

const smallGfx = createRef('fossil_pool_small_gfx');
const smallText = createRef('fossil_pool_small_text');
const mediumGfx = createRef('fossil_pool_medium_gfx');
const mediumText = createRef('fossil_pool_medium_text');
const largeGfx = createRef('fossil_pool_large_gfx');
const largeText = createRef('fossil_pool_large_text');
const plantGfx = createRef('fossil_pool_plant_gfx');
const plantText = createRef('fossil_pool_plant_text');
const rareGfx = createRef('fossil_pool_rare_gfx');
const rareText = createRef('fossil_pool_rare_text');
const unidGfx = createRef('fossil_pool_unid_gfx');
const unidText = createRef('fossil_pool_unid_text');
const calciumText = createRef('fossil_pool_calcium_text');
const phosphateText = createRef('fossil_pool_phosphate_text');

export function FossilPool(): Component {
  useInterval(
    () =>
      fossilPoolInit(
        smallGfx,
        smallText,
        mediumGfx,
        mediumText,
        largeGfx,
        largeText,
        plantGfx,
        plantText,
        rareGfx,
        rareText,
        unidGfx,
        unidText,
        calciumText,
        phosphateText,
      ),
    timerHost,
  );

  return (
    <layer w="fill" h="fill" ref={timerHost}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={PoolArt.BACKING} tiling />

      <layer x={{ right: Layout.CLOSE_INSET }} y={Layout.CLOSE_INSET} w={Layout.CLOSE_BOX} h={Layout.CLOSE_BOX}>
        <CloseButton w={Layout.CLOSE_W} h={Layout.CLOSE_H} />
      </layer>

      <text
        x="center"
        y={Layout.TITLE_Y}
        w={{ fill: Layout.TITLE_INSET_W }}
        h={Layout.TITLE_H}
        text="Fossil Pool"
        align="center"
        shadow
        font={PoolFonts.TITLE}
        color={PoolColor.LABEL}
      />

      <layer
        x={Layout.SLOT_INSET_X}
        y={Layout.SLOT_TOP_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <text
          ref={smallText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Small Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={smallGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer x="center" y={Layout.SLOT_TOP_Y} w={Layout.SLOT_W} h={Layout.SLOT_H} options={['Add to Pool']}>
        <text
          ref={mediumText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Medium Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={mediumGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer
        x={{ right: Layout.SLOT_INSET_X }}
        y={Layout.SLOT_TOP_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <text
          ref={largeText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Large Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={largeGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer
        x={Layout.SLOT_INSET_X}
        y={Layout.SLOT_BOTTOM_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <text
          ref={plantText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Plant Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={plantGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer x="center" y={Layout.SLOT_BOTTOM_Y} w={Layout.SLOT_W} h={Layout.SLOT_H} options={['Add to Pool']}>
        <text
          ref={unidText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Un-id Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={unidGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer
        x={{ right: Layout.SLOT_INSET_X }}
        y={Layout.SLOT_BOTTOM_Y}
        w={Layout.SLOT_W}
        h={Layout.SLOT_H}
        options={['Add to Pool']}
      >
        <text
          ref={rareText}
          x="center"
          y="bottom"
          w="fill"
          h={Layout.SLOT_LABEL_H}
          text="Rare Fossil"
          align="center"
          valign="middle"
          shadow
          font={PoolFonts.LABEL}
          color={PoolColor.LABEL}
        />
        <sprite ref={rareGfx} x="center" y={Layout.SLOT_ICON_Y} w={Layout.SLOT_ICON_W} h={Layout.SLOT_ICON_H} />
        <StoneHoverSkin />
      </layer>

      <layer x="center" y="bottom" w="fill" h={Layout.FOOTER_H}>
        <layer
          x={{ right: Layout.BUTTON_RIGHT }}
          y={Layout.BUTTON_TOP_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Add to pool']}
        >
          <text
            ref={calciumText}
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="Add Calcium"
            align="center"
            valign="middle"
            shadow
            font={PoolFonts.LABEL}
            color={PoolColor.LABEL}
          />
          <StoneHoverSkin />
        </layer>

        <layer x={Layout.BAR_X} y={Layout.BAR_TOP_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
          <rect x={0} y="center" w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>

        <layer
          x={{ right: Layout.BUTTON_RIGHT }}
          y={Layout.BUTTON_BOTTOM_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Add to pool']}
        >
          <text
            ref={phosphateText}
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="Add Phosphate"
            align="center"
            valign="middle"
            shadow
            font={PoolFonts.LABEL}
            color={PoolColor.LABEL}
          />
          <StoneHoverSkin />
        </layer>

        <layer x={Layout.BAR_X} y={Layout.BAR_BOTTOM_Y} w={Layout.BAR_W} h={Layout.BAR_H}>
          <rect x={0} y={0} w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>

        <layer x={Layout.COUNTER_X} y={Layout.COUNTER_Y} w={{ fill: Layout.COUNTER_INSET_W }} h={Layout.COUNTER_H}>
          <rect x={0} y="center" w={Layout.BAR_FILLED_W} h="fill" color={PoolColor.BAR_FILLED} fill />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text="0/28"
            align="center"
            valign="middle"
            shadow
            font={PoolFonts.COUNTER}
            color={PoolColor.COUNTER}
          />
          <rect x="center" y="center" w="fill" h="fill" color={PoolColor.BAR_BORDER} />
        </layer>
      </layer>
    </layer>
  );
}
