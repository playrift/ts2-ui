import { CS2, useInventory } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { FossilItems, PoolColor } from './fossil-pool.constants';

export function fossilPoolInit(
  smallIcon: ComponentId,
  smallLabel: ComponentId,
  mediumIcon: ComponentId,
  mediumLabel: ComponentId,
  largeIcon: ComponentId,
  largeLabel: ComponentId,
  plantIcon: ComponentId,
  plantLabel: ComponentId,
  rareIcon: ComponentId,
  rareLabel: ComponentId,
  unidIcon: ComponentId,
  unidLabel: ComponentId,
  calciumLabel: ComponentId,
  phosphateLabel: ComponentId,
): void {
  CS2.if_item_nonum_set(FossilItems.SMALL_1, 0, smallIcon);
  CS2.if_item_nonum_set(FossilItems.MEDIUM_1, 0, mediumIcon);
  CS2.if_item_nonum_set(FossilItems.LARGE_1, 0, largeIcon);
  CS2.if_item_nonum_set(FossilItems.RARE_1, 0, rareIcon);
  CS2.if_item_nonum_set(FossilItems.PLANT_1, 0, plantIcon);
  CS2.if_item_nonum_set(FossilItems.SMALL_UNID, 0, unidIcon);

  const inv = useInventory(Inventories.INV);

  const small: Int =
    inv.total(FossilItems.SMALL_1) +
    inv.total(FossilItems.SMALL_2) +
    inv.total(FossilItems.SMALL_3) +
    inv.total(FossilItems.SMALL_4) +
    inv.total(FossilItems.SMALL_5);
  const medium: Int =
    inv.total(FossilItems.MEDIUM_1) +
    inv.total(FossilItems.MEDIUM_2) +
    inv.total(FossilItems.MEDIUM_3) +
    inv.total(FossilItems.MEDIUM_4) +
    inv.total(FossilItems.MEDIUM_5);
  const large: Int =
    inv.total(FossilItems.LARGE_1) +
    inv.total(FossilItems.LARGE_2) +
    inv.total(FossilItems.LARGE_3) +
    inv.total(FossilItems.LARGE_4) +
    inv.total(FossilItems.LARGE_5);
  const plant: Int =
    inv.total(FossilItems.PLANT_1) +
    inv.total(FossilItems.PLANT_2) +
    inv.total(FossilItems.PLANT_3) +
    inv.total(FossilItems.PLANT_4) +
    inv.total(FossilItems.PLANT_5);
  const rare: Int =
    inv.total(FossilItems.RARE_1) +
    inv.total(FossilItems.RARE_2) +
    inv.total(FossilItems.RARE_3) +
    inv.total(FossilItems.RARE_4) +
    inv.total(FossilItems.RARE_5);

  const smallUnid: Int = inv.total(FossilItems.SMALL_UNID);
  const mediumUnid: Int = inv.total(FossilItems.MEDIUM_UNID);
  const largeUnid: Int = inv.total(FossilItems.LARGE_UNID);
  const rareUnid: Int = inv.total(FossilItems.RARE_UNID);

  const calcite: Int = inv.total(FossilItems.CALCITE);
  const pyrophosphite: Int = inv.total(FossilItems.PYROPHOSPHITE);

  if (small > 0 || smallUnid > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, smallLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, smallLabel);
  }
  if (medium > 0 || mediumUnid > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, mediumLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, mediumLabel);
  }
  if (large > 0 || largeUnid > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, largeLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, largeLabel);
  }
  if (rare > 0 || rareUnid > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, rareLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, rareLabel);
  }
  if (plant > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, plantLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, plantLabel);
  }
  if (smallUnid > 0 || mediumUnid > 0 || largeUnid > 0 || rareUnid > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, unidLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, unidLabel);
  }
  if (calcite > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, calciumLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, calciumLabel);
  }
  if (pyrophosphite > 0) {
    CS2.if_colour_set(PoolColor.LABEL_HELD, phosphateLabel);
  } else {
    CS2.if_colour_set(PoolColor.LABEL, phosphateLabel);
  }
}
