import { useState } from 'ts2';

import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';

export function StoneHoverSkin(): Component {
  const [hovered, setHovered] = useState(0);

  return (
    <layer w="fill" h="fill" onMouseEnter={() => setHovered(1)} onMouseLeave={() => setHovered(0)}>
      {hovered !== 0 ? <StoneButtonPressedEntrypoint /> : <StoneButtonEntrypoint />}
    </layer>
  );
}
