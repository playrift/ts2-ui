import { createRef, useState } from 'ts2';

import { Fonts } from '../lib/game/fonts';
import { Sprites } from '../lib/game/sprites';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { tutorialLine } from './tutorial-overlay.helpers';
import { tutorialBoxShown, tutorialLinesStep } from './tutorial-overlay.state';

const dodger = createRef('tutorial_overlay_dodger');
const box = createRef('tutorial_overlay_box');

const TEXT_COLOUR = 0xff981f;
const OUTLINE_COLOUR = 0x5b3400;

export function TutorialOverlay(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" hide noClickThrough />
      <layer
        ref={dodger}
        x="center"
        y="center"
        w="fill"
        h="fill"
        onLoad={() => overlayInit(dodger, box, 65256, Anchor.LEFT, Anchor.TOP, 0)}
      >
        <layer static ref={box} x={4} y={2} w={280} h={104}>
          <InstructionBox />
        </layer>
      </layer>
      <layer x="center" y="center" w="fill" h="fill">
        <layer x="center" y={{ bottom: 10 }} w={370} h={35} hide>
          <layer x="right" y={4} w={{ fill: 50 }} h={10}>
            <rect x="center" y="center" w="fill" h="fill" color={0x000000} fill transparency={150} />
            <rect y="center" w={0} h="fill" color={0x8080ff} fill transparency={64} />
            <rect x="center" y="center" w="fill" h="fill" color={0x808080} transparency={64} />
          </layer>
          <text w={45} h={{ fill: 17 }} font={Fonts.P12_FULL} color={0x888888} align="right" shadow text="% Done" />
          <text
            x="center"
            y="bottom"
            w="fill"
            h={17}
            font={Fonts.P12_FULL}
            color={0xffff00}
            align="center"
            valign="middle"
            shadow
            text="Tutorial Island Progress"
          />
        </layer>
      </layer>
    </>
  );
}

function InstructionBox(): Component {
  const [shown] = useState(tutorialBoxShown);
  const [step] = useState(tutorialLinesStep);

  return (
    <layer w="fill" h="fill" hide={shown === 0}>
      <sprite
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        sprite={Sprites.TRADEBACKING_DARK}
        tiling
        transparency={80}
      />
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={0x000000} fill transparency={220} />
      <rect x="center" y="center" w="fill" h="fill" color={OUTLINE_COLOUR} />
      <Line y={6} text={tutorialLine(step, 1)} />
      <Line y={24} text={tutorialLine(step, 2)} />
      <Line y={50} text={tutorialLine(step, 3)} />
      <Line y={68} text={tutorialLine(step, 4)} />
    </layer>
  );
}

function Line({ y, text }: { y: Int; text: String }): Component {
  return (
    <text
      x="center"
      y={y}
      w={{ fill: 20 }}
      h={30}
      font={Fonts.B12_FULL}
      color={TEXT_COLOUR}
      align="center"
      valign="middle"
      shadow
      text={text}
    />
  );
}
