import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { tutorialBoxShown, tutorialLinesStep } from './tutorial-overlay.state';
import { LAST_STEP, TutorialSteps } from './tutorial-steps.data';

export function tutorialOverlayStep(step: Int): void {
  const [, setShown] = useState(tutorialBoxShown);
  const [, setLinesStep] = useState(tutorialLinesStep);
  setShown(1);
  if (step >= 1 && step <= LAST_STEP) {
    setLinesStep(step);
  }
}

export function tutorialLine(step: Int, line: Int): String {
  if (step < 1) {
    return '';
  }
  const row = TutorialSteps.at(step - 1);
  if (row === null) {
    return '';
  }
  if (onMobile()) {
    if (line === 1) {
      return row.mobile1;
    }
    if (line === 2) {
      return row.mobile2;
    }
    if (line === 3) {
      return row.mobile3;
    }
    return row.mobile4;
  }
  if (line === 1) {
    return row.desktop1;
  }
  if (line === 2) {
    return row.desktop2;
  }
  if (line === 3) {
    return row.desktop3;
  }
  return row.desktop4;
}
