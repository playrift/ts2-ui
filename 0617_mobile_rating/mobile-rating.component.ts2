import { RatingButton } from './rating-button.component';
import { Layout, RatingColors, RatingFonts, RatingModels } from './mobile-rating.constants';

export function MobileRating(): Component {
  return (
    <layer x={{ center: Layout.PANEL_NUDGE }} y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <text
        x="center"
        y={Layout.MESSAGE_Y}
        w={Layout.MESSAGE_WIDTH}
        h={{ fill: Layout.MESSAGE_BOTTOM }}
        text="Enjoying your time?<br><br>Would you like to take a moment to rate the app?"
        font={RatingFonts.MESSAGE}
        color={RatingColors.LABEL}
        align="center"
        valign="middle"
      />

      <RatingButton
        label="Ask Me Later"
        x="center"
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <RatingButton
        label="No"
        x={{ right: Layout.BUTTON_EDGE }}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <RatingButton
        label="Yes"
        x={Layout.BUTTON_EDGE}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <model
        x={Layout.MODEL_INSET}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RatingModels.PROMPT}
        zoom={Layout.MODEL_ZOOM}
      />
      <model
        x={{ right: Layout.MODEL_INSET }}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={RatingModels.PROMPT}
        zoom={Layout.MODEL_ZOOM}
      />
    </layer>
  );
}
