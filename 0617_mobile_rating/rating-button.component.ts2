import { useRef } from 'ts2';
import { Frame } from '../lib/frame.component';
import { ButtonSkinIn, ButtonSkinOut, RatingColors, RatingFonts } from './mobile-rating.constants';

export function RatingButton({ label }: { label: String }): Component {
  const raised = useRef();
  const pressed = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        raised.hide = true;
        pressed.hide = false;
      }}
      onMouseLeave={() => {
        raised.hide = false;
        pressed.hide = true;
      }}
    >
      <layer ref={raised} w="fill" h="fill">
        <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={ButtonSkinOut.FILL} tiling />
        <Frame
          topLeft={ButtonSkinOut.TOP_LEFT}
          topRight={ButtonSkinOut.TOP_RIGHT}
          bottomLeft={ButtonSkinOut.BOTTOM_LEFT}
          bottomRight={ButtonSkinOut.BOTTOM_RIGHT}
          left={ButtonSkinOut.LEFT}
          top={ButtonSkinOut.TOP}
          right={ButtonSkinOut.RIGHT}
          bottom={ButtonSkinOut.BOTTOM}
        >
          <RatingButtonLabel label={label} />
        </Frame>
      </layer>

      <layer ref={pressed} hide w="fill" h="fill">
        <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={RatingColors.PRESSED_FILL} fill />
        <Frame
          topLeft={ButtonSkinIn.TOP_LEFT}
          topRight={ButtonSkinIn.TOP_RIGHT}
          bottomLeft={ButtonSkinIn.BOTTOM_LEFT}
          bottomRight={ButtonSkinIn.BOTTOM_RIGHT}
          left={ButtonSkinIn.LEFT}
          top={ButtonSkinIn.TOP}
          right={ButtonSkinIn.RIGHT}
          bottom={ButtonSkinIn.BOTTOM}
        >
          <RatingButtonLabel label={label} />
        </Frame>
      </layer>
    </layer>
  );
}

function RatingButtonLabel({ label }: { label: String }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={RatingFonts.BUTTON}
      color={RatingColors.LABEL}
      align="center"
      valign="middle"
    />
  );
}
