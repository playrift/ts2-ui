import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { ButtonBackground } from './button-background.component';
import { ArenaColor, ArenaFonts, ArenaSprites, ArenaTransparency, Layout, ReviewRows } from './1v1arena-hud.constants';
import {
  collapseArenaHud,
  displaySlot,
  expandArenaHud,
  hideLabel,
  hideSlot,
  pressArenaButton,
  showLabel,
  showSlot,
  spectatorLabel,
  startAllLabel,
  swapLabelColor,
} from './1v1arena-hud.helpers';

export function Arena1v1Hud(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        ref={showSlot}
        x={Layout.SHOW_X}
        y="center"
        w={Layout.SHOW_W}
        h={Layout.SHOW_H}
        hide
        noClickThrough
        options={['Show']}
        onMouseEnter={() => swapLabelColor(showLabel, ArenaColor.HOVER)}
        onMouseLeave={() => swapLabelColor(showLabel, ArenaColor.LABEL)}
        onOptionSelect={() => expandArenaHud()}
      >
        <ButtonBackground />
        <text
          ref={showLabel}
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="Show"
          font={ArenaFonts.LABEL}
          color={ArenaColor.LABEL}
          align="center"
          valign="middle"
          shadow
        />
      </layer>

      <layer ref={displaySlot} x={Layout.DISPLAY_X} y="center" w={Layout.DISPLAY_W} h={Layout.DISPLAY_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          sprite={ArenaSprites.BACKDROP}
          tiling
          transparency={ArenaTransparency.BACKDROP}
        />

        <layer x="center" y="center" w={{ fill: Layout.CONTENTS_INSET }} h={{ fill: Layout.CONTENTS_INSET }} dragTarget>
          <layer
            ref={hideSlot}
            x={{ right: Layout.HIDE_INSET_X }}
            y={Layout.HIDE_Y}
            w={Layout.HIDE_W}
            h={Layout.HIDE_H}
            noClickThrough
            options={['Hide']}
            onMouseEnter={() => swapLabelColor(hideLabel, ArenaColor.HOVER)}
            onMouseLeave={() => swapLabelColor(hideLabel, ArenaColor.LABEL)}
            onOptionSelect={() => collapseArenaHud()}
          >
            <ButtonBackground />
            <text
              ref={hideLabel}
              x="center"
              y="center"
              w="fill"
              h="fill"
              text="Hide"
              font={ArenaFonts.LABEL}
              color={ArenaColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            x={{ right: Layout.SPECTATOR_INSET_X }}
            y={Layout.SPECTATOR_Y}
            w={Layout.SPECTATOR_W}
            h={Layout.SPECTATOR_H}
            noClickThrough
            options={['Spectator']}
            onMouseRepeat={() => swapLabelColor(spectatorLabel, ArenaColor.HOVER)}
            onMouseLeave={() => swapLabelColor(spectatorLabel, ArenaColor.LABEL)}
            onOptionSelect={(event) => pressArenaButton(event.component, spectatorLabel)}
          >
            <ButtonBackground />
            <text
              ref={spectatorLabel}
              x="center"
              y="center"
              w="fill"
              h="fill"
              text="Spectator"
              font={ArenaFonts.LABEL}
              color={ArenaColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            x={{ right: Layout.STARTALL_INSET_X }}
            y={Layout.STARTALL_Y}
            w={Layout.STARTALL_W}
            h={Layout.STARTALL_H}
            noClickThrough
            options={['Start All']}
            onMouseRepeat={() => swapLabelColor(startAllLabel, ArenaColor.HOVER)}
            onMouseLeave={() => swapLabelColor(startAllLabel, ArenaColor.LABEL)}
            onOptionSelect={(event) => pressArenaButton(event.component, startAllLabel)}
          >
            <ButtonBackground />
            <text
              ref={startAllLabel}
              x="center"
              y="center"
              w="fill"
              h="fill"
              text="Start All"
              font={ArenaFonts.LABEL}
              color={ArenaColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            x={0}
            y={0}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="center"
            y={0}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x={0}
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="center"
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="right"
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />

          {ReviewRows.map(() => (
            <layer
              x={0}
              y="bottom"
              w={Layout.REVIEW_W}
              h={Layout.REVIEW_H}
              hide
              options={['Review']}
              interactionDepth={1}
              dragDeadZone={5}
              dragDeadTime={5}
            />
          ))}
        </layer>

        <SteelFrameEntrypoint />
      </layer>
    </layer>
  );
}
