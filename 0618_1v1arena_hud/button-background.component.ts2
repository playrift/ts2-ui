import { ButtonSprite } from './1v1arena-hud.constants';

export function ButtonBackground(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={ButtonSprite.EDGE} h={ButtonSprite.EDGE} sprite={ButtonSprite.NW} />
      <sprite
        x={ButtonSprite.EDGE}
        y="top"
        w={{ fill: ButtonSprite.EDGE_INSET }}
        h={ButtonSprite.EDGE}
        sprite={ButtonSprite.N}
        tiling
      />
      <sprite x="right" y="top" w={ButtonSprite.EDGE} h={ButtonSprite.EDGE} sprite={ButtonSprite.NE} />
      <sprite
        x="left"
        y={ButtonSprite.EDGE}
        w={ButtonSprite.EDGE}
        h={{ fill: ButtonSprite.EDGE_INSET }}
        sprite={ButtonSprite.W}
        tiling
      />
      <sprite
        x={ButtonSprite.EDGE}
        y={ButtonSprite.EDGE}
        w={{ fill: ButtonSprite.EDGE_INSET }}
        h={{ fill: ButtonSprite.EDGE_INSET }}
        sprite={ButtonSprite.C}
        tiling
      />
      <sprite
        x="right"
        y={ButtonSprite.EDGE}
        w={ButtonSprite.EDGE}
        h={{ fill: ButtonSprite.EDGE_INSET }}
        sprite={ButtonSprite.E}
        tiling
      />
      <sprite x="left" y="bottom" w={ButtonSprite.EDGE} h={ButtonSprite.EDGE} sprite={ButtonSprite.SW} />
      <sprite
        x={ButtonSprite.EDGE}
        y="bottom"
        w={{ fill: ButtonSprite.EDGE_INSET }}
        h={ButtonSprite.EDGE}
        sprite={ButtonSprite.S}
        tiling
      />
      <sprite x="right" y="bottom" w={ButtonSprite.EDGE} h={ButtonSprite.EDGE} sprite={ButtonSprite.SE} />
    </layer>
  );
}
