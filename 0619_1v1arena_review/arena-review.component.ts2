import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ReviewInventory } from './review-inventory.component';
import { ReviewSlot } from './review-slot.component';
import { ReviewArt, ReviewColors, ReviewFonts, StatIcons, WornSlot } from './arena-review.constants';

export function ArenaReview(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y={{ bottom: 10 }} w={{ fill: 20 }} h={{ fill: 50 }}>
        <sprite x="right" y={0} w={25} h={25} sprite={StatIcons.ROW_1} transparency={100} />
        <sprite x="right" y={25} w={25} h={25} sprite={StatIcons.ROW_2} transparency={100} />
        <sprite x="right" y={50} w={25} h={25} sprite={StatIcons.ROW_3} transparency={100} />
        <sprite x="right" y={75} w={25} h={25} sprite={StatIcons.ROW_4} transparency={100} />
        <sprite x="right" y={100} w={25} h={25} sprite={StatIcons.ROW_5} transparency={100} />
        <sprite x="right" y={125} w={25} h={25} sprite={StatIcons.ROW_6} transparency={100} />
        <sprite x="right" y={150} w={25} h={25} sprite={StatIcons.ROW_7} transparency={100} />
        <sprite x="right" y={175} w={25} h={25} sprite={StatIcons.ROW_8} transparency={100} />

        <text
          x="right"
          y={0}
          w={25}
          h={200}
          font={ReviewFonts.STATS}
          color={ReviewColors.STATS}
          shadow
          align="center"
          valign="middle"
          lineHeight={25}
        />

        <layer x={{ right: 30 }} y="center" w={160} h="fill">
          <sprite x="center" y="center" w="fill" h="fill" sprite={ReviewArt.BACKDROP} tiling />
          <layer x="center" y="center" w="fill" h="fill">
            <ThinBoxEntrypoint />
          </layer>
          <ReviewInventory />
        </layer>

        <layer x={0} y="center" w={140} h={220}>
          <sprite x="center" y="center" w={36} h={{ fill: 72 }} sprite={ReviewArt.SILHOUETTE_NARROW} tiling />
          <sprite x="center" y={42} w={{ fill: 92 }} h={36} sprite={ReviewArt.SILHOUETTE_WIDE} tiling />
          <sprite x="center" y={81} w={{ fill: 72 }} h={36} sprite={ReviewArt.SILHOUETTE_WIDE} tiling />
          <sprite x={0} y={118} w={36} h={{ fill: 154 }} sprite={ReviewArt.SILHOUETTE_NARROW} tiling />
          <sprite x="right" y={118} w={36} h={{ fill: 154 }} sprite={ReviewArt.SILHOUETTE_NARROW} tiling />

          <ReviewSlot slot={WornSlot.HEAD} x={52} y={0} />
          <ReviewSlot slot={WornSlot.CAPE} x={10} y={43} />
          <ReviewSlot slot={WornSlot.AMULET} x={52} y={43} />
          <ReviewSlot slot={WornSlot.WEAPON} x={0} y={82} />
          <ReviewSlot slot={WornSlot.BODY} x={52} y={82} />
          <ReviewSlot slot={WornSlot.SHIELD} x={104} y={82} />
          <ReviewSlot slot={WornSlot.LEGS} x={52} y={134} />
          <ReviewSlot slot={WornSlot.HANDS} x={0} y={184} />
          <ReviewSlot slot={WornSlot.FEET} x={52} y={184} />
          <ReviewSlot slot={WornSlot.RING} x={104} y={184} />
          <ReviewSlot slot={WornSlot.AMMO} x={94} y={43} />
        </layer>
      </layer>
    </>
  );
