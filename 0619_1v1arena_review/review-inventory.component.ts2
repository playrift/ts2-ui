import { intArray, useInventory, useUniverse } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { Grid, Icon, ReviewColors, ReviewInventories, ThickOutlineItems } from './arena-review.constants';

export function ReviewInventory(): Component {
  const stash = useInventory(ReviewInventories.SNAPSHOT);
  const universe = useUniverse();

  const pitchX: Int = (universe.width - Grid.MARGINS - Grid.COLUMNS * Icon.W) / (Grid.COLUMNS - 1) + Icon.W;
  const pitchY: Int = (universe.height - Grid.MARGINS - Grid.ROWS * Icon.H) / (Grid.ROWS - 1) + Icon.H;

  const carried = intArray<Item>(Grid.SLOTS);
  let index: Int = 0;
  while (index < Grid.SLOTS) {
    carried[index] = stash[Grid.OFFSET + index];
    index = index + 1;
  }

  return (
    <layer w="fill" h="fill">
      {carried.map(
        (item, slot) =>
          item !== -1 && (
            <sprite
              x={Grid.MARGIN + pitchX * (slot % Grid.COLUMNS)}
              y={Grid.MARGIN + pitchY * (slot / Grid.COLUMNS)}
              w={Icon.W}
              h={Icon.H}
              item={item}
              itemCount={stash.count(Grid.OFFSET + slot)}
              outline={ThickOutlineItems.get(item) === true ? 2 : 1}
              shadowColor={ReviewColors.ICON_SHADOW}
              options={['', '', '', '', '', '', '', '', '', 'Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
            />
          ),
      )}
    </layer>
  );
}
