import { CS2, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_house-options/button-background.component';
import { CLEAR, Layout, PRESS_CYCLES, ResultsColors, ResultsFonts, ResultsSounds } from './arena-results.constants';

export function ClearButton(): Component {
  const [pressedUntil, setPressedUntil] = useState(0);

  if (pressedUntil !== 0) {
    return (
      <layer
        x={Layout.BUTTON_X}
        y={Layout.BUTTON_Y}
        w={{ fill: Layout.BUTTON_INSET_W }}
        h={Layout.BUTTON_H}
        options={[CLEAR]}
        onTimer={() => {
          if (clientClock() < pressedUntil) {
            return;
          }
          setPressedUntil(0);
        }}
      >
        <rect x={0} y={0} w={0} h={0} hide />
        <ButtonBackground />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={CLEAR}
          font={ResultsFonts.BUTTON}
          color={ResultsColors.PRESSED}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      x={Layout.BUTTON_X}
      y={Layout.BUTTON_Y}
      w={{ fill: Layout.BUTTON_INSET_W }}
      h={Layout.BUTTON_H}
      options={[CLEAR]}
      onOptionSelect={(event) => {
        playSound(ResultsSounds.SELECT);
        setPressedUntil(clientClock() + PRESS_CYCLES);
        CS2.if_resume_pausebutton(event.component);
      }}
    >
      <rect x={0} y={0} w={0} h={0} hide />
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={CLEAR}
        font={ResultsFonts.BUTTON}
        color={ResultsColors.LABEL}
        hover={{ color: ResultsColors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
