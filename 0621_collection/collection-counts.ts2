import { useServerState } from 'ts2';

import { timeConvertOption } from '../0512_trailblazer_areas/time.shared';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { groupDigits } from '../lib/lib.format';
import { textDevice } from '../lib/lib.helpers';

export function formatCount(value: Int): String {
  if (value >= MAX_INT) {
    return `Lots! (${stringOf(value)}+)`;
  }
  return groupDigits(value, ',');
}

const MAX_INT = 2147483647;

export function categoryCountLines(category: Int): [String, String, String, String] {
  const count: Int = useServerState(Varps.COLLECTION_CATEGORY_COUNT);
  const count2: Int = useServerState(Varps.COLLECTION_CATEGORY_COUNT2);
  const count3: Int = useServerState(Varps.COLLECTION_CATEGORY_COUNT3);
  const aluftHard: Int = useServerState(Varbits.COLLECTION_ALUFT_HARD_DELIVERIES);
  const aluftEasy: Int = useServerState(Varbits.COLLECTION_ALUFT_EASY_DELIVERIES);
  const personalBest: Int = useServerState(Varps.COLLECTION_PERSONAL_BEST_TRANSMIT);
  const personalBest2: Int = useServerState(Varps.COLLECTION_PERSONAL_BEST_TRANSMIT_2);
  let best: String = 'N/A';
  let best2: String = 'N/A';
  if (personalBest > 0) {
    best = timeConvertOption(personalBest);
  }
  if (personalBest2 > 0) {
    best2 = timeConvertOption(personalBest2);
  }
  switch (category) {
    case 0:
      return [`Abyssal Sire kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 1:
      return [
        `Alchemical Hydra kills: <col=ffffff>${formatCount(count)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
        '',
        '',
      ];
    case 2:
      return [
        `Amoxliatl kills: <col=ffffff>${formatCount(count)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
        '',
        '',
      ];
    case 3:
      return [
        `Araxxor kills: <col=ffffff>${formatCount(count)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
        '',
        '',
      ];
    case 4:
      return [`Barrows Chests opened: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 5:
      return [
        `Brutus kills: <col=ffffff>${formatCount(count)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
        '',
        '',
      ];
    case 6:
      return [`Bryophyta kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 7:
      return [
        `Artio kills: <col=ffffff>${formatCount(count)}</col>`,
        `Callisto kills: <col=ffffff>${formatCount(count2)}</col>`,
        '',
        '',
      ];
    case 8:
      return [`Cerberus kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 9:
      return [`Chaos Elemental kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 10:
      return [`Chaos Fanatic kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 11:
      return [`Commander Zilyana kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 12:
      return [`Corporeal Beast kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 13:
      return [`Crazy Archaeologist kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 14:
      return [
        `Dagannoth Supreme kills: <col=ffffff>${formatCount(count)}</col>`,
        `Dagannoth Prime kills: <col=ffffff>${formatCount(count2)}</col>`,
        `Dagannoth Rex kills: <col=ffffff>${formatCount(count3)}</col>`,
        '',
      ];
    case 15:
      return [`Deranged Archaeologist kills: <col=ffffff>${formatCount(count)}</col>`, '', '', ''];
    case 16:
      return [
        `Total delves: <col=ffffff>${formatCount(count)}</col>`,
        `Deep delves: <col=ffffff>${formatCount(count2)}</col>`,
        `Deepest delve: <col=ffffff>${formatCount(count3)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
      ];
    case 17:
      return [
        `Duke Sucellus kills: <col=ffffff>${formatCount(count)}</col>`,
        `Personal Best: <col=ffffff>${best}</col>`,
        '',
        '',
      ];
    case 18:
