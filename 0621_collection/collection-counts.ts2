export function categoryCompleted(category: Int): Int {
  switch (category) {
    case 0:
      return useServerState(Varbits.COLLECTION_BOSSES_SIRE_COMPLETED);
    case 1:
      return useServerState(Varbits.COLLECTION_BOSSES_HYDRA_BOSS_COMPLETED);
    case 2:
