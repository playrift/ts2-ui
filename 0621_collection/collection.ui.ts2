export const collectionUi = (): UI => (
  <ui ref={infinityRef}>
    <CollectionLog_ />
  </ui>
);

function CollectionLog_(): Component {
  return (
    <>
      <layer
        ref={universeRef}
        x="center"
        y="center"
        w={Layout.PANEL_W}
        h={Layout.PANEL_H}
        noClickThrough
        onLoad={() => collectionInit()}
      >
        <layer ref={frameRef} x="center" y="center" w="fill" h="fill">
          <CollectionFrame />
        </layer>

        <CollectionClose />

        <layer
          ref={contentRef}
