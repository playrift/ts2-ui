              y={Layout.SCROLLBAR_INSET}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_INSET_H }}
            >
              <CategoryScrollbar tab={0} content={bossContainerRef} />
            </layer>
            <layer
              ref={raidContainerRef}
              x={Layout.CONTAINER_X}
              y={0}
              w={{ fill: Layout.CONTAINER_INSET_W }}
              h={{ fill: Layout.CONTAINER_INSET_H }}
            >
              <CategoryList tab={1} />
            </layer>
            <layer
              ref={raidScrollbarRef}
              right={Layout.SCROLLBAR_INSET}
              y={Layout.SCROLLBAR_INSET}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_INSET_H }}
            >
              <CategoryScrollbar tab={1} content={raidContainerRef} />
            </layer>
            <layer
              ref={clueContainerRef}
              x={Layout.CONTAINER_X}
              y={0}
              w={{ fill: Layout.CONTAINER_INSET_W }}
              h={{ fill: Layout.CONTAINER_INSET_H }}
            >
              <CategoryList tab={2} />
            </layer>
            <layer
              ref={clueScrollbarRef}
              right={Layout.SCROLLBAR_INSET}
              y={Layout.SCROLLBAR_INSET}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_INSET_H }}
            >
              <CategoryScrollbar tab={2} content={clueContainerRef} />
            </layer>
            <layer
              ref={minigameContainerRef}
              x={Layout.CONTAINER_X}
              y={0}
              w={{ fill: Layout.CONTAINER_INSET_W }}
              h={{ fill: Layout.CONTAINER_INSET_H }}
            >
              <CategoryList tab={3} />
            </layer>
            <layer
              ref={minigameScrollbarRef}
              right={Layout.SCROLLBAR_INSET}
              y={Layout.SCROLLBAR_INSET}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_INSET_H }}
            >
              <CategoryScrollbar tab={3} content={minigameContainerRef} />
            </layer>
            <layer
              ref={otherContainerRef}
              x={Layout.CONTAINER_X}
              y={0}
              w={{ fill: Layout.CONTAINER_INSET_W }}
              h={{ fill: Layout.CONTAINER_INSET_H }}
            >
              <CategoryList tab={4} />
            </layer>
            <layer
              ref={otherScrollbarRef}
              right={Layout.SCROLLBAR_INSET}
              y={Layout.SCROLLBAR_INSET}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.SCROLLBAR_INSET_H }}
            >
              <CategoryScrollbar tab={4} content={otherContainerRef} />
            </layer>
            <ListOutline />
          </layer>

          <layer ref={mainRef} x="right" y={Layout.LIST_Y} w={{ fill: Layout.LIST_W }} h={{ fill: Layout.LIST_Y }}>
            <CollectionLog />
          </layer>

          <layer ref={burgerOverlayRef} x={0} y={0} w="fill" h="fill">
            <BurgerClickAway />
          </layer>
        </layer>

        <layer ref={keyListenerRef} x={0} y={0} w={Layout.KEY_LISTENER} h={Layout.KEY_LISTENER}>
          <layer ref={keyARef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyBRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyCRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyDRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyERef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyFRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyGRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyHRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyIRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyJRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyKRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyLRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyMRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyNRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyORef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyPRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyQRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyRRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keySRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyTRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyURef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyVRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyWRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyXRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyYRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyZRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keySpaceRef} x={0} y={0} w="fill" h="fill" />
          <layer ref={keyBackspaceRef} x={0} y={0} w="fill" h="fill" />
          <layer
            ref={keyTabRef}
            x={0}
            y={0}
            w="fill"
            h="fill"
            onLoad={() => bindSearchToggleKey()}
            onOptionSelect={() => toggleSearch(0)}
