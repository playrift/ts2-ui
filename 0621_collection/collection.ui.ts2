        </layer>

        <layer
          ref={contentSearchRef}
          x="center"
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_INSET_W }}
          h={{ fill: Layout.CONTENT_INSET_H }}
        >
          <SearchContent />
