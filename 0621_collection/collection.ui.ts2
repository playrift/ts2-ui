          h={{ fill: Layout.CONTENT_INSET_H }}
        >
          <layer ref={tabsRef} x={0} y={0} w="fill" h={Layout.TABS_H}>
            <CollectionTabStrip />
          </layer>

          <layer ref={listRef} x={0} y={Layout.LIST_Y} w={Layout.LIST_W} h={{ fill: Layout.LIST_Y }}>
            <layer
              ref={bossContainerRef}
              x={Layout.CONTAINER_X}
              y={0}
              w={{ fill: Layout.CONTAINER_INSET_W }}
              h={{ fill: Layout.CONTAINER_INSET_H }}
            >
              <CategoryList tab={0} />
            </layer>
            <layer
              ref={bossScrollbarRef}
