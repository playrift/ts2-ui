        <layer
          ref={burgerButtonRef}
          x={Layout.BURGER_XY}
          y={Layout.BURGER_XY}
          w={Layout.BURGER}
          h={Layout.BURGER}
          options={[Copy.BURGER_OP]}
          onOptionSelect={(event) => toggleBurgerMenu(event.option)}
        >
          <BurgerGlyph />
        </layer>
        <layer ref={burgerFrameRef} x={0} y={Layout.MENU_Y} w={Layout.MENU_W} h={Layout.MENU_H}>
          <BurgerMenuFrame />
        </layer>

        <layer
          ref={searchToggleClickzoneRef}
          x={Build.SEARCH_BUTTON_X}
          y={0}
          w={Build.SEARCH_BUTTON_W}
          h={Build.SEARCH_CLICKZONE_H}
        >
          <SearchToggleClickzone />
        </layer>
        <layer
          ref={searchButtonRef}
          right={Build.MOBILE_SEARCH_RIGHT}
          y={Build.MOBILE_SEARCH_Y}
          w={Build.MOBILE_SEARCH_W}
          h={Build.MOBILE_SEARCH_H}
        >
          <MobileSearchButton />
        </layer>
        <layer
          ref={searchToggleRef}
          x={Build.SEARCH_BUTTON_X}
          y={Build.SEARCH_BUTTON_Y}
          w={Build.SEARCH_BUTTON_W}
          h={Build.SEARCH_BUTTON_H}
        >
          <SearchToggle />
        </layer>
      </layer>

      <layer ref={resizePreviewRef} x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H} hide>
        {PreviewRings.map((ring) => (
          <rect
            x="center"
            y="center"
            w={{ fill: ring * Layout.PREVIEW_INSET_STEP }}
            h={{ fill: ring * Layout.PREVIEW_INSET_STEP }}
            color={CollectionColor.RESIZE_PREVIEW}
            transparency={Layout.PREVIEW_BASE_TRANSPARENCY + ring * Layout.PREVIEW_TRANSPARENCY_STEP}
          />
        ))}
      </layer>

      <CollectionChrome />
    </>
  );
}

function CollectionFrame(): Component {
  const [tab] = useState(collectionTab);
  if (tab === -1) {
    return null;
  }
  const count: Int = useServerState(Varps.COLLECTION_COUNT);
  const max: Int = useServerState(Varps.COLLECTION_COUNT_MAX);
  const flags: Int = panelAtDefaultBox() ? BorderFlags.PLAIN : BorderFlags.RESIZABLE;
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <SteelBorder
        title={`${Copy.TITLE}${stringOf(count)}/${stringOf(max)}`}
        titleColor={CollectionColor.ORANGE}
        flags={flags}
      />
    </layer>
  );
}

enum BorderFlags {
  PLAIN = 1,
  RESIZABLE = 3,
}

function BurgerMenuFrame(): Component {
  const [tab] = useState(collectionTab);
  const [open] = useState(collectionBurgerOpen);
  if (tab === -1 || open === 0) {
    return null;
  }
  return (
    <layer x={0} y={0} w="fill" h="fill" noClickThrough>
      <BurgerMenu />
    </layer>
  );
}

function ListOutline(): Component {
  const [searchOpen] = useState(collectionSearchOpen);
  return <rect x={0} y={0} w="fill" h="fill" color={CollectionColor.OUTLINE} hide={searchOpen === 1} />;
}

function BurgerClickAway(): Component {
  const [open] = useState(collectionBurgerOpen);
  const [searchOpen] = useState(collectionSearchOpen);
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      noClickThrough
      hide={open === 0 || searchOpen === 1}
      onClick={() => closeBurgerMenu()}
    />
  );
}

const PreviewRings = [0, 1, 2, 3];
