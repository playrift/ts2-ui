import { useServerState } from 'ts2';

import { GUESS_SLOTS, HINT_SLOTS, Layout, PuzzleVarbits } from './puzzle-vikingexile.constants';
import { puzzleHintFace, puzzleSlotFace } from './puzzle-vikingexile.helpers';

export function AttemptRow({ attempt }: { attempt: Int }): Component {
  const attempts: Int = useServerState(PuzzleVarbits.ATTEMPTS);
  if (attempts !== attempt) {
    return null;
  }

  return (
    <>
      {GUESS_SLOTS.map((slot) => (
        <sprite
          x={Layout.GUESS_ART_X + Layout.GUESS_STRIDE * slot}
          y={Layout.GUESS_ART_Y}
          w={Layout.GUESS_ART}
          h={Layout.GUESS_ART}
          sprite={puzzleSlotFace(slot)}
        />
      ))}
      {HINT_SLOTS.map((hint) => (
        <sprite
          x={hint % 2 === 0 ? Layout.HINT_ART_X0 : Layout.HINT_ART_X1}
          y={hint > 1 ? Layout.HINT_ART_Y1 : Layout.HINT_ART_Y0}
          w={Layout.HINT_ART}
          h={Layout.HINT_ART}
          sprite={puzzleHintFace(hint)}
          hide={puzzleHintFace(hint) === -1 ? true : false}
        />
      ))}
    </>
  );
}
