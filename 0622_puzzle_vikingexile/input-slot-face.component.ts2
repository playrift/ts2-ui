import { Layout, Palette, PuzzleFonts, SlotFaces } from './puzzle-vikingexile.constants';
import { puzzleSlot } from './puzzle-vikingexile.helpers';

export function InputSlotFace({ slot }: { slot: Int }): Component {
  const value: Int = puzzleSlot(slot);
  const face: Sprite = SlotFaces.get(value) ?? -1;

  return (
    <>
      <sprite x="center" y="center" w={Layout.TILE} h={Layout.TILE} sprite={face} hide={face === -1 ? true : false} />
      <text
        x={0}
        y={Layout.LABEL_Y}
        w={Layout.TILE}
        h={Layout.LABEL_H}
        text="-"
        font={PuzzleFonts.TILE}
        color={Palette.LABEL}
        align="center"
        valign="middle"
        shadow
        hide={face === -1 ? false : true}
      />
    </>
  );
}
