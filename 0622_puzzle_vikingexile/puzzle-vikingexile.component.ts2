import { createRef } from 'ts2';

import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { AttemptRow } from './attempt-row.component';
import { InputSlotFace } from './input-slot-face.component';
import {
  ATTEMPT_ROWS,
  CloseSprites,
  Layout,
  Palette,
  PuzzleArt,
  PuzzleFade,
  PuzzleFonts,
  ROW_CELLS,
  TileSprites,
} from './puzzle-vikingexile.constants';

const slot1Tile = createRef('vikingexile_slot1_tile');
const slot2Tile = createRef('vikingexile_slot2_tile');
const slot3Tile = createRef('vikingexile_slot3_tile');
const slot4Tile = createRef('vikingexile_slot4_tile');
const goTile = createRef('vikingexile_go_tile');

export function PuzzleVikingExile(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          sprite={PuzzleArt.BACKDROP}
          tiling
        />

        <layer x="center" y="center" w={{ fill: Layout.CONTENT_INSET }} h={{ fill: Layout.CONTENT_INSET }}>
          <layer x="center" y={{ center: Layout.STRIP_DY }} w={Layout.STRIP_W} h={Layout.STRIP_H}>
            <rect
              x={Layout.CELL_OUT_X}
              y={Layout.CELL_OUT_Y}
              w={Layout.CELL_OUT}
              h={Layout.CELL_OUT}
              color={Palette.CELL_OUTLINE}
            />
            <layer x={0} y={0} w={Layout.PICKER_WIDE} h={Layout.PICKER_H} options={['Cycle Forward', 'Cycle Back']}>
              <layer
                x={{ center: Layout.PICKER_ONE_DX }}
                y="center"
                w={Layout.TILE}
                h={Layout.TILE}
                onMouseEnter={() => graphicSwapperUnlessMobile(slot1Tile, TileSprites.HOVER)}
                onMouseLeave={() => graphicSwapperUnlessMobile(slot1Tile, TileSprites.REST)}
              >
                <rect
                  x="center"
                  y="center"
                  w={Layout.TILE}
                  h={Layout.TILE}
                  color={Palette.SLOT_HIGHLIGHT}
                  fill
                  transparency={PuzzleFade.SLOT_HIGHLIGHT}
                  hide
                />
                <sprite
                  ref={slot1Tile}
                  x="center"
                  y="center"
                  w={Layout.TILE}
                  h={Layout.TILE}
                  sprite={TileSprites.REST}
                />
                <InputSlotFace slot={0} />
              </layer>
            </layer>

            <rect x={31} y={Layout.CELL_OUT_Y} w={Layout.CELL_OUT} h={Layout.CELL_OUT} color={Palette.CELL_OUTLINE} />
            <layer x={32} y={0} w={Layout.PICKER_NARROW} h={Layout.PICKER_H} options={['Cycle Forward', 'Cycle Back']}>
              <layer
                x="center"
                y="center"
                w={Layout.TILE}
                h={Layout.TILE}
                onMouseEnter={() => graphicSwapperUnlessMobile(slot2Tile, TileSprites.HOVER)}
                onMouseLeave={() => graphicSwapperUnlessMobile(slot2Tile, TileSprites.REST)}
              >
                <sprite
                  ref={slot2Tile}
                  x="center"
                  y="center"
                  w={Layout.TILE}
                  h={Layout.TILE}
                  sprite={TileSprites.REST}
                />
                <InputSlotFace slot={1} />
              </layer>
            </layer>

            <rect x={59} y={Layout.CELL_OUT_Y} w={Layout.CELL_OUT} h={Layout.CELL_OUT} color={Palette.CELL_OUTLINE} />
            <layer x={60} y={0} w={Layout.PICKER_NARROW} h={Layout.PICKER_H} options={['Cycle Forward', 'Cycle Back']}>
              <layer
                x="center"
                y="center"
                w={Layout.TILE}
                h={Layout.TILE}
                onMouseEnter={() => graphicSwapperUnlessMobile(slot3Tile, TileSprites.HOVER)}
                onMouseLeave={() => graphicSwapperUnlessMobile(slot3Tile, TileSprites.REST)}
              >
                <sprite
                  ref={slot3Tile}
                  x="center"
                  y="center"
                  w={Layout.TILE}
                  h={Layout.TILE}
                  sprite={TileSprites.REST}
                />
                <InputSlotFace slot={2} />
              </layer>
            </layer>

            <rect x={87} y={Layout.CELL_OUT_Y} w={Layout.CELL_OUT} h={Layout.CELL_OUT} color={Palette.CELL_OUTLINE} />
            <layer x={88} y={0} w={Layout.PICKER_NARROW} h={Layout.PICKER_H} options={['Cycle Forward', 'Cycle Back']}>
              <layer
                x="center"
                y="center"
                w={Layout.TILE}
                h={Layout.TILE}
                onMouseEnter={() => graphicSwapperUnlessMobile(slot4Tile, TileSprites.HOVER)}
                onMouseLeave={() => graphicSwapperUnlessMobile(slot4Tile, TileSprites.REST)}
              >
                <sprite
                  ref={slot4Tile}
                  x="center"
                  y="center"
                  w={Layout.TILE}
                  h={Layout.TILE}
                  sprite={TileSprites.REST}
                />
                <InputSlotFace slot={3} />
              </layer>
            </layer>

            <rect x={115} y={Layout.CELL_OUT_Y} w={Layout.CELL_OUT} h={Layout.CELL_OUT} color={Palette.CELL_OUTLINE} />
            <layer x={116} y={0} w={Layout.PICKER_WIDE} h={Layout.PICKER_H} options={['Go']}>
              <layer
                x={0}
                y="center"
                w={Layout.TILE}
                h={Layout.TILE}
                onMouseEnter={() => graphicSwapperUnlessMobile(goTile, TileSprites.HOVER)}
                onMouseLeave={() => graphicSwapperUnlessMobile(goTile, TileSprites.REST)}
              >
                <sprite ref={goTile} x="center" y="center" w={Layout.TILE} h={Layout.TILE} sprite={TileSprites.REST} />
                <text
                  x={0}
                  y={Layout.LABEL_Y}
                  w={Layout.TILE}
                  h={Layout.LABEL_H}
                  text="Go"
                  font={PuzzleFonts.TILE}
                  color={Palette.LABEL}
                  align="center"
                  valign="middle"
                  shadow
                />
              </layer>
            </layer>
          </layer>

          <layer x="center" y={{ center: Layout.GRID_DY }} w={Layout.GRID_W} h={Layout.GRID_H}>
            {ATTEMPT_ROWS.map((attempt) => (
              <HistoryRow attempt={attempt} />
            ))}
          </layer>
        </layer>

        <SteelFrameEntrypoint />
      </layer>

      <layer
        x={{ center: Layout.CLOSE_DX }}
        y={{ center: Layout.CLOSE_DY }}
        w={Layout.CLOSE_BOX}
        h={Layout.CLOSE_BOX}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_ART_X}
          y="center"
          w={Layout.CLOSE_ART_W}
          h={Layout.CLOSE_ART_H}
          sprite={CloseSprites.REST}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, CloseSprites.HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, CloseSprites.REST)}
        />
      </layer>
    </layer>
  );
}

function HistoryRow({ attempt }: { attempt: Int }): Component {
  return (
    <layer x="right" y={{ bottom: (attempt - 1) * Layout.ROW_STRIDE }} w={Layout.ROW_W} h={Layout.ROW_H}>
      {ROW_CELLS.map((cell) => (
        <rect x={cell.x} y={cell.y} w={cell.w} h={cell.h} color={Palette.CELL_OUTLINE} />
      ))}
      <AttemptRow attempt={attempt} />
    </layer>
  );
}
