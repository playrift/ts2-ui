import { useServerState } from 'ts2';

import { HintFaces, PuzzleVarbits, SlotFaces } from './puzzle-vikingexile.constants';

export function puzzleSlot(slot: Int): Int {
  if (slot === 0) {
    return useServerState(PuzzleVarbits.SLOT1);
  }
  if (slot === 1) {
    return useServerState(PuzzleVarbits.SLOT2);
  }
  if (slot === 2) {
    return useServerState(PuzzleVarbits.SLOT3);
  }
  return useServerState(PuzzleVarbits.SLOT4);
}

export function puzzleHint(hint: Int): Int {
  if (hint === 0) {
    return useServerState(PuzzleVarbits.HINT1);
  }
  if (hint === 1) {
    return useServerState(PuzzleVarbits.HINT2);
  }
  if (hint === 2) {
    return useServerState(PuzzleVarbits.HINT3);
  }
  return useServerState(PuzzleVarbits.HINT4);
}

export function puzzleSlotFace(slot: Int): Sprite {
  return SlotFaces.get(puzzleSlot(slot)) ?? -1;
}

export function puzzleHintFace(hint: Int): Sprite {
  return HintFaces.get(puzzleHint(hint)) ?? -1;
}
