import { useRef } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { CloseSprites, Layout } from './lovaquest-locks.constants';

export function CloseButton(): Component {
  const face = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={() => graphicSwapper(face, CloseSprites.LIT)}
      onMouseLeave={() => graphicSwapper(face, CloseSprites.REST)}
    >
      <sprite ref={face} x="center" y="center" w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={CloseSprites.REST} />
    </layer>
  );
}
