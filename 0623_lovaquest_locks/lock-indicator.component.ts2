import { useDerived } from 'ts2';

import { lockProgress } from './lovaquest-locks.helpers';
import { Layout, Lock, LockModel } from './lovaquest-locks.constants';

export function LockIndicator({ lock, done }: { lock: Lock; done: Int }): Component {
  const progress: Int = useDerived(() => lockProgress(lock));
  return (
    <layer w="fill" h="fill">
      <model
        x="center"
        y={{ bottom: Layout.LOCK_DY }}
        w={Layout.LOCK_W}
        h={Layout.LOCK_H}
        model={progress < done ? LockModel.LOCKED : LockModel.UNLOCKED}
        zoom={Layout.LOCK_ZOOM}
        pitch={Layout.LOCK_PITCH}
      />
    </layer>
  );
}
