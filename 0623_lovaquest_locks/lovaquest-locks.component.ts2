import { CloseButton } from './close-button.component';
import { LockIndicator } from './lock-indicator.component';
import { Layout, Lock, LockColor, LockFonts, LockModel, LockText } from './lovaquest-locks.constants';

export function LovaquestLocks(): Component {
  return (
    <layer x={0} y={0} w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <model
          x={{ center: Layout.HEADER_DX }}
          y="center"
          w={Layout.HEADER_W}
          h={Layout.HEADER_H}
          model={LockModel.HEADER}
          zoom={Layout.HEADER_ZOOM}
          pitch={Layout.HEADER_PITCH}
        />

        <CloseButton
          x={{ right: Layout.CLOSE_BOX_X }}
          y={Layout.CLOSE_BOX_Y}
          w={Layout.CLOSE_BOX_W}
          h={Layout.CLOSE_BOX_H}
        />
      </layer>

      <layer x={{ center: Layout.BODY_DX }} y="center" w={Layout.BODY_W} h={Layout.BODY_H}>
        <layer x="center" y={0} w="fill" h={Layout.TEXT_BAND_H}>
          <text
            x="center"
            y="center"
            w={{ fill: Layout.TEXT_INSET_X }}
            h={{ fill: Layout.TEXT_INSET_Y }}
            text={LockText.BODY}
            font={LockFonts.BODY}
            color={LockColor.BODY}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer x={Layout.COLUMN_1_X} y="bottom" w={Layout.COLUMN_W} h={Layout.COLUMN_H}>
          <model
            x="center"
            y={Layout.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            model={LockModel.ICON_ELECTRICITY}
            zoom={Layout.ICON_ZOOM}
            pitch={Layout.ICON_PITCH}
          />
          <LockIndicator lock={Lock.ELECTRICITY} done={4} w="fill" h="fill" />
        </layer>

        <layer x={Layout.COLUMN_2_X} y="bottom" w={Layout.COLUMN_W} h={Layout.COLUMN_H}>
          <model
            x="center"
            y={Layout.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            model={LockModel.ICON_FURNACE}
            zoom={Layout.ICON_ZOOM}
            pitch={Layout.ICON_PITCH}
          />
          <LockIndicator lock={Lock.FURNACE} done={4} w="fill" h="fill" />
        </layer>

        <layer x={{ right: Layout.COLUMN_3_X }} y="bottom" w={Layout.COLUMN_W} h={Layout.COLUMN_H}>
          <model
            x="center"
            y={Layout.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            model={LockModel.ICON_REFINERY}
            zoom={Layout.ICON_ZOOM}
            pitch={Layout.ICON_PITCH}
          />
          <LockIndicator lock={Lock.REFINERY} done={4} w="fill" h="fill" />
        </layer>

        <layer x={{ right: Layout.COLUMN_4_X }} y="bottom" w={Layout.COLUMN_W} h={Layout.COLUMN_H}>
          <model
            x="center"
            y={Layout.ICON_Y}
            w={Layout.ICON_W}
            h={Layout.ICON_H}
            model={LockModel.ICON_ALTAR}
            zoom={Layout.ICON_ZOOM}
            pitch={Layout.ICON_PITCH}
          />
          <LockIndicator lock={Lock.ALTAR} done={2} w="fill" h="fill" />
        </layer>
      </layer>
    </layer>
  );
}
