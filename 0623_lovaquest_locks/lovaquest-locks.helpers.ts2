import { useServerState } from 'ts2';

import { Lock } from './lovaquest-locks.constants';
import { Varbits } from '../lib/game/varbits';

export function lockProgress(lock: Lock): Int {
  switch (lock) {
    case Lock.ELECTRICITY:
      return useServerState(Varbits.LOVAQUEST_ELECTRICITY);
    case Lock.FURNACE:
      return useServerState(Varbits.LOVAQUEST_FURNACE);
    case Lock.REFINERY:
      return useServerState(Varbits.LOVAQUEST_REFINERY);
    case Lock.ALTAR:
      return useServerState(Varbits.LOVAQUEST_ALTAR);
  }
  return 0;
}
