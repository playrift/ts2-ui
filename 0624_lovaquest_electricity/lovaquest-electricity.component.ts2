import { closeInterface } from '../lib/lib.helpers';
import { ElectricityArt, ElectricityModels } from './lovaquest-electricity.constants';
import { PowerGrid } from './power-grid.component';

export function LovaquestElectricity(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={300}
        h={300}
        model={ElectricityModels.CONSOLE}
        zoom={ElectricityModels.CONSOLE_ZOOM}
        pitch={ElectricityModels.CONSOLE_PITCH}
      />

      <layer x="center" y="center" w={300} h={300}>
        <PowerGrid />
      </layer>

      <sprite
        right={5}
        y={5}
        w={26}
        h={23}
        sprite={ElectricityArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        hover={{ sprite: ElectricityArt.CLOSE_HOVER }}
      />
    </>
  );
}
