import { closeInterface } from '../lib/lib.helpers';
import { ScrollColors, ScrollFonts, ScrollModels, ScrollSprites } from './message-scroll.constants';

export function MessageScroll(): Component {
  return (
    <layer x="center" y="center" w={512} h={334}>
      <sprite
        right={8}
        y={6}
        w={26}
        h={23}
        sprite={ScrollSprites.CLOSE}
        hover={{ sprite: ScrollSprites.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />

      <model
        x={{ center: 9 }}
        y={{ center: -19 }}
        w={24}
        h={23}
        model={ScrollModels.BANNER}
        zoom={1119}
        pitch={490}
        yaw={513}
      />

      <text
        x={60}
        y={30}
        w={370}
        h={22}
        text="Title"
        font={ScrollFonts.BODY}
        align="center"
        valign="middle"
        shadow
        color={ScrollColors.TEXT}
      />

      <layer x={{ center: -19 }} y={{ center: 10 }} w={348} h={244}>
        <text
          x={1}
          w={343}
          h={1200}
          font={ScrollFonts.BODY}
          align="center"
          lineHeight={16}
          shadow
          color={ScrollColors.TEXT}
        />
      </layer>

      <layer right={83} y={55} w={16} h={244} />
    </layer>
  );
}
