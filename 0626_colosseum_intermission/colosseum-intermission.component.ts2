export function ColosseumIntermission(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y={{ center: -34 }} w="fill" h={{ fill: 66 }}>
        <IntermissionBorder />
      </layer>
      <layer x="center" y={39} w={499} h={{ fill: 313 }}>
        <PaneTabs />
      </layer>
      <layer x={0} y={60} w="99.993896484375%" h={{ fill: 131 }}>
        <IntermissionPanes />
      </layer>
      <layer x={0} y={0} w={512} h={264} />
      <layer ref={CONFIRM_LAYER} x={0} y={0} w="fill" h="fill" hide noClickThrough>
        <rect x={0} y={0} w="fill" h={{ fill: 70 }} fill transparency={128} />
        <layer x="center" y="center" w={350} h={150}>
          <layer x="center" y="center" w="fill" h="fill">
            <SteelBorder
              title="Are you sure you want to claim your loot?"
              titleColor={SteelborderColor.TITLE}
              flags={1}
            />
          </layer>
          <text
            ref={CONFIRM_BODY}
            x={{ center: -1 }}
            y={38}
            w={{ fill: 32 }}
            h={62}
            text=""
            font={ColosseumFonts.BODY}
            color={ColosseumColor.ORANGE}
            shadow
            align="center"
            valign="middle"
            lineHeight={15}
          />
          <layer x={{ right: 53 }} y={{ bottom: 13 }} w={90} h={30}>
            <ConfirmChoice label="Confirm" confirm />
          </layer>
          <layer x={52} y={{ bottom: 12 }} w={90} h={30}>
            <ConfirmChoice label="Cancel" confirm={false} />
          </layer>
          <layer ref={CLAIMING_LAYER} x={0} y={0} w="fill" h="fill" hide noClickThrough>
            <rect x={0} y={0} w="fill" h="fill" fill transparency={128} />
            <ClaimingRing />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}

function IntermissionBorder(): Component {
  const [wave] = useState(intermissionWave);
  const title: String = wave > 0 ? `Wave ${wave} Completed!` : 'Colosseum';
  return <SteelBorder title={title} titleColor={SteelborderColor.TITLE} flags={0} />;
}

function PaneTabs(): Component {
  const [mode] = useState(intermissionMode);
  return (
    <>
      <layer
        x={0}
        y={0}
        w="50%"
        h="fill"
        options={['View']}
        onOptionSelect={() => {
          if (mode !== 0) {
            switchIntermissionPane(0);
          }
        }}
      >
        <PaneTab label="Summary" selected={mode === 0} />
      </layer>
      <layer
        x="right"
        y={0}
        w="50%"
        h="fill"
        options={['View']}
        onOptionSelect={() => {
          if (mode !== 1) {
            switchIntermissionPane(1);
          }
        }}
      >
        <PaneTab label="Proceed" selected={mode === 1} />
      </layer>
    </>
  );
}

function PaneTab({ label, selected }: { label: String; selected: Boolean }): Component {
  const [hovered, setHovered] = useState(0);
  const face: Int = selected ? 1 : hovered === 1 ? 2 : 0;
  const cap: Sprite =
    face === 1 ? Sprites.TABS_MODAL_SHORT_0 : face === 2 ? Sprites.TABS_MODAL_SHORT_4 : Sprites.TABS_MODAL_SHORT_2;
  const middle: Sprite =
    face === 1 ? Sprites.TABS_MODAL_SHORT_1 : face === 2 ? Sprites.TABS_MODAL_SHORT_5 : Sprites.TABS_MODAL_SHORT_3;
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!selected && !onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => {
        if (!selected && !onMobile()) {
          setHovered(0);
        }
      }}
    >
      <sprite x={0} y={0} w={20} h={21} sprite={cap} />
      <sprite x={20} y={0} w={{ fill: 40 }} h={21} sprite={middle} tiling />
      <sprite x="right" y={0} w={20} h={21} sprite={cap} hflip />
      <text
        x="center"
        y={1}
        w="fill"
        h={19}
        text={label}
        font={ColosseumFonts.BODY}
        color={selected ? TabColor.SELECTED : ColosseumColor.ORANGE}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

enum TabColor {
  SELECTED = 0xffa82f,
}

