}

function SummaryScrollbar(): Component {
  const [held] = useState(intermissionHeld);
  const count: Int = intermissionHeldCount(held);
  const bar = useRef();
  const gutter = useRef();
  const thumb = useRef();
  const capTop = useRef();
  const capBottom = useRef();
  const scrollExtent: Int = SUMMARY_LIST.scrollHeight;
  const extent: Int = scrollExtent > 0 ? scrollExtent : SUMMARY_LIST.height;

  if (count > 0) {
    SUMMARY_LIST.onScrollWheel = (event) => {
      SUMMARY_LIST.scrollY = SUMMARY_LIST.scrollY + event.mouseY * WHEEL;
      trackScroll(gutter, thumb, capTop, capBottom, SUMMARY_LIST);
    };
  }

  return count > 0 ? (
    <layer ref={bar} w="fill" h="fill">
      <sprite
        ref={gutter}
        y="center"
        w="fill"
        h={{ fill: ARROW * 2 }}
        sprite={Sprites.SCROLLBAR_DRAGGER_V2_3}
        noClickThrough
        onScrollWheel={(event) => {
          SUMMARY_LIST.scrollY = SUMMARY_LIST.scrollY + event.mouseY * WHEEL;
          trackScroll(gutter, thumb, capTop, capBottom, SUMMARY_LIST);
        }}
        onClick={(event) => {
          const travel: Int = Math.max(1, gutter.height - thumb.height);
          const offset: Int = Math.clamp(0, travel, event.mouseY - thumb.height / 2);
          const range: Int = SUMMARY_LIST.scrollHeight - SUMMARY_LIST.height;
          SUMMARY_LIST.scrollY = (offset * range) / travel;
          trackScroll(gutter, thumb, capTop, capBottom, SUMMARY_LIST);
        }}
      />
      <sprite
        ref={thumb}
        y={
          ARROW +
          ((gutter.height - thumbHeightOf(bar.height, SUMMARY_LIST.height, extent, true)) * SUMMARY_LIST.scrollY) /
            Math.max(1, SUMMARY_LIST.scrollHeight - SUMMARY_LIST.height)
        }
        w="fill"
        h={thumbHeightOf(bar.height, SUMMARY_LIST.height, extent, true)}
        sprite={Sprites.SCROLLBAR_DRAGGER_V2_1}
        noClickThrough
        draggable={gutter}
        dragMoves
        onDrag={(event) => {
          const offset: Int = event.mouseY;
          thumb.y = offset + ARROW;
          capTop.y = offset + ARROW;
          capBottom.y = offset + ARROW + thumb.height - CAP;
          const travel: Int = Math.max(1, gutter.height - thumb.height);
          const range: Int = SUMMARY_LIST.scrollHeight - SUMMARY_LIST.height;
          SUMMARY_LIST.scrollY = (offset * range) / travel;
        }}
      />
      <sprite ref={capTop} y={thumb.y} w="fill" h={CAP} sprite={Sprites.SCROLLBAR_DRAGGER_V2_0} />
      <sprite
        ref={capBottom}
        y={thumb.y + thumb.height - CAP}
        w="fill"
        h={CAP}
        sprite={Sprites.SCROLLBAR_DRAGGER_V2_2}
      />
      <sprite
        y="top"
        w="fill"
        h={ARROW}
        sprite={Sprites.SCROLLBAR_V2_0}
        noClickThrough
        onHold={() => {
          SUMMARY_LIST.scrollY = SUMMARY_LIST.scrollY - STEP;
          trackScroll(gutter, thumb, capTop, capBottom, SUMMARY_LIST);
        }}
      />
      <sprite
        y="bottom"
        w="fill"
        h={ARROW}
        sprite={Sprites.SCROLLBAR_V2_1}
        noClickThrough
        onHold={() => {
          SUMMARY_LIST.scrollY = SUMMARY_LIST.scrollY + STEP;
          trackScroll(gutter, thumb, capTop, capBottom, SUMMARY_LIST);
        }}
      />
    </layer>
  ) : null;
}

function SummaryList(): Component {
  const [held] = useState(intermissionHeld);
  const count: Int = intermissionHeldCount(held);
  return (
    <>
      {count === 0 ? (
        <text
          x={{ center: 10 }}
          y={0}
          w="fill"
          h="fill"
          text="None!"
          font={ColosseumFonts.BODY}
          color={ColosseumColor.WHITE}
          shadow
          align="center"
          valign="middle"
        />
      ) : null}
      <layer x={0} y={0} w="fill" h={count * 28}>
        {ColosseumModifiers.map(
          (row, key) =>
            modifierHeld(row, held) && (
              <>
                <rect
                  x="center"
                  y={summaryRowBefore(held, key) * 28}
                  w="fill"
                  h={28}
                  fill
                  transparency={220}
                  color={summaryRowBefore(held, key) % 2 === 0 ? ColosseumColor.BLACK : ColosseumColor.WHITE}
                />
                <text
                  x="center"
                  y={summaryRowBefore(held, key) * 28}
                  w="50%"
                  h={28}
                  text={modifierTitle(row, true, true)}
                  font={ColosseumFonts.BODY}
                  color={ColosseumColor.WHITE}
                  shadow
                  align="center"
                  valign="middle"
                />
              </>
            ),
        )}
      </layer>
    </>
  );
}

function summaryRowBefore(held: Int, key: Int): Int {
  let count: Int = 0;
  let at: Int = 0;
  while (at < key) {
    const row = ColosseumModifiers.at(at);
    if (row !== null && modifierHeld(row, held)) {
      count = count + 1;
    }
    at = at + 1;
  }
  return count;
}

const DIVIDER = 0x786f64;

function GloryColumn(): Component {
  const [held] = useState(intermissionHeld);
  const [wave] = useState(intermissionWave);
  const lastWave: Int = useServerState(ColosseumVarps.LAST_WAVE_DURATION);
  const glory: Int = useServerState(ColosseumVarps.GLORY);
  const damage: Int = useServerState(ColosseumVarps.DAMAGE_TAKEN);
  const lastWaveTime: String = formatDurationMinutes(ticksToSeconds(lastWave));
  const totalTime: String = formatDurationMinutes(ticksToSeconds(useServerState(ColosseumVarps.TOTAL_DURATION)));
  const gloryText: String = glory === 2147483647 ? 'Lots!' : `${glory}`;
  const damageBonus: Int = damage <= 0 ? wave * 100 : 0;
  const waveBonus: Int = wave === 12 ? 100 * wave + 1000 : 100 * wave;
  const speedBonus: Int = lastWave > 0 && lastWave < 500 ? (500 - lastWave) * wave : 0;
  const modifierBonus: Int = heldGloryUntiered(held);

  return (
    <>
      <text
        x={0}
        y={{ bottom: 26 }}
        w="50%"
        h={20}
        text="Total Glory"
        font={ColosseumFonts.BOLD}
        color={ColosseumColor.ORANGE}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={0}
        y={{ bottom: 7 }}
        w="50%"
        h={20}
        text={gloryText}
        font={ColosseumFonts.BODY}
        color={ColosseumColor.WHITE}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="right"
        y={{ bottom: 26 }}
        w="50%"
        h={20}
        text="Total Time"
        font={ColosseumFonts.BOLD}
        color={ColosseumColor.ORANGE}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="right"
        y={{ bottom: 7 }}
        w="50%"
        h={20}
        text={totalTime}
        font={ColosseumFonts.BODY}
        color={ColosseumColor.WHITE}
        shadow
        align="center"
        valign="middle"
      />
      <GloryRow top={30} label="Wave complete: " value={`<col=0dc10d>+${waveBonus}</col>`} />
      <GloryRow top={60} label="Speed bonus: " value={`<col=0dc10d>+${speedBonus}</col> (${lastWaveTime})`} />
      <GloryRow top={90} label="Modifier choice:" value={`<col=0dc10d>+${modifierBonus}</col>`} />
      <GloryRow top={120} label="Damage Taken:" value={`<col=0dc10d>+${damageBonus}</col> (${damage})`} />
    </>
  );
}

function GloryRow({ top, label, value }: { top: Int; label: String; value: String }): Component {
  return (
    <>
      <text
        x={15}
        y={top}
        w="50%"
        h={28}
        text={label}
        font={ColosseumFonts.BODY}
        color={GLORY_LABEL}
        shadow
        align="left"
        valign="middle"
      />
      <text
        x="right"
        y={top}
        w="50%"
        h={28}
        text={value}
        font={ColosseumFonts.BODY}
        color={ColosseumColor.WHITE}
        shadow
        align="left"
        valign="middle"
      />
    </>
  );
}

const GLORY_LABEL = 0xffb83f;

function heldGloryUntiered(held: Int): Int {
  let total: Int = 0;
  let key: Int = 0;
  while (key < ColosseumModifiers.length) {
    const row = ColosseumModifiers.at(key);
    if (row !== null && modifierHeld(row, held)) {
      total = total + row.glory;
    }
    key = key + 1;
  }
  return total;
}

