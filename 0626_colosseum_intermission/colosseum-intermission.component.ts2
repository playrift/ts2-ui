function ItemBoxBacking(): Component {
  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={ColosseumSprites.BACKING_DARK} tiling />
      <ThinBoxOutline />
    </>
  );
}

function LastWaveRow(): Component {
  const items = useInventory(ColosseumInventories.LAST_WAVE);
  const stop: Int = firstEmptyLastWave();
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {items.map(
        (item, slot) =>
          slot < stop && (
            <sprite
              x={36 * slot + 5}
              y={2}
              w={36}
              h={32}
              item={item}
              itemCount={items.count(slot)}
              outline={1}
              shadowColor={ColosseumColor.ITEM_SHADOW}
              transparency={0}
              options={['Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
              onOptionSelect={(event) => flashFor(event.self, 100, 0)}
            />
          ),
      )}
    </layer>
  );
}

function firstEmptyLastWave(): Int {
  const items = useInventory(ColosseumInventories.LAST_WAVE);
  let slot: Int = 0;
  while (slot < items.size && items[slot] !== -1) {
    slot = slot + 1;
  }
  return slot;
}

function NextWaveRow(): Component {
  const items = useInventory(ColosseumInventories.NEXT_WAVE);
  return (
    <layer x={0} y={0} w="fill" h="fill">
      {items.map(
        (item, slot) =>
          item !== -1 &&
          items.count(slot) > 0 && (
            <sprite
              x={36 * slot + 5}
              y={2}
              w={36}
              h={32}
              item={item}
              itemCount={items.count(slot)}
              outline={1}
              shadowColor={ColosseumColor.ITEM_SHADOW}
              transparency={0}
              options={['Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
              onOptionSelect={(event) => flashFor(event.self, 100, 0)}
            />
          ),
      )}
    </layer>
  );
}

function LootChest(): Component {
  const [chestHover, setChestHover] = useState(intermissionChestHover);
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setChestHover(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setChestHover(0);
        }
      }}
    >
      <sprite
        x="center"
        y={{ center: chestHover === 1 ? 2 : 0 }}
        w={32}
        h={32}
        sprite={Sprites.OPTIONS_ICONS_28}
        transparency={chestHover === 1 ? 100 : 0}
      />
    </layer>
  );
}

function OfferBox({ position }: { position: Int }): Component {
  const [selected, setSelected] = useState(colosseumSelectedModifierClient);
  const [hoveredOffer, setHoveredOffer] = useState(intermissionHovered);
  const key: Int = offerKey(position);
  const row = ColosseumModifiers.at(key);
  const tier: Int = row === null ? 0 : row.tiered ? modifierTier(row) : 0;
  const title: String = row === null ? '' : modifierTitle(row, false, true);
  const icon: Sprite = row === null ? -1 : modifierIcon(row, tier + 1);
  const badge: Sprite = ModifierBadges.get(tier + 1) ?? BADGE_DEFAULT;
  const lit: Boolean = selected === position || hoveredOffer === position;

  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      optionSubject={`<col=ff9040>${title}</col>`}
      onOptionSelect={(event) => {
        if (event.option === 1) {
          if (selected === position) {
            setSelected(0);
          } else {
            setSelected(position);
            playSound(ColosseumSounds.SELECT);
          }
        }
      }}
      onMouseEnter={() => {
        if (!onMobile() && selected !== position) {
          playSound(ColosseumSounds.HOVER);
          setHoveredOffer(position);
        }
      }}
      onMouseLeave={() => {
        if (selected !== position) {
          setHoveredOffer(0);
        }
      }}
    >
      <sprite x="center" y="center" w="fill" h="fill" sprite={ColosseumSprites.BACKING_DARK} tiling />
      <rect x="center" y="center" w="fill" h="fill" fill color={ColosseumColor.WHITE} transparency={lit ? 200 : 255} />
      <ThinBoxOutline />
      <sprite x="center" y="center" w={64} h={64} sprite={badge} />
      <sprite x="center" y="center" w={64} h={64} sprite={icon} />
    </layer>
  );
}

const BADGE_DEFAULT = 5531;

function offerKey(position: Int): Int {
  if (position === 1) {
    return useServerState(ColosseumVarps.OFFER_1);
  }
  if (position === 2) {
    return useServerState(ColosseumVarps.OFFER_2);
  }
  return useServerState(ColosseumVarps.OFFER_3);
}

function OfferDescription(): Component {
  const [chestHover] = useState(intermissionChestHover);
  const [hoveredOffer] = useState(intermissionHovered);
  const [selected] = useState(colosseumSelectedModifierClient);
  const hoveredKey: Int = hoveredOffer > 0 ? offerKey(hoveredOffer) : 0;
  const showHovered: Boolean = hoveredOffer > 0 && hoveredKey !== 0;
  const shown: Int = showHovered ? hoveredOffer : selected;
  const key: Int = shown > 0 ? offerKey(shown) : 0;
  const row = ColosseumModifiers.at(key);
  const title: String = row === null ? '' : showHovered ? modifierTitle(row, false, false) : row.name;
  const description: String = row === null ? '' : modifierDescription(row);
  const glory: Int = row === null ? 0 : row.glory;

  return (
    <>
      <layer x={0} y={0} w="fill" h="fill" hide={chestHover === 1}>
        <ItemBoxBacking />
        {shown > 0 ? (
          <>
            <text
              x="center"
              y={5}
              w={{ fill: 5 }}
              h="32.99560546875%"
              text={title}
              font={ColosseumFonts.BODY}
              color={ColosseumColor.ORANGE}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x="center"
              y="center"
              w={{ fill: 5 }}
              h="32.99560546875%"
              text={description}
              font={ColosseumFonts.BODY}
              color={ColosseumColor.ORANGE}
              shadow
              align="center"
              valign="middle"
            />
            <text
              x="center"
              y={{ bottom: 5 }}
              w={{ fill: 5 }}
              h="32.99560546875%"
              text={`+${glory} Glory per wave`}
              font={ColosseumFonts.BODY}
              color={ColosseumColor.GREEN}
              shadow
              align="center"
              valign="middle"
            />
          </>
        ) : null}
      </layer>
      <layer x={0} y={0} w="fill" h="fill" hide={chestHover !== 1}>
        <ChestLoot />
      </layer>
    </>
  );
}

function ChestLoot(): Component {
  const loot = useInventory(ColosseumInventories.LOOT);
  const total: Int = useServerState(ColosseumVarps.TOTAL_VALUE);
  const stop: Int = firstEmptyLoot();
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <ItemBoxBacking />
      {loot.map(
        (item, slot) =>
          slot < stop && (
            <sprite
              x={36 * slot + 5}
              y={5}
              w={36}
              h={32}
              item={item}
              itemCount={loot.count(slot)}
              outline={1}
              shadowColor={ColosseumColor.ITEM_SHADOW}
              transparency={0}
              options={['Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
              onOptionSelect={(event) => flashFor(event.self, 100, 0)}
            />
          ),
      )}
      <text
        x="center"
        y="bottom"
        w="fill"
        h={20}
        text={`Total value: <col=ffffff>${groupDigits(total, ',')} GP</col>`}
        font={ColosseumFonts.SMALL}
        color={ColosseumColor.ORANGE}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

function firstEmptyLoot(): Int {
  const loot = useInventory(ColosseumInventories.LOOT);
  let slot: Int = 0;
  while (slot < loot.size && loot[slot] !== -1) {
    slot = slot + 1;
  }
  return slot;
}

function ContinueButton(): Component {
  const [selected] = useState(colosseumSelectedModifierClient);
  const [pressed, setPressed] = useState(0);
  const live: Boolean = selected !== 0;
  return (
    <layer
      x={{ center: 193 }}
      y={{ center: 32 }}
      w={85}
      h={34}
      options={['Continue']}
      onMouseRepeat={() => {
        if (live && !onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (live && !onMobile()) {
          setPressed(0);
        }
      }}
    >
      <ButtonFace pressed={pressed === 1} label="Continue" colour={live ? CONTINUE_LIVE : ColosseumColor.DISABLED} />
    </layer>
  );
}

const CONTINUE_LIVE = 0x00f010;
const CLAIM_CANCELLED = 0xff3232;

function ClaimButton(): Component {
  const [wave] = useState(intermissionWave);
  const [cancelled] = useState(intermissionClaimCancelled);
  const [pressed, setPressed] = useState(0);
  if (wave <= 0) {
    return <layer x={{ center: -188 }} y={{ center: 32 }} w={85} h={34} options={['Select']} />;
  }
  return (
    <layer
      x={{ center: -188 }}
      y={{ center: 32 }}
      w={85}
      h={34}
      options={['Claim']}
      onOptionSelect={() => {
        playSound(ColosseumSounds.SELECT);
        CONFIRM_LAYER.hide = false;
      }}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setPressed(0);
        }
      }}
    >
      <ButtonFace
        pressed={pressed === 1}
        label="Claim"
        colour={cancelled === 1 ? CLAIM_CANCELLED : ColosseumColor.ORANGE}
      />
    </layer>
  );
}

function ButtonFace({ pressed, label, colour }: { pressed: Boolean; label: String; colour: Int }): Component {
  return (
    <>
      {pressed ? <StoneButtonPressed /> : <StoneButton />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={ColosseumFonts.BODY}
        color={colour}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}

function ConfirmChoice({ label, confirm }: { label: String; confirm: Boolean }): Component {
  const [pressed, setPressed] = useState(0);
  const [, setCancelled] = useState(intermissionClaimCancelled);
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      options={[label]}
      optionSubject="<col=ff981f>Claim</col>"
      onOptionSelect={() => {
        playSound(ColosseumSounds.SELECT);
        if (confirm) {
          CLAIMING_LAYER.hide = false;
        } else {
          CONFIRM_LAYER.hide = true;
          setCancelled(1);
        }
      }}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setPressed(0);
        }
      }}
    >
      <ButtonFace pressed={pressed === 1} label={label} colour={ColosseumColor.WHITE} />
    </layer>
  );
}

function ClaimingRing(): Component {
  const universe = useUniverse();
  const size: Int = Math.min(universe.width, universe.height) / LoadingIcon.SIZE_DIVISOR;
  const centerX: Int = (universe.width - size) / 2;
  const centerY: Int = (universe.height - size) / 2 + RING_OFFSET_Y;
  return (
    <layer x="center" y="center" w="fill" h="fill">
      {LoadingRingItems.map((item, index) => (
        <ClaimingRingItem item={item} index={index} centerX={centerX} centerY={centerY} size={size} />
      ))}
    </layer>
  );
}

const RING_OFFSET_Y = 30;

function ClaimingRingItem({
  item,
  index,
  centerX,
  centerY,
  size,
}: {
  item: Item;
  index: Int;
  centerX: Int;
  centerY: Int;
  size: Int;
}): Component {
  const angle: Int = index * LoadingIcon.DEGREES_PER_ITEM + Math.min(index + 1, LoadingIcon.DEGREES_SPARE);
  const zoom: Int = Math.max(LoadingIcon.ZOOM_MAX - index * LoadingIcon.ZOOM_STEP, LoadingIcon.ZOOM_MIN);
  const me = useRef();

  useInterval(() => {
    const next: Int = me.zoom + LoadingIcon.ZOOM_PER_CYCLE;
    me.props = {
      offsetX: 0,
      offsetY: 0,
      pitch: LoadingIcon.PITCH,
      yaw: LoadingIcon.YAW,
      roll: LoadingIcon.ROLL,
      zoom: next > LoadingIcon.ZOOM_MAX ? LoadingIcon.ZOOM_MIN : next,
    };
  }, me);

  return (
    <model
      ref={me}
      x={centerX + scaled(CosineDegrees.at(angle) ?? 0, LoadingIcon.TRIG_UNIT, LoadingIcon.RADIUS)}
      y={centerY + scaled(SineDegrees.at(angle) ?? 0, LoadingIcon.TRIG_UNIT, LoadingIcon.RADIUS)}
      w={size}
      h={size}
      item={item}
      itemCount={LoadingIcon.STACK}
      pitch={LoadingIcon.PITCH}
      yaw={LoadingIcon.YAW}
      roll={LoadingIcon.ROLL}
      zoom={zoom}
    />
  );
}
