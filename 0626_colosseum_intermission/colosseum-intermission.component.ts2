          <SummaryScrollbar />
        </layer>
        <line x={{ center: -1 }} y={0} w={0} h={{ fill: 2 }} color={DIVIDER} lineWidth={1} />
        <layer ref={SUMMARY_LIST} x={{ right: 20 }} y={29} w={{ fill: 276 }} h={{ fill: 31 }}>
          <SummaryList />
        </layer>
        <layer x={0} y={0} w={{ fill: 257 }} h="99.993896484375%">
          <GloryColumn />
        </layer>
        <text
          x="right"
          y={0}
          w="50%"
          h={28}
          text="Active Modifiers"
          font={ColosseumFonts.BOLD}
          color={ColosseumColor.ORANGE}
          shadow
          align="center"
          valign="middle"
        />
        <text
          x={0}
          y={0}
          w="50%"
          h={28}
          text="Glory"
          font={ColosseumFonts.BOLD}
          color={ColosseumColor.ORANGE}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
      <layer ref={PROCEED_PANE} x={0} y={0} w={512} h={204}>
        <ProceedPane />
      </layer>
    </>
