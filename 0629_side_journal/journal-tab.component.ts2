import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { JournalLayout, JournalSprites } from './side-journal.constants';
import { selectJournalTab } from './side-journal.state';

export function JournalTab({
  index,
  icon,
  label,
  label2 = '',
  selected,
  transparent,
  painted,
}: {
  index: Int;
  icon: Sprite;
  label: String;
  label2?: String;
  selected: Int;
  transparent: Int;
  painted: Int;
}): Component {
  const [hovered, setHovered] = useState(0);

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[label, label2]}
        onMouseLeave={() => {
          setHovered(0);
        }}
        onOptionSelect={(event) => {
          selectJournalTab(event.option, index);
        }}
      >
        <JournalTabSkin icon={icon} selected={selected} transparent={transparent} painted={painted} hovered={0} />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label, label2]}
      onMouseRepeat={() => {
        setHovered(1);
      }}
      onMouseLeave={() => {
        setHovered(0);
      }}
      onOptionSelect={(event) => {
        selectJournalTab(event.option, index);
      }}
    >
      <JournalTabSkin icon={icon} selected={selected} transparent={transparent} painted={painted} hovered={hovered} />
    </layer>
  );
}

function JournalTabSkin({
  icon,
  selected,
  transparent,
  painted,
  hovered,
}: {
  icon: Sprite;
  selected: Int;
  transparent: Int;
  painted: Int;
  hovered: Int;
}): Component {
  if (painted === 0) {
    return (
      <layer w="fill" h="fill">
        <sprite
          x={0}
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={JournalSprites.WASH_REST_CAP}
          transparency={JournalLayout.CACHE_WASH_TRANSPARENCY}
        />
        <sprite
          x={0}
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={JournalSprites.LEGACY_SELECTED_CAP}
        />
        <sprite
          x="center"
          y="bottom"
          w={JournalLayout.MID_W}
          h={JournalLayout.MID_H}
          sprite={JournalSprites.WASH_REST_MID}
        />
        <sprite
          x="center"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={JournalSprites.LEGACY_SELECTED_MID}
        />
        <sprite
          x="right"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          hflip
          sprite={JournalSprites.WASH_REST_CAP}
        />
        <sprite
          x="right"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          hflip
          sprite={JournalSprites.LEGACY_SELECTED_CAP}
        />
        <sprite
          x="center"
          y={{ bottom: JournalLayout.ICON_BOTTOM }}
          w={JournalLayout.ICON_BOX}
          h={JournalLayout.ICON_BOX}
          sprite={icon}
        />
      </layer>
    );
  }

  if (transparent === 0) {
    return (
      <layer w="fill" h="fill">
        <sprite
          x={0}
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={JournalSprites.WASH_REST_CAP}
          transparency={JournalLayout.CACHE_WASH_TRANSPARENCY}
        />
        <sprite
          x={0}
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={legacyCap(selected, hovered)}
        />
        <sprite
          x="center"
          y="bottom"
          w={JournalLayout.MID_W}
          h={JournalLayout.MID_H}
          sprite={JournalSprites.WASH_REST_MID}
        />
        <sprite
          x="center"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={legacyMid(selected, hovered)}
        />
        <sprite
          x="right"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          hflip
          sprite={JournalSprites.WASH_REST_CAP}
        />
        <sprite
          x="right"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          hflip
          sprite={legacyCap(selected, hovered)}
        />
        <sprite
          x="center"
          y={{ bottom: JournalLayout.ICON_BOTTOM }}
          w={JournalLayout.ICON_BOX}
          h={JournalLayout.ICON_BOX}
          sprite={icon}
        />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill">
      {selected === 0 ? (
        <sprite
          x={0}
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          sprite={hovered === 1 ? JournalSprites.WASH_HOVER_CAP : JournalSprites.WASH_REST_CAP}
          transparency={JournalLayout.WASH_TRANSPARENCY}
        />
      ) : null}
      <sprite
        x={0}
        y="bottom"
        w={JournalLayout.CAP_W}
        h={JournalLayout.CAP_H}
        sprite={selected === 1 ? JournalSprites.PLATE_SELECTED_CAP : JournalSprites.PLATE_REST_CAP}
      />
      {selected === 0 ? (
        <sprite
          x="center"
          y="bottom"
          w={{ fill: JournalLayout.CAP_W * 2 }}
          h={{ fill: 3 }}
          sprite={hovered === 1 ? JournalSprites.WASH_HOVER_MID : JournalSprites.WASH_REST_MID}
          transparency={JournalLayout.WASH_TRANSPARENCY}
        />
      ) : null}
      <sprite
        x="center"
        y="bottom"
        w={JournalLayout.CAP_W}
        h={JournalLayout.CAP_H}
        sprite={selected === 1 ? JournalSprites.PLATE_SELECTED_MID : JournalSprites.PLATE_REST_MID}
      />
      {selected === 0 ? (
        <sprite
          x="right"
          y="bottom"
          w={JournalLayout.CAP_W}
          h={JournalLayout.CAP_H}
          hflip
          sprite={hovered === 1 ? JournalSprites.WASH_HOVER_CAP : JournalSprites.WASH_REST_CAP}
          transparency={JournalLayout.WASH_TRANSPARENCY}
        />
      ) : null}
      <sprite
        x="right"
        y="bottom"
        w={JournalLayout.CAP_W}
        h={JournalLayout.CAP_H}
        hflip
        sprite={selected === 1 ? JournalSprites.PLATE_SELECTED_CAP : JournalSprites.PLATE_REST_CAP}
      />
      <sprite
        x="center"
        y={{ bottom: JournalLayout.ICON_BOTTOM }}
        w={JournalLayout.ICON_BOX}
        h={JournalLayout.ICON_BOX}
        sprite={icon}
      />
    </layer>
  );
}

function legacyCap(selected: Int, hovered: Int): Sprite {
  if (selected === 1) {
    return JournalSprites.LEGACY_SELECTED_CAP;
  }
  if (hovered === 1) {
    return JournalSprites.LEGACY_HOVER_CAP;
  }
  return JournalSprites.LEGACY_REST_CAP;
}

function legacyMid(selected: Int, hovered: Int): Sprite {
  if (selected === 1) {
    return JournalSprites.LEGACY_SELECTED_MID;
  }
  if (hovered === 1) {
    return JournalSprites.LEGACY_HOVER_MID;
  }
  return JournalSprites.LEGACY_REST_MID;
}
