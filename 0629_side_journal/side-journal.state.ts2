import { predictServerState } from 'ts2';

import { FifthTab, JournalLayout, JournalTab, JournalVarbits } from './side-journal.constants';

export function selectJournalTab(op: Int, index: Int): void {
  if (op !== 1) {
    return;
  }
  predictServerState(JournalVarbits.TAB, index);
}

export function tabWidth(fifth: Int): Int {
  if (fifth === FifthTab.NONE) {
    return JournalLayout.TAB_W_THREE;
  }
  return JournalLayout.TAB_W_FOUR;
}

export function tabOffset(index: Int, fifth: Int): Int {
  if (fifth === FifthTab.NONE) {
    if (index === JournalTab.QUESTS) {
      return JournalLayout.THREE_X1;
    }
    if (index === JournalTab.DIARIES) {
      return JournalLayout.THREE_X2;
    }
    return JournalLayout.THREE_X0;
  }
  if (index === JournalTab.QUESTS) {
    return JournalLayout.FOUR_X1;
  }
  if (index === JournalTab.DIARIES) {
    return JournalLayout.FOUR_X2;
  }
  if (index === JournalTab.SUMMARY) {
    return JournalLayout.FOUR_X0;
  }
  return JournalLayout.FOUR_X3;
}

export function visibleTab(selected: Int, fifth: Int): Int {
  if (fifth === FifthTab.NONE) {
    if (selected === JournalTab.PATHS || selected === JournalTab.LEAGUES) {
      return JournalTab.SUMMARY;
    }
    return selected;
  }
  if (fifth === FifthTab.PATHS) {
    if (selected === JournalTab.LEAGUES) {
      return JournalTab.QUESTS;
    }
    return selected;
  }
  if (selected === JournalTab.PATHS) {
    return JournalTab.QUESTS;
  }
  return selected;
}
