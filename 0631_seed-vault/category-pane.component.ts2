import { useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { Bar } from './seed-vault.constants';

export function CategoryPane(): Component {
  const list = useRef();

  return (
    <layer x={0} y={0} w="27.9541%" h="fill">
      <layer x="right" y={0} w={16} h="fill">
        <ScrollbarVertical
          content={list}
          track={Bar.TRACK}
          capTopSprite={Bar.CAP_TOP}
          thumbSprite={Bar.THUMB}
          capBottomSprite={Bar.CAP_BOTTOM}
          arrowUp={Bar.ARROW_UP}
          arrowDown={Bar.ARROW_DOWN}
        />
      </layer>
      <layer ref={list} x={0} y={0} w={{ fill: 16 }} h="fill">
        <layer w="fill" h="fill" />
        <layer w="fill" h="fill" />
      </layer>
    </layer>
  );
}
