import { useRef } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { Bar, CategoryRow, Colors, Enums, Fonts } from './seed-vault.constants';

export function CategoryPane(): Component {
  const list = useRef();
  const rowHeight: Int = onMobile() ? CategoryRow.HEIGHT_MOBILE : CategoryRow.HEIGHT;

  return (
    <layer x={0} y={0} w="27.9541%" h="fill">
      <layer ref={list} x={0} y={0} w={{ fill: 16 }} h="fill">
        <layer w="fill" h="fill">
          {Enums.CATEGORY_NAMES.map((name, index) => (
            <rect
              x={0}
              y={index * rowHeight}
              w="fill"
              h={rowHeight}
              fill
              color={index % 2 === 0 ? Colors.STRIPE_EVEN : Colors.STRIPE_ODD}
              transparency={index % 2 === 0 ? CategoryRow.STRIPE_EVEN_ALPHA : CategoryRow.STRIPE_ODD_ALPHA}
            />
          ))}
        </layer>
        <layer w="fill" h="fill">
          {Enums.CATEGORY_NAMES.map((name, index) => (
            <text
              x={5}
              y={index * rowHeight}
              w={{ fill: 5 }}
              h={rowHeight}
              text={name}
              font={Fonts.CATEGORY}
              color={Colors.QTY_LABEL}
              shadow
              align="left"
              valign="middle"
              options={['Select']}
            />
          ))}
        </layer>
      </layer>
      <layer x="right" y={0} w={16} h="fill">
        <ScrollbarVertical
          content={list}
          track={Bar.TRACK}
          capTopSprite={Bar.CAP_TOP}
          thumbSprite={Bar.THUMB}
          capBottomSprite={Bar.CAP_BOTTOM}
          arrowUp={Bar.ARROW_UP}
          arrowDown={Bar.ARROW_DOWN}
        />
      </layer>
    </layer>
  );
}
