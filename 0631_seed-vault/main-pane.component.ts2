import { useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { QuantityToolbar } from './quantity-toolbar.component';
import {
  Bar,
  CategoryRow,
  Colors,
  DividerSprite,
  Enums,
  Fonts,
  HeaderFont,
  Items,
  Layout,
} from './seed-vault.constants';
import { categoryHeaderY, itemsPerRow, listScrollHeight } from './seed-vault.helpers';

export function MainPane(): Component {
  const list = useRef();
  const perRow: Int = itemsPerRow(Layout.LIST_WIDTH);

  return (
    <layer x="right" y={0} w="71.9177%" h="fill">
      <layer ref={list} x={0} y={0} w={{ fill: 16 }} h={{ fill: 40 }} scrollHeight={listScrollHeight(perRow)}>
        <layer w="fill" h="fill">
          <sprite
            x={Layout.ITEM_GAP / 2 + (Layout.ITEM_PITCH - Layout.ICON_WIDTH) / 2}
            y={categoryHeaderY(0, perRow) + CategoryRow.HEADER_HEIGHT + 2 + Layout.ITEM_INSET}
            w={Layout.ICON_WIDTH}
            h={Layout.ICON_HEIGHT}
            item={Items.FAVOURITES}
            itemCount={-1}
            transparency={120}
          />
          <text
            x={Layout.ITEM_GAP / 2}
            y={categoryHeaderY(0, perRow) + CategoryRow.HEADER_HEIGHT + 2 + Layout.ITEM_INSET + Layout.ICON_HEIGHT}
            w={Layout.ITEM_PITCH}
            h={Layout.LABEL_HEIGHT}
            text="Remove Favourites"
            font={Fonts.QTY_LABEL}
            color={Colors.QTY_LABEL}
            shadow
            align="center"
            valign="top"
          />
        </layer>
        <layer w="fill" h="fill">
          {Enums.CATEGORY_NAMES.map((name, index) => (
            <text
              x={5}
              y={categoryHeaderY(index, perRow)}
              w={{ fill: 5 }}
              h={CategoryRow.HEADER_HEIGHT}
              text={name}
              font={HeaderFont.CATEGORY}
              color={Colors.QTY_LABEL}
              shadow
              align="left"
              valign="top"
            />
          ))}
        </layer>
        <layer w="fill" h="fill">
          {Enums.CATEGORY_NAMES.map((name, index) => (
            <sprite
              x={2}
              y={categoryHeaderY(index, perRow) + CategoryRow.HEADER_HEIGHT + 2}
              w={{ fill: 4 }}
              h={2}
              sprite={DividerSprite.RULE}
              tiling
            />
          ))}
        </layer>
        <layer w="fill" h="fill" />
        <layer w="fill" h="fill" />
      </layer>
      <layer x="right" y={0} w={16} h={{ fill: 40 }}>
        <ScrollbarVertical
          content={list}
          track={Bar.TRACK}
          capTopSprite={Bar.CAP_TOP}
          thumbSprite={Bar.THUMB}
          capBottomSprite={Bar.CAP_BOTTOM}
          arrowUp={Bar.ARROW_UP}
          arrowDown={Bar.ARROW_DOWN}
        />
      </layer>
      <QuantityToolbar />
    </layer>
  );
}
