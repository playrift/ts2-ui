import { predictServerState, useRef, useServerState } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { Fonts, Varps } from './seed-vault.constants';
import { qtyColor } from './seed-vault.helpers';

export function QtyButton({ x, label, qty, op }: { x: Int; label: String; qty: Int; op: String }): Component {
  const selected = useServerState(Varps.SELECTED_QTY);
  const pressed = useRef();

  return (
    <layer
      x={x}
      y="center"
      w={30}
      h={30}
      options={[op]}
      onMouseOver={() => {
        pressed.hide = false;
      }}
      onMouseLeave={() => {
        pressed.hide = true;
      }}
      onOptionSelect={() => {
        predictServerState(Varps.SELECTED_QTY, qty);
      }}
    >
      <StoneButtonEntrypoint>
        <text
          w="fill"
          h="fill"
          text={label}
          font={Fonts.QTY_LABEL}
          color={qtyColor(qty, selected)}
          shadow
          align="center"
          valign="middle"
        />
      </StoneButtonEntrypoint>
      <layer ref={pressed} hide w="fill" h="fill">
        <StoneButtonPressedEntrypoint>
          <text
            w="fill"
            h="fill"
            text={label}
            font={Fonts.QTY_LABEL}
            color={qtyColor(qty, selected)}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonPressedEntrypoint>
      </layer>
    </layer>
  );
}
