import { useRef } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { Sprites } from './seed-vault.constants';

export function SearchButton({ x }: { x: Int }): Component {
  const pressed = useRef();

  return (
    <layer
      x={x}
      y="center"
      w={30}
      h={30}
      options={['Search']}
      onMouseEnter={() => {
        pressed.hide = false;
      }}
      onMouseLeave={() => {
        pressed.hide = true;
      }}
    >
      <sprite x="center" y="center" w={29} h={22} sprite={Sprites.SEARCH} />
      <StoneButtonEntrypoint />
      <layer ref={pressed} hide w="fill" h="fill">
        <StoneButtonPressedEntrypoint />
      </layer>
    </layer>
  );
}
