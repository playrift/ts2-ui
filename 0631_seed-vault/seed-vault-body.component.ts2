import { useRef } from 'ts2';

import { CategoryPane } from './category-pane.component';
import { MainPane } from './main-pane.component';

export function SeedVaultBody(): Component {
  const body = useRef();

  return (
    <layer ref={body} x="center" y={36} w={{ fill: 20 }} h={{ fill: 46 }}>
      <CategoryPane box={body} />
      <MainPane />
    </layer>
  );
}
