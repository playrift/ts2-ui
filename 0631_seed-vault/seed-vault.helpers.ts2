import { useServerState } from 'ts2';
import { Colors, Layout, Qty, Varbits } from './seed-vault.constants';

export function qtyColor(amount: Int, selected: Int): Int {
  if (amount === selected) {
    return Colors.QTY_SELECTED;
  }
  return Colors.QTY_LABEL;
}

export function isPresetQty(v: Int): Boolean {
  if (v === Qty.ONE || v === Qty.FIVE || v === Qty.TEN || v === Qty.ALL) {
    return true;
  }
  return false;
}

export function customQtyColor(selected: Int): Int {
  if (isPresetQty(selected)) {
    return Colors.QTY_LABEL;
  }
  return Colors.QTY_SELECTED;
}

export function itemsPerRow(listWidth: Int, gap: Int): Int {
  return listWidth / (Layout.ITEM_PITCH + gap);
}

export function categoryRows(count: Int, perRow: Int): Int {
  return 1 + (count - 1) / perRow;
}

export function favouriteRank(slot: Int): Int {
  if (useServerState(Varbits.FAVE1) === slot) {
    return 1;
  }
  if (useServerState(Varbits.FAVE2) === slot) {
    return 2;
  }
  if (useServerState(Varbits.FAVE3) === slot) {
    return 3;
  }
  if (useServerState(Varbits.FAVE4) === slot) {
    return 4;
  }
  if (useServerState(Varbits.FAVE5) === slot) {
    return 5;
  }
  if (useServerState(Varbits.FAVE6) === slot) {
    return 6;
  }
  if (useServerState(Varbits.FAVE7) === slot) {
    return 7;
  }
  if (useServerState(Varbits.FAVE8) === slot) {
    return 8;
  }
  return -1;
}

export function slotCategory(category: Int, slot: Int): Int {
  if (favouriteRank(slot) !== -1) {
    return 0;
  }
  return category;
}
