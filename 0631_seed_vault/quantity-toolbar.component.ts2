import { useRef, useServerState } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { DepositAllButton } from './deposit-all-button.component';
import { QtyButton } from './qty-button.component';
import { SearchButton } from './search-button.component';
import { Colors, Fonts, Qty, Varps } from './seed-vault.constants';
import { customQtyColor } from './seed-vault.helpers';

export function QuantityToolbar(): Component {
  const selected = useServerState(Varps.SELECTED_QTY);
  const pressedX = useRef();

  return (
    <layer x={0} y="bottom" w="fill" h={40}>
      <line x={0} y={0} w="fill" h={0} color={Colors.DIVIDER} lineWidth={1} />

      <QtyButton x={5} label="1" qty={Qty.ONE} op="Withdraw-1" />
      <QtyButton x={55} label="5" qty={Qty.FIVE} op="Withdraw-5" />
      <QtyButton x={105} label="10" qty={Qty.TEN} op="Withdraw-10" />

      <layer
        x={155}
        y="center"
        w={30}
        h={30}
        options={['*', 'Set custom quantity']}
        onMouseEnter={() => {
          pressedX.hide = false;
        }}
        onMouseLeave={() => {
          pressedX.hide = true;
        }}
      >
        <StoneButtonEntrypoint>
          <text
            w="fill"
            h="fill"
            text="X"
            font={Fonts.QTY_LABEL}
            color={customQtyColor(selected)}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonEntrypoint>
        <layer ref={pressedX} hide w="fill" h="fill">
          <StoneButtonPressedEntrypoint>
            <text
              w="fill"
              h="fill"
              text="X"
              font={Fonts.QTY_LABEL}
              color={customQtyColor(selected)}
              shadow
              align="center"
              valign="middle"
            />
          </StoneButtonPressedEntrypoint>
        </layer>
      </layer>

      <QtyButton x={205} label="All" qty={Qty.ALL} op="Withdraw-All" />

      <SearchButton x={255} />
      <DepositAllButton />
    </layer>
  );
}
