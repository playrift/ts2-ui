import { useRef, useState } from 'ts2';

import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { flashFor } from '../lib/lib.components';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { clientClock } from '../lib/lib.engine';
import {
  DepositButton,
  HallowedColors,
  HallowedToolsFonts,
  HallowedToolsSprites,
  IconFlash,
} from './hallowed-tool-side.constants';

export function DepositAllButton({ label, filled = true }: { label: String; filled?: Boolean }): Component {
  const [hovered, setHovered] = useState(0);
  const icon = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      optionSubject="<col=ff9040>All equipment</col>"
      options={[label]}
      onMouseRepeat={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => {
        flashFor(icon, IconFlash.PRESSED, IconFlash.CLEAR);
      }}
    >
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}

      <text
        x={DepositButton.LABEL_X}
        y={0}
        w={DepositButton.LABEL_W}
        h="fill"
        text={`${label} all equipment`}
        font={HallowedToolsFonts.DEPOSIT}
        color={hovered === 1 ? HallowedColors.DEPOSIT_HOVER : HallowedColors.DEPOSIT_IDLE}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        ref={icon}
        x={{ right: DepositButton.ICON_RIGHT }}
        y="center"
        w={DepositButton.ICON_W}
        h={DepositButton.ICON_H}
        sprite={filled ? HallowedToolsSprites.DEPOSIT : HallowedToolsSprites.WITHDRAW}
      />
    </layer>
  );
}
