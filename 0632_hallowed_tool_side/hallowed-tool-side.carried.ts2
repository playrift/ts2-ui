import { carriedTotal } from '../0126_farming_tools_side/carried-tools.shared';
import { HallowedItems } from './hallowed-tool-side.constants';

export function hallowedToolsGetCarried(item: Item): [Int, Item] {
  switch (item) {
    case HallowedItems.TOKEN:
      return [carriedTotal(HallowedItems.TOKEN), HallowedItems.TOKEN];
    case HallowedItems.GRAPPLE:
      return [carriedTotal(HallowedItems.GRAPPLE), HallowedItems.GRAPPLE];
    case HallowedItems.FOCUS:
      return [carriedTotal(HallowedItems.FOCUS), HallowedItems.FOCUS];
    case HallowedItems.SYMBOL:
      return [carriedTotal(HallowedItems.SYMBOL), HallowedItems.SYMBOL];
    case HallowedItems.HAMMER:
      return [carriedTotal(HallowedItems.HAMMER), HallowedItems.HAMMER];
    case HallowedItems.RING:
      return [carriedTotal(HallowedItems.RING), HallowedItems.RING];
  }
  return [0, -1];
}
