import { DepositAllButton } from './deposit-all-button.component';
import { HALLOWED_TOOLS } from './hallowed-tool-side.data';
import { DepositButton, ToolSlot } from './hallowed-tool-side.constants';
import { HallowedToolSlot } from './hallowed-tool-slot.component';

export function HallowedToolSide(): Component {
  return (
    <>
      {HALLOWED_TOOLS.map((tool, index) => (
        <layer
          x={index % 2 === 0 ? 0 : { right: 0 }}
          y={(index / 2) * ToolSlot.HEIGHT}
          w={ToolSlot.WIDTH}
          h={ToolSlot.HEIGHT}
        >
          <HallowedToolSlot item={tool.item} label={tool.label} />
        </layer>
      ))}

      <layer x={0} y="bottom" w={DepositButton.WIDTH} h={DepositButton.HEIGHT}>
        <DepositAllButton label="Deposit" />
      </layer>
    </>
  );
}
