import { GraphicBoxColor, GraphicBoxFonts, GraphicBoxLayout } from './graphicbox.constants';

export function GraphicBox(): Component {
  return (
    <>
      <layer
        x={GraphicBoxLayout.HOLDER_X}
        y={GraphicBoxLayout.HOLDER_Y}
        w={GraphicBoxLayout.HOLDER_SIZE}
        h={GraphicBoxLayout.HOLDER_SIZE}
      >
        <sprite x="center" y="center" w={GraphicBoxLayout.IMG_SIZE} h={GraphicBoxLayout.IMG_SIZE} />
      </layer>

      <text
        x={GraphicBoxLayout.TEXT_X}
        y={GraphicBoxLayout.TEXT_Y}
        w={GraphicBoxLayout.TEXT_W}
        h={GraphicBoxLayout.TEXT_H}
        font={GraphicBoxFonts.BODY}
        color={GraphicBoxColor.MESSAGE}
        align="center"
        valign="middle"
      />
    </>
  );
}
