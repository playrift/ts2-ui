import { createRef } from 'ts2';
import { GraphicBox } from './graphicbox.component';
import { GraphicBoxLayout } from './graphicbox.constants';

const graphicBoxRef = createRef('graphicbox');

export const graphicBoxUi = (): UI => (
  <ui ref={graphicBoxRef} w={GraphicBoxLayout.ROOT_W} h={GraphicBoxLayout.ROOT_H} x="center" y="center">
    <GraphicBox />
  </ui>
);
