import { sessionState } from 'ts2';

import { Fade, NO_BACKDROP, Wipe } from './overlay-portal.constants';

export const overlayPortalOpen = sessionState(0);

export const overlayPortalModel = sessionState(-1);

export const overlayPortalSheetColour = sessionState(0);

export const overlayPortalSheet = sessionState(Wipe.CLEAR);

export const overlayPortalZoom = sessionState(Wipe.START_ZOOM);

export const overlayPortalBackdropColour = sessionState(NO_BACKDROP);
export const overlayPortalBackdropTransparency = sessionState(NO_BACKDROP);

export const overlayPortalDirection = sessionState(Fade.IDLE);

export const overlayPortalStartedAt = sessionState(0);
