import { useRef } from 'ts2';

import { closeInterface } from '../lib/lib.helpers';
import { Layout, PillarArt } from './lighttemple-pillar.constants';

export function CloseButton(): Component {
  const cross = useRef();

  return (
    <layer
      x="right"
      y={0}
      w={Layout.CLOSE_BOX}
      h={Layout.CLOSE_BOX}
      options={['Close']}
      onOptionSelect={() => {
        closeInterface();
      }}
      onMouseRepeat={() => {
        cross.sprite = PillarArt.CLOSE_HOVER;
      }}
      onMouseLeave={() => {
        cross.sprite = PillarArt.CLOSE;
      }}
    >
      <sprite
        ref={cross}
        x={{ right: Layout.CLOSE_INSET_X }}
        y={Layout.CLOSE_INSET_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PillarArt.CLOSE}
      />
    </layer>
  );
}
