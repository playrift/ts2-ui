import { CloseButton } from './close-button.component';
import { MirrorButton } from './mirror-button.component';
import { Layout, MIRROR_STATES, PillarModel } from './lighttemple-pillar.constants';

export function LightTemplePillar(): Component {
  return (
    <layer x={{ center: Layout.PANEL_X }} y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <CloseButton />

      <layer x={{ center: Layout.MODEL_X }} y={{ center: Layout.MODEL_Y }} w={Layout.MODEL_W} h={Layout.MODEL_H}>
        <model
          x="center"
          y="center"
          w={PillarModel.W}
          h={PillarModel.H}
          model={PillarModel.PILLAR}
          zoom={PillarModel.ZOOM}
          pitch={PillarModel.PITCH}
        />

        <model
          x="center"
          y="center"
          w={PillarModel.W}
          h={PillarModel.H}
          model={PillarModel.ALTERNATE}
          zoom={PillarModel.ZOOM}
          pitch={PillarModel.PITCH}
          hide
        />

        {MIRROR_STATES.map((state) => (
          <layer x={{ center: state.x }} y={{ center: state.y }} w={PillarModel.BOX_W} h={PillarModel.BOX_H} hide>
            <model
              x={state.mx}
              y={state.my}
              w={state.mw}
              h={state.mh}
              model={state.model}
              zoom={state.zoom}
              pitch={state.pitch}
              yaw={state.yaw}
            />
          </layer>
        ))}
      </layer>

      <MirrorButton label="Rotate Mirror" keys="1" offsetY={Layout.ROTATE_Y} primary />

      <MirrorButton label="Remove Mirror" keys="2" offsetY={Layout.REMOVE_Y} />
    </layer>
  );
}
