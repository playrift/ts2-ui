import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, UpassBattleColor, UpassBattleDodge, UpassBattleFont } from './sote-upass-battle.constants';

const timerHost = createRef('0636_sote_upass_battle_timer_host');

const content = createRef('sote_upass_battle_content');

export function SoteUpassBattle_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, UpassBattleDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer x="center" y={Layout.BAR_Y} w={{ fill: Layout.BAR_INSET }} h={Layout.BAR_H}>
            <rect
              x={{ right: Layout.BAR_X }}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={UpassBattleColor.DAMAGE}
              fill
            />

            <rect
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={UpassBattleColor.BARRIER}
              fill
            />

            <rect
              x={Layout.OUTLINE_X}
              y={Layout.OUTLINE_Y}
              w={Layout.OUTLINE_W}
              h={Layout.OUTLINE_H}
              color={UpassBattleColor.OUTLINE}
            />

            <text
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              font={UpassBattleFont.LABEL}
              text="Barrier Strength"
              align="center"
              valign="middle"
              color={UpassBattleColor.OUTLINE}
            />
          </layer>

          <layer x="center" y={{ bottom: Layout.CLOCK_BOTTOM }} w={{ fill: Layout.BAR_INSET }} h={Layout.CLOCK_STRIP_H}>
            <text
              x={Layout.CLOCK_X}
              y={Layout.CLOCK_Y}
              w={Layout.CLOCK_W}
              h={Layout.CLOCK_H}
              font={UpassBattleFont.LABEL}
              text="Time Left: 4:00"
              valign="middle"
              shadow
              color={UpassBattleColor.CLOCK}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
