import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { GauntletColor, GauntletDodge, GauntletFont, Layout } from './gauntlet-overlay.constants';

const timerHost = createRef('0637_gauntlet_overlay_timer_host');

const content = createRef('gauntlet_overlay_content');

export function GauntletOverlay_(): Component {
  useInterval(() => overlayRelayout(timerHost, content, GauntletDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w={Layout.PLATE_W} h={Layout.PLATE_H} ref={timerHost}>
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer x="center" y={Layout.STRIP_Y} w={{ fill: Layout.STRIP_INSET }} h={Layout.STRIP_H}>
            <text
              x={Layout.CLOCK_X}
              y={Layout.CLOCK_Y}
              w={Layout.CLOCK_W}
              h={Layout.CLOCK_H}
              font={GauntletFont.CLOCK}
              text="Time Left: 10:00"
              valign="middle"
              shadow
              color={GauntletColor.CLOCK}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
