import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  GauntletArt,
  GauntletColor,
  GauntletFonts,
  GauntletModel,
  Layout,
  SlotRows,
} from './gauntlet-scoreboard.constants';

function GauntletHalf(): Component {
  return (
    <layer w="fill" h={Layout.HALF_H}>
      <text
        w={Layout.TITLE_W}
        h={Layout.LABEL_H}
        font={GauntletFonts.TITLE}
        color={GauntletColor.LABEL}
        align="center"
        shadow
        text=""
      />

      {SlotRows.map((slot) => (
        <text
          x={slot.right ? 'right' : 0}
          y={slot.y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          font={GauntletFonts.VALUE}
          color={GauntletColor.LABEL}
          align="center"
          shadow
          text=""
        />
      ))}
    </layer>
  );
}

export function GauntletScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={GauntletModel.BACKDROP}
        zoom={Camera.ZOOM}
        offsetY={Layout.MODEL_OFFSET_Y}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={GauntletArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, GauntletArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, GauntletArt.CLOSE);
        }}
      />

      <layer x="center" y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <GauntletHalf x={0} y={0} />
        <GauntletHalf x={0} y="bottom" />
      </layer>
    </>
  );
}
