          name={`Attuned ${kind} Legs`}
          ingredients={`${String(60)} ${kind} Shards, 1 Basic ${kind} Legs, ${String(1)} ${kind} Ore, ${String(1)} Phren Bark & ${String(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.at(23893) : 23893}
        />
        <GauntletRecipeRow
          y={721}
          height={Row.HEIGHT}
          name={`Perfected ${kind} Halberd`}
          ingredients={`1 Attuned ${kind} Halberd & 1 ${kind} Spike`}
          item={corrupted === 1 ? CorruptedItems.at(23897) : 23897}
