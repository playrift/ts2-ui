import { useServerState } from 'ts2';
import { ParchmentPanel } from '../lib/parchment-panel.component';
import { Varbits } from '../lib/game/varbits';
import { GauntletRecipeRow } from './recipe-row.component';
import { CorruptedItems, Row } from './gauntlet-recipes.constants';

export function GauntletRecipes(): Component {
  const corrupted: Int = useServerState(Varbits.GAUNTLET_CORRUPTED);

  const kind: String = corrupted === 1 ? 'Corrupted' : 'Crystal';
  const prefix: String = corrupted === 1 ? 'Corrupted ' : '';
  const bowstring: String = corrupted === 1 ? 'Corrupted' : 'Crystalline';

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <ParchmentPanel title="Crystal Singing Recipes" contentHeight={Row.CONTENT_HEIGHT}>
        <GauntletRecipeRow
          y={1}
          height={Row.HEIGHT}
          name={`Crystal Vial`}
          ingredients={`${stringOf(10)} ${kind} Shards`}
          item={corrupted === 1 ? CorruptedItems.get(23879) : 23879}
        />
        <GauntletRecipeRow
          y={46}
          height={Row.HEIGHT}
          name={`${prefix}Teleport Crystal`}
          ingredients={`${stringOf(40)} ${kind} Shards`}
          item={corrupted === 1 ? CorruptedItems.get(23904) : 23904}
        />
        <GauntletRecipeRow
          y={91}
          height={Row.HEIGHT}
