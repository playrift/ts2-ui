import { useServerState } from 'ts2';
import { ParchmentPanel } from '../lib/parchment-panel.component';
import { Varbits } from '../lib/game/varbits';
import { GauntletRecipeRow } from './recipe-row.component';
import { CorruptedItems, Row } from './gauntlet-recipes.constants';

export function GauntletRecipes(): Component {
  const corrupted: Int = useServerState(Varbits.GAUNTLET_CORRUPTED);

  const kind: String = corrupted === 1 ? 'Corrupted' : 'Crystal';
  const prefix: String = corrupted === 1 ? 'Corrupted ' : '';
  const bowstring: String = corrupted === 1 ? 'Corrupted' : 'Crystalline';

  return (
    <layer x="center" y="center" w="fill" h="fill">
