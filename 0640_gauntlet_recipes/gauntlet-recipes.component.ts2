          ingredients={`1 Attuned ${kind} Staff & 1 ${kind} Orb`}
          item={corrupted === 1 ? CorruptedItems.at(23900) : 23900}
        />
        <GauntletRecipeRow
          y={856}
          height={Row.HEIGHT}
          name={`Perfected ${kind} Helm`}
          ingredients={`${String(80)} ${kind} Shards, 1 Attuned ${kind} Helm, ${String(2)} ${kind} Ore, ${String(2)} Phren Bark & ${String(2)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.at(23888) : 23888}
