        />
        <GauntletRecipeRow
          y={181}
          height={Row.HEIGHT}
          name={`Basic ${kind} Halberd`}
          ingredients={`${stringOf(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.get(23895) : 23895}
        />
        <GauntletRecipeRow
          y={226}
          height={Row.HEIGHT}
          name={`Basic ${kind} Bow`}
          ingredients={`${stringOf(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.get(23901) : 23901}
        />
        <GauntletRecipeRow
          y={271}
          height={Row.HEIGHT}
          name={`Basic ${kind} Staff`}
          ingredients={`${stringOf(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.get(23898) : 23898}
        />
        <GauntletRecipeRow
          y={316}
          height={Row.HEIGHT}
          name={`Basic ${kind} Helm`}
          ingredients={`${stringOf(40)} ${kind} Shards, ${stringOf(1)} ${kind} Ore, ${stringOf(1)} Phren Bark & ${stringOf(1)} Linum Tirinum`}
