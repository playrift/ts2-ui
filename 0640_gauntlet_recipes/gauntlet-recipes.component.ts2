          y={1}
          height={Row.HEIGHT}
          name={`Crystal Vial`}
          ingredients={`${String(10)} ${kind} Shards`}
          item={corrupted === 1 ? CorruptedItems.at(23879) : 23879}
        />
        <GauntletRecipeRow
          y={46}
          height={Row.HEIGHT}
          name={`${prefix}Teleport Crystal`}
          ingredients={`${String(40)} ${kind} Shards`}
          item={corrupted === 1 ? CorruptedItems.at(23904) : 23904}
