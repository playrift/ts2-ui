        />
        <GauntletRecipeRow
          y={361}
          height={Row.HEIGHT}
          name={`Basic ${kind} Body`}
          ingredients={`${stringOf(40)} ${kind} Shards, ${stringOf(1)} ${kind} Ore, ${stringOf(1)} Phren Bark & ${stringOf(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.get(23889) : 23889}
        />
        <GauntletRecipeRow
          y={406}
          height={Row.HEIGHT}
          name={`Basic ${kind} Legs`}
          ingredients={`${stringOf(40)} ${kind} Shards, ${stringOf(1)} ${kind} Ore, ${stringOf(1)} Phren Bark & ${stringOf(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.get(23892) : 23892}
        />
        <GauntletRecipeRow
