        <GauntletRecipeRow
          y={181}
          height={Row.HEIGHT}
          name={`Basic ${kind} Halberd`}
          ingredients={`${String(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.at(23895) : 23895}
        />
        <GauntletRecipeRow
          y={226}
          height={Row.HEIGHT}
          name={`Basic ${kind} Bow`}
          ingredients={`${String(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.at(23901) : 23901}
        />
        <GauntletRecipeRow
          y={271}
          height={Row.HEIGHT}
          name={`Basic ${kind} Staff`}
          ingredients={`${String(20)} ${kind} Shards & 1 Weapon Frame`}
          item={corrupted === 1 ? CorruptedItems.at(23898) : 23898}
        />
        <GauntletRecipeRow
          y={316}
          height={Row.HEIGHT}
          name={`Basic ${kind} Helm`}
          ingredients={`${String(40)} ${kind} Shards, ${String(1)} ${kind} Ore, ${String(1)} Phren Bark & ${String(1)} Linum Tirinum`}
