          height={Row.HEIGHT}
          name={`Attuned ${kind} Staff`}
          ingredients={`${stringOf(60)} ${kind} Shards & 1 Basic ${kind} Staff`}
          item={corrupted === 1 ? CorruptedItems.get(23899) : 23899}
        />
