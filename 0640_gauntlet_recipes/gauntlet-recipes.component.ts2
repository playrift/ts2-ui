          name={`Perfected ${kind} Staff`}
          ingredients={`1 Attuned ${kind} Staff & 1 ${kind} Orb`}
          item={corrupted === 1 ? CorruptedItems.get(23900) : 23900}
        />
        <GauntletRecipeRow
          y={856}
          height={Row.HEIGHT}
          name={`Perfected ${kind} Helm`}
          ingredients={`${stringOf(80)} ${kind} Shards, 1 Attuned ${kind} Helm, ${stringOf(2)} ${kind} Ore, ${stringOf(2)} Phren Bark & ${stringOf(2)} Linum Tirinum`}
