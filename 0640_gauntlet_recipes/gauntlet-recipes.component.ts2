        <GauntletRecipeRow
          y={676}
          height={Row.HEIGHT}
          name={`Attuned ${kind} Legs`}
          ingredients={`${stringOf(60)} ${kind} Shards, 1 Basic ${kind} Legs, ${stringOf(1)} ${kind} Ore, ${stringOf(1)} Phren Bark & ${stringOf(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.get(23893) : 23893}
        />
        <GauntletRecipeRow
          y={721}
