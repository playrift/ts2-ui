        <GauntletRecipeRow
          y={361}
          height={Row.HEIGHT}
          name={`Basic ${kind} Body`}
          ingredients={`${String(40)} ${kind} Shards, ${String(1)} ${kind} Ore, ${String(1)} Phren Bark & ${String(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.at(23889) : 23889}
        />
        <GauntletRecipeRow
          y={406}
          height={Row.HEIGHT}
          name={`Basic ${kind} Legs`}
          ingredients={`${String(40)} ${kind} Shards, ${String(1)} ${kind} Ore, ${String(1)} Phren Bark & ${String(1)} Linum Tirinum`}
          item={corrupted === 1 ? CorruptedItems.at(23892) : 23892}
