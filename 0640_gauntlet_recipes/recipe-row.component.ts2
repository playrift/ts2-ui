import { GauntletColors, GauntletFonts, Row } from './gauntlet-recipes.constants';

export function GauntletRecipeRow({
  y,
  height,
  name,
  ingredients,
  item,
}: {
  y: Int;
  height: Int;
  name: String;
  ingredients: String;
  item: ItemName;
}): Component {
  return (
    <layer x={0} y={y} w="fill" h={height}>
      <sprite
        x={1}
        y="center"
        w={Row.ICON_W}
        h={Row.ICON_H}
        item={item}
        itemCount={-1}
        outline={1}
        shadowColor={GauntletColors.ICON_SHADOW}
      />

      <text
        x={Row.TEXT_X}
        y={1}
        w={Row.TEXT_W}
        h={Row.TITLE_H}
        text={name}
        align="left"
        valign="top"
        shadow
        font={GauntletFonts.TITLE}
        color={GauntletColors.LABEL}
      />

      <text
        x={Row.TEXT_X}
        y={{ bottom: 1 }}
        w={Row.TEXT_W}
        h={Row.BODY_H}
        text={ingredients}
        align="left"
        valign="top"
        shadow
        font={GauntletFonts.BODY}
        color={GauntletColors.LABEL}
      />
    </layer>
  );
}
