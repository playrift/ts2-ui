import { useInterval, useRef, useState } from 'ts2';

import { atmosphericRef, PORTAL_ANIM, PORTAL_MODEL, WASH_COLOR, Wipe } from './prif-overlay.constants';
import { prifOverlayReset, prifOverlayTick } from './prif-overlay.helpers';
import { prifWipeBuilt, prifWipeStartedAt, prifWipeWash, prifWipeZoom } from './prif-overlay.state';

export function PrifOverlay(): Component {
  return (
    <layer ref={atmosphericRef} w="fill" h="fill" x="center" y="center" onLoad={() => prifOverlayReset()}>
      <PrifWipe />
    </layer>
  );
}

function PrifWipe(): Component {
  const [built] = useState(prifWipeBuilt);
  const [zoom] = useState(prifWipeZoom);
  const [wash] = useState(prifWipeWash);
  const [startedAt] = useState(prifWipeStartedAt);
  const host = useRef();
  useInterval(() => prifOverlayTick(), host);

  return (
    <layer x="center" y="center" w="fill" h="fill" rebuildOn={built}>
      <layer ref={host} x={0} y={0} w={1} h={1} hide={startedAt < 0} />
      {built > 0 && <WipeArt zoom={zoom} wash={wash} />}
    </layer>
  );
}

function WipeArt({ zoom, wash }: { zoom: Int; wash: Int }): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={PORTAL_MODEL}
        anim={PORTAL_ANIM}
        offsetY={Wipe.MODEL_OFFSET_Y}
        zoom={zoom}
      />
      <rect x="center" y="center" w="fill" h="fill" color={WASH_COLOR} fill transparency={wash} />
    </>
  );
}
