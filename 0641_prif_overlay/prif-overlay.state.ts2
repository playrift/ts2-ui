import { sessionState } from 'ts2';

import { Fade, Wipe } from './prif-overlay.constants';

export const prifWipeBuilt = sessionState(0);

export const prifWipeZoom = sessionState(Wipe.START_ZOOM);

export const prifWipeWash = sessionState(Wipe.CLEAR);

export const prifWipeStartedAt = sessionState(-1);

export const prifWipeDirection = sessionState(Fade.IN);

export const prifWipeSteps = sessionState(0);
