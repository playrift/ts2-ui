import { useWatch } from 'ts2';

import { Varps } from '../lib/game/varps';
import {
  Art,
  Colour,
  Font,
  Layout,
  backRef,
  bannerRef,
  bodyRef,
  extraBackRef,
  extraDescriptionPanelRef,
  extraDescriptionRef,
  extraHintRef,
  extraImagePanelRef,
  extraImageRef,
  extraImageTextPanelRef,
  extraImageTextRef,
  extraLinkRef,
  extraPanelRef,
  extraTaskInfoRef,
  extraTaskNameRef,
  extraTitleRef,
  filtersRef,
  frameRef,
  pathMenuRef,
  pathRewardRef,
  pathsRef,
  rewardListRef,
  rewardsScrollbarRef,
  scrollbarPathsRef,
  scrollbarTaskRef,
  taskDescriptionRef,
  taskFocusRef,
  taskHintRef,
  taskInfoRef,
  taskListRef,
  taskNameRef,
  taskPanelRef,
  tasksDoneRef,
  tasksRef,
  toolbarRef,
} from './adventurepath.constants';
import { adventurePathInitEntrypoint, adventurePathRebuild } from './adventurepath.builders';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { stoneBorder, stoneBox, stonePanel } from './adventurepath.skins';

export function AdventurePath(): Component {
  useWatch(
    [Varps.ADVENTUREPATH_FOCUS_TRIGGER, Varps.ADVENTUREPATH_SELECTED_PATH],
    () => adventurePathRebuild(),
    pathsRef,
  );

  return (
    <>
      <layer static ref={frameRef} x={0} y={0} w="fill" h={Layout.ROOT_H} onLoad={() => adventurePathFrame()} />
      <layer
        static
        ref={bodyRef}
        x="center"
        y={{ bottom: Layout.BODY_BOTTOM }}
        w={{ fill: Layout.BODY_INSET_W }}
        h={{ fill: Layout.BODY_INSET_H }}
      >
        <layer static ref={pathMenuRef} x={0} y={0} w="fill" h={Layout.PAGE_H} hide>
          <layer
            static
            ref={pathsRef}
            x={0}
            y={0}
            w={{ fill: Layout.SCROLLBAR_W }}
            h="fill"
            onLoad={() => adventurePathInitEntrypoint()}
          />
          <layer static ref={scrollbarPathsRef} x={Layout.SCROLLBAR_X} y={0} w={Layout.SCROLLBAR_W} h="fill">
            <ScrollbarVertical
              content={pathsRef}
              track={Art.SCROLL_DRAGGER_MID}
              capTopSprite={Art.SCROLL_DRAGGER_TOP}
              thumbSprite={Art.SCROLL_DRAGGER_BOTTOM}
              capBottomSprite={Art.SCROLL_DRAGGER_BODY}
              arrowUp={Art.SCROLL_GUTTER_TOP}
              arrowDown={Art.SCROLL_GUTTER_BOTTOM}
            />
          </layer>
        </layer>

        <layer static ref={bannerRef} x={0} y={{ bottom: 0 }} w="fill" h={0} />

        <layer static ref={taskListRef} x={0} y={0} w="fill" h={Layout.PAGE_H}>
          <layer
            static
            ref={taskPanelRef}
            x={0}
            y={30}
            w={{ fill: 330 }}
            h={{ fill: 30 }}
            onLoad={() => adventurePathTaskPanel()}
          >
            <layer static ref={tasksRef} x={3} y={3} w={{ fill: 6 }} h={250} />
          </layer>
          <layer static ref={toolbarRef} x={0} y={0} w="fill" h={28} onLoad={() => adventurePathToolbar()}>
            <layer static ref={filtersRef} x={{ right: 138 }} y={0} w={32} h={28} options={['*', '*']} />
            <layer static ref={backRef} x={0} y={0} w={{ fill: 330 }} h={28} />
            <layer static ref={pathRewardRef} x={{ right: 28 }} y={0} w={110} h={28} />
            <layer static ref={tasksDoneRef} x={{ center: -10 }} y={0} w={158} h={28} />
            <layer static ref={taskFocusRef} x={{ right: 0 }} y={0} w={28} h={28} />
          </layer>
          <layer static ref={scrollbarTaskRef} x={150} y={30} w={16} h={{ fill: 30 }} />
          <layer static ref={taskInfoRef} x={167} y={30} w={{ fill: 167 }} h={256}>
            <layer static ref={taskHintRef} x="center" y={60} w={{ fill: 10 }} h={70} />
            <text
              static
              ref={taskNameRef}
              x="center"
              y={5}
              w={{ fill: 10 }}
              h={20}
              font={Font.BOLD_12}
              color={Colour.WHITE}
              shadow
              align="center"
              valign="middle"
            />
            <text
              static
              ref={taskDescriptionRef}
              x="center"
              y={25}
              w={{ fill: 10 }}
              h={35}
              font={Font.P12_FULL}
              color={Colour.WHITE}
              shadow
            />
            <layer static ref={rewardListRef} x={5} y={{ bottom: 10 }} w={{ fill: 27 }} h={110} />
            <layer static ref={rewardsScrollbarRef} x={291} y={{ bottom: 10 }} w={16} h={110} />
          </layer>
        </layer>

        <layer static ref={extraTaskInfoRef} x={0} y={0} w="fill" h={Layout.PAGE_H} hide>
          <layer static ref={extraPanelRef} x={0} y={28} w="fill" h={258} onLoad={() => adventurePathExtraPanel()}>
            <layer
              static
              ref={extraDescriptionPanelRef}
              x={0}
              y={0}
              w={{ fill: 172 }}
              h={40}
              onLoad={() => adventurePathExtraDescriptionPanel()}
            >
              <text
                static
                ref={extraDescriptionRef}
                x="center"
                y="center"
                w={{ fill: 10 }}
                h={{ fill: 10 }}
                font={Font.EXTRA_BODY}
                color={Colour.WHITE}
                shadow
                lineHeight={15}
              />
            </layer>
            <layer static ref={extraLinkRef} x={5} y={{ bottom: 2 }} w={{ fill: 185 }} h={20} />
            <layer static ref={extraHintRef} x={5} y={40} w={{ fill: 183 }} h={195} />
            <layer
              static
              ref={extraImagePanelRef}
              x={{ right: 0 }}
              y={0}
              w={175}
              h={201}
              onLoad={() => adventurePathExtraImagePanel()}
            >
              <sprite static ref={extraImageRef} x={{ right: 0 }} y={0} w="fill" h="fill" />
            </layer>
            <layer
              static
              ref={extraImageTextPanelRef}
              x={305}
              y={199}
              w={175}
              h={58}
              onLoad={() => adventurePathExtraCaptionPanel()}
            >
              <text
                static
                ref={extraImageTextRef}
                x="center"
                y="center"
                w={{ fill: 14 }}
                h={{ fill: 10 }}
                font={Font.P12_FULL}
                color={Colour.WHITE}
                shadow
                lineHeight={15}
                align="center"
                valign="middle"
              />
            </layer>
          </layer>
          <layer static ref={extraTitleRef} x={0} y={0} w="fill" h={28}>
            <text
              static
              ref={extraTaskNameRef}
              x={{ right: 0 }}
              y={0}
              w={{ fill: 150 }}
              h={28}
              font={Font.EXTRA_TITLE}
              color={Colour.WHITE}
              shadow
              lineHeight={22}
              align="center"
              valign="middle"
            />
            <layer static ref={extraBackRef} x={0} y={0} w={{ fill: 330 }} h={28} />
          </layer>
        </layer>
      </layer>
    </>
  );
}

function adventurePathFrame(frame: ComponentId = frameRef): void {
  stoneBorder(frame, 'Adventure Paths');
}

function adventurePathTaskPanel(panel: ComponentId = taskPanelRef): void {
  stonePanel(0, panel, 0);
}

function adventurePathToolbar(box: ComponentId = toolbarRef): void {
  stoneBox(box, 1, 0);
}

function adventurePathExtraPanel(panel: ComponentId = extraPanelRef): void {
  stonePanel(0, panel, 0);
}

function adventurePathExtraDescriptionPanel(panel: ComponentId = extraDescriptionPanelRef): void {
  stonePanel(0, panel, 0);
}

function adventurePathExtraImagePanel(panel: ComponentId = extraImagePanelRef): void {
  stonePanel(0, panel, 0);
}

function adventurePathExtraCaptionPanel(panel: ComponentId = extraImageTextPanelRef): void {
  stonePanel(0, panel, 0);
}
