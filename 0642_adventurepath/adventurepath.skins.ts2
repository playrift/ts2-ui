export function stonePanel(divider: Int, container: ComponentId, index: Int): Int {
  const w: Int = CS2.if_width_get(container);
  const h: Int = CS2.if_height_get(container);
  const right: Int = w - Layout.PANEL_CORNER;
  const bottom: Int = h - Layout.PANEL_CORNER;

  createGraphic(
    container,
    index,
    Art.PANEL_TOP,
    16,
    -13,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    right,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 1,
    Art.PANEL_BOTTOM,
    16,
    h - 20,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    right,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 2,
    Art.PANEL_LEFT,
    -14,
    16,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    bottom,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 3,
    Art.PANEL_RIGHT,
    w - 20,
    16,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    bottom,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 4,
    Art.PANEL_TOP_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 5,
    Art.PANEL_TOP_RIGHT,
    right,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 6,
    Art.PANEL_BOTTOM_LEFT,
    0,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 7,
    Art.PANEL_BOTTOM_RIGHT,
    right,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  if (divider < 6) {
    return index + 8;
  }
  createGraphic(
    container,
    index + 8,
    Art.PANEL_DIVIDER,
    0,
    divider - 20,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 9,
    Art.PANEL_DIVIDER_LEFT,
    0,
    divider - 18,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 10,
    Art.PANEL_DIVIDER_RIGHT,
    right,
    divider - 18,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  return index + 11;
}

export function stoneBorderFree(container: ComponentId, index: Int, w: Int, h: Int, x: Int, y: Int): Int {
  const spanW: Int = w - 64;
  const spanH: Int = h - 64;
  const right: Int = x + w - 32;
  const bottom: Int = y + h - 32;

  createGraphic(
    container,
    index,
    Art.PANEL_TOP_LEFT,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
