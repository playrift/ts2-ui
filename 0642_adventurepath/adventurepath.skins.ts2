  createGraphic(
    container,
    index + 1,
    Art.PANEL_TOP_RIGHT,
    right,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 2,
    Art.PANEL_BOTTOM_LEFT,
    x,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 3,
    Art.PANEL_BOTTOM_RIGHT,
    right,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 4,
    Art.PANEL_TOP,
    x + 32,
    y - 13,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 5,
    Art.PANEL_BOTTOM,
    x + 32,
    y + h - 20,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 6,
    Art.PANEL_LEFT,
    x - 13,
    y + 32,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 7,
    Art.PANEL_RIGHT,
    right + 12,
    y + 32,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  return index + 8;
}

export function stoneButtonFree(
  container: ComponentId,
  index: Int,
  w: Int,
  h: Int,
  x: Int,
  y: Int,
  label: String,
  colour: Int,
  hoverColour: Int,
  withOp: Int,
  pressed: Int,
): Int {
  nineSlice(container, index, w, h, x, y, pressed);

  CS2.cc_create(container, ComponentType.TEXT, index + 9, false);
  CS2.cc_size_set(w - 6, h - 6, SizeMode.ABS, SizeMode.ABS);
  CS2.cc_position_set(3 + x, 3 + y, PosMode.ABS_LEFT, PosMode.ABS_TOP);
  CS2.cc_text_set(label);
  CS2.cc_text_font_set(Font.P12_FULL);
  CS2.cc_text_shadow_set(true);
  CS2.cc_colour_set(colour);
  if (withOp !== 0) {
    CS2.cc_op_set(1, `Show task: <col=ff9040>${label}</col>`);
  }
  CS2.cc_text_align_set(TextAlign.CENTRE, TextAlign.CENTRE, 20);
  if (pressed === 0) {
    if (onMobile()) {
      CS2.cc_on_mouseover_set(() => recolour(container, index, colour));
    } else {
      CS2.cc_on_mouseover_set(() => recolour(container, index, hoverColour));
    }
    CS2.cc_on_mouseleave_set(() => recolour(container, index, colour));
  }
  return index + 10;
}

export function iconButtonFree(
  container: ComponentId,
  index: Int,
  w: Int,
  h: Int,
  x: Int,
  y: Int,
  op: String,
  icon: Sprite,
  hoverIcon: Sprite,
  insetX: Int,
  insetY: Int,
  pressed: Int,
  pressOnClick: Int,
  noHover: Int,
): Int {
  nineSlice(container, index, w, h, x, y, pressed);

  CS2.cc_create(container, ComponentType.SPRITE, index + 9, false);
  CS2.cc_size_set(w - insetX, h - insetY, SizeMode.ABS, SizeMode.ABS);
  CS2.cc_position_set(insetX / 2 + x, insetY / 2 + y, PosMode.ABS_LEFT, PosMode.ABS_TOP);
  CS2.cc_sprite_set(icon);
  CS2.cc_text_align_set(TextAlign.CENTRE, TextAlign.CENTRE, 20);
  if (pressed === 0) {
    if (pressOnClick === 1) {
      CS2.cc_onop_set(() => pressSkin(container, index, hoverIcon));
    } else {
      CS2.cc_onop_set(() => buttonSelectSound());
    }
    CS2.cc_op_set(4, op);
    if (onMobile() && noHover === 0) {
      CS2.cc_on_mouseover_set(() => raiseSkin(container, index, icon));
    } else {
      CS2.cc_on_mouseover_set(() => raiseSkin(container, index, hoverIcon));
    }
    CS2.cc_on_mouseleave_set(() => raiseSkin(container, index, icon));
  }
  return index + 10;
}

function nineSlice(container: ComponentId, index: Int, w: Int, h: Int, x: Int, y: Int, pressed: Int): void {
  const right: Int = w - Layout.STONE_CORNER + x;
  const bottom: Int = h - Layout.STONE_CORNER + y;
  const spanW: Int = w - 18;
  const spanH: Int = h - 18;

  if (pressed === 0) {
    createGraphic(
      container,
      index,
      Art.TRADEBACKING,
      x,
      y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      w,
      h,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 1,
      Art.RAISED_TOP_LEFT,
      x,
      y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 2,
      Art.RAISED_TOP_RIGHT,
      right,
      y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 3,
      Art.RAISED_BOTTOM_LEFT,
      x,
      bottom,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 4,
      Art.RAISED_BOTTOM_RIGHT,
      right,
      bottom,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 5,
      Art.RAISED_LEFT,
      x,
      9 + y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      spanH,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 6,
      Art.RAISED_TOP,
      x + 9,
      y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      spanW,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 7,
      Art.RAISED_RIGHT,
      right,
      9 + y,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      9,
      spanH,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 8,
      Art.RAISED_BOTTOM,
      x + 9,
      bottom,
      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      spanW,
      9,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    return;
  }
  createGraphic(
    container,
    index,
    Art.PRESSED_BACKDROP,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w,
    h,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 1,
    Art.PRESSED_TOP_LEFT,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 2,
    Art.PRESSED_TOP_RIGHT,
    right,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 3,
    Art.PRESSED_BOTTOM_LEFT,
    x,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 4,
    Art.PRESSED_BOTTOM_RIGHT,
    right,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 5,
    Art.PRESSED_LEFT,
    x,
    9 + y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 6,
    Art.PRESSED_TOP,
    9 + x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 7,
    Art.PRESSED_RIGHT,
    right,
    9 + y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 8,
    Art.PRESSED_BOTTOM,
    x + 9,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
}

function recolour(container: ComponentId, index: Int, colour: Int): void {
  if (CS2.cc_find(container, index + 9)) {
    CS2.cc_colour_set(colour);
  }
}

function pressSkin(container: ComponentId, index: Int, icon: Sprite): void {
  buttonSelectSound();
  swapSprite(container, index, Art.TRADEBACKING);
  swapSprite(container, index + 1, Art.PRESSED_TOP_LEFT);
  swapSprite(container, index + 2, Art.PRESSED_TOP_RIGHT);
  swapSprite(container, index + 3, Art.PRESSED_BOTTOM_LEFT);
  swapSprite(container, index + 4, Art.PRESSED_BOTTOM_RIGHT);
  swapSprite(container, index + 5, Art.PRESSED_LEFT);
  swapSprite(container, index + 6, Art.PRESSED_TOP);
  swapSprite(container, index + 7, Art.PRESSED_RIGHT);
  swapSprite(container, index + 8, Art.PRESSED_BOTTOM);
  swapSprite(container, index + 9, icon);
}

function raiseSkin(container: ComponentId, index: Int, icon: Sprite): void {
  swapSprite(container, index, Art.TRADEBACKING);
  swapSprite(container, index + 1, Art.RAISED_TOP_LEFT);
  swapSprite(container, index + 2, Art.RAISED_TOP_RIGHT);
  swapSprite(container, index + 3, Art.RAISED_BOTTOM_LEFT);
  swapSprite(container, index + 4, Art.RAISED_BOTTOM_RIGHT);
  swapSprite(container, index + 5, Art.RAISED_LEFT);
  swapSprite(container, index + 6, Art.RAISED_TOP);
  swapSprite(container, index + 7, Art.RAISED_RIGHT);
  swapSprite(container, index + 8, Art.RAISED_BOTTOM);
  swapSprite(container, index + 9, icon);
}

function buttonSelectSound(): void {
  CS2.sound_effect(2266, 1, 0);
}

export function progressBar(
  container: ComponentId,
  index: Int,
  w: Int,
  h: Int,
  x: Int,
  y: Int,
  value: Int,
  max: Int,
  asPercent: Int,
  suffix: String,
): Int {
  CS2.cc_create(container, ComponentType.RECTANGLE, index, false);
  let fill: Int = 0;
  if (value >= max) {
    fill = w - 4;
  } else {
    fill = CS2.scale(value, max, w - 4);
  }
  CS2.cc_size_set(fill, h, SizeMode.ABS, SizeMode.ABS);
  CS2.cc_position_set(2 + x, y, PosMode.ABS_LEFT, PosMode.ABS_TOP);

  const half: Int = max / 2;
  let red: Int = 0;
  let green: Int = 0;
  if (max > 0) {
    if (value <= half) {
      red = 150;
      green = CS2.interpolate(0, value, 0, half, 150);
    } else {
      red = 150 - CS2.interpolate(0, value - half, 0, half, 150);
      green = 150;
    }
  }
  CS2.cc_colour_set(rgb(red, green, 0));
  CS2.cc_fill_set(true);

  const frame: Int = index + 1;
  const right: Int = w - 9 + x;
  const bottom: Int = h - 9 + y;
  const spanW: Int = w - 18;
  const spanH: Int = h - 18;
  createGraphic(
    container,
    frame,
    Art.BAR_TOP_LEFT,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 1,
    Art.BAR_TOP_RIGHT,
    right,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 2,
    Art.BAR_BOTTOM_LEFT,
    x,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 3,
    Art.BAR_BOTTOM_RIGHT,
    right,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 4,
    Art.BAR_LEFT,
    x,
    9 + y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 5,
    Art.BAR_TOP,
    x + 9,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 6,
    Art.BAR_RIGHT,
    right,
    9 + y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    9,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    frame + 7,
    Art.BAR_BOTTOM,
    x + 9,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    9,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  CS2.cc_create(container, ComponentType.TEXT, frame + 8, false);
  CS2.cc_size_set(w, h - 3, SizeMode.ABS, SizeMode.ABS);
  CS2.cc_position_set(x, y + 3, PosMode.ABS_LEFT, PosMode.ABS_TOP);
  if (value === -1 || max === -1) {
    CS2.cc_text_set('N/A');
  } else if (value === 0 && max === 0) {
    CS2.cc_text_set('N/A');
  } else if (asPercent === 0) {
    CS2.cc_text_set(`${groupDigits(value, ',')}/${groupDigits(max, ',')}${suffix}`);
  } else {
    CS2.cc_text_set(`${stringOf(value / 10)}.${stringOf(value % 10)}/100${suffix}`);
  }
  CS2.cc_colour_set(Colour.CAPTION);
  CS2.cc_text_font_set(Font.BOLD_12);
  CS2.cc_text_shadow_set(true);
  CS2.cc_text_align_set(TextAlign.CENTRE, TextAlign.CENTRE, 0);
  return frame + 9;
}

export function buttonTileGrey(container: ComponentId, index: Int, w: Int, h: Int, x: Int, y: Int): Int {
  const corner: Int = Layout.TILE_CORNER;
  createGraphic(
    container,
    index,
    TileGrey.NW,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    false,
  );
  createGraphic(
    container,
    index + 1,
    TileGrey.NC,
    x + corner,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w - corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 2,
    TileGrey.NE,
    x + w,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    false,
  );
  createGraphic(
    container,
    index + 3,
    TileGrey.CW,
    x,
    y + corner,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    h - corner,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 4,
    TileGrey.CC,
    x + corner,
    y + corner,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w - corner,
    h - corner,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 5,
    TileGrey.CE,
    x + w,
    y + corner,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    h - corner,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 6,
    TileGrey.SW,
    x,
    y + h,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    false,
  );
  createGraphic(
    container,
    index + 7,
    TileGrey.SC,
    x + corner,
    y + h,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w - corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 8,
    TileGrey.SE,
    x + w,
    y + h,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    corner,
    corner,
    SizeMode.ABS,
    SizeMode.ABS,
    false,
  );
  return index + 9;
}

export function buttonTileToRed(container: ComponentId, index: Int): void {
  swapSprite(container, index, TileRed.NW);
  swapSprite(container, index + 1, TileRed.NC);
  swapSprite(container, index + 2, TileRed.NE);
  swapSprite(container, index + 3, TileRed.CW);
  swapSprite(container, index + 4, TileRed.CC);
  swapSprite(container, index + 5, TileRed.CE);
  swapSprite(container, index + 6, TileRed.SW);
  swapSprite(container, index + 7, TileRed.SC);
  swapSprite(container, index + 8, TileRed.SE);
}

export function buttonTileToGrey(container: ComponentId, index: Int): void {
  swapSprite(container, index, TileGrey.NW);
  swapSprite(container, index + 1, TileGrey.NC);
  swapSprite(container, index + 2, TileGrey.NE);
  swapSprite(container, index + 3, TileGrey.CW);
  swapSprite(container, index + 4, TileGrey.CC);
  swapSprite(container, index + 5, TileGrey.CE);
  swapSprite(container, index + 6, TileGrey.SW);
  swapSprite(container, index + 7, TileGrey.SC);
  swapSprite(container, index + 8, TileGrey.SE);
}
