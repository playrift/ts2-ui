import { CS2, useServerState } from 'ts2';

import { closeInterface, onMobile } from '../lib/lib.helpers';
import { groupDigits } from '../lib/lib.format';
import {
  Art,
  Colour,
  ComponentType,
  Font,
  Layout,
  PosMode,
  SizeMode,
  TextAlign,
  TileGrey,
  TileRed,
} from './adventurepath.constants';
import { rgb } from './adventurepath.helpers';

export function createGraphic(
  container: ComponentId,
  index: Int,
  sprite: Sprite,
  x: Int,
  y: Int,
  xMode: Int,
  yMode: Int,
  w: Int,
  h: Int,
  wMode: Int,
  hMode: Int,
  tiling: Boolean,
): void {
  CS2.cc_create(container, ComponentType.SPRITE, index, false);
  CS2.cc_position_set(x, y, xMode, yMode);
  CS2.cc_size_set(w, h, wMode, hMode);
  CS2.cc_sprite_set(sprite);
  CS2.cc_tiling_set(tiling);
}

export function stoneBorder(container: ComponentId, title: String): void {
  CS2.cc_all_delete(container);
  const w: Int = CS2.if_width_get(container);
  const h: Int = CS2.if_height_get(container);

  createGraphic(
    container,
    0,
    Art.TRADEBACKING,
    1,
    1,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w - 2,
    h - 2,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  CS2.cc_create(container, ComponentType.TEXT, 1, false);
  CS2.cc_position_set(6, 6, PosMode.ABS_LEFT, PosMode.ABS_TOP);
  CS2.cc_size_set(w - 12, 23, SizeMode.ABS, SizeMode.ABS);
  CS2.cc_text_align_set(TextAlign.CENTRE, TextAlign.CENTRE, 0);
  CS2.cc_colour_set(Colour.CAPTION);
  CS2.cc_text_shadow_set(true);
  CS2.cc_text_font_set(Font.BOLD_12);
  CS2.cc_text_set(title);

  const right: Int = w - Layout.BORDER_CORNER;
  const bottom: Int = h - Layout.BORDER_CORNER;
  createGraphic(
    container,
    2,
    Art.BORDER_TOP_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    3,
    Art.BORDER_TOP_RIGHT,
    right,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    4,
    Art.BORDER_BOTTOM_LEFT,
    0,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    5,
    Art.BORDER_BOTTOM_RIGHT,
    right,
    bottom,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  const spanW: Int = w - 64;
  createGraphic(
    container,
    6,
    Art.BORDER_TOP,
    32,
    -13,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    7,
    Art.BORDER_BOTTOM,
    32,
    h - 20,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    spanW,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  const spanH: Int = h - 64;
  createGraphic(
    container,
    8,
    Art.BORDER_LEFT,
    -13,
    32,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    9,
    Art.BORDER_RIGHT,
    w - 20,
    32,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    spanH,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  createGraphic(
    container,
    10,
    Art.BORDER_TAB_LEFT,
    0,
    17,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    11,
    Art.BORDER_TAB_RIGHT,
    right,
    17,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    12,
    Art.BORDER_TAB,
    11,
    15,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    w - 22,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );

  borderCloseButton(container, w);
}

function borderCloseButton(container: ComponentId, w: Int): void {
  let rest: Sprite = Art.BORDER_CLOSE;
  let hover: Sprite = Art.BORDER_CLOSE_HOVER;
  let x: Int = w - 26;
  let y: Int = 10;
  let box: Int = 16;
  if (onMobile()) {
    rest = Art.BORDER_CLOSE_MOBILE;
    hover = Art.BORDER_CLOSE_MOBILE;
    x = w - 34;
    y = 2;
    box = 32;
  }

  const index: Int = 13;
  createGraphic(
    container,
    index,
    rest,
    x,
    y,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    box,
    box,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  CS2.cc_on_mouseleave_set(() => swapSprite(container, index, rest));
  CS2.cc_on_mouseover_set(() => swapSprite(container, index, hover));
  CS2.cc_op_set(1, 'Close');
  CS2.cc_onop_set(() => closeInterface());
}

function swapSprite(container: ComponentId, index: Int, sprite: Sprite): void {
  if (CS2.cc_find(container, index)) {
    CS2.cc_sprite_set(sprite);
  }
}

export function stoneBox(container: ComponentId, style: Int, index: Int): Int {
  if (style === 1) {
