      0,
      PosMode.ABS_RIGHT,
      PosMode.ABS_TOP,
      32,
      32,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 2,
      Art.BORDER_BOTTOM_LEFT,
      0,
      0,
      PosMode.ABS_LEFT,
      PosMode.ABS_BOTTOM,
      32,
      32,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 3,
