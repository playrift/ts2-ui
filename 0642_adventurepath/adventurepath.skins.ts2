      PosMode.ABS_LEFT,
      PosMode.ABS_TOP,
      32,
      32,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 1,
      Art.BORDER_TOP_RIGHT,
