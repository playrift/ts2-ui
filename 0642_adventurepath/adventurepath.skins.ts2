      0,
      0,
      PosMode.ABS_RIGHT,
      PosMode.ABS_BOTTOM,
      32,
      32,
      SizeMode.ABS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 4,
      Art.BORDER_TOP,
      0,
      -13,
      PosMode.ABS_CENTRE,
      PosMode.ABS_TOP,
      64,
      32,
      SizeMode.MINUS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 5,
      Art.BORDER_BOTTOM,
      0,
      -12,
      PosMode.ABS_CENTRE,
      PosMode.ABS_BOTTOM,
      64,
      32,
      SizeMode.MINUS,
      SizeMode.ABS,
      true,
    );
    createGraphic(
      container,
      index + 6,
      Art.BORDER_LEFT,
      -13,
      0,
      PosMode.ABS_LEFT,
      PosMode.ABS_CENTRE,
      32,
      64,
      SizeMode.ABS,
      SizeMode.MINUS,
      true,
    );
    createGraphic(
      container,
