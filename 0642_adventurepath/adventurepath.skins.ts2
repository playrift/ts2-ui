  }
  createGraphic(
    container,
    index,
    Art.BOX_TOP_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 1,
    Art.BOX_TOP_RIGHT,
    0,
    0,
    PosMode.ABS_RIGHT,
    PosMode.ABS_TOP,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 2,
    Art.BOX_BOTTOM_LEFT,
    0,
    0,
    PosMode.ABS_LEFT,
    PosMode.ABS_BOTTOM,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 3,
    Art.BOX_BOTTOM_RIGHT,
    0,
    0,
    PosMode.ABS_RIGHT,
    PosMode.ABS_BOTTOM,
    32,
    32,
    SizeMode.ABS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 4,
    Art.BORDER_TAB,
    0,
    -14,
    PosMode.ABS_CENTRE,
    PosMode.ABS_TOP,
    64,
    32,
    SizeMode.MINUS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
    container,
    index + 5,
    Art.BORDER_TAB,
    0,
    -12,
    PosMode.ABS_CENTRE,
    PosMode.ABS_BOTTOM,
    64,
    32,
    SizeMode.MINUS,
    SizeMode.ABS,
    true,
  );
  createGraphic(
