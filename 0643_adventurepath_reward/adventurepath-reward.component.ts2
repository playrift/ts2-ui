import { Layout } from './adventurepath-reward.constants';

export function AdventurepathReward(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer
        x={Layout.BODY_X}
        y={{ center: Layout.BODY_Y }}
        w={{ fill: Layout.BODY_FILL_W }}
        h={{ fill: Layout.BODY_FILL_H }}
      >
        <layer x={0} y={0} w={Layout.HOLDER_W} h="fill" />

        <layer x="right" y={0} w={Layout.SCROLLBAR_W} h="fill" />
      </layer>
    </>
  );
}
