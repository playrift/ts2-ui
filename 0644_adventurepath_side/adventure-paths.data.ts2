export enum AdventurePathId {
  P0 = 0,
  P1 = 1,
  P2 = 2,
  P3 = 3,
  P4 = 4,
}

export type AdventurePathRow = {
  name: String;
  icon: Sprite;
};

export const AdventurePaths = mapOf<AdventurePathId, AdventurePathRow>([
  [AdventurePathId.P0, { name: 'Combat path', icon: 2550 }],
  [AdventurePathId.P1, { name: 'Gatherer path', icon: 2551 }],
  [AdventurePathId.P2, { name: 'Warrior path', icon: 2552 }],
  [AdventurePathId.P3, { name: 'Wizard path', icon: 2554 }],
  [AdventurePathId.P4, { name: 'Ranger path', icon: 2553 }],
]);

export const PathFallback = {
  name: 'You forgot to give the path a name.',
  icon: 2549,
};
