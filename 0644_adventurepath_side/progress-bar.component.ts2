import { useUniverse } from 'ts2';
import { Bar, SideColors, SideFonts, SideSprites } from './adventurepath-side.constants';
import { barColour, barFill, barLabel } from './adventurepath-side.helpers';

export function ProgressBar({ value, max, suffix }: { value: Int; max: Int; suffix: String }): Component {
  const box = useUniverse();
  const width: Int = box.width;
  const height: Int = box.height;

  return (
    <layer w="fill" h="fill">
      <rect x={Bar.FILL_X} y={0} w={barFill(value, max, width)} h={height} color={barColour(value, max)} fill />

      <sprite x={0} y={0} w={Bar.CORNER} h={Bar.CORNER} sprite={SideSprites.BAR_TL} tiling />
      <sprite x="right" y={0} w={Bar.CORNER} h={Bar.CORNER} sprite={SideSprites.BAR_TR} tiling />
      <sprite x={0} y="bottom" w={Bar.CORNER} h={Bar.CORNER} sprite={SideSprites.BAR_BL} tiling />
      <sprite x="right" y="bottom" w={Bar.CORNER} h={Bar.CORNER} sprite={SideSprites.BAR_BR} tiling />
      <sprite x={0} y={Bar.CORNER} w={Bar.CORNER} h={{ fill: Bar.CORNER * 2 }} sprite={SideSprites.BAR_LEFT} tiling />
      <sprite x={Bar.CORNER} y={0} w={{ fill: Bar.CORNER * 2 }} h={Bar.CORNER} sprite={SideSprites.BAR_TOP} tiling />
      <sprite
        x="right"
        y={Bar.CORNER}
        w={Bar.CORNER}
        h={{ fill: Bar.CORNER * 2 }}
        sprite={SideSprites.BAR_RIGHT}
        tiling
      />
      <sprite
        x={Bar.CORNER}
        y="bottom"
        w={{ fill: Bar.CORNER * 2 }}
        h={Bar.CORNER}
        sprite={SideSprites.BAR_BOTTOM}
        tiling
      />

      <text
        x={0}
        y={Bar.LABEL_TOP}
        w={width}
        h={height - Bar.LABEL_TOP}
        text={barLabel(value, max, suffix)}
        font={SideFonts.TITLE}
        shadow
        color={SideColors.GOLD}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
