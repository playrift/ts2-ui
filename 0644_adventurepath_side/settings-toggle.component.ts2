import { CS2, useDerived, useRef } from 'ts2';
import {
  Layout,
  SideColors,
  SideFonts,
  SideOps,
  SideSounds,
  SideSprites,
  Toggle,
} from './adventurepath-side.constants';
import { desktop, settingValue, toggleOn, togglePressedColour, toggleSetting } from './adventurepath-side.helpers';
import { Frame } from '../lib/frame.component';
import { StoneButton } from '../lib/stone-button.component';

export function SettingsToggle({ label, index, width }: { label: String; index: Int; width: Int }): Component {
  const up = useRef();
  const down = useRef();
  const text = useRef();
  const setting: Int = useDerived(() => settingValue(index));
  const on: Boolean = toggleOn(setting);
  const swap: Boolean = desktop();
  const pressedColour: Int = togglePressedColour();
  const top: Int = index * Toggle.STEP;

  return (
    <layer x={0} y={top} w={width} h={Toggle.HEIGHT}>
      <layer ref={up} w="fill" h="fill">
        <sprite x={0} y={0} w="fill" h="fill" sprite={Toggle.BACKING_RAISED} tiling />
        <StoneButton />
      </layer>
      <layer ref={down} w="fill" h="fill" hide>
        <sprite x={0} y={0} w="fill" h="fill" sprite={Toggle.BACKING_PRESSED} tiling />
        <Frame
          topLeft={Toggle.IN_TL}
          topRight={Toggle.IN_TR}
          bottomLeft={Toggle.IN_BL}
          bottomRight={Toggle.IN_BR}
          left={Toggle.IN_LEFT}
          top={Toggle.IN_TOP}
          right={Toggle.IN_RIGHT}
          bottom={Toggle.IN_BOTTOM}
        />
      </layer>

      <text
        ref={text}
        x={Toggle.LABEL_X}
        y={0}
        w={width - Toggle.RADIO_X}
        h={Toggle.HEIGHT}
        text={label}
        font={SideFonts.BODY}
        shadow
        color={SideColors.GOLD}
        align="center"
        valign="middle"
        lineHeight={Layout.BODY_LINE_H}
      />

      <sprite
        x={width - Toggle.RADIO_X}
        y={Toggle.RADIO_Y}
        w={Toggle.RADIO}
        h={Toggle.RADIO}
        sprite={on ? SideSprites.RADIO_ON : SideSprites.RADIO_OFF}
      />

      <rect
        x={0}
        y={0}
        w={width + Toggle.CLICK_EXTRA}
        h={Toggle.HEIGHT}
        transparency={Toggle.CLICK_FADE}
        options={[SideOps.TOGGLE]}
        onOptionSelect={() => {
          CS2.sound_effect(SideSounds.CLICK, 1, 0);
          toggleSetting(index, on);
        }}
        onMouseEnter={() => {
          text.color = pressedColour;
          up.hide = true;
          down.hide = false;
        }}
        onMouseLeave={() => {
          text.color = SideColors.GOLD;
          up.hide = false;
          down.hide = true;
        }}
      />
    </layer>
  );
}
