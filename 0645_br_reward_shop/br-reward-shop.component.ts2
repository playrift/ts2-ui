import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { RewardConfirm, RewardPoints } from './reward-footer.component';
import { RewardPane } from './reward-pane.component';
import { RewardFrame } from './br-reward-shop.constants';

export function BrRewardShop(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Justine's stuff for the Last Shopper Standing" />

      <layer
        x="center"
        y={{ bottom: RewardFrame.BODY_BOTTOM }}
        w={{ fill: RewardFrame.BODY_W_INSET }}
        h={{ fill: RewardFrame.BODY_H_INSET }}
      >
        <RewardPane />
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x="center"
        y={{ bottom: RewardFrame.FOOTER_BOTTOM }}
        w={{ fill: RewardFrame.FOOTER_W_INSET }}
        h={RewardFrame.FOOTER_H}
      >
        <RewardConfirm />
        <RewardPoints />
      </layer>
    </>
  );
}
