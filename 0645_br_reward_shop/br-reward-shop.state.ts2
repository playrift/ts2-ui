import { useState } from 'ts2';
import { chatMessage, playSound } from '../lib/lib.engine';
import { RewardSounds, SelectedReward } from './br-reward-shop.constants';

export function selectReward(index: Int): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.SELECT);
  setSelected(index);
}

export function refuseReward(message: String): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
}

export function confirmReward(): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.SELECT);
  setSelected(-1);
}
