import { sessionState, useState } from 'ts2';
import { Fonts } from '../lib/game/fonts';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';

export declare const PestRewardsFonts: {
  readonly TITLE: typeof Fonts.P12_FULL;
  readonly SUB: typeof Fonts.P11_FULL;
};

export const PestRewards = {
  DIVIDER_DARK: 0x0e0e0c,
  DIVIDER_LIGHT: 0x474745,
  DIVIDER_GAP: 8,
  LABEL: 0xff981f,
  LABEL_DISABLED: 0x7f7f7f,
  LINE_INSET: 8,
  LINE_OFFSET: -1,
};

export const ConfirmPressed = sessionState(0);

export function pressConfirm(): void {
  const [, setPressed] = useState(ConfirmPressed);
  setPressed(1);
}

export function releaseConfirm(): void {
  const [, setPressed] = useState(ConfirmPressed);
  setPressed(0);
}

export function PestRewardsDivider({ y, inset = 5 }: { y: Int; inset?: Int }): Component {
  return (
    <>
      <rect x="center" y={y} w={{ fill: inset * 2 }} h={1} fill color={PestRewards.DIVIDER_DARK} />
      <rect x="center" y={y + 1} w={{ fill: inset * 2 }} h={1} fill color={PestRewards.DIVIDER_LIGHT} />
    </>
  );
}

export function PestRewardsConfirm({ label }: { label: String }): Component {
  const [pressed] = useState(ConfirmPressed);

  return (
    <layer w="fill" h="fill">
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}

      <text
        x="center"
        y={{ center: PestRewards.LINE_OFFSET }}
        w="fill"
        h={{ fill: PestRewards.LINE_INSET }}
        text="Confirm"
        font={PestRewardsFonts.TITLE}
        color={PestRewards.LABEL}
        shadow
        align="center"
        valign="top"
      />
      <text
        x="center"
        y={{ center: PestRewards.LINE_OFFSET }}
        w="fill"
        h={{ fill: PestRewards.LINE_INSET }}
        text={label}
        font={PestRewardsFonts.SUB}
        color={PestRewards.LABEL}
        shadow
        align="center"
        valign="bottom"
      />
    </layer>
  );
}

export function PestRewardsConfirmDisabled(): Component {
  return (
    <layer w="fill" h="fill">
      <StoneButtonPressedFilled />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text="Confirm"
        font={PestRewardsFonts.TITLE}
        color={PestRewards.LABEL_DISABLED}
        shadow={false}
        align="center"
        valign="middle"
      />
    </layer>
  );
}

export function costPoints(points: Int): String {
  if (points === 1) {
    return '1 point';
  }
  return `${stringOf(points)} points`;
}
