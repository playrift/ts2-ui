import { useServerState, useState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import { PestRewardsConfirm, PestRewardsConfirmDisabled, pressConfirm, releaseConfirm } from './pest-rewards.shared';
import { confirmReward } from './br-reward-shop.state';
import {
  RewardColor,
  RewardFonts,
  RewardFrame,
  RewardLabels,
  RewardLimits,
  RewardVarps,
  SelectedReward,
} from './br-reward-shop.constants';

export function RewardPoints(): Component {
  const points: Int = useServerState(RewardVarps.POINTS);
  const wins: Int = useServerState(RewardVarps.WINS);

  return (
    <text
      x={0}
      y="center"
      w={RewardFrame.POINTS_W}
      h="fill"
      text={`Points: <col=ffffff>${groupDigits(points, ',')}</col><br>Wins: <col=ffffff>${
        wins < RewardLimits.WINS_SHOWN ? groupDigits(wins, ',') : 'Lots!'
      }</col>`}
      font={RewardFonts.NAME}
      color={RewardColor.PRICE_REST}
      shadow
      align="center"
      valign="middle"
    />
  );
}

export function RewardConfirm(): Component {
  const [selected] = useState(SelectedReward);

  return (
    <layer x="center" y="center" w={RewardFrame.CONFIRM_W} h="fill">
      <layer x="center" y="center" w="fill" h="fill">
        {selected !== -1 ? (
          <PestRewardsConfirm label={RewardLabels.at(selected) ?? 'Reward'} />
        ) : (
          <PestRewardsConfirmDisabled />
        )}
      </layer>

      {selected !== -1 ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          options={['Confirm']}
          onMouseRepeat={() => pressConfirm()}
          onMouseLeave={() => releaseConfirm()}
          onOptionSelect={() => confirmReward()}
        />
      ) : null}
    </layer>
  );
}
