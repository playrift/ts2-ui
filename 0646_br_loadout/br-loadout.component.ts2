export function BrLoadout(): Component {
  return (
    <>
      <layer static x="center" y="center" w="fill" h="fill">
        <SteelBorderEntrypoint title="Drag items in from the list to customise your load-outs" />
      </layer>

      <layer static x="center" y={40} w={{ fill: 20 }} h={21}>
        <TabStrip />
      </layer>

      <layer static x="center" y={{ bottom: 10 }} w={{ fill: 20 }} h={261}>
        <layer static ref={displayA} x="center" y="bottom" w="fill" h="fill">
          <DisplayA />
        </layer>
        <layer static ref={displayB} x="center" y="bottom" w="fill" h="fill" hide>
          <DisplayB />
        </layer>
        <layer static ref={displayC} x="center" y="bottom" w="fill" h="fill" hide>
          <DisplayC />
        </layer>
        <layer static x="center" y="bottom" w="fill" h="fill">
          <layer static x="right" y={0} w={{ fill: 316 }} h={20}>
            <SpellbookControl />
          </layer>
        </layer>
        <layer static x="center" y="bottom" w="fill" h="fill">
          <SpellbookSheet />
        </layer>
        <layer static ref={warnA} x="center" y="bottom" w="fill" h="fill">
          <layer static x="center" y="bottom" w="fill" h={16}>
            <WarningLine tab={Tab.MAX_MED} />
          </layer>
        </layer>
        <layer static ref={warnB} x="center" y="bottom" w="fill" h="fill" hide>
          <layer static x="center" y="bottom" w="fill" h={16}>
            <WarningLine tab={Tab.ZERKER} />
          </layer>
        </layer>
        <layer static ref={warnC} x="center" y="bottom" w="fill" h="fill" hide>
          <layer static x="center" y="bottom" w="fill" h={16}>
            <WarningLine tab={Tab.PURE} />
          </layer>
        </layer>
        <layer static x="center" y="bottom" w="fill" h="fill">
          <DragGhost />
        </layer>
      </layer>
    </>
  );
}

