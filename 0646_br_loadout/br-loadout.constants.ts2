import { Fonts } from '../lib/game/fonts';
import { Models } from '../lib/game/models';
import { Sounds } from '../lib/game/sounds';
import { Sprites } from '../lib/game/sprites';

export enum Tab {
  MAX_MED = 0,
  ZERKER = 1,
  PURE = 2,
}

export function tabLabel(tab: Int): String {
  if (tab === Tab.ZERKER) {
    return 'Zerker kit';
  }
  if (tab === Tab.PURE) {
    return '1 Def Pure kit';
  }
  return 'Max/Med kit';
}

