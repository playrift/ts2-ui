  }
  if (slot === 5) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_LHAND);
  }
  if (slot === 7) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_LEGS);
  }
  if (slot === 9) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_HANDS);
  }
  if (slot === 10) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_FEET);
  }
  if (slot === 12) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_RING);
  }
  if (slot === 13) {
    return useServerState(Varbits.BR_LOADOUT_A_WORN_QUIVER);
  }
  return 0;
}

export function setLoadoutWorn(tab: Int, slot: Int, key: Int): void {
  if (tab === Tab.ZERKER) {
    if (slot === 0) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_HAT, key);
      return;
    }
    if (slot === 1) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_BACK, key);
      return;
    }
    if (slot === 2) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_FRONT, key);
      return;
    }
    if (slot === 3) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_RHAND, key);
      return;
    }
    if (slot === 4) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_TORSO, key);
      return;
    }
    if (slot === 5) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_LHAND, key);
      return;
    }
    if (slot === 7) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_LEGS, key);
      return;
    }
    if (slot === 9) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_HANDS, key);
      return;
    }
    if (slot === 10) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_FEET, key);
      return;
    }
    if (slot === 12) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_RING, key);
      return;
    }
    if (slot === 13) {
      predictServerState(Varbits.BR_LOADOUT_B_WORN_QUIVER, key);
      return;
    }
    return;
  }
  if (tab === Tab.PURE) {
    if (slot === 0) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_HAT, key);
      return;
    }
    if (slot === 1) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_BACK, key);
      return;
    }
    if (slot === 2) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_FRONT, key);
      return;
    }
    if (slot === 3) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_RHAND, key);
      return;
    }
    if (slot === 4) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_TORSO, key);
      return;
    }
    if (slot === 5) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_LHAND, key);
      return;
    }
    if (slot === 7) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_LEGS, key);
      return;
    }
    if (slot === 9) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_HANDS, key);
      return;
    }
    if (slot === 10) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_FEET, key);
      return;
    }
    if (slot === 12) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_RING, key);
      return;
    }
    if (slot === 13) {
      predictServerState(Varbits.BR_LOADOUT_C_WORN_QUIVER, key);
      return;
    }
    return;
  }
  if (slot === 0) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_HAT, key);
    return;
  }
  if (slot === 1) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_BACK, key);
    return;
  }
  if (slot === 2) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_FRONT, key);
    return;
  }
  if (slot === 3) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_RHAND, key);
    return;
  }
  if (slot === 4) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_TORSO, key);
    return;
  }
  if (slot === 5) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_LHAND, key);
    return;
  }
  if (slot === 7) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_LEGS, key);
    return;
  }
  if (slot === 9) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_HANDS, key);
    return;
  }
  if (slot === 10) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_FEET, key);
    return;
  }
  if (slot === 12) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_RING, key);
    return;
  }
  if (slot === 13) {
    predictServerState(Varbits.BR_LOADOUT_A_WORN_QUIVER, key);
    return;
  }
}

export function spellbookOf(tab: Int): Int {
  if (tab === Tab.ZERKER) {
    return useServerState(Varbits.BR_LOADOUT_B_SPELLBOOK);
  }
  if (tab === Tab.PURE) {
    return useServerState(Varbits.BR_LOADOUT_C_SPELLBOOK);
  }
  return useServerState(Varbits.BR_LOADOUT_A_SPELLBOOK);
}

export function spellbookOfClamped(tab: Int): Int {
  const stored: Int = spellbookOf(tab);
  if (tab === Tab.PURE && (SpellbookOrder.at(stored) ?? -1) === 2) {
    return 1;
  }
  return stored;
}

export function setLoadoutSpellbook(tab: Int, menu: Int): void {
  const last: Int = SpellbookOrder.length - 1;
  const capped: Int = menu > last ? last : menu;
  let chosen: Int = capped < 0 ? 0 : capped;
  if (tab === Tab.PURE && (SpellbookOrder.at(chosen) ?? -1) === 2) {
    chosen = 1;
  }
  if (tab === Tab.ZERKER) {
    predictServerState(Varbits.BR_LOADOUT_B_SPELLBOOK, chosen);
    return;
  }
  if (tab === Tab.PURE) {
    predictServerState(Varbits.BR_LOADOUT_C_SPELLBOOK, chosen);
    return;
  }
  predictServerState(Varbits.BR_LOADOUT_A_SPELLBOOK, chosen);
}

export function spellbookName(menu: Int): String {
  const book: Int = SpellbookOrder.at(menu) ?? -1;
  return SpellbookNames.get(book) ?? SPELLBOOK_DEFAULT_NAME;
}

export function itemOf(tab: Int, key: Int): Item {
  const base: Int = tab === Tab.ZERKER ? TAB_BASE_ZERKER : tab === Tab.PURE ? TAB_BASE_PURE : TAB_BASE_MAX_MED;
  const row: LoadoutItemRow | null = LoadoutItems.at(base + key);
  return row === null ? -1 : row.item;
}

export function slotInfo(item: Item): Int {
  return param(item, Params.LOADOUT_ITEMINFO);
}

export function stackCap(item: Item): Int {
  return StackCaps.get(item) ?? STACK_CAP_DEFAULT;
}

export function ellipsised(text: String, width: Int, font: Font): String {
  let out: String = text;
  let cut: Int = out.length;
  if (cut <= 0) {
    out = '-';
    cut = 1;
  }
  if (cut > 0 && CS2.parawidth(out, Row.MEASURE_W, font) > width) {
    let done: Int = 0;
    while (cut > 1 && done === 0) {
      cut = cut - 1;
      const candidate: String = `${out.substring(0, cut)}...`;
      if (CS2.parawidth(candidate, Row.MEASURE_W, font) <= width) {
        out = candidate;
        done = 1;
      }
    }
  }
  return out;
}

export function itemOpBase(item: Item): String {
  return `<col=ff9040>${itemName(item)}</col>`;
}
