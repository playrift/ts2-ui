import { CS2, sessionState, useState } from 'ts2';
import { clientClock } from '../lib/lib.engine';
import { LoadoutSounds, Row, Tab } from './br-loadout.constants';
import { setLoadoutSpellbook } from './br-loadout.helpers';

export const selectedTab = sessionState(Tab.MAX_MED);

export const openDropdown = sessionState(-1);

export const spellbookCloseAfter = sessionState(-1);

export function openSpellbook(tab: Int): void {
  const [, setOpen] = useState(openDropdown);
  const [, setCloseAfter] = useState(spellbookCloseAfter);
  CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
  setCloseAfter(clientClock() + 10);
  setOpen(tab);
}

export function releaseSpellbook(): void {
  const [open, setOpen] = useState(openDropdown);
  const [closeAfter] = useState(spellbookCloseAfter);
  if (clientClock() < closeAfter) {
    return;
  }
  if (open >= 0) {
    CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
  }
  setOpen(-1);
}

export function selectSpellbook(menu: Int): void {
  const [open, setOpen] = useState(openDropdown);
  setLoadoutSpellbook(open, menu);
  CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
  setOpen(-1);
}

export const ghostTab = sessionState(-1);
export const ghostKey = sessionState(0);
export const ghostX = sessionState(0);
export const ghostY = sessionState(0);
export const ghostTextW = sessionState(0);
export const ghostLabelW = sessionState(100);

export function showDragGhost(tab: Int, key: Int, textW: Int, mouseX: Int, mouseY: Int): void {
  const [, setTab] = useState(ghostTab);
  const [, setKey] = useState(ghostKey);
  const [, setX] = useState(ghostX);
  const [, setY] = useState(ghostY);
  const [, setTextW] = useState(ghostTextW);
  const [labelW, setLabelW] = useState(ghostLabelW);
  setKey(key);
  setX(mouseX);
  setY(mouseY);
  setTextW(textW);
  setLabelW(labelW - Row.LABEL_INSET);
  setTab(tab);
}

export function hideDragGhost(): void {
  const [, setTab] = useState(ghostTab);
  setTab(-1);
}
