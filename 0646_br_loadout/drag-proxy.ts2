import { CS2, useState } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { LoadoutColor, LoadoutFonts, Row, Wash } from './br-loadout.constants';
import { ellipsised, itemOf } from './br-loadout.helpers';
import { ghostKey, ghostLabelW, ghostTab, ghostTextW, ghostX, ghostY } from './br-loadout.state';

export function DragGhost(): Component {
  const [tab] = useState(ghostTab);
  const [key] = useState(ghostKey);
  const [x] = useState(ghostX);
  const [y] = useState(ghostY);
  const [labelW] = useState(ghostLabelW);
  const [textW] = useState(ghostTextW);
  const item: Item = itemOf(tab < 0 ? 0 : tab, key);
  let stacks: Boolean = false;
  let text: String = '';
  if (tab >= 0 && item !== -1) {
    stacks = CS2.item_stackable(item);
    text = ellipsised(itemName(item), textW, LoadoutFonts.BODY);
  }
  return (
    <layer w="fill" h="fill" hide={tab < 0}>
      <sprite
        x={x + Row.PAD}
        y={y + Row.ITEM_INSET}
        w={Row.ITEM_W}
        h={Row.ITEM_H}
        hide={!stacks}
        item={item}
        itemCount={5000}
        outline={1}
        shadowColor={LoadoutColor.ITEM_SHADOW}
        transparency={Wash.PROXY}
      />
      <sprite
        x={x + Row.PAD}
        y={y + Row.ITEM_INSET}
        w={Row.ITEM_W}
        h={Row.ITEM_H}
        hide={stacks}
        item={item}
        itemCount={1}
        itemCountMode="never"
        outline={1}
        shadowColor={LoadoutColor.ITEM_SHADOW}
        transparency={Wash.PROXY}
      />
      <text
        x={x + Row.PAD + Row.ITEM_W + 2}
        y={y}
        w={labelW}
        h={Row.HEIGHT}
        color={LoadoutColor.LABEL}
        font={LoadoutFonts.BODY}
        shadow
        align="left"
        valign="middle"
        text={text}
      />
    </layer>
  );
}
