import { CS2, onMounted, onUpdated, useState } from 'ts2';
import { LoadoutColor, LoadoutFonts, LoadoutSounds, LoadoutSprites, Tab, tabLabel } from './br-loadout.constants';
import { displayA, displayB, displayC, warnA, warnB, warnC } from './br-loadout.refs';
import { selectedTab } from './br-loadout.state';

export function TabStrip(): Component {
  const [shown, setShown] = useState(selectedTab);
  const [hoverA, setHoverA] = useState(0);
  const [hoverB, setHoverB] = useState(0);
  const [hoverC, setHoverC] = useState(0);

  const onA: Boolean = shown === Tab.MAX_MED;
  const onB: Boolean = shown === Tab.ZERKER;
  const onC: Boolean = shown === Tab.PURE;
  const showA: Boolean = !onB && !onC;

  const endA: Sprite =
    hoverA === 1 ? LoadoutSprites.TAB_END_HOVER : showA ? LoadoutSprites.TAB_END_ON : LoadoutSprites.TAB_END_OFF;
  const midA: Sprite =
    hoverA === 1 ? LoadoutSprites.TAB_MID_HOVER : showA ? LoadoutSprites.TAB_MID_ON : LoadoutSprites.TAB_MID_OFF;
  const endB: Sprite =
    hoverB === 1 ? LoadoutSprites.TAB_END_HOVER : onB ? LoadoutSprites.TAB_END_ON : LoadoutSprites.TAB_END_OFF;
  const midB: Sprite =
    hoverB === 1 ? LoadoutSprites.TAB_MID_HOVER : onB ? LoadoutSprites.TAB_MID_ON : LoadoutSprites.TAB_MID_OFF;
  const endC: Sprite =
    hoverC === 1 ? LoadoutSprites.TAB_END_HOVER : onC ? LoadoutSprites.TAB_END_ON : LoadoutSprites.TAB_END_OFF;
  const midC: Sprite =
    hoverC === 1 ? LoadoutSprites.TAB_MID_HOVER : onC ? LoadoutSprites.TAB_MID_ON : LoadoutSprites.TAB_MID_OFF;

  onMounted(() => showDisplay(onB, onC));
  onUpdated(() => showDisplay(onB, onC));

  return (
    <layer w="fill" h="fill">
      <layer
        x={0}
        y="center"
        w={125}
        h="fill"
        onMouseEnter={
          showA
            ? undefined
            : () => {
                setHoverA(1);
              }
        }
        onMouseLeave={
          showA
            ? undefined
            : () => {
                setHoverA(0);
              }
        }
        onClick={
          showA
            ? undefined
            : () => {
                CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
                setHoverA(0);
                setHoverB(0);
                setHoverC(0);
                setShown(Tab.MAX_MED);
              }
        }
      >
        <sprite x="left" y="bottom" w={20} h={21} sprite={endA} />
        <sprite x="right" y="bottom" w={20} h={21} sprite={endA} hflip />
        <sprite x="center" y="bottom" w={{ fill: 40 }} h={21} sprite={midA} tiling />
        <text
          x="center"
          y={{ center: 1 }}
          w="fill"
          h="fill"
          font={LoadoutFonts.BODY}
          color={LoadoutColor.LABEL}
          shadow
          align="center"
          valign="middle"
          text={tabLabel(Tab.MAX_MED)}
        />
      </layer>
      <layer
        x={125}
        y="center"
        w={125}
        h="fill"
        onMouseEnter={
          onB
            ? undefined
            : () => {
                setHoverB(1);
              }
        }
        onMouseLeave={
          onB
            ? undefined
            : () => {
                setHoverB(0);
              }
        }
        onClick={
          onB
            ? undefined
            : () => {
                CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
                setHoverA(0);
                setHoverB(0);
                setHoverC(0);
                setShown(Tab.ZERKER);
              }
        }
      >
        <sprite x="left" y="bottom" w={20} h={21} sprite={endB} />
        <sprite x="right" y="bottom" w={20} h={21} sprite={endB} hflip />
        <sprite x="center" y="bottom" w={{ fill: 40 }} h={21} sprite={midB} tiling />
        <text
          x="center"
          y={{ center: 1 }}
          w="fill"
          h="fill"
          font={LoadoutFonts.BODY}
          color={LoadoutColor.LABEL}
          shadow
          align="center"
          valign="middle"
          text={tabLabel(Tab.ZERKER)}
        />
      </layer>
      <layer
        x={250}
        y="center"
        w={125}
        h="fill"
        onMouseEnter={
          onC
            ? undefined
            : () => {
                setHoverC(1);
              }
        }
        onMouseLeave={
          onC
            ? undefined
            : () => {
                setHoverC(0);
              }
        }
        onClick={
          onC
            ? undefined
            : () => {
                CS2.sound_effect(LoadoutSounds.CLICK, 1, 0);
                setHoverA(0);
                setHoverB(0);
                setHoverC(0);
                setShown(Tab.PURE);
              }
        }
      >
        <sprite x="left" y="bottom" w={20} h={21} sprite={endC} />
        <sprite x="right" y="bottom" w={20} h={21} sprite={endC} hflip />
        <sprite x="center" y="bottom" w={{ fill: 40 }} h={21} sprite={midC} tiling />
        <text
          x="center"
          y={{ center: 1 }}
          w="fill"
          h="fill"
          font={LoadoutFonts.BODY}
          color={LoadoutColor.LABEL}
          shadow
          align="center"
          valign="middle"
          text={tabLabel(Tab.PURE)}
        />
      </layer>
    </layer>
  );
}

function showDisplay(onB: Boolean, onC: Boolean): void {
  displayA.props = { hide: onB || onC };
  displayB.props = { hide: !onB };
  displayC.props = { hide: !onC };
  warnA.props = { hide: onB || onC };
  warnB.props = { hide: !onB };
  warnC.props = { hide: !onC };
}
