import { CS2 } from 'ts2';
import { clientClock } from '../lib/lib.engine';

export function tobHudNameFlasher(): Int {
  let phase: Int = clientClock() % 90;
  if (phase > 45) {
    phase = 90 - phase;
  }
  const level: Int = CS2.scale(CS2.invpow(phase * 255, 2), CS2.invpow(11475, 2), 255);
  return (255 * 65536) | (level * 256) | level;
}
