import { useRef } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { CanoeMapColors, CanoeMapFonts, CanoeMapModels, CanoePins } from './canoe-map.constants';

export function CanoeDestination({
  label,
  option,
  labelX,
  markerRight,
  wide = false,
}: {
  label: String;
  option: String;
  labelX: Int;
  markerRight: Int;
  wide?: Boolean;
}): Component {
  const caption = useRef();
  const marker = useRef();

  let hoverable: Boolean = false;
  if (!onMobile()) {
    hoverable = true;
  }

  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill={false}
        transparency={255}
        options={[option]}
        onMouseRepeat={() => {
          if (hoverable) {
            if (!wide) {
              marker.model = CanoeMapModels.MARKER_HOVER;
            }
            caption.color = CanoeMapColors.LABEL_HOVER;
          }
        }}
        onMouseLeave={() => {
          if (hoverable) {
            if (!wide) {
              marker.model = CanoeMapModels.MARKER;
            }
            caption.color = CanoeMapColors.LABEL;
          }
        }}
      />

      <text
        ref={caption}
        x={labelX}
        y={0}
        w={wide ? 'fill' : '50%'}
        h="fill"
        text={label}
        font={CanoeMapFonts.LABEL}
        color={CanoeMapColors.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      {!wide && (
        <model
          ref={marker}
          right={markerRight}
          y={0}
          w="50%"
          h="fill"
          model={CanoeMapModels.MARKER}
          pitch={CanoePins.MARKER_PITCH}
          yaw={CanoePins.MARKER_YAW}
          zoom={CanoePins.MARKER_ZOOM}
        />
      )}
    </>
  );
}

export function CanoeYouAreHere(): Component {
  return (
    <>
      <text
        right={0}
        y={{ center: -7 }}
        w={94}
        h={14}
        text="You are here"
        font={CanoeMapFonts.YOU_ARE_HERE}
        color={CanoeMapColors.YOU_ARE_HERE}
        shadow
        align="center"
        valign="middle"
      />
      <model
        right={90}
        y={{ center: -6 }}
        w={36}
        h={31}
        model={CanoeMapModels.YOU_ARE_HERE}
        pitch={CanoePins.HERE_PITCH}
        yaw={CanoePins.HERE_YAW}
        zoom={CanoePins.HERE_ZOOM}
      />
    </>
  );
}
