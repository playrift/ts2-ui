import { useServerState } from 'ts2';

import { CanoeDestination, CanoeYouAreHere } from './canoe-destination.component';
import { CanoeStops, CanoeVarbits } from './canoe-map.constants';
import { canoeReturnLocations } from './canoe-map.paddles';

export function CanoeDestinations(): Component {
  const from: Int = useServerState(CanoeVarbits.START_FROM);

  const [lumbridge, champions, barbarian, edgeville, wilderness, ferox] = canoeReturnLocations();

  return (
    <>
      <layer x={165} y={135} w={210} h={36}>
        {edgeville !== 1 && (
          <CanoeDestination label="Edgeville" labelX={-10} markerRight={25} option="Travel to<col=ff9040> Edgeville" />
        )}
        {from === CanoeStops.EDGEVILLE && <CanoeYouAreHere />}
      </layer>

      <layer x={237} y={245} w={210} h={38}>
        {lumbridge !== 1 && (
          <CanoeDestination label="Lumbridge" labelX={0} markerRight={15} option="Travel to<col=ff9040> Lumbridge" />
        )}
        {from === CanoeStops.LUMBRIDGE && <CanoeYouAreHere />}
      </layer>

      <layer x={181} y={208} w={232} h={36}>
        {champions !== 1 && (
          <CanoeDestination
            label="Champions <br>Guild"
            labelX={-20}
            markerRight={0}
            option="Travel to<col=ff9040> Champions Guild"
          />
        )}
        {from === CanoeStops.CHAMPIONS_GUILD && <CanoeYouAreHere />}
      </layer>

      <layer x={174} y={173} w={178} h={35}>
        {barbarian !== 1 && (
          <CanoeDestination
            label="Barbarian <br> Village"
            labelX={-10}
            markerRight={20}
            option="Travel to<col=ff9040> Barbarian Village"
          />
        )}
        {from === CanoeStops.BARBARIAN_VILLAGE && <CanoeYouAreHere />}
      </layer>

      <layer x={236} y={61} w={189} h={38}>
        {wilderness !== 1 && (
          <CanoeDestination
            label="Wilderness Pond - <br>No canoe trees here."
            wide
            labelX={0}
            markerRight={0}
            option="Travel to<col=ff9040> Wilderness Pond"
          />
        )}
      </layer>

      <layer x={169} y={99} w={224} h={37}>
        {ferox !== 1 && (
          <CanoeDestination
            label="Ferox <br> Enclave"
            labelX={-15}
            markerRight={35}
            option="Travel to<col=ff9040> Ferox Enclave"
          />
        )}
        {from === CanoeStops.FEROX_ENCLAVE && <CanoeYouAreHere />}
      </layer>
    </>
  );
}
