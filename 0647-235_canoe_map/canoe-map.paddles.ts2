import { useServerState } from 'ts2';

import { CanoeStops, CanoeType, CanoeVarbits } from './canoe-map.constants';

export function canoeGetState(stop: Int): Int {
  switch (stop) {
    case CanoeStops.BARBARIAN_VILLAGE:
      return useServerState(CanoeVarbits.STATE_BARBARIAN_VILLAGE);
    case CanoeStops.CHAMPIONS_GUILD:
      return useServerState(CanoeVarbits.STATE_CHAMPIONS_GUILD);
    case CanoeStops.EDGEVILLE:
      return useServerState(CanoeVarbits.STATE_EDGEVILLE);
    case CanoeStops.LUMBRIDGE:
      return useServerState(CanoeVarbits.STATE_LUMBRIDGE);
    case CanoeStops.FEROX_ENCLAVE:
      return useServerState(CanoeVarbits.STATE_FEROX_ENCLAVE);
  }
  return 0;
}

export function canoePaddleLog(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 1, 1, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 1, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [1, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [1, 1, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 1, 1, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleDugout(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 1, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [1, 0, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 1, 0, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleStableDugout(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 0, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [0, 0, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 0, 0, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleStableWaka(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 0, 0, 0];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 0, 0];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 0, 0];
    case CanoeStops.EDGEVILLE:
      return [0, 0, 0, 1, 0, 0];
    case CanoeStops.FEROX_ENCLAVE:
      return [0, 0, 0, 0, 0, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoeReturnLocations(): [Int, Int, Int, Int, Int, Int] {
  const from: Int = useServerState(CanoeVarbits.START_FROM);
  switch (canoeGetState(from)) {
    case CanoeType.LOG:
      return canoePaddleLog(from);
    case CanoeType.DUGOUT:
      return canoePaddleDugout(from);
    case CanoeType.STABLE_DUGOUT:
      return canoePaddleStableDugout(from);
    case CanoeType.STABLE_WAKA:
      return canoePaddleStableWaka(from);
  }
  return [0, 0, 0, 0, 0, 0];
}
