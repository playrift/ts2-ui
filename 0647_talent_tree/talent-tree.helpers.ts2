function pick(slot: Int, a: Sprite, b: Sprite, c: Sprite, d: Sprite): Sprite {
  if (slot === 0) {
    return a;
  } else if (slot === 1) {
    return b;
  } else if (slot === 2) {
    return c;
  }
  return d;
}

export function pactFormat(text: String, value: String): String {
  return stringFindAndReplace(stringFindAndReplace(text, '#', value), '*', 'F47113');
}

export function hotfixText(hotfix: String, effect: Int): String {
  const needle: String = `|T${keyRun(effect)}`;
  const at: Int = hotfix.indexOf(needle, 0);
  if (at === -1) {
    return '';
  }
  let end: Int = hotfix.indexOf('|', at + 5);
  if (end === -1) {
    end = hotfix.length;
  }
  return hotfix.substring(at + 5, end);
}

export function hotfixValue(hotfix: String, key: Int): Int {
  const needle: String = `|V${keyRun(key)}:`;
  const at: Int = hotfix.indexOf(needle, 0);
  if (at === -1) {
    return 0;
  }
  let end: Int = hotfix.indexOf('|', at + 6);
  if (end === -1) {
    end = hotfix.length;
  }
  return parseInt(hotfix.substring(at + 6, end));
}

export function pactEffectText(key: Int, hotfix: String, short: Boolean): String {
  const node: PactNode | null = PactNodes.at(key);
  if (node === null) {
    return '';
  }
  const fixed: String = hotfixText(hotfix, node.effect);
  if (fixed.length > 0) {
    return fixed;
  }
  if (short) {
    if (node.effect === 15) {
      return '+#% Ranged damage.';
    } else if (node.effect === 14) {
      return '+#% Melee damage.';
    } else if (node.effect === 7) {
      return "+#% Magic damage<br><br>This bonus is multiplied by the Tumeken's Shadow special effect.";
    }
  }
  return node.text;
}

export function pactEffectValue(key: Int, hotfix: String): Int {
  const node: PactNode | null = PactNodes.at(key);
  if (node === null) {
    return 0;
  }
  const fixed: Int = hotfixValue(hotfix, key);
  if (fixed > 0) {
    return fixed;
  }
  return node.value;
}

export function pactTooltip(key: Int, hotfix: String, zoom: Int, debug: Boolean): String {
  const node: PactNode | null = PactNodes.at(key);
  if (node === null) {
    return '';
  }
  let text: String = pactFormat(pactEffectText(key, hotfix, false), `${pactEffectValue(key, hotfix)}`);
  if (debug) {
    text = `ID - ${key + 1} [${node.debug}]<br>${text}<br>X: ${pactNodeX(node, zoom)}, Y: ${pactNodeY(node, zoom)}`;
  }
  return text;
}

export function pactStyleName(style: Int): String {
  if (style === PactStyle.MELEE) {
    return 'Melee';
  } else if (style === PactStyle.RANGED) {
    return 'Ranged';
  } else if (style === PactStyle.MAGIC) {
    return 'Magic';
  } else if (style === PactStyle.NEUTRAL) {
    return 'Neutral';
  }
  return '';
}

export function pactEffectDisabled(effect: Int): Boolean {
  return false;
}

export function pactEffectLevel(effect: Int): Int {
  if (useServerState(Varbits.LEAGUE_TYPE) !== 6) {
    return 0;
  }
  if (pactEffectDisabled(effect)) {
    return 0;
  }
