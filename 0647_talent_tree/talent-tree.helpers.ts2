  } else if (effect === 59) {
    return useServerState(Varbits.VARBIT_20318);
  } else if (effect === 60) {
    return useServerState(Varbits.VARBIT_20319);
  } else if (effect === 61) {
    return useServerState(Varbits.VARBIT_20320);
  } else if (effect === 62) {
    return useServerState(Varbits.VARBIT_20323);
  } else if (effect === 63) {
    return useServerState(Varbits.VARBIT_20324);
  } else if (effect === 64) {
    return useServerState(Varbits.VARBIT_20325);
  } else if (effect === 65) {
    return useServerState(Varbits.VARBIT_20326);
  } else if (effect === 66) {
    return useServerState(Varbits.VARBIT_20334);
  } else if (effect === 67) {
    return useServerState(Varbits.VARBIT_20328);
  } else if (effect === 68) {
    return useServerState(Varbits.VARBIT_20346);
  } else if (effect === 69) {
    return useServerState(Varbits.VARBIT_20330);
  } else if (effect === 70) {
    return useServerState(Varbits.VARBIT_20333);
  } else if (effect === 71) {
    return useServerState(Varbits.VARBIT_20331);
  } else if (effect === 72) {
    return useServerState(Varbits.VARBIT_20332);
  } else if (effect === 73) {
    return useServerState(Varbits.VARBIT_20347);
  } else if (effect === 74) {
    return useServerState(Varbits.VARBIT_20335);
  } else if (effect === 75) {
    return useServerState(Varbits.VARBIT_20327);
  } else if (effect === 76) {
    return useServerState(Varbits.VARBIT_20265);
  } else if (effect === 77) {
    return useServerState(Varbits.VARBIT_20338);
  } else if (effect === 78) {
    return useServerState(Varbits.VARBIT_20339);
  } else if (effect === 79) {
    return useServerState(Varbits.VARBIT_20263);
  } else if (effect === 80) {
    return useServerState(Varbits.VARBIT_20290);
  } else if (effect === 82) {
    return useServerState(Varbits.VARBIT_20270);
  } else if (effect === 83) {
    return useServerState(Varbits.VARBIT_20343);
  } else if (effect === 84) {
    return useServerState(Varbits.VARBIT_20348);
  }
  debugMessageAlias(`Missing plugin for effect type ${effect}`);
  return 0;
}

export function talentTreeOpen(recentre: Int): void {
  const [zoomRaw, setZoom] = useState(talentTreeZoomScalar);
  if (zoomRaw <= 0) {
    setZoom(100);
  }
  const zoom: Int = zoomOf(zoomRaw);

  const [px] = useState(talentTreeOverlayX);
  const [py] = useState(talentTreeOverlayY);
  const [pw] = useState(talentTreeOverlayWidth);
  const [ph] = useState(talentTreeOverlayHeight);
  let wantW: Int = pw;
  let wantH: Int = ph;
  let wantX: Int = px;
  let wantY: Int = py;
  if (onMobile()) {
    const [, setDelay] = useState(talentTreeDragDelay);
    setDelay(10);
    wantX = 16;
    wantY = 16;
    wantW = 684;
    wantH = 418;
  }
  const [placedX, placedY, placedW, placedH] = floaterPlaced(TALENT_TREE_FLOATER, wantX, wantY, wantW, wantH);
  floaterPlace(TALENT_TREE_FLOATER, wantX, wantY, wantW, wantH);

  if (recentre === 1) {
    const extent: Int = pactPaneExtent(zoom);
    const [, setScrollX] = useState(talentTreeHorizontalScrollPos);
    const [, setScrollY] = useState(talentTreeVerticalScrollPos);
    setScrollX((extent - (placedW - 12)) / 2);
    setScrollY((extent - (placedH - 41)) / 2);
  }

  const [, setCount] = useState(talentTreeSelectedNodeAmount);
  const [, setPending] = useState(pactPending);
  const [, setBar] = useState(pactBarKind);
  const [, setCounted] = useState(pactBarCounted);
  const [, setDeselect0] = useState(pactDeselect0);
  const [, setDeselect1] = useState(pactDeselect1);
  const [, setDeselect2] = useState(pactDeselect2);
  const [, setDeselect3] = useState(pactDeselect3);
  const [, setDeselect4] = useState(pactDeselect4);
  const [, setRootRule] = useState(pactRootRule);
  const [, setPulsing] = useState(pactPulsing);
  setCount(0);
  setPending('');
  setBar(PactBar.HIDDEN);
  setCounted(0);
  setDeselect0(0);
  setDeselect1(0);
  setDeselect2(0);
  setDeselect3(0);
  setDeselect4(0);
  setRootRule(1);
  if (!pactUnlocked(ROOT_NODE) && useServerState(Varbits.LEAGUE_TUTORIAL_COMPLETED) < TUTORIAL_DONE) {
    setPulsing(1);
  } else {
    setPulsing(0);
  }
  const [showing] = useState(talentTreeShowingInfoPanel);
  if (showing === PactSideLook.INFO) {
    const [, setShown] = useState(pactTipShown);
    setShown(0);
  }
}

export function pactInterfaceOpened(): void {
  const [, setHotfix] = useState(pactHotfix);
  const [, setShown] = useState(pactTipShown);
  const [, setKey] = useState(pactTipKey);
  const [, setText] = useState(pactTipText);
  const [, setTimed] = useState(pactTipTimed);
  const [, setSeen] = useState(pactTipSeen);
  setHotfix('');
  setShown(0);
  setKey(-1);
  setText('');
  setTimed(0);
  setSeen(-1);
}

export function talentTreeHotfixClear(): void {
  const [, setHotfix] = useState(pactHotfix);
  setHotfix('');
}

export function talentTreeHotfixText(effect: Int, text: String): void {
  const [hotfix, setHotfix] = useState(pactHotfix);
  if (hotfix.indexOf(`|T${keyRun(effect)}`, 0) !== -1) {
    debugWarn(
      'Hotfix',
      `Duplicate $effect name change in hotfix layer, for $effect = ${effect}. Ensure you arent hotfixing this effect more than once.`,
    );
    return;
  }
  setHotfix(`${hotfix}|T${keyRun(effect)}${text}`);
}

export function talentTreeHotfixValue(key: Int, value: Int): void {
  if (key < 0) {
    return;
  }
  const [hotfix, setHotfix] = useState(pactHotfix);
  if (hotfix.indexOf(`|V${keyRun(key)}:`, 0) !== -1) {
    const node: PactNode | null = PactNodes.at(key);
    let name: String = '';
    if (node !== null) {
      name = node.debug;
    }
    debugWarn(
      'Hotfix',
      `Duplicate [${name}] value hotfix data in hotfix layer. Ensure you arent hotfixing this node more than once.`,
    );
    return;
  }
  setHotfix(`${hotfix}|V${keyRun(key)}:${value}`);
}

export function pactZoom(next: Int): void {
  const [zoom, setZoom] = useState(talentTreeZoomScalar);
  const before: Int = pactPaneExtent(zoom);
  setZoom(next);
  const after: Int = pactPaneExtent(next);
  const [scrollX, setScrollX] = useState(talentTreeHorizontalScrollPos);
  const [scrollY, setScrollY] = useState(talentTreeVerticalScrollPos);
  setScrollX(Math.max(0, scrollX + (after - before) / 2));
  setScrollY(Math.max(0, scrollY + (after - before) / 2));
  if (pactDebugIds()) {
    debugMessage(`Zoom is ${next}`);
  }
}

export function pactDragStart(mouseX: Int, mouseY: Int): void {
  const [, setFocusX] = useState(talentTreeDragFocusX);
  const [, setFocusY] = useState(talentTreeDragFocusY);
  setFocusX(mouseX);
  setFocusY(mouseY);
}

export function pactDrag(mouseX: Int, mouseY: Int): void {
  const [delay, setDelay] = useState(talentTreeDragDelay);
  const left: Int = Math.max(0, delay - 2);
  setDelay(left);
  if (left > 2) {
    return;
  }
  const [focusX, setFocusX] = useState(talentTreeDragFocusX);
  const [focusY, setFocusY] = useState(talentTreeDragFocusY);
  const [scrollX, setScrollX] = useState(talentTreeHorizontalScrollPos);
  const [scrollY, setScrollY] = useState(talentTreeVerticalScrollPos);
  setScrollX(scrollX + (focusX - mouseX));
  setScrollY(scrollY + (focusY - mouseY));
  setFocusX(mouseX);
  setFocusY(mouseY);
}

export function pactDragDelayTick(): void {
  const [delay, setDelay] = useState(talentTreeDragDelay);
  setDelay(Math.min(10, delay + 1));
}

export function pactToggleInfoOnTap(): void {
  const [toggle, setToggle] = useState(talentTreeMobileOpToggle);
  if (toggle === 1) {
    setToggle(0);
  } else {
    setToggle(1);
  }
}

export function pactShowInfo(show: Boolean): void {
  const [, setShowing] = useState(talentTreeShowingInfoPanel);
  if (show) {
    playSound(PactSound.EXPAND);
    setShowing(1);
  } else {
    setShowing(0);
  }
}

export function pactResetAllowed(): Boolean {
  if (pactResets() <= 0) {
    chatMessage(
      '<col=ff0000>You need atleast one pact reset point to do that. You can see which tasks give you these points, within the tasks interface.',
    );
    playSound(PactSound.REFUSED);
    return false;
  }
  return true;
}
