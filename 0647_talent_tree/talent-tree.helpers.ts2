export function keyRun(key: Int): String {
  return `${key}`.padStart(3, '0');
}

export function runCount(run: String): Int {
  return run.length / 3;
}

export function runAt(run: String, position: Int): Int {
  return parseInt(run.substring(position * 3, position * 3 + 3));
}

export function runHas(run: String, key: Int): Boolean {
  const needle: String = keyRun(key);
  let at: Int = run.indexOf(needle, 0);
  while (at !== -1 && at % 3 !== 0) {
    at = run.indexOf(needle, at + 1);
  }
  return at !== -1;
}

export function runIndexOf(run: String, key: Int): Int {
  const needle: String = keyRun(key);
  let at: Int = run.indexOf(needle, 0);
  while (at !== -1 && at % 3 !== 0) {
    at = run.indexOf(needle, at + 1);
  }
  if (at === -1) {
    return -1;
  }
  return at / 3;
}

export function pactUnlocked(key: Int): Boolean {
  const bit: Int = key % 32;
  const word: Int = key / 32;
  if (word === 0) {
    return CS2.testbit(useServerState(Varps.VARP_5498), bit);
  } else if (word === 1) {
    return CS2.testbit(useServerState(Varps.VARP_5499), bit);
  } else if (word === 2) {
    return CS2.testbit(useServerState(Varps.VARP_5500), bit);
  } else if (word === 3) {
    return CS2.testbit(useServerState(Varps.VARP_5501), bit);
  } else if (word === 4) {
    return CS2.testbit(useServerState(Varps.VARP_5502), bit);
  } else if (word === 5) {
    return CS2.testbit(useServerState(Varps.VARP_5503), bit);
  }
  debugMessageAlias(
    `Missing plugin for ID ${key} We're probably missing a plugin for var ${word} in talent_tree_tracking_get_set_unlocked`,
  );
  return false;
}

export function pactsEarned(): Int {
  return useServerState(Varps.VARP_5484);
}

export function pactsSpent(): Int {
  return useServerState(Varps.VARP_5486);
}

export function pactResets(): Int {
  return useServerState(Varbits.VARBIT_20260);
}

export function pactDebugIds(): Boolean {
  return useServerState(Varbits.FAIRYRINGS_DEPRECATED) === 1;
}

export function pactNodeState(key: Int, earned: Int, spent: Int, pending: String, rootRule: Int): Int {
  if (pactUnlocked(key)) {
    return PactState.ACTIVE;
  }
  if (runHas(pending, key)) {
    return PactState.SELECTED;
  }
  if (spent + runCount(pending) >= earned) {
    return PactState.LOCKED;
  }
  if (key === ROOT_NODE && rootRule === 1) {
    return PactState.SELECTABLE;
  }
  const links: String = PactLinks.at(key) ?? '';
  const count: Int = runCount(links);
  let i: Int = 0;
  while (i < count) {
    const other: Int = runAt(links, i);
    if (pactUnlocked(other)) {
      return PactState.SELECTABLE;
    }
    if (runHas(pending, other)) {
      return PactState.SELECTABLE;
    }
    i = i + 1;
  }
  return PactState.LOCKED;
}

export function pactLineState(a: Int, b: Int): Int {
  if (a === PactState.ACTIVE) {
    return b;
  }
  if (a === PactState.SELECTED) {
    if (b === PactState.LOCKED) {
      return PactState.LOCKED;
    }
    if (b === PactState.SELECTABLE) {
      return PactState.SELECTABLE;
    }
    return PactState.SELECTED;
  }
  if (a === PactState.SELECTABLE) {
    if (b === PactState.ACTIVE || b === PactState.SELECTED) {
      return PactState.SELECTABLE;
    }
    return PactState.LOCKED;
  }
  return PactState.LOCKED;
}

export function pactLineColour(state: Int): Int {
  if (state === PactState.LOCKED) {
    return 0x000001;
  } else if (state === PactState.ACTIVE) {
    return 0xfae17d;
  } else if (state === PactState.SELECTED) {
    return 0xf17113;
  } else if (state === PactState.SELECTABLE) {
    return 0xbd000b;
  }
  return 0x000000;
}

export function zoomOf(zoom: Int): Int {
  if (zoom <= 0) {
    return 100;
  }
  return zoom;
}

export function pactNodeSide(size: Int, zoom: Int): Int {
  let side: Int = 0;
  if (size === 2) {
    side = 24;
  } else if (size === 1) {
    side = 48;
  } else if (size === 3) {
    side = 72;
  }
  return scaled(side, 100, zoom);
}

export function pactNodeX(node: PactNode, zoom: Int): Int {
  return scaled(node.x, 100, zoom);
}

export function pactNodeY(node: PactNode, zoom: Int): Int {
  return scaled(node.y, 100, zoom);
}

export function pactLineWidth(zoom: Int): Int {
  if (zoom <= 125) {
    return 2;
  }
  if (zoom <= 175) {
    return 3;
  }
  return 4;
}

export function pactIconSide(size: Int, side: Int): Int {
  if (size === 2) {
    return (8192 * side) / 16384;
  }
  return (16384 * side) / 16384;
}

export function pactPaneExtent(zoom: Int): Int {
  return scaled(PANE_SIDE, 100, zoom);
}

export function pactRingSprite(size: Int, side: Int, state: Int): Sprite {
  if (size === 3) {
    if (side > 48) {
      if (state === 0) {
        return 7670;
      } else if (state === 1) {
        return 7667;
      } else if (state === 2) {
        return 7668;
      } else if (state === 3) {
        return 7669;
      }
    } else {
      if (state === 0) {
        return 7660;
      } else if (state === 1) {
        return 7657;
      } else if (state === 2) {
        return 7658;
      } else if (state === 3) {
        return 7659;
      }
    }
  } else {
    if (side > 48) {
      if (state === 0) {
        return 7665;
      } else if (state === 1) {
        return 7662;
      } else if (state === 2) {
        return 7663;
      } else if (state === 3) {
        return 7664;
      }
    } else {
      if (state === 0) {
        return 7655;
      } else if (state === 1) {
        return 7652;
      } else if (state === 2) {
        return 7653;
      } else if (state === 3) {
        return 7654;
      }
    }
  }
  return -1;
}

export function pactIconSprite(effect: Int, size: Int, iconSide: Int, state: Int): Sprite {
  let limit: Int = 48;
  if (size === 2) {
    limit = 16;
  }
  let slot: Int = 3;
  if (state === PactState.ACTIVE || state === PactState.SELECTED) {
    slot = 1;
    if (iconSide > limit) {
      slot = 0;
    }
  } else if (iconSide > limit) {
    slot = 2;
  }
  return effectIcon(effect, size, slot);
}

