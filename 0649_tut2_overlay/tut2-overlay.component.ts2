import { createRef, useInterval, useServerState } from 'ts2';

import { scaled } from '../lib/lib.engine';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Bar,
  Layout,
  Tut2Color,
  Tut2Dodge,
  Tut2Fonts,
  Tut2Sprites,
  Tut2Varps,
  Tut2Wash,
} from './tut2-overlay.constants';

const timerHost1 = createRef('0649_tut2_overlay_timer_host1');

const timerHost2 = createRef('0649_tut2_overlay_timer_host2');

const hintLayer = createRef('tut2_overlay_hint_layer');

const progressbarContainer = createRef('tut2_overlay_progressbar_container');

function ProgressBarSpace(): Component {
  const progress: Int = useServerState(Tut2Varps.PROGRESS);
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={Tut2Color.TRACK} fill transparency={Tut2Wash.TRACK} />

      <rect
        x={0}
        y="center"
        w={scaled(scaled(progress, Bar.FULL, Bar.PROPORTION), Bar.PROPORTION, Bar.TRACK_W)}
        h="fill"
        color={Tut2Color.BAR}
        fill
        transparency={Tut2Wash.BAR}
      />

      <rect x="center" y="center" w="fill" h="fill" color={Tut2Color.TRACK_BORDER} transparency={Tut2Wash.BAR} />
    </layer>
  );
}

export function Tut2Overlay(): Component {
  useInterval(() => overlayRelayout(timerHost1, hintLayer, Tut2Dodge.HINT, Anchor.LEFT, Anchor.TOP, 0), timerHost1);
  useInterval(
    () => overlayRelayout(timerHost2, progressbarContainer, Tut2Dodge.PROGRESS, Anchor.CENTRE, Anchor.BOTTOM, 0),
    timerHost2,
  );

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" hide noClickThrough />

      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={hintLayer} x={Layout.HINT_X} y={Layout.HINT_Y} w={Layout.HINT_W} h={Layout.HINT_H} hide>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.HINT_INSET }}
            h={{ fill: Layout.HINT_INSET }}
            sprite={Tut2Sprites.HINT_BACKING}
            tiling
            transparency={Tut2Wash.HINT_BACKING}
          />

          <rect
            x="center"
            y="center"
            w={{ fill: Layout.HINT_INSET }}
            h={{ fill: Layout.HINT_INSET }}
            color={Tut2Color.HINT_FOREGROUND}
            fill
            transparency={Tut2Wash.HINT_FOREGROUND}
          />

          <rect x="center" y="center" w="fill" h="fill" color={Tut2Color.HINT_BORDER} />

          <text
            x="center"
            y={Layout.HINT_LINE_1_Y}
            w={{ fill: Layout.HINT_LINE_W_INSET }}
            h={Layout.HINT_LINE_H}
            font={Tut2Fonts.HINT}
            text=""
            align="center"
            valign="middle"
            shadow
            color={Tut2Color.HINT_TEXT}
          />
          <text
            x="center"
            y={Layout.HINT_LINE_2_Y}
            w={{ fill: Layout.HINT_LINE_W_INSET }}
            h={Layout.HINT_LINE_H}
            font={Tut2Fonts.HINT}
            text=""
            align="center"
            valign="middle"
            shadow
            color={Tut2Color.HINT_TEXT}
          />
          <text
            x="center"
            y={Layout.HINT_LINE_3_Y}
            w={{ fill: Layout.HINT_LINE_W_INSET }}
            h={Layout.HINT_LINE_H}
            font={Tut2Fonts.HINT}
            text=""
            align="center"
            valign="middle"
            shadow
            color={Tut2Color.HINT_TEXT}
          />
          <text
            x="center"
            y={Layout.HINT_LINE_4_Y}
            w={{ fill: Layout.HINT_LINE_W_INSET }}
            h={Layout.HINT_LINE_H}
            font={Tut2Fonts.HINT}
            text=""
            align="center"
            valign="middle"
            shadow
            color={Tut2Color.HINT_TEXT}
          />
        </layer>
      </layer>

      <layer w="fill" h="fill" ref={timerHost2}>
        <layer
          ref={progressbarContainer}
          x="center"
          y={{ bottom: Layout.BAR_BOX_BOTTOM }}
          w={Layout.BAR_BOX_W}
          h={Layout.BAR_BOX_H}
        >
          <ProgressBarSpace x="right" y={Layout.TRACK_Y} w={{ fill: Layout.TRACK_W_INSET }} h={Layout.TRACK_H} />

          <text
            x={0}
            y={0}
            w={Layout.CAPTION_W}
            h={{ fill: Layout.CAPTION_H_INSET }}
            font={Tut2Fonts.PROGRESS}
            text="% Done"
            align="right"
            shadow
            color={Tut2Color.CAPTION}
          />

          <text
            x="center"
            y="bottom"
            w="fill"
            h={Layout.TITLE_H}
            font={Tut2Fonts.PROGRESS}
            text="Tutorial Island Progress"
            align="center"
            valign="middle"
            shadow
            color={Tut2Color.TITLE}
          />
        </layer>
      </layer>
    </layer>
  );
}
