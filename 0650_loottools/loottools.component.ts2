import { useRef, useServerState, useState, useUniverse, useWatch } from 'ts2';
import { DropdownButton } from '../0891_hotkey_settings_new/dropdown-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ThinBoxOutline } from '../lib/thin-box.component';
import { onMobile } from '../lib/lib.helpers';
import { Sprites } from '../lib/game/sprites';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { osmPopoutState } from '../lib/game/varcs';
import { GroundItemsOverlayStruct, LOOTTOOLS_CATEGORY_COUNT, LoottoolsCategories } from './loottools.data';
import { GroundVector, LootColors, LootCopy, LootFonts, LootLayout, LootPopout } from './loottools.constants';
import {
  collapseOption,
  collapseSprite,
  dropsHidden,
  groundItemsToggle,
  groundVectorJoined,
  groupViewSprite,
  groupViewSubject,
  ignoreModeOption,
  ignoreModeSprite,
  lootGroupViewSynced4850,
  lootToggleCollapse,
  lootToggleGroupMode,
  lootToggleIgnored,
  lootToggleValueMode,
  sourcesHidden,
  totalsText,
  valueModeSprite,
  valueModeSubject,
} from './loottools.helpers';
import {
  groundListsRevision,
  lootGroupViewSynced,
  lootNamedRows,
  lootRowsExpanded,
  lootRowsExtent,
  lootTotalCount,
  lootTotalValue,
} from './loottools.state';

export function Loottools(): Component {
  return (
    <>
      <layer x="right" y={0} w={LootLayout.COLUMN_W} h="fill">
        <LootHeader />
        <CategoryPanes />
      </layer>
      <layer x={0} y={0} w={LootLayout.TOOLTIP_W} h={LootLayout.TOOLTIP_H} />
      <layer x={0} y={0} w="fill" h="fill" hide>
        <layer
          x={LootLayout.DROPDOWN_X}
          y={LootLayout.DROPDOWN_Y}
          w={LootLayout.DROPDOWN_W}
          h={LootLayout.DROPDOWN_H}
          noClickThrough
        >
          <layer x={0} y={0} w={{ fill: LootLayout.DROPDOWN_CONTENT_INSET }} h="fill" />
          <layer x="right" y={0} w={LootLayout.DROPDOWN_SCROLLER_W} h={LootLayout.DROPDOWN_H} />
        </layer>
      </layer>
    </>
  );
}

function fullPopout(state: Int): Boolean {
  return onMobile() && state === LootPopout.FULL;
}

function LootHeader(): Component {
  const [popout] = useState(osmPopoutState);
  const state: Int = popout;
  return (
    <layer x={0} y={0} w="fill" h={LootLayout.HEADER_H} hide={fullPopout(state)}>
      <layer
        x={LootLayout.BUTTON_INSET}
        y={LootLayout.BUTTON_INSET}
        w={{ fill: LootLayout.CATEGORY_INSET_W }}
        h={LootLayout.BUTTON_H}
      >
        <CategoryButton />
      </layer>
      <SettingsButton />
    </layer>
  );
}

function CategoryButton(): Component {
  const category: Int = useServerState(Varbits.LOOTTOOLS_CATEGORY_CURRENT);
  return (
    <DropdownButton
      label={LoottoolsCategories.at(category) ?? 'Loot Tracker'}
      entryCount={LOOTTOOLS_CATEGORY_COUNT}
      color={LootColors.ORANGE}
    />
  );
}

function SettingsButton(): Component {
  const mobile: Boolean = onMobile();
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      x={{ right: LootLayout.BUTTON_INSET }}
      y={LootLayout.BUTTON_INSET}
      w={LootLayout.SETTINGS_W}
      h={LootLayout.BUTTON_H}
      options={[LootCopy.SETTINGS]}
      onMouseRepeat={mobile ? undefined : () => setPressed(1)}
      onMouseLeave={mobile ? undefined : () => setPressed(0)}
    >
      {pressed === 1 ? (
        <StoneButtonPressedFilled>
          <SettingsIcon />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonFilled>
          <SettingsIcon />
        </StoneButtonFilled>
      )}
    </layer>
  );
}

function SettingsIcon(): Component {
  return (
    <sprite
      x="center"
      y="center"
      w={LootLayout.SETTINGS_ICON}
      h={LootLayout.SETTINGS_ICON}
      sprite={Sprites.ACC_MAN_ICONS_7}
    />
  );
}

function CategoryPanes(): Component {
  const [popout] = useState(osmPopoutState);
  const category: Int = useServerState(Varbits.LOOTTOOLS_CATEGORY_CURRENT);
  const state: Int = popout;
  const top: Int = fullPopout(state) ? 0 : LootLayout.HEADER_H;
  return (
    <layer x={0} y="bottom" w="fill" h={{ fill: top }}>
      <layer x={0} y={0} w="fill" h="fill" hide={category !== 0}>
        <LootTracking />
      </layer>
      <layer x={0} y={0} w="fill" h="fill" hide={category !== 1}>
        <GroundItems />
      </layer>
    </layer>
  );
}

function LootTracking(): Component {
  const universe = useUniverse();
  const outer = useRef();
  const [rowsExtent] = useState(lootRowsExtent);
  const extentRows: Int = rowsExtent;
  const extent: Int = LootLayout.TRACKER_EXTENT_START + extentRows + LootLayout.OVERVIEW_H;
  const contentH: Int = universe.height - LootLayout.CONTENT_INSET;
  const scrolling: Boolean = extent > contentH;
  return (
    <>
      <layer
        x={LootLayout.CONTENT_X}
        y="center"
        w={{ fill: scrolling ? LootLayout.CONTENT_INSET_SCROLLING : LootLayout.CONTENT_INSET }}
        h={{ fill: LootLayout.CONTENT_INSET }}
      >
        <layer ref={outer} x={0} y={0} w="fill" h="fill" scrollHeight={scrolling ? extent : 0}>
          <layer x={0} y={0} w="fill" h={extent}>
            <TrackerViews />
            <OverviewStrip />
          </layer>
        </layer>
      </layer>
      <layer x={{ right: LootLayout.SCROLLBAR_RIGHT }} y={0} w={LootLayout.SCROLLBAR_W} h="fill" hide={!scrolling}>
        {scrolling ? (
          <ScrollbarVertical
            content={outer}
            track={Sprites.SCROLLBAR_DRAGGER_V2_3}
            capTopSprite={Sprites.SCROLLBAR_DRAGGER_V2_0}
            thumbSprite={Sprites.SCROLLBAR_DRAGGER_V2_1}
            capBottomSprite={Sprites.SCROLLBAR_DRAGGER_V2_2}
            arrowUp={Sprites.SCROLLBAR_V2_0}
            arrowDown={Sprites.SCROLLBAR_V2_1}
          />
        ) : null}
      </layer>
    </>
  );
}

function TrackerViews(): Component {
  const groupMode: Int = useServerState(Varbits.OPTION_LOOTTRACKER_DISPLAY_GROUP_MODE);
  const [synced] = useState(lootGroupViewSynced);
  const viewSynced: Int = synced;
  return (
    <>
      <layer
        x="center"
        y={LootLayout.OVERVIEW_H}
        w="fill"
        h={{ fill: LootLayout.OVERVIEW_H }}
        hide={dropsHidden(viewSynced, groupMode)}
      />
      <layer
        x="center"
        y={LootLayout.OVERVIEW_H}
        w="fill"
        h={{ fill: LootLayout.OVERVIEW_H }}
        hide={sourcesHidden(viewSynced, groupMode)}
      />
    </>
  );
}

function OverviewStrip(): Component {
  const host = useRef();
  const ignored: Int = useServerState(Varbits.OPTION_LOOTTRACKER_DISPLAY_IGNORED_ENTRIES);
  const valueMode: Int = useServerState(Varbits.OPTION_LOOTTRACKER_DISPLAY_VALUE_MODE);
  const groupMode: Int = useServerState(Varbits.OPTION_LOOTTRACKER_DISPLAY_GROUP_MODE);
  const [synced] = useState(lootGroupViewSynced);
  const [named] = useState(lootNamedRows);
  const [expanded] = useState(lootRowsExpanded);
  const [count] = useState(lootTotalCount);
  const [value] = useState(lootTotalValue);
  const viewSynced: Int = synced;
  const universe = useUniverse();
  const stripW: Int = universe.width;
  const anyExpanded: Int = named > 0 ? expanded : 0;

  useWatch(Varps.SETTINGS_VARP_EHC_5, () => lootGroupViewSynced4850(), host);

  return (
    <layer ref={host} x="center" y={0} w="fill" h={LootLayout.OVERVIEW_H}>
      <sprite x={0} y={0} w="fill" h="fill" sprite={Sprites.TRADEBACKING_DARK} />
      <IconButton
        x={fromRight(stripW, LootLayout.ICON_IGNORE_RIGHT)}
        sprite={ignoreModeSprite(ignored)}
        option={ignoreModeOption(ignored)}
        subject={LootCopy.IGNORED_ITEMS}
        action={LootButton.IGNORED}
        state={ignored}
      />
      <IconButton
        x={fromRight(stripW, LootLayout.ICON_COLLAPSE_RIGHT)}
        sprite={collapseSprite(anyExpanded)}
        option={collapseOption(anyExpanded)}
        subject={LootCopy.ALL_ENTRIES}
        action={LootButton.COLLAPSE}
        state={0}
      />
      <IconButton
        x={fromRight(stripW, LootLayout.ICON_VALUE_RIGHT)}
        sprite={valueModeSprite(valueMode)}
        option={LootCopy.SWITCH_TO}
        subject={valueModeSubject(valueMode)}
        action={LootButton.VALUE_MODE}
        state={valueMode}
      />
      <IconButton
        x={LootLayout.ICON_GROUP_X}
        sprite={groupViewSprite(viewSynced, groupMode)}
        option={LootCopy.SWITCH_TO_GROUP}
        subject={groupViewSubject(viewSynced, groupMode)}
        action={LootButton.GROUP_MODE}
        state={groupMode}
      />
      <text
        x={LootLayout.TOTALS_LABEL_X}
        y="center"
        w={LootLayout.TOTALS_LABEL_W}
        h={LootLayout.TOTALS_H}
        text={LootCopy.TOTALS_LABEL}
        font={LootFonts.P11}
        color={LootColors.WHITE}
        shadow
        align="left"
        valign="middle"
      />
      <text
        x={LootLayout.TOTALS_VALUE_X}
        y="center"
        w={{ fill: LootLayout.TOTALS_VALUE_X }}
        h={LootLayout.TOTALS_H}
        text={totalsText(count, value)}
        font={LootFonts.P11}
        color={LootColors.WHITE}
        shadow
        align="left"
        valign="middle"
      />
      <ThinBoxEntrypoint />
    </layer>
  );
}

function fromRight(stripW: Int, inset: Int): Int {
  return stripW - inset - LootLayout.ICON;
}

const enum LootButton {
  IGNORED = 0,
  COLLAPSE = 1,
  VALUE_MODE = 2,
  GROUP_MODE = 3,
}

function lootButtonOp(action: Int, state: Int): void {
  if (action === LootButton.IGNORED) {
    lootToggleIgnored(state);
  } else if (action === LootButton.COLLAPSE) {
    lootToggleCollapse();
  } else if (action === LootButton.VALUE_MODE) {
    lootToggleValueMode(state);
  } else if (action === LootButton.GROUP_MODE) {
    lootToggleGroupMode(state);
  }
}

function IconButton({
  x,
  sprite,
  option,
  subject,
  action,
  state,
}: {
  x: Int;
  sprite: Sprite;
  option: String;
  subject: String;
  action: Int;
  state: Int;
}): Component {
  const [hover, setHover] = useState(0);
  return (
    <sprite
      x={x}
      y="center"
      w={LootLayout.ICON}
      h={LootLayout.ICON}
      sprite={sprite}
      transparency={hover}
      options={[option]}
      optionSubject={subject}
      onOptionSelect={() => lootButtonOp(action, state)}
      onMouseRepeat={() => setHover(LootLayout.ICON_HOVER)}
      onMouseLeave={() => setHover(0)}
    />
  );
}

function GroundItems(): Component {
  const universe = useUniverse();
  const outer = useRef();
  const contentH: Int = universe.height - LootLayout.CONTENT_INSET;
  const scrolling: Boolean = contentH < LootLayout.GROUND_TALL;
  const innerH: Int = scrolling ? LootLayout.GROUND_INNER_H : contentH;
  const bottomH: Int = scrolling ? LootLayout.BOTTOM_SCROLLING : LootLayout.BOTTOM;
  const listsInset: Int = scrolling ? LootLayout.LISTS_INSET_SCROLLING : LootLayout.LISTS_INSET;
  const listsBottom: Int = scrolling ? LootLayout.LISTS_BOTTOM_SCROLLING : LootLayout.LISTS_BOTTOM;
  return (
    <>
      <layer
        x={LootLayout.CONTENT_X}
        y="center"
        w={{ fill: scrolling ? LootLayout.CONTENT_INSET_SCROLLING : LootLayout.CONTENT_INSET }}
        h={{ fill: LootLayout.CONTENT_INSET }}
      >
        <layer ref={outer} x={0} y={0} w="fill" h="fill" scrollHeight={scrolling ? LootLayout.GROUND_INNER_H : 0}>
          <layer x={0} y={0} w="fill" h={innerH}>
            <GroundTop />
            <layer x={0} y={{ bottom: listsBottom }} w="fill" h={{ fill: listsInset }}>
              <layer x={0} y={0} w="fill" h="50%">
                <text
                  x={0}
                  y={0}
                  w="fill"
                  h={LootLayout.LIST_TITLE_H}
                  text={LootCopy.HIGHLIGHTED}
                  font={LootFonts.B12}
                  color={LootColors.ORANGE}
                  shadow
                  align="left"
                  valign="middle"
                />
                <layer x={0} y="bottom" w="fill" h={{ fill: LootLayout.LIST_TITLE_H }}>
                  <GroundList vector={GroundVector.HIGHLIGHTS} />
                </layer>
              </layer>
              <layer x={0} y="bottom" w="fill" h="50%">
                <text
                  x={0}
                  y={0}
                  w="fill"
                  h={LootLayout.LIST_TITLE_H}
                  text={LootCopy.FILTERED}
                  font={LootFonts.B12}
                  color={LootColors.ORANGE}
                  shadow
                  align="left"
                  valign="middle"
                />
                <layer x={0} y="bottom" w="fill" h={{ fill: LootLayout.LIST_TITLE_H }}>
                  <GroundList vector={GroundVector.FILTER} />
                </layer>
              </layer>
            </layer>
            <layer x={0} y="bottom" w="fill" h={bottomH}>
              <text
                x={0}
                y="bottom"
                w="fill"
                h="fill"
                text={LootCopy.HELP}
                font={LootFonts.P11}
                color={LootColors.ORANGE}
                shadow
                align="left"
                valign="top"
              />
            </layer>
          </layer>
        </layer>
      </layer>
      <layer x={{ right: LootLayout.SCROLLBAR_RIGHT }} y={0} w={LootLayout.SCROLLBAR_W} h="fill" hide={!scrolling}>
        {scrolling ? (
          <ScrollbarVertical
            content={outer}
            track={Sprites.SCROLLBAR_DRAGGER_V2_3}
            capTopSprite={Sprites.SCROLLBAR_DRAGGER_V2_0}
            thumbSprite={Sprites.SCROLLBAR_DRAGGER_V2_1}
            capBottomSprite={Sprites.SCROLLBAR_DRAGGER_V2_2}
            arrowUp={Sprites.SCROLLBAR_V2_0}
            arrowDown={Sprites.SCROLLBAR_V2_1}
          />
        ) : null}
      </layer>
    </>
  );
}

function GroundTop(): Component {
  const enabled: Int = useServerState(Varbits.GROUND_ITEMS_ENABLED);
  const overlayRow = GroundItemsOverlayStruct.at(0);
  let title: String = '';
  if (overlayRow !== null) {
    title = overlayRow.param1086;
  }
  return (
    <layer x={0} y={0} w="fill" h={LootLayout.GROUND_TOP_H}>
      <rect
        x="center"
        y={0}
        w="fill"
        h={LootLayout.GROUND_TOP_H}
        color={LootColors.WHITE}
        fill
        transparency={255}
        options={[LootCopy.TOGGLE]}
        onOptionSelect={() => groundItemsToggle(enabled)}
      />
      <text
        x={0}
        y={0}
        w={{ fill: LootLayout.GROUND_TOP_TEXT_INSET }}
        h={LootLayout.GROUND_TOP_H}
        text={title}
        font={LootFonts.B12}
        color={LootColors.ORANGE}
        shadow
        align="left"
        valign="middle"
        lineHeight={LootLayout.GROUND_TOP_LINE}
      />
      <sprite
        x={{ right: 0 }}
        y={LootLayout.GROUND_TOP_H / 2 - LootLayout.TOGGLE / 2}
        w={LootLayout.TOGGLE}
        h={LootLayout.TOGGLE}
        sprite={enabled === 1 ? Sprites.TOGGLE_BOX_1 : Sprites.TOGGLE_BOX_0}
      />
    </layer>
  );
}

function GroundList({ vector }: { vector: Int }): Component {
  const universe = useUniverse();
  const [revision] = useState(groundListsRevision);
  const built: Int = revision;
  const fieldW: Int = universe.width - LootLayout.FIELD_INSET;
  const text: String = built >= 0 ? groundVectorJoined(vector) : '';
  return (
    <>
      <ThinBoxOutline />
      <rect
        x="center"
        y="center"
        w={{ fill: LootLayout.FIELD_BACK_INSET }}
        h={{ fill: LootLayout.FIELD_BACK_INSET }}
        color={LootColors.FIELD_BACK}
        fill
      />
      <input
        x="center"
        y="center"
        w={{ fill: LootLayout.FIELD_INSET }}
        h={{ fill: LootLayout.FIELD_INSET }}
        lineWrapWidth={fieldW - LootLayout.FIELD_WRAP_INSET}
        font={LootFonts.P12}
        color={LootColors.WHITE}
        shadow
        align="left"
        valign="top"
        selectColor={LootColors.SELECT}
        selectBgColor={LootColors.SELECT_BG}
        text={text}
      />
    </>
  );
}
