function resetRequests(): void {
  const [, setBuilt] = useState(buffBarBuilt);
  const [initSeq] = useState(buffBarInitSeq);
  const [, setInitApplied] = useState(buffBarInitApplied);
  const [redrawSeq] = useState(buffBarRedrawSeq);
  const [, setRedrawApplied] = useState(buffBarRedrawApplied);
  const [, setLayout] = useState(buffBarLayoutSeq);
  const [, setStarts0] = useState(buffBarStarts0);
  const [, setStarts1] = useState(buffBarStarts1);
  const [, setStarts2] = useState(buffBarStarts2);
  const [, setStarts3] = useState(buffBarStarts3);
  const [, setStarts4] = useState(buffBarStarts4);
  setBuilt(0);
  setInitApplied(initSeq);
  setRedrawApplied(redrawSeq);
  setLayout(0);
  setStarts0(0);
  setStarts1(0);
  setStarts2(0);
  setStarts3(0);
  setStarts4(0);
}

function BuffCell({
  slot,
  index,
  gridW,
  gridH,
  place,
  top,
  stack,
  icon,
  badge,
  itemId,
}: {
  slot: Int;
  index: Int;
  gridW: Int;
  gridH: Int;
  place: Int;
  top: Int;
  stack: Int;
  icon: Int;
  badge: Int;
  itemId: Int;
}): Component {
  const row = Buffs.at(slot);
  if (row === null) {
    return null;
  }
  const left: Int = cellX(index, gridW, gridH, place);
  const bottom: Int = cellY(index, gridW, gridH, place);
  const wash: Int = BackingWash.get(row.backing) ?? BACKING_WASH_DEFAULT;
  const edge: Int = BackingEdge.get(row.backing) ?? BACKING_EDGE_DEFAULT;
  const iconLeft: Int = left + 1 + 16 - row.iconW / 2 + row.iconX;
  const iconBottom: Int = bottom + 1 + 16 - row.iconH / 2 + row.iconY;
  const badgeLeft: Int = left + 1 + 16 - row.badgeW / 2;
  const badgeBottom: Int = bottom + 1 + 16 - row.badgeH / 2;
  const label: String = cellLabel(slot, row.kind, row.lowAt, row.cap, top);
  const lower: String = cellLower(row.stacks, row.stackLowAt, stack);
  const labelBottom: Int = bottom + cellLabelDrop(row.textLower);
  const shownItem: Item = CS2.item_uncert(itemId as Item);
  const arm: Int = buffTipArm();
  return (
    <>
      <rect x={left + 1} y={{ bottom: bottom + 1 }} w={32} h={32} color={slot} />
      <rect x={left + 1} y={{ bottom: bottom + 1 }} w={32} h={32} fill color={row.backing} transparency={wash} />
      <rect x={left} y={{ bottom: bottom }} w={1} h={34} fill color={row.backing} transparency={edge} />
      <rect x={left + 33} y={{ bottom: bottom }} w={1} h={34} fill color={row.backing} transparency={edge} />
      <rect x={left + 1} y={{ bottom: bottom }} w={32} h={1} fill color={row.backing} transparency={edge} />
      <rect x={left + 1} y={{ bottom: bottom + 33 }} w={32} h={1} fill color={row.backing} transparency={edge} />
      {icon !== -1 ? (
        <sprite x={iconLeft} y={{ bottom: iconBottom }} w={row.iconW} h={row.iconH} sprite={icon as Sprite} />
      ) : (
        <sprite
          x={iconLeft}
          y={{ bottom: iconBottom }}
          w={row.iconW}
          h={row.iconH}
          outline={1}
          item={shownItem}
          itemCount={100000}
          itemCountMode="never"
        />
      )}
      <sprite
        x={badgeLeft}
        y={{ bottom: badgeBottom }}
        w={row.badgeW}
        h={row.badgeH}
        sprite={badge as Sprite}
        hide={badge === -1}
      />
      <text
        x={left}
        y={{ bottom: labelBottom }}
        w={34}
        h={12}
        color={0xffffff}
        font={row.font as Font}
        shadow
        align="center"
        valign="middle"
        text={label}
      />
      <text
        x={left}
        y={{ bottom: bottom + 21 }}
        w={34}
        h={12}
        color={0xffffff}
        font={494 as Font}
        shadow
        align="center"
        valign="middle"
        text={lower}
      />
      <rect
        x={left}
        y={{ bottom: bottom }}
        w={34}
        h={34}
        color={0}
        transparency={255}
        noClickThrough={arm === TIP_TAP}
        onClick={arm === TIP_TAP ? () => tapBuffTip(slot, index, left, bottom) : null}
        onMouseRepeat={arm === TIP_HOVER ? () => showBuffTip(slot, index, left, bottom) : null}
        onMouseLeave={arm === TIP_HOVER ? () => hideBuffTip() : null}
      />
    </>
  );
}

function widthOf(component: ComponentId): Int {
  return CS2.if_width_get(component);
}

function heightOf(component: ComponentId): Int {
  return CS2.if_height_get(component);
}

function BuffTooltip(): Component {
  const [slot] = useState(buffTipSlot);
  const [left] = useState(buffTipLeft);
  const [bottom] = useState(buffTipBottom);
  const [open] = useState(buffBarTooltip);
  useInterval(open !== -1 ? () => expireBuffTip() : undefined);

  let text: String = '';
  if (slot !== -1) {
    text = buffTipText(slot);
  }
  const hostW: Int = widthOf(dodgerRef);
  const hostH: Int = heightOf(dodgerRef);
  let measure: Int = BUFF_TIP_WRAP;
  if (measure > hostW) {
    measure = hostW;
  }
  measure = measure - TooltipBox.padX;
  const boxW: Int = TooltipBox.padX + textWidth(text, measure, TooltipBox.font);
  const boxH: Int = TooltipBox.padY + TooltipBox.line * textLineCount(text, measure, TooltipBox.font);
  const anchorX: Int = absoluteX(buffDisplayRef) + left;
  const anchorY: Int = absoluteY(buffDisplayRef) + heightOf(buffDisplayRef) - bottom - 34;
  let x: Int = anchorX + TooltipBox.nudge;
  if (x > hostW - boxW) {
    x = hostW - boxW;
  }
  let y: Int = anchorY + 34 + TooltipBox.nudge;
  if (y > hostH - boxH) {
    y = anchorY - boxH - TooltipBox.nudge;
  }

  if (slot !== -1) {
    tooltipRef.props = { x: x, y: y, w: boxW, h: boxH };
  }
  if (slot === -1) {
    return <layer x={0} y={0} w={1} h={1} />;
  }
  return (
    <layer x={0} y={0} w={boxW} h={boxH}>
      <TooltipChrome text={text} font={TooltipBox.font} lineHeight={0} />
    </layer>
  );
}

function cellLabel(slot: Int, kind: Int, lowAt: Int, cap: Int, top: Int): String {
  if (hasLabel(kind) && top !== EMPTY) {
    return buffLabel(slot, kind, lowAt, cap, top);
  }
  return '';
}

function cellLower(stacks: Int, stackLowAt: Int, stack: Int): String {
  if (stacks === 1 && stack !== EMPTY) {
    return stackLabel(stackLowAt, stack);
  }
  return '';
}

function cellLabelDrop(textLower: Int): Int {
  if (textLower === 1) {
    return 6;
  }
  return 1;
}
