function BuffListener0(): Component {
  const me = createRef();
  useWatch(
    Varps.DEADMAN_TRANSMITTING_PERM,
    () => {
      const [mask0, setMask0] = useState(buffBarTransmits0);
      let raised0: Int = mask0;
      if (!hasBit(raised0, 1)) {
        raised0 = raised0 + Math.pow(2, 1);
      }
      if (!hasBit(raised0, 5)) {
        raised0 = raised0 + Math.pow(2, 5);
      }
      setMask0(raised0);
    },
    me,
  );
  return <layer ref={me} x={0} y={0} w={1} h={1} />;
}

