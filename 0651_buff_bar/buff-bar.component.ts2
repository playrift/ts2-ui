                      setP1(top);
                      setQ1(stack);
                      setG1(sprite);
                      setB1(badge);
                      setI1(item);
                    }
                    case 2: {
                      setD2(slot);
                      setP2(top);
                      setQ2(stack);
                      setG2(sprite);
                      setB2(badge);
                      setI2(item);
                    }
                    case 3: {
                      setD3(slot);
                      setP3(top);
                      setQ3(stack);
                      setG3(sprite);
                      setB3(badge);
                      setI3(item);
                    }
                    case 4: {
                      setD4(slot);
                      setP4(top);
                      setQ4(stack);
                      setG4(sprite);
                      setB4(badge);
                      setI4(item);
                    }
                    case 5: {
                      setD5(slot);
                      setP5(top);
                      setQ5(stack);
                      setG5(sprite);
                      setB5(badge);
                      setI5(item);
                    }
                    case 6: {
                      setD6(slot);
                      setP6(top);
                      setQ6(stack);
                      setG6(sprite);
                      setB6(badge);
                      setI6(item);
                    }
                    case 7: {
                      setD7(slot);
                      setP7(top);
                      setQ7(stack);
                      setG7(sprite);
                      setB7(badge);
                      setI7(item);
                    }
                    case 8: {
                      setD8(slot);
                      setP8(top);
                      setQ8(stack);
                      setG8(sprite);
                      setB8(badge);
                      setI8(item);
                    }
                    case 9: {
                      setD9(slot);
                      setP9(top);
                      setQ9(stack);
                      setG9(sprite);
                      setB9(badge);
                      setI9(item);
                    }
                    case 10: {
                      setD10(slot);
                      setP10(top);
                      setQ10(stack);
                      setG10(sprite);
                      setB10(badge);
                      setI10(item);
                    }
                    case 11: {
                      setD11(slot);
                      setP11(top);
                      setQ11(stack);
                      setG11(sprite);
                      setB11(badge);
                      setI11(item);
                    }
                  }
                  shown = shown + 1;
                }
              }
            }
            walk = walk + 1;
          }
          const [layout, setLayout] = useState(buffBarLayoutSeq);
          setLayout(layout + 1);
          relayContent();
        }
        setShownCount(shown);
        const [, setShownSession] = useState(buffBarShownCount);
        setShownSession(shown);
        buffTipsRebuilt(shown);
        const [laidW] = useState(buffBarContentW);
        const [laidH] = useState(buffBarContentH);
        setGridW(laidW);
        setGridH(laidH);
        setGridPlace(placeMode());
      }
    },
    host,
  );

  const slots = intArray(12);
  slots[0] = d0;
  slots[1] = d1;
  slots[2] = d2;
  slots[3] = d3;
  slots[4] = d4;
  slots[5] = d5;
  slots[6] = d6;
  slots[7] = d7;
  slots[8] = d8;
  slots[9] = d9;
  slots[10] = d10;
  slots[11] = d11;
  const tops = intArray(12);
  tops[0] = p0;
  tops[1] = p1;
  tops[2] = p2;
  tops[3] = p3;
  tops[4] = p4;
  tops[5] = p5;
  tops[6] = p6;
  tops[7] = p7;
  tops[8] = p8;
  tops[9] = p9;
  tops[10] = p10;
  tops[11] = p11;
  const stacks = intArray(12);
  stacks[0] = q0;
  stacks[1] = q1;
  stacks[2] = q2;
  stacks[3] = q3;
  stacks[4] = q4;
  stacks[5] = q5;
  stacks[6] = q6;
  stacks[7] = q7;
  stacks[8] = q8;
  stacks[9] = q9;
  stacks[10] = q10;
  stacks[11] = q11;
  const sprites = intArray(12);
  sprites[0] = g0;
  sprites[1] = g1;
  sprites[2] = g2;
  sprites[3] = g3;
  sprites[4] = g4;
  sprites[5] = g5;
  sprites[6] = g6;
  sprites[7] = g7;
  sprites[8] = g8;
  sprites[9] = g9;
  sprites[10] = g10;
  sprites[11] = g11;
  const badges = intArray(12);
  badges[0] = b0;
  badges[1] = b1;
  badges[2] = b2;
  badges[3] = b3;
  badges[4] = b4;
  badges[5] = b5;
  badges[6] = b6;
  badges[7] = b7;
  badges[8] = b8;
  badges[9] = b9;
  badges[10] = b10;
  badges[11] = b11;
  const items = intArray(12);
  items[0] = i0;
  items[1] = i1;
  items[2] = i2;
  items[3] = i3;
  items[4] = i4;
  items[5] = i5;
  items[6] = i6;
  items[7] = i7;
  items[8] = i8;
  items[9] = i9;
  items[10] = i10;
  items[11] = i11;
  return (
    <layer ref={host} x={0} y={0} w="fill" h="fill">
      {slots.map((slot, index) =>
        index < shownCount ? (
          <BuffCell
            slot={slot}
            index={index}
            gridW={gridW}
            gridH={gridH}
            place={gridPlace}
            top={tops[index]}
            stack={stacks[index]}
            icon={sprites[index]}
            badge={badges[index]}
            itemId={items[index]}
          />
        ) : null,
      )}
    </layer>
  );
}

