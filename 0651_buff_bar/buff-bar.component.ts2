const EMPTY = -2147483648;

export const dodgerRef = createRef('buff_bar_dodger');
export const contentRef = createRef('buff_bar_content');
export const tooltipRef = createRef('buff_bar_tooltip');

export function BuffBar(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <BuffLayout />

      <BuffListeners />

      <layer ref={dodgerRef} x={0} y={0} w="fill" h="fill">
        <layer static ref={contentRef} x={0} y={0} w="fill" h="fill">
          <layer static ref={buffDisplayRef} x={0} y={0} w="fill" h="fill">
            <BuffGrid />
          </layer>
          <layer x="center" y="center" w="fill" h="fill" />
        </layer>
        <layer static ref={tooltipRef} x={0} y={0} w={1} h={1}>
          <BuffTooltip />
        </layer>
      </layer>

      <layer x={0} y={0} w="fill" h="fill" />
    </layer>
  );
}

function BuffLayout(): Component {
  const [laid] = useState(buffBarLayoutSeq);
  const [dodgerUpdate] = useState(buffBarDodgerUpdate);
  const frame: Int = toplevelComponents();
  const x: Int = contentX(frame);
  const y: Int = contentY(frame);
  const w: Int = contentW(frame);
  const h: Int = contentH(frame);
  const fromRight: Boolean = contentFromRight(frame);
  const dodges: Boolean = contentDodges(frame);
  onMounted(() => placeContent(laid, frame, x, y, w, h, fromRight, dodges));
  onUpdated(() => placeContent(laid, frame, x, y, w, h, fromRight, dodges));
  return <layer x={0} y={0} w={0} h={0} hide={laid === 0 || dodgerUpdate === EMPTY} />;
}

function placeContent(
  laid: Int,
  frame: Int,
  x: Int,
  y: Int,
  w: Int,
  h: Int,
  fromRight: Boolean,
  dodges: Boolean,
): void {
  if (laid === 0) {
    return;
  }
  contentRef.props = { x: fromRight ? { right: x } : x, y: { bottom: y }, w: w, h: h };
  const [, setLaidW] = useState(buffBarContentW);
  const [, setLaidH] = useState(buffBarContentH);
  setLaidW(w);
  setLaidH(h);
  if (dodges) {
    overlayInit(dodgerRef, contentRef, dodgeWord(frame), dodgeXAnchor(frame), dodgeYAnchor(frame), 0);
  }
}

function relayContent(): void {
  const frame: Int = toplevelComponents();
  placeContent(
    1,
    frame,
    contentX(frame),
    contentY(frame),
    contentW(frame),
    contentH(frame),
    contentFromRight(frame),
    contentDodges(frame),
  );
}

