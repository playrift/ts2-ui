import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile } from '../lib/lib.helpers';
import { Anchor, mobileGameframe } from '../lib/lib.overlay';

export const CELL = 37;

const DODGE_MOBILE = 32770;
const DODGE_DESKTOP = 28672;

function desktopFrame(frame: Int): Boolean {
  return (
    frame === ToplevelComponents.STRETCH || frame === ToplevelComponents.PRE_EOC || frame === ToplevelComponents.FIXED
  );
}

export function contentDodges(frame: Int): Boolean {
  return mobileGameframe(frame) || desktopFrame(frame);
}

export function contentX(frame: Int): Int {
  if (mobileGameframe(frame) || desktopFrame(frame)) {
    return 1;
  }
  return 0;
}

export function contentY(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return 29;
  }
  if (desktopFrame(frame)) {
    return 1;
  }
  return 0;
}

export function contentFromRight(frame: Int): Boolean {
  return mobileGameframe(frame);
}

export function contentW(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return 91;
  }
  if (frame === ToplevelComponents.STRETCH || frame === ToplevelComponents.PRE_EOC) {
    return 497;
  }
  if (frame === ToplevelComponents.FIXED) {
    return 320;
  }
  return 1;
}

export function contentH(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return 249;
  }
  if (frame === ToplevelComponents.STRETCH || frame === ToplevelComponents.PRE_EOC) {
    return 79;
  }
  if (frame === ToplevelComponents.FIXED) {
    return 40;
  }
  return 1;
}

export function dodgeWord(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return DODGE_MOBILE;
  }
  return DODGE_DESKTOP;
}

export function dodgeXAnchor(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return Anchor.RIGHT;
  }
  return Anchor.LEFT;
}

export function dodgeYAnchor(frame: Int): Int {
  if (mobileGameframe(frame)) {
    return Anchor.CENTRE;
  }
  return Anchor.BOTTOM;
}

export function placeMode(): Int {
  if (onMobile()) {
    return 1;
  }
  if (useServerState(Varbits.BUFF_BAR_LOCATION) === 0) {
    return 0;
  }
  return 2;
}

export function cellX(index: Int, width: Int, height: Int, mode: Int): Int {
  const across: Int = width / CELL;
  const down: Int = height / CELL;
  if (index >= across * down) {
    return -1;
  }
  if (mode === 1) {
    return 2 + across * CELL - CELL * (index / down) - CELL + (width - (across * CELL + 1));
  }
  if (mode === 2) {
    return 2 + CELL * (index / down);
  }
  return 2 + CELL * (index % across);
}

export function cellY(index: Int, width: Int, height: Int, mode: Int): Int {
  const across: Int = width / CELL;
  const down: Int = height / CELL;
  if (index >= across * down) {
    return -1;
  }
  if (mode === 1 || mode === 2) {
    return 2 + CELL * (index % down);
  }
  return 2 + CELL * (index / across);
}
