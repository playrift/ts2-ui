import { useServerState } from 'ts2';

import { Fragments } from '../0735_league_3_fragments/fragments.data';
import { RelicReloaded } from '../0529_league_summary/league-summary.data';
import { Varbits } from '../lib/game/varbits';
import { LeagueRelicTiers } from '../lib/league-relics.data';
import {
  FragmentBuffBadges,
  FragmentBuffIcons,
  MasteryMagicBuffIcons,
  MasteryMeleeBuffIcons,
  MasteryRangedBuffIcons,
  RelicBuffIcons,
} from './buff-tables.data';

function fragmentIcon(fragment: Int): Int {
  if (fragment <= 0) {
    return -1;
  }
  const row = Fragments.get(fragment);
  if (row === null) {
    return -1;
  }
  return FragmentBuffIcons.at(row.icon) ?? -1;
}

function fragmentBadge(fragment: Int): Int {
  if (fragment <= 0) {
    return -1;
  }
  const row = Fragments.get(fragment);
  if (row === null) {
    return -1;
  }
  return FragmentBuffBadges.at(row.icon) ?? -1;
}

function reloadedTier(): Int {
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_0) > 0) {
    return 0;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_1) > 0) {
    return 1;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_2) > 0) {
    return 2;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_3) > 0) {
    return 3;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_4) > 0) {
    return 4;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_5) > 0) {
    return 5;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_6) > 0) {
    return 6;
  }
  if (useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_7) > 0) {
    return 7;
  }
  return -1;
}

function otherSelection(tier: Int): Int {
  switch (tier) {
    case 0:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_0);
    case 1:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_1);
    case 2:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_2);
    case 3:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_3);
    case 4:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_4);
    case 5:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_5);
    case 6:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_6);
    case 7:
      return useServerState(Varbits.LEAGUE_RELIC_SELECTION_OTHER_7);
  }
  return 0;
}

function selectedRelic(tier: Int, selection: Int): Int {
  if (selection <= 0) {
    return -1;
  }
  const tiers = LeagueRelicTiers.get(useServerState(Varbits.LEAGUE_TYPE));
  if (tiers === null) {
    return -1;
  }
  const selections = tiers.get(tier);
  if (selections === null) {
    return -1;
  }
  return selections.get(selection) ?? -1;
}

function relicBuffIcon(tier: Int, selection: Int): Int {
  const relic: Int = selectedRelic(tier, selection);
  if (relic === -1) {
    return -1;
  }
  let shown: Int = relic;
  if (RelicReloaded.get(relic) ?? false) {
    const pickedTier: Int = reloadedTier();
    if (pickedTier !== -1) {
      const picked: Int = selectedRelic(pickedTier, otherSelection(pickedTier));
      if (picked !== -1) {
        shown = picked;
      }
    }
  }
  return RelicBuffIcons.get(shown) ?? -1;
}

export function valueSprite(slot: Int): Int {
  switch (slot) {
    case 49:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_0));
    case 50:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_1));
    case 51:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_2));
    case 52:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_3));
    case 53:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_4));
    case 54:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_5));
    case 55:
      return fragmentIcon(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_6));
    case 101:
      return relicBuffIcon(0, useServerState(Varbits.LEAGUE_RELIC_SELECTION_0));
    case 102:
      return relicBuffIcon(1, useServerState(Varbits.LEAGUE_RELIC_SELECTION_1));
    case 103:
      return relicBuffIcon(2, useServerState(Varbits.LEAGUE_RELIC_SELECTION_2));
    case 104:
      return relicBuffIcon(3, useServerState(Varbits.LEAGUE_RELIC_SELECTION_3));
    case 105:
      return relicBuffIcon(4, useServerState(Varbits.LEAGUE_RELIC_SELECTION_4));
    case 106:
      return relicBuffIcon(5, useServerState(Varbits.LEAGUE_RELIC_SELECTION_5));
    case 107:
      return relicBuffIcon(6, useServerState(Varbits.LEAGUE_RELIC_SELECTION_6));
    case 108:
      return relicBuffIcon(7, useServerState(Varbits.LEAGUE_RELIC_SELECTION_7));
    case 123:
      return MasteryMeleeBuffIcons.get(useServerState(Varbits.LEAGUE_COMBAT_MASTERY_MELEE_PROGRESS)) ?? -1;
    case 124:
      return MasteryRangedBuffIcons.get(useServerState(Varbits.LEAGUE_COMBAT_MASTERY_RANGED_PROGRESS)) ?? -1;
    case 125:
      return MasteryMagicBuffIcons.get(useServerState(Varbits.LEAGUE_COMBAT_MASTERY_MAGIC_PROGRESS)) ?? -1;
    case 134:
      return 7840;
    case 133:
      return 7839;
  }
  return -1;
}

export function valueBadge(slot: Int): Int {
  switch (slot) {
    case 49:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_0));
    case 50:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_1));
    case 51:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_2));
    case 52:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_3));
    case 53:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_4));
    case 54:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_5));
    case 55:
      return fragmentBadge(useServerState(Varbits.LEAGUE_3_FRAGMENT_LOADOUT_SLOT_6));
  }
  return -1;
}
