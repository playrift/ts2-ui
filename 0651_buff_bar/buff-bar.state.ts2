function builtOrPending(): Boolean {
  const [built] = useState(buffBarBuilt);
  const [seq] = useState(buffBarInitSeq);
  const [applied] = useState(buffBarInitApplied);
  if (built === 1) {
    return true;
  }
  return seq !== applied;
}

function queueStart(slot: Int): void {
  const [, setClock] = useState(buffBarStartClock);
  setClock(clientClock());
  const bit: Int = slot % 30;
  const cell: Int = slot / 30;
  if (cell === 0) {
    const [bits, setBits] = useState(buffBarStarts0);
    if (!hasBit(bits, bit)) {
      setBits(bits + Math.pow(2, bit));
    }
  }
  if (cell === 1) {
    const [bits, setBits] = useState(buffBarStarts1);
    if (!hasBit(bits, bit)) {
      setBits(bits + Math.pow(2, bit));
    }
  }
  if (cell === 2) {
    const [bits, setBits] = useState(buffBarStarts2);
    if (!hasBit(bits, bit)) {
      setBits(bits + Math.pow(2, bit));
    }
  }
  if (cell === 3) {
    const [bits, setBits] = useState(buffBarStarts3);
    if (!hasBit(bits, bit)) {
      setBits(bits + Math.pow(2, bit));
    }
  }
  if (cell === 4) {
    const [bits, setBits] = useState(buffBarStarts4);
    if (!hasBit(bits, bit)) {
      setBits(bits + Math.pow(2, bit));
    }
  }
}

export function buffBarInit(): void {
  const [seq, setSeq] = useState(buffBarInitSeq);
  const [, setClock] = useState(buffBarInitClock);
  setClock(clientClock());
  setSeq(seq + 1);
}

export function buffBarStart(slot: Int, value: Int): void {
  buffStartWrite(slot, value);
  if (builtOrPending()) {
    queueStart(slot);
  }
}

export function buffBarStartIfBuilt(slot: Int, value: Int): void {
  if (builtOrPending()) {
    buffStartWrite(slot, value);
    queueStart(slot);
  }
}

export function buffBarRedraw(): void {
  const [seq, setSeq] = useState(buffBarRedrawSeq);
  setSeq(seq + 1);
}

export function stackCount(slot: Int): Int {
  if (slot === 42) {
    const poison: Int = useServerState(Varps.POISON);
    if (poison > 0 && poison < 1000000) {
      return poisonStacks(poison);
    }
  }
  if (slot === 43) {
    const venom: Int = useServerState(Varps.POISON);
    if (venom >= 1000000) {
      return venomStacks(venom);
    }
  }
  if (slot === 120) {
    if (useServerState(Varbits.PLAYER_OWN_BURN_DAMAGE_HITSPLAT_SIZE) > 0) {
      return useServerState(Varbits.PLAYER_OWN_BURN_DAMAGE_HITSPLAT_SIZE);
    }
  }
  if (slot === 93) {
    const decay: Int = useServerState(Varbits.WBR_DECAY_STATE);
    if (decay === 50) {
      return 1 + (decay - 5) / 5;
    }
    if (decay < 5) {
      return 1;
    }
    const tier: Int = 1 + (decay - 5) / 5;
    if (decay % 5 === 5 - 1) {
      return tier + 1;
    }
    return tier;
  }
  if (slot === 132) {
    return useServerState(Varbits.SAILING_BOAT_SPEEDBOOST_DURATION);
  }
  return 0;
}

export function poisonStacks(poison: Int): Int {
  let damage: Int = poison;
  if (damage > 100) {
    damage = 100;
  }
  return (damage + 4) / 5;
}

export function venomStacks(venom: Int): Int {
  const stacks: Int = (venom - 1000000) * 2 + 6;
  if (stacks > 20) {
    return 20;
  }
  return stacks;
}

export function ammoItem(slot: Int): Int {
  if (slot === 41) {
    if (useServerState(Varps.BUFF_BAR_AMMO_TYPE) !== -1) {
      return useServerState(Varps.BUFF_BAR_AMMO_TYPE);
    }
    return useServerState(Varps.BUFF_BAR_WEAPON);
  }
  if (slot === 40) {
    return useServerState(Varps.BUFF_BAR_AMMO_TYPE);
  }
  return -1;
}
