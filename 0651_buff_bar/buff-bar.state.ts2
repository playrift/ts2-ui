  }
  if (slot === 10) {
    const [, set_buffAntipoisonStart] = useState(buffAntipoisonStart);
    set_buffAntipoisonStart(value);
  }
  if (slot === 27) {
    const [, set_buffAntipoisonStart] = useState(buffAntipoisonStart);
