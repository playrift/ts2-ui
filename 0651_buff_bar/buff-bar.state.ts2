  }
  if (slot === 91) {
    const [, set_buffToaMidraidlootEnergyEnd] = useState(buffToaMidraidlootEnergyEnd);
    set_buffToaMidraidlootEnergyEnd(value);
  }
  if (slot === 92) {
    const [, set_buffToaMidraidlootStatsEnd] = useState(buffToaMidraidlootStatsEnd);
    set_buffToaMidraidlootStatsEnd(value);
  }
  if (slot === 93) {
    const [, set_buffBarExitCaveDebuffStart] = useState(buffBarExitCaveDebuffStart);
    set_buffBarExitCaveDebuffStart(value);
  }
  if (slot === 94) {
    const [, set_buffBleedEnd] = useState(buffBleedEnd);
    set_buffBleedEnd(value);
  }
  if (slot === 98) {
    const [, set_buffStarOn] = useState(buffStarOn);
    set_buffStarOn(value);
