    }
  }
  if (slot === 54) {
    if (loadoutFilled(5) === true) {
      return 1;
    }
  }
  if (slot === 55) {
    if (loadoutFilled(6) === true) {
      return 1;
    }
  }
  if (slot === 101) {
    if (relicChosen(0) === true) {
      return 1;
    }
  }
  if (slot === 102) {
    if (relicChosen(1) === true) {
      return 1;
    }
  }
  if (slot === 103) {
    if (relicChosen(2) === true) {
      return 1;
    }
  }
  if (slot === 104) {
    if (relicChosen(3) === true) {
      return 1;
    }
  }
  if (slot === 105) {
    if (relicChosen(4) === true) {
      return 1;
    }
  }
  if (slot === 106) {
    if (relicChosen(5) === true) {
      return 1;
    }
  }
  if (slot === 107) {
    if (relicChosen(6) === true) {
      return 1;
    }
  }
  if (slot === 108) {
    if (relicChosen(7) === true) {
      return 1;
    }
  }
  if (slot === 123) {
    if (masteriesShown() === true && useServerState(Varbits.LEAGUE_COMBAT_MASTERY_MELEE_PROGRESS) > 0) {
      return 1;
    }
  }
  if (slot === 124) {
    if (masteriesShown() === true && useServerState(Varbits.LEAGUE_COMBAT_MASTERY_RANGED_PROGRESS) > 0) {
      return 1;
    }
  }
  if (slot === 125) {
    if (masteriesShown() === true && useServerState(Varbits.LEAGUE_COMBAT_MASTERY_MAGIC_PROGRESS) > 0) {
      return 1;
