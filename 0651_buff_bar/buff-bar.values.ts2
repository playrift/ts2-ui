} from './buff-bar.checks';
import { cyclesLeftSince, minutesLeftSince, scaledCount, ticksLeftSince, ticksUntil } from './buff-bar.format';
import { Buffs } from './buffs.data';

export declare const ValueSkills: {
  readonly MAGIC: SkillRef<6>;
};

export function buffValue(slot: Int): Int {
  const row = Buffs.at(slot);
  if (row === null) {
    return 0;
  }
  if (slot === 0) {
    const [cell_buffSireStunStart] = useState(buffSireStunStart);
    if (cell_buffSireStunStart > 0) {
      return cyclesLeftSince(cell_buffSireStunStart, 45 * 30 + 150);
    }
  }
  if (slot === 1) {
    const [cell_buffPlayerFrozenTime] = useState(buffPlayerFrozenTime);
    if (cell_buffPlayerFrozenTime > 0) {
      return ticksUntil(cell_buffPlayerFrozenTime);
    }
  }
  if (slot === 2) {
    const [cell_buffSotdSpecialStart] = useState(buffSotdSpecialStart);
    if (cell_buffSotdSpecialStart > 0) {
      return ticksLeftSince(cell_buffSotdSpecialStart, row.perUnit);
    }
  }
  if (slot === 4) {
    const [cell_buffImbuedHeartStart] = useState(buffImbuedHeartStart);
    if (cell_buffImbuedHeartStart > 0) {
      return scaledCount(cell_buffImbuedHeartStart, useServerState(Varbits.IMBUED_HEART_TIMER), row.perUnit);
    }
  }
  if (slot === 126) {
    const [cell_buffSurgePotionStart] = useState(buffSurgePotionStart);
    if (cell_buffSurgePotionStart > 0) {
      return scaledCount(cell_buffSurgePotionStart, useServerState(Varbits.SURGE_POTION_TIMER), row.perUnit);
    }
  }
  if (slot === 5) {
    const [cell_buffDragonfireShieldStart] = useState(buffDragonfireShieldStart);
    if (cell_buffDragonfireShieldStart > 0) {
      return scaledCount(cell_buffDragonfireShieldStart, useServerState(Varbits.DRAGONFIRE_SHIELD_RECHARGE), 8);
    }
  }
  if (slot === 6) {
    const [cell_buffStaminaPotionStart] = useState(buffStaminaPotionStart);
    if (useServerState(Varbits.STAMINA_ACTIVE) === 1) {
      return scaledCount(cell_buffStaminaPotionStart, useServerState(Varbits.STAMINA_DURATION), 10);
    }
  }
  if (slot === 63) {
    const [cell_buffPrayerEnhanceStart] = useState(buffPrayerEnhanceStart);
    if (
      useServerState(Varbits.RAIDS_PRAYER_ENHANCE_TIER) === 1 &&
      useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER) > 0
    ) {
      return scaledCount(
        cell_buffPrayerEnhanceStart,
        useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER),
        useServerState(Varbits.RAIDS_PRAYERENHANCE_RATE),
      );
    }
  }
  if (slot === 7) {
    const [cell_buffPrayerEnhanceStart] = useState(buffPrayerEnhanceStart);
    if (
      useServerState(Varbits.RAIDS_PRAYER_ENHANCE_TIER) === 2 &&
      useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER) > 0
    ) {
      return scaledCount(
        cell_buffPrayerEnhanceStart,
        useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER),
        useServerState(Varbits.RAIDS_PRAYERENHANCE_RATE),
      );
    }
  }
  if (slot === 64) {
    const [cell_buffPrayerEnhanceStart] = useState(buffPrayerEnhanceStart);
    if (
      useServerState(Varbits.RAIDS_PRAYER_ENHANCE_TIER) === 3 &&
      useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER) > 0
    ) {
      return scaledCount(
        cell_buffPrayerEnhanceStart,
        useServerState(Varbits.RAIDS_PRAYERENHANCE_TIMER),
        useServerState(Varbits.RAIDS_PRAYERENHANCE_RATE),
      );
    }
  }
  if (slot === 61) {
    const [cell_buffOverloadStart] = useState(buffOverloadStart);
    if (useServerState(Varbits.RAIDS_OVERLOAD_TIER) === 1 && cell_buffOverloadStart > 0) {
      return scaledCount(cell_buffOverloadStart, useServerState(Varbits.RAIDS_OVERLOAD_TIMER), 25);
    }
  }
  if (slot === 8) {
    const [cell_buffOverloadStart] = useState(buffOverloadStart);
    if (useServerState(Varbits.RAIDS_OVERLOAD_TIER) === 2 && cell_buffOverloadStart > 0) {
      return scaledCount(cell_buffOverloadStart, useServerState(Varbits.RAIDS_OVERLOAD_TIMER), 25);
    }
  }
  if (slot === 62) {
    const [cell_buffOverloadStart] = useState(buffOverloadStart);
    if (useServerState(Varbits.RAIDS_OVERLOAD_TIER) === 3 && cell_buffOverloadStart > 0) {
      return scaledCount(cell_buffOverloadStart, useServerState(Varbits.RAIDS_OVERLOAD_TIMER), 25);
    }
  }
  if (slot === 14) {
    const [cell_buffOverloadStart] = useState(buffOverloadStart);
    if (cell_buffOverloadStart > 0) {
      return scaledCount(cell_buffOverloadStart, useServerState(Varbits.NZONE_OVERLOAD_POTION_EFFECTS), 25);
    }
  }
  if (slot === 9) {
    const [cell_buffAntifireStart] = useState(buffAntifireStart);
    if (cell_buffAntifireStart > 0) {
      return scaledCount(cell_buffAntifireStart, useServerState(Varbits.ANTIFIRE_POTION), row.perUnit);
    }
  }
  if (slot === 15) {
    const [cell_buffSuperAntifireStart] = useState(buffSuperAntifireStart);
    if (cell_buffSuperAntifireStart > 0) {
      return scaledCount(cell_buffSuperAntifireStart, useServerState(Varbits.SUPER_ANTIFIRE_POTION), row.perUnit);
    }
  }
  if (slot === 10) {
    const [cell_buffAntipoisonStart] = useState(buffAntipoisonStart);
    if (useServerState(Varps.POISON) >= -38 && useServerState(Varps.POISON) < 0) {
      return scaledCount(cell_buffAntipoisonStart, useServerState(Varps.POISON) * -1, row.perUnit);
    }
  }
  if (slot === 27) {
    const [cell_buffAntipoisonStart] = useState(buffAntipoisonStart);
    if (useServerState(Varps.POISON) < -38) {
      return scaledCount(cell_buffAntipoisonStart, (useServerState(Varps.POISON) + 38) * -1, row.perUnit);
    }
  }
  if (slot === 11) {
    const [cell_buffChargeStart] = useState(buffChargeStart);
    if (cell_buffChargeStart > 0) {
      return scaledCount(cell_buffChargeStart, useServerState(Varps.MAGEARENA_CHARGE), 2);
    }
  }
  if (slot === 12) {
    const [cell_buffMagicImbueStart] = useState(buffMagicImbueStart);
    if (cell_buffMagicImbueStart > 0) {
      return scaledCount(cell_buffMagicImbueStart, useServerState(Varbits.MAGIC_IMBUE_ACTIVE), row.perUnit);
    }
  }
  if (slot === 13) {
    const [cell_buffGwdAltarStart] = useState(buffGwdAltarStart);
    if (cell_buffGwdAltarStart > 0) {
      return scaledCount(cell_buffGwdAltarStart, useServerState(Varbits.GODWARS_ALTAR_DELAY), 100);
    }
  }
  if (slot === 110) {
    const [cell_buffRatBossFoodPileStart] = useState(buffRatBossFoodPileStart);
    if (cell_buffRatBossFoodPileStart > 0) {
      return scaledCount(
        cell_buffRatBossFoodPileStart,
        useServerState(Varbits.RAT_BOSS_FOOD_PILE_PLAYER_EAT_DELAY),
        100,
      );
    }
  }
  if (slot === 16) {
    if (useServerState(Varps.AIDE_TELE_TIMER) > 0) {
      return minutesLeftSince(useServerState(Varps.AIDE_TELE_TIMER), 30);
    }
  }
  if (slot === 100) {
    const local1: Int = Math.max(0, 6 - 1 * (totalLevel() / 300));
    if (useServerState(Varps.LEAGUE_LAST_RECALL_COOLDOWN) > 0 && local1 > 0) {
      return minutesLeftSince(useServerState(Varps.LEAGUE_LAST_RECALL_COOLDOWN), local1);
    }
  }
  if (slot === 109) {
    const [cell_buffLeagueUndyingRetributionDuration] = useState(buffLeagueUndyingRetributionDuration);
    const [cell_buffLeagueUndyingRetributionStart] = useState(buffLeagueUndyingRetributionStart);
    if (cell_buffLeagueUndyingRetributionStart > 0) {
      return ticksLeftSince(cell_buffLeagueUndyingRetributionStart, cell_buffLeagueUndyingRetributionDuration - 3);
    }
  }
  if (slot === 17) {
    if (useServerState(Varps.SLUG2_REGIONUID) > 0) {
      return minutesLeftSince(useServerState(Varps.SLUG2_REGIONUID), 20);
    }
  }
  if (slot === 18) {
    if (useServerState(Varbits.TELEBLOCK_CYCLES) > 0) {
      return useServerState(Varbits.TELEBLOCK_CYCLES) - 100;
    }
  }
  if (slot === 19) {
    if (useServerState(Varbits.DIVINECOMBAT_POTION_TIME) === 0) {
      return useServerState(Varbits.DIVINEATTACK_POTION_TIME);
    }
  }
  if (slot === 20) {
    if (useServerState(Varbits.DIVINECOMBAT_POTION_TIME) === 0) {
      return useServerState(Varbits.DIVINESTRENGTH_POTION_TIME);
    }
  }
  if (slot === 21) {
    if (
      useServerState(Varbits.DIVINECOMBAT_POTION_TIME) === 0 &&
      useServerState(Varbits.DIVINEBASTION_POTION_TIME) === 0 &&
      useServerState(Varbits.DIVINEBATTLEMAGE_POTION_TIME) === 0 &&
      useServerState(Varbits.MOONLIGHT_POTION_TIME) === 0
    ) {
      return useServerState(Varbits.DIVINEDEFENCE_POTION_TIME);
    }
  }
  if (slot === 115) {
    if (useServerState(Varbits.MOONLIGHT_POTION_TIME) > 0) {
      return useServerState(Varbits.MOONLIGHT_POTION_TIME);
    }
  }
  if (slot === 22) {
    if (useServerState(Varbits.DIVINEBATTLEMAGE_POTION_TIME) === 0) {
      return useServerState(Varbits.DIVINEMAGIC_POTION_TIME);
    }
  }
  if (slot === 23) {
    if (useServerState(Varbits.DIVINEBASTION_POTION_TIME) === 0) {
      return useServerState(Varbits.DIVINERANGE_POTION_TIME);
    }
  }
  if (slot === 24) {
    if (useServerState(Varbits.DIVINEBASTION_POTION_TIME) > 0) {
      return useServerState(Varbits.DIVINEBASTION_POTION_TIME);
    }
  }
  if (slot === 25) {
    if (useServerState(Varbits.DIVINEBATTLEMAGE_POTION_TIME) > 0) {
      return useServerState(Varbits.DIVINEBATTLEMAGE_POTION_TIME);
    }
  }
  if (slot === 26) {
    if (useServerState(Varbits.DIVINECOMBAT_POTION_TIME) > 0) {
      return useServerState(Varbits.DIVINECOMBAT_POTION_TIME);
    }
  }
  if (slot === 28) {
    if (useServerState(Varbits.VENGEANCE_REBOUND) > 0) {
      return useServerState(Varbits.VENGEANCE_REBOUND);
    }
  }
  if (slot === 3) {
    const [cell_buffVengeanceCastStart] = useState(buffVengeanceCastStart);
    if (cell_buffVengeanceCastStart > 0) {
      return scaledCount(cell_buffVengeanceCastStart, useServerState(Varbits.VENGEANCE_TIMELIMIT), 50);
    }
  }
  if (slot === 29) {
    if (useServerState(Varbits.ARCEUUS_CORRUPTION) === 1) {
      return 1;
    }
  }
  if (slot === 60) {
    if (useServerState(Varbits.ARCEUUS_CORRUPTION) === 2) {
      return 1;
    }
  }
  if (slot === 30) {
    const [cell_buffCorruptionStart] = useState(buffCorruptionStart);
    if (cell_buffCorruptionStart > 0) {
      return scaledCount(cell_buffCorruptionStart, useServerState(Varbits.ARCEUUS_CORRUPTION_COOLDOWN), 50);
    }
  }
  if (slot === 31) {
    const [cell_buffMarkOfDarknessDuration] = useState(buffMarkOfDarknessDuration);
    const [cell_buffMarkOfDarknessStart] = useState(buffMarkOfDarknessStart);
    if (cell_buffMarkOfDarknessStart > 0) {
      return ticksLeftSince(cell_buffMarkOfDarknessStart, cell_buffMarkOfDarknessDuration);
    }
  }
  if (slot === 33) {
    const [cell_buffShadowVeilActiveStart] = useState(buffShadowVeilActiveStart);
    if (cell_buffShadowVeilActiveStart > 0) {
      return ticksLeftSince(cell_buffShadowVeilActiveStart, useSkillBase(ValueSkills.MAGIC));
    }
  }
  if (slot === 32) {
    const [cell_buffShadowVeilCooldownStart] = useState(buffShadowVeilCooldownStart);
    if (cell_buffShadowVeilCooldownStart > 0) {
      return scaledCount(cell_buffShadowVeilCooldownStart, useServerState(Varbits.ARCEUUS_SHADOW_VEIL_COOLDOWN), 50);
    }
  }
  if (slot === 35) {
    const [cell_buffDeathChargeActiveStart] = useState(buffDeathChargeActiveStart);
    if (cell_buffDeathChargeActiveStart > 0) {
      return scaledCount(cell_buffDeathChargeActiveStart, useServerState(Varbits.ARCEUUS_DEATH_CHARGE_ACTIVE), 100);
    }
  }
  if (slot === 34) {
    const [cell_buffDeathChargeCooldownStart] = useState(buffDeathChargeCooldownStart);
    if (cell_buffDeathChargeCooldownStart > 0) {
      return scaledCount(cell_buffDeathChargeCooldownStart, useServerState(Varbits.ARCEUUS_DEATH_CHARGE_COOLDOWN), 100);
    }
  }
  if (slot === 37) {
    const [cell_buffWardOfArceuusActiveStart] = useState(buffWardOfArceuusActiveStart);
    if (cell_buffWardOfArceuusActiveStart > 0) {
      return ticksLeftSince(cell_buffWardOfArceuusActiveStart, useSkillBase(ValueSkills.MAGIC));
    }
  }
  if (slot === 36) {
    const [cell_buffWardOfArceuusCooldownStart] = useState(buffWardOfArceuusCooldownStart);
    if (cell_buffWardOfArceuusCooldownStart > 0) {
      return scaledCount(cell_buffWardOfArceuusCooldownStart, useServerState(Varbits.ARCEUUS_WARD_COOLDOWN), 50);
    }
  }
  if (slot === 39) {
    const [cell_buffResurrectionActiveDuration] = useState(buffResurrectionActiveDuration);
    const [cell_buffResurrectionActiveStart] = useState(buffResurrectionActiveStart);
    if (cell_buffResurrectionActiveStart > 0) {
      return ticksLeftSince(cell_buffResurrectionActiveStart, cell_buffResurrectionActiveDuration - 3);
    }
  }
  if (slot === 99) {
    const [cell_buffLeagueGuardianActiveDuration] = useState(buffLeagueGuardianActiveDuration);
    const [cell_buffLeagueGuardianActiveStart] = useState(buffLeagueGuardianActiveStart);
    if (cell_buffLeagueGuardianActiveStart > 0) {
      return ticksLeftSince(cell_buffLeagueGuardianActiveStart, cell_buffLeagueGuardianActiveDuration - 3);
    }
  }
  if (slot === 38) {
    const [cell_buffResurrectionCooldownStart] = useState(buffResurrectionCooldownStart);
    if (cell_buffResurrectionCooldownStart > 0) {
      return scaledCount(cell_buffResurrectionCooldownStart, useServerState(Varbits.ARCEUUS_RESURRECTION_COOLDOWN), 17);
    }
  }
  if (slot === 41) {
    if (useServerState(Varps.BUFF_BAR_WEAPON) !== -1) {
      return useServerState(Varps.BUFF_BAR_AMMO_AMOUNT);
    }
  }
  if (slot === 40) {
    if (useServerState(Varps.BUFF_BAR_WEAPON) === -1) {
      return useServerState(Varps.BUFF_BAR_AMMO_AMOUNT);
    }
  }
  if (slot === 42) {
    const [cell_buffPoisonDamageTimerStart] = useState(buffPoisonDamageTimerStart);
    if (useServerState(Varps.POISON) > 0 && useServerState(Varps.POISON) < 1000000) {
      return ticksLeftSince(cell_buffPoisonDamageTimerStart, row.perUnit);
    }
  }
  if (slot === 43) {
    const [cell_buffPoisonDamageTimerStart] = useState(buffPoisonDamageTimerStart);
    if (useServerState(Varps.POISON) >= 1000000) {
      return ticksLeftSince(cell_buffPoisonDamageTimerStart, row.perUnit);
    }
  }
  if (slot === 120) {
    if (useServerState(Varbits.PLAYER_OWN_BURN_DAMAGE_TOTAL) > 0) {
      return useServerState(Varbits.PLAYER_OWN_BURN_DAMAGE_TOTAL);
    }
  }
  if (slot === 44) {
    const [cell_buffDesertDamageStart] = useState(buffDesertDamageStart);
    if (cell_buffDesertDamageStart > 0) {
      return scaledCount(cell_buffDesertDamageStart, 1, useServerState(Varbits.BUFF_BAR_DESERT_HEAT_TIMER_ITERATION));
    }
  }
  if (slot === 45) {
    const [cell_buffPlayerNexPrison] = useState(buffPlayerNexPrison);
    if (cell_buffPlayerNexPrison > 0) {
      return ticksUntil(cell_buffPlayerNexPrison);
    }
  }
  if (slot === 46) {
    const [cell_buffPlayerNexSacrifice] = useState(buffPlayerNexSacrifice);
    if (cell_buffPlayerNexSacrifice > 0) {
      return ticksUntil(cell_buffPlayerNexSacrifice);
    }
  }
  if (slot === 47) {
    const [cell_buffPlayerNexVirus] = useState(buffPlayerNexVirus);
    if (cell_buffPlayerNexVirus > 0) {
      return ticksUntil(cell_buffPlayerNexVirus);
    }
  }
  if (slot === 56) {
    if (
      useServerState(Varps.DROPCANNON) === 4 &&
      CS2.map_world() % 128 === useServerState(Varbits.MCANNON_WORLD) &&
      useServerState(Varbits.MCANNON_LAST_BALLTYPE) === 0 &&
      useServerState(Varbits.MCANNON_DECAYED) === 0
    ) {
      return useServerState(Varps.ROCKTHROWER);
    }
  }
  if (slot === 57) {
    if (
      useServerState(Varps.DROPCANNON) === 4 &&
      CS2.map_world() % 128 === useServerState(Varbits.MCANNON_WORLD) &&
      useServerState(Varbits.MCANNON_LAST_BALLTYPE) === 1 &&
      useServerState(Varbits.MCANNON_DECAYED) === 0
    ) {
      return useServerState(Varps.ROCKTHROWER);
    }
  }
  if (slot === 48) {
    if (useServerState(Varps.REVENANT_REWARD_TIMED_BUFF_END) > 0) {
      return useServerState(Varps.REVENANT_REWARD_TIMED_BUFF_END) - useServerState(Varps.DATE_MINUTES);
    }
  }
  if (slot === 83) {
    const [cell_buffStatrenewalStart] = useState(buffStatrenewalStart);
    if (useServerState(Varbits.STATRENEWAL_POTION_TIMER) > 0) {
      return scaledCount(cell_buffStatrenewalStart, useServerState(Varbits.STATRENEWAL_POTION_TIMER), 25);
    }
  }
  if (slot === 121) {
    const [cell_buffPrayerRegenerationStart] = useState(buffPrayerRegenerationStart);
    if (useServerState(Varbits.PRAYER_REGENERATION_POTION_TIMER) > 0) {
      return scaledCount(
        cell_buffPrayerRegenerationStart,
        useServerState(Varbits.PRAYER_REGENERATION_POTION_TIMER),
        12,
      );
    }
  }
  if (slot === 49) {
    if (loadoutFilled(0) === true) {
      return 1;
    }
  }
  if (slot === 50) {
    if (loadoutFilled(1) === true) {
      return 1;
    }
  }
  if (slot === 51) {
    if (loadoutFilled(2) === true) {
      return 1;
    }
  }
  if (slot === 52) {
    if (loadoutFilled(3) === true) {
