    return useServerState(Varbits.BUFF_ZEBAK_BLEED_DURATION_DISABLED);
  }
  if (slot === 96) {
    return useServerState(Varbits.BUFF_GROUP_GATHERING_WOODCUTTING_DISABLED);
  }
  if (slot === 97) {
    if (useServerState(Varbits.BUFF_WOODCUTTING_LEPRECHAUN_RAINBOWS_SETTING) === 2) {
      return 1;
    }
    return 0;
  }
  if (slot === 111) {
    return useServerState(Varbits.BUFF_DRAGONFIRE_SHIELD_COOLDOWN_DISABLED);
  }
  if (slot === 112) {
    return useServerState(Varbits.BUFF_DRAGONFIRE_SHIELD_COOLDOWN_DISABLED);
  }
  if (slot === 110) {
    return useServerState(Varbits.BUFF_SCURRIUS_FOOD_PILE);
  }
  if (slot === 119) {
    return useServerState(Varbits.BUFF_DEADMAN_OVERLOAD_POTION);
  }
  if (slot === 122) {
    return useServerState(Varbits.BUFF_GOADING_POTION_DURATION_DISABLED);
  }
  if (slot === 127) {
    return useServerState(Varbits.BUFF_BOWSTRING_SPOOL_DISABLED);
  }
  if (slot === 129) {
    return useServerState(Varbits.BUFF_ENT_TOTEMS_BONUS_XP_DISABLED);
  }
  if (slot === 130 || slot === 131 || slot === 132) {
    if (useServerState(Varbits.SAILING_PLAYER_IS_ON_PLAYER_BOAT) === 1) {
      return 0;
    }
    return 1;
  }
  return 0;
}
