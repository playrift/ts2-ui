import { onMounted } from 'ts2';
import { chatMessage, itemName } from '../lib/lib.engine';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SkillCapes, SkillOrder, SkillcapesShopLayout, WARMED_SKILL_KEYS } from './league-skillcapes-shop.constants';

export function LeagueSkillcapesShop(): Component {
  onMounted(() => {
    let key: Int = 1;
    while (key < 23) {
      chatMessage(`Loading: ${itemName(SkillCapes.get(SkillOrder.get(key)) as Item)}`);
      key = key + 1;
    }
  });

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={SkillcapesShopLayout.WINDOW_W} h={SkillcapesShopLayout.WINDOW_H}>
        <SteelBorderEntrypoint title="League Skill Cape Shop" />

        <layer
          x="center"
          y="center"
          w={{ fill: SkillcapesShopLayout.INSET }}
          h={{ fill: SkillcapesShopLayout.INSET }}
        />

        {WARMED_SKILL_KEYS.map((key, i) => (
          <sprite
            x={SkillcapesShopLayout.CELL_X0 + i * SkillcapesShopLayout.CELL_STEP}
            y={SkillcapesShopLayout.CELL_Y}
            w={SkillcapesShopLayout.CELL}
            h={SkillcapesShopLayout.CELL}
            item={SkillCapes.get(SkillOrder.get(key))}
            itemCount={-1}
          />
        ))}
      </layer>
    </layer>
  );
}
