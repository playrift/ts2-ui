import { createRef } from 'ts2';

const leagueTutorial = createRef('league_tutorial');

export function LeagueTutorial(): Component {
  return (
    <layer w="fill" h="fill">
      <layer w="fill" h="fill" hide noClickThrough />
    </layer>
  );
}

export const leagueTutorialUi = (): UI => (
  <ui ref={leagueTutorial}>
    <LeagueTutorial />
  </ui>
);
