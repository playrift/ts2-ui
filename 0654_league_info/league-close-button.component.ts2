import { closeInterface, onMobile } from '../lib/lib.helpers';
import { LeagueInfoSprites } from './league-info.constants';
import { closeRefused } from './league-info.helpers';

export function LeagueCloseButton({ league }: { league: Int }): Component {
  const mobile: Boolean = onMobile();
  const refused: Boolean = closeRefused(league);
  return (
    <sprite
      right={mobile ? 1 : 3}
      y={mobile ? 1 : 6}
      w={mobile ? 33 : 26}
      h={mobile ? 33 : 23}
      sprite={mobile ? LeagueInfoSprites.CLOSE_MOBILE : LeagueInfoSprites.CLOSE}
      hover={{ sprite: mobile ? LeagueInfoSprites.CLOSE_MOBILE : LeagueInfoSprites.CLOSE_HOVER }}
      tiling
      options={['Close']}
      onOptionSelect={refused ? undefined : () => closeInterface()}
    />
  );
}
