export type RelicToggleEntry = { row: Int; toggle: LeagueToggle };

export const RelicToggleLists = listOf<RelicToggleEntry>([
  { row: 0, toggle: LeagueToggle.ENDLESS_HARVEST_BANK },
  { row: 1, toggle: LeagueToggle.BARBARIAN_GATHERING_DISPOSE },
  { row: 2, toggle: LeagueToggle.SOUL_HARVEST_BONE },
  { row: 3, toggle: LeagueToggle.ABUNDANCE_COIN_INV },
  { row: 4, toggle: LeagueToggle.WOODSMAN_BANK },
  { row: 4, toggle: LeagueToggle.WOODSMAN_BURN },
  { row: 5, toggle: LeagueToggle.TRANSMUTATION_ALCHEMY },
  { row: 5, toggle: LeagueToggle.TRANSMUTATION_BANK },
]);

