import { CS2, sessionState, useState } from 'ts2';

import { leagueProgressBarTooltip } from '../lib/game/varcs';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { onEnhancedMobile } from '../0134_settings/settings.helpers';
import { onEnhancedAny } from '../0091_clanwars_setup/clanwars-setup.helpers';

const TIP_DWELL = 25;

export const relicBarTip = sessionState(-1);
export const relicBarTipFragment = sessionState(0);

export function relicBarTipShow(pin: Int, fragment: Boolean): void {
  if (onEnhancedMobile()) {
    return;
  }
  if (onEnhancedAny()) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(TIP_DWELL)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  const [, setTip] = useState(relicBarTip);
  const [, setFragment] = useState(relicBarTipFragment);
  setTip(pin);
  setFragment(fragment ? 1 : 0);
  tooltipRaise();
}

export function relicBarTipHide(): void {
  tooltipHide();
  const [, setTip] = useState(relicBarTip);
  setTip(-1);
}

export function relicBarTipToggle(pin: Int, fragment: Boolean): void {
  const [up, setUp] = useState(leagueProgressBarTooltip);
  const [, setTip] = useState(relicBarTip);
  const [, setFragment] = useState(relicBarTipFragment);
  if (up === pin) {
    tooltipHide();
    setUp(-1);
    setTip(-1);
    return;
  }
  if (onEnhancedAny()) {
    return;
  }
  setUp(pin);
  setTip(pin);
  setFragment(fragment ? 1 : 0);
  tooltipRaise();
}

export const relicHover = sessionState(-1);

export const relicsDrawn = sessionState(0);

export const relicsLoading = sessionState(0);

export function relicView(): void {
  CS2.sound_effect(2266, 1, 0);
  const [, setLoading] = useState(relicsLoading);
  const [, setHover] = useState(relicHover);
  setLoading(1);
  setHover(-1);
}

export const detailRelic = sessionState(-1);
export const detailState = sessionState(0);
export const detailPassiveFlag = sessionState(-1);
export const detailDescription = sessionState('');
export const detailPassive = sessionState('');
export const detailEffectsH = sessionState(0);
export const detailOverflow = sessionState(0);
export const detailPassiveH = sessionState(0);
export const detailCollapsed = sessionState(0);
export const detailWindowH = sessionState(314);
export const confirmOpen = sessionState(0);
export const passiveOpen = sessionState(0);
