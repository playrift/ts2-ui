import { EtchedBoxSprites } from './league-side-panel.constants';

export function EtchedBox({ x, y, w, h, inset = 0 }: { x: Int; y: Int; w: Int; h: Int; inset?: Int }): Component {
  return (
    <>
      <sprite x={x + inset} y={y} w={8} h={8} sprite={EtchedBoxSprites.CORNER_TL} />
      <sprite x={x + w - 8 - inset} y={y} w={8} h={8} sprite={EtchedBoxSprites.CORNER_TR} />
      <sprite x={x + inset} y={y + h - 2 - 4} w={8} h={8} sprite={EtchedBoxSprites.CORNER_BL} />
      <sprite x={x + w - 8 - inset} y={y + h - 2 - 4} w={8} h={8} sprite={EtchedBoxSprites.CORNER_BR} />
      <sprite x={x + inset + 8} y={y} w={w - 2 * (inset + 8)} h={4} sprite={EtchedBoxSprites.EDGE_TOP} />
      <sprite x={x + inset + 8} y={y + h - 2} w={w - 2 * (inset + 8)} h={4} sprite={EtchedBoxSprites.EDGE_BOTTOM} />
      <sprite x={x + inset} y={y + 8} w={4} h={h - 2 - 12} sprite={EtchedBoxSprites.EDGE_LEFT} />
      <sprite x={x + w - 4 - inset} y={y + 8} w={4} h={h - 2 - 12} sprite={EtchedBoxSprites.EDGE_RIGHT} />
      <sprite x={x + inset + 4} y={y + 8} w={w - 2 * (inset + 4)} h={h - 2 - 10} sprite={EtchedBoxSprites.FILL} />
      <sprite x={x + inset + 8} y={y + 4} w={w - 2 * (inset + 8)} h={h - 2 - 4} sprite={EtchedBoxSprites.FILL} />
    </>
  );
}
