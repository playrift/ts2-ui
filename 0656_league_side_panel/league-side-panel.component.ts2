import { useRef } from 'ts2';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { EtchedBox } from './etched-box.component';
import { PanelContent } from './panel-content.component';
import { SidePanelTooltip } from './side-panel-tooltip.component';
import { currentRankSprite, panelAccent, panelTitle } from './league-side-panel.helpers';
import { hideTooltip, infoSelectSound, showTooltip } from './league-side-panel.state';
import {
  SidePanelColor,
  SidePanelFonts,
  SidePanelLayout,
  SidePanelSprites,
  SidePanelText,
  Tip,
} from './league-side-panel.constants';

function InfoButton(): Component {
  return (
    <layer
      x={SidePanelLayout.INFO_X}
      y={0}
      w={SidePanelLayout.INFO_W}
      h={SidePanelLayout.INFO_H}
      options={[SidePanelText.INFO_OPTION]}
      optionSubject={SidePanelText.INFO_SUBJECT}
      onMouseRepeat={() => showTooltip(Tip.INFO)}
      onMouseLeave={() => hideTooltip()}
      onOptionSelect={() => infoSelectSound()}
    >
      <sprite
        x="center"
        y="center"
        w={SidePanelLayout.INFO_ICON}
        h={SidePanelLayout.INFO_ICON}
        sprite={SidePanelSprites.INFO_ICON}
      />
    </layer>
  );
}

function SidePanelTitle(): Component {
  return (
    <text
      x={SidePanelLayout.TITLE_X}
      y={0}
      w={{ fill: SidePanelLayout.TITLE_W_INSET }}
      h={SidePanelLayout.TITLE_H}
      text={panelTitle()}
      font={SidePanelFonts.TITLE}
      color={panelAccent()}
      shadow
      align="center"
      valign="middle"
    />
  );
}

function SummaryButton(): Component {
  const label = useRef();
  const accent: Int = panelAccent();

  return (
    <layer
      x={SidePanelLayout.SUMMARY_X}
      y={{ bottom: SidePanelLayout.BOTTOM_BUTTON_DY }}
      w={SidePanelLayout.BOTTOM_BUTTON_W}
      h={SidePanelLayout.BOTTOM_BUTTON_H}
      options={[SidePanelText.SUMMARY_OPTION]}
      onMouseEnter={() => {
        label.color = SidePanelColor.HOVER;
      }}
      onMouseLeave={() => {
        label.color = accent;
      }}
    >
      <layer
        x={0}
        y={SidePanelLayout.SUMMARY_BOX_Y}
        w="fill"
        h={SidePanelLayout.SUMMARY_BOX_H}
        onMouseRepeat={() => showTooltip(Tip.SUMMARY)}
        onMouseLeave={() => hideTooltip()}
      >
        <EtchedBox x={0} y={0} w={SidePanelLayout.BOTTOM_BUTTON_W} h={SidePanelLayout.ETCHED_H} />
      </layer>

      <layer x={0} y={SidePanelLayout.SUMMARY_BOX_Y} w="fill" h={SidePanelLayout.SUMMARY_LABEL_H}>
        <text
          ref={label}
          x={0}
          y={SidePanelLayout.SUMMARY_LABEL_Y}
          w="fill"
          h="fill"
          text={SidePanelText.SUMMARY}
          font={SidePanelFonts.BODY}
          color={accent}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </layer>
  );
}

function RankButton(): Component {
  const label = useRef();
  const accent: Int = panelAccent();

  return (
    <layer
      x={SidePanelLayout.RANK_X}
      y={{ bottom: SidePanelLayout.BOTTOM_BUTTON_DY }}
      w={SidePanelLayout.BOTTOM_BUTTON_W}
      h={SidePanelLayout.BOTTOM_BUTTON_H}
      options={[SidePanelText.RANK_OPTION]}
      onMouseEnter={() => {
        label.color = SidePanelColor.HOVER;
      }}
      onMouseLeave={() => {
        label.color = accent;
      }}
    >
      <layer
        x={0}
        y={SidePanelLayout.RANK_BOX_Y}
        w="fill"
        h={{ fill: SidePanelLayout.RANK_BOX_H_INSET }}
        onMouseRepeat={() => showTooltip(Tip.RANK)}
        onMouseLeave={() => hideTooltip()}
      >
        <rect x="center" y={0} w="fill" h="fill" fill color={SidePanelColor.RANK_WASH} hide />
        <EtchedBox x={0} y={0} w={SidePanelLayout.BOTTOM_BUTTON_W} h={SidePanelLayout.ETCHED_H} />
      </layer>

      <layer x={0} y={SidePanelLayout.RANK_BOX_Y} w="fill" h={{ fill: SidePanelLayout.RANK_LABEL_H_INSET }}>
        <text
          ref={label}
          x={SidePanelLayout.RANK_LABEL_X}
          y={SidePanelLayout.RANK_LABEL_Y}
          w={{ fill: SidePanelLayout.RANK_LABEL_W_INSET }}
          h="fill"
          text={SidePanelText.RANK}
          font={SidePanelFonts.BODY}
          color={accent}
          shadow
          align="center"
          valign="middle"
        />
        <sprite
          x={{ right: SidePanelLayout.TROPHY_RIGHT }}
          y="center"
          w={SidePanelLayout.TROPHY}
          h={SidePanelLayout.TROPHY}
          sprite={currentRankSprite()}
        />
      </layer>
    </layer>
  );
}

export function LeagueSidePanel(): Component {
  return (
    <layer x="center" y="center" w={SidePanelLayout.BODY_W} h={SidePanelLayout.BODY_H}>
      <InfoButton />

      <SidePanelTitle />

      <layer x="center" y={SidePanelLayout.FRAME_Y} w="fill" h={{ fill: SidePanelLayout.FRAME_H_INSET }}>
        <rect
          x="center"
          y={SidePanelLayout.WASH_Y}
          w={{ fill: SidePanelLayout.WASH_INSET }}
          h={{ fill: SidePanelLayout.WASH_INSET }}
          fill
          color={SidePanelColor.WASH}
          transparency={SidePanelLayout.WASH_TRANSPARENCY}
        />
        <PanelContent />
        <SteelFrameEntrypoint />
      </layer>

      <SummaryButton />

      <RankButton />

      <layer x={0} y={0} w="fill" h="fill">
        <SidePanelTooltip />
      </layer>
    </layer>
  );
}
