import { useState } from 'ts2';
import { tooltipBuilt } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark } from '../lib/tooltip.component';
import { SidePanelLayout, SidePanelSounds, Tip } from './league-side-panel.constants';

export function buttonSelectSound(): void {
  playSound(SidePanelSounds.SELECT);
}

export function infoSelectSound(): void {
  playSound(SidePanelSounds.SELECT);
}

function tooltipRaise(tip: Tip): void {
  const [, setBuilt] = useState(tooltipBuilt);
  setBuilt(tip);
}

export function currentTip(): Int {
  const [built] = useState(tooltipBuilt);
  return built;
}

export function showTooltip(tip: Tip): void {
  if (onMobile()) {
    return;
  }
  tooltipMark();
  if (tooltipDown() && tooltipDwellElapsed(SidePanelLayout.TOOLTIP_DWELL)) {
    tooltipRaise(tip);
  }
}

export function hideTooltip(): void {
  tooltipHide();
}
