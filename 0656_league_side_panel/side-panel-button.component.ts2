import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { buttonSelectSound } from './league-side-panel.state';
import { SidePanelColor, SidePanelFonts, SidePanelLayout } from './league-side-panel.constants';

function SidePanelButtonMount({ option }: { option: String }): Component {
  const [hovered, setHovered] = useState(0);

  if (onMobile()) {
    return (
      <layer
        x="center"
        y="center"
        w={{ fill: SidePanelLayout.BUTTON_INSET }}
        h={{ fill: SidePanelLayout.BUTTON_INSET }}
        options={[option]}
        onOptionSelect={() => buttonSelectSound()}
      >
        {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      </layer>
    );
  }
  return (
    <layer
      x="center"
      y="center"
      w={{ fill: SidePanelLayout.BUTTON_INSET }}
      h={{ fill: SidePanelLayout.BUTTON_INSET }}
      options={[option]}
      onMouseEnter={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => buttonSelectSound()}
    >
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
    </layer>
  );
}

export function SidePanelButton({ option, label }: { option: String; label: String }): Component {
  return (
    <>
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={SidePanelColor.BUTTON_WASH}
        transparency={SidePanelLayout.BUTTON_WASH_TRANSPARENCY}
      />
      <SidePanelButtonMount option={option} />
      <text
        x="center"
        y="center"
        w={{ fill: SidePanelLayout.BUTTON_INSET }}
        h={{ fill: SidePanelLayout.BUTTON_INSET }}
        text={label}
        font={SidePanelFonts.BODY}
        color={SidePanelColor.BUTTON_LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
