export function LeagueTasks(): Component {
  return (
    <>
      <layer
        static
        ref={universeRef}
        x="center"
        y="center"
        w={Layout.universe.w}
        h={Layout.universe.h}
        onLoad={() => leagueTasksWindowInit()}
      >
        <layer static x={0} y={0} w="fill" h="fill">
          <TaskFrame />
        </layer>
        <layer static x={0} y={0} w="fill" h="fill">
          <CloseButton />
        </layer>
        <layer static x={0} y={0} w="fill" h="fill">
          <MenuButtonMount />
        </layer>
        <layer
          static
          ref={contentRef}
          x={Layout.content.x}
          y={Layout.content.y}
          w={{ fill: Layout.content.insetW }}
          h={{ fill: Layout.content.insetH }}
        >
          <layer static x="center" y={Layout.progress.y} w={{ fill: Layout.progress.insetW }} h={Layout.progress.h}>
            <TaskPointsBar />
          </layer>
          <sprite
            static
            x="center"
            y={Layout.dividerH.y}
            w="fill"
            h={Layout.dividerH.h}
            sprite={TaskSprite.DIVIDER_H}
            tiling
          />
          <sprite
            static
            x={Layout.dividerV.x}
            y={{ bottom: 0 }}
            w={Layout.dividerV.w}
            h={{ fill: Layout.dividerV.insetH }}
            sprite={TaskSprite.DIVIDER_V}
            tiling
          />
          <layer static x={Layout.search.x} y={Layout.search.y} w={{ fill: Layout.search.insetW }} h={Layout.search.h}>
            <SearchBar />
          </layer>
          <layer
            static
            x={Layout.tasks.x}
            y={Layout.tasks.y}
            w={{ fill: Layout.tasks.insetW }}
            h={{ fill: Layout.tasks.insetH }}
          >
            <layer static x={{ right: 0 }} y={0} w={Layout.scrollbar.w} h="fill">
              <TasksScrollbar />
            </layer>
            <layer static ref={tasksListRef} x={0} y={0} w={{ fill: Layout.pane.insetW }} h="fill">
              <layer static ref={taskChunkRef} x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={0} />
              </layer>
              <layer static x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={1} />
              </layer>
              <layer static x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={2} />
              </layer>
              <layer static x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={3} />
              </layer>
              <layer static x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={4} />
              </layer>
              <layer static x={0} y={0} w="fill" h={Layout.chunk.h}>
                <TaskChunk chunk={5} />
              </layer>
              <layer static x={0} y={0} w="fill" h="fill">
                <TaskRows />
              </layer>
            </layer>
          </layer>
          <layer static ref={filtersRef} x={0} y={Layout.filters.y} w={Layout.filters.w} h={Layout.filters.h}>
            <layer static x={0} y={0} w="fill" h="fill">
              <FiltersTitle />
            </layer>
            <layer
              static
              ref={tierFilterRef}
              x="center"
              y={Layout.filterRow.tierY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
            >
              <FilterRow filter={TaskFilter.TIER} />
            </layer>
            <layer
              static
              ref={typeFilterRef}
              x="center"
              y={Layout.filterRow.typeY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
            >
              <FilterRow filter={TaskFilter.TYPE} />
            </layer>
            <layer
              static
              ref={areaFilterRef}
              x="center"
              y={Layout.filterRow.areaY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
            >
              <FilterRow filter={TaskFilter.AREA} />
            </layer>
            <layer
              static
              ref={skillFilterRef}
              x="center"
              y={Layout.filterRow.skillY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
              hide
            >
              <FilterRow filter={TaskFilter.SKILL} />
            </layer>
            <layer
              static
              ref={completedFilterRef}
              x="center"
              y={Layout.filterRow.completedY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
            >
              <FilterRow filter={TaskFilter.COMPLETED} />
            </layer>
            <layer
              static
              ref={pactFilterRef}
              x="center"
              y={Layout.filterRow.pactY}
              w={Layout.filterRow.w}
              h={Layout.filterRow.h}
            >
              <FilterRow filter={TaskFilter.PACT} />
            </layer>
          </layer>
          <layer static x="center" y="center" w="fill" h="fill">
            <LeagueMenuOverlay />
          </layer>
          <layer static x="center" y="center" w="fill" h="fill" hide />
        </layer>
        <layer static x={0} y={0} w="fill" h="fill">
          <MenuDropdownMount />
        </layer>
      </layer>

      <layer
        static
        ref={dropdownContainerRef}
