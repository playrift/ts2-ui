export function dropdownEntryHeight(): Int {
  if (onMobile()) {
    return Filter.entry.mobileH;
  }
  return Filter.entry.h;
}

function drawnEntries(filter: Int): Int {
  let count: Int = 0;
  let i: Int = 0;
  while (i < LeagueFilterEntries.length) {
    const entry: LeagueFilterEntry | null = LeagueFilterEntries.at(i);
    if (entry !== null) {
      if (entry.filter === filter && filterEntryDrawn(entry)) {
        count = count + 1;
      }
    }
    i = i + 1;
  }
  return count;
}

function filterTableSize(filter: Int): Int {
  let count: Int = 1;
  let i: Int = 0;
  while (i < LeagueFilterEntries.length) {
    const entry: LeagueFilterEntry | null = LeagueFilterEntries.at(i);
    if (entry !== null) {
      if (entry.filter === filter) {
        count = count + 1;
      }
    }
    i = i + 1;
  }
  return count;
}

export function leagueTaskFilterOpen(filter: Int): void {
  predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 0);
  playSound(TaskSound.SELECT);
  dropdownContainerRef.hide = false;
  const rowX: Int = filterRowX(filter) + filtersRef.x + contentRef.x + universeRef.x + leagueTasksRef.x;
  const rowY: Int = filterRowY(filter) + filtersRef.y + contentRef.y + universeRef.y + leagueTasksRef.y;
  const rowHeight: Int = filterRowHeight(filter);
  const boxHeight: Int = Filter.dropdown.pad + drawnEntries(filter) * dropdownEntryHeight() + Filter.dropdown.pad;
  let boxY: Int = rowY + rowHeight - 1;
  if (boxY + boxHeight + Filter.dropdown.margin > dropdownContainerRef.height) {
    boxY = rowY + rowHeight - boxHeight - Filter.dropdown.aboveNudge;
  }
  dropdownBoxRef.x = rowX;
  dropdownBoxRef.y = boxY;
  dropdownBoxRef.width = filterRowWidth(filter);
  dropdownBoxRef.height = boxHeight;
  const [opened, setOpened] = useState(dropdownOpenTick);
  setOpened(opened + 1);
  const [, setOpen] = useState(openFilter);
  setOpen(filter);
}

export function leagueTaskFilterClose(option: Int, key: Int, filter: Int): void {
  predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 0);
  if (option === 1 && filter !== -1 && (key === -1 || (key >= 0 && key < filterTableSize(filter)))) {
    playSound(TaskSound.SELECT);
    if (key !== -1) {
      setFilterValue(filter, key);
    }
    dropdownContainerRef.hide = true;
    const [, setOpen] = useState(openFilter);
    setOpen(-1);
  }
}

export function leagueTaskFilterCancel(): void {
  const [open] = useState(openFilter);
  leagueTaskFilterClose(1, -1, open);
}

const enum SearchKey {
  ENTER = 84,
  BACKSPACE = 85,
  DELETE = 101,
}

const enum SearchGate {
  NO_TOPLEVEL = -1,
  SETTINGS = 134,
}

export function leagueTaskSearchOp(): void {
  settingsOpSound(1);
  if (
    useServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING) === 1 &&
    useServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD) === 1
  ) {
    chatDefaultRestoreInput();
    predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 0);
    predictServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD, 0);
    return;
  }
  chatDefaultStopInput();
  predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 1);
  predictServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD, 1);
  if (onMobile()) {
    keyboardShow(0, 25);
  }
}

export function leagueTaskSearchKeyboard(): void {
  const [query] = useState(leagueTasksSearchString);
  keyboardShowString(0, 25, query);
}

export function typeIntoLeagueSearch(keyCode: Int, keyChar: Char): void {
  if (dialogueMayAdvance(SearchGate.NO_TOPLEVEL, SearchGate.SETTINGS) === false) {
    return;
  }
  if (useServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD) === 0) {
    return;
  }
  if (useServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING) === 0) {
    return;
  }
  const [query, setQuery] = useState(leagueTasksSearchString);
  if (keyCode === SearchKey.DELETE) {
    if (query.length === 0) {
      return;
    }
    setQuery('');
    collapseTasks();
    return;
  }
  if (keyCode === SearchKey.ENTER) {
    if (onMobile()) {
      hideKeyboard();
      return;
    }
    chatDefaultRestoreInput();
    predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 0);
    predictServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD, 0);
    collapseTasks();
    return;
  }
  if (keyCode === SearchKey.BACKSPACE) {
    if (query.length > 0) {
      setQuery(query.substring(0, query.length - 1));
      collapseTasks();
    }
    return;
  }
  if (CS2.char_alpha_numeric_is(keyChar) === false && CS2.string_indexof_char(' -/,', keyChar) === -1) {
    return;
  }
  const next: String = CS2.append_char(query, keyChar);
  if (next.length > 25) {
    return;
  }
  setQuery(next);
  collapseTasks();
}
