export function taskLeague(): Int {
  return useServerState(Varbits.LEAGUE_TYPE);
}

export function taskLeagueKnown(): Boolean {
  const theme = RelicThemes.get(taskLeague());
  if (theme === null) {
    return false;
  }
  return true;
}

export function taskAccent(): Int {
  const theme = RelicThemes.get(taskLeague());
  if (theme === null) {
    return TaskColour.ORANGE;
  }
  return theme.accent;
}

