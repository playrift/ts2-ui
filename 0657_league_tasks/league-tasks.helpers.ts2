  switch (filter) {
    case TaskFilter.TYPE:
      return typeFilterRef.x;
    case TaskFilter.AREA:
      return areaFilterRef.x;
    case TaskFilter.SKILL:
      return skillFilterRef.x;
    case TaskFilter.COMPLETED:
      return completedFilterRef.x;
    case TaskFilter.PACT:
      return pactFilterRef.x;
    default:
      return tierFilterRef.x;
