export function filterValue(filter: Int): Int {
  switch (filter) {
    case TaskFilter.TIER:
      return useServerState(Varbits.LEAGUE_TASK_FILTER_TIER);
    case TaskFilter.COMPLETED:
      return useServerState(Varbits.LEAGUE_TASK_FILTER_COMPLETED);
    case TaskFilter.TYPE:
      return useServerState(Varbits.LEAGUE_TASK_FILTER_TYPE);
    case TaskFilter.SKILL:
      return useServerState(Varbits.LEAGUE_TASK_FILTER_SKILL);
    case TaskFilter.AREA:
      return useServerState(Varbits.LEAGUE_TASK_FILTER_AREA);
    case TaskFilter.PACT:
      return useServerState(Varbits.VARBIT_20357);
    default:
      return 0;
  }
}

export function setFilterValue(filter: Int, value: Int): void {
  switch (filter) {
    case TaskFilter.TIER:
      predictServerState(Varbits.LEAGUE_TASK_FILTER_TIER, value);
      break;
    case TaskFilter.COMPLETED:
      predictServerState(Varbits.LEAGUE_TASK_FILTER_COMPLETED, value);
      break;
    case TaskFilter.TYPE:
      predictServerState(Varbits.LEAGUE_TASK_FILTER_TYPE, value);
      break;
    case TaskFilter.SKILL:
      predictServerState(Varbits.LEAGUE_TASK_FILTER_SKILL, value);
      break;
    case TaskFilter.AREA:
      predictServerState(Varbits.LEAGUE_TASK_FILTER_AREA, value);
      break;
    case TaskFilter.PACT:
      predictServerState(Varbits.VARBIT_20357, value);
      break;
    default:
      break;
  }
}

export function filterLabel(filter: Int, key: Int): String {
  switch (filter) {
    case TaskFilter.TYPE:
      return LeagueTypeFilter.get(key) ?? '';
    case TaskFilter.AREA:
      return LeagueAreaFilter.get(key) ?? '';
    case TaskFilter.SKILL:
      return LeagueSkillFilter.get(key) ?? '';
    case TaskFilter.COMPLETED:
      return LeagueCompletedFilter.get(key) ?? '';
    case TaskFilter.PACT:
      return LeaguePactFilter.get(key) ?? '';
    default:
      return LeagueTierFilter.get(key) ?? '';
  }
}

export function filterCaption(filter: Int): String {
  return `${filterLabel(filter, -1)}:`;
}

export function filterEntryDrawn(entry: LeagueFilterEntry): Boolean {
  if (entry.filter !== TaskFilter.AREA) {
    return true;
  }
  return regionHidden(entry.area) === false;
}

export function withoutSpaces(text: String): String {
  let out: String = '';
  let i: Int = 0;
  while (i < text.length) {
    const piece: String = text.substring(i, i + 1);
    if (piece.startsWith(' ')) {
      i = i + 1;
    } else {
      out = `${out}${piece}`;
      i = i + 1;
    }
  }
  return out;
}

export function filtersActive(searchLength: Int): Boolean {
  if (
    useServerState(Varbits.LEAGUE_TASK_FILTER_TIER) === 0 &&
    useServerState(Varbits.LEAGUE_TASK_FILTER_TYPE) === 0 &&
    useServerState(Varbits.LEAGUE_TASK_FILTER_AREA) === 0 &&
    useServerState(Varbits.VARBIT_20357) === 0 &&
    searchLength <= 1
  ) {
    return false;
  }
  return true;
}

export function leagueTaskDisplay(task: LeagueTask, done: Int, search: String, searchLength: Int): Boolean {
  const tier: Int = useServerState(Varbits.LEAGUE_TASK_FILTER_TIER);
  if (tier !== 0 && tier !== task.tier) {
    return false;
  }
  const type: Int = useServerState(Varbits.LEAGUE_TASK_FILTER_TYPE);
  if (type !== 0 && type !== task.type) {
    return false;
  }
  const area: Int = useServerState(Varbits.LEAGUE_TASK_FILTER_AREA);
  if (area !== 0) {
    const wanted: Int = LeagueAreaFilterArea.get(area) ?? -1;
    if (wanted === 24) {
      if (task.area !== 0 && areaSelected(task.area) === false) {
        return false;
      }
    } else if (wanted !== task.area) {
      return false;
    }
  }
  const completed: Int = useServerState(Varbits.LEAGUE_TASK_FILTER_COMPLETED);
  if (completed !== 0 && completed - 1 !== done) {
    return false;
  }
  const pact: Int = useServerState(Varbits.VARBIT_20357);
  if (pact === 1 && task.pact === false) {
    return false;
  }
  if (pact === 2 && task.pactReset === false) {
    return false;
  }
  if (searchLength > 1) {
    const needle: String = search.toLowerCase();
    if (
      task.name.toLowerCase().includes(needle) === false &&
      task.description.toLowerCase().includes(needle) === false
    ) {
      return false;
    }
  }
  if (regionHidden(task.area)) {
    return false;
  }
  return true;
}

export function leagueTaskShown(
  task: LeagueTask,
  done: Int,
  active: Boolean,
  search: String,
  searchLength: Int,
): Boolean {
  if (task.inLeague === false) {
    return false;
  }
  if (active) {
    return leagueTaskDisplay(task, done, search, searchLength);
  }
  const completed: Int = useServerState(Varbits.LEAGUE_TASK_FILTER_COMPLETED);
  if (completed !== 0 && completed - 1 !== done) {
    return false;
  }
  return true;
}

export function descriptionLines(task: LeagueTask, paneWidth: Int): Int {
  return textLineCount(`Description: ${task.description}.`, paneWidth - Row.DESCRIPTION_INSET, TaskFont.SMALL);
}

export function rowHeight(task: LeagueTask, index: Int, expanded: Int, paneWidth: Int): Int {
  if (index === expanded) {
    return Row.H + Row.LINE * descriptionLines(task, paneWidth) + Row.EXPAND_PAD;
  }
  return Row.H;
}

export function rewardText(task: LeagueTask): String {
  const points: Int = LeagueTierPoints.get(task.tier) ?? 0;
  const text: String = `Reward: <col=ffffff>${stringOf(points)} League Points`;
  if (task.pact) {
    if (task.pactReset) {
      return `${text}, 1 Demonic Pact (40 Max) & 1 Pact reset.</col>`;
    }
    return `${text} & 1 Demonic Pact (40 Max).</col>`;
  }
  if (task.pactReset) {
    return `${text} & 1 Pact reset.</col>`;
  }
  return text;
}

export function tierIcon(task: LeagueTask, league: Int): Sprite {
  if (league === 6 && task.pact) {
    return LeagueTierIconsPact.get(task.tier) ?? -1;
  }
  return LeagueTierIcons.get(task.tier) ?? -1;
}

export function leagueTaskSelect(index: Int): void {
  const [building] = useState(leagueTaskMenuBuildIsActive);
  if (building === 1) {
    return;
  }
  playSound(TaskSound.SELECT);
  const [selected, setSelected] = useState(leagueTaskMenuSelectedTask);
  if (selected === index) {
    setSelected(-1);
  } else {
    setSelected(index);
  }
}

export function collapseTasks(): void {
  const [, setSelected] = useState(leagueTaskMenuSelectedTask);
  setSelected(-1);
}

export function leagueGeneralChanged(): void {
  chatDefaultRestoreInput();
  predictServerState(Varbits.LEAGUE_TASKS_IS_SEARCHING, 0);
  predictServerState(Varbits.LEAGUE_TASKS_SEARCH_LISTEN_FOR_KEYBOARD, 0);
  collapseTasks();
}

export function leagueTasksWindowInit(): void {
  if (onMobile()) {
    return;
  }
  universeRef.width = Layout.universe.desktopW;
  universeRef.height = Layout.universe.desktopH;
}

