import { CS2, useState } from 'ts2';

import { osmChatKeyboard } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';

export function hideKeyboard(): void {
  if (onMobile() === false) {
    return;
  }
  const [, setChatKeyboard] = useState(osmChatKeyboard);
  setChatKeyboard(0);
  CS2.mobile_keyboardhide();
}
