import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { RewardConfirm, RewardPoints } from './reward-confirm.component';
import { RewardOverlay } from './reward-overlay.component';
import { RewardPane } from './reward-pane.component';
import { RewardLayout, RewardText } from './league-rewards.constants';

export function LeagueRewards(): Component {
  return (
    <layer x="center" y="center" w={RewardLayout.BODY_W} h={RewardLayout.BODY_H}>
      <SteelBorderEntrypoint title={RewardText.TITLE} />

      <layer x={0} y={0} w={RewardLayout.BODY_W} h={RewardLayout.BODY_H}>
        <layer
          x="center"
          y={{ bottom: RewardLayout.INNER_BOTTOM }}
          w={{ fill: RewardLayout.INNER_W_INSET }}
          h={{ fill: RewardLayout.INNER_H_INSET }}
        >
          <RewardPane />
          <RewardPoints />
          <RewardConfirm />
        </layer>

        <RewardOverlay />
      </layer>
    </layer>
  );
}
