import { useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { ConfirmOpen, ConfirmPressed, RewardBuying, RewardSounds, SelectedReward } from './league-rewards.constants';

export function selectReward(index: Int): void {
  playSound(RewardSounds.SELECT);
  const [, setSelected] = useState(SelectedReward);
  setSelected(index);
}

export function openRewardConfirm(): void {
  playSound(RewardSounds.SELECT);
  const [, setOpen] = useState(ConfirmOpen);
  setOpen(1);
}

export function buyReward(): void {
  playSound(RewardSounds.SELECT);
  const [, setBuying] = useState(RewardBuying);
  setBuying(1);
}

export function closeRewardConfirm(): void {
  playSound(RewardSounds.SELECT);
  const [, setOpen] = useState(ConfirmOpen);
  setOpen(0);
}

export function pressRewardConfirm(): void {
  const [, setPressed] = useState(ConfirmPressed);
  setPressed(1);
}

export function releaseRewardConfirm(): void {
  const [, setPressed] = useState(ConfirmPressed);
  setPressed(0);
}
