import { onMounted, onUpdated, useRef, useServerState, useState, useUniverse } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { RewardCell, RewardCellHit, RewardSectionHeader } from './reward-section.component';
import { rewardShopIsInfoOnly } from './league-rewards.helpers';
import {
  DemonicPactsRewards,
  RagingEchoesRewards,
  RewardBar,
  RewardLayout,
  RewardSections,
  RewardSectionTitles,
  RewardSprites,
  RewardVarps,
  SelectedReward,
  ShatteredRelicsRewards,
  TrailblazerReloadedRewards,
  TrailblazerRewards,
  TwistedRewards,
} from './league-rewards.constants';

export function RewardPane(): Component {
  const universe = useUniverse();
  const list = useRef();

  const [selected] = useState(SelectedReward);
  const points: Int = useServerState(RewardVarps.POINTS);
  const infoOnly: Int = rewardShopIsInfoOnly() ? 1 : 0;

  const paneW: Int = universe.width - RewardLayout.BOX_W_INSET - RewardLayout.PANE_W_INSET;
  const paneH: Int = universe.height - RewardLayout.BOX_H_INSET - RewardLayout.PANE_H_INSET;
  const half: Int = paneW / 2;

  onMounted(() => {
    list.scrollY = RewardLayout.OPENING_SCROLL;
  });
  onUpdated(() => {
    list.scrollY = RewardLayout.OPENING_SCROLL;
  });

  return (
    <layer
      x="center"
      y={RewardLayout.BOX_Y}
      w={{ fill: RewardLayout.BOX_W_INSET }}
      h={{ fill: RewardLayout.BOX_H_INSET }}
    >
      <sprite
        x={RewardLayout.BACKING_XY}
        y={RewardLayout.BACKING_XY}
        w={{ fill: RewardLayout.BACKING_INSET }}
        h={{ fill: RewardLayout.BACKING_INSET }}
        sprite={RewardSprites.PANE_BACKING}
        tiling
      />

      <layer
        ref={list}
        x={RewardLayout.PANE_XY}
        y={RewardLayout.PANE_XY}
        w={{ fill: RewardLayout.PANE_W_INSET }}
        h={{ fill: RewardLayout.PANE_H_INSET }}
        scrollHeight={RewardLayout.CONTENT_H > paneH ? RewardLayout.CONTENT_H : 0}
      >
        <layer x={0} y={0} w="fill" h="fill">
          {TwistedRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.TWISTED.first}
              rowTop={RewardSections.TWISTED.rowTop}
              half={half}
            />
          ))}
          {TrailblazerRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.TRAILBLAZER.first}
              rowTop={RewardSections.TRAILBLAZER.rowTop}
              half={half}
            />
          ))}
          {ShatteredRelicsRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.SHATTERED.first}
              rowTop={RewardSections.SHATTERED.rowTop}
              half={half}
            />
          ))}
          {TrailblazerReloadedRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.RELOADED.first}
              rowTop={RewardSections.RELOADED.rowTop}
              half={half}
            />
          ))}
          {RagingEchoesRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.ECHOES.first}
              rowTop={RewardSections.ECHOES.rowTop}
              half={half}
            />
          ))}
          {DemonicPactsRewards.map((row, index) => (
            <RewardCellHit
              row={row}
              index={index}
              first={RewardSections.DEMONIC.first}
              rowTop={RewardSections.DEMONIC.rowTop}
              half={half}
            />
          ))}
        </layer>

        <layer x={0} y={0} w="fill" h="fill">
          <RewardSectionHeader
            title={RewardSectionTitles.TWISTED}
            headerY={RewardSections.TWISTED.headerY}
            ruleBefore={RewardSections.TWISTED.ruleBefore}
            ruleAfter={RewardSections.TWISTED.ruleAfter}
            paneW={paneW}
          />
          {TwistedRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.TWISTED.first}
              rowTop={RewardSections.TWISTED.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
          <RewardSectionHeader
            title={RewardSectionTitles.TRAILBLAZER}
            headerY={RewardSections.TRAILBLAZER.headerY}
            ruleBefore={RewardSections.TRAILBLAZER.ruleBefore}
            ruleAfter={RewardSections.TRAILBLAZER.ruleAfter}
            paneW={paneW}
          />
          {TrailblazerRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.TRAILBLAZER.first}
              rowTop={RewardSections.TRAILBLAZER.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
          <RewardSectionHeader
            title={RewardSectionTitles.SHATTERED}
            headerY={RewardSections.SHATTERED.headerY}
            ruleBefore={RewardSections.SHATTERED.ruleBefore}
            ruleAfter={RewardSections.SHATTERED.ruleAfter}
            paneW={paneW}
          />
          {ShatteredRelicsRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.SHATTERED.first}
              rowTop={RewardSections.SHATTERED.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
          <RewardSectionHeader
            title={RewardSectionTitles.RELOADED}
            headerY={RewardSections.RELOADED.headerY}
            ruleBefore={RewardSections.RELOADED.ruleBefore}
            ruleAfter={RewardSections.RELOADED.ruleAfter}
            paneW={paneW}
          />
          {TrailblazerReloadedRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.RELOADED.first}
              rowTop={RewardSections.RELOADED.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
          <RewardSectionHeader
            title={RewardSectionTitles.ECHOES}
            headerY={RewardSections.ECHOES.headerY}
            ruleBefore={RewardSections.ECHOES.ruleBefore}
            ruleAfter={RewardSections.ECHOES.ruleAfter}
            paneW={paneW}
          />
          {RagingEchoesRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.ECHOES.first}
              rowTop={RewardSections.ECHOES.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
          <RewardSectionHeader
            title={RewardSectionTitles.DEMONIC}
            headerY={RewardSections.DEMONIC.headerY}
            ruleBefore={RewardSections.DEMONIC.ruleBefore}
            ruleAfter={RewardSections.DEMONIC.ruleAfter}
            paneW={paneW}
          />
          {DemonicPactsRewards.map((row, index) => (
            <RewardCell
              row={row}
              index={index}
              first={RewardSections.DEMONIC.first}
              rowTop={RewardSections.DEMONIC.rowTop}
              half={half}
              selected={selected}
              points={points}
              infoOnly={infoOnly}
            />
          ))}
        </layer>
      </layer>

      <layer
        x={{ right: RewardLayout.BAR_XY }}
        y={RewardLayout.BAR_XY}
        w={RewardLayout.BAR_W}
        h={{ fill: RewardLayout.PANE_H_INSET }}
      >
        <ScrollbarVertical
          content={list}
          track={RewardBar.TRACK}
          capTopSprite={RewardBar.CAP_TOP}
          thumbSprite={RewardBar.THUMB}
          capBottomSprite={RewardBar.CAP_BOTTOM}
          arrowUp={RewardBar.ARROW_UP}
          arrowDown={RewardBar.ARROW_DOWN}
          rebuilt
        />
      </layer>

      <ThinBoxEntrypoint />
    </layer>
  );
}
