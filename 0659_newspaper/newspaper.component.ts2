import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { CloseSprites, Layout, NewspaperModel } from './newspaper.constants';

export function Newspaper(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <model
          x="center"
          y="center"
          w="fill"
          h="fill"
          model={NewspaperModel.MODEL}
          pitch={NewspaperModel.PITCH}
          zoom={NewspaperModel.ZOOM}
        />
      </layer>

      <layer x={0} y={0} w="fill" h="fill">
        <layer x={Layout.SLOT_3.x} y={{ bottom: Layout.SLOT_3.bottom }} w={Layout.SLOT_3.w} h={Layout.SLOT_3.h} />

        <layer
          x={Layout.LEFT_CONTENT.x}
          y={{ bottom: Layout.LEFT_CONTENT.bottom }}
          w={Layout.LEFT_CONTENT.w}
          h={Layout.LEFT_CONTENT.h}
        />
        <layer
          x={Layout.LEFT_SCROLL.x}
          y={{ bottom: Layout.LEFT_SCROLL.bottom }}
          w={Layout.LEFT_SCROLL.w}
          h={Layout.LEFT_SCROLL.h}
        />

        <layer
          x={{ right: Layout.RIGHT_CONTENT.right }}
          y={{ bottom: Layout.RIGHT_CONTENT.bottom }}
          w={Layout.RIGHT_CONTENT.w}
          h={Layout.RIGHT_CONTENT.h}
        />
        <layer
          x={{ right: Layout.RIGHT_SCROLL.right }}
          y={{ bottom: Layout.RIGHT_SCROLL.bottom }}
          w={Layout.RIGHT_SCROLL.w}
          h={Layout.RIGHT_SCROLL.h}
        />

        <layer x={{ right: Layout.CLOSE.right }} y={Layout.CLOSE.y} w={Layout.CLOSE.w} h={Layout.CLOSE.h}>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={CloseSprites.REST}
            options={['Close']}
            onOptionSelect={() => closeInterface()}
            onMouseRepeat={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
            onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.REST)}
          />
        </layer>
      </layer>
    </>
  );
}
