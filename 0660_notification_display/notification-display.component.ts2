import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  NOTIFICATION_BODY,
  NOTIFICATION_TITLE,
  NotificationColor,
  NotificationFonts,
  NotificationLayout,
  NotificationSprites,
} from './notification-display.constants';

export function NotificationDisplay(): Component {
  return (
    <layer
      x="center"
      y={NotificationLayout.CONTAINER_Y}
      w={NotificationLayout.CONTAINER_W}
      h={NotificationLayout.CONTAINER_H}
    >
      <layer x="center" y="center" w="fill" h="fill">
        <sprite w="fill" h="fill" sprite={NotificationSprites.BACKING} />

        <layer
          x="center"
          y={NotificationLayout.TITLE_BOX_Y}
          w={{ fill: NotificationLayout.TITLE_BOX_INSET_W }}
          h={NotificationLayout.TITLE_BOX_H}
        >
          <text
            x="center"
            y="center"
            w={{ fill: NotificationLayout.TEXT_INSET_W }}
            h="fill"
            text={NOTIFICATION_TITLE}
            font={NotificationFonts.TITLE}
            color={NotificationColor.TEXT}
            shadow
            align="center"
            valign="middle"
          />
          <ThinBoxEntrypoint />
        </layer>

        <layer
          x="center"
          y={{ bottom: NotificationLayout.BODY_BOX_BOTTOM }}
          w={{ fill: NotificationLayout.BODY_BOX_INSET_W }}
          h={{ fill: NotificationLayout.BODY_BOX_INSET_H }}
        >
          <text
            x="center"
            y="center"
            w={{ fill: NotificationLayout.TEXT_INSET_W }}
            h="fill"
            text={NOTIFICATION_BODY}
            font={NotificationFonts.BODY}
            color={NotificationColor.TEXT}
            shadow
            align="center"
            valign="middle"
            lineHeight={NotificationLayout.BODY_LINE_HEIGHT}
          />
          <ThinBoxEntrypoint />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <StoneBoxEntrypoint skin={StoneBoxSkin.ORNATE} />
      </layer>
    </layer>
  );
}
