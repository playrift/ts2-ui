import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { DepositAllButton } from '../0681_ii_elnock_storage_side/deposit-all-button.component';
import { QuantityButtons } from '../0125_farming_tools/quantity-button.component';
import {
  QUANTITY_CAPTION,
  QuantityColors,
  QuantityFonts,
  QuantitySprites,
  QuantityStrip,
} from '../0125_farming_tools/storage-main.shared';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { Panel, StorageSlot, WithdrawButton } from './ii-elnock-storage.constants';
import { STORAGE_TOOLS } from './ii-elnock-storage.data';
import { StorageToolMainSlot } from './storage-slot.component';

export function IiElnockStorage(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Elnock's Equipment Storage" />

      <layer
        x={Panel.CONTENT_X}
        y={{ bottom: Panel.CONTENT_BOTTOM }}
        w={Panel.CONTENT_W}
        h={{ fill: Panel.CONTENT_INSET }}
      >
        {STORAGE_TOOLS.map((tool, index) => (
          <layer
            x={index === 0 ? { center: -Panel.COLUMN_DX } : index === 1 ? 'center' : { center: Panel.COLUMN_DX }}
            y={0}
            w={StorageSlot.WIDTH}
            h={StorageSlot.HEIGHT}
          >
            <StorageToolMainSlot table={QuantityTable.ELNOCK_STORAGE} item={tool.item} label={tool.label} />
          </layer>
        ))}

        <layer x="center" y={{ bottom: WithdrawButton.BOTTOM }} w={WithdrawButton.WIDTH} h={WithdrawButton.HEIGHT}>
          <DepositAllButton label="Withdraw" filled={false} />
        </layer>
      </layer>

      <layer x="center" y={{ bottom: QuantityStrip.BOTTOM }} w={{ fill: QuantityStrip.INSET }} h={QuantityStrip.HEIGHT}>
        <QuantityButtons table={QuantityTable.ELNOCK_STORAGE} />

        <sprite
          x="center"
          y={QuantityStrip.RULE_Y}
          w="fill"
          h={QuantityStrip.RULE_H}
          sprite={QuantitySprites.RULE}
          tiling
        />

        <text
          x="0.12%"
          y={{ center: QuantityStrip.CAPTION_DY }}
          w={QuantityStrip.CAPTION_W}
          h={QuantityStrip.CAPTION_H}
          text={QUANTITY_CAPTION}
          font={QuantityFonts.STRIP}
          color={QuantityColors.CAPTION}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}
