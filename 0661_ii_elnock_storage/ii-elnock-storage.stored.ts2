import { useServerState } from 'ts2';

import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { Varbits } from '../lib/game/varbits';
import { StorageItems } from './ii-elnock-storage.constants';

export function elnockGetStored(item: Item): [Int, Item] {
  let kind: Int = 0;

  switch (item) {
    case StorageItems.BUTTERFLY_NET:
      kind = useServerState(Varbits.II_STORED_NET);
      if (kind === 0) {
        return [0, StorageItems.BUTTERFLY_NET];
      }
      if (kind === 1) {
        return [1, StorageItems.BUTTERFLY_NET];
      }
      if (kind === 2) {
        return [1, StorageItems.MAGIC_BUTTERFLY_NET];
      }
      return [0, -1];

    case StorageItems.IMP_REPELLENT:
      return [useServerState(Varbits.II_STORED_REPELLENT), StorageItems.IMP_REPELLENT];

    case StorageItems.IMPLING_JAR:
      return [useServerState(Varbits.II_STORED_IMPLING_JARS), StorageItems.IMPLING_JAR];
  }

  return [0, -1];
}

export function storageGetStored(table: Enum, item: Item): [Int, Item] {
  if (table === QuantityTable.ELNOCK_STORAGE) {
    return elnockGetStored(item);
  }
  return [0, -1];
}
