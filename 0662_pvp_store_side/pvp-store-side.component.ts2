import { useInventory } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { BLANK_ITEM, Grid, PvpStore, StoreColor, Transparency } from './pvp-store-side.constants';

function PvpStoreSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={Grid.OUTLINE}
      shadowColor={StoreColor.SLOT_SHADOW}
      transparency={Transparency.DIMMED}
      options={['', '', '', '', '', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
    />
  );
}

function PvpStoreBlank({ slot }: { slot: Int }): Component {
  return (
    <sprite
      hide
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={BLANK_ITEM}
      itemCount={1}
      outline={Grid.OUTLINE}
      shadowColor={StoreColor.SLOT_SHADOW}
    />
  );
}

export function PvpStoreSide(): Component {
  const bag = useInventory(PvpStore.INV);

  return (
    <layer w="fill" h="fill">
      {bag.map((item, slot) =>
        item === -1 ? <PvpStoreBlank slot={slot} /> : <PvpStoreSlot item={item} count={bag.count(slot)} slot={slot} />,
      )}
    </layer>
  );
}
