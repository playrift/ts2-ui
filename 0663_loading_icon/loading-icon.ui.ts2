import { createRef } from 'ts2';

const loadingIcon = createRef('loading_icon');

export function LoadingIcon(): Component {
  return (
    <layer x={0} y={0} w={512} h={334}>
      <layer w="fill" h="fill" />
    </layer>
  );
}

export const loadingIconUi = (): UI => (
  <ui ref={loadingIcon}>
    <LoadingIcon />
  </ui>
);
