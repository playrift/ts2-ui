import { useState } from 'ts2';
import {
  HighlightColor,
  HighlightFonts,
  HighlightLayout,
  highlightAccent,
  highlightCaption,
  highlightCounter,
} from './screenhighlight.constants';

export function HighlightCaption(): Component {
  const [caption] = useState(highlightCaption);
  const [accent] = useState(highlightAccent);
  const colour: Int = accent === -1 ? HighlightColor.TEXT : accent;

  return (
    <text
      x="center"
      y={HighlightLayout.CAPTION_Y}
      w={{ fill: HighlightLayout.CAPTION_W_INSET }}
      h={{ fill: HighlightLayout.CAPTION_H_INSET }}
      text={caption}
      font={HighlightFonts.BODY}
      color={colour}
      shadow
      align="center"
      valign="middle"
      lineHeight={HighlightLayout.CAPTION_LINE}
    />
  );
}

export function HighlightCounter(): Component {
  const [counter] = useState(highlightCounter);
  const [accent] = useState(highlightAccent);
  const colour: Int = accent === -1 ? HighlightColor.TEXT : accent;

  return (
    <text
      x={HighlightLayout.COUNTER_X}
      y={HighlightLayout.COUNTER_Y}
      w={{ fill: HighlightLayout.COUNTER_W_INSET }}
      h={HighlightLayout.COUNTER_H}
      text={counter}
      font={HighlightFonts.BODY}
      color={colour}
      shadow
      align="center"
      valign="middle"
      lineHeight={HighlightLayout.COUNTER_LINE}
    />
  );
}
