import { CS2 } from 'ts2';
import { graphicSwapper, onMobile } from '../lib/lib.helpers';
import { playSound } from '../lib/lib.engine';
import { HighlightSounds, HighlightSprites, highlightPauseButton } from './screenhighlight.constants';

export function resumeHighlight(pauseButton: ComponentId): void {
  playSound(HighlightSounds.SELECT);
  CS2.if_resume_pausebutton(pauseButton);
}

export function HighlightCloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        x="center"
        y="center"
        w="fill"
        h="fill"
        sprite={HighlightSprites.CLOSE}
        tiling
        options={['Close']}
        onOptionSelect={() => resumeHighlight(highlightPauseButton)}
      />
    );
  }

  return (
    <sprite
      x="center"
      y="center"
      w="fill"
      h="fill"
      sprite={HighlightSprites.CLOSE}
      tiling
      options={['Close']}
      onMouseLeave={(event) => graphicSwapper(event.self, HighlightSprites.CLOSE)}
      onMouseRepeat={(event) => graphicSwapper(event.self, HighlightSprites.CLOSE_HOVER)}
      onOptionSelect={() => resumeHighlight(highlightPauseButton)}
    />
  );
}
