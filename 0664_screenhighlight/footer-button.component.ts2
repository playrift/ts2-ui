import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { highlightNext } from './screenhighlight.state';
import {
  HighlightFonts,
  highlightNextLabel,
  highlightNextMode,
  highlightNextResumes,
  highlightPrevLabel,
  highlightPrevMode,
} from './screenhighlight.constants';

function HighlightButtonFace({ label, mode, resumes }: { label: String; mode: Int; resumes: Int }): Component {
  const [hovered, setHovered] = useState(0);

  if (mode < 0) {
    return <layer w="fill" h="fill" />;
  }

  if (mode !== 0) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonPressedFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={HighlightFonts.BODY}
          color={0xaaaaaa}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  if (onMobile()) {
    return (
      <layer w="fill" h="fill" options={[label]} onOptionSelect={() => highlightNext(resumes)}>
        <StoneButtonFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={HighlightFonts.BODY}
          color={0xffffff}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => highlightNext(resumes)}
    >
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={HighlightFonts.BODY}
        color={0xffffff}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

export function HighlightNextButton(): Component {
  const [label] = useState(highlightNextLabel);
  const [mode] = useState(highlightNextMode);
  const [resumes] = useState(highlightNextResumes);
  return (
    <layer w="fill" h="fill">
      <HighlightButtonFace label={label} mode={mode} resumes={resumes} />
    </layer>
  );
}

export function HighlightPrevButton(): Component {
  const [label] = useState(highlightPrevLabel);
  const [mode] = useState(highlightPrevMode);
  return (
    <layer w="fill" h="fill">
      <HighlightButtonFace label={label} mode={mode} resumes={0} />
    </layer>
  );
}
