import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { highlightButtonHover, highlightNext } from './screenhighlight.helpers';
import { HighlightFonts, HighlightTextbox } from './screenhighlight.constants';
import {
  highlightNextDisarmed,
  highlightNextHovered,
  highlightNextLabel,
  highlightNextMode,
  highlightNextResumes,
  highlightPrevDisarmed,
  highlightPrevHovered,
  highlightPrevLabel,
  highlightPrevMode,
} from './screenhighlight.state';

function HighlightButtonFace({
  slot,
  label,
  mode,
  resumes,
  disarmed,
  hovered,
}: {
  slot: Int;
  label: String;
  mode: Int;
  resumes: Int;
  disarmed: Int;
  hovered: Int;
}): Component {
  if (mode < 0) {
    return <layer w="fill" h="fill" />;
  }

  if (mode !== 0) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonPressedFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={HighlightFonts.BODY}
          color={0xaaaaaa}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        options={disarmed === 1 ? [] : [label]}
        onOptionSelect={disarmed === 1 ? undefined : () => highlightNext(slot, resumes)}
      >
        <StoneButtonFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={HighlightFonts.BODY}
          color={0xffffff}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={disarmed === 1 ? [] : [label]}
      onMouseRepeat={() => highlightButtonHover(slot, 1)}
      onMouseLeave={() => highlightButtonHover(slot, 0)}
      onOptionSelect={disarmed === 1 ? undefined : () => highlightNext(slot, resumes)}
    >
      <layer w="fill" h="fill" hide={hovered === 1}>
        <StoneButtonFilled />
      </layer>
      <layer w="fill" h="fill" hide={hovered !== 1}>
        <StoneButtonPressedFilled />
      </layer>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={HighlightFonts.BODY}
        color={0xffffff}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

export function HighlightNextButton(): Component {
  const [label] = useState(highlightNextLabel);
  const [mode] = useState(highlightNextMode);
  const [resumes] = useState(highlightNextResumes);
  const [disarmed] = useState(highlightNextDisarmed);
  const [hovered] = useState(highlightNextHovered);
  return (
    <HighlightButtonFace
      slot={HighlightTextbox.SLOT_NEXT}
      label={label}
      mode={mode}
      resumes={resumes}
      disarmed={disarmed}
      hovered={hovered}
    />
  );
}

export function HighlightPrevButton(): Component {
  const [label] = useState(highlightPrevLabel);
  const [mode] = useState(highlightPrevMode);
  const [disarmed] = useState(highlightPrevDisarmed);
  const [hovered] = useState(highlightPrevHovered);
  return (
    <HighlightButtonFace
      slot={HighlightTextbox.SLOT_PREV}
      label={label}
      mode={mode}
      resumes={0}
      disarmed={disarmed}
      hovered={hovered}
    />
  );
}
