import { HighlightBorderSprites, HighlightLayout } from './screenhighlight.constants';

export function HighlightBorder(): Component {
  return (
    <>
      <sprite
        x={0}
        y={0}
        w={HighlightLayout.CORNER}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.TOP_LEFT}
      />
      <sprite
        x="right"
        y={0}
        w={HighlightLayout.CORNER}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.TOP_RIGHT}
      />
      <sprite
        x={0}
        y="bottom"
        w={HighlightLayout.CORNER}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.BOTTOM_LEFT}
      />
      <sprite
        x="right"
        y="bottom"
        w={HighlightLayout.CORNER}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.BOTTOM_RIGHT}
      />

      <sprite
        x={0}
        y="center"
        w={HighlightLayout.CORNER}
        h={{ fill: HighlightLayout.EDGE_INSET }}
        sprite={HighlightBorderSprites.LEFT}
      />
      <sprite
        x="center"
        y={0}
        w={{ fill: HighlightLayout.EDGE_INSET }}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.TOP}
      />
      <sprite
        x="right"
        y="center"
        w={HighlightLayout.CORNER}
        h={{ fill: HighlightLayout.EDGE_INSET }}
        sprite={HighlightBorderSprites.RIGHT}
      />
      <sprite
        x="center"
        y="bottom"
        w={{ fill: HighlightLayout.EDGE_INSET }}
        h={HighlightLayout.CORNER}
        sprite={HighlightBorderSprites.BOTTOM}
      />
    </>
  );
}
