import { useInterval, useRef, useState } from 'ts2';
import { HighlightBorder } from './highlight-border.component';
import { HighlightCaption, HighlightCounter } from './caption.component';
import { HighlightCloseButton } from './close-button.component';
import { HighlightNextButton, HighlightPrevButton } from './footer-button.component';
import { highlightTextboxResize } from './screenhighlight.helpers';
import {
  HighlightColor,
  HighlightLayout,
  HighlightSprites,
  highlightMarker,
  highlightPauseButton,
  highlightRoot,
} from './screenhighlight.constants';
import {
  PANEL_FALLBACK,
  PANEL_REST,
  highlightCloseShown,
  highlightMeasuredH,
  highlightPanelH,
  highlightPanelPlace,
  highlightPanelW,
  highlightPanelX,
  highlightPanelY,
} from './screenhighlight.state';

export function Screenhighlight(): Component {
  return (
    <layer static ref={highlightRoot} w="fill" h="fill">
      <layer w="fill" h="fill">
        <rect
          x="center"
          y={0}
          w="fill"
          h={HighlightLayout.BAR_H}
          fill
          color={HighlightColor.DIM}
          transparency={HighlightLayout.DIM_TRANSPARENCY}
        />
        <rect
          x="center"
          y="bottom"
          w="fill"
          h={HighlightLayout.BAR_H}
          fill
          color={HighlightColor.DIM}
          transparency={HighlightLayout.DIM_TRANSPARENCY}
        />
        <rect
          x="right"
          y="bottom"
          w={HighlightLayout.BAR_W}
          h="fill"
          fill
          color={HighlightColor.DIM}
          transparency={HighlightLayout.DIM_TRANSPARENCY}
        />
        <rect
          x={0}
          y="bottom"
          w={HighlightLayout.BAR_W}
          h="fill"
          fill
          color={HighlightColor.DIM}
          transparency={HighlightLayout.DIM_TRANSPARENCY}
        />
      </layer>

      <layer
        static
        ref={highlightMarker}
        x={HighlightLayout.FRAME_X}
        y={{ bottom: HighlightLayout.FRAME_Y }}
        w={HighlightLayout.FRAME_W}
        h={HighlightLayout.FRAME_H}
      >
        <HighlightBorder />
      </layer>

      <rect static ref={highlightPauseButton} x={0} y={0} w={0} h={0} />

      <HighlightPanel />
    </layer>
  );
}

function HighlightPanel(): Component {
  const [placeMode] = useState(highlightPanelPlace);
  const [x] = useState(highlightPanelX);
  const [y] = useState(highlightPanelY);
  const [w] = useState(highlightPanelW);
  const [h] = useState(highlightPanelH);
  const [closeShown] = useState(highlightCloseShown);
  const [measuredH] = useState(highlightMeasuredH);

  const host = useRef();
  useInterval(measuredH >= 0 ? () => highlightTextboxResize() : undefined, host);

  return (
    <layer
      ref={host}
      x={placeMode === PANEL_FALLBACK ? 'center' : x}
      y={placeMode === PANEL_REST ? { bottom: y } : placeMode === PANEL_FALLBACK ? { bottom: y } : y}
      w={w}
      h={h}
    >
      <sprite x="center" y="center" w="fill" h="fill" sprite={HighlightSprites.PANEL_BACKING} />

      <HighlightBorder />

      <HighlightCaption />
      <HighlightCounter />

      <layer
        x={{ right: HighlightLayout.CLOSE_RIGHT }}
        y={HighlightLayout.CLOSE_Y}
        w={HighlightLayout.CLOSE_W}
        h={HighlightLayout.CLOSE_H}
        hide={closeShown === 0}
      >
        <HighlightCloseButton />
      </layer>

      <layer
        x="center"
        y={{ bottom: HighlightLayout.FOOTER_BOTTOM }}
        w={{ fill: HighlightLayout.FOOTER_W_INSET }}
        h={HighlightLayout.FOOTER_H}
      >
        <layer x="right" y={0} w="50%" h="fill">
          <HighlightNextButton />
        </layer>
        <layer x={0} y={0} w="50%" h="fill">
          <HighlightPrevButton />
        </layer>
      </layer>
    </layer>
  );
}
