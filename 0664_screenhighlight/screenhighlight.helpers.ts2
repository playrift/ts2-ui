import { CS2, useServerState, useState } from 'ts2';
import { clientClock, playSound, scaled, textLineCount } from '../lib/lib.engine';
import {
  HighlightFonts,
  HighlightSounds,
  HighlightTextbox,
  HighlightVarbits,
  highlightMarker,
  highlightPauseButton,
  highlightRoot,
} from './screenhighlight.constants';
import {
  PANEL_FALLBACK,
  PANEL_PLACED,
  highlightAccent,
  highlightCaption,
  highlightCloseShown,
  highlightCounter,
  highlightFallback,
  highlightMeasuredH,
  highlightMeasuredW,
  highlightNextDisarmed,
  highlightNextHovered,
  highlightNextLabel,
  highlightNextMode,
  highlightNextResumes,
  highlightPanelH,
  highlightPanelPlace,
  highlightPanelW,
  highlightPanelX,
  highlightPanelY,
  highlightPrevDisarmed,
  highlightPrevHovered,
  highlightPrevLabel,
  highlightPrevMode,
} from './screenhighlight.state';

function xOf(component: ComponentId): Int {
  return CS2.if_x_get(component);
}
function yOf(component: ComponentId): Int {
  return CS2.if_y_get(component);
}
function widthOf(component: ComponentId): Int {
  return CS2.if_width_get(component);
}
function heightOf(component: ComponentId): Int {
  return CS2.if_height_get(component);
}
function hiddenComponent(component: ComponentId): Boolean {
  return CS2.if_hide_get(component);
}

function textboxWidth(text: String): Int {
  let raw: Int = 0;
  let found: Int = 0;
  let step: Int = 0;
  while (step < 500) {
    if (found === 0) {
      raw = raw + 10;
      if (raw >= textLineCount(text, raw, HighlightFonts.BODY) * HighlightTextbox.LINE) {
        found = 1;
      }
    }
    step = step + 1;
  }
  const grown: Int = scaled(150, 100, raw + HighlightTextbox.MARGIN);
  if (grown < HighlightTextbox.MIN_W) {
    return HighlightTextbox.MIN_W;
  }
  return grown;
}

function textboxHeight(text: String): Int {
  const width: Int = textboxWidth(text);
  const lines: Int = textLineCount(text, width - HighlightTextbox.MARGIN, HighlightFonts.BODY);
  return Math.max(lines * HighlightTextbox.LINE + HighlightTextbox.CHROME, HighlightTextbox.MIN_H);
}

export function highlightTextbox(text: String, colour: Int, showClose: Boolean, fallback: Int): void {
  const [, setCloseShown] = useState(highlightCloseShown);
  const [, setAccent] = useState(highlightAccent);
  const [, setCaption] = useState(highlightCaption);
  const [, setFallback] = useState(highlightFallback);
  setCloseShown(showClose ? 1 : 0);
  setAccent(colour);
  setCaption(text);
  setFallback(fallback);
  layoutTextbox(text, fallback);
}

export function highlightTextboxResize(): void {
  const [measuredH] = useState(highlightMeasuredH);
  const [measuredW] = useState(highlightMeasuredW);
  if (clientClock() % 100 !== 0 && heightOf(highlightRoot) === measuredH && widthOf(highlightRoot) === measuredW) {
    return;
  }
  const [caption] = useState(highlightCaption);
  const [fallback] = useState(highlightFallback);
  layoutTextbox(caption, fallback);
}

function layoutTextbox(text: String, fallback: Int): void {
  const [, setMeasuredH] = useState(highlightMeasuredH);
  const [, setMeasuredW] = useState(highlightMeasuredW);
  const [, setCounter] = useState(highlightCounter);
  const [, setPanelW] = useState(highlightPanelW);
  const [, setPanelH] = useState(highlightPanelH);

  const stageH: Int = heightOf(highlightRoot);
  const stageW: Int = widthOf(highlightRoot);
  setMeasuredH(stageH);
  setMeasuredW(stageW);

  setCounter(
    `${stringOf(useServerState(HighlightVarbits.STEP) + 1)}/${stringOf(useServerState(HighlightVarbits.STEPS))}`,
  );

  const boxW: Int = textboxWidth(text);
  const boxH: Int = textboxHeight(text);
  setPanelW(boxW);
  setPanelH(boxH);

  if (hiddenComponent(highlightMarker)) {
    place(PANEL_FALLBACK, 0, HighlightTextbox.FALLBACK_BOTTOM);
    return;
  }

  const markerX: Int = xOf(highlightMarker);
  const markerY: Int = yOf(highlightMarker);
  const markerW: Int = widthOf(highlightMarker);
  const markerH: Int = heightOf(highlightMarker);

  if (boxH + HighlightTextbox.GAP <= markerY) {
    place(PANEL_PLACED, clampX(markerX + markerW / 2 - boxW / 2, boxW, stageW), markerY - HighlightTextbox.GAP - boxH);
    return;
  }
  if (markerY + markerH + boxH + HighlightTextbox.GAP <= stageH) {
    place(
      PANEL_PLACED,
      clampX(markerX + markerW / 2 - boxW / 2, boxW, stageW),
      markerY + HighlightTextbox.GAP + markerH,
    );
    return;
  }
  if (boxW + HighlightTextbox.GAP <= markerX) {
    place(PANEL_PLACED, markerX - HighlightTextbox.GAP - boxW, clampY(markerY + markerH / 2 - boxH / 2, boxH, stageH));
    return;
  }
  if (markerX + markerW + boxW + HighlightTextbox.GAP <= stageW) {
    place(
      PANEL_PLACED,
      markerX + HighlightTextbox.GAP + markerW,
      clampY(markerY + markerH / 2 - boxH / 2, boxH, stageH),
    );
    return;
  }
  if (fallback >= 1 && fallback <= 4) {
    place(PANEL_FALLBACK, 0, HighlightTextbox.FALLBACK_NEAR);
    return;
  }
  place(PANEL_FALLBACK, 0, HighlightTextbox.FALLBACK_BOTTOM);
}

function place(mode: Int, x: Int, y: Int): void {
  const [, setPlace] = useState(highlightPanelPlace);
  const [, setX] = useState(highlightPanelX);
  const [, setY] = useState(highlightPanelY);
  setPlace(mode);
  setX(x);
  setY(y);
}

function clampX(x: Int, boxW: Int, stageW: Int): Int {
  if (x <= 1) {
    return HighlightTextbox.EDGE;
  }
  if (x + boxW >= stageW) {
    return stageW - HighlightTextbox.EDGE - boxW;
  }
  return x;
}

function clampY(y: Int, boxH: Int, stageH: Int): Int {
  if (y <= 1) {
    return HighlightTextbox.EDGE;
  }
  if (y + boxH >= stageH) {
    return stageH - HighlightTextbox.EDGE - boxH;
  }
  return y;
}

export function highlightButton(slot: Int, mode: Int, label: String, resumes: Boolean): void {
  if (slot === HighlightTextbox.SLOT_NEXT) {
    const [, setLabel] = useState(highlightNextLabel);
    const [, setMode] = useState(highlightNextMode);
    const [, setResumes] = useState(highlightNextResumes);
    const [, setDisarmed] = useState(highlightNextDisarmed);
    setLabel(label);
    setMode(mode);
    setResumes(resumes ? 1 : 0);
    setDisarmed(0);
    highlightButtonHover(slot, 0);
    return;
  }
  const [, setPrevLabel] = useState(highlightPrevLabel);
  const [, setPrevMode] = useState(highlightPrevMode);
  const [, setPrevDisarmed] = useState(highlightPrevDisarmed);
  setPrevLabel(label);
  setPrevMode(mode);
  setPrevDisarmed(0);
  highlightButtonHover(slot, 0);
}

export function highlightButtonHover(slot: Int, hovered: Int): void {
  if (slot === HighlightTextbox.SLOT_NEXT) {
    const [, setNextHovered] = useState(highlightNextHovered);
    setNextHovered(hovered);
    return;
  }
  const [, setPrevHovered] = useState(highlightPrevHovered);
  setPrevHovered(hovered);
}

export function highlightNext(slot: Int, resumes: Int): void {
  let silent: Int = 0;
  if (useServerState(HighlightVarbits.LEAGUE) === 3) {
    if (useServerState(HighlightVarbits.LEAGUE_TUTORIAL) === 9 && useServerState(HighlightVarbits.STEP) === 6) {
      silent = 1;
    }
    if (useServerState(HighlightVarbits.LEAGUE_TUTORIAL) === 11 && useServerState(HighlightVarbits.STEP) === 7) {
      silent = 1;
    }
  }
  if (silent === 0) {
    playSound(HighlightSounds.SELECT);
  }
  if (slot === HighlightTextbox.SLOT_NEXT) {
    const [, setNextDisarmed] = useState(highlightNextDisarmed);
    setNextDisarmed(1);
  } else {
    const [, setPrevDisarmed] = useState(highlightPrevDisarmed);
    setPrevDisarmed(1);
  }
  if (resumes === 1) {
    resumeHighlightFrom(highlightPauseButton);
  }
}

function resumeHighlightFrom(pauseButton: ComponentId): void {
  CS2.if_resume_pausebutton(pauseButton);
}

export function screenHighlightSetup(
  colour: Int,
  resumes: Boolean,
  showClose: Boolean,
  fallback: Int,
  text: String,
): void {
  highlightTextbox(text, colour, showClose, fallback);

  const step: Int = useServerState(HighlightVarbits.STEP);
  const steps: Int = useServerState(HighlightVarbits.STEPS);

  if (step >= steps - 1) {
    highlightButton(HighlightTextbox.SLOT_NEXT, 0, 'Finish', resumes);
  } else {
    highlightButton(HighlightTextbox.SLOT_NEXT, 0, 'Continue', resumes);
  }
  if (step > 0) {
    highlightButton(HighlightTextbox.SLOT_PREV, 0, 'Previous', false);
  } else {
    highlightButton(HighlightTextbox.SLOT_PREV, 1, 'Previous', false);
  }
}
