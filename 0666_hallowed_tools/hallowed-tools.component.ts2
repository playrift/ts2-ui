import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { DepositAllButton } from '../0632_hallowed_tool_side/deposit-all-button.component';
import { QuantityButtons } from '../0125_farming_tools/quantity-button.component';
import {
  QUANTITY_CAPTION,
  QuantityColors,
  QuantityFonts,
  QuantitySprites,
  QuantityStrip,
} from '../0125_farming_tools/storage-main.shared';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { HALLOWED_TOOLS } from './hallowed-tools.data';
import { HallowedSlot, Panel, WithdrawButton } from './hallowed-tools.constants';
import { HallowedToolMainSlot } from './hallowed-tool-slot.component';

export function HallowedTools(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Hallowed Sepulchre Equipment Storage" />

      <layer
        x={Panel.CONTENT_X}
        y={{ bottom: Panel.CONTENT_BOTTOM }}
        w={Panel.CONTENT_W}
        h={{ fill: Panel.CONTENT_INSET }}
      >
        {HALLOWED_TOOLS.map((tool, index) => (
          <layer
            x={
              index % 3 === 0 ? { center: -Panel.COLUMN_DX } : index % 3 === 1 ? 'center' : { center: Panel.COLUMN_DX }
            }
            y={index < 3 ? 0 : 'center'}
            w={HallowedSlot.WIDTH}
            h={HallowedSlot.HEIGHT}
          >
            <HallowedToolMainSlot item={tool.item} label={tool.label} />
          </layer>
        ))}

        <layer x="center" y={{ bottom: WithdrawButton.BOTTOM }} w={WithdrawButton.WIDTH} h={WithdrawButton.HEIGHT}>
          <DepositAllButton label="Withdraw" filled={false} />
        </layer>
      </layer>

      <layer x="center" y={{ bottom: QuantityStrip.BOTTOM }} w={{ fill: QuantityStrip.INSET }} h={QuantityStrip.HEIGHT}>
        <QuantityButtons table={QuantityTable.HALLOWED_TOOLS} />

        <sprite
          x="center"
          y={QuantityStrip.RULE_Y}
          w="fill"
          h={QuantityStrip.RULE_H}
          sprite={QuantitySprites.RULE}
          tiling
        />

        <text
          x="0.12%"
          y={{ center: QuantityStrip.CAPTION_DY }}
          w={QuantityStrip.CAPTION_W}
          h={QuantityStrip.CAPTION_H}
          text={QUANTITY_CAPTION}
          font={QuantityFonts.STRIP}
          color={QuantityColors.CAPTION}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </>
  );
}
