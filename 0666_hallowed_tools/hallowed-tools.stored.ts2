import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { HallowedItems } from './hallowed-tools.constants';

export function hallowedToolsGetStored(item: Item): [Int, Item] {
  switch (item) {
    case HallowedItems.TOKEN:
      return [useServerState(Varbits.HALLOWED_STORAGE_TOKEN), HallowedItems.TOKEN];
    case HallowedItems.GRAPPLE:
      return [useServerState(Varbits.HALLOWED_STORAGE_GRAPPLE), HallowedItems.GRAPPLE];
    case HallowedItems.FOCUS:
      return [useServerState(Varbits.HALLOWED_STORAGE_FOCUS), HallowedItems.FOCUS];
    case HallowedItems.SYMBOL:
      return [useServerState(Varbits.HALLOWED_STORAGE_SYMBOL), HallowedItems.SYMBOL];
    case HallowedItems.HAMMER:
      return [useServerState(Varbits.HALLOWED_STORAGE_HAMMER), HallowedItems.HAMMER];
    case HallowedItems.RING:
      return [useServerState(Varbits.HALLOWED_STORAGE_RING), HallowedItems.RING];
  }
  return [0, -1];
}
