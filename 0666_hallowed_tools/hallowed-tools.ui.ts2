import { createRef } from 'ts2';
import { HallowedTools } from './hallowed-tools.component';
import { Panel } from './hallowed-tools.constants';

const hallowedToolsRef = createRef('hallowed_tools');

export const hallowedToolsUi = (): UI => (
  <ui ref={hallowedToolsRef} x="center" y="center">
    <layer x="center" y="center" w={Panel.WIDTH} h={{ fill: Panel.HEIGHT_INSET }}>
      <HallowedTools />
    </layer>
  </ui>
);
