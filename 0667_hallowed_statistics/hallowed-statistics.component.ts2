import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  BestTimeRows,
  Camera,
  CompletionRows,
  HallowedArt,
  HallowedColor,
  HallowedFonts,
  HallowedModel,
  Layout,
  TITLE,
} from './hallowed-statistics.constants';

export function HallowedStatistics(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={HallowedModel.BACKDROP}
        zoom={Camera.ZOOM}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={HallowedArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, HallowedArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, HallowedArt.CLOSE);
          }}
        />
      </layer>

      <layer
        x={{ center: Layout.CONTENT_X_OFFSET }}
        y={{ center: Layout.CONTENT_Y_OFFSET }}
        w={Layout.CONTENT_W}
        h={Layout.CONTENT_H}
      >
        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_W_INSET }} h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.TITLE_W}
            h={Layout.LABEL_H}
            font={HallowedFonts.HEADING}
            color={HallowedColor.LABEL}
            align="center"
            shadow
            text={TITLE}
          />
        </layer>

        <layer x="center" y={Layout.STATS_BAND_Y} w={{ fill: Layout.STATS_BAND_W_INSET }} h={Layout.STATS_BAND_H}>
          {CompletionRows.map((row) => (
            <text
              x={row.x}
              y={row.y}
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              font={row.heading ? HallowedFonts.HEADING : HallowedFonts.VALUE}
              color={HallowedColor.LABEL}
              align="center"
              shadow
              text={row.text}
            />
          ))}

          {BestTimeRows.map((row) => (
            <text
              x={{ right: Layout.COL_RIGHT }}
              y={row.y}
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              font={row.heading ? HallowedFonts.HEADING : HallowedFonts.VALUE}
              color={HallowedColor.LABEL}
              align="center"
              shadow
              text={row.text}
            />
          ))}
        </layer>
      </layer>
    </>
  );
}
