import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { HallowedColor, HallowedFonts, HallowedOverlay, Layout } from './hallowed-overlay.constants';

const timerHost = createRef('0668_hallowed_overlay_timer_host');

const content = createRef('hallowed_overlay_content');

export function HallowedOverlayPanel(): Component {
  useInterval(() => overlayRelayout(timerHost, content, HallowedOverlay.DODGE, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x={0} y={0} w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={0} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <layer x="center" y={Layout.TIMER_Y} w={{ fill: Layout.TIMER_MARGIN }} h={Layout.TIMER_H}>
            <text
              x={Layout.TEXT_X}
              y={Layout.TEXT_Y}
              w={{ fill: Layout.TEXT_MARGIN }}
              h={Layout.TEXT_H}
              font={HallowedFonts.TIMER}
              color={HallowedColor.TIMER}
              shadow
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
