import { itemName } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';

const MAX_INT = 2147483647;

export function retrievalInfoText(item: Item, count: Int, fee: Int, coffer: Int): String {
  const cofferLine: String = `Death's Coffer: <col=ffffff>${groupDigits(coffer, ',')} coins</col>`;

  if (count > 1) {
    if (fee !== 1) {
      const each: String =
        MAX_INT / count < fee
          ? `Fee: <col=ffffff>${groupDigits(fee, ',')} coins</col> each`
          : `Fee: <col=ffffff>${groupDigits(fee, ',')} coins</col> each (<col=ffffff>${groupDigits(count * fee, ',')}</col>)`;
      return `${groupDigits(count, ',')} x ${itemName(item)}:<br>${each}<br>${cofferLine}`;
    }
    return `${groupDigits(count, ',')} x ${itemName(item)}:<br>Fee: <col=ffffff>1 coin</col> each<br>${cofferLine}`;
  }
  if (fee !== 1) {
    return `${itemName(item)}:<br>Fee: <col=ffffff>${groupDigits(fee, ',')} coins</col><br>${cofferLine}`;
  }
  return `${itemName(item)}:<br>Fee: <col=ffffff>1 coin</col><br>${cofferLine}`;
}

export function selectPromptText(coffer: Int): String {
  return `Select an item to retrieve.<br>Death's Coffer: <col=ffffff>${groupDigits(coffer, ',')}</col>`;
}

export function officeTitle(filled: Int, size: Int): String {
  return `Death's Office Item Retrieval <col=ffb83f>(${filled}/${size})</col>`;
}
