import { useServerState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import { Balance, CofferColor, CofferFonts, CofferVarps, THOUSANDS } from './death-coffer.constants';

export function CofferBalance(): Component {
  const balance: Int = useServerState(CofferVarps.BALANCE);

  let text: String = 'Coffer: <col=ffffff>Empty</col>';
  if (balance > 1) {
    text = `Coffer: <col=ffffff>${groupDigits(balance, THOUSANDS)}</col> coins`;
  } else if (balance === 1) {
    text = 'Coffer: <col=ffffff>1</col> coin';
  }

  return (
    <layer w="fill" h="fill">
      <text
        x="center"
        y="bottom"
        w="fill"
        h={Balance.H}
        text={text}
        font={CofferFonts.BODY}
        color={CofferColor.BODY}
        align="center"
        valign="middle"
        shadow
      />
      <text
        x="center"
        y="bottom"
        w="fill"
        h="fill"
        text="You may <col=ffffff>sacrifice</col> unwanted items here. Their value will go into <col=ffffff>Death's Coffer</col>, a pot of money from which you can <col=ffffff>pay item reclamation fees</col> in future.<br><br>Items sacrificed here <col=ffffff>can </col><col=ff0000>NEVER</col><col=ffffff> be retrieved</col>, and the money <col=ff0000>CANNOT</col><col=ffffff> be withdrawn</col> or used for any other purposes."
        font={CofferFonts.BODY}
        color={CofferColor.BODY}
        align="left"
        valign="top"
        lineHeight={Balance.BLURB_LINE_HEIGHT}
        shadow
      />
    </layer>
  );
}
