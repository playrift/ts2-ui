import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { CofferBalance } from './coffer-balance.component';
import { CofferPanel } from './coffer-panel.component';
import { Art, Body, CofferArt } from './death-coffer.constants';

export function DeathCoffer(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <SteelBorderEntrypoint title="Sacrifice items to Death's Coffer" />
      </layer>

      <layer x="center" y={{ bottom: Body.BOTTOM }} w={{ fill: Body.W_INSET }} h={{ fill: Body.H_INSET }}>
        <layer y="center" w={{ fill: Body.LEFT_INSET }} h="fill">
          <model
            x="center"
            y="bottom"
            w={Art.COFFER_W}
            h={Art.COFFER_H}
            model={Art.COFFER_MODEL}
            pitch={Art.COFFER_PITCH}
            zoom={Art.COFFER_ZOOM}
            offsetX={Art.COFFER_DX}
            offsetY={Art.COFFER_DY}
          />
          <CofferBalance />
        </layer>

        <layer x="right" y="center" w={Body.RIGHT_W} h="fill">
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={CofferArt.BACKING} tiling />
          <model
            x={{ center: Art.MODEL_DX }}
            y="center"
            w={Art.SPINNER_SIZE}
            h={Art.SPINNER_SIZE}
            model={Art.SPINNER_MODEL}
            anim={Art.SPINNER_ANIM}
            yaw={Art.SPINNER_YAW}
            zoom={Art.SPINNER_ZOOM}
            offsetY={Art.SPINNER_DY}
          />
          <model x={{ center: Art.MODEL_DX }} y="center" w={Art.ITEM_SIZE} h={Art.ITEM_SIZE} zoom={Art.ITEM_ZOOM} />
          <CofferPanel />
        </layer>
      </layer>
    </>
  );
}
