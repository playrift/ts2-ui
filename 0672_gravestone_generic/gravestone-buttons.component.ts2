import { useState } from 'ts2';
import { ButtonBackground } from '../0370_house-options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { clientClock, playSound } from '../lib/lib.engine';
import { Fade, GraveSounds } from './gravestone-generic.constants';

const PRESS_CYCLES = 20;

export function FreeReclaimButton({ sprite }: { sprite: Sprite }): Component {
  const [hovered, setHovered] = useState(0);
  const [pressedUntil, setPressedUntil] = useState(0);
  const pressed: Int = pressedUntil > clientClock() ? 1 : 0;

  return (
    <>
      <layer
        x={{ right: 2 }}
        y="center"
        w={41}
        h={41}
        options={['Take-All']}
        onMouseRepeat={() => setHovered(1)}
        onMouseLeave={() => setHovered(0)}
        onOptionSelect={() => {
          playSound(GraveSounds.PRESS);
          setPressedUntil(clientClock() + PRESS_CYCLES);
        }}
        onTimer={
          pressed === 1
            ? () => {
                if (clientClock() >= pressedUntil) {
                  setPressedUntil(0);
                }
              }
            : undefined
        }
      >
        {pressed === 1 ? <ButtonBackgroundPressed /> : <ButtonBackground />}
      </layer>

      <sprite
        x={{ right: 8 }}
        y="center"
        w={29}
        h={22}
        sprite={sprite}
        transparency={pressed === 0 && hovered === 1 ? Fade.ICON_HOVER : Fade.ICON_REST}
      />
    </>
  );
}

export function PayButton({ label, sprite }: { label: String; sprite: Sprite }): Component {
  const [hovered, setHovered] = useState(0);
  const [pressedUntil, setPressedUntil] = useState(0);
  const pressed: Int = pressedUntil > clientClock() ? 1 : 0;

  return (
    <>
      <layer
        x="right"
        y={0}
        w={41}
        h={41}
        options={[label]}
        onMouseRepeat={() => setHovered(1)}
        onMouseLeave={() => setHovered(0)}
        onOptionSelect={() => {
          playSound(GraveSounds.PRESS);
          setPressedUntil(clientClock() + PRESS_CYCLES);
        }}
        onTimer={
          pressed === 1
            ? () => {
                if (clientClock() >= pressedUntil) {
                  setPressedUntil(0);
                }
              }
            : undefined
        }
      >
        {pressed === 1 ? <ButtonBackgroundPressed /> : <ButtonBackground />}
      </layer>

      <sprite
        x={{ right: 6 }}
        y={9}
        w={29}
        h={22}
        sprite={sprite}
        transparency={pressed === 0 && hovered === 1 ? Fade.ICON_HOVER : Fade.ICON_REST}
      />
    </>
  );
}
