import { graphicSwapper, onMobile, opsound } from '../lib/lib.helpers';
import { CLOSE_OPSOUND_MASK, GraveArt, KEY_ESCAPE } from './gravestone-generic.constants';

export function GravestoneCloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        x={{ right: 1 }}
        y={1}
        w={33}
        h={33}
        sprite={GraveArt.CLOSE_MOBILE}
        options={[{ label: 'Close', hotkey: KEY_ESCAPE }]}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, GraveArt.CLOSE_MOBILE);
        }}
        onOptionSelect={(event) => {
          opsound(event.option, CLOSE_OPSOUND_MASK);
        }}
      />
    );
  }

  return (
    <sprite
      x={{ right: 3 }}
      y={6}
      w={26}
      h={23}
      sprite={GraveArt.CLOSE}
      options={[{ label: 'Close', hotkey: KEY_ESCAPE }]}
      onMouseEnter={(event) => {
        graphicSwapper(event.component, GraveArt.CLOSE_HOVER);
      }}
      onMouseLeave={(event) => {
        graphicSwapper(event.component, GraveArt.CLOSE);
      }}
      onOptionSelect={(event) => {
        opsound(event.option, CLOSE_OPSOUND_MASK);
      }}
    />
  );
}
