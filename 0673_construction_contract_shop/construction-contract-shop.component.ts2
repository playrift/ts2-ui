import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ContractConfirm, ContractPoints } from './contract-footer.component';
import { ContractPane } from './contract-pane.component';
import { ContractFrame } from './construction-contract-shop.constants';

export function ConstructionContractShop(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Mahogany Homes Reward Shop" />

      <layer
        x="center"
        y={{ bottom: ContractFrame.BODY_BOTTOM }}
        w={{ fill: ContractFrame.BODY_W_INSET }}
        h={{ fill: ContractFrame.BODY_H_INSET }}
      >
        <ContractPane />
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x="center"
        y={{ bottom: ContractFrame.FOOTER_BOTTOM }}
        w={{ fill: ContractFrame.FOOTER_W_INSET }}
        h={ContractFrame.FOOTER_H}
      >
        <ContractConfirm />
        <ContractPoints />
      </layer>
    </>
  );
}
