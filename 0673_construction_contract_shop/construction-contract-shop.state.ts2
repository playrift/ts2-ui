import { useState } from 'ts2';
import { chatMessage, playSound } from '../lib/lib.engine';
import { ContractSounds, SelectedContract } from './construction-contract-shop.constants';

export function selectContract(index: Int): void {
  const [, setSelected] = useState(SelectedContract);
  playSound(ContractSounds.SELECT);
  setSelected(index);
}

export function refuseContract(message: String): void {
  const [, setSelected] = useState(SelectedContract);
  playSound(ContractSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
}

export function confirmContract(): void {
  const [, setSelected] = useState(SelectedContract);
  playSound(ContractSounds.SELECT);
  setSelected(-1);
}
