import { useServerState, useState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import {
  PestRewardsConfirm,
  PestRewardsConfirmDisabled,
  pressConfirm,
  releaseConfirm,
} from '../0645_br_reward_shop/pest-rewards.shared';
import { confirmContract } from './construction-contract-shop.state';
import {
  ContractColor,
  ContractFonts,
  ContractFrame,
  ContractLabels,
  ContractVarps,
  SelectedContract,
} from './construction-contract-shop.constants';

export function ContractPoints(): Component {
  const points: Int = useServerState(ContractVarps.POINTS);

  return (
    <text
      x={0}
      y="center"
      w={ContractFrame.POINTS_W}
      h="fill"
      text={`Carpenter Points:<br><col=ffffff>${groupDigits(points, ',')}</col>`}
      font={ContractFonts.NAME}
      color={ContractColor.PRICE_REST}
      shadow
      align="center"
      valign="middle"
      lineHeight={ContractFrame.POINTS_LINE_H}
    />
  );
}

export function ContractConfirm(): Component {
  const [selected] = useState(SelectedContract);

  return (
    <layer x="center" y="center" w={ContractFrame.CONFIRM_W} h="fill">
      <layer x="center" y="center" w="fill" h="fill">
        {selected !== -1 ? (
          <PestRewardsConfirm label={ContractLabels.at(selected) ?? 'Reward'} />
        ) : (
          <PestRewardsConfirmDisabled />
        )}
      </layer>

      {selected !== -1 ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          options={['Confirm']}
          onMouseRepeat={() => pressConfirm()}
          onMouseLeave={() => releaseConfirm()}
          onOptionSelect={() => confirmContract()}
        />
      ) : null}
    </layer>
  );
}
