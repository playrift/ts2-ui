import { CS2 } from 'ts2';

import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  Button,
  Layout,
  PressedSkin,
  RaisedSkin,
  depositAllRef,
  itemsRef,
  modeRef,
  scrollbarRef,
  searchRef,
  tierRef,
} from './poh-costumes.constants';

export function PohCostumes(): Component {
  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={{ fill: Layout.UNIVERSE_H_INSET }}>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer
        x={Layout.ITEMS_BOX_X}
        y={{ bottom: Layout.ITEMS_BOX_BOTTOM }}
        w={{ fill: Layout.ITEMS_BOX_W_INSET }}
        h={{ fill: Layout.ITEMS_BOX_H_INSET }}
      >
        <layer
          ref={itemsRef}
          x={Layout.ITEMS_X}
          y="center"
          w={{ fill: Layout.ITEMS_W_INSET }}
          h={{ fill: Layout.ITEMS_H_INSET }}
        />
        <layer
          ref={scrollbarRef}
          x={{ right: Layout.SCROLLBAR_RIGHT }}
          y="center"
          w={Layout.SCROLLBAR_W}
          h={{ fill: Layout.SCROLLBAR_H_INSET }}
        />
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x={{ right: Layout.BUTTONS_RIGHT }}
        y={{ bottom: Layout.BUTTONS_BOTTOM }}
        w={Layout.BUTTONS_W}
        h={{ fill: Layout.BUTTONS_H_INSET }}
      >
        <layer
          ref={tierRef}
          x="center"
          y={{ bottom: Layout.TIER_BOTTOM }}
          w="fill"
          h={Layout.BUTTON_H}
          options={['*', '*', '*', '*', '*', '*', '*']}
        />
        <layer
          ref={modeRef}
          x="center"
          y={{ bottom: Layout.MODE_BOTTOM }}
          w="fill"
          h={Layout.BUTTON_H}
          options={['*']}
        />
        <layer
          ref={searchRef}
          x="center"
          y={{ bottom: Layout.SEARCH_BOTTOM }}
          w="fill"
          h={Layout.BUTTON_H}
          options={['*', '*']}
        />
        <layer
          ref={depositAllRef}
          x="center"
          y={{ bottom: Layout.DEPOSITALL_BOTTOM }}
          w="fill"
          h={Layout.BUTTON_H}
          options={['*']}
        />
      </layer>
    </layer>
  );
}

function createGraphic(
  container: ComponentId,
  index: Int,
  sprite: Sprite,
  x: Int,
  y: Int,
  xMode: Int,
  yMode: Int,
  w: Int,
  h: Int,
  wMode: Int,
  hMode: Int,
  tiling: Boolean,
): void {
  CS2.cc_create(container, Button.SPRITE_TYPE, index, false);
  CS2.cc_position_set(x, y, xMode, yMode);
  CS2.cc_size_set(w, h, wMode, hMode);
  CS2.cc_sprite_set(sprite);
  CS2.cc_tiling_set(tiling);
}

function stoneButtonPressedFilled(container: ComponentId): void {
  const w: Int = CS2.if_width_get(container);
  const h: Int = CS2.if_height_get(container);
  const right: Int = w - Button.CORNER;
  const bottom: Int = h - Button.CORNER;
  const spanW: Int = w - Button.EDGE_INSET;
  const spanH: Int = h - Button.EDGE_INSET;

  createGraphic(
    container,
    0,
    PressedSkin.BACKDROP,
    0,
    0,
    Button.POS_CENTER,
    Button.POS_CENTER,
    Button.BACKDROP_INSET,
    Button.BACKDROP_INSET,
    Button.SIZE_MINUS,
    Button.SIZE_MINUS,
    true,
  );
  createGraphic(
    container,
    1,
    PressedSkin.TOP_LEFT,
    0,
    0,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    2,
    PressedSkin.TOP_RIGHT,
    right,
    0,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    3,
    PressedSkin.BOTTOM_LEFT,
    0,
    bottom,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    4,
    PressedSkin.BOTTOM_RIGHT,
    right,
    bottom,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    5,
    PressedSkin.LEFT,
    0,
    Button.CORNER,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    spanH,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    6,
    PressedSkin.TOP,
    Button.CORNER,
    0,
    Button.POS_LEFT,
    Button.POS_TOP,
    spanW,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    7,
    PressedSkin.RIGHT,
    right,
    Button.CORNER,
    Button.POS_LEFT,
    Button.POS_TOP,
    Button.CORNER,
    spanH,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
  createGraphic(
    container,
    8,
    PressedSkin.BOTTOM,
    Button.CORNER,
    bottom,
    Button.POS_LEFT,
    Button.POS_TOP,
    spanW,
    Button.CORNER,
    Button.SIZE_ABS,
    Button.SIZE_ABS,
    true,
  );
}

