}

function pohCostumesSetTrans(container: ComponentId, index: Int, transparency: Int): void {
  if (CS2.cc_find(container, index)) {
    CS2.cc_transparency_set(transparency);
  }
}

export function pohCostumesButtonsDraw(button: ComponentId, sprite: Sprite, item: Item, selected: Boolean): void {
  CS2.cc_all_delete(button);

  if (selected === true) {
    stoneButtonPressedFilled(button);
  } else {
    stoneButtonOutFilled(button);
  }

  const icon: Int = Button.CORNER;
  CS2.cc_create(button, Button.SPRITE_TYPE, icon, false);
  CS2.cc_position_set(0, 0, Button.POS_CENTER, Button.POS_CENTER);
  if (item !== -1) {
    CS2.cc_size_set(Button.ITEM_W, Button.ITEM_H, Button.SIZE_ABS, Button.SIZE_ABS);
    CS2.cc_item_nonum_set(item, Button.ITEM_COUNT);
    CS2.cc_outline_set(Button.ITEM_OUTLINE);
  } else {
    CS2.cc_size_set(Button.ICON_W, Button.ICON_H, Button.SIZE_ABS, Button.SIZE_ABS);
    CS2.cc_sprite_set(sprite);
  }
  CS2.cc_transparency_set(Button.OPAQUE);

  CS2.if_on_mouserepeat_set(() => pohCostumesSetTrans(button, icon, Button.HOVER_TRANS), button);
  CS2.if_on_mouseleave_set(() => pohCostumesSetTrans(button, icon, Button.OPAQUE), button);
}
