import { useServerState } from 'ts2';

import { SteelborderSprite } from '../lib/lib.constants';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { TutorialColors, TutorialFonts, TutorialLayout, TutorialVarbits } from './league-tutorial-main.constants';
import {
  bothButtons,
  tutorialBody,
  tutorialButton1,
  tutorialButton2,
  tutorialColour,
  tutorialGraphic,
  tutorialHeader,
  tutorialShortfall,
} from './league-tutorial-main.helpers';
import { TutorialButton } from './tutorial-button.component';

export function LeagueTutorialMain(): Component {
  const league: Int = useServerState(TutorialVarbits.LEAGUE);
  const page: Int = useServerState(TutorialVarbits.PAGE);

  const accent: Int = tutorialColour(league);
  const header: String = tutorialHeader(league, page);
  const body: String = tutorialBody(league, page);
  const label1: String = tutorialButton1(league, page);
  const label2: String = tutorialButton2(league, page);
  const graphic: Sprite = tutorialGraphic(league, page);

  const shortHeight: Int = TutorialLayout.PANEL_HEIGHT - tutorialShortfall(body) * TutorialLayout.BODY_LINE_HEIGHT;
  const paired: Boolean = bothButtons(label1, label2);

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <layer x="center" y="center" w={TutorialLayout.PANEL_WIDTH} h={shortHeight}>
        <layer x="center" y="center" w="fill" h="fill">
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={SteelborderSprite.BACKDROP} />
          <SteelFrameEntrypoint />
        </layer>

        <layer
          x="center"
          y="center"
          w={{ fill: TutorialLayout.CONTENT_INSET }}
          h={{ fill: TutorialLayout.CONTENT_INSET }}
        >
          <layer
            x="center"
            y={TutorialLayout.HEADER_Y}
            w={{ fill: TutorialLayout.HEADER_INSET }}
            h={TutorialLayout.HEADER_HEIGHT}
          >
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={header.length > 0 ? header : 'Leagues Tutorial'}
              font={TutorialFonts.HEADING}
              color={accent}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            x="center"
            y={TutorialLayout.BODY_Y}
            w={{ fill: TutorialLayout.BODY_INSET }}
            h={{ fill: TutorialLayout.BODY_BOTTOM_INSET }}
          >
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={body}
              font={TutorialFonts.BODY}
              color={accent}
              align="center"
              valign="middle"
              shadow
              lineHeight={TutorialLayout.BODY_LINE_HEIGHT}
            />
          </layer>

          {label1.length > 0 && <TutorialButton label={label1} offset={paired ? -TutorialLayout.BUTTON_OFFSET : 0} />}
          {label2.length > 0 && <TutorialButton label={label2} offset={paired ? TutorialLayout.BUTTON_OFFSET : 0} />}

          <layer
            x="center"
            y={{ bottom: TutorialLayout.GRAPHIC_BOTTOM }}
            w={TutorialLayout.GRAPHIC_WIDTH}
            h={TutorialLayout.GRAPHIC_HEIGHT}
          >
            {graphic !== -1 && <sprite x="center" y="center" w="fill" h="fill" sprite={graphic} />}
          </layer>
        </layer>
      </layer>
    </>
  );
}
