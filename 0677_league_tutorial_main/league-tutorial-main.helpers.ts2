import { leagueColour } from '../0735_league-3-fragments/league-3-fragments.helpers';
import { textLineCount } from '../lib/lib.engine';
import {
  League,
  LeagueRange,
  SharedTutorial,
  ShatteredRelicsTutorial,
  TutorialColors,
  TutorialFonts,
  TutorialLayout,
} from './league-tutorial-main.constants';

export function hasTutorial(league: Int): Boolean {
  if (league < LeagueRange.FIRST_WITH_TUTORIAL) {
    return false;
  }
  if (league > LeagueRange.LAST) {
    return false;
  }
  return true;
}

export function tutorialHeader(league: Int, page: Int): String {
  if (hasTutorial(league) === false) {
    return '';
  }
  if (league === League.SHATTERED_RELICS) {
    return ShatteredRelicsTutorial.HEADER.get(page) ?? 'Welcome to Leagues III: Shattered Relics!';
  }
  return SharedTutorial.HEADER.get(page) ?? 'Welcome to Leagues V - Raging Echoes!';
}

export function tutorialBody(league: Int, page: Int): String {
  if (hasTutorial(league) === false) {
    return '';
  }
  if (league === League.SHATTERED_RELICS) {
    return ShatteredRelicsTutorial.BODY.get(page) ?? '';
  }
  return SharedTutorial.BODY.get(page) ?? '';
}

export function tutorialButton1(league: Int, page: Int): String {
  if (hasTutorial(league) === false) {
    return '';
  }
  if (league === League.SHATTERED_RELICS) {
    return ShatteredRelicsTutorial.BUTTON_1.get(page) ?? '';
  }
  return SharedTutorial.BUTTON_1.get(page) ?? '';
}

export function tutorialButton2(league: Int, page: Int): String {
  if (hasTutorial(league) === false) {
    return '';
  }
  if (league === League.SHATTERED_RELICS) {
    return ShatteredRelicsTutorial.BUTTON_2.at(page) ?? '';
  }
  return SharedTutorial.BUTTON_2.at(page) ?? '';
}

export function tutorialGraphic(league: Int, page: Int): Sprite {
  if (hasTutorial(league) === false) {
    return -1;
  }
  if (league === League.SHATTERED_RELICS) {
    return ShatteredRelicsTutorial.GRAPHIC.get(page) ?? -1;
  }
  return SharedTutorial.GRAPHIC.get(page) ?? -1;
}

export function tutorialColour(league: Int): Int {
  if (league < LeagueRange.FIRST) {
    return TutorialColors.FALLBACK;
  }
  if (league > LeagueRange.LAST) {
    return TutorialColors.FALLBACK;
  }
  return leagueColour(league);
}

export function tutorialShortfall(body: String): Int {
  if (body.length === 0) {
    return 0;
  }
  let lines: Int = textLineCount(body, TutorialLayout.BODY_WIDTH, TutorialFonts.BODY) + 1;
  if (lines >= TutorialLayout.REFERENCE_LINES) {
    return 0;
  }
  if (lines < TutorialLayout.MIN_LINES) {
    lines = TutorialLayout.MIN_LINES;
  }
  return TutorialLayout.REFERENCE_LINES - lines;
}

export function bothButtons(label1: String, label2: String): Boolean {
  if (label1.length === 0) {
    return false;
  }
  if (label2.length === 0) {
    return false;
  }
  return true;
}
