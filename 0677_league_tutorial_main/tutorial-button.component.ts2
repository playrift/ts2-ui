import { CS2, useInterval, useState } from 'ts2';

import { Sounds } from '../lib/lib.constants';
import { clientClock, playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { TutorialColors, TutorialFonts, TutorialLayout, TutorialTiming } from './league-tutorial-main.constants';

export function TutorialButton({ label, offset }: { label: String; offset: Int }): Component {
  const mobile: Boolean = onMobile();
  const [pressed, setPressed] = useState(0);
  const [pinnedUntil, setPinnedUntil] = useState(0);

  const op: String = CS2.tags_remove(label);

  useInterval(
    () => {
      if (pinnedUntil > 0 && clientClock() >= pinnedUntil) {
        setPinnedUntil(0);
        setPressed(0);
      }
    },
    { everyMs: 20 },
  );

  return (
    <layer
      x={{ center: offset }}
      y={{ bottom: TutorialLayout.BUTTON_BOTTOM }}
      w={TutorialLayout.BUTTON_WIDTH}
      h={TutorialLayout.BUTTON_HEIGHT}
      options={[op]}
      onMouseRepeat={() => {
        if (!mobile && pinnedUntil === 0) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!mobile && pinnedUntil === 0) {
          setPressed(0);
        }
      }}
      onOptionSelect={() => {
        if (pinnedUntil === 0) {
          playSound(Sounds.CLICK);
          setPressed(1);
          setPinnedUntil(clientClock() + TutorialTiming.PRESS_CYCLES);
        }
      }}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={TutorialFonts.BODY}
        color={TutorialColors.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
