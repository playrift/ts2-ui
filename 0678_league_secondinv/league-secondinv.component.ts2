import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { Layout, SecondInvColors, SecondInvFonts, SecondInvSprites } from './league-secondinv.constants';

export function LeagueSecondinv(): Component {
  return (
    <>
      <text
        x={0}
        y={0}
        w="fill"
        h={Layout.TITLE_H}
        font={SecondInvFonts.TITLE}
        color={SecondInvColors.HEADING}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        x={{ right: Layout.CLOSE_INSET }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_BOX}
        h={Layout.CLOSE_BOX}
        sprite={SecondInvSprites.CLOSE_REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, SecondInvSprites.CLOSE_LIT)}
        onMouseLeave={(event) => graphicSwapper(event.component, SecondInvSprites.CLOSE_REST)}
      />

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PANE_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKING_INSET }}
          h={{ fill: Layout.BACKING_INSET }}
          sprite={SecondInvSprites.PANE_BACKING}
          tiling
        />
        <layer x="center" y="center" w={{ fill: Layout.ITEMS_INSET }} h={{ fill: Layout.ITEMS_INSET }} />
        <ThinStoneBoxEntrypoint />
      </layer>

      <text
        x="center"
        y="bottom"
        w="fill"
        h={{ fill: Layout.FOOTER_INSET_H }}
        font={SecondInvFonts.FOOTER}
        color={SecondInvColors.HEADING}
        shadow
        align="center"
        valign="middle"
      />

      <layer x={0} y={0} w={Layout.SPACER} h={Layout.SPACER} />
    </>
  );
}
