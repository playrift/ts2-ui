import { CS2, useServerState, useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { DesignColors, DesignFonts, DesignVarbits } from './player-design.constants';

export function BodyTypeButton({ label, value }: { label: String; value: Int }): Component {
  const mobile: Boolean = onMobile();
  const bodyType: Int = useServerState(DesignVarbits.BODY_TYPE);
  const [hovered, setHovered] = useState(0);

  const selected: Int = bodyType === value ? 1 : 0;
  const op: String = selected === 1 ? '' : CS2.tags_remove(label);

  return (
    <layer
      w="fill"
      h="fill"
      options={[op]}
      onMouseRepeat={() => {
        if (!mobile) {
          if (selected === 0) {
            setHovered(1);
          }
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          if (selected === 0) {
            setHovered(0);
          }
        }
      }}
    >
      {selected === 1 || hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={DesignFonts.BODY}
        color={selected === 1 ? DesignColors.BUTTON_LABEL_SELECTED : DesignColors.BUTTON_LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
