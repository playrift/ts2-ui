import { ProgressPips } from '../0929_tutorial_player_experience/progress-pips.component';
import { leaguesEnabled } from '../0735_league-3-fragments/league-3-fragments.helpers';
import { SteelborderColor } from '../lib/lib.constants';
import { SteelBorder } from '../lib/steel-border.component';
import { DesignCopy, DesignLayout } from './player-design.constants';

export function CreatorFrame(): Component {
  const leagues: Boolean = leaguesEnabled();

  return (
    <layer w="fill" h="fill">
      <SteelBorder title={DesignCopy.TITLE} titleColor={SteelborderColor.TITLE} flags={1} />

      {!leagues && <ProgressPips done={DesignLayout.PIPS_DONE} />}
    </layer>
  );
}
