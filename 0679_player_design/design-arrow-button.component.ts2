import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { DesignCopy, DesignLayout, DesignSprites } from './player-design.constants';

export function DesignArrowButton({ flip }: { flip: Int }): Component {
  const mobile: Boolean = onMobile();
  const [pressed, setPressed] = useState(0);

  return (
    <layer
      w="fill"
      h="fill"
      options={[DesignCopy.SELECT]}
      onMouseRepeat={() => {
        if (!mobile) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          setPressed(0);
        }
      }}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <sprite
        x="center"
        y="center"
        w={DesignLayout.ARROW_W}
        h={DesignLayout.ARROW_H}
        sprite={DesignSprites.ARROW}
        hflip={flip === 1 ? true : false}
      />
    </layer>
  );
}
