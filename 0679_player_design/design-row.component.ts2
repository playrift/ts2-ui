import { DesignArrowButton } from './design-arrow-button.component';
import { DesignColors, DesignFonts, DesignLayout } from './player-design.constants';

export function DesignRow({ label, y }: { label: String; y: Int }): Component {
  return (
    <layer x="center" y={y} w={{ fill: DesignLayout.ROW_INSET_W }} h={DesignLayout.ROW_H}>
      <text
        x="center"
        y="center"
        w={{ fill: DesignLayout.ROW_LABEL_INSET_W }}
        h={{ fill: DesignLayout.ROW_LABEL_INSET_H }}
        text={label}
        font={DesignFonts.BODY}
        color={DesignColors.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <DesignArrowButton
        x={DesignLayout.ARROW_BUTTON_INSET}
        y="center"
        w={DesignLayout.ARROW_BUTTON_W}
        h={DesignLayout.ARROW_BUTTON_H}
        flip={1}
      />
      <DesignArrowButton
        x={{ right: DesignLayout.ARROW_BUTTON_INSET }}
        y="center"
        w={DesignLayout.ARROW_BUTTON_W}
        h={DesignLayout.ARROW_BUTTON_H}
        flip={0}
      />
    </layer>
  );
}
