import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { BodyTypeButton } from './body-type-button.component';
import { CreatorFrame } from './creator-frame.component';
import { DesignConfirmButton } from './design-confirm-button.component';
import { DesignRow } from './design-row.component';
import { PronounDropdown } from './pronoun-dropdown.component';
import { DesignColors, DesignCopy, DesignFonts, DesignLayout, DesignSprites } from './player-design.constants';

export function PlayerDesign(): Component {
  return (
    <>
      <layer x={0} y={0} w="fill" h="fill" noClickThrough />

      <layer x="center" y="center" w={DesignLayout.PANEL_W} h={DesignLayout.PANEL_H}>
        <CreatorFrame />

        <sprite
          x={DesignLayout.RULE_V_X}
          y={DesignLayout.RULE_V_Y}
          w={DesignLayout.RULE_V_W}
          h={DesignLayout.RULE_V_H}
          sprite={DesignSprites.RULE_V}
          tiling
        />
        <sprite
          x={{ right: DesignLayout.RULE_V_X }}
          y={DesignLayout.RULE_V_Y}
          w={DesignLayout.RULE_V_W}
          h={DesignLayout.RULE_V_H}
          sprite={DesignSprites.RULE_V}
          tiling
        />

        <sprite
          x={{ right: DesignLayout.RULE_H8_RIGHT }}
          y={{ bottom: DesignLayout.RULE_H8_BOTTOM }}
          w={DesignLayout.RULE_H8_W}
          h={DesignLayout.RULE_H_H}
          sprite={DesignSprites.RULE_H}
          tiling
        />
        <sprite
          x={{ right: DesignLayout.RULE_H9_RIGHT }}
          y={DesignLayout.RULE_H9_Y}
          w={DesignLayout.RULE_H9_W}
          h={DesignLayout.RULE_H_H}
          sprite={DesignSprites.RULE_H}
          tiling
        />

        <layer x={DesignLayout.DESIGN_X} y={DesignLayout.COLUMN_Y} w={DesignLayout.COLUMN_W} h={DesignLayout.DESIGN_H}>
          <text
            x="center"
            y={DesignLayout.HEADING_Y}
            w={{ fill: DesignLayout.HEADING_INSET_W }}
            h={DesignLayout.HEADING_H}
            text={DesignCopy.DESIGN}
            font={DesignFonts.HEADING}
            color={DesignColors.LABEL}
            align="center"
            valign="top"
            shadow
          />
          <layer x="center" y={DesignLayout.STACK_Y} w="fill" h={DesignLayout.DESIGN_STACK_H}>
            <DesignRow label={DesignCopy.HEAD} y={DesignLayout.ROW_0_Y} />
            <DesignRow label={DesignCopy.JAW} y={DesignLayout.ROW_1_Y} />
            <DesignRow label={DesignCopy.TORSO} y={DesignLayout.ROW_2_Y} />
            <DesignRow label={DesignCopy.ARMS} y={DesignLayout.ROW_3_Y} />
            <DesignRow label={DesignCopy.HANDS} y={DesignLayout.ROW_4_Y} />
            <DesignRow label={DesignCopy.LEGS} y={DesignLayout.ROW_5_Y} />
            <DesignRow label={DesignCopy.FEET} y={DesignLayout.ROW_6_Y} />
          </layer>
        </layer>

        <layer
          x={{ right: DesignLayout.DESIGN_X }}
          y={DesignLayout.COLUMN_Y}
          w={DesignLayout.COLUMN_W}
          h={DesignLayout.COLOUR_H}
        >
          <text
            x="center"
            y={DesignLayout.HEADING_Y}
            w={{ fill: DesignLayout.HEADING_INSET_W }}
            h={DesignLayout.HEADING_H}
            text={DesignCopy.COLOUR}
            font={DesignFonts.HEADING}
            color={DesignColors.LABEL}
            align="center"
            valign="top"
            shadow
          />
          <layer x="center" y={DesignLayout.STACK_Y} w="fill" h={DesignLayout.COLOUR_STACK_H}>
            <DesignRow label={DesignCopy.HAIR} y={DesignLayout.ROW_0_Y} />
            <DesignRow label={DesignCopy.TORSO} y={DesignLayout.ROW_1_Y} />
            <DesignRow label={DesignCopy.LEGS} y={DesignLayout.ROW_2_Y} />
            <DesignRow label={DesignCopy.FEET} y={DesignLayout.ROW_3_Y} />
            <DesignRow label={DesignCopy.SKIN} y={DesignLayout.ROW_4_Y} />
          </layer>
        </layer>

        <layer
          x={{ right: DesignLayout.DESIGN_X }}
          y={DesignLayout.BODYTYPE_Y}
          w={DesignLayout.COLUMN_W}
          h={DesignLayout.BODYTYPE_H}
        >
          <text
            x="center"
            y={DesignLayout.HEADING_Y}
            w={{ fill: DesignLayout.HEADING_INSET_W }}
            h={DesignLayout.HEADING_H}
            text={DesignCopy.BODY_TYPE}
            font={DesignFonts.HEADING}
            color={DesignColors.LABEL}
            align="center"
            valign="top"
            shadow
          />
          <layer x="center" y={DesignLayout.STACK_Y} w="fill" h={DesignLayout.BODYTYPE_STACK_H}>
            <layer x="center" y={DesignLayout.ROW_0_Y} w={{ fill: DesignLayout.ROW_INSET_W }} h={DesignLayout.ROW_H}>
              <BodyTypeButton
                x={DesignLayout.ARROW_BUTTON_INSET}
                y="center"
                w={DesignLayout.BODYTYPE_BUTTON_W}
                h={DesignLayout.BODYTYPE_BUTTON_H}
                label={DesignCopy.TYPE_A}
                value={0}
              />
              <BodyTypeButton
                x={{ right: DesignLayout.ARROW_BUTTON_INSET }}
                y="center"
                w={DesignLayout.BODYTYPE_BUTTON_W}
                h={DesignLayout.BODYTYPE_BUTTON_H}
                label={DesignCopy.TYPE_B}
                value={1}
              />
            </layer>
          </layer>
        </layer>

        <layer x="center" y={DesignLayout.COLUMN_Y} w={DesignLayout.COLUMN_W} h={DesignLayout.PRONOUNS_H}>
          <text
            x="center"
            y={DesignLayout.HEADING_Y}
            w={DesignLayout.PRONOUN_HEADING_W}
            h={DesignLayout.HEADING_H}
            text={DesignCopy.PRONOUNS}
            font={DesignFonts.HEADING}
            color={DesignColors.LABEL}
            align="center"
            valign="top"
            shadow
          />
          <PronounDropdown
            x="center"
            y={{ bottom: DesignLayout.DROPDOWN_BOTTOM }}
            w={DesignLayout.DROPDOWN_W}
            h={DesignLayout.DROPDOWN_H}
          />
        </layer>

        <model
          x="center"
          y={{ bottom: DesignLayout.PREVIEW_BOTTOM }}
          w={DesignLayout.PREVIEW_W}
          h={DesignLayout.PREVIEW_H}
          contentType={DesignLayout.PREVIEW_CONTENT_TYPE}
          zoom={DesignLayout.PREVIEW_ZOOM}
          offsetY={DesignLayout.PREVIEW_OFFSET_Y}
        />

        <DesignConfirmButton
          x="center"
          y={{ bottom: DesignLayout.CONFIRM_BOTTOM }}
          w={DesignLayout.CONFIRM_W}
          h={DesignLayout.CONFIRM_H}
          label={DesignCopy.CONFIRM}
        />
      </layer>

      <layer x={0} y={0} w="fill" h="fill" hide noClickThrough>
        <rect x="center" y="center" w="fill" h="fill" fill color={DesignColors.SCRIM} transparency={255} />

        <layer x={0} y={0} w={DesignLayout.LIST_W} h={DesignLayout.LIST_H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={DesignSprites.LIST_BACKING} tiling />
          <layer
            x={DesignLayout.LIST_BODY_X}
            y="center"
            w={{ fill: DesignLayout.LIST_BODY_INSET_W }}
            h={{ fill: DesignLayout.LIST_BODY_INSET_H }}
          />
          <layer
            x={{ right: DesignLayout.LIST_BAR_RIGHT }}
            y="center"
            w={DesignLayout.LIST_BAR_W}
            h={{ fill: DesignLayout.LIST_BODY_INSET_H }}
          />
          <ThinBoxEntrypoint />
        </layer>
      </layer>

      <layer x={0} y={0} w={DesignLayout.ANCHOR} h={DesignLayout.ANCHOR} />
