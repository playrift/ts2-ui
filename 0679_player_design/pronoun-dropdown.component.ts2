import { useServerState, useState } from 'ts2';

import {
  DesignColors,
  DesignCopy,
  DesignFonts,
  DesignLayout,
  DesignSprites,
  DesignVarbits,
  PronounNames,
} from './player-design.constants';

export function PronounDropdown(): Component {
  const pronouns: Int = useServerState(DesignVarbits.PRONOUNS);
  const [hovered, setHovered] = useState(0);

  const value: String = PronounNames.at(pronouns) ?? DesignCopy.PRONOUNS;

  const plateAlpha: Int = hovered === 1 ? 100 : 0;
  const chevronAlpha: Int = hovered === 1 ? 125 : 0;
  const valueColor: Int = hovered === 1 ? DesignColors.DROPDOWN_VALUE_HOVER : DesignColors.DROPDOWN_VALUE;

  return (
    <layer w="fill" h="fill">
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={DesignLayout.DROPDOWN_CONTROL_H}
        sprite={DesignSprites.PLATE}
        tiling
        transparency={plateAlpha}
        onMouseEnter={() => setHovered(1)}
        onMouseLeave={() => setHovered(0)}
      />
      <rect x="center" y="bottom" w="fill" h={DesignLayout.DROPDOWN_CONTROL_H} color={DesignColors.DROPDOWN_BORDER} />
      <rect
        x="center"
        y={{ bottom: DesignLayout.DROPDOWN_INNER_BOTTOM }}
        w={{ fill: DesignLayout.DROPDOWN_INNER_INSET_W }}
        h={DesignLayout.DROPDOWN_INNER_H}
        color={DesignColors.DROPDOWN_INNER}
      />
      <sprite
        x={{ right: DesignLayout.DROPDOWN_CHEVRON_INSET }}
        y={{ bottom: DesignLayout.DROPDOWN_CHEVRON_INSET }}
        w={DesignLayout.DROPDOWN_CHEVRON}
        h={DesignLayout.DROPDOWN_CHEVRON}
        sprite={DesignSprites.CHEVRON_CLOSED}
        transparency={chevronAlpha}
      />
      <text
        x={DesignLayout.DROPDOWN_VALUE_X}
        y={{ bottom: DesignLayout.DROPDOWN_VALUE_BOTTOM }}
        w={{ fill: DesignLayout.DROPDOWN_VALUE_INSET_W }}
        h={DesignLayout.DROPDOWN_VALUE_H}
        text={value}
        font={DesignFonts.VALUE}
        color={valueColor}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y="top"
        w="fill"
        h={{ fill: DesignLayout.DROPDOWN_CAPTION_INSET_H }}
        text={DesignCopy.DROPDOWN_CAPTION}
        font={DesignFonts.BODY}
        color={DesignColors.LABEL}
        shadow
        align="left"
        valign="middle"
      />
    </layer>
  );
}
