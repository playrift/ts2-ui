import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  BookArt,
  BookColors,
  BookFonts,
  BookModels,
  IndexSlots,
  Layout,
  LeftLines,
  PictureSlots,
  RightLines,
} from './indexed-book.constants';
import { colourSwapperUnlessMobile } from './indexed-book.helpers';

export function IndexedBook(): Component {
  return (
    <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
      <layer x="center" y={{ center: Layout.BACKDROP_DY }} w={Layout.STAGE_W} h={Layout.STAGE_H}>
        {BookModels.map((model) => (
          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_SIZE}
            h={Layout.MODEL_SIZE}
            model={model}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
            yaw={Layout.MODEL_YAW}
          />
        ))}
      </layer>

      <text
        x={{ center: Layout.TITLE_DX }}
        y={Layout.TITLE_Y}
        w={Layout.TITLE_W}
        h={Layout.TITLE_H}
        font={BookFonts.BODY}
        color={BookColors.HEADING}
        shadow
        align="center"
        text="Title"
      />

      <layer
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, BookArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, BookArt.CLOSE)}
      >
        <sprite x="center" y="center" w={Layout.CLOSE_W} h={Layout.CLOSE_H} sprite={BookArt.CLOSE} />
      </layer>

      <text
        x={{ right: Layout.CAPTION_RIGHT }}
        y={Layout.CAPTION_TOP}
        w={Layout.CAPTION_W}
        h={Layout.CAPTION_H}
        font={BookFonts.CAPTION}
        color={BookColors.HEADING}
        shadow
        align="center"
        valign="middle"
        continueOp
        text="First Page"
        onMouseEnter={(event) => colourSwapperUnlessMobile(event.component, BookColors.HEADING_HOVER)}
        onMouseLeave={(event) => colourSwapperUnlessMobile(event.component, BookColors.HEADING)}
      />

      <text
        x={Layout.PAGENO_X}
        y={{ bottom: Layout.PAGENO_BOTTOM }}
        w={Layout.PAGENO_W}
        h={Layout.PAGENO_H}
        font={BookFonts.BODY}
        color={BookColors.INK}
        text="1"
      />
      <text
        x={{ right: Layout.PAGENO_RIGHT }}
        y={{ bottom: Layout.PAGENO_BOTTOM }}
        w={Layout.PAGENO_W}
        h={Layout.PAGENO_H}
        font={BookFonts.BODY}
        color={BookColors.INK}
        align="right"
        text="2"
      />

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PICTURE_PANE_H}>
        {PictureSlots.map((slot) => (
          <model
            x="center"
            y={slot.y}
            w={Layout.PICTURE_SIZE}
            h={Layout.PICTURE_SIZE}
            zoom={Layout.PICTURE_ZOOM}
            hide
          />
        ))}
      </layer>
      <layer x={{ right: Layout.PANE_X }} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PICTURE_PANE_H}>
        {PictureSlots.map((slot) => (
          <model
            x="center"
            y={slot.y}
            w={Layout.PICTURE_SIZE}
            h={Layout.PICTURE_SIZE}
            zoom={Layout.PICTURE_ZOOM}
            hide
          />
        ))}
      </layer>

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.TEXT_PANE_H}>
        {LeftLines.map((line) => (
          <text
            x="center"
            y={line.y}
            w="fill"
            h={Layout.LINE_H}
            font={BookFonts.BODY}
            color={BookColors.INK}
            text={line.text}
          />
        ))}
      </layer>
      <layer x={{ right: Layout.PANE_X }} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.TEXT_PANE_H}>
        {RightLines.map((line) => (
          <text
            x="center"
            y={line.y}
            w="fill"
            h={Layout.LINE_H}
            font={BookFonts.BODY}
            color={BookColors.INK}
            text={line.text}
          />
        ))}
      </layer>

      <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.TEXT_PANE_H}>
        {IndexSlots.map((slot) => (
          <text
            x="center"
            y={slot.y}
            w="fill"
            h={Layout.INDEX_H}
            font={BookFonts.BODY}
            color={BookColors.INK}
            continueOp
            hide
            onMouseEnter={(event) => colourSwapperUnlessMobile(event.component, BookColors.INK_HOVER)}
            onMouseLeave={(event) => colourSwapperUnlessMobile(event.component, BookColors.INK)}
          />
        ))}
      </layer>
      <layer x={{ right: Layout.PANE_X }} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.TEXT_PANE_H}>
        {IndexSlots.map((slot) => (
          <text
            x="center"
            y={slot.y}
            w="fill"
            h={Layout.INDEX_H}
            font={BookFonts.BODY}
            color={BookColors.INK}
            continueOp
            hide
            onMouseEnter={(event) => colourSwapperUnlessMobile(event.component, BookColors.INK_HOVER)}
            onMouseLeave={(event) => colourSwapperUnlessMobile(event.component, BookColors.INK)}
          />
        ))}
      </layer>

      <layer
        x={Layout.ARROW_X}
        y={{ bottom: 0 }}
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        continueOp
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, BookArt.PREVIOUS_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, BookArt.PREVIOUS)}
      >
        <sprite x="center" y="center" w={Layout.ARROW_W} h={Layout.ARROW_H} sprite={BookArt.PREVIOUS} />
      </layer>
      <layer
        x={{ right: Layout.ARROW_X }}
        y={{ bottom: 0 }}
        w={Layout.ARROW_W}
        h={Layout.ARROW_H}
        continueOp
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, BookArt.NEXT_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, BookArt.NEXT)}
      >
        <sprite x="center" y="center" w={Layout.ARROW_W} h={Layout.ARROW_H} sprite={BookArt.NEXT} />
      </layer>
    </layer>
  );
}
