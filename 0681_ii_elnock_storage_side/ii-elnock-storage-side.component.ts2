import { QuantityTable } from '../0126_farming_tools_side/carried-tools.shared';
import { DepositAllButton } from './deposit-all-button.component';
import { DepositButton, StorageSlot } from './ii-elnock-storage-side.constants';
import { STORAGE_TOOLS } from './ii-elnock-storage-side.data';
import { StorageToolSlot } from './storage-slot.component';

export function IiElnockStorageSide(): Component {
  return (
    <>
      {STORAGE_TOOLS.map((tool, index) => (
        <layer
          x={index === 0 ? 0 : index === 1 ? { right: 0 } : 'center'}
          y={(index / 2) * StorageSlot.HEIGHT}
          w={StorageSlot.WIDTH}
          h={StorageSlot.HEIGHT}
        >
          <StorageToolSlot table={QuantityTable.ELNOCK_STORAGE} item={tool.item} label={tool.label} />
        </layer>
      ))}

      <layer x="center" y="bottom" w={DepositButton.WIDTH} h={DepositButton.HEIGHT}>
        <DepositAllButton label="Deposit" />
      </layer>
    </>
  );
}
