import { ColumnRows, TemporossColor, TemporossFont, TemporossLayout } from './tempoross-stats.constants';

export function StatsColumn({ totalLabel, fastestLabel }: { totalLabel: String; fastestLabel: String }): Component {
  return (
    <>
      <text
        x="center"
        y={ColumnRows.totalLabel}
        w={ColumnRows.w}
        h={TemporossLayout.row.h}
        text={totalLabel}
        font={TemporossFont.LABEL}
        align="center"
        shadow
        color={TemporossColor.LABEL}
      />
      <text
        x="center"
        y={ColumnRows.totalValue}
        w={ColumnRows.w}
        h={TemporossLayout.row.h}
        text="-"
        font={TemporossFont.VALUE}
        align="center"
        shadow
        color={TemporossColor.VALUE}
      />
      <text
        x="center"
        y={ColumnRows.fastestLabel}
        w={ColumnRows.w}
        h={TemporossLayout.row.h}
        text={fastestLabel}
        font={TemporossFont.LABEL}
        align="center"
        shadow
        color={TemporossColor.LABEL}
      />
      <text
        x="center"
        y={ColumnRows.fastestValue}
        w={ColumnRows.w}
        h={TemporossLayout.row.h}
        text="-"
        font={TemporossFont.VALUE}
        align="center"
        shadow
        color={TemporossColor.VALUE}
      />
    </>
  );
}
