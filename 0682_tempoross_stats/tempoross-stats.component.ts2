import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StatsColumn } from './stats-column.component';
import {
  CloseHitbox,
  HeaderModels,
  StripRows,
  TemporossColor,
  TemporossFont,
  TemporossLayout,
} from './tempoross-stats.constants';

export function TemporossStats(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Tempoross Statistics">
        <layer
          x={{ right: CloseHitbox.right }}
          y={CloseHitbox.y}
          w={CloseHitbox.w}
          h={CloseHitbox.h}
          options={['Close']}
        />
      </SteelBorderEntrypoint>

      <layer
        x={TemporossLayout.content.x}
        y={TemporossLayout.content.y}
        w={{ fill: TemporossLayout.content.inset }}
        h={{ fill: TemporossLayout.content.drop }}
      >
        <layer y="bottom" w="fill" h={{ fill: TemporossLayout.strip.drop }}>
          <line
            x="center"
            y={TemporossLayout.rule.y}
            w={TemporossLayout.rule.w}
            h={0}
            color={TemporossColor.RULE}
            lineWidth={1}
          />

          <text
            x={{ center: StripRows.bestPointsLabel.dx }}
            y={StripRows.bestPointsLabel.y}
            w={StripRows.bestPointsLabel.w}
            h={TemporossLayout.row.h}
            text="My Best Points:"
            font={TemporossFont.LABEL}
            shadow
            color={TemporossColor.LABEL}
          />
          <text
            x={{ center: StripRows.bestPointsValue.dx }}
            y={StripRows.bestPointsValue.y}
            w={StripRows.bestPointsValue.w}
            h={TemporossLayout.row.h}
            text="-"
            font={TemporossFont.VALUE}
            shadow
            color={TemporossColor.VALUE}
          />
          <text
            x={{ center: StripRows.rewardsLabel.dx }}
            y={StripRows.rewardsLabel.y}
            w={StripRows.rewardsLabel.w}
            h={TemporossLayout.row.h}
            text="My Total Rewards Claimed:"
            font={TemporossFont.LABEL}
            shadow
            color={TemporossColor.LABEL}
          />
          <text
            x={{ center: StripRows.rewardsValue.dx }}
            y={StripRows.rewardsValue.y}
            w={StripRows.rewardsValue.w}
            h={TemporossLayout.row.h}
            text="-"
            font={TemporossFont.VALUE}
            shadow
            color={TemporossColor.VALUE}
          />
        </layer>

        <layer x="left" y="top" w={TemporossLayout.column.w} h={TemporossLayout.column.h}>
          <StatsColumn totalLabel="My Total Completions" fastestLabel="My Fastest Completion" />
        </layer>

        <layer x="right" y="top" w={TemporossLayout.column.w} h={TemporossLayout.column.h}>
          <StatsColumn totalLabel="Global Total Completions" fastestLabel="Global Fastest Completion" />
        </layer>
      </layer>

      {HeaderModels.map((decor) => (
        <model
          x={{ center: decor.dx }}
          y={decor.y}
          w={decor.w}
          h={decor.h}
          model={decor.model}
          zoom={decor.zoom}
          pitch={decor.pitch}
          yaw={decor.yaw}
          roll={decor.roll}
          offsetY={decor.offsetY}
        />
      ))}
    </>
  );
}
