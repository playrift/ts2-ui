import { predictServerState, useRef, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { TackleBoxColor, TackleBoxFonts, TackleBoxSounds, TackleBoxVarbits } from './tackle-box-main.constants';

export function QuantityButton({ label, quantity }: { label: String; quantity: Int }): Component {
  const armed: Int = useServerState(TackleBoxVarbits.QUANTITY);
  const face = useRef();

  if (armed === quantity) {
    return (
      <layer w="fill" h="fill" options={[label]}>
        <StoneButtonPressedFilled>
          <text
            w="fill"
            h="fill"
            text={label}
            font={TackleBoxFonts.LABEL}
            color={TackleBoxColor.SELECTED}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonPressedFilled>
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        face.color = TackleBoxColor.SELECTED;
      }}
      onMouseLeave={() => {
        face.color = TackleBoxColor.IDLE;
      }}
      onOptionSelect={() => {
        playSound(TackleBoxSounds.CLICK);
        predictServerState(TackleBoxVarbits.QUANTITY, quantity);
      }}
    >
      <StoneButtonOutFilled>
        <text
          ref={face}
          w="fill"
          h="fill"
          text={label}
          font={TackleBoxFonts.LABEL}
          color={TackleBoxColor.IDLE}
          shadow
          align="center"
          valign="middle"
        />
      </StoneButtonOutFilled>
    </layer>
  );
}
