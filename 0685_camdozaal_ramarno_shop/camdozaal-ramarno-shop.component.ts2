import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { BuffCell } from './buff-cell.component';
import { RamarnoShardTotal } from './shard-total.component';
import { BUFF_CELLS, BuffCellLayout, RamarnoPanel } from './camdozaal-ramarno-shop.constants';

export function CamdozaalRamarnoShop(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Ramarno's Shard Exchange" />

      <RamarnoShardTotal
        x="center"
        y={{ bottom: RamarnoPanel.TOTAL_BOTTOM }}
        w={{ fill: RamarnoPanel.TOTAL_INSET }}
        h={RamarnoPanel.TOTAL_HEIGHT}
      />

      {BUFF_CELLS.map(({ slot, x, y, subject }) => (
        <layer
          x={{ center: x }}
          y={y}
          w={BuffCellLayout.WIDTH}
          h={BuffCellLayout.HEIGHT}
          options={['Buy']}
          optionSubject={subject}
        >
          <BuffCell slot={slot} />
        </layer>
      ))}
    </>
  );
}
