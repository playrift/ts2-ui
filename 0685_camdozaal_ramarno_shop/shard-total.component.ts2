import { useServerState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { RamarnoColors, RamarnoFonts, RamarnoVarps } from './camdozaal-ramarno-shop.constants';

export function RamarnoShardTotal(): Component {
  const stored: Int = useServerState(RamarnoVarps.STORED_BARRONITE);
  const grouped: String = groupDigits(stored, ',');
  const label: String = `<col=ff981f>Total Barronite Shards:</col><col=ffffff> ${grouped}</col>`;

  return (
    <text
      w="fill"
      h="fill"
      text={label}
      font={RamarnoFonts.BOLD}
      align="center"
      valign="middle"
      shadow
      color={RamarnoColors.WHITE}
    />
  );
}
