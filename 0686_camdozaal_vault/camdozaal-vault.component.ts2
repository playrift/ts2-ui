import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, VaultColor, VaultFonts, VaultOverlay } from './camdozaal-vault.constants';

const timerHost = createRef('0686_camdozaal_vault_timer_host');

const timer = createRef('camdozaal_vault_timer');

export function CamdozaalVault(): Component {
  useInterval(() => overlayRelayout(timerHost, timer, VaultOverlay.DODGE, Anchor.CENTRE, Anchor.TOP, 0), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x={0} y={0} w="fill" h="fill" ref={timerHost}>
        <layer ref={timer} x="center" y={Layout.TIMER_Y} w={{ fill: Layout.TIMER_MARGIN }} h={Layout.TIMER_H}>
          <text
            x={Layout.TEXT_X}
            y={Layout.TEXT_Y}
            w={{ fill: Layout.TEXT_MARGIN }}
            h={Layout.TEXT_H}
            font={VaultFonts.TIMER}
            color={VaultColor.TIMER}
            shadow
            valign="middle"
          />
        </layer>
      </layer>
    </layer>
  );
}
