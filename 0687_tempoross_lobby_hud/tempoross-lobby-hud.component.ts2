import { createRef } from 'ts2';

import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import {
  Layout,
  Rows,
  STONE_DIVIDER,
  TEMPOROSS_ORANGE,
  TemporossFonts,
  TemporossLobbyDodge,
  TemporossSprites,
} from './tempoross-lobby-hud.constants';

const content = createRef('tempoross_lobby_hud_content');

export function TemporossLobbyHud(): Component {
  return (
    <layer x={0} y={0} w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H}>
      <layer
        x={0}
        y={0}
        w={Layout.UNIVERSE_W}
        h={Layout.UNIVERSE_H}
        onTimer={(event) =>
          overlayRelayout(
            event.component,
            content,
            TemporossLobbyDodge.DODGE,
            Anchor.LEFT,
            Anchor.TOP,
            TemporossLobbyDodge.SIDEWAYS,
          )
        }
      >
        <layer ref={content} x={0} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={TemporossSprites.BACKING} tiling transparency={80} />

          <text
            x="center"
            y={Layout.WAITING_Y}
            w={{ fill: Layout.ROW_INSET }}
            h={Layout.ROW_H}
            text={Rows.WAITING}
            font={TemporossFonts.ROW}
            color={TEMPOROSS_ORANGE}
            align="center"
            shadow
            lineHeight={Layout.ROW_LINE_H}
          />

          <text
            x="center"
            y={Layout.DEPARTURE_Y}
            w={{ fill: Layout.ROW_INSET }}
            h={Layout.ROW_H}
            text={Rows.DEPARTURE}
            font={TemporossFonts.ROW}
            color={TEMPOROSS_ORANGE}
            align="center"
            shadow
            lineHeight={Layout.ROW_LINE_H}
          />

          <StonePanelEntrypoint divider={STONE_DIVIDER} />
        </layer>
      </layer>
    </layer>
  );
}
