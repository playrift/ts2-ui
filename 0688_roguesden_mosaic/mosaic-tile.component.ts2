import { Camera, Layout } from './roguesden-mosaic.constants';
import { mosaicTileDistance } from './roguesden-mosaic.helpers';

export function MosaicTile({
  model,
  x,
  y,
  hidden,
  mobile,
}: {
  model: Model;
  x: Int;
  y: Int;
  hidden: Boolean;
  mobile: Boolean;
}): Component {
  return (
    <model
      x={x}
      y={y}
      w={Layout.TILE}
      h={Layout.TILE}
      model={model}
      pitch={Camera.PITCH}
      zoom={Camera.REST_ZOOM}
      hide={hidden}
      options={['Select']}
      onMouseEnter={mobile ? undefined : (event) => mosaicTileDistance(event.component, Camera.HOVER_ZOOM)}
      onMouseLeave={mobile ? undefined : (event) => mosaicTileDistance(event.component, Camera.REST_ZOOM)}
    />
  );
}
