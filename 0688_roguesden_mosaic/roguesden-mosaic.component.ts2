import { useInventory } from 'ts2';

import { closeInterface, graphicSwapper, onMobile } from '../lib/lib.helpers';
import { MosaicTile } from './mosaic-tile.component';
import { Camera, Layout, MosaicArt, MosaicInventory, MosaicModels, MosaicTiles } from './roguesden-mosaic.constants';

export function RoguesdenMosaic(): Component {
  const backpack = useInventory(MosaicInventory.BACKPACK);

  const held1: Int = backpack.total(MosaicTiles.TILE_1);
  const held2: Int = backpack.total(MosaicTiles.TILE_2);
  const held3: Int = backpack.total(MosaicTiles.TILE_3);
  const held4: Int = backpack.total(MosaicTiles.TILE_4);

  let hidden1: Boolean = true;
  if (held1 > 0) {
    hidden1 = false;
  }
  let hidden2: Boolean = true;
  if (held2 > 0) {
    hidden2 = false;
  }
  let hidden3: Boolean = true;
  if (held3 > 0) {
    hidden3 = false;
  }
  let hidden4: Boolean = true;
  if (held4 > 0) {
    hidden4 = false;
  }

  const mobile: Boolean = onMobile();

  return (
    <>
      <layer w="fill" h="fill">
        <model
          x={Layout.FIXED_A_X}
          y={Layout.FIXED_A_Y}
          w={Layout.TILE}
          h={Layout.TILE}
          model={MosaicModels.FIXED_A}
          pitch={Camera.PITCH}
          zoom={Camera.REST_ZOOM}
        />
        <model
          x={Layout.FIXED_B_X}
          y={Layout.FIXED_B_Y}
          w={Layout.TILE}
          h={Layout.TILE}
          model={MosaicModels.FIXED_B}
          pitch={Camera.PITCH}
          zoom={Camera.REST_ZOOM}
        />

        <MosaicTile
          model={MosaicModels.TILE_1}
          x={Layout.TILE_1_X}
          y={Layout.TILE_1_Y}
          hidden={hidden1}
          mobile={mobile}
        />
        <MosaicTile
          model={MosaicModels.TILE_2}
          x={Layout.TILE_2_X}
          y={Layout.TILE_2_Y}
          hidden={hidden2}
          mobile={mobile}
        />
        <MosaicTile
          model={MosaicModels.TILE_3}
          x={Layout.TILE_3_X}
          y={Layout.TILE_3_Y}
          hidden={hidden3}
          mobile={mobile}
        />
        <MosaicTile
          model={MosaicModels.TILE_4}
          x={Layout.TILE_4_X}
          y={Layout.TILE_4_Y}
          hidden={hidden4}
          mobile={mobile}
        />
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={MosaicArt.CLOSE_REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, MosaicArt.CLOSE_LIT)}
        onMouseLeave={(event) => graphicSwapper(event.component, MosaicArt.CLOSE_REST)}
      />
    </>
  );
}
