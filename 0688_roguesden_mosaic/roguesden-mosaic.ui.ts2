import { createRef } from 'ts2';

import { RoguesdenMosaic } from './roguesden-mosaic.component';
import { Layout } from './roguesden-mosaic.constants';

const roguesdenMosaicRef = createRef('roguesden_mosaic');

export const roguesdenMosaicUi = (): UI => (
  <ui ref={roguesdenMosaicRef} w={Layout.ROOT_W} h={Layout.ROOT_H}>
    <RoguesdenMosaic />
  </ui>
);
