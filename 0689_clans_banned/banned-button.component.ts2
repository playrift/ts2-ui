import { useState } from 'ts2';

import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { ClanBannedFonts, OP_SOUND_MASK } from './clans-banned.constants';

export function BannedButton({ label, option }: { label: String; option: String }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[option]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
    >
      <StoneButtonDraw label={label} font={ClanBannedFonts.BODY} pressed={skin} />
    </layer>
  );
}
