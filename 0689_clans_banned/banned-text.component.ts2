import { CS2 } from 'ts2';

import { textDevice } from '../lib/lib.helpers';
import { leagueWorld } from '../0162_chatbox/chatbox.helpers';
import { speedrunningWorld } from '../0134_settings/settings.helpers';
import { eventInvocationsUnlocked } from '../0776_toa_invocations/toa-invocations.helpers';
import { clanStatusText } from '../0696_clans_storage_main/clan-interface-title';
import { clanRankTitle } from '../0696_clans_storage_main/clan-permission';
import { banFromChatRank } from '../0701_clans_sidepanel/clan-channel-pane.component';
import { AffinityStatus, ClanBannedText } from './clans-banned.constants';

export function bannedClanLoaded(asGuest: Int, guestStatus: Int, status: Int): Int {
  if (asGuest === 1 && guestStatus === AffinityStatus.LIVE && CS2.activeclansettings_listened_find()) {
    return 1;
  }
  if (asGuest === 0 && status === AffinityStatus.LIVE && CS2.activeclansettings_affined_find(0)) {
    return 1;
  }
  return 0;
}

export function bannedTitle(
  loaded: Int,
  searching: Int,
  filter: String,
  asGuest: Int,
  guestStatus: Int,
  status: Int,
): String {
  if (loaded === 0) {
    return clanStatusText(asGuest, guestStatus, status);
  }
  if (searching === 1) {
    if (filter.length > 0) {
      return `${ClanBannedText.SEARCH_TITLE}<col=ff0000>${filter}</col>`;
    }
    return `${ClanBannedText.SEARCH_TITLE}<col=ff0000>${ClanBannedText.SEARCH_ANY}</col>`;
  }
  return `${CS2.activeclansettings_clan_name_get()}: ${ClanBannedText.TITLE_SUFFIX}`;
}

export function bannedHintText(loaded: Int, asGuest: Int, guestStatus: Int, status: Int): String {
  if (loaded === 0) {
    return `<col=9f9f9f>${clanStatusText(asGuest, guestStatus, status)}</col>`;
  }
  const mySlot: Int = CS2.activeclansettings_affined_slot_get(CS2.tags_remove(CS2.chat_playername()));
  if (mySlot === -1) {
    return ClanBannedText.HINT_MEMBERS_ONLY;
  }
  const banRank: Int = banFromChatRank();
  if (CS2.activeclansettings_affined_rank_get(mySlot) >= banRank) {
    return `${textDevice('Click', 'Tap')}${ClanBannedText.HINT_MAY}`;
  }
  const title: String = clanRankTitle(banRank);
  if (leagueWorld()) {
    return ClanBannedText.HINT_LEAGUE;
  }
  if (speedrunningWorld()) {
    return ClanBannedText.HINT_SPEEDRUN;
  }
  if (eventInvocationsUnlocked()) {
    return ClanBannedText.HINT_THIS_WORLD;
  }
  return `${ClanBannedText.HINT_RANK_PREFIX}${title}${ClanBannedText.HINT_RANK_SUFFIX}`;
}
