import { CS2 } from 'ts2';

import { AFFINITY_LIVE, ClanInfoArm } from './clans-info.constants';

export function clanInfoArm(asGuest: Int, guestStatus: Int, status: Int): Int {
  if (asGuest === 1) {
    if (guestStatus === AFFINITY_LIVE) {
      if (CS2.activeclansettings_listened_find()) {
        return ClanInfoArm.GUEST;
      }
    }
  }
  if (asGuest === 0) {
    if (status === AFFINITY_LIVE) {
      if (CS2.activeclansettings_affined_find(0)) {
        return ClanInfoArm.MEMBER;
      }
    }
  }
  return ClanInfoArm.NONE;
}
