import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ClanHallButton } from './hall-button.component';
import { SettingsList } from './settings-list.component';
import { ClanHallArt, ClanHallText, Layout } from './clans-hall.constants';

export function ClansHall(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={ClanHallArt.BACKDROP} tiling />

      <SteelBorderEntrypoint title={ClanHallText.TITLE} />

      <ClanHallButton
        liveLabel={ClanHallText.BACK}
        deadLabel={ClanHallText.BACK}
        alwaysLive={1}
        x={Layout.BUTTON_INSET}
        y={{ bottom: Layout.BUTTON_INSET }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
      />

      <ClanHallButton
        liveLabel={ClanHallText.SAVE_LIVE}
        deadLabel={ClanHallText.SAVE_DEAD}
        x={{ right: Layout.BUTTON_INSET }}
        y={{ bottom: Layout.BUTTON_INSET }}
        w={Layout.BUTTON_W}
        h={Layout.BUTTON_H}
      />

      <layer x="center" y={Layout.BOX_Y} w={{ fill: Layout.BOX_INSET_W }} h={{ fill: Layout.BOX_INSET_H }}>
        <SettingsList />

        <ThinBoxEntrypoint />
      </layer>
    </layer>
  );
}
