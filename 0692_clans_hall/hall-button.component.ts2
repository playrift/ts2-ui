import { CS2, useServerState, useState } from 'ts2';

import { onMobile, opsound } from '../lib/lib.helpers';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { ClanHallFonts, ClanHallText, ClanHallVarbits, OP_SOUND_MASK } from './clans-hall.constants';

export function ClanHallButton({
  liveLabel,
  deadLabel = '',
  alwaysLive = 0,
}: {
  liveLabel: String;
  deadLabel?: String;
  alwaysLive?: Int;
}): Component {
  const permitted: Int = useServerState(ClanHallVarbits.EDITING_PERMITTED);
  const [pressed, setPressed] = useState(0);

  let live: Int = alwaysLive;
  if (permitted === 1) {
    live = 1;
  }

  const label: String = live === 1 ? liveLabel : deadLabel;

  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => {
        if (live === 1) {
          opsound(event.option, OP_SOUND_MASK);
        }
      }}
    >
      <StoneButtonDraw label={label} font={ClanHallFonts.BODY} pressed={skin} />
    </layer>
  );
}
