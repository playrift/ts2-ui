import { useState } from 'ts2';

import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { ClanMembersFonts, ClanMembersOps, ClanMembersText, OP_SOUND_MASK } from './clans-members.constants';

export function BackButton(): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[ClanMembersOps.BACK]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
    >
      <StoneButtonDraw label={ClanMembersText.BACK} font={ClanMembersFonts.BODY} pressed={skin} />
    </layer>
  );
}
