import { useState } from 'ts2';

import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { meslayerinput, meslayermode } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';
import {
  ClanMembersOps,
  ClanMembersSprites,
  ClanMembersWash,
  Layout,
  MESLAYER_SEARCH,
} from './clans-members.constants';
import { clanMembersSearching, clanSearchToggle } from './clan-members-shared.search';

export function ClanSearchButton(): Component {
  const [pressed, setPressed] = useState(0);
  const [glassHot, setGlassHot] = useState(0);
  const [mode] = useState(meslayermode);
  const [typed] = useState(meslayerinput);

  let searching: Int = 0;
  if (mode === MESLAYER_SEARCH || (mode <= 0 && typed.length > 0)) {
    searching = 1;
  }
  let down: Int = pressed;
  if (searching === 1) {
    down = 1;
  }
  let glassWash: Int = 0;
  if (searching === 1 && glassHot === 1) {
    glassWash = ClanMembersWash.SEARCH_ICON_HOVER;
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[ClanMembersOps.SEARCH]}
      onOptionSelect={(event) => {
        setPressed(0);
        setGlassHot(0);
        clanSearchToggle(event.option);
      }}
      onMouseRepeat={() => {
        if (onMobile()) {
          return;
        }
        if (clanMembersSearching()) {
          setGlassHot(1);
          setPressed(0);
        } else {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (clanMembersSearching()) {
          setGlassHot(0);
          setPressed(0);
        } else {
          setPressed(0);
        }
      }}
    >
      {down === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      <sprite
        x={{ center: Layout.SEARCH_ICON_DX }}
        y="center"
        w={Layout.SEARCH_ICON_W}
        h={Layout.SEARCH_ICON_H}
        sprite={ClanMembersSprites.SEARCH}
        transparency={glassWash}
      />
    </layer>
  );
}
