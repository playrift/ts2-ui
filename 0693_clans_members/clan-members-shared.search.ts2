import { CS2, useState } from 'ts2';

import { meslayerinput, meslayermode } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { meslayerClose, meslayerMode18 } from '../0162_chatbox/meslayer';
import { ClanMembersSounds, MESLAYER_SEARCH } from './clans-members.constants';

export function clanMembersSearching(): Boolean {
  const [mode] = useState(meslayermode);
  const [typed] = useState(meslayerinput);
  if (mode === MESLAYER_SEARCH) {
    return true;
  }
  if (mode <= 0 && typed.length > 0) {
    return true;
  }
  return false;
}

export const NO_FILTER = 2147483647;

export function clanMembersFilterNameIn(name: String, filter: String): Int {
  if (filter.length > 0) {
    return CS2.string_indexof_string(CS2.lowercase(name), filter, 0);
  }
  return NO_FILTER;
}

export function clanSearchToggle(op: Int): void {
  if (op !== 1) {
    return;
  }
  playSound(ClanMembersSounds.CLICK);
  if (clanMembersSearching()) {
    meslayerClose(true, true, true);
    return;
  }
  meslayerMode18();
}

export function clanSearchInit(): void {
  const [mode] = useState(meslayermode);
  const [, setTyped] = useState(meslayerinput);
  if (clanMembersSearching()) {
    meslayerClose(true, true, true);
    return;
  }
  if (mode <= 0) {
    setTyped('');
  }
}
