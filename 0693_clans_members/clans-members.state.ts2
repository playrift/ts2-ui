import { sessionState } from 'ts2';

export const openHeader = sessionState(0);

export const OPEN_STRIDE = 4;

export function openHeaderWhich(value: Int): Int {
  return value % OPEN_STRIDE;
}

export function openHeaderOpened(value: Int, which: Int): Int {
  return (value / OPEN_STRIDE + 1) * OPEN_STRIDE + which;
}

export function openHeaderClosed(value: Int): Int {
  return (value / OPEN_STRIDE) * OPEN_STRIDE;
}
