import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { FADER_COLOR, FADER_TRANSPARENCY, Layout } from './clans-outfit.constants';

export function ClansOutfit(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={FADER_COLOR} fill transparency={FADER_TRANSPARENCY} />

      <layer x="center" y="center" w={Layout.WINDOW_W} h={{ fill: Layout.WINDOW_INSET_H }}>
        <layer x="center" y="center" w="fill" h="fill" />

        <layer x="center" y={Layout.HIGHLIGHT_Y} w={Layout.HIGHLIGHT_W} h={Layout.HIGHLIGHT_H}>
          <ThinBoxEntrypoint />
        </layer>

        <layer x="center" y={Layout.DISPLAY_Y} w={Layout.DISPLAY_W} h={Layout.DISPLAY_H} />

        <layer x={Layout.BUTTON_INSET} y={{ bottom: Layout.BUTTON_INSET }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        <layer
          x={{ right: Layout.BUTTON_INSET }}
          y={{ bottom: Layout.BUTTON_INSET }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
        />

        <layer x={{ center: -Layout.ARROW_DX }} y={Layout.ARROW_TOP_Y} w={Layout.ARROW_W} h={Layout.ARROW_H} />
        <layer x={{ center: Layout.ARROW_DX }} y={Layout.ARROW_TOP_Y} w={Layout.ARROW_W} h={Layout.ARROW_H} />
        <layer x={{ center: Layout.ARROW_DX }} y={Layout.ARROW_BOTTOM_Y} w={Layout.ARROW_W} h={Layout.ARROW_H} />
        <layer x={{ center: -Layout.ARROW_DX }} y={Layout.ARROW_BOTTOM_Y} w={Layout.ARROW_W} h={Layout.ARROW_H} />

        <layer x="center" y={Layout.PICKER_Y} w={Layout.PICKER_W} h={{ fill: Layout.PICKER_INSET_H }}>
          <layer x={{ right: Layout.BAR_RIGHT }} y="center" w={Layout.BAR_W} h="fill" />
          <layer x={{ right: Layout.LIST_RIGHT }} y="top" w={{ fill: Layout.LIST_INSET_W }} h="fill" />
        </layer>

        <layer x="center" y={Layout.ICON_TOP_Y} w={Layout.ICON_SIZE} h={Layout.ICON_SIZE} />
        <layer x="center" y={Layout.ICON_BOTTOM_Y} w={Layout.ICON_SIZE} h={Layout.ICON_SIZE} />
      </layer>
    </layer>
  );
}
