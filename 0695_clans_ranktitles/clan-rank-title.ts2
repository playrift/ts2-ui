import { predictServerState, useServerState } from 'ts2';

import { playSound } from '../lib/lib.engine';

import { ClanRankTitles } from './clan-rank-titles.data';
import type { ClanRankTitle } from './clan-rank-titles.data';
import { Layout, RankTitleVarbits, RankTitlesSounds, RankTitlesText } from './clans-ranktitles.constants';

export function clampTitleId(title: Int): Int {
  if (title > 0 && title <= Layout.TITLE_COUNT) {
    return title;
  }
  return 0;
}

export function rankTitleAssigned(rank: Int): Int {
  switch (rank) {
    case 0:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_000));
    case 10:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_010));
    case 20:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_020));
    case 30:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_030));
    case 40:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_040));
    case 50:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_050));
    case 60:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_060));
    case 70:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_070));
    case 80:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_080));
    case 90:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_090));
    case 95:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_095));
    case 96:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_096));
    case 97:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_097));
    case 98:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_098));
    case 99:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_099));
    case 101:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_101));
    case 102:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_102));
    case 103:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_103));
    case 104:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_104));
    case 105:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_105));
    case 110:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_110));
    case 115:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_115));
    case 120:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_120));
    case 124:
      return clampTitleId(useServerState(RankTitleVarbits.RANK_124));
  }
  return 0;
}

export function setRankTitle(rank: Int, title: Int): void {
  const value: Int = clampTitleId(title);
  switch (rank) {
    case 0:
      predictServerState(RankTitleVarbits.RANK_000, value);
      return;
    case 10:
      predictServerState(RankTitleVarbits.RANK_010, value);
      return;
    case 20:
      predictServerState(RankTitleVarbits.RANK_020, value);
      return;
    case 30:
      predictServerState(RankTitleVarbits.RANK_030, value);
      return;
    case 40:
      predictServerState(RankTitleVarbits.RANK_040, value);
      return;
    case 50:
      predictServerState(RankTitleVarbits.RANK_050, value);
      return;
    case 60:
      predictServerState(RankTitleVarbits.RANK_060, value);
      return;
    case 70:
      predictServerState(RankTitleVarbits.RANK_070, value);
      return;
    case 80:
      predictServerState(RankTitleVarbits.RANK_080, value);
      return;
    case 90:
      predictServerState(RankTitleVarbits.RANK_090, value);
      return;
    case 95:
      predictServerState(RankTitleVarbits.RANK_095, value);
      return;
    case 96:
      predictServerState(RankTitleVarbits.RANK_096, value);
      return;
    case 97:
      predictServerState(RankTitleVarbits.RANK_097, value);
      return;
    case 98:
      predictServerState(RankTitleVarbits.RANK_098, value);
      return;
    case 99:
      predictServerState(RankTitleVarbits.RANK_099, value);
      return;
    case 101:
      predictServerState(RankTitleVarbits.RANK_101, value);
      return;
    case 102:
      predictServerState(RankTitleVarbits.RANK_102, value);
      return;
    case 103:
      predictServerState(RankTitleVarbits.RANK_103, value);
      return;
    case 104:
      predictServerState(RankTitleVarbits.RANK_104, value);
      return;
    case 105:
      predictServerState(RankTitleVarbits.RANK_105, value);
      return;
    case 110:
      predictServerState(RankTitleVarbits.RANK_110, value);
      return;
    case 115:
      predictServerState(RankTitleVarbits.RANK_115, value);
      return;
    case 120:
      predictServerState(RankTitleVarbits.RANK_120, value);
      return;
    case 124:
      predictServerState(RankTitleVarbits.RANK_124, value);
      return;
  }
}

export function rankTitleKey(rank: Int): Int {
  if (rank === 128) {
    return -6;
  }
  if (rank === 127) {
    return -5;
  }
  if (rank === 126) {
    return -4;
  }
  if (rank === 125) {
    return -3;
  }
  if (rank === 100) {
    return -2;
  }
  if (rank === -1) {
    return -1;
  }
  switch (rank) {
    case 10:
      return useServerState(RankTitleVarbits.RANK_010);
    case 20:
      return useServerState(RankTitleVarbits.RANK_020);
    case 30:
      return useServerState(RankTitleVarbits.RANK_030);
    case 40:
      return useServerState(RankTitleVarbits.RANK_040);
    case 50:
      return useServerState(RankTitleVarbits.RANK_050);
    case 60:
      return useServerState(RankTitleVarbits.RANK_060);
    case 70:
      return useServerState(RankTitleVarbits.RANK_070);
    case 80:
      return useServerState(RankTitleVarbits.RANK_080);
    case 90:
      return useServerState(RankTitleVarbits.RANK_090);
    case 95:
      return useServerState(RankTitleVarbits.RANK_095);
    case 96:
      return useServerState(RankTitleVarbits.RANK_096);
    case 97:
      return useServerState(RankTitleVarbits.RANK_097);
    case 98:
      return useServerState(RankTitleVarbits.RANK_098);
    case 99:
      return useServerState(RankTitleVarbits.RANK_099);
    case 101:
      return useServerState(RankTitleVarbits.RANK_101);
    case 102:
      return useServerState(RankTitleVarbits.RANK_102);
    case 103:
      return useServerState(RankTitleVarbits.RANK_103);
    case 104:
      return useServerState(RankTitleVarbits.RANK_104);
    case 105:
      return useServerState(RankTitleVarbits.RANK_105);
    case 110:
      return useServerState(RankTitleVarbits.RANK_110);
    case 115:
      return useServerState(RankTitleVarbits.RANK_115);
    case 120:
      return useServerState(RankTitleVarbits.RANK_120);
    case 124:
      return useServerState(RankTitleVarbits.RANK_124);
  }
  return useServerState(RankTitleVarbits.RANK_000);
}

export function rankTitleText(rank: Int): String {
  const row: ClanRankTitle | null = ClanRankTitles.get(rankTitleKey(rank));
  const title: String = row === null ? '' : row.title;
  if (title.length > 0) {
    return title;
  }
  if (rank > 0) {
    return `Rank ${stringOf(rank)}`;
  }
  return RankTitlesText.NOT_RANKED;
}

export function rankTitleIcon(rank: Int): Sprite {
  const row: ClanRankTitle | null = ClanRankTitles.get(rankTitleKey(rank));
  const title: String = row === null ? '' : row.title;
  const icon: Sprite = row === null ? -1 : row.icon;
  if (title.length > 0) {
    return icon;
  }
  return -1;
}

export function wipeRankTitle(rank: Int): void {
  if (rankTitleAssigned(rank) === 0) {
    return;
  }
  playSound(RankTitlesSounds.CLICK);
  setRankTitle(rank, 0);
}
