import { CS2 } from 'ts2';

import type { ClanPermissionRow } from './clan-permissions.data';
import {
  CLAN_RANK_COUNT,
  CLAN_SETTING_UNAVAILABLE,
  ClanCofferText,
  ClanPermission,
  ClanPermissions,
  ClanRank,
  ClanRankTitles,
  ClanRankValues,
} from './clans-storage-main.constants';

export function clanPermissionGet(setting: ClanPermissionRow): Int {
  let stored: Int = ClanRank.OWNER + ClanRank.SETTING_OFFSET;

  const rankTalk: ClanPermissionRow = ClanPermissions.at(ClanPermission.RANK_TALK);
  const rankKick: ClanPermissionRow = ClanPermissions.at(ClanPermission.RANK_KICK);
  const withdraw: ClanPermissionRow = ClanPermissions.at(ClanPermission.WITHDRAW_FROM_COFFER);
  const deposit: ClanPermissionRow = ClanPermissions.at(ClanPermission.DEPOSIT_INTO_COFFER);

  if (setting === rankTalk) {
    stored = CS2.activeclansettings_rank_talk_get() + ClanRank.SETTING_OFFSET;
  } else if (setting === rankKick) {
    stored = CS2.activeclansettings_rank_kick_get() + ClanRank.SETTING_OFFSET;
  } else if (setting === withdraw) {
    stored = CLAN_SETTING_UNAVAILABLE;
  } else if (setting === deposit) {
    stored = CLAN_SETTING_UNAVAILABLE;
  }

  const rank: Int = stored - ClanRank.SETTING_OFFSET;

  const floor: Int = setting.minRank;
  const allowsNobody: Boolean = setting.allowsNobody;

  let found: Int = 0;
  let index: Int = CLAN_RANK_COUNT;
  while (index > 0) {
    index = index - 1;
    const candidate: Int = ClanRankValues.at(index) ?? -1;
    if (rank === candidate) {
      if (candidate >= Math.min(0, floor)) {
        if (candidate <= ClanRank.OWNER) {
          found = 1;
        } else if (candidate === ClanRank.NOBODY && allowsNobody) {
          found = 1;
        }
      }
      index = 0;
    }
  }

  if (found === 0) {
    if (allowsNobody) {
      return ClanRank.NOBODY;
    }
    return ClanRank.OWNER;
  }

  return Math.max(rank, floor);
}

export function clanRankTitle(rank: Int): String {
  let key: Int = CLAN_SETTING_UNAVAILABLE;
  if (rank === 128) {
    key = -6;
  } else if (rank === 127) {
    key = -5;
  } else if (rank === 126) {
    key = -4;
  } else if (rank === 125) {
    key = -3;
  } else if (rank === 100) {
    key = -2;
  } else if (rank === -1) {
    key = -1;
  }

  const title: String = ClanRankTitles.get(key) ?? '';
  if (CS2.string_length(title) > 0) {
    return title;
  }
  if (rank > 0) {
    return `Rank ${stringOf(rank)}`;
  }
  return ClanCofferText.NOT_RANKED;
}
