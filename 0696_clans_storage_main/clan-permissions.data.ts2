export enum ClanPermission {
  WITHDRAW_FROM_COFFER = 0,
  DEPOSIT_INTO_COFFER = 1,
  RANK_TALK = 2,
  RANK_KICK = 3,
}

export type ClanPermissionRow = {
  minRank: Int;
  allowsNobody: Boolean;
  parent: Int;
};

export const ClanPermissions = listOf<ClanPermissionRow>([
  { minRank: 0, allowsNobody: false, parent: ClanPermission.DEPOSIT_INTO_COFFER },
  { minRank: 0, allowsNobody: false, parent: -1 },
  { minRank: -1, allowsNobody: false, parent: -1 },
  { minRank: 0, allowsNobody: false, parent: ClanPermission.RANK_TALK },
]);
