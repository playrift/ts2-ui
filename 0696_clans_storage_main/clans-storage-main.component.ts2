        <sprite x={0} y={0} w={Layout.PICTURE_W} h={Layout.PICTURE_H} sprite={ClanCofferArt.COINS} />

        <layer x={{ right: 0 }} y={0} w={{ fill: Layout.PICTURE_W }} h={{ fill: Layout.STRIP_H }}>
          <CofferSlot />
        </layer>

        <layer x="center" y="bottom" w="fill" h={Layout.STRIP_H}>
          <CofferHintText x="center" y={0} w="fill" h={Layout.HINT_H} />

          <WithdrawButton
            label="1"
            x={{ center: -Layout.BUTTON_DX_1 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
          />
          <WithdrawButton
            label="1k"
            x={{ center: -Layout.BUTTON_DX_2 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
          />
          <WithdrawButton
            label="1m"
            x={{ center: -Layout.BUTTON_DX_3 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
          />
          <WithdrawButton
            label="10m"
            x={{ center: Layout.BUTTON_DX_3 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
          />
          <WithdrawButton
            label="X"
            x={{ center: Layout.BUTTON_DX_2 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
          />
          <WithdrawButton
            label="All"
            x={{ center: Layout.BUTTON_DX_1 }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={{ fill: Layout.BUTTON_INSET_H }}
