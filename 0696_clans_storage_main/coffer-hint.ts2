import { CS2 } from 'ts2';

import { clanPermissionGet, clanRankTitle } from './clan-permission';
import { AffinityStatus, ClanCofferText, ClanPermissionStructs } from './clans-storage-main.constants';

export function cofferHint(status: Int): String {
  if (status !== AffinityStatus.LIVE) {
    return ClanCofferText.HINT_UNAVAILABLE;
  }
  if (!CS2.activeclansettings_affined_find(0)) {
    return ClanCofferText.HINT_UNAVAILABLE;
  }

  const slot: Int = CS2.activeclansettings_affined_slot_get(CS2.tags_remove(CS2.chat_playername()));
  if (slot === -1) {
    return ClanCofferText.HINT_NOT_A_MEMBER;
  }

  const required: Int = clanPermissionGet(ClanPermissionStructs.WITHDRAW_FROM_COFFER);
  if (CS2.activeclansettings_affined_rank_get(slot) >= required) {
    return ClanCofferText.HINT_WITHDRAW;
  }
  return `<col=ff0000>'${clanRankTitle(required)}' rank is required:</col>`;
}
