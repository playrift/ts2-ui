import { useServerState } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { clanInterfaceTitle } from './clan-interface-title';
import { cofferHint } from './coffer-hint';
import { ClanCofferColor, ClanCofferFonts, ClanCofferText, ClanCofferVarbits } from './clans-storage-main.constants';

export function PanelFrame(): Component {
  const asGuest: Int = useServerState(ClanCofferVarbits.LOAD_AS_GUEST);
  const guestStatus: Int = useServerState(ClanCofferVarbits.GUEST_AFFINITY_STATUS);
  const status: Int = useServerState(ClanCofferVarbits.AFFINITY_STATUS);

  return (
    <layer w="fill" h="fill">
      <SteelBorderEntrypoint title={clanInterfaceTitle(ClanCofferText.TITLE_SUFFIX, asGuest, guestStatus, status)} />
    </layer>
  );
}

export function CofferHintText(): Component {
  const status: Int = useServerState(ClanCofferVarbits.AFFINITY_STATUS);

  return (
    <text
      x="center"
      y={0}
      w="fill"
      h="fill"
      text={cofferHint(status)}
      font={ClanCofferFonts.LABEL}
      color={ClanCofferColor.LABEL}
      shadow
    />
  );
}
