import { useInterval, useRef, useState } from 'ts2';

import { clientClock, playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { ClanCofferColor, ClanCofferFonts, ClanCofferSounds, PRESS_CYCLES } from './clans-storage-main.constants';

export function WithdrawButton({ label }: { label: String }): Component {
  const timerHost = useRef();

  useInterval(() => {
    if (pressedUntil === 0) {
      return;
    }
    if (clientClock() < pressedUntil) {
      return;
    }
    setPressedUntil(0);
  }, timerHost);

  const [pressedUntil, setPressedUntil] = useState(0);
  const caption = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      options={['Withdraw']}
      optionSubject={`<col=ff9040>${label}</col>`}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(ClanCofferSounds.CLICK);
        setPressedUntil(clientClock() + PRESS_CYCLES);
      }}
      ref={timerHost}
      onMouseRepeat={() => {
        if (!onMobile()) {
          caption.color = ClanCofferColor.HOVER;
        }
      }}
      onMouseLeave={() => {
        caption.color = ClanCofferColor.LABEL;
      }}
    >
      {pressedUntil === 0 ? <StoneButtonOutFilled /> : <StoneButtonPressedFilled />}

      <text
        ref={caption}
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={ClanCofferFonts.LABEL}
        color={ClanCofferColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
