import { CoinSlot } from './coin-slot.component';
import { DepositButton } from './deposit-button.component';
import {
  ClanStorageArt,
  ClanStorageColors,
  ClanStorageFonts,
  ClanStorageText,
  Layout,
} from './clans-storage-side.constants';

export function ClansStorageSide(): Component {
  return (
    <>
      <sprite x={0} y={0} w={Layout.PICTURE_W} h={Layout.PICTURE_H} sprite={ClanStorageArt.COINS} />

      <CoinSlot x={{ right: 0 }} y={0} w={{ fill: Layout.PICTURE_W }} h={Layout.PICTURE_H} />

      <layer x="center" y="bottom" w="fill" h={{ fill: Layout.PICTURE_H }}>
        <text
          x="center"
          y={0}
          w="fill"
          h={Layout.HINT_H}
          text={ClanStorageText.HINT}
          font={ClanStorageFonts.LABEL}
          color={ClanStorageColors.LABEL}
          shadow
        />

        <DepositButton
          label="1"
          x={{ center: -Layout.BUTTON_DX }}
          y={{ bottom: Layout.BUTTON_DY }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
        />
        <DepositButton label="1k" x="center" y={{ bottom: Layout.BUTTON_DY }} w={Layout.BUTTON} h={Layout.BUTTON} />
        <DepositButton
          label="1m"
          x={{ center: Layout.BUTTON_DX }}
          y={{ bottom: Layout.BUTTON_DY }}
          w={Layout.BUTTON}
          h={Layout.BUTTON}
        />
        <DepositButton label="10m" x={{ center: -Layout.BUTTON_DX }} y="bottom" w={Layout.BUTTON} h={Layout.BUTTON} />
        <DepositButton label="X" x="center" y="bottom" w={Layout.BUTTON} h={Layout.BUTTON} />
        <DepositButton label="All" x={{ center: Layout.BUTTON_DX }} y="bottom" w={Layout.BUTTON} h={Layout.BUTTON} />
      </layer>
    </>
  );
}
