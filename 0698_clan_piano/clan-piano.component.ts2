import { createRef } from 'ts2';

import { graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  KeyMeshes,
  Layout,
  NaturalKeys,
  PianoBody,
  PianoColors,
  PianoFonts,
  PianoSprites,
  SharpKeys,
} from './clan-piano.constants';

const closeIcon = createRef('clan_piano_close_icon');

export function ClanPiano(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <layer x={0} y={0} w={Layout.KEYLISTENERS_BOX} h={Layout.KEYLISTENERS_BOX} />

        <layer x={0} y={0} w="fill" h="fill">
          <model
            x={Layout.MODEL_X}
            y={{ center: Layout.MODEL_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={PianoBody.MESH}
            zoom={Camera.ZOOM}
            pitch={Camera.PITCH}
          />
        </layer>

        <layer x={0} y="center" w="fill" h="fill">
          {KeyMeshes.map((mesh) => (
            <model
              x={Layout.MODEL_X}
              y={{ center: Layout.MODEL_Y }}
              w={Layout.MODEL_BOX}
              h={Layout.MODEL_BOX}
              model={mesh}
              zoom={Camera.ZOOM}
              pitch={Camera.PITCH}
            />
          ))}

          <layer x={0} y={0} w={Layout.STAGE_W} h={Layout.STAGE_H}>
            {NaturalKeys.map((key) => (
              <text
                x={key.x}
                y={{ center: Layout.KEY_Y }}
                w={Layout.KEY_W}
                h={Layout.KEY_H}
                text={key.note}
                font={PianoFonts.LABEL}
                color={PianoColors.LABEL}
                shadow
                align="center"
                valign="bottom"
                options={[key.option]}
              />
            ))}
            {SharpKeys.map((key) => (
              <text
                x={key.x}
                y={{ bottom: Layout.SHARP_Y }}
                w={Layout.KEY_W}
                h={Layout.SHARP_H}
                text={key.note}
                font={PianoFonts.LABEL}
                color={PianoColors.LABEL}
                shadow
                align="center"
                valign="top"
                options={[key.option]}
              />
            ))}
          </layer>
        </layer>

        <layer
          x={{ right: Layout.CLOSE_INSET }}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_BOX}
          h={Layout.CLOSE_BOX}
          options={['Close']}
          onMouseEnter={() => graphicSwapper(closeIcon, PianoSprites.CLOSE_LIT)}
          onMouseLeave={() => graphicSwapper(closeIcon, PianoSprites.CLOSE_REST)}
        >
          <sprite
            ref={closeIcon}
            x="center"
            y="center"
            w={Layout.CLOSE_BOX}
            h={Layout.CLOSE_BOX}
            sprite={PianoSprites.CLOSE_REST}
          />
        </layer>
      </layer>
    </layer>
  );
}
