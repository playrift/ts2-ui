import { Engine, useRerenderOn, useServerState } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ApplicantsVarbits } from './clans-applicants.constants';
import { applicantsTitle } from './clans-applicants.helpers';

export function ApplicantsFrame(): Component {
  useRerenderOn(Engine.CLAN_SETTINGS);

  const status: Int = useServerState(ApplicantsVarbits.AFFINITY_STATUS);
  const asGuest: Int = useServerState(ApplicantsVarbits.LOAD_AS_GUEST);
  const guestStatus: Int = useServerState(ApplicantsVarbits.GUEST_AFFINITY_STATUS);

  return (
    <layer w="fill" h="fill">
      <SteelBorderEntrypoint title={applicantsTitle(status, asGuest, guestStatus)} />
    </layer>
  );
}
