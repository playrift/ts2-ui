import { useServerState } from 'ts2';

import { Varps } from '../lib/game/varps';
import { ClanBoardColor, ClanBoardFonts, Layout } from './clans-board.constants';
import { filledRowCount, noClansText } from './clans-board.helpers';

export function ClanBoardEmptyNotice(): Component {
  const included: Int = useServerState(Varps.MACRO_BEE_POS_3);
  const excluded: Int = useServerState(Varps.MACRO_BEE_POS_4);
  const filled: Int = filledRowCount();
  const filtered: Int = included !== 0 || excluded !== 0 ? 1 : 0;

  return filled <= 0 ? (
    <text
      x="center"
      y="center"
      w={{ fill: Layout.PANEL_MARGIN }}
      h={{ fill: Layout.PANEL_MARGIN }}
      text={noClansText(filtered)}
      font={ClanBoardFonts.BODY}
      color={ClanBoardColor.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  ) : null;
}
