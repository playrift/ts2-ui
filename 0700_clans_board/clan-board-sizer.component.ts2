import { useOnResize, useUniverse } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { Layout, filtersRef, listRef, universeRef } from './clans-board.constants';
import { boardHeight, filtersExtent, filtersScrollHeight, listExtent, listScrollHeight } from './clans-board.helpers';

export function ClanBoardSizer(): Component {
  const slot = useUniverse();
  useOnResize(slot);

  const filterRowHeight: Int = onMobile() ? Layout.FILTER_ROW_H_MOBILE : Layout.FILTER_ROW_H;
  const filtersContent: Int = filtersExtent(filterRowHeight);
  const listContent: Int = listExtent(listRef.width - Layout.ROW_INSET_W);
  const height: Int = boardHeight(slot.height, filtersContent, listContent);

  universeRef.height = height;
  filtersRef.scrollHeight = filtersScrollHeight(slot.height, filterRowHeight);
  listRef.scrollHeight = listScrollHeight(slot.height, filterRowHeight, listRef.width);

  return <layer w={1} h={1} />;
}
