import { BoardButton } from '../lib/board-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ClanBoardEmptyNotice } from './clan-board-empty-notice.component';
import { ClanBoardFilters } from './clan-board-filters.component';
import { ClanBoardRows } from './clan-board-rows.component';
import { ClanBoardSortButton } from './clan-board-sort-button.component';
import {
  ClanBoardColor,
  ClanBoardFonts,
  ClanBoardScrollbar,
  ClanBoardSprites,
  Copy,
  Layout,
  SortMode,
  applicantsRef,
  bottomRef,
  filtersRef,
  legendRef,
  listRef,
  myclanRef,
  refreshRef,
  sortareaRef,
  universeRef,
} from './clans-board.constants';
import { layoutBoardButtons } from './clans-board.helpers';
import { MyClanButton } from './my-clan-button.component';

export function ClansBoard(): Component {
  return (
    <layer
      ref={universeRef}
      x="center"
      y="center"
      w={Layout.PANEL_W}
      h={Layout.PANEL_H}
      onLoad={() => layoutBoardButtons()}
    >
      <SteelBorderEntrypoint title={Copy.TITLE} />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET_W }}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <layer x={0} y="center" w={Layout.FILTER_BOX_W} h="fill">
          <layer
            ref={filtersRef}
            x={Layout.FILTERS_X}
            y={Layout.FILTERS_Y}
            w={{ fill: Layout.FILTERS_INSET_W }}
            h={{ fill: Layout.FILTERS_INSET_H }}
          >
            <ClanBoardFilters />
          </layer>
          <layer
            right={Layout.SCROLLBAR_RIGHT}
            y={Layout.FILTERS_Y}
            w={Layout.SCROLLBAR_W}
            h={{ fill: Layout.FILTERS_INSET_H }}
          >
            <ScrollbarVertical
              content={filtersRef}
              track={ClanBoardScrollbar.TRACK}
              capTopSprite={ClanBoardScrollbar.CAP_TOP}
              thumbSprite={ClanBoardScrollbar.THUMB}
              capBottomSprite={ClanBoardScrollbar.CAP_BOTTOM}
              arrowUp={ClanBoardScrollbar.ARROW_UP}
              arrowDown={ClanBoardScrollbar.ARROW_DOWN}
            />
          </layer>
          <layer ref={legendRef} x="center" y="bottom" w="fill" h={Layout.LEGEND_H}>
            <sprite
              x={Layout.LEGEND_ICON_X}
              y={Layout.LEGEND_ICON_INCLUDE_Y}
              w={Layout.LEGEND_ICON}
              h={Layout.LEGEND_ICON}
              sprite={ClanBoardSprites.RADIO_INCLUDE}
            />
            <text
              right={Layout.LEGEND_TEXT_RIGHT}
              y={Layout.LEGEND_TEXT_INCLUDE_Y}
              w={{ fill: Layout.LEGEND_TEXT_INSET_W }}
              h={Layout.LEGEND_TEXT_H}
              text={Copy.LEGEND_INCLUDE}
              font={ClanBoardFonts.BODY}
              color={ClanBoardColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
            <sprite
              x={Layout.LEGEND_ICON_X}
              y={Layout.LEGEND_ICON_EXCLUDE_Y}
              w={Layout.LEGEND_ICON}
              h={Layout.LEGEND_ICON}
              sprite={ClanBoardSprites.RADIO_EXCLUDE}
            />
            <text
              right={Layout.LEGEND_TEXT_RIGHT}
              y={Layout.LEGEND_TEXT_EXCLUDE_Y}
              w={{ fill: Layout.LEGEND_TEXT_INSET_W }}
              h={Layout.LEGEND_TEXT_H}
              text={Copy.LEGEND_EXCLUDE}
              font={ClanBoardFonts.BODY}
              color={ClanBoardColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
            <layer x="center" y={{ bottom: Layout.RESET_BOTTOM }} w={Layout.RESET_W} h={{ fill: Layout.RESET_INSET_H }}>
              <BoardButton label={Copy.RESET} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
          <ThinBoxEntrypoint />
        </layer>

        <layer x="right" y="center" w={{ fill: Layout.LIST_COLUMN_INSET_W }} h="fill">
          <layer x="center" y={0} w="fill" h={{ fill: Layout.LIST_BOX_INSET_H }}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={ClanBoardSprites.BACKING}
              tiling
            />
            <layer ref={sortareaRef} x="center" y={0} w="fill" h={Layout.SORT_H}>
              <layer x={Layout.SORT_NAME_X} y="center" w={Layout.SORT_NAME_W} h={{ fill: Layout.SORT_INSET_H }}>
                <ClanBoardSortButton
                  label={Copy.SORT_NAME}
                  ascending={SortMode.NAME_ASC}
                  descending={SortMode.NAME_DESC}
                />
              </layer>
              <layer x={Layout.SORT_SIZE_X} y="center" w={Layout.SORT_SIZE_W} h={{ fill: Layout.SORT_INSET_H }}>
                <ClanBoardSortButton
                  label={Copy.SORT_SIZE}
                  ascending={SortMode.SIZE_ASC}
                  descending={SortMode.SIZE_DESC}
                />
              </layer>
              <layer
                right={Layout.SORT_AGE_RIGHT}
                y="center"
                w={{ fill: Layout.SORT_AGE_INSET_W }}
                h={{ fill: Layout.SORT_INSET_H }}
              >
                <ClanBoardSortButton
                  label={Copy.SORT_CREATED}
                  ascending={SortMode.CREATED_ASC}
                  descending={SortMode.CREATED_DESC}
                />
              </layer>
              <ThinBoxEntrypoint />
            </layer>
            <layer
              ref={listRef}
              x={Layout.LIST_X}
              y={{ bottom: Layout.LIST_BOTTOM }}
              w={{ fill: Layout.LIST_INSET_W }}
              h={{ fill: Layout.LIST_INSET_H }}
            >
              <ClanBoardRows />
              <ClanBoardEmptyNotice />
            </layer>
            <layer
              right={Layout.SCROLLBAR_RIGHT}
              y={{ bottom: Layout.LIST_BOTTOM }}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.LIST_INSET_H }}
            >
              <ScrollbarVertical
                content={listRef}
                track={ClanBoardScrollbar.TRACK}
                capTopSprite={ClanBoardScrollbar.CAP_TOP}
                thumbSprite={ClanBoardScrollbar.THUMB}
                capBottomSprite={ClanBoardScrollbar.CAP_BOTTOM}
                arrowUp={ClanBoardScrollbar.ARROW_UP}
                arrowDown={ClanBoardScrollbar.ARROW_DOWN}
              />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
          <layer ref={bottomRef} x="center" y="bottom" w="fill" h={Layout.BOTTOM_H}>
            <layer ref={myclanRef} x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <MyClanButton />
            </layer>
            <layer ref={applicantsRef} x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <BoardButton label={Copy.APPLICANTS} />
            </layer>
            <layer ref={refreshRef} x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <BoardButton label={Copy.REFRESH} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
