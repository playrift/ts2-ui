import { useServerState } from 'ts2';

import { BoardButton } from '../lib/board-button.component';
import { Varps } from '../lib/game/varps';
import { Copy } from './clans-board.constants';

export function MyClanButton(): Component {
  const listed: Int = useServerState(Varps.IF1);
  return (
    <layer w="fill" h="fill">
      <BoardButton label={listed === 1 ? Copy.DELIST_CLAN : Copy.LIST_CLAN} />
    </layer>
  );
}
