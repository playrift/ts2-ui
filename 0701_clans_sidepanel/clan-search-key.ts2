import { CS2, useState } from 'ts2';
import {
  clanLastclansearch00,
  clanLastclansearch01,
  clanLastclansearch02,
  clanLastclansearch03,
  clanLastclansearch04,
  clanLastclansearch05,
  clanLastclansearch06,
  clanLastclansearch07,
  clanLastclansearch08,
  clanLastclansearch09,
  clanLastclansearch10,
  clanLastclansearch11,
} from '../lib/game/varcs';

const SEARCH_ALPHABET = '0123456789abcdefghijklmnopqrstuvwxyz _-';

function searchKeyAt(name: String, length: Int, index: Int): Int {
  if (length <= index) {
    return 0;
  }
  return CS2.string_indexof_string(SEARCH_ALPHABET, CS2.substring(name, index, index + 1), 0) + 1;
}

export function rememberClanSearch(clanName: String): void {
  const name: String = CS2.lowercase(clanName);
  const length: Int = CS2.string_length(clanName);

  const [, set00] = useState(clanLastclansearch00);
  const [, set01] = useState(clanLastclansearch01);
  const [, set02] = useState(clanLastclansearch02);
  const [, set03] = useState(clanLastclansearch03);
  const [, set04] = useState(clanLastclansearch04);
  const [, set05] = useState(clanLastclansearch05);
  const [, set06] = useState(clanLastclansearch06);
  const [, set07] = useState(clanLastclansearch07);
  const [, set08] = useState(clanLastclansearch08);
  const [, set09] = useState(clanLastclansearch09);
  const [, set10] = useState(clanLastclansearch10);
  const [, set11] = useState(clanLastclansearch11);

  set00(searchKeyAt(name, length, 0));
  set01(searchKeyAt(name, length, 1));
  set02(searchKeyAt(name, length, 2));
  set03(searchKeyAt(name, length, 3));
  set04(searchKeyAt(name, length, 4));
  set05(searchKeyAt(name, length, 5));
  set06(searchKeyAt(name, length, 6));
  set07(searchKeyAt(name, length, 7));
  set08(searchKeyAt(name, length, 8));
  set09(searchKeyAt(name, length, 9));
  set10(searchKeyAt(name, length, 10));
  set11(searchKeyAt(name, length, 11));
}
