import { CS2, useServerState } from 'ts2';
import { ClanRankIcons, ClanRankTitles, ClanSidepanelVarbits } from './clans-sidepanel.constants';

export const CLAN_SETTING_UNAVAILABLE = 0;

export function clanSettingGroupType(): Int {
  return CLAN_SETTING_UNAVAILABLE;
}

export function clanSettingVacancies(): Int {
  return CLAN_SETTING_UNAVAILABLE;
}

export function clanSettingFilled(): Int {
  return CLAN_SETTING_UNAVAILABLE;
}

export function clanSettingRosterSize(): Int {
  return CLAN_SETTING_UNAVAILABLE;
}

export function ironmanIsGrouped(): Boolean {
  if (useServerState(ClanSidepanelVarbits.IRONMAN) === 6) {
    return true;
  }
  return false;
}

export function clanRankIcon(rank: Int): Sprite {
  let key: Int = CLAN_SETTING_UNAVAILABLE;
  if (rank === 128) {
    key = -6;
  } else if (rank === 127) {
    key = -5;
  } else if (rank === 126) {
    key = -4;
  } else if (rank === 125) {
    key = -3;
  } else if (rank === 100) {
    key = -2;
  } else if (rank === -1) {
    key = -1;
  }

  const title: String = ClanRankTitles.get(key) ?? '';
  if (CS2.string_length(title) > 0) {
    return ClanRankIcons.get(key) ?? -1;
  }
  return -1;
}

export function clanAffinityText(status: Int): String {
  switch (status) {
    case 2:
      return '<col=9f9f9f>Fetching data...</col>';
    case 1:
      return '<col=9f9f9f>No current clan</col>';
    case 3:
      return '<col=9f9f9f>No current clan</col>';
    case 0:
      return '<col=9f9f9f>Connecting...</col>';
  }
  return '<col=9f9f9f>System unavailable</col>';
}
