import { CS2, useServerState } from 'ts2';
import { ClanRankIcons, ClanSidepanelVarbits, PvpaRankIcons } from './clans-sidepanel.constants';

export function pvpaGetRank(points: Int): Int {
  if (points < 1000) {
    return 0;
  }
  if (points < 2000) {
    return 1;
  }
  if (points < 3000) {
    return 2;
  }
  if (points < 4000) {
    return 3;
  }
  if (points < 5000) {
    return 4;
  }
  if (points < 6000) {
    return 5;
  }
  return 6;
}

export function pvpaSidepanelRankIcon(userSlot: Int, rank: Int, isSelf: Int): Sprite {
  if (rank <= -1) {
    return ClanRankIcons.get(-1) ?? -1;
  }
  if (rank === 127) {
    return ClanRankIcons.get(-5) ?? -1;
  }

  const fightWorld: Int = useServerState(ClanSidepanelVarbits.PVPA_FIGHTWORLD);
  const points: Int = useServerState(ClanSidepanelVarbits.PVPA_RANK_POINTS);

  const affined: Int = CS2.activeclansettings_affined_slot_get(
    CS2.tags_remove(CS2.activeclanchannel_user_display_name_get(userSlot)),
  );
  if (affined !== -1 && CS2.activeclansettings_affined_extra_info_get(affined, 20, 31) !== 0) {
    if (isSelf === 1 && fightWorld === 0) {
      const tier: Int = pvpaGetRank(points);
      if (tier === 26) {
        return ClanRankIcons.get(-4) ?? -1;
      }
      if (tier === 6) {
        return PvpaRankIcons.RANK_6;
      }
      if (tier === 5) {
        return PvpaRankIcons.RANK_5;
      }
      if (tier === 4) {
        return PvpaRankIcons.RANK_4;
      }
      if (tier === 3) {
        return PvpaRankIcons.RANK_3;
      }
      if (tier === 2) {
        return PvpaRankIcons.RANK_2;
      }
      if (tier === 1) {
        return PvpaRankIcons.RANK_1;
      }
    }
    return PvpaRankIcons.SIGNED_UP;
  }

  const banded: Int = rank - 100;
  if (banded === 26) {
    return ClanRankIcons.get(-4) ?? -1;
  }
  if (banded === 6) {
    return PvpaRankIcons.RANK_6;
  }
  if (banded === 5) {
    return PvpaRankIcons.RANK_5;
  }
  if (banded === 4) {
    return PvpaRankIcons.RANK_4;
  }
  if (banded === 3) {
    return PvpaRankIcons.RANK_3;
  }
  if (banded === 2) {
    return PvpaRankIcons.RANK_2;
  }
  if (banded === 1) {
    return PvpaRankIcons.RANK_1;
  }
  return PvpaRankIcons.UNRANKED;
}
