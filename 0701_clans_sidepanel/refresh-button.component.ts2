import { createRef, useInterval, useRef, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { setTransparency } from '../lib/lib.components';
import { onMobile } from '../lib/lib.helpers';
import { Sounds } from '../lib/game/sounds';
import { ClanSidepanelSprites, Layout } from './clans-sidepanel.constants';

const timerHost = createRef('0701_clans_sidepanel_timer_host');

export function RefreshButton(): Component {
  useInterval(() => {
    if (until > 0 && clientClock() >= until) {
      setUntil(0);
    }
  }, timerHost);

  const icon = useRef();
  const [until, setUntil] = useState(0);

  const pressed: Int = until > 0 ? 1 : 0;

  return (
    <layer
      w="fill"
      h="fill"
      options={['Refresh']}
      onMouseRepeat={() => {
        if (pressed === 0 && !onMobile()) {
          setTransparency(icon, REFRESH_HOVER);
        }
      }}
      onMouseLeave={() => {
        if (pressed === 0) {
          setTransparency(icon, REFRESH_REST);
        }
      }}
      onOptionSelect={() => {
        playSound(Sounds.INTERFACE_SELECT1);
        setUntil(clientClock() + REFRESH_HOLD_CLOCKS);
      }}
      ref={timerHost}
    >
      <sprite
        ref={icon}
        x="center"
        y="center"
        w={Layout.REFRESH_ICON_W}
        h={Layout.REFRESH_ICON_H}
        sprite={ClanSidepanelSprites.REFRESH}
        transparency={pressed === 1 ? REFRESH_PRESSED : REFRESH_REST}
      />
    </layer>
  );
}

const REFRESH_HOVER = 100;
const REFRESH_REST = 0;
const REFRESH_PRESSED = 175;
const REFRESH_HOLD_CLOCKS = 20;
