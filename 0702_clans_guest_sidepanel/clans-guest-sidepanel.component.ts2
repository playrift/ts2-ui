import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ClanChannelPane } from '../0701_clans_sidepanel/clan-channel-pane.component';
import { ClanHeader } from '../0701_clans_sidepanel/clan-header.component';
import { ClanFindButton, ClanLeaveButton, ClanSettingsButton } from '../0701_clans_sidepanel/clan-footer.component';
import { RefreshButton } from '../0701_clans_sidepanel/refresh-button.component';
import { BACKDROP_TRANSPARENCY, ClanSidepanelColor, Layout } from '../0701_clans_sidepanel/clans-sidepanel.constants';

export function ClansGuestSidepanel(): Component {
  return (
    <>
      <layer x="center" y={0} w={Layout.ROOT_W} h={{ fill: Layout.HEADER_DROP }}>
        <ClanHeader asGuest={1} />

        <layer x="right" y={0} w={Layout.REFRESH} h={Layout.REFRESH}>
          <RefreshButton />
        </layer>
      </layer>

      <layer x="center" y={Layout.FRAME_TOP} w={{ fill: Layout.FRAME_INSET }} h={{ fill: Layout.FRAME_DROP }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          fill
          color={ClanSidepanelColor.BACKDROP}
          transparency={BACKDROP_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.BOX_INSET }} h={{ fill: Layout.BOX_INSET }}>
          <ClanChannelPane asGuest={1} />
          <ThinBoxEntrypoint />
        </layer>

        <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
      </layer>

      <layer x={1} y={{ bottom: 2 }} w={59} h={32}>
        <ClanLeaveButton asGuest={1} />
      </layer>

      <layer x="center" y={{ bottom: 2 }} w={60} h={32}>
        <ClanSettingsButton asGuest={1} />
      </layer>

      <layer x={{ right: 1 }} y={{ bottom: 2 }} w={59} h={32}>
        <ClanFindButton />
      </layer>
    </>
  );
}
