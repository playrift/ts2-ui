import { CS2 } from 'ts2';

import { CLAN_RANK_COUNT, ClanRankValues } from './clan-ranks.data';
import { AFFINITY_LIVE } from './clans-events.constants';

export const ORGANISE_EVENTS_STORED_RANK = 0;

const RANK_SETTING_OFFSET = 2;

const CLAN_RANK_OWNER = 126;

const CLAN_RANK_NOBODY = 128;

const ORGANISE_EVENTS_MIN_RANK = 0;

const ORGANISE_EVENTS_ALLOWS_NOBODY = false;

export function clanEventsPermissionRank(): Int {
  const rank: Int = ORGANISE_EVENTS_STORED_RANK - RANK_SETTING_OFFSET;

  let found: Int = 0;
  let index: Int = CLAN_RANK_COUNT;
  while (index > 0) {
    index = index - 1;
    const candidate: Int = ClanRankValues.at(index) ?? -1;
    if (rank === candidate) {
      if (candidate >= Math.min(0, ORGANISE_EVENTS_MIN_RANK)) {
        if (candidate <= CLAN_RANK_OWNER) {
          found = 1;
        } else if (candidate === CLAN_RANK_NOBODY && ORGANISE_EVENTS_ALLOWS_NOBODY) {
          found = 1;
        }
      }
      index = 0;
    }
  }

  if (found === 0) {
    if (ORGANISE_EVENTS_ALLOWS_NOBODY) {
      return CLAN_RANK_NOBODY;
    }
    return CLAN_RANK_OWNER;
  }

  return Math.max(rank, ORGANISE_EVENTS_MIN_RANK);
}

export function clanEventsHasPermission(playerName: String, affinity: Int): Int {
  if (affinity === AFFINITY_LIVE) {
    if (CS2.activeclansettings_affined_find(0)) {
      const slot: Int = CS2.activeclansettings_affined_slot_get(CS2.tags_remove(playerName));
      if (slot !== -1) {
        const required: Int = clanEventsPermissionRank();
        if (CS2.activeclansettings_affined_rank_get(slot) >= required) {
          return 1;
        }
      }
    }
  }
  return 0;
}
