import { EventArt, EventField, Layout } from './clans-events-create.constants';
import { EventButtonRow, EventFrame } from './event-buttons.component';
import { IntCell, RankCell, SelectionCell } from './event-cell.component';
import { EventDropdown } from './dropdown.component';

export function ClansEventsCreate(): Component {
  return (
    <>
      <EventForm />
      <EventDropdown />
    </>
  );
}

function EventForm(): Component {
  return (
    <layer x="center" y="center" w={Layout.FRAME_W} h={Layout.FRAME_H}>
      <EventFrame />

      <layer x="center" y={Layout.CONTENT_Y} w={{ fill: Layout.CONTENT_INSET_W }} h={{ fill: Layout.CONTENT_INSET_H }}>
        <layer x="center" y={0} w="fill" h={Layout.ROW_H}>
          <layer x="center" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <SelectionCell field={EventField.SUBTYPE} />
          </layer>
          <layer x="right" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <IntCell field={EventField.DATE} />
          </layer>
          <layer x="left" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <SelectionCell field={EventField.TYPE} />
          </layer>
        </layer>

        <layer x="center" y={Layout.ROW2_Y} w="fill" h={Layout.ROW_H}>
          <layer x="right" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <IntCell field={EventField.TIME} />
          </layer>
          <layer x="left" w={Layout.WIDE_CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <SelectionCell field={EventField.ACTIVITY} cellWidth={Layout.WIDE_CELL_W} />
          </layer>
        </layer>

        <layer x="center" y={Layout.ROW3_Y} w="fill" h={Layout.ROW_H}>
          <layer x="center" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <IntCell field={EventField.WORLD} />
          </layer>
          <layer x="right" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <IntCell field={EventField.DURATION} />
          </layer>
          <layer x="left" w={Layout.CELL_W} h="fill" options={['Edit']}>
            <sprite y="bottom" w="fill" h={Layout.VALUE_H} sprite={EventArt.CELL_BACKING_LIGHT} tiling />
            <RankCell />
          </layer>
        </layer>

        <layer x="center" y="bottom" w="fill" h={Layout.BUTTON_ROW_H}>
          <EventButtonRow />
        </layer>
      </layer>

      <layer x="left" y="top" w="fill" h="fill" />
    </layer>
  );
}
