export enum EventField {
  WORLD = 0,
  TYPE = 1,
  SUBTYPE = 2,
  ACTIVITY = 3,
  DURATION = 4,
  DATE = 5,
  TIME = 6,
  JOIN_RANK = 7,
}

export const EventFieldLabels = mapOf<EventField, String>([
  [EventField.WORLD, 'World'],
  [EventField.TYPE, 'Type'],
  [EventField.SUBTYPE, 'Subtype'],
  [EventField.ACTIVITY, 'Activity'],
  [EventField.DURATION, 'Duration (Days)'],
  [EventField.DATE, 'Date'],
  [EventField.TIME, 'Time'],
  [EventField.JOIN_RANK, 'Join Rank'],
]);

