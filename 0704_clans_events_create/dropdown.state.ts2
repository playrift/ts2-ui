import { sessionState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { Dropdown, EventField, Layout } from './clans-events-create.constants';

export const openField = sessionState(-1);

export function dropdownRowHeight(): Int {
  if (onMobile()) {
    return Dropdown.MOBILE_ROW_H;
  }
  return Dropdown.ROW_H;
}

export function dropdownCellWidth(field: EventField): Int {
  if (field === EventField.ACTIVITY) {
    return Layout.WIDE_CELL_W;
  }
  return Layout.CELL_W;
}

export function dropdownRowY(field: EventField): Int {
  if (field === EventField.ACTIVITY) {
    return Layout.ROW2_Y;
  }
  return 0;
}

export function dropdownCellX(field: EventField): Int {
  if (field === EventField.SUBTYPE) {
    return (Layout.FRAME_W - Layout.CONTENT_INSET_W - Layout.CELL_W) / 2;
  }
  return 0;
}
