import { CS2, useServerState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import { SteelBorder } from '../lib/steel-border.component';
import { StoneButtonInit } from './stone-button.component';
import { EventColor, EventFonts, EventVarbits, Layout } from './clans-events-create.constants';

export function EventButtonRow(): Component {
  const slot: Int = useServerState(EventVarbits.EDIT_SLOT);
  let editing: Int = 0;
  if (slot > 0) {
    editing = 1;
  }
  let deleteHidden: Boolean = false;
  if (editing === 0) {
    deleteHidden = true;
  }

  return (
    <>
      <layer
        x="left"
        y="center"
        w={Layout.BUTTON_W}
        h="fill"
        options={['*']}
        onOptionSelect={(event) => opsound(event.option, 2)}
      >
        <StoneButtonInit label="<col=ff0000>Back</col>" font={EventFonts.LABEL} />
      </layer>

      <layer
        x="center"
        y="center"
        w={Layout.BUTTON_W}
        h="fill"
        hide={deleteHidden}
        options={['*']}
        onOptionSelect={(event) => opsound(event.option, 2)}
      >
        {editing === 1 && <StoneButtonInit label="<col=ff0000>Delete</col>" font={EventFonts.LABEL} />}
      </layer>

      <layer
        x="right"
        y="center"
        w={Layout.BUTTON_W}
        h="fill"
        options={['*']}
        onOptionSelect={(event) => opsound(event.option, 2)}
      >
        {editing === 1 ? (
          <StoneButtonInit label="<col=0dc10d>Save</col>" font={EventFonts.LABEL} />
        ) : (
          <StoneButtonInit label="<col=0dc10d>Create</col>" font={EventFonts.LABEL} />
        )}
      </layer>
    </>
  );
}

export function EventFrame(): Component {
  const affinity: Int = useServerState(EventVarbits.AFFINITY);

  let title: String = '';
  if (affinity === 3 && CS2.activeclansettings_affined_find(0)) {
    title = `${CS2.activeclansettings_clan_name_get()}: Events`;
  }

  return (
    <layer w="fill" h="fill">
      <SteelBorder title={title} titleColor={EventColor.ACCENT} flags={0} />
    </layer>
  );
}
