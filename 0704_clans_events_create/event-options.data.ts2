export function optionSetBase(set: OptionSet): Int {
  switch (set) {
    case OptionSet.TYPE:
      return 0;
    case OptionSet.SUBTYPE:
      return 4;
    case OptionSet.ACT_BOSSING:
      return 14;
    case OptionSet.ACT_SKILLING:
      return 72;
    case OptionSet.ACT_PVP:
      return 91;
    case OptionSet.ACT_SOCIAL:
      return 109;
  }
  return 0;
}

export function optionSetCount(set: OptionSet): Int {
  switch (set) {
    case OptionSet.TYPE:
      return 4;
    case OptionSet.SUBTYPE:
      return 10;
    case OptionSet.ACT_BOSSING:
      return 58;
    case OptionSet.ACT_SKILLING:
      return 19;
    case OptionSet.ACT_PVP:
      return 18;
    case OptionSet.ACT_SOCIAL:
      return 10;
  }
  return 0;
}
