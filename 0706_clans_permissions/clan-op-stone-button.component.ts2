import { CS2, useState } from 'ts2';

import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile, opsound } from '../lib/lib.helpers';

const OP_SOUND_MASK = 2;

export function ClanOpStoneButton({ label, font }: { label: String; font: Font }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onOptionSelect={(event) => opsound(event.option, OP_SOUND_MASK)}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
    >
      <StoneButtonDraw label={label} font={font} pressed={skin} />
    </layer>
  );
}
