import { Sprites } from '../lib/game/sprites';

const Slim = {
  TOP: Sprites.V2_BORDERS_SLIM_0,
  LEFT: Sprites.V2_BORDERS_SLIM_1,
  BOTTOM: Sprites.V2_BORDERS_SLIM_2,
  RIGHT: Sprites.V2_BORDERS_SLIM_3,
  TOP_LEFT: Sprites.V2_BORDERS_SLIM_4,
  TOP_RIGHT: Sprites.V2_BORDERS_SLIM_5,
  BOTTOM_LEFT: Sprites.V2_BORDERS_SLIM_6,
  BOTTOM_RIGHT: Sprites.V2_BORDERS_SLIM_7,
};

const CORNER = 32;
const OVERHANG = 13;
const OVERHANG_FAR = 12;

export function StoneBorderFree({ left, top, w, h }: { left: Int; top: Int; w: Int; h: Int }): Component {
  const right: Int = left + w - CORNER;
  const bottom: Int = top + h - CORNER;
  const spanW: Int = w - CORNER * 2;
  const spanH: Int = h - CORNER * 2;

  return (
    <>
      <sprite x={left} y={top} w={CORNER} h={CORNER} sprite={Slim.TOP_LEFT} tiling />
      <sprite x={right} y={top} w={CORNER} h={CORNER} sprite={Slim.TOP_RIGHT} tiling />
      <sprite x={left} y={bottom} w={CORNER} h={CORNER} sprite={Slim.BOTTOM_LEFT} tiling />
      <sprite x={right} y={bottom} w={CORNER} h={CORNER} sprite={Slim.BOTTOM_RIGHT} tiling />
      <sprite x={left + CORNER} y={top - OVERHANG} w={spanW} h={CORNER} sprite={Slim.TOP} tiling />
      <sprite x={left + CORNER} y={top + h - 20} w={spanW} h={CORNER} sprite={Slim.BOTTOM} tiling />
      <sprite x={left - OVERHANG} y={top + CORNER} w={CORNER} h={spanH} sprite={Slim.LEFT} tiling />
      <sprite x={right + OVERHANG_FAR} y={top + CORNER} w={CORNER} h={spanH} sprite={Slim.RIGHT} tiling />
    </>
  );
}
