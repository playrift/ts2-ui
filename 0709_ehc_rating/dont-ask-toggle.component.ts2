import { predictServerState, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { EhcColors, EhcFonts, EhcSounds, EhcSprites, EhcVarbits, Layout } from './ehc-rating.constants';

export function DontAskToggle(): Component {
  const dontAsk: Int = useServerState(EhcVarbits.DONT_PROMPT);

  return (
    <layer
      w="fill"
      h="fill"
      options={['Select']}
      onOptionSelect={() => {
        predictServerState(EhcVarbits.DONT_PROMPT, 1 - dontAsk);
        playSound(EhcSounds.CLICK);
      }}
    >
      <text
        x="right"
        y="bottom"
        w={Layout.TOGGLE_LABEL_WIDTH}
        h={Layout.TOGGLE_LABEL_HEIGHT}
        text="Don't ask again."
        font={EhcFonts.SMALL}
        color={EhcColors.LABEL}
        valign="middle"
      />

      <sprite
        x={0}
        y="center"
        w={Layout.CHECKBOX_SIZE}
        h={Layout.CHECKBOX_SIZE}
        sprite={dontAsk === 1 ? EhcSprites.CHECKBOX_ON : EhcSprites.CHECKBOX_OFF}
      />
    </layer>
  );
}
