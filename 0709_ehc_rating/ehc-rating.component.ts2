import { DontAskToggle } from './dont-ask-toggle.component';
import { EhcButton } from './ehc-button.component';
import { EhcColors, EhcFonts, EhcModels, Layout } from './ehc-rating.constants';

export function EhcRating(): Component {
  return (
    <layer x={{ center: Layout.PANEL_NUDGE }} y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <text
        x="center"
        y={{ bottom: Layout.FOOTNOTE_BOTTOM }}
        w={Layout.FOOTNOTE_WIDTH}
        h={Layout.FOOTNOTE_HEIGHT}
        text="(No pop-up or survey follows this question.)"
        font={EhcFonts.SMALL}
        color={EhcColors.LABEL}
        align="center"
        valign="middle"
      />

      <DontAskToggle
        x={{ right: Layout.TOGGLE_RIGHT }}
        y={{ bottom: Layout.TOGGLE_BOTTOM }}
        w={Layout.TOGGLE_WIDTH}
        h={Layout.TOGGLE_HEIGHT}
      />

      <text
        x="center"
        y={Layout.MESSAGE_Y}
        w={Layout.MESSAGE_WIDTH}
        h={{ fill: Layout.MESSAGE_BOTTOM }}
        text="We hope you're enjoying our game client!<br><br>Would you recommend it to a friend?"
        font={EhcFonts.MESSAGE}
        color={EhcColors.LABEL}
        align="center"
        valign="middle"
      />

      <EhcButton
        label="No"
        x="center"
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <EhcButton
        label="Skip"
        x={{ right: Layout.BUTTON_EDGE }}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <EhcButton
        label="Yes"
        x={Layout.BUTTON_EDGE}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />

      <model
        x={Layout.MODEL_INSET}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={EhcModels.PROMPT}
        zoom={Layout.MODEL_ZOOM}
      />
      <model
        x={{ right: Layout.MODEL_INSET }}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={EhcModels.PROMPT}
        zoom={Layout.MODEL_ZOOM}
      />
    </layer>
  );
}
