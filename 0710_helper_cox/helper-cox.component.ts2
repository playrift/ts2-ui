import { graphicSwapper } from '../lib/lib.helpers';
import { HelperBackgroundEntrypoint } from './helper-background.component';
import { Layout, ShowMoreSprites } from './helper-cox.constants';

export function HelperCox(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer x={0} y={0} w="fill" h="fill">
        <layer x={0} y="center" w="fill" h="fill">
          <HelperBackgroundEntrypoint />
        </layer>

        <layer
          x={Layout.CONTENT_INSET}
          y={Layout.CONTENT_INSET}
          w={{ fill: Layout.CONTENT_MARGIN }}
          h={{ fill: Layout.CONTENT_MARGIN }}
        >
          <layer x="right" y="bottom" w={Layout.ARROW_BOX} h={Layout.ARROW_BOX} noClickThrough>
            <sprite
              x="right"
              y="bottom"
              w={Layout.ARROW_BOX}
              h={Layout.ARROW_BOX}
              sprite={ShowMoreSprites.REST}
              vflip
              hflip
              options={['*']}
              onMouseEnter={(event) => graphicSwapper(event.component, ShowMoreSprites.HOVER)}
              onMouseLeave={(event) => graphicSwapper(event.component, ShowMoreSprites.REST)}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
