import { CS2, useInventory, useServerState, useState } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Varbits } from '../lib/game/varbits';
import { leagueRelicActive } from '../lib/lib.magic';
import { Relic } from '../lib/league-relics.data';
import {
  helperGenericActive,
  helperGenericAddText,
  helperGenericAddTitle,
  helperGenericBuildUi,
  helperGenericSetup,
  helperGenericUpdateText,
} from './helper-generic.state';
import { ClueEmoteNames, ClueHotColdCluequest3 } from './clue-enums.data';
import {
  ChallengeKind,
  Challenges,
  ChallengeQuestionsOf,
  ClueCombatsOf,
  ClueEmotesOf,
  Clue,
  ClueKind,
  ClueRequirementsOf,
  ClueTargetKind,
  ClueTargetNpcs,
  ClueTargets,
  ClueTypeHotColdBeginner,
  ClueTypeHotColdMaster,
  Clues,
  CombatEncounters,
} from './clues.data';
import {
  HELPER_ACTIVE_CLUE,
  clueBoundRowsClear,
  clueChallengeVariant,
  clueColourBinary,
  clueColourTernary,
  clueDifficulty,
  clueHelperClue,
  clueMusicRowIndex,
  clueOutfitFallbackRowIndex,
  clueSpadeRowIndex,
  clueStashRowIndex,
  clueHotColdPossible,
  clueHotColdStored,
  clueIsDig,
  clueRequirementDescription,
  clueStashBuilt,
  clueTarget,
  clueTargetDescription,
  clueTargetDescriptionShort,
  clueTargetTuple,
  clueTargetVariant,
  leagueSix,
} from './cluehelper.state';
import { MusicTracks } from '../0239_music/music.data';
import { trackUnlocked } from '../0239_music/music.component';
import { clueEquipUpdate, clueOutfitFallbackText, clueOutfitRows } from './cluehelper-outfit';

export function cluehelperInfoboxDrawContent(): void {
  const [clue] = useState(clueHelperClue);
  helperGenericSetup(1, 1, 1);
  const [, setActive] = useState(helperGenericActive);
  setActive(HELPER_ACTIVE_CLUE);
  clueBoundRowsClear();
  const row = Clues.at(clue);
  if (row !== null) {
    switch (row.kind) {
      case ClueKind.CRYPTIC: {
        drawCryptic(clue);
      }
      case ClueKind.ANAGRAM: {
        drawAnagram(clue);
      }
      case ClueKind.MAP: {
        drawMap(clue);
      }
      case ClueKind.HOTCOLD: {
        drawHotCold(clue);
      }
      case ClueKind.EMOTE: {
        drawEmote(clue);
      }
      case ClueKind.COORDINATE: {
        drawCoordinate(clue);
      }
      case ClueKind.SKILLCHALLENGE: {
        drawSkillChallenge(clue);
      }
      case ClueKind.MUSIC: {
        drawMusic(clue);
      }
      case ClueKind.FALOBARD: {
        drawFaloBard(clue);
      }
      case ClueKind.CIPHER: {
        drawCipher(clue);
      }
      case ClueKind.FAIRYRING: {
        drawFairyRing(clue);
      }
      default: {
      }
    }
  }
  helperGenericBuildUi();
  clueSpadeUpdate();
  clueStashUpdate();
  clueOutfitUpdate();
  clueMusicUpdate();
}

export function clueSpadeUpdate(): void {
  const [row] = useState(clueSpadeRowIndex);
  if (row < 0) {
    return;
  }
  helperGenericUpdateText(row, clueSpadeText());
}

export function clueStashUpdate(): void {
  const [row] = useState(clueStashRowIndex);
  if (row < 0) {
    return;
  }
  const [clue] = useState(clueHelperClue);
  const shown = Clues.at(clue);
  if (shown === null) {
    return;
  }
  const loc: WorldObject | null = shown.hideyHoleLoc ?? null;
  if (loc === null) {
    return;
  }
  helperGenericUpdateText(row, clueStashText(loc));
}

export function clueOutfitUpdate(): void {
  const [clue] = useState(clueHelperClue);
  const [fallbackRow] = useState(clueOutfitFallbackRowIndex);
  if (fallbackRow >= 0) {
    helperGenericUpdateText(fallbackRow, clueOutfitFallbackText(clue));
    return;
  }
  const shown = Clues.at(clue);
  if (shown === null) {
    return;
  }
  clueEquipUpdate(shown.outfit ?? -1);
}

export function clueMusicUpdate(): void {
  const [row] = useState(clueMusicRowIndex);
  if (row < 0) {
    return;
  }
  const [clue] = useState(clueHelperClue);
  helperGenericUpdateText(row, clueMusicRow(clue));
}

function showClueText(): Boolean {
  return useServerState(Varbits.OPTION_CLUEHELPER_INFOBOX_SHOW_CLUE_TEXT) === 1;
}

function clueText(clue: Int): String {
  const row = Clues.at(clue);
  if (row === null) {
    return '';
  }
  return row.clueText ?? '';
}

function targetOf(clue: Int): Int {
  const row = Clues.at(clue);
  if (row === null) {
    return -1;
  }
  const first: Int = row.target ?? -1;
  if (first === -1) {
    return -1;
  }
  return clueTargetTuple(clue, first, clueTargetVariant(first));
}

const SPADE = 952;
const EASTER23_SPADE = 27873;
const FEUD_KEBABMAN_POSTQUEST = 11876;
const SLAYER_MASTER_1_TUREAL = 13618;
const SLAYER_MASTER_1_AYA = 13619;
const WARGUILD_GHOMMAL_NPC = 13613;
const WARGUILD_LAIDEE = 13614;

export function clueSpadeText(): String {
  const inv: Container = useInventory(Inventories.INV);
  let held: Int = 0;
  if (inv.total(SPADE as Item) > 0) {
    held = 1;
  } else if (inv.total(EASTER23_SPADE as Item) > 0) {
    held = 1;
  }
  return clueColourBinary('A spade is required!', held);
}

export function clueSpadeRow(): void {
  const [, setSpadeRow] = useState(clueSpadeRowIndex);
  setSpadeRow(helperGenericAddText(clueSpadeText()));
}

export function clueStashRow(loc: WorldObject): void {
  const [, setStashRow] = useState(clueStashRowIndex);
  setStashRow(helperGenericAddText(clueStashText(loc)));
}

export function clueStashText(loc: WorldObject): String {
  const filled: Int = useServerState(Varbits.CLUEHELPER_HIDEYHOLE_FILLED);
  const built: Int = clueStashBuilt(loc);
  let text: String = 'null';
  let state: Int = 0;
  if (filled === 1) {
    state = 1;
    text = 'Filled';
  } else if (built === 1) {
    state = 2;
    text = 'Built';
  } else {
    state = 0;
    text = 'Not built';
  }
  clueColourTernary(text, state);
  return text;
}

function clueOutfitFallbackRow(clue: Int): void {
  const [, setFallbackRow] = useState(clueOutfitFallbackRowIndex);
  setFallbackRow(helperGenericAddText(clueOutfitFallbackText(clue)));
}

function digRow(clue: Int, target: Int): void {
  if (clueIsDig(clue, target) === 1) {
    clueSpadeRow();
  }
}

export function clueTargetDisplay(target: Int): void {
  const row = ClueTargets.at(target);
  if (row === null) {
    return;
  }
  switch (row.kind) {
    case ClueTargetKind.NPC: {
      helperGenericAddTitle('Talk-to', 0);
      let npc: Npc | null = row.fallbackNpc ?? null;
      if (npc === (FEUD_KEBABMAN_POSTQUEST as Npc) && useServerState(Varbits.FEUD_VAR) < 28) {
        npc = null;
      }
      if (npc === (SLAYER_MASTER_1_TUREAL as Npc) && useServerState(Varbits.WGS_HERO_PART_1_VIS) !== 0) {
        npc = SLAYER_MASTER_1_AYA as Npc;
      }
      if (npc === (WARGUILD_GHOMMAL_NPC as Npc) && useServerState(Varbits.WGS_HERO_PART_2_VIS) !== 0) {
        npc = WARGUILD_LAIDEE as Npc;
      }
      if (npc !== null) {
        helperGenericAddText(CS2.npc_name(npc));
      } else {
        helperGenericAddText(CS2.npc_name(row.npc ?? (0 as Npc)));
      }
      helperGenericAddTitle('Location', 0);
      helperGenericAddText(clueTargetDescription(target));
    }
    case ClueTargetKind.LOC: {
      helperGenericAddTitle('Goal', 0);
      const loc: WorldObject | null = row.fallbackLoc ?? null;
      if (loc !== null) {
        helperGenericAddText(CS2.object_name(loc));
      } else {
        helperGenericAddText(CS2.object_name(row.loc ?? (0 as WorldObject)));
      }
      helperGenericAddTitle('Location', 0);
      helperGenericAddText(clueTargetDescription(target));
    }
    case ClueTargetKind.COORD: {
      helperGenericAddTitle('Location ', 0);
      helperGenericAddText(clueTargetDescription(target));
    }
    case ClueTargetKind.KEY: {
      helperGenericAddText(clueTargetDescription(target));
      helperGenericAddTitle('Kill', 0);
      helperGenericAddText(CS2.npc_name(targetNpcFirst(target)));
      helperGenericAddTitle('Key', 0);
      helperGenericAddText(CS2.item_name(row.key ?? (0 as Item)));
      helperGenericAddTitle('Search', 0);
      helperGenericAddText(CS2.object_name(row.loc ?? (0 as WorldObject)));
    }
    case ClueTargetKind.KILL: {
      helperGenericAddTitle('Kill', 0);
      helperGenericAddText(clueTargetDescription(target));
    }
    default: {
    }
  }
}

function targetNpcFirst(target: Int): Npc {
  let i: Int = 0;
  while (i < ClueTargetNpcs.length) {
    const entry = ClueTargetNpcs.at(i);
    if (entry !== null) {
      if (entry.row === target) {
        return entry.npcs;
      }
    }
    i = i + 1;
  }
  return 0 as Npc;
}

export function clueChallengeDisplay(challenge: Int, variant: Int): void {
  const row = Challenges.at(challenge);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Challenge', 0);
  switch (row.kind) {
    case ChallengeKind.QUESTION: {
      helperGenericAddText(`Answer = ${CS2.tostring(challengeAnswer(challenge, variant))}`);
    }
    case ChallengeKind.BOX: {
      helperGenericAddText(row.description ?? 'null');
    }
    default: {
    }
  }
}

function challengeAnswer(challenge: Int, n: Int): Int {
  let seen: Int = 0;
  let found: Int = 0;
  let i: Int = 0;
  while (i < ChallengeQuestionsOf.length) {
    const entry = ChallengeQuestionsOf.at(i);
    if (entry !== null) {
      if (entry.row === challenge) {
        if (seen === n) {
          found = entry.answer;
          i = ChallengeQuestionsOf.length;
        }
        seen = seen + 1;
      }
    }
    i = i + 1;
  }
  return found;
}

function drawCryptic(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  let target: Int = targetOf(clue);
  let text: String = row.clueText ?? '';
  helperGenericAddTitle('Cryptic Clue', 1);
  if (leagueSix() === true) {
    const leagueText: String = row.leagueClueText ?? '';
    const leagueTarget: Int = row.leagueTarget ?? -1;
    if (leagueTarget !== -1) {
      target = leagueTarget;
    }
    if (CS2.string_length(leagueText) > 0) {
      text = leagueText;
    }
  }
  if (showClueText()) {
    helperGenericAddText(text);
  }
  clueTargetDisplay(target);
  const challenge: Int = row.challenge ?? -1;
  if (challenge !== -1) {
    clueChallengeDisplay(challenge, clueChallengeVariant(clue));
  }
  const stash: WorldObject | null = row.hideyHoleLoc ?? null;
  if (stash !== null) {
    helperGenericAddTitle('S.T.A.S.H', 0);
    clueStashRow(stash);
  }
  const outfit: Int = row.outfit ?? -1;
  if (outfit !== -1) {
    helperGenericAddTitle('Equip', 0);
    if (CS2.string_length(row.outfitTextFallback ?? '') > 0) {
      clueOutfitFallbackRow(clue);
    } else {
      clueOutfitRows(outfit);
    }
  }
  digRow(clue, target);
}

function drawAnagram(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Anagram Clue', 1);
  if (showClueText()) {
    helperGenericAddText(clueText(clue));
  }
  const target: Int = targetOf(clue);
  clueTargetDisplay(target);
  clueChallengeDisplay(row.challenge ?? -1, clueChallengeVariant(clue));
  digRow(clue, target);
}

function drawCipher(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Cipher Clue', 1);
  if (showClueText()) {
    helperGenericAddText(clueText(clue));
  }
  const target: Int = targetOf(clue);
  clueTargetDisplay(target);
  clueChallengeDisplay(row.challenge ?? -1, clueChallengeVariant(clue));
  digRow(clue, target);
}

function drawMap(clue: Int): void {
  helperGenericAddTitle('Map Clue', 1);
  const target: Int = targetOf(clue);
  const dig: Int = clueIsDig(clue, target);
  if (showClueText()) {
    if (dig === 1) {
      helperGenericAddText(
        'Find the clue scroll indicator on your world map to see your destination. <br>Travel to the destination and dig at the marked location.',
      );
    } else {
      helperGenericAddText(
        'Find the clue scroll indicator on your world map to see your destination. <br>Travel to the destination and search the marked location.',
      );
    }
  }
  clueTargetDisplay(target);
  if (dig === 1) {
    clueSpadeRow();
  }
}

function drawCoordinate(clue: Int): void {
  helperGenericAddTitle('Coordinate Clue', 1);
  if (showClueText()) {
    helperGenericAddText(clueText(clue));
    helperGenericAddText('Dig at the location below.');
  }
  const target: Int = targetOf(clue);
  clueTargetDisplay(target);
  combatRows(clue);
  digRow(clue, target);
}

function combatRows(clue: Int): void {
  let any: Boolean = false;
  let i: Int = 0;
  while (i < ClueCombatsOf.length) {
    const entry = ClueCombatsOf.at(i);
    if (entry !== null) {
      if (entry.row === clue) {
        if (!any) {
          helperGenericAddTitle('Combat', 0);
          any = true;
        }
        const encounter = CombatEncounters.at(entry.combatEncounter);
        if (encounter !== null) {
          helperGenericAddText(encounter.description);
        }
      }
    }
    i = i + 1;
  }
}

function drawSkillChallenge(clue: Int): void {
  const difficulty: Int = clueDifficulty(clue);
  helperGenericAddTitle('Skill Challenge', 1);
  helperGenericAddText(clueText(clue));
  if (showClueText()) {
    if (difficulty === 0) {
      helperGenericAddText('Firstly, talk to Charlie, then bring the requested item.');
    } else if (difficulty === 4 || difficulty === 5) {
      helperGenericAddText('Firstly, talk to Sherlock, then bring the requested item.');
    }
  }
  let any: Boolean = false;
  let i: Int = 0;
  while (i < ClueRequirementsOf.length) {
    const entry = ClueRequirementsOf.at(i);
    if (entry !== null) {
      if (entry.row === clue) {
        if (!any) {
          helperGenericAddTitle('Requirements', 0);
          any = true;
        }
        helperGenericAddText(clueRequirementDescription(entry.requirement));
      }
    }
    i = i + 1;
  }
}

function drawFaloBard(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Falo the Bard Clue', 1);
  if (showClueText()) {
    helperGenericAddText(clueText(clue));
  }
  clueTargetDisplay(targetOf(clue));
  helperGenericAddTitle('Item', 0);
  helperGenericAddText(clueRequirementDescription(row.requirements ?? -1));
}

function drawMusic(clue: Int): void {
  helperGenericAddTitle('Music Clue', 1);
  if (showClueText()) {
    helperGenericAddText('Travel to the marked destination and near the NPC play the song in the music player.');
  }
  clueTargetDisplay(targetOf(clue));
  helperGenericAddTitle('Song', 0);
  const [, setMusicRow] = useState(clueMusicRowIndex);
  setMusicRow(helperGenericAddText(clueMusicRow(clue)));
}

export function clueMusicRow(clue: Int): String {
  const row = Clues.at(clue);
  if (row === null) {
    return '';
  }
  const track = MusicTracks.at(row.music ?? -1);
  if (track === null) {
    return '';
  }
  return clueColourBinary(track.name, trackUnlocked(track) ? 1 : 0);
}

function drawFairyRing(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Fairy Ring Clue', 1);
  if (showClueText()) {
    helperGenericAddText(
      'Travel to the fairy ring, and then walk the following amount of steps to the marked location then dig.',
    );
  }
  const target: Int = targetOf(clue);
  helperGenericAddTitle('Fairy Ring Code', 0);
  helperGenericAddText(row.fairyringCode ?? '');
  helperGenericAddTitle('Steps from the Fairy Ring', 0);
  const n: Int = row.stepsSlot0 ?? 0;
  const e: Int = row.stepsSlot1 ?? 0;
  const s: Int = row.stepsSlot2 ?? 0;
  const w: Int = row.stepsSlot3 ?? 0;
  helperGenericAddText(`${CS2.tostring(n)}n ${CS2.tostring(e)}e ${CS2.tostring(s)}s ${CS2.tostring(w)}w`);
  digRow(clue, target);
}

function drawEmote(clue: Int): void {
  const row = Clues.at(clue);
  if (row === null) {
    return;
  }
  helperGenericAddTitle('Emote Clue', 1);
  if (showClueText()) {
    helperGenericAddText(clueText(clue));
  }
  helperGenericAddTitle('Emotes', 0);
  let i: Int = 0;
  while (i < ClueEmotesOf.length) {
    const entry = ClueEmotesOf.at(i);
    if (entry !== null) {
      if (entry.row === clue) {
        if (entry.emote === -1) {
          helperGenericAddText('Bull roarer');
        } else {
          helperGenericAddText(ClueEmoteNames.at(entry.emote) ?? 'Emote');
        }
      }
    }
    i = i + 1;
  }
  clueTargetDisplay(targetOf(clue));
  const stash: WorldObject | null = row.hideyHoleLoc ?? null;
  if (stash !== null) {
    helperGenericAddTitle('S.T.A.S.H', 0);
    clueStashRow(stash);
  }
  const outfit: Int = row.outfit ?? -1;
  if (outfit !== -1) {
    helperGenericAddTitle('Equip', 0);
    if (leagueRelicActive(Relic.STRUCT_1128) === 1) {
      helperGenericAddText('Anything');
    } else if (CS2.string_length(row.outfitTextFallback ?? '') > 0) {
      clueOutfitFallbackRow(clue);
    } else {
      clueOutfitRows(outfit);
    }
  }
  combatRows(clue);
}

function drawHotCold(clue: Int): void {
  helperGenericAddTitle('Hot/Cold Clue', 1);
  if (showClueText()) {
    helperGenericAddText(
      'Use the orb to show how far away the target location is. As you do, potential locations will be eliminated from the list.',
    );
  }
  const difficulty: Int = clueDifficulty(clue);
  const [stored] = useState(clueHotColdStored);
  let candidates: Int = 0;
  if (stored === 1) {
    candidates = clueHotColdCandidateCount(clue, difficulty);
  }
  helperGenericAddTitle('Locations', 0);
  let listed: Int = 0;
  let last: Int = -1;
  let i: Int = 0;
  while (i < candidates && listed < HOTCOLD_LISTED) {
    if (clueHotColdPossible(i)) {
      last = clueTarget(clueHotColdCandidate(clue, difficulty, i));
      helperGenericAddText(clueTargetDescriptionShort(last));
      listed = listed + 1;
    }
    i = i + 1;
  }
  if (listed >= HOTCOLD_LISTED) {
    let possible: Int = 0;
    i = 0;
    while (i < candidates) {
      if (clueHotColdPossible(i)) {
        possible = possible + 1;
      }
      i = i + 1;
    }
    const others: Int = possible - HOTCOLD_LISTED;
    if (others > 0) {
      helperGenericAddText(`and ${CS2.tostring(others)} other possible locations!`);
    }
  }
  digRow(clue, last);
}

const HOTCOLD_LISTED = 10;

export function clueHotColdCandidateCount(clue: Int, difficulty: Int): Int {
  if (clue === Clue.HOTCOLD_CLUEQUEST_3) {
    return ClueHotColdCluequest3.length;
  }
  if (difficulty === 0) {
    return ClueTypeHotColdBeginner.length;
  }
  if (difficulty === 5) {
    return ClueTypeHotColdMaster.length;
  }
  return 0;
}

export function clueHotColdCandidate(clue: Int, difficulty: Int, n: Int): Int {
  if (clue === Clue.HOTCOLD_CLUEQUEST_3) {
    return ClueHotColdCluequest3.at(n) ?? -1;
  }
  if (difficulty === 0) {
    return ClueTypeHotColdBeginner.at(n) ?? -1;
  }
  if (difficulty === 5) {
    return ClueTypeHotColdMaster.at(n) ?? -1;
  }
  return -1;
}
