import { useState, useWatch } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Varps } from '../lib/game/varps';
import { helperGenericActive } from './helper-generic.state';
import { clueMusicUpdate, clueOutfitUpdate, clueSpadeUpdate, clueStashUpdate } from './cluehelper-content';
import { HELPER_ACTIVE_CLUE } from './cluehelper.state';

export function ClueHelperTransmits(): Component {
  return (
    <layer x={0} y={0} w={1} h={1}>
      <ClueSpadeTransmits />
      <ClueOutfitTransmits />
      <ClueStashTransmits />
      <ClueMusicTransmits />
    </layer>
  );
}

function ClueSpadeTransmits(): Component {
  useWatch(Inventories.INV, () => clueGated(0));
  return <layer x={0} y={0} w={1} h={1} />;
}

function ClueOutfitTransmits(): Component {
  useWatch([Inventories.INV, Inventories.WORN], () => clueGated(1));
  return <layer x={0} y={0} w={1} h={1} />;
}

function ClueStashTransmits(): Component {
  useWatch(
    [
      Varps.SETTINGS_TRACKING,
      Varps.HH_CONSTRUCTED_EASY,
      Varps.HH_CONSTRUCTED_MEDIUM,
      Varps.HH_CONSTRUCTED_HARD,
      Varps.HH_CONSTRUCTED_ELITE,
      Varps.HH_CONSTRUCTED_MASTER,
      Varps.HH_CONSTRUCTED_BEGINNER,
    ],
    () => clueGated(2),
  );
  return <layer x={0} y={0} w={1} h={1} />;
}

function ClueMusicTransmits(): Component {
  useWatch(
    [
      Varps.MUSICMULTI_1,
      Varps.MUSICMULTI_2,
      Varps.MUSICMULTI_3,
      Varps.MUSICMULTI_4,
      Varps.MUSICMULTI_5,
      Varps.MUSICMULTI_6,
      Varps.MUSICMULTI_7,
      Varps.MUSICMULTI_8,
      Varps.MUSICMULTI_9,
      Varps.MUSICMULTI_10,
      Varps.MUSICMULTI_11,
      Varps.MUSICMULTI_12,
      Varps.MUSICMULTI_13,
      Varps.MUSICMULTI_14,
      Varps.MUSICMULTI_15,
      Varps.MUSICMULTI_16,
      Varps.MUSICMULTI_17,
      Varps.MUSICMULTI_18,
      Varps.MUSICMULTI_19,
      Varps.MUSICMULTI_20,
      Varps.MUSICMULTI_21,
      Varps.MUSICMULTI_22,
      Varps.MUSICMULTI_23,
      Varps.MUSICMULTI_24,
      Varps.MUSICMULTI_25,
      Varps.MUSICMULTI_26,
      Varps.HH_CONSTRUCTED_MEDIUM,
    ],
    () => clueGated(3),
  );
  return <layer x={0} y={0} w={1} h={1} />;
}

function clueGated(host: Int): void {
  const [active] = useState(helperGenericActive);
  if (active !== HELPER_ACTIVE_CLUE) {
    return;
  }
  if (host === 0) {
    clueSpadeUpdate();
  } else if (host === 1) {
    clueOutfitUpdate();
  } else if (host === 2) {
    clueStashUpdate();
  } else {
    clueMusicUpdate();
  }
}
