import { CS2, useInventory, useServerState, useState } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { Varbits } from '../lib/game/varbits';
import { groupDigits } from '../lib/lib.format';
import {
  HelperActive,
  helperGenericActive,
  helperGenericActiveArg,
  helperGenericAddData,
  helperGenericAddTitle,
  helperGenericBuildUi,
  helperGenericSetBit,
  helperGenericSetup,
} from './helper-generic.state';

const ICE_GLOVES = 1580;

function heldRow(label: String, held: Int): void {
  if (held > 0) {
    helperGenericAddData(label, CS2.tostring(held));
  }
}

export function furnaceCollection(): String {
  const hot: Int = useServerState(Varbits.BLAST_FURNACE_BARS_HOT);
  const worn: Container = useInventory(Inventories.WORN);
  const gloves: Int = worn.total(ICE_GLOVES as Item);
  if ((gloves > 0 && hot !== 0) || hot === 3) {
    return '<col=00ff00>Ready</col>';
  }
  if (hot === 2) {
    return '<col=ff0000>Needs cooling</col>';
  }
  return '<col=ff0000>Not ready</col>';
}

export function helperFurnaceDraw(showCoffer: Int): void {
  helperGenericSetup(0, 1, 1);
  helperGenericSetBit(0);
  helperGenericAddTitle('Blast Furnace Info', 0);
  const [, setActive] = useState(helperGenericActive);
  const [, setArg] = useState(helperGenericActiveArg);
  setActive(HelperActive.FURNACE);
  setArg(showCoffer);
  if (showCoffer === 1) {
    helperGenericAddData('Coffer:', groupDigits(useServerState(Varbits.BLAST_FURNACE_COFFER), ','));
  }
  helperGenericAddData('Collection:', furnaceCollection());
  heldRow('Coal:', useServerState(Varbits.BLAST_FURNACE_COAL));
  heldRow('Tin ore:', useServerState(Varbits.BLAST_FURNACE_TIN_ORE));
  heldRow('Copper ore:', useServerState(Varbits.BLAST_FURNACE_COPPER_ORE));
  heldRow('Bronze bars:', useServerState(Varbits.BLAST_FURNACE_BRONZE_BARS));
  heldRow('Iron ore:', useServerState(Varbits.BLAST_FURNACE_IRON_ORE));
  heldRow('Iron bars:', useServerState(Varbits.BLAST_FURNACE_IRON_BARS));
  heldRow('Lead ore:', useServerState(Varbits.BLAST_FURNACE_LEAD_ORE));
  heldRow('Lead bars:', useServerState(Varbits.BLAST_FURNACE_LEAD_BARS));
  heldRow('Steel bars:', useServerState(Varbits.BLAST_FURNACE_STEEL_BARS));
  heldRow('Mithril ore:', useServerState(Varbits.BLAST_FURNACE_MITHRIL_ORE));
  heldRow('Mithril bars:', useServerState(Varbits.BLAST_FURNACE_MITHRIL_BARS));
  heldRow('Adamantite ore:', useServerState(Varbits.BLAST_FURNACE_ADAMANTITE_ORE));
  heldRow('Adamantite bars:', useServerState(Varbits.BLAST_FURNACE_ADAMANTITE_BARS));
  heldRow('Nickel ore:', useServerState(Varbits.BLAST_FURNACE_NICKEL_ORE));
  heldRow('Cupronickel bars:', useServerState(Varbits.BLAST_FURNACE_CUPRONICKEL_BARS));
  heldRow('Runite ore:', useServerState(Varbits.BLAST_FURNACE_RUNITE_ORE));
  heldRow('Runite bars:', useServerState(Varbits.BLAST_FURNACE_RUNITE_BARS));
  heldRow('Silver ore:', useServerState(Varbits.BLAST_FURNACE_SILVER_ORE));
  heldRow('Silver bars:', useServerState(Varbits.BLAST_FURNACE_SILVER_BARS));
  heldRow('Gold ore:', useServerState(Varbits.BLAST_FURNACE_GOLD_ORE));
  heldRow('Gold bars:', useServerState(Varbits.BLAST_FURNACE_GOLD_BARS));
  heldRow('Perfect gold ore:', useServerState(Varbits.BLAST_FURNACE_PERFECT_GOLD_ORE));
  heldRow('Perfect gold bars:', useServerState(Varbits.BLAST_FURNACE_PERFECT_GOLD_BARS));
  helperGenericBuildUi();
}

export function helperFurnaceTransmit(): void {
  const [active] = useState(helperGenericActive);
  if (active !== HelperActive.FURNACE) {
    return;
  }
  const [showCoffer] = useState(helperGenericActiveArg);
  helperFurnaceDraw(showCoffer);
}
