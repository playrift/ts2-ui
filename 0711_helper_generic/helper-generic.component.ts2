const UNSET_OP = '*';

const OP_SUBJECT = '<col=ff9040>Helper</col>';

const TITLE_LINE = 15;
const BODY_LINE = 14;

export function HelperGeneric(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer x={0} y={0} w="fill" h="fill">
        <HelperScrollHolder />
        <layer x={{ right: 1 }} y={{ bottom: 1 }} w={1} h={1} />
        <layer x={0} y="center" w="fill" h="fill">
          <HelperBackgroundEntrypoint />
        </layer>
        <HelperContent />
      </layer>
      <HelperSlayerTransmits />
      <HelperAgilityTransmits />
      <HelperFurnaceTransmits />
      <ClueHelperTransmits />
      <HelperSpeedrunClock />
    </layer>
  );
}

function HelperSlayerTransmits(): Component {
  useWatch(
    [
      Varps.SLAYER_COUNT,
      Varps.SLAYER_TARGET,
      Varps.SLAYER_AREA,
      Varps.SLAYER_TASKS_COMPLETED_1,
      Varps.SLAYER_TASKS_COMPLETED_2,
      Varps.SLAYER_KILLERWATT_VAR,
    ],
    () => helperSlayerTransmit(),
  );
  return <layer x={0} y={0} w={1} h={1} />;
}

function HelperAgilityTransmits(): Component {
  useWatch(Varps.HELPER_AGILITY_VARS, () => helperAgilityTransmit());
  return <layer x={0} y={0} w={1} h={1} />;
}

function HelperFurnaceTransmits(): Component {
  useWatch(
    [
      Varps.BLAST_FURNACE_READINGS,
      Varps.DTTD_REGION,
      Varps.BLAST_FURNACE_1,
      Varps.BLAST_FURNACE_2,
      Varps.BLAST_FURNACE_3,
      Varps.BLAST_FURNACE_4,
      Varps.BLAST_FURNACE_5,
      Varps.BLAST_FURNACE_6,
      Varps.BLAST_FURNACE_7,
    ],
    () => helperFurnaceTransmit(),
  );
  useWatch(Inventories.WORN, () => helperFurnaceTransmit());
  return <layer x={0} y={0} w={1} h={1} />;
}

function HelperSpeedrunClock(): Component {
  const host = useRef();
  const [active] = useState(helperGenericActive);
  const [row] = useState(helperSpeedrunClockRow);
  useInterval(
    active === HelperActive.SPEEDRUN && row > 0 ? () => speedrunHelperUpdateTimeEntrypoint() : undefined,
    host,
  );
  return <layer ref={host} x={0} y={0} w={1} h={1} />;
}

function HelperScrollHolder(): Component {
  const [frameH] = useState(helperGenericFrameH);
  if (frameH === -1) {
    return <layer x={{ right: 4 }} y={4} w={14} h={{ fill: 8 }} />;
  }
  const scrolls: Boolean = frameH > 300;
  return (
    <layer x={4} y={4} w={scrolls ? 14 : 0} h={{ fill: 8 }} hide={!scrolls}>
      {scrolls && <HelperScrollbar />}
    </layer>
  );
}

const PIECE_ALPHA = 150;
const ARROW_ALPHA = 70;

function HelperScrollbar(): Component {
  const holder = useUniverse();
  const gutter = useRef();
  const thumb = useRef();
  const [frameH] = useState(helperGenericFrameH);
  const [extent] = useState(helperGenericScrollExtent);
  const [scrollY, setScrollY] = useState(helperGenericScrollY);
  const thumbH: Int = thumbHeightOf(holder.height, holder.height, extent, false);
  const thumbY: Int = ARROW + ((holder.height - ARROW * 2 - thumbH) * scrollY) / Math.max(1, extent - holder.height);
  return (
    <>
      <sprite
        ref={gutter}
        y="center"
        w="fill"
        h={{ fill: ARROW * 2 }}
        sprite={Sprites.SCROLLBAR_TRANS_DRAGGER_3}
        transparency={PIECE_ALPHA}
        noClickThrough
        onScrollWheel={(event) => {
          const range: Int = Math.max(1, frameH - gutter.height - ARROW * 2);
          setScrollY(Math.clamp(0, range, scrollY + event.mouseY * WHEEL));
        }}
        onClick={(event) => {
          const range: Int = Math.max(1, frameH - gutter.height - ARROW * 2);
          const span: Int = Math.max(1, gutter.height - thumb.height);
          const offset: Int = Math.clamp(0, span, event.mouseY - thumb.height / 2);
          setScrollY((offset * range) / span);
        }}
      />
      <sprite
        ref={thumb}
        y={thumbY}
        w="fill"
        h={thumbH}
        sprite={Sprites.SCROLLBAR_TRANS_DRAGGER_1}
        transparency={PIECE_ALPHA}
        noClickThrough
        draggable={gutter}
        dragMoves
        onDrag={(event) => {
          const range: Int = Math.max(1, frameH - gutter.height - ARROW * 2);
          const span: Int = Math.max(1, gutter.height - thumb.height);
          setScrollY((Math.clamp(0, span, event.mouseY) * range) / span);
        }}
      />
      <sprite y={thumbY} w="fill" h={CAP} sprite={Sprites.SCROLLBAR_TRANS_DRAGGER_0} transparency={PIECE_ALPHA} />
      <sprite
        y={thumbY + thumbH - CAP}
        w="fill"
        h={CAP}
        sprite={Sprites.SCROLLBAR_TRANS_DRAGGER_2}
        transparency={PIECE_ALPHA}
      />
      <sprite
        y="top"
        w="fill"
        h={ARROW}
        sprite={Sprites.SCROLLBAR_TRANS_ARROWS_0}
        transparency={ARROW_ALPHA}
        noClickThrough
        onHold={() => setScrollY(Math.max(0, scrollY - STEP))}
      />
      <sprite
        y="bottom"
        w="fill"
        h={ARROW}
        sprite={Sprites.SCROLLBAR_TRANS_ARROWS_1}
        transparency={ARROW_ALPHA}
        noClickThrough
        onHold={() => setScrollY(Math.min(Math.max(1, frameH - gutter.height - ARROW * 2), scrollY + STEP))}
      />
    </>
  );
}

function HelperContent(): Component {
  const host = useUniverse();
  const [built] = useState(helperGenericBuilt);
  const [frameW] = useState(helperGenericFrameW);
  const [frameH] = useState(helperGenericFrameH);
  const [ops] = useState(helperGenericOps);
  const [reset] = useState(helperGenericOpReset);
  const [close] = useState(helperGenericOpClose);
  const [disable] = useState(helperGenericOpDisable);
  const [scrollY, setScrollY] = useState(helperGenericScrollY);
  const scrolls: Boolean = frameH > 300;
  const fresh: Boolean = frameH === -1;
  const range: Int = Math.max(1, frameH - (host.height - 8));
  return (
    <layer
      x={{ right: 4 }}
      y={4}
      w={{ fill: fresh ? 22 : scrolls ? 24 : 8 }}
      h={{ fill: 8 }}
      scrollWidth={scrolls ? frameW : 0}
      scrollHeight={scrolls ? frameH : 0}
      scrollY={scrollY}
      onScrollWheel={(event) => {
        setScrollY(scrolls ? Math.clamp(0, range, scrollY + event.mouseY * WHEEL) : 0);
      }}
      optionSubject={ops === 1 ? OP_SUBJECT : ''}
      options={[
        '',
        '',
        '',
        '',
        '',
        fresh ? UNSET_OP : reset === 1 ? 'Reset' : '',
        fresh ? UNSET_OP : close === 1 ? 'Close' : '',
        fresh ? UNSET_OP : disable === 1 ? 'Disable' : '',
      ]}
      onOptionSelect={(event) => helperGenericOption(event.option)}
    >
      {built > 0 && <HelperRow0 />}
      {built > 1 && <HelperRow1 />}
      {built > 2 && <HelperRow2 />}
      {built > 3 && <HelperRow3 />}
      {built > 4 && <HelperRow4 />}
      {built > 5 && <HelperRow5 />}
      {built > 6 && <HelperRow6 />}
      {built > 7 && <HelperRow7 />}
      {built > 8 && <HelperRow8 />}
      {built > 9 && <HelperRow9 />}
      {built > 10 && <HelperRow10 />}
      {built > 11 && <HelperRow11 />}
      {built > 12 && <HelperRow12 />}
      {built > 13 && <HelperRow13 />}
      {built > 14 && <HelperRow14 />}
      {built > 15 && <HelperRow15 />}
      {built > 16 && <HelperRow16 />}
      {built > 17 && <HelperRow17 />}
      {built > 18 && <HelperRow18 />}
      {built > 19 && <HelperRow19 />}
      {built > 20 && <HelperRow20 />}
      {built > 21 && <HelperRow21 />}
      {built > 22 && <HelperRow22 />}
      {built > 23 && <HelperRow23 />}
      {built > 24 && <HelperRow24 />}
      {built > 25 && <HelperRow25 />}
      {built > 26 && <HelperRow26 />}
      {built > 27 && <HelperRow27 />}
      {built > 28 && <HelperRow28 />}
      {built > 29 && <HelperRow29 />}
      {built > 30 && <HelperRow30 />}
      {built > 31 && <HelperRow31 />}
      {built > 32 && <HelperRow32 />}
      {built > 33 && <HelperRow33 />}
      {built > 34 && <HelperRow34 />}
      {built > 35 && <HelperRow35 />}
      {built > 36 && <HelperRow36 />}
      {built > 37 && <HelperRow37 />}
      {built > 38 && <HelperRow38 />}
      {built > 39 && <HelperRow39 />}
      {built > 40 && <HelperRow40 />}
      {built > 41 && <HelperRow41 />}
      {built > 42 && <HelperRow42 />}
      {built > 43 && <HelperRow43 />}
      {built > 44 && <HelperRow44 />}
    </layer>
  );
}

function HelperRowText({ kind, box, text }: { kind: Int; box: Int; text: String }): Component {
  const top: Int = rowBoxTop(box);
  const h: Int = rowBoxHeight(box);
  const w: Int = rowBoxWidth(box);
  if (kind === RowKind.TITLE) {
    return (
      <text
        x={1}
        y={top}
        w={w}
        h={h}
        color={0xffffff}
        font={Fonts.B12_FULL}
        shadow
        align="left"
        valign="middle"
        lineHeight={TITLE_LINE}
        text={text}
      />
    );
  }
  if (kind === RowKind.TITLE_CENTRED) {
    return (
      <text
        x="center"
        y={top}
        w={w}
        h={h}
        color={0xffffff}
        font={Fonts.B12_FULL}
        shadow
        align="center"
        valign="middle"
        lineHeight={TITLE_LINE}
        text={text}
      />
    );
  }
  if (kind === RowKind.TEXT || kind === RowKind.DATA_LEFT) {
    return (
      <text
        x={1}
        y={top}
        w={w}
        h={h}
        color={0xffffff}
        font={Fonts.P12_FULL}
        shadow
        align="left"
        valign="middle"
        lineHeight={BODY_LINE}
        text={text}
      />
    );
  }
  if (kind === RowKind.DATA_RIGHT) {
    return (
      <text
        x={{ right: 1 }}
        y={top}
        w={w}
        h={h}
        color={0xffffff}
        font={Fonts.P12_FULL}
        shadow
        align="right"
        valign="middle"
        lineHeight={BODY_LINE}
        text={text}
      />
    );
  }
  return null;
}

