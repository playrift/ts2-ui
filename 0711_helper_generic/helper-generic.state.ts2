export function rowWidth(row: Int): Int {
  const kind: Int = rowKind(row);
  if (kind === RowKind.NONE) {
    return -1;
  }
  if (kind === RowKind.TITLE || kind === RowKind.TITLE_CENTRED) {
    return Math.min(textWidth(rowText(row), HELPER_MAX_WIDTH, Fonts.B12_FULL), HELPER_MAX_WIDTH);
  }
  if (kind === RowKind.TEXT) {
    return Math.min(textWidth(rowText(row), HELPER_MAX_WIDTH, Fonts.P12_FULL), HELPER_MAX_WIDTH);
  }
  if (kind === RowKind.DATA_LEFT) {
    const left: Int = textWidth(rowText(row), HELPER_MAX_WIDTH / 2, Fonts.P12_FULL);
    const right: Int = textWidth(rowText(row + 1), HELPER_MAX_WIDTH - left, Fonts.P12_FULL);
    return left + right;
  }
  return 0;
}

export function helperGenericReset(): void {
  let row: Int = 0;
  while (row < HELPER_ROWS) {
    setRowKind(row, RowKind.NONE);
    setRowText(row, 'null');
    row = row + 1;
  }
  const [, setBuilt] = useState(helperGenericBuilt);
  const [seq, setSeq] = useState(helperGenericBuildSeq);
  setBuilt(0);
  setSeq(seq + 1);
  const [, setActive] = useState(helperGenericActive);
  setActive(HelperActive.NONE);
  helperGenericSetSize(140, 300);
  const [, setWidth] = useState(helperGenericCurrentWidth);
  const [, setHeight] = useState(helperGenericCurrentHeight);
  const [, setCount] = useState(helperGenericCurrentId);
  setWidth(0);
  setHeight(0);
  setCount(0);
}

export function helperGenericSetSize(width: Int, height: Int): void {
  const container: ComponentId = gameframeSlot(GameframeSlot.HELPER_CONTENT);
  let w: Int = width;
  let h: Int = height;
  const [mask] = useState(helperGenericMask);
  if (container === -1) {
    const [noFrameH, setNoFrameH] = useState(helperGenericFrameH);
    const [, setNoFrameW] = useState(helperGenericFrameW);
    const [, setNoFrameExtent] = useState(helperGenericScrollExtent);
    setNoFrameExtent(h > 300 && noFrameH > 300 ? h : 0);
    setNoFrameW(w);
    setNoFrameH(h);
    return;
  }
  if (hasBit(mask, 0)) {
    if (w < CS2.if_width_get(container)) {
      w = CS2.if_width_get(container);
    }
  }
  if (hasBit(mask, 1)) {
    if (h < CS2.if_height_get(container)) {
      h = CS2.if_height_get(container);
    }
  }
  const [prevH, setFrameH] = useState(helperGenericFrameH);
  const [, setFrameW] = useState(helperGenericFrameW);
  const [, setExtent] = useState(helperGenericScrollExtent);
  setExtent(h > 300 && prevH > 300 ? h : 0);
  const [, setScrollY] = useState(helperGenericScrollY);
  setScrollY(0);
  setFrameW(w);
  setFrameH(h);
  sizeFrame(container, w, h);
}

function sizeFrame(container: ComponentId, frameW: Int, frameH: Int): void {
  if (frameH > 300) {
    CS2.if_size_set(frameW + 14, 300, 0, 0, container);
  } else {
    CS2.if_size_set(frameW, frameH, 0, 0, container);
  }
}

export function helperGenericSetup(reset: Int, close: Int, disable: Int): void {
  helperGenericReset();
  const [, setBits] = useState(helperGenericMask);
  const [, setOps] = useState(helperGenericOps);
  const [, setReset] = useState(helperGenericOpReset);
  const [, setClose] = useState(helperGenericOpClose);
  const [, setDisable] = useState(helperGenericOpDisable);
  setBits(0);
  setOps(1);
  setReset(reset);
  setClose(close);
  setDisable(disable);
}

export function helperGenericClear(): void {
  helperGenericReset();
  const [, setBits] = useState(helperGenericMask);
  const [, setOps] = useState(helperGenericOps);
  const [, setReset] = useState(helperGenericOpReset);
  const [, setClose] = useState(helperGenericOpClose);
  const [, setDisable] = useState(helperGenericOpDisable);
  setBits(0);
  setOps(0);
  setReset(0);
  setClose(0);
  setDisable(0);
}

export function helperGenericSetBit(bit: Int): void {
  const [bits, setBits] = useState(helperGenericMask);
  if (!hasBit(bits, bit)) {
    setBits(bits + Math.pow(2, bit));
  }
}

function addRow(kind: Int, text: String): Int {
  const [count, setCount] = useState(helperGenericCurrentId);
  const row: Int = count;
  if (row >= HELPER_ROWS) {
    return 0;
  }
  setRowKind(row, kind);
  setRowText(row, text);
  setCount(row + 1);
  return row;
}

export function helperGenericAddTitle(text: String, centred: Int): Int {
  if (centred === 1) {
    return addRow(RowKind.TITLE_CENTRED, text);
  }
  return addRow(RowKind.TITLE, text);
}

export function helperGenericAddText(text: String): Int {
  return addRow(RowKind.TEXT, text);
}

export function helperGenericAddData(label: String, value: String): Int {
  const [count] = useState(helperGenericCurrentId);
  if (count >= HELPER_ROWS - 1) {
    return 0;
  }
  const left: Int = addRow(RowKind.DATA_LEFT, label);
  addRow(RowKind.DATA_RIGHT, value);
  return left;
}

export function helperGenericBuildUi(): void {
  const [count] = useState(helperGenericCurrentId);
  let width: Int = 0;
  let row: Int = 0;
  while (row < count) {
    const wanted: Int = rowWidth(row);
    if (width < wanted) {
      width = Math.min(wanted, HELPER_MAX_WIDTH);
    }
    if (rowKind(row) === RowKind.DATA_LEFT) {
      row = row + 2;
    } else {
      row = row + 1;
    }
  }
  let height: Int = 1;
  row = 0;
  while (row < count) {
    const kind: Int = rowKind(row);
    if (kind === RowKind.TITLE || kind === RowKind.TITLE_CENTRED) {
      const titleH: Int = titleHeight(row, width);
      setRowBox(row, packRowBox(height, titleH, width));
      height = height + titleH + 2;
      row = row + 1;
    } else if (kind === RowKind.TEXT) {
      const textH: Int = textHeight(row, width);
      setRowBox(row, packRowBox(height, textH - (textH % 14), width));
      height = height + textH;
      row = row + 1;
    } else if (kind === RowKind.DATA_LEFT) {
      const dataH: Int = dataHeight(row);
      setRowBox(row, packRowBox(height, dataH, dataLeftWidth(row)));
      setRowBox(row + 1, packRowBox(height, dataH, dataRightWidth(row)));
      height = height + dataH;
      row = row + 2;
    } else {
      row = row + 1;
    }
  }
  height = 2 + height;
  const [, setWidth] = useState(helperGenericCurrentWidth);
  const [, setHeight] = useState(helperGenericCurrentHeight);
  const [, setBuilt] = useState(helperGenericBuilt);
  const [seq, setSeq] = useState(helperGenericBuildSeq);
  setWidth(width);
  setHeight(height);
  setBuilt(count);
  setSeq(seq + 1);
  helperGenericSetSize(width + 8 + 1 * 2, height + 8);
}

export function titleHeight(row: Int, width: Int): Int {
  return textLineCount(rowText(row), width, Fonts.B12_FULL) * 15;
}

export function textHeight(row: Int, width: Int): Int {
  const lines: Int = textLineCount(rowText(row), width, Fonts.P12_FULL) * 14;
  if (rowKind(row + 1) === RowKind.TITLE) {
    return lines + 4;
  }
  return lines;
}

export function dataLeftWidth(row: Int): Int {
  return textWidth(rowText(row), HELPER_MAX_WIDTH / 2, Fonts.P12_FULL);
}

export function dataRightWidth(row: Int): Int {
  return textWidth(rowText(row + 1), HELPER_MAX_WIDTH - dataLeftWidth(row), Fonts.P12_FULL);
}

export function dataHeight(row: Int): Int {
  const left: Int = textLineCount(rowText(row), dataLeftWidth(row), Fonts.P12_FULL) * 14;
  const right: Int = textLineCount(rowText(row + 1), dataRightWidth(row), Fonts.P12_FULL) * 14;
  return Math.max(left, right);
}

export function helperGenericUpdateText(row: Int, text: String): void {
  const [count] = useState(helperGenericCurrentId);
  if (row < count) {
    setRowText(row, text);
  }
  helperGenericBuildUi();
}

export function helperGenericOption(option: Int): void {
  if (option === 6) {
    const helper: Int = useServerState(Varbits.CURRENT_HELPER);
    if (helper === 4) {
      helperGenericReset();
    }
  }
}

export function helperGenericTest(): void {
  helperGenericSetup(1, 1, 1);
  helperGenericAddTitle('Helper Test', 0);
  helperGenericAddData('Dig: ', '<col=00ff00>0,49,21,38,21</col>');
  helperGenericAddData('Obnoxiously Long Descriptor: ', 'And same for data.');
  helperGenericAddText("Don't forget to bring a <col=ff0000> spade</col>.");
  helperGenericBuildUi();
}
