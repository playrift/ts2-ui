export function packRowBox(top: Int, height: Int, width: Int): Int {
  return top * 262144 + height * 256 + width;
}

export function rowBoxTop(box: Int): Int {
  return box / 262144;
}

export function rowBoxHeight(box: Int): Int {
  return (box / 256) % 1024;
}

export function rowBoxWidth(box: Int): Int {
  return box % 256;
}

