export function diariesTotal(): Int {
  return (
    regionTotal(
      DiaryTaskTotals.KARAMJA.easy,
      DiaryTaskTotals.KARAMJA.medium,
      DiaryTaskTotals.KARAMJA.hard,
      DiaryTaskTotals.KARAMJA.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.ARDOUGNE.easy,
      DiaryTaskTotals.ARDOUGNE.medium,
      DiaryTaskTotals.ARDOUGNE.hard,
      DiaryTaskTotals.ARDOUGNE.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.FALADOR.easy,
      DiaryTaskTotals.FALADOR.medium,
      DiaryTaskTotals.FALADOR.hard,
      DiaryTaskTotals.FALADOR.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.WILDERNESS.easy,
      DiaryTaskTotals.WILDERNESS.medium,
      DiaryTaskTotals.WILDERNESS.hard,
      DiaryTaskTotals.WILDERNESS.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.WESTERN.easy,
      DiaryTaskTotals.WESTERN.medium,
      DiaryTaskTotals.WESTERN.hard,
      DiaryTaskTotals.WESTERN.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.KANDARIN.easy,
      DiaryTaskTotals.KANDARIN.medium,
      DiaryTaskTotals.KANDARIN.hard,
      DiaryTaskTotals.KANDARIN.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.DESERT.easy,
      DiaryTaskTotals.DESERT.medium,
      DiaryTaskTotals.DESERT.hard,
      DiaryTaskTotals.DESERT.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.MORYTANIA.easy,
      DiaryTaskTotals.MORYTANIA.medium,
      DiaryTaskTotals.MORYTANIA.hard,
      DiaryTaskTotals.MORYTANIA.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.FREMENNIK.easy,
      DiaryTaskTotals.FREMENNIK.medium,
      DiaryTaskTotals.FREMENNIK.hard,
      DiaryTaskTotals.FREMENNIK.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.LUMBRIDGE.easy,
      DiaryTaskTotals.LUMBRIDGE.medium,
      DiaryTaskTotals.LUMBRIDGE.hard,
      DiaryTaskTotals.LUMBRIDGE.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.VARROCK.easy,
      DiaryTaskTotals.VARROCK.medium,
      DiaryTaskTotals.VARROCK.hard,
      DiaryTaskTotals.VARROCK.elite,
    ) +
    regionTotal(
      DiaryTaskTotals.KOUREND.easy,
      DiaryTaskTotals.KOUREND.medium,
      DiaryTaskTotals.KOUREND.hard,
      DiaryTaskTotals.KOUREND.elite,
    )
  );
}

function regionTotal(easy: Int, medium: Int, hard: Int, elite: Int): Int {
  return easy + medium + hard + elite;
}

export function combatTasksCompleted(): Int {
  return (
    useServerState(CombatTaskVarbits.EASY) +
    useServerState(CombatTaskVarbits.MEDIUM) +
    useServerState(CombatTaskVarbits.HARD) +
    useServerState(CombatTaskVarbits.ELITE) +
    useServerState(CombatTaskVarbits.MASTER) +
    useServerState(CombatTaskVarbits.GRANDMASTER)
  );
}

export function combatTasksTotal(): Int {
  const groupSize: Int = useServerState(SummaryVarbits.GIM_GROUPSIZE);
  const ironman: Int = useServerState(SummaryVarbits.IRONMAN);
  const total: Int =
    CombatTaskCounts.EASY +
    CombatTaskCounts.MEDIUM +
    CombatTaskCounts.HARD +
    CombatTaskCounts.ELITE +
    CombatTaskCounts.MASTER +
    CombatTaskCounts.GRANDMASTER;
  if (!isGroupIronman(ironman)) {
    return total;
  }
  return (
    total -
    excludedForSize(
      groupSize,
      GroupIronExcludedElite.SIZE2,
      GroupIronExcludedElite.SIZE3,
      GroupIronExcludedElite.SIZE4,
      GroupIronExcludedElite.SIZE5,
    ) -
    excludedForSize(
      groupSize,
      GroupIronExcludedMaster.SIZE2,
      GroupIronExcludedMaster.SIZE3,
      GroupIronExcludedMaster.SIZE4,
      GroupIronExcludedMaster.SIZE5,
    ) -
    excludedForSize(
      groupSize,
      GroupIronExcludedGrandmaster.SIZE2,
      GroupIronExcludedGrandmaster.SIZE3,
      GroupIronExcludedGrandmaster.SIZE4,
      GroupIronExcludedGrandmaster.SIZE5,
    )
  );
}

function excludedForSize(groupSize: Int, size2: Int, size3: Int, size4: Int, size5: Int): Int {
  if (groupSize === 2) {
    return size2;
  }
  if (groupSize === 3) {
    return size3;
  }
  if (groupSize === 4) {
    return size4;
  }
  if (groupSize === 5) {
    return size5;
  }
  return 0;
}
