import { CS2, useServerState, useSkillBase } from 'ts2';

import { isGroupIronman } from '../0551_raids_storage_side/raids-storage-side.helpers';
import { Varbits } from '../lib/game/varbits';
import { groupDigits, padGroup } from '../lib/lib.format';
import {
  CombatTaskCounts,
  DiaryTaskTotals,
  GroupIronExcludedElite,
  GroupIronExcludedGrandmaster,
  GroupIronExcludedMaster,
} from './account-summary-sidepanel.data';
import { Copy, CombatTaskVarbits, Layout, Skills, SummaryVarbits } from './account-summary-sidepanel.constants';

export function writePlayerName(target: ComponentId): void {
  target.text = CS2.chat_playername();
}

export function sailingRestricted(): Boolean {
  if (useServerState(SummaryVarbits.SAILING_RESTRICTED) >= 1) {
    return true;
  }
  return false;
}

export function totalLevel(): Int {
  const base: Int =
    useSkillBase(Skills.ATTACK) +
    useSkillBase(Skills.DEFENCE) +
    useSkillBase(Skills.STRENGTH) +
    useSkillBase(Skills.HITPOINTS) +
    useSkillBase(Skills.RANGED) +
    useSkillBase(Skills.PRAYER) +
    useSkillBase(Skills.MAGIC) +
    useSkillBase(Skills.COOKING) +
    useSkillBase(Skills.WOODCUTTING) +
    useSkillBase(Skills.FLETCHING) +
    useSkillBase(Skills.FISHING) +
    useSkillBase(Skills.FIREMAKING) +
    useSkillBase(Skills.CRAFTING) +
    useSkillBase(Skills.SMITHING) +
    useSkillBase(Skills.MINING) +
    useSkillBase(Skills.HERBLORE) +
    useSkillBase(Skills.AGILITY) +
    useSkillBase(Skills.THIEVING) +
    useSkillBase(Skills.SLAYER) +
    useSkillBase(Skills.FARMING) +
    useSkillBase(Skills.RUNECRAFT) +
    useSkillBase(Skills.HUNTER) +
    useSkillBase(Skills.CONSTRUCTION);
  if (sailingRestricted()) {
    return base;
  }
  return base + useSkillBase(Skills.SAILING);
}

export function totalXpText(): String {
  let low: Int = 0;
  let high: Int = 0;
  low = low + xpOf(Skills.ATTACK);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.DEFENCE);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.STRENGTH);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HITPOINTS);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.RANGED);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.PRAYER);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.MAGIC);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.COOKING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.WOODCUTTING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FLETCHING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FISHING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FIREMAKING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.CRAFTING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SMITHING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.MINING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HERBLORE);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.AGILITY);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.THIEVING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SLAYER);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.FARMING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.RUNECRAFT);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.HUNTER);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.CONSTRUCTION);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }
  low = low + xpOf(Skills.SAILING);
  while (low >= Layout.XP_BILLION) {
    low = low - Layout.XP_BILLION;
    high = high + 1;
  }

  if (high > 0) {
    return `${groupDigits(high, Copy.SEPARATOR)}${Copy.SEPARATOR}${padGroup(low / 1000000)}${Copy.SEPARATOR}${padGroup((low % 1000000) / 1000)}${Copy.SEPARATOR}${padGroup(low % 1000)}`;
  }
  return groupDigits(low, Copy.SEPARATOR);
}

function xpOf(skill: SkillRef<number>): Int {
  if (skill === Skills.SAILING && sailingRestricted()) {
    return 0;
  }
  return CS2.skill_visible_xp(skill);
}

