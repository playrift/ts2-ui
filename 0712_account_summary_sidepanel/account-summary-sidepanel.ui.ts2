import { buttonSelectSound } from '../0656_league_side_panel/league-side-panel.state';
import {
  CLICK_TRANSPARENCY,
  CollectionsTile,
  CombatLevelTile,
  CombatTasksTile,
  DiariesTile,
  QuestsTile,
  TimePlayedClick,
  TimePlayedRow,
  TotalLevelTile,
  TotalXpRow,
} from './summary-rows.component';
import {
  Layout,
  Ops,
  SummaryColor,
  SummaryFonts,
  accountSummaryRef,
  clickLayerRef,
  contentsRef,
  playerNameRef,
} from './account-summary-sidepanel.constants';
import { writePlayerName } from './account-summary-sidepanel.helpers';

export const accountSummarySidepanelUi = (): UI => (
  <ui ref={accountSummaryRef} w={Layout.PANEL_W} h={Layout.PANEL_H}>
    <AccountSummarySidepanel />
  </ui>
);

function AccountSummarySidepanel(): Component {
  return (
    <>
      <text
        ref={playerNameRef}
        x={Layout.NAME_X}
        y={0}
        w={{ fill: Layout.NAME_INSET_W }}
        h={Layout.NAME_H}
        text=""
        font={SummaryFonts.NAME}
        color={SummaryColor.NAME}
        align="center"
        valign="middle"
        shadow
        onLoad={(event) => writePlayerName(event.component)}
      />

      <layer ref={contentsRef} x={0} y={Layout.BODY_Y} w="fill" h={{ fill: Layout.BODY_INSET_H }}>
        <layer x={0} y={Layout.ROW1_Y} w={Layout.COLUMN_W} h={Layout.ROW1_H + Layout.ETCH_OVERHANG}>
          <CombatLevelTile />
        </layer>
        <layer x={Layout.COLUMN2_X} y={Layout.ROW1_Y} w={Layout.COLUMN_W} h={Layout.ROW1_H + Layout.ETCH_OVERHANG}>
          <TotalLevelTile />
        </layer>
        <layer x={0} y={Layout.ROW2_Y} w={Layout.BODY_W} h={Layout.ROW2_H + Layout.ETCH_OVERHANG}>
          <TotalXpRow />
        </layer>
        <layer x={0} y={Layout.ROW3_Y} w={Layout.COLUMN_W} h={Layout.ROW3_H + Layout.ETCH_OVERHANG}>
          <QuestsTile />
        </layer>
        <layer x={Layout.COLUMN2_X} y={Layout.ROW3_Y} w={Layout.COLUMN_W} h={Layout.ROW3_H + Layout.ETCH_OVERHANG}>
          <DiariesTile />
        </layer>
        <layer x={0} y={Layout.ROW4_Y} w={Layout.COLUMN_W} h={Layout.ROW4_H + Layout.ETCH_OVERHANG}>
          <CombatTasksTile />
        </layer>
        <layer x={Layout.COLUMN2_X} y={Layout.ROW4_Y} w={Layout.COLUMN_W} h={Layout.ROW4_H + Layout.ETCH_OVERHANG}>
          <CollectionsTile />
        </layer>
        <layer x={0} y={Layout.ROW5_Y} w={Layout.BODY_W} h={Layout.ROW5_H + Layout.ETCH_OVERHANG}>
          <TimePlayedRow />
        </layer>
      </layer>

      <layer ref={clickLayerRef} x={0} y={Layout.BODY_Y} w="fill" h={{ fill: Layout.BODY_INSET_H }}>
        <rect x={0} y={Layout.ROW1_Y} w={Layout.COLUMN_W} h={Layout.ROW1_H} transparency={CLICK_TRANSPARENCY} />
        <rect
          x={Layout.COLUMN2_X}
          y={Layout.ROW1_Y}
          w={Layout.COLUMN_W}
          h={Layout.ROW1_H}
          transparency={CLICK_TRANSPARENCY}
        />
        <rect x={0} y={Layout.ROW2_Y} w={Layout.BODY_W} h={Layout.ROW2_H} transparency={CLICK_TRANSPARENCY} />
        <rect
          x={0}
          y={Layout.ROW3_Y}
          w={Layout.COLUMN_W}
          h={Layout.ROW3_H}
          transparency={CLICK_TRANSPARENCY}
          options={[Ops.QUEST_LIST]}
          onOptionSelect={() => buttonSelectSound()}
        />
        <rect
          x={Layout.COLUMN2_X}
          y={Layout.ROW3_Y}
          w={Layout.COLUMN_W}
          h={Layout.ROW3_H}
          transparency={CLICK_TRANSPARENCY}
          options={[Ops.DIARIES]}
          onOptionSelect={() => buttonSelectSound()}
        />
        <rect
          x={0}
          y={Layout.ROW4_Y}
          w={Layout.COLUMN_W}
          h={Layout.ROW4_H}
          transparency={CLICK_TRANSPARENCY}
          options={[Ops.CA_OVERVIEW, Ops.CA_BOSSES, Ops.CA_TASKS, Ops.CA_REWARDS]}
          onOptionSelect={() => buttonSelectSound()}
        />
        <rect
          x={Layout.COLUMN2_X}
          y={Layout.ROW4_Y}
          w={Layout.COLUMN_W}
          h={Layout.ROW4_H}
          transparency={CLICK_TRANSPARENCY}
          options={[Ops.COLLECTION_LOG, Ops.COLLECTION_OVERVIEW]}
          onOptionSelect={() => buttonSelectSound()}
        />
        <layer x={0} y={Layout.ROW5_Y} w={Layout.BODY_W} h={Layout.ROW5_H}>
          <TimePlayedClick />
        </layer>
      </layer>
    </>
  );
}
