import { EtchedBox } from '../0656_league_side_panel/etched-box.component';
import { textWidth } from '../lib/lib.engine';
import { Layout, SummaryColor, SummaryFonts } from './account-summary-sidepanel.constants';

export function SummaryRow({
  text,
  icon = -1,
  height,
  hovered = 0,
}: {
  text: String;
  icon?: Sprite;
  height: Int;
  hovered?: Int;
}): Component {
  const textWidthPx: Int = textWidth(text, Layout.BODY_W, SummaryFonts.BODY);
  const iconX: Int = Layout.BODY_W / 2 - (textWidthPx + Layout.ICON + Layout.ICON_GAP) / 2;
  const color: Int = hovered === 1 ? SummaryColor.HOVER : SummaryColor.LABEL;

  if (icon === -1) {
    return (
      <layer w="fill" h="fill">
        <EtchedBox x={0} y={0} w={Layout.BODY_W} h={height} />
        <text
          x={0}
          y={1}
          w="fill"
          h={height}
          text={text}
          font={SummaryFonts.BODY}
          color={color}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill">
      <EtchedBox x={0} y={0} w={Layout.BODY_W} h={height} />
      <text
        x={iconX + Layout.ICON + Layout.ICON_GAP}
        y={2}
        w="fill"
        h={height}
        text={text}
        font={SummaryFonts.BODY}
        color={color}
        align="left"
        valign="middle"
        shadow
      />
      <sprite x={iconX} y={(height - Layout.ICON) / 2 + 1} w={Layout.ICON} h={Layout.ICON} sprite={icon} />
    </layer>
  );
}
