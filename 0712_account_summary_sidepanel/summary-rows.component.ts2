export function TimePlayedRow(): Component {
  const [hovered, setHovered] = useState(0);
  const [playtime] = useState(accountSummaryPlaytime);
  const shown: Int = useServerState(SummaryVarbits.DISPLAY_PLAYTIME);
  const mobile: Boolean = onMobile();

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => {
        setHovered(0);
      }}
    >
      <SummaryRow
        text={
          shown === 1
            ? `${Copy.TIME_PLAYED} <col=0dc10d>${minutesAsText(playtime, 1)}</col>`
            : mobile
              ? `${Copy.TIME_PLAYED} ${Copy.REVEAL_MOBILE}`
              : `${Copy.TIME_PLAYED} ${Copy.REVEAL_DESKTOP}`
        }
        height={Layout.ROW5_H}
        hovered={hovered}
      />
    </layer>
  );
}

export function TimePlayedClick(): Component {
  const shown: Int = useServerState(SummaryVarbits.DISPLAY_PLAYTIME);
  return (
    <rect
      w="fill"
      h="fill"
      transparency={CLICK_TRANSPARENCY}
      options={[shown === 1 ? Ops.HIDE : Ops.REVEAL]}
      onOptionSelect={() => buttonSelectSound()}
    />
  );
}

export const CLICK_TRANSPARENCY = 255;
