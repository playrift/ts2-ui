import { useServerState, useState } from 'ts2';

import { speedrunningWorld } from '../0134_settings/settings.helpers';
import { minutesAsText } from '../0378_welcome_screen/welcome-screen.helpers';
import { groupDigits } from '../lib/lib.format';
import { buttonSelectSound } from '../0656_league_side_panel/league-side-panel.state';
import { onMobile } from '../lib/lib.helpers';
import { accountSummaryPlaytime, combatLevel } from '../lib/game/varcs';
import { Copy, Layout, Ops, SummaryIcons, SummaryVarbits, SummaryVarps } from './account-summary-sidepanel.constants';
import {
  combatTasksCompleted,
  combatTasksTotal,
  diariesCompleted,
  diariesTotal,
  totalLevel,
  totalXpText,
} from './account-summary-sidepanel.helpers';
import { SummaryRow } from './summary-row.component';
import { SummaryTile } from './summary-tile.component';

export function CombatLevelTile(): Component {
  const [combat] = useState(combatLevel);
  return (
    <SummaryTile
      label={Copy.COMBAT_LEVEL}
      value={`<col=0dc10d>${combat}</col>`}
      icon={SummaryIcons.COMBAT}
      height={Layout.ROW1_H}
    />
  );
}

export function TotalLevelTile(): Component {
  const total: Int = totalLevel();
  const value: String = `<col=0dc10d>${total}</col>`;
  return <SummaryTile label={Copy.TOTAL_LEVEL} value={value} icon={SummaryIcons.TOTAL_LEVEL} height={Layout.ROW1_H} />;
}

export function TotalXpRow(): Component {
  const xp: String = totalXpText();
  return (
    <SummaryRow text={`${Copy.TOTAL_XP} <col=0dc10d>${xp}</col>`} icon={SummaryIcons.TOTAL_XP} height={Layout.ROW2_H} />
  );
}

export function QuestsTile(): Component {
  const [hovered, setHovered] = useState(0);
  const speedrun: Boolean = speedrunningWorld();
  const points: Int = Math.min(useServerState(SummaryVarps.SPEEDRUN_POINTS), Layout.SPEEDRUN_CAP);
  const done: Int = useServerState(SummaryVarbits.QUESTS_COMPLETED);
  const outOf: Int = useServerState(SummaryVarbits.QUESTS_TOTAL);

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => {
        setHovered(0);
      }}
    >
      <SummaryTile
        label={speedrun ? Copy.SPEEDRUN_POINTS : Copy.QUESTS}
        value={
          speedrun ? `<col=0dc10d>${groupDigits(points, Copy.SEPARATOR)}</col>` : `<col=0dc10d>${done}/${outOf}</col>`
        }
        icon={SummaryIcons.QUESTS}
        height={Layout.ROW3_H}
        hovered={hovered}
      />
    </layer>
  );
}

