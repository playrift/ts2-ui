export function CollectionsTile(): Component {
  const [hovered, setHovered] = useState(0);
  const done: Int = useServerState(SummaryVarps.COLLECTION_COUNT);
  const outOf: Int = useServerState(SummaryVarps.COLLECTION_COUNT_MAX);

  return (
    <layer
      w="fill"
