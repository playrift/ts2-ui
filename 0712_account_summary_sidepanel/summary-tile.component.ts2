import { EtchedBox } from '../0656_league_side_panel/etched-box.component';
import { textLineCount, textWidth } from '../lib/lib.engine';
import { Layout, SummaryColor, SummaryFonts } from './account-summary-sidepanel.constants';

export function SummaryTile({
  label,
  value,
  icon,
  height,
  hovered = 0,
}: {
  label: String;
  value: String;
  icon: Sprite;
  height: Int;
  hovered?: Int;
}): Component {
  const valueWidth: Int = textWidth(value, Layout.BODY_W, SummaryFonts.BODY);
  const labelHeight: Int = textLineCount(label, Layout.LABEL_W, SummaryFonts.BODY) * Layout.LINE_H;
  const iconX: Int = Layout.COLUMN_W / 2 - (valueWidth + Layout.ICON + Layout.ICON_GAP) / 2;

  return (
    <layer w="fill" h="fill">
      <EtchedBox x={0} y={0} w={Layout.COLUMN_W} h={height} />
      <text
        x={Layout.LABEL_X}
        y={Layout.LABEL_Y}
        w={Layout.LABEL_W}
        h={height}
        text={label}
        font={SummaryFonts.BODY}
        color={hovered === 1 ? SummaryColor.HOVER : SummaryColor.LABEL}
        align="center"
        valign="top"
        shadow
      />
      <text
        x={iconX + Layout.ICON + Layout.ICON_GAP}
        y={labelHeight + Layout.VALUE_DY}
        w={valueWidth}
        h={height - labelHeight}
        text={value}
        font={SummaryFonts.BODY}
        align="left"
        valign="top"
        shadow
      />
      <sprite x={iconX} y={labelHeight + Layout.ICON_DY} w={Layout.ICON} h={Layout.ICON} sprite={icon} />
    </layer>
  );
}
