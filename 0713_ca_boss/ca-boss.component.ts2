import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { SteelborderColor } from '../lib/lib.constants';
import { SteelBorder } from '../lib/steel-border.component';
import { CaBurgerMenu } from '../0716_ca_bosses/ca-shared.burger';
import { CaColour, CaFont, CaView } from '../0716_ca_bosses/ca-shared.constants';
import { CaBosses } from '../0716_ca_bosses/ca-shared.data';
import { CaTasksProgressBar, CaTierBarMode } from '../0716_ca_bosses/ca-shared.progress';

import { CaBossButtonKind, CaBossIconButton, CaBossStats } from './ca-boss-buttons.component';
import { CaBossModel, caBossModelInit } from './ca-boss-model.component';
import { CaBossTabPane, CaBossTabs, caBossTabsInit } from './ca-boss-tabs.component';
import { CaBossArt, CaBossColour, CaBossLayout, CaBossText } from './ca-boss.constants';

export function CaBoss(): Component {
  return (
    <>
      <layer x="center" y="center" w={CaBossLayout.PANEL_W} h={CaBossLayout.PANEL_H}>
        <layer x={0} y={0} w={CaBossLayout.PANEL_W} h={CaBossLayout.PANEL_H}>
          <CaBossFrame />
        </layer>

        <layer x={CaBossLayout.NAME_X} y={CaBossLayout.NAME_Y} w={CaBossLayout.NAME_W} h={CaBossLayout.NAME_H}>
          <CaBossName />
        </layer>

        <layer
          x={{ right: CaBossLayout.WIKI_RIGHT }}
          y={CaBossLayout.BUTTON_Y}
          w={CaBossLayout.BUTTON_W}
          h={CaBossLayout.BUTTON_H}
        >
          <CaBossIconButton kind={CaBossButtonKind.WIKI} />
          <sprite
            x="center"
            y="center"
            w={CaBossLayout.WIKI_ICON_W}
            h={CaBossLayout.WIKI_ICON_H}
            sprite={CaBossArt.WIKI_ICON}
          />
        </layer>

        <layer
          x={{ right: CaBossLayout.MAP_RIGHT }}
          y={CaBossLayout.BUTTON_Y}
          w={CaBossLayout.BUTTON_W}
          h={CaBossLayout.BUTTON_H}
        >
          <CaBossIconButton kind={CaBossButtonKind.MAP} />
          <sprite
            x="center"
            y="center"
            w={CaBossLayout.MAP_ICON_SIZE}
            h={CaBossLayout.MAP_ICON_SIZE}
            sprite={CaBossArt.MAP_ICON}
          />
        </layer>

        <layer
          x={{ right: CaBossLayout.COLLECTION_RIGHT }}
          y={CaBossLayout.BUTTON_Y}
          w={CaBossLayout.BUTTON_W}
          h={CaBossLayout.BUTTON_H}
        >
          <CaBossIconButton kind={CaBossButtonKind.COLLECTION} />
          <sprite
            x="center"
            y="center"
            w={CaBossLayout.COLLECTION_ICON_SIZE}
            h={CaBossLayout.COLLECTION_ICON_SIZE}
            sprite={CaBossArt.COLLECTION_ICON}
          />
        </layer>

        <layer x={CaBossLayout.INFO_X} y={CaBossLayout.INFO_Y} w={CaBossLayout.INFO_W} h={CaBossLayout.INFO_H}>
          <rect x={0} y={0} w="fill" h="fill" color={CaBossColour.BOX_OUTER} />
          <rect
            x={CaBossLayout.BOX_INNER_INSET}
            y={CaBossLayout.BOX_INNER_INSET}
            w={{ fill: CaBossLayout.BOX_INNER_INSET * 2 }}
            h={{ fill: CaBossLayout.BOX_INNER_INSET * 2 }}
            color={CaBossColour.BOX_INNER}
          />
          <CaBossTabPane />
        </layer>

        <layer
          x={CaBossLayout.TABS_X}
          y={CaBossLayout.TABS_Y}
          w={CaBossLayout.TABS_W}
          h={CaBossLayout.TABS_H}
          onLoad={() => caBossTabsInit()}
        >
          <CaBossTabs />
        </layer>

        <layer
          x={{ right: CaBossLayout.MODEL_RIGHT }}
          y={CaBossLayout.MODEL_Y}
          w={CaBossLayout.MODEL_W}
          h={CaBossLayout.MODEL_H}
        >
          <rect x="center" y="center" w="fill" h="fill" color={CaBossColour.BOX_OUTER} />
          <rect
            x={CaBossLayout.BOX_INNER_INSET}
            y={CaBossLayout.BOX_INNER_INSET}
            w={{ fill: CaBossLayout.BOX_INNER_INSET * 2 }}
            h={{ fill: CaBossLayout.BOX_INNER_INSET * 2 }}
            color={CaBossColour.BOX_INNER}
          />
          <sprite
            x={CaBossLayout.BOX_CONTENT_INSET}
            y={CaBossLayout.BOX_CONTENT_INSET}
            w={{ fill: CaBossLayout.BOX_CONTENT_INSET * 2 }}
            h={{ fill: CaBossLayout.BOX_CONTENT_INSET * 2 }}
            sprite={CaBossArt.MODEL_BACKDROP}
            transparency={CaBossLayout.MODEL_BACKDROP_ALPHA}
          />
          <layer
            x={CaBossLayout.BOX_CONTENT_INSET}
            y={CaBossLayout.BOX_CONTENT_INSET}
            w={{ fill: CaBossLayout.BOX_CONTENT_INSET * 2 }}
            h={{ fill: CaBossLayout.BOX_CONTENT_INSET * 2 }}
            onLoad={() => caBossModelInit()}
          >
            <CaBossModel />
          </layer>
        </layer>

        <layer
          x={{ right: CaBossLayout.STATS_RIGHT }}
          y={{ bottom: CaBossLayout.STATS_BOTTOM }}
          w={CaBossLayout.STATS_W}
          h={{ fill: CaBossLayout.STATS_INSET_H }}
        >
          <CaBossStats />
        </layer>

        <layer
          x="center"
          y={CaBossLayout.TIER_BAR_Y}
          w={{ fill: CaBossLayout.TIER_BAR_INSET_W }}
          h={CaBossLayout.TIER_BAR_H}
          options={['']}
        >
          <CaTasksProgressBar mode={CaTierBarMode.BOSS} />
        </layer>

        <layer w="fill" h="fill">
          <CaBurgerMenu current={CaView.NONE} />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill" />
    </>
  );
}

function CaBossFrame(): Component {
  const row = CaBosses.get(useServerState(Varbits.CA_BOSS_SELECTED));
  const title: String = row === null ? CaBossText.TITLE_FALLBACK : CaBossText.TITLE_PREFIX.concat(row.name);
  return <SteelBorder title={title} titleColor={SteelborderColor.TITLE} flags={0} />;
}

function CaBossName(): Component {
  const row = CaBosses.get(useServerState(Varbits.CA_BOSS_SELECTED));
  const name: String = row === null ? '0' : row.name;
  return (
    <text
      x="center"
      y={{ center: CaBossLayout.NAME_TEXT_DY }}
      w={{ fill: CaBossLayout.NAME_TEXT_INSET_W }}
      h={{ fill: CaBossLayout.NAME_TEXT_INSET_H }}
      text={name}
      font={CaFont.BOLD}
      shadow
      color={CaColour.AMBER}
      align="left"
      valign="middle"
    />
  );
}
