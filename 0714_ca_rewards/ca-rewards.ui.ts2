import { createRef } from 'ts2';

import { CaRewardsPanel, caRewardsRef } from './ca-rewards.component';
import { CaRewardsTooltip } from './ca-rewards-tooltip.component';
import { Layout } from './ca-rewards.constants';

export const caRewardsTooltipRef = createRef('ca_rewards:tooltip');

export const caRewardsUi = (): UI => (
  <ui ref={caRewardsRef} w={Layout.ROOT_W} h="fill" x="center">
    <CaRewardsPanel />
    <layer ref={caRewardsTooltipRef} x="center" y="center" w="fill" h="fill">
      <CaRewardsTooltip />
    </layer>
  </ui>
);
