import { CaTask, CaTaskList } from './ca-tasks.data';

export function caTierStatus(tier: Int): Int {
  switch (tier) {
    case 1:
      return useServerState(Varbits.CA_TIER_STATUS_EASY);
    case 2:
      return useServerState(Varbits.CA_TIER_STATUS_MEDIUM);
    case 3:
      return useServerState(Varbits.CA_TIER_STATUS_HARD);
    case 4:
      return useServerState(Varbits.CA_TIER_STATUS_ELITE);
    case 5:
      return useServerState(Varbits.CA_TIER_STATUS_MASTER);
    case 6:
      return useServerState(Varbits.CA_TIER_STATUS_GRANDMASTER);
    default:
      return -1;
  }
}

export function caTaskIsDisabled(task: CaTask, groupSize: Int): Int {
  if (groupSize <= 1 || groupSize > 5) {
    return 0;
  }
  if (groupSize <= task.gimGroupLimit) {
    return 1;
  }
  return 0;
}

export function caTasksBossTotal(monster: Int, groupSize: Int): Int {
  if (monster === 0) {
    return 0;
  }
  let total: Int = 0;
  let i: Int = 0;
  while (i < CaTaskList.length) {
    const task: CaTask | null = CaTaskList.at(i);
    if (task !== null && task.monster === monster && caTaskIsDisabled(task, groupSize) === 0) {
      total = total + 1;
    }
    i = i + 1;
  }
  return total;
}

