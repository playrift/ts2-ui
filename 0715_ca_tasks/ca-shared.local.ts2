export const enum CaBarMode {
  TIER = 0,
  BOSS = 1,
  ALL = 2,
}

export function CaTasksProgressBar({ mode, groupSize }: { mode: Int; groupSize: Int }): Component {
  const points: Int = useServerState(Varbits.CA_POINTS);
  const easy: Int = useServerState(Varbits.CA_THRESHOLD_EASY);
  const medium: Int = useServerState(Varbits.CA_THRESHOLD_MEDIUM);
  const hard: Int = useServerState(Varbits.CA_THRESHOLD_HARD);
  const elite: Int = useServerState(Varbits.CA_THRESHOLD_ELITE);
  const master: Int = useServerState(Varbits.CA_THRESHOLD_MASTER);
  const grandmaster: Int = useServerState(Varbits.CA_THRESHOLD_GRANDMASTER);

  let reached: Int = 0;
  let toNext: Int = 0;
  let found: Int = 0;
  if (found === 0) {
    if (points < easy) {
      toNext = easy - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }
  if (found === 0) {
    if (points < medium) {
      toNext = medium - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }
  if (found === 0) {
    if (points < hard) {
      toNext = hard - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }
  if (found === 0) {
    if (points < elite) {
      toNext = elite - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }
  if (found === 0) {
    if (points < master) {
      toNext = master - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }
  if (found === 0) {
    if (points < grandmaster) {
      toNext = grandmaster - points;
      found = 1;
    } else {
      reached = reached + 1;
    }
  }

  let pending: Int = 0;
  let tier: Int = 0;
  while (tier < 6) {
    if (caTierStatus(tier) === 1) {
      pending = 1;
    }
    tier = tier + 1;
  }

  const top: Int = Math.max(1, grandmaster);

  const host = useUniverse();
  const width: Int = host.width;
  const inner: Int = width - 4;

  let font: Font = CaFont.BODY;
  let caption: String = '';
  if (pending === 1) {
    font = CaFont.BOLD;
    if (useServerState(Varbits.WGS_HERO_PART_2_VIS) !== 0) {
      caption = 'You have rewards to collect from Laidee Gnonock!';
    } else {
      caption = 'You have rewards to collect from Ghommal!';
    }
  } else if (reached >= 6) {
    caption = `Total Points: ${stringOf(points)}`;
  } else {
    caption = `Total Points: ${stringOf(points)} - Next unlock in ${stringOf(toNext)} points`;
  }

  let fill: Int = 0;
  let bossTotal: Int = 0;
  let bossDone: Int = 0;
  if (mode === CaBarMode.ALL) {
    fill = scaled(Math.min(points, top), top, inner);
  } else if (mode === CaBarMode.BOSS) {
    const boss: Int = useServerState(Varbits.CA_BOSS_SELECTED);
    bossTotal = caTasksBossTotal(boss, groupSize);
    bossDone = caSpecificTaskcount(boss);
    if (bossDone > bossTotal) {
      bossDone = bossTotal;
    }
    fill = scaled(bossDone, Math.max(bossTotal, 1), inner);
    if (bossTotal <= 0) {
      caption = 'No Tasks Available';
    } else {
      caption = `Tasks Completed: ${stringOf(bossDone)}/${stringOf(bossTotal)}`;
    }
  } else if (pending === 1 || reached >= 6) {
    fill = inner;
  } else {
    const lower: Int = thresholdAt(reached, easy, medium, hard, elite, master, grandmaster);
    const upper: Int = thresholdAt(reached + 1, easy, medium, hard, elite, master, grandmaster);
    fill = scaled(Math.max(0, points - lower), Math.max(1, upper - lower), inner);
  }
  if (fill > inner) {
    fill = inner;
  }

  const hovered: Boolean = mode === CaBarMode.BOSS && bossTotal > 0;
  const mobile: Boolean = onMobile();

  const [captionLit, setCaptionLit] = useState(0);

  return (
    <>
      {hovered ? (
        <sprite
          x={2}
          y={2}
          w={inner}
          h={27}
          options={['View Tasks']}
          onOptionSelect={() => playSound(CaSound.SELECT)}
          transparency={250}
        />
      ) : null}
      <rect x={1} y={1} w={width - 2} h={29} color={CaColour.INK_INNER} />
      <sprite x={2} y={2} w={inner} h={27} sprite={CaSprite.BAR_TRACK} tiling />
      <sprite x={2} y={2} w={fill} h={27} sprite={CaSprite.BAR_FILL} tiling />
      <text
        x={0}
        y={0}
        w={width}
        h="fill"
        text={caption}
        font={font}
        color={captionLit === 1 ? CaColour.ORANGE : CaColour.WHITE}
        shadow
        align="center"
        valign="middle"
        onMouseEnter={
          hovered && !mobile
            ? () => {
                setCaptionLit(1);
              }
            : undefined
        }
        onMouseLeave={
          hovered
            ? () => {
                setCaptionLit(0);
              }
            : undefined
        }
      />
      <rect x={0} y={0} w={width} h={31} color={CaColour.INK_OUTER} />
    </>
  );
}

function thresholdAt(index: Int, easy: Int, medium: Int, hard: Int, elite: Int, master: Int, grandmaster: Int): Int {
  switch (index) {
    case 1:
      return easy;
    case 2:
      return medium;
    case 3:
      return hard;
    case 4:
      return elite;
    case 5:
      return master;
    case 6:
      return grandmaster;
    default:
      return 0;
  }
}

export const enum CaPage {
  OVERVIEW = 0,
  TASKS = 1,
  REWARDS = 2,
  BOSSES = 3,
}

const CaBurgerEntries = [
  { label: 'Overview', op: 'View Overview', page: CaPage.OVERVIEW },
  { label: 'Tasks', op: 'View Tasks', page: CaPage.TASKS },
  { label: 'Bosses', op: 'View Bosses', page: CaPage.BOSSES },
  { label: 'Rewards', op: 'View Rewards', page: CaPage.REWARDS },
] as const;

export function CaBurgerMenu({ current, mobile }: { current: Int; mobile: Boolean }): Component {
  const [open, setOpen] = useState(0);
  const [lit, setLit] = useState(0);

  const buttonSize: Int = mobile ? CaBurger.BUTTON_SIZE_MOBILE : CaBurger.BUTTON_SIZE;
  const buttonXY: Int = mobile ? CaBurger.BUTTON_XY_MOBILE : CaBurger.BUTTON_XY;
  const menuW: Int = mobile ? CaBurger.MENU_W_MOBILE : CaBurger.MENU_W;
  const menuH: Int = mobile ? CaBurger.MENU_H_MOBILE : CaBurger.MENU_H;
  const rowH: Int = mobile ? CaBurger.ROW_H_MOBILE : CaBurger.ROW_H;
  const rowW: Int = menuW - CaBurger.ROW_INSET;

  return (
    <>
      <layer
        x={buttonXY}
        y={buttonXY}
        w={buttonSize}
        h={buttonSize}
        options={['Show Menu']}
        onOptionSelect={(event) => {
          caBurgerSearchOff();
          if (event.option === 1) {
            const next: Int = open === 1 ? 0 : 1;
            setOpen(next);
            setLit(next);
          }
        }}
      >
        <sprite
          x="center"
          y="center"
          w={CaBurger.ICON_SIZE}
          h={CaBurger.ICON_SIZE}
          sprite={lit === 1 ? CaSprite.MENU_ACTIVE : CaSprite.MENU}
          onMouseRepeat={
            mobile
              ? undefined
              : () => {
                  setLit(1);
                }
          }
          onMouseLeave={
            mobile
              ? undefined
              : () => {
                  setLit(0);
                }
          }
        />
      </layer>

      {open === 1 ? (
        <layer
          w="fill"
          h="fill"
          noClickThrough
          onClick={() => {
            caBurgerCloseEffects();
            setOpen(0);
            setLit(0);
          }}
        />
      ) : null}

      {open === 1 ? (
        <layer x={0} y={CaBurger.MENU_Y} w={menuW} h={menuH} noClickThrough>
          <sprite w="fill" h="fill" sprite={CaSprite.TRADEBACKING_LIGHT} />
          <SteelFrame backdrop={false} />
          <layer w="fill" h="fill">
            {CaBurgerEntries.map((entry, i) => (
              <>
                <rect
                  x={CaBurger.ROW_X}
                  y={CaBurger.ROW_Y + rowH * i}
                  w={rowW}
                  h={rowH}
                  color={CaColour.WHITE}
                  fill
                  transparency={entry.page === current ? CaBurger.WASH_CURRENT : CaBurger.WASH_HIDDEN}
                />
                {entry.page === current ? (
                  <text
                    x={CaBurger.ROW_X}
                    y={CaBurger.ROW_Y + rowH * i}
                    w={rowW}
                    h={rowH}
                    text={entry.label}
                    font={CaFont.BODY}
                    shadow
                    color={CaColour.CURRENT}
                    align="center"
                    valign="middle"
                  />
                ) : mobile ? (
                  <text
                    x={CaBurger.ROW_X}
                    y={CaBurger.ROW_Y + rowH * i}
                    w={rowW}
                    h={rowH}
                    text={entry.label}
                    font={CaFont.BODY}
                    shadow
                    color={CaColour.ORANGE}
                    align="center"
                    valign="middle"
                    options={[entry.op]}
                    onOptionSelect={() => {
                      caBurgerCloseEffects();
                      setOpen(0);
                      setLit(0);
                    }}
                  />
                ) : (
                  <text
                    x={CaBurger.ROW_X}
                    y={CaBurger.ROW_Y + rowH * i}
                    w={rowW}
                    h={rowH}
                    text={entry.label}
                    font={CaFont.BODY}
                    shadow
                    color={CaColour.ORANGE}
                    align="center"
                    valign="middle"
                    hover={{ color: CaColour.WHITE }}
                    options={[entry.op]}
                    onOptionSelect={() => {
                      caBurgerCloseEffects();
                      setOpen(0);
                      setLit(0);
                    }}
                  />
                )}
              </>
            ))}
          </layer>
        </layer>
      ) : null}
    </>
  );
}

function caBurgerSearchOff(): void {
  if (useServerState(Varbits.CA_BOSSES_IS_SEARCHING) === 1) {
    caBossDisableSearch();
  }
}

function caBurgerCloseEffects(): void {
  caBurgerSearchOff();
  playSound(CaSound.SELECT);
}

export function caBossDisableSearch(): void {
  if (useServerState(Varbits.CA_BOSSES_IS_SEARCHING) === 1) {
    chatdefaultRestoreInput();
    predictServerState(Varbits.CA_BOSSES_IS_SEARCHING, 0);
  }
}

export function chatdefaultRestoreInput(): void {
  chatDefaultSetOnKey(1);
  const [, setSnapshotOpen] = useState(snapshotOpen);
  setSnapshotOpen(0);
  if (onMobile()) {
    keyboardHide();
  }
}
