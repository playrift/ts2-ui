    case 69:
      return useServerState(Varps.TOTAL_SNAKEBOSS_KILLS);
    case 6:
      return useServerState(Varps.VARP_5407);
  }
  return 0;
}

export function caTierStatus(tier: Int): Int {
  switch (tier) {
    case 1:
      return useServerState(Varbits.CA_TIER_STATUS_EASY);
    case 2:
      return useServerState(Varbits.CA_TIER_STATUS_MEDIUM);
    case 3:
      return useServerState(Varbits.CA_TIER_STATUS_HARD);
    case 4:
      return useServerState(Varbits.CA_TIER_STATUS_ELITE);
    case 5:
      return useServerState(Varbits.CA_TIER_STATUS_MASTER);
    case 6:
      return useServerState(Varbits.CA_TIER_STATUS_GRANDMASTER);
  }
  return -1;
}

export function caTaskIsDisabled(task: CaTaskRow): Int {
  const groupSize: Int = useServerState(Varbits.GIM_GROUPSIZE);
  if (groupSize <= 1 || groupSize > 5) {
    return 0;
  }
  const limit: Int = task.groupSizeLimit ?? 0;
  if (groupSize <= limit) {
    return 1;
  }
  return 0;
}

export function caTasksBossTotalTier(tier: Int, boss: Int): Int {
  let at: Int = 0;
  let total: Int = 0;
  while (at < CaTasks.length) {
    const task = CaTasks.at(at);
    if (task !== null) {
      if (task.tier === tier && task.boss === boss && caTaskIsDisabled(task) === 0) {
        total = total + 1;
      }
    }
    at = at + 1;
  }
  return total;
}

export function caTasksBossTotal(boss: Int): Int {
  if (boss === 0) {
    return 0;
  }
  let at: Int = 0;
  let total: Int = 0;
  while (at < CaTasks.length) {
    const task = CaTasks.at(at);
    if (task !== null) {
      if (task.boss === boss && caTaskIsDisabled(task) === 0) {
        total = total + 1;
      }
    }
    at = at + 1;
  }
  return total;
}
