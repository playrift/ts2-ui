        useServerState(Varps.JAD_CHALLENGE_3_COMPLETIONS) +
        useServerState(Varps.JAD_CHALLENGE_4_COMPLETIONS) +
        useServerState(Varps.JAD_CHALLENGE_5_COMPLETIONS) +
        useServerState(Varps.JAD_CHALLENGE_6_COMPLETIONS) +
        useServerState(Varps.JAD_CHALLENGE_LEAGUE_ONLY_COMPLETIONS)
