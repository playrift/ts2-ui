import { SteelBorder } from '../lib/steel-border.component';

import { Burger, CaColour, CaFonts, Layout, WideBar } from './ca-overview.constants';
import { profileHeaderText } from './ca-overview.helpers';
import { CaBurgerMenu, CaTasksProgressBar } from './ca-shared.local';
import { CaTierGrid } from './ca-tier-tile.component';
import { CaPersonal } from './ca-personal.component';

export function CaOverview(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <layer w="fill" h="fill">
        <SteelBorder title="Combat Achievements - Overview" titleColor={CaColour.ORANGE} flags={0} />
      </layer>

      <layer x="center" y={Layout.BAR_Y} w={{ fill: Layout.BAR_INSET_W }} h={Layout.BAR_H}>
        <CaTasksProgressBar mode={WideBar.MODE_OVERVIEW} tipOriginX={0} tipOriginY={0} />
      </layer>

      <layer x={Layout.HEADER_X} y={Layout.HEADER_Y} w={Layout.LEFT_W} h={Layout.HEADER_H}>
        <text
          x="center"
          y={Layout.HEADER_TEXT_Y}
          w="fill"
          h={{ fill: 1 }}
          text="Difficulty Tiers"
          font={CaFonts.BOLD}
          shadow
          color={CaColour.ORANGE}
          align="center"
          valign="middle"
        />
      </layer>

      <layer x={{ right: Layout.HEADER_X }} y={Layout.HEADER_Y} w={Layout.RIGHT_W} h={Layout.HEADER_H}>
        <ProfileHeader />
      </layer>

      <layer x={Layout.HEADER_X} y={Layout.CONTENT_Y} w={Layout.LEFT_W} h={{ fill: Layout.CONTENT_INSET_H }}>
        <CaTierGrid />
      </layer>

      <layer
        x={{ right: Layout.HEADER_X }}
        y={Layout.CONTENT_Y}
        w={Layout.RIGHT_W}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <CaPersonal />
      </layer>

      <CaBurgerMenu selected={Burger.OVERVIEW} />
    </layer>
  );
}

function ProfileHeader(): Component {
  return (
    <text
      x="center"
      y={Layout.HEADER_TEXT_Y}
      w="fill"
      h={{ fill: 1 }}
      text={profileHeaderText()}
      font={CaFonts.BOLD}
      shadow
      color={CaColour.ORANGE}
      align="center"
      valign="middle"
    />
  );
}
