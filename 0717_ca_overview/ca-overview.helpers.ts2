export function skillingBossKillTotal(): Int {
  return (
    useServerState(Varps.TOTAL_TEMPOROSS_KILLS) +
    useServerState(Varps.TOTAL_WINTERTODT_KILLS) +
    useServerState(Varps.TOTAL_ZALCANO_KILLS)
  );
}

export function raidCompletionTotal(): Int {
  return (
    useServerState(Varps.TOTAL_COMPLETED_XERICCHAMBERS) +
    useServerState(Varps.TOTAL_COMPLETED_XERICCHAMBERS_CHALLENGE) +
    useServerState(Varps.TOTAL_COMPLETED_THEATREOFBLOOD) +
    useServerState(Varps.TOTAL_COMPLETED_THEATREOFBLOOD_HARD) +
    useServerState(Varps.TOTAL_COMPLETED_TOMBSOFAMASCUT) +
    useServerState(Varps.TOTAL_COMPLETED_TOMBSOFAMASCUT_EXPERT)
  );
}

export function topBossOf(category: Int): Int {
  let id: Int = 0;
  let best: Int = 0;
  let top: Int = 0;
  while (id <= 90) {
    id = id + 1;
    const kills: Int = caSpecificKillcount(id);
    if ((CaBossCategories.get(id) ?? 0) === category && kills > best && id !== 51 && id !== 55) {
      top = id;
      best = kills;
    }
  }
  return top;
}

export function topBossKillcount(category: Int): Int {
  return caSpecificKillcount(topBossOf(category));
}

export function topBossText(boss: Int, kills: Int): String {
  if (boss === 0) {
    return 'Nothing!';
  }
  return `${CaBossNames.get(boss) ?? 'None'} (${formatCount(kills)})`;
}

export function caTasksCompletedTier(tier: Int): Int {
  switch (tier) {
    case 1:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_EASY);
    case 2:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_MEDIUM);
    case 3:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_HARD);
    case 4:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_ELITE);
    case 5:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_MASTER);
    case 6:
      return useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_GRANDMASTER);
  }
  return -1;
}

function excludedForSize(groupSize: Int, size2: Int, size3: Int, size4: Int, size5: Int): Int {
  if (groupSize === 2) {
    return size2;
  }
  if (groupSize === 3) {
    return size3;
  }
  if (groupSize === 4) {
    return size4;
  }
  if (groupSize === 5) {
    return size5;
  }
  return 0;
}

function groupIronExcluded(tier: Int, groupSize: Int): Int {
  if (tier === 4) {
    return excludedForSize(
      groupSize,
      GroupIronExcludedElite.SIZE2,
      GroupIronExcludedElite.SIZE3,
      GroupIronExcludedElite.SIZE4,
      GroupIronExcludedElite.SIZE5,
    );
  }
  if (tier === 5) {
    return excludedForSize(
      groupSize,
      GroupIronExcludedMaster.SIZE2,
      GroupIronExcludedMaster.SIZE3,
      GroupIronExcludedMaster.SIZE4,
      GroupIronExcludedMaster.SIZE5,
    );
  }
  if (tier === 6) {
    return excludedForSize(
      groupSize,
      GroupIronExcludedGrandmaster.SIZE2,
      GroupIronExcludedGrandmaster.SIZE3,
      GroupIronExcludedGrandmaster.SIZE4,
      GroupIronExcludedGrandmaster.SIZE5,
    );
  }
  return 0;
}

export function caTasksTierTotal(tier: Int): Int {
  let total: Int = CombatTaskCounts.EASY;
  if (tier === 2) {
    total = CombatTaskCounts.MEDIUM;
  } else if (tier === 3) {
    total = CombatTaskCounts.HARD;
  } else if (tier === 4) {
    total = CombatTaskCounts.ELITE;
  } else if (tier === 5) {
    total = CombatTaskCounts.MASTER;
  } else if (tier === 6) {
    total = CombatTaskCounts.GRANDMASTER;
  }
  if (isGroupIronman(useServerState(Varbits.IRONMAN))) {
    total = total - groupIronExcluded(tier, useServerState(Varbits.GIM_GROUPSIZE));
  }
  return total;
}

export function profileHeaderText(): String {
  return `Combat Profile - ${CS2.chat_playername()}`;
}
