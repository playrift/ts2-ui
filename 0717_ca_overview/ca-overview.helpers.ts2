import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { groupDigits } from '../lib/lib.format';
import { isGroupIronman } from '../0551_raids_storage_side/raids-storage-side.helpers';
import {
  CombatTaskCounts,
  GroupIronExcludedElite,
  GroupIronExcludedGrandmaster,
  GroupIronExcludedMaster,
} from '../0712_account_summary_sidepanel/account-summary-sidepanel.data';

import { WideBar } from './ca-overview.constants';
import { CaBossCategories, CaBossNames } from './ca-overview.data';
import { caSpecificKillcount } from './ca-shared.local';

export function formatCount(value: Int): String {
  if (value >= WideBar.LOTS) {
    return `Lots! (${stringOf(value)}+)`;
  }
  return groupDigits(value, ',');
}

export function tasksCompletedTotal(): Int {
  return (
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_EASY) +
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_MEDIUM) +
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_HARD) +
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_ELITE) +
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_MASTER) +
    useServerState(Varbits.CA_TOTAL_TASKS_COMPLETED_GRANDMASTER)
  );
}

