export function caTierStatus(tier: Int): Int {
  switch (tier) {
    case 1:
      return useServerState(Varbits.CA_TIER_STATUS_EASY);
    case 2:
      return useServerState(Varbits.CA_TIER_STATUS_MEDIUM);
    case 3:
      return useServerState(Varbits.CA_TIER_STATUS_HARD);
    case 4:
      return useServerState(Varbits.CA_TIER_STATUS_ELITE);
    case 5:
      return useServerState(Varbits.CA_TIER_STATUS_MASTER);
    case 6:
      return useServerState(Varbits.CA_TIER_STATUS_GRANDMASTER);
  }
  return -1;
}

export function caTaskIsDisabled(groupSizeLimit: Int, groupSize: Int): Boolean {
  if (groupSize <= 1 || groupSize > 5) {
    return false;
  }
  if (groupSize <= groupSizeLimit) {
    return true;
  }
  return false;
}

export function caTasksBossTotalTier(tier: Int, boss: Int): Int {
  const groupSize: Int = useServerState(Varbits.GIM_GROUPSIZE);
  let total: Int = 0;
  let at: Int = 0;
  const count: Int = CaTasks.length;
  while (at < count) {
    const row = CaTasks.at(at);
    if (row !== null) {
      if (row.tier === tier && row.boss === boss && !caTaskIsDisabled(row.groupSizeLimit, groupSize)) {
        total = total + 1;
      }
    }
    at = at + 1;
  }
  return total;
}

export function caTasksBossTotal(boss: Int): Int {
  if (boss === 0) {
    return 0;
  }
  return (
    caTasksBossTotalTier(1, boss) +
    caTasksBossTotalTier(2, boss) +
    caTasksBossTotalTier(3, boss) +
    caTasksBossTotalTier(4, boss) +
    caTasksBossTotalTier(5, boss) +
    caTasksBossTotalTier(6, boss)
  );
}

export function chatDefaultRestoreInput(): void {
  chatDefaultSetOnKey(1);
  const [, setSnapshot] = useState(snapshotOpen);
  setSnapshot(0);
  if (onMobile()) {
    keyboardHide();
  }
}

export function caBossDisableSearch(): void {
  if (useServerState(Varbits.CA_BOSSES_IS_SEARCHING) === 1) {
    chatDefaultRestoreInput();
    predictServerState(Varbits.CA_BOSSES_IS_SEARCHING, 0);
  }
}

const CaBurgerEntries = [
  { label: 'Overview', op: 'View Overview', page: Burger.OVERVIEW },
  { label: 'Tasks', op: 'View Tasks', page: Burger.TASKS },
  { label: 'Bosses', op: 'View Bosses', page: Burger.BOSSES },
  { label: 'Rewards', op: 'View Rewards', page: Burger.REWARDS },
] as const;

export function CaBurgerMenu({ selected }: { selected: Int }): Component {
  const [open, setOpen] = useState(0);
  const [lit, setLit] = useState(0);
  const mobile: Boolean = onMobile();

  const entriesH: Int = mobile ? Burger.ENTRIES_H_MOBILE : Burger.ENTRIES_H;
  const frameW: Int = mobile ? Burger.FRAME_W_MOBILE : Burger.FRAME_W;
  const entryH: Int = entriesH / 4;
  const entryW: Int = frameW - Burger.FRAME_INSET;

  return (
    <>
      <layer
        x={mobile ? Burger.BUTTON_INSET_MOBILE : Burger.BUTTON_INSET}
        y={mobile ? Burger.BUTTON_INSET_MOBILE : Burger.BUTTON_INSET}
        w={mobile ? Burger.BUTTON_MOBILE : Burger.BUTTON}
        h={mobile ? Burger.BUTTON_MOBILE : Burger.BUTTON}
        options={['Show Menu']}
        onOptionSelect={(event) => {
          caBossDisableSearch();
          if (event.option === 1) {
            const next: Int = open === 1 ? 0 : 1;
            setOpen(next);
            setLit(next);
          }
        }}
      >
        <sprite
          x="center"
          y="center"
          w={Burger.BUTTON}
          h={Burger.BUTTON}
          sprite={lit === 1 ? CaArt.MENU_ON : CaArt.MENU_OFF}
          onMouseRepeat={
            mobile
              ? undefined
              : () => {
                  setLit(1);
                }
          }
          onMouseLeave={
            mobile
              ? undefined
              : () => {
                  setLit(0);
                }
          }
        />
      </layer>

      {open === 1 ? (
        <layer
          w="fill"
          h="fill"
          noClickThrough
          onClick={() => {
            caBurgerCloseEffects();
            setOpen(0);
            setLit(0);
          }}
        />
      ) : null}

      {open === 1 ? (
        <layer y={Burger.FRAME_Y} w={frameW} h={entriesH + Burger.FRAME_INSET} noClickThrough>
          <sprite w="fill" h="fill" sprite={CaArt.DROPDOWN_BACKDROP} />
          <SteelFrame backdrop={false} />
          <layer w="fill" h="fill">
            {CaBurgerEntries.map((entry, i) => (
              <>
                <rect
                  x={Burger.ENTRY_INSET}
                  y={Burger.ENTRY_INSET + entryH * i}
                  w={entryW}
                  h={entryH}
                  fill
                  color={CaColour.WHITE}
                  transparency={entry.page === selected ? Burger.CURRENT_WASH : Burger.OTHER_WASH}
                />
                {entry.page === selected ? (
                  <text
                    x={Burger.ENTRY_INSET}
                    y={Burger.ENTRY_INSET + entryH * i}
                    w={entryW}
                    h={entryH}
                    text={entry.label}
                    font={CaFonts.BODY}
                    shadow
                    color={CaColour.DROPDOWN_CURRENT}
                    align="center"
                    valign="middle"
                  />
                ) : mobile ? (
                  <text
                    x={Burger.ENTRY_INSET}
                    y={Burger.ENTRY_INSET + entryH * i}
                    w={entryW}
                    h={entryH}
                    text={entry.label}
                    font={CaFonts.BODY}
                    shadow
                    color={CaColour.ORANGE}
                    align="center"
                    valign="middle"
                    options={[entry.op]}
                    onOptionSelect={() => {
                      caBurgerCloseEffects();
                      setOpen(0);
                      setLit(0);
                    }}
                  />
                ) : (
                  <text
                    x={Burger.ENTRY_INSET}
                    y={Burger.ENTRY_INSET + entryH * i}
                    w={entryW}
                    h={entryH}
                    text={entry.label}
                    font={CaFonts.BODY}
                    shadow
                    color={CaColour.ORANGE}
                    align="center"
                    valign="middle"
                    hover={{ color: CaColour.WHITE }}
                    options={[entry.op]}
                    onOptionSelect={() => {
                      caBurgerCloseEffects();
                      setOpen(0);
                      setLit(0);
                    }}
                  />
                )}
              </>
            ))}
          </layer>
        </layer>
      ) : null}
    </>
  );
}

function caBurgerCloseEffects(): void {
  caBossDisableSearch();
  playSound(CaSounds.SELECT);
}

function tileSegmentWidth(fill: Int, segW: Int, i: Int): Int {
  const remaining: Int = fill > i * segW ? fill - i * segW : 0;
  if (remaining > segW) {
    return segW - 1;
  }
  return remaining - 1;
}

const TILE_SEGMENTS = [0, 1, 2, 3] as const;

export function CaSetupProgressBar({
  total,
  done,
  x,
  y,
  w,
  color,
  textY,
}: {
  total: Int;
  done: Int;
  x: Int;
  y: Int;
  w: Int;
  color: Int;
  textY: Int;
}): Component {
  const segW: Int = w / TileBar.SEGMENTS;
  const fill: Int = 1 + scaled(done, Math.max(1, total), w - 1);
  const caption: Int = total === done ? color : done > 0 ? CaColour.YELLOW : CaColour.IDLE;

  return (
    <>
      <rect x={x} y={y + 1} w={w} h={TileBar.PLATE_H} fill color={CaColour.WHITE} transparency={TileBar.PLATE_ALPHA} />
      <text
        x={x}
        y={y + textY}
        w={w}
        h={TileBar.CAPTION_H}
        text={`${stringOf(done)}/${stringOf(total)}`}
        color={caption}
        shadow
        font={CaFonts.BODY}
        align="center"
        valign="top"
      />
      <rect
        x={x}
        y={y + TileBar.TROUGH_Y}
        w={w}
        h={TileBar.TROUGH_H}
        fill
        color={CaColour.BLACK}
        transparency={TileBar.TROUGH_ALPHA}
      />
      {TILE_SEGMENTS.map((i) => (
        <rect x={x + i * segW} y={y + TileBar.TROUGH_Y} w={segW + 1} h={TileBar.TROUGH_H} color={CaColour.BLACK} />
      ))}
      {TILE_SEGMENTS.map((i) => (
        <rect
          x={x + i * segW + 1}
          y={y + TileBar.SEGMENT_Y}
          w={tileSegmentWidth(fill, segW, i)}
          h={TileBar.SEGMENT_H}
          fill
          color={caption}
        />
      ))}
    </>
  );
}

export const caProgressTipText = sessionState('');
export const caProgressTipX = sessionState(-1);
export const caProgressTipY = sessionState(-1);
export const caProgressTipH = sessionState(-1);

export function caProgressTipShow(text: String, x: Int, y: Int, h: Int): void {
  const [, setText] = useState(caProgressTipText);
  const [, setX] = useState(caProgressTipX);
  const [, setY] = useState(caProgressTipY);
  const [, setH] = useState(caProgressTipH);
  if (onEnhancedMobile()) {
    return;
  }
  if (onEnhancedAny()) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(WideBar.TIP_DWELL)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  setText(text);
  setX(x);
  setY(y);
  setH(h);
  tooltipRaise();
}

export function caProgressTipBuild(text: String, x: Int, y: Int, h: Int): void {
  const [, setText] = useState(caProgressTipText);
  const [, setX] = useState(caProgressTipX);
  const [, setY] = useState(caProgressTipY);
  const [, setH] = useState(caProgressTipH);
  if (onEnhancedAny()) {
    return;
  }
  setText(text);
  setX(x);
  setY(y);
  setH(h);
  tooltipRaise();
}

export function leagueProgressBarMobileTooltip(marker: Int, text: String, x: Int, y: Int, h: Int): void {
  const [shown, setShown] = useState(leagueProgressBarTooltip);
  if (shown === marker) {
    tooltipHide();
    setShown(-1);
  } else {
    caProgressTipBuild(text, x, y, h);
    setShown(marker);
  }
}

export function caBossBarTotal(mode: Int): Int {
  if (mode !== WideBar.MODE_BOSS) {
    return 0;
  }
  return caTasksBossTotal(useServerState(Varbits.CA_BOSS_SELECTED));
}

export function caBossBarDone(mode: Int): Int {
  if (mode !== WideBar.MODE_BOSS) {
    return 0;
  }
  return caSpecificTaskcount(useServerState(Varbits.CA_BOSS_SELECTED));
}

const TIER_MARKERS = [0, 1, 2, 3, 4, 5] as const;

export function CaTasksProgressBar({
  mode,
  tipOriginX,
  tipOriginY,
}: {
  mode: Int;
  tipOriginX: Int;
  tipOriginY: Int;
}): Component {
  const universe = useUniverse();
  const mobile: Boolean = onMobile();

  const thresholds = intArray(7);
  thresholds[0] = 0;
  thresholds[1] = useServerState(Varbits.CA_THRESHOLD_EASY);
  thresholds[2] = useServerState(Varbits.CA_THRESHOLD_MEDIUM);
  thresholds[3] = useServerState(Varbits.CA_THRESHOLD_HARD);
  thresholds[4] = useServerState(Varbits.CA_THRESHOLD_ELITE);
  thresholds[5] = useServerState(Varbits.CA_THRESHOLD_MASTER);
  thresholds[6] = useServerState(Varbits.CA_THRESHOLD_GRANDMASTER);
  const points: Int = useServerState(Varbits.CA_POINTS);

  let tier: Int = 0;
  let toNext: Int = 0;
  let found: Int = 0;
  let i: Int = 0;
  while (i < 6 && found === 0) {
    if (points < thresholds[1 + i]) {
      toNext = thresholds[1 + i] - points;
      found = 1;
    } else {
      tier = tier + 1;
    }
    i = i + 1;
  }

  let claimable: Int = 0;
  i = 0;
  while (i < 6) {
    if (caTierStatus(i) === WideBar.STATUS_CLAIMABLE) {
      claimable = 1;
    }
    i = i + 1;
  }

  const maxPoints: Int = Math.max(1, thresholds[6]);

  const width: Int = universe.width;
  const fillW: Int = width - WideBar.FILL_INSET;

  let font: Font = CaFonts.BODY;
  let caption: String = '';
  if (claimable === 1) {
    font = CaFonts.BOLD;
    if (useServerState(Varbits.WGS_HERO_PART_2_VIS) !== 0) {
      caption = 'You have rewards to collect from Laidee Gnonock!';
    } else {
      caption = 'You have rewards to collect from Ghommal!';
    }
  } else if (tier >= 6) {
    caption = `Total Points: ${stringOf(points)}`;
  } else {
    caption = `Total Points: ${stringOf(points)} - Next unlock in ${stringOf(toNext)} points`;
  }

  let bossTotal: Int = 0;
  let bossDone: Int = 0;
  let fill: Int = 0;
  if (mode === WideBar.MODE_REWARDS) {
    fill = scaled(Math.min(points, maxPoints), maxPoints, fillW);
  } else if (mode === WideBar.MODE_BOSS) {
    bossTotal = useDerived(() => caBossBarTotal(mode));
    bossDone = useDerived(() => caBossBarDone(mode));
    if (bossDone > bossTotal) {
      bossDone = bossTotal;
    }
    fill = scaled(bossDone, Math.max(bossTotal, 1), fillW);
    if (bossTotal <= 0) {
      caption = 'No Tasks Available';
    } else {
      caption = `Tasks Completed: ${stringOf(bossDone)}/${stringOf(bossTotal)}`;
    }
  } else if (claimable === 1 || tier >= 6) {
    fill = fillW;
  } else {
    const low: Int = thresholds[tier];
    const high: Int = thresholds[1 + tier];
    fill = scaled(Math.max(0, points - low), Math.max(1, high - low), fillW);
  }
  if (fill > fillW) {
    fill = fillW;
  }

  const captionHover: Boolean =
    (mode === WideBar.MODE_BOSS && bossTotal > 0) || (mode === WideBar.MODE_REWARDS && mobile);

  const [captionLit, setCaptionLit] = useState(0);

  return (
    <>
      {mode === WideBar.MODE_BOSS && bossTotal > 0 && (
        <sprite
          x={WideBar.TROUGH_INSET}
          y={WideBar.TROUGH_INSET}
          w={width - WideBar.FILL_INSET}
          h={WideBar.TROUGH_H}
          transparency={WideBar.CLICK_ALPHA}
          options={['View Tasks']}
          onOptionSelect={() => playSound(CaSounds.SELECT)}
        />
      )}
      <rect
        x={WideBar.PLATE_INSET}
        y={WideBar.PLATE_INSET}
        w={width - WideBar.PLATE_INSET * 2}
        h={WideBar.PLATE_H}
        color={CaColour.BAR_PLATE}
      />
      <sprite
        x={WideBar.TROUGH_INSET}
        y={WideBar.TROUGH_INSET}
        w={width - WideBar.FILL_INSET}
        h={WideBar.TROUGH_H}
        sprite={CaArt.BAR_EMPTY}
        tiling
      />
      <sprite
        x={WideBar.TROUGH_INSET}
        y={WideBar.TROUGH_INSET}
        w={fill}
        h={WideBar.TROUGH_H}
        sprite={CaArt.BAR_FILL}
        tiling
      />
      {mode === WideBar.MODE_REWARDS &&
        TIER_MARKERS.map((marker) => (
          <ThresholdMarker
            marker={marker}
            points={thresholds[1 + marker]}
            maxPoints={maxPoints}
            fillW={fillW}
            mobile={mobile}
            tipOriginX={tipOriginX}
            tipOriginY={tipOriginY}
          />
        ))}
      <text
        x={0}
        y={0}
        w={width}
        h="fill"
        font={font}
        color={captionLit === 1 ? CaColour.ORANGE : CaColour.WHITE}
        shadow
        align="center"
        valign="middle"
        text={caption}
        onMouseEnter={
          captionHover && !mobile
            ? () => {
                setCaptionLit(1);
              }
            : undefined
        }
        onMouseLeave={
          captionHover
            ? () => {
                setCaptionLit(0);
              }
            : undefined
        }
      />
      <rect x={0} y={0} w={width} h={WideBar.OUTLINE_H} color={CaColour.BAR_OUTLINE} />
    </>
  );
}

function ThresholdMarker({
  marker,
  points,
  maxPoints,
  fillW,
  mobile,
  tipOriginX,
  tipOriginY,
}: {
  marker: Int;
  points: Int;
  maxPoints: Int;
  fillW: Int;
  mobile: Boolean;
  tipOriginX: Int;
  tipOriginY: Int;
}): Component {
  let at: Int = scaled(points, maxPoints, fillW);
  if (at <= 2) {
    at = 0;
  } else if (at >= fillW) {
    at = 3 + fillW;
  } else {
    at = at + 2;
  }
  const left: Int = at - WideBar.MARKER_OFFSET;
  const anchorX: Int = tipOriginX + Math.max(0, left);
  const tierName: String = CaTierNames.get(marker + 1) ?? '';
  let text: String = '';
  if (points === 1) {
    text = `${tierName} Tier rewards unlocked at one point.`;
  } else {
    text = `${tierName} Tier rewards unlocked at ${stringOf(points)} points.`;
  }

  if (mobile) {
    return (
      <sprite
        x={left}
        y={0}
        w={WideBar.MARKER_W}
        h={WideBar.MARKER_H}
        sprite={CaArt.THRESHOLD}
        options={['Show Threshold']}
        onOptionSelect={() => leagueProgressBarMobileTooltip(marker, text, anchorX, tipOriginY, WideBar.MARKER_H)}
      />
    );
  }
  return (
    <sprite
      x={left}
      y={0}
      w={WideBar.MARKER_W}
      h={WideBar.MARKER_H}
      sprite={CaArt.THRESHOLD}
      options={['']}
      onMouseRepeat={() => caProgressTipShow(text, anchorX, tipOriginY, WideBar.MARKER_H)}
      onMouseLeave={() => tooltipHide()}
    />
  );
}
