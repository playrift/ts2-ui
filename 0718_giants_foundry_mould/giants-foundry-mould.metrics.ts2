import { MouldFonts } from './giants-foundry-mould.constants';

export function breakpointOf(width: Int, height: Int): Int {
  let level: Int = 0;
  if (width > 640 && height > 480) {
    level = 1;
  }
  if (width > 800 && height > 600) {
    level = 2;
  }
  if (width > 1024 && height > 768) {
    level = 3;
  }
  return level;
}

export function universeWidth(bp: Int): Int {
  switch (bp) {
    case 1:
      return 600;
    case 2:
      return 720;
    case 3:
      return 850;
  }
  return 480;
}

export function universeHeight(bp: Int): Int {
  switch (bp) {
    case 1:
      return 392;
    case 2:
      return 470;
    case 3:
      return 556;
  }
  return 314;
}

export function bodyFont(bp: Int): Font {
  if (bp >= 1) {
    return MouldFonts.BODY_WIDE;
  }
  return MouldFonts.BODY;
}

export function boldFont(bp: Int): Font {
  if (bp >= 1) {
    return MouldFonts.BOLD_WIDE;
  }
  return MouldFonts.BOLD;
}

export function smallFont(bp: Int): Font {
  if (bp >= 1) {
    return MouldFonts.SMALL_WIDE;
  }
  return MouldFonts.SMALL;
}

export function tabHeight(bp: Int): Int {
  switch (bp) {
    case 1:
      return 40;
    case 2:
      return 40;
    case 3:
