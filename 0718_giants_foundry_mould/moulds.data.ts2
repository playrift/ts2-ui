export enum MouldKeyword {
  NARROW = 1,
  LIGHT = 2,
  FLAT = 3,
  BROAD = 4,
  HEAVY = 5,
  SPIKED = 6,
}

export const MouldKeywords = mapOf<MouldKeyword, String>([
  [MouldKeyword.NARROW, 'Narrow'],
  [MouldKeyword.LIGHT, 'Light'],
  [MouldKeyword.FLAT, 'Flat'],
  [MouldKeyword.BROAD, 'Broad'],
  [MouldKeyword.HEAVY, 'Heavy'],
  [MouldKeyword.SPIKED, 'Spiked'],
]);

export function mouldIndex(category: MouldCategory, slot: Int): Int {
  if (slot < 1 || slot > MOULDS_PER_CATEGORY) {
    return -1;
  }
  return category * MOULDS_PER_CATEGORY + slot - 1;
}
