import { textLineCount } from '../lib/lib.engine';
import { Layout, SigilFonts, SigilParams, SigilTables } from './deadman-sigils.constants';

export function offerTitle(sigil: Row): String {
  if (sigil === -1) {
    return '<col=9f9f9f>Unavailable</col>';
  }
  return `${SigilTables.TYPE_NAMES.get(sigil.int(SigilParams.TYPE))}: <col=ffb83f>${sigil.text(SigilParams.NAME)}</col>`;
}

export function offerBody(sigil: Row): String {
  if (sigil === -1) {
    return '<col=9f9f9f>Please make another selection.</col>';
  }
  return sigil.text(SigilParams.DESCRIPTION);
}

export function offerTitleHeight(title: String): Int {
  return Layout.OFFER_NAME_PAD + Layout.OFFER_NAME_LINE * textLineCount(title, Layout.OFFER_TEXT_W, SigilFonts.BODY);
}

export function offerBodyHeight(body: String): Int {
  return (
    Layout.OFFER_BODY_PAD + Layout.OFFER_BODY_LINE * textLineCount(body, Layout.OFFER_TEXT_W, SigilFonts.OFFER_BODY)
  );
}

export function offerBodyPadded(titleH: Int, bodyH: Int): Int {
  return Math.max(bodyH, Layout.OFFER_ROW_MIN_H - titleH);
}

export function slotTitle(sigil: Row): String {
  if (sigil === -1) {
    return '<col=9f9f9f>Empty slot</col>';
  }
  return sigil.text(SigilParams.NAME);
}

export function slotBody(sigil: Row): String {
  if (sigil === -1) {
    return '<col=9f9f9f>You can attune 3 of sigils to give you various advantages.</col>';
  }
  const type: String = SigilTables.TYPE_NAMES.get(sigil.int(SigilParams.TYPE));
  const tier: Int = sigil.int(SigilParams.TIER);
  return `Type: <col=ffb83f>${type}</col><br>Tier: <col=ffb83f>${tier}</col><br><br>${sigil.text(SigilParams.DESCRIPTION)}`;
}

export function slotTextHeight(text: String): Int {
  return Layout.SLOT_TEXT_PAD + Layout.SLOT_TEXT_LINE * textLineCount(text, Layout.SLOT_TEXT_W, SigilFonts.BODY);
}

export function slotTitleLines(title: String): Int {
  return textLineCount(title, Layout.SLOT_TEXT_W, SigilFonts.BODY);
}
