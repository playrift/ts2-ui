import { Layout, SigilColor, SigilFonts, SigilTables } from './deadman-sigils.constants';

export function OfferRow({
  sigil,
  y,
  transparency,
  title,
  titleH,
  body,
  bodyH,
  height,
}: {
  sigil: Int;
  y: Int;
  transparency: Int;
  title: String;
  titleH: Int;
  body: String;
  bodyH: Int;
  height: Int;
}): Component {
  const item: ItemName = SigilTables.OFFER_ITEM.get(sigil) ?? -1;

  return (
    <>
      <rect x="center" y={y} w="fill" h={height} color={SigilColor.ROW} fill transparency={transparency} />

      {item !== -1 && (
        <sprite
          x={Layout.OFFER_ITEM_X}
          y={y + (height - Layout.OFFER_ITEM_H) / 2}
          w={Layout.OFFER_ITEM_W}
          h={Layout.OFFER_ITEM_H}
          item={item}
          itemCount={1}
          outline={1}
          shadowColor={SigilColor.ITEM_SHADOW}
        />
      )}

      <text
        x={Layout.OFFER_TEXT_X}
        y={y}
        w={Layout.OFFER_TEXT_W}
        h={titleH}
        text={title}
        font={SigilFonts.BODY}
        color={SigilColor.LABEL}
        align="left"
        valign="bottom"
        shadow
      />

      <text
        x={Layout.OFFER_TEXT_X}
        y={y + titleH}
        w={Layout.OFFER_TEXT_W}
        h={bodyH}
        text={body}
        font={SigilFonts.OFFER_BODY}
        color={SigilColor.LABEL}
        align="left"
        valign="middle"
        shadow
      />
    </>
  );
}
