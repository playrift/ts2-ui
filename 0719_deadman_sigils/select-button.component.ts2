import { CS2, useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { SigilFonts } from './deadman-sigils.constants';

const LABEL = '<col=0dc10d>Select</col>';

const SOUND_MASK = 2;

export function SelectButton(): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(LABEL)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, SOUND_MASK)}
    >
      <StoneButtonDraw label={LABEL} font={SigilFonts.BODY} pressed={skin} />
    </layer>
  );
}
