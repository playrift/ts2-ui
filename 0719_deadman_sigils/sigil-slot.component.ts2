import {
  Layout,
  SigilArt,
  SigilColor,
  SigilFonts,
  SigilModels,
  SigilType,
  Transparency,
} from './deadman-sigils.constants';
import type { SigilRow } from './sigils.data';

export function SigilSlot({
  slot,
  sigil,
  title,
  titleH,
  body,
  bodyH,
}: {
  slot: Int;
  sigil: SigilRow | null;
  title: String;
  titleH: Int;
  body: String;
  bodyH: Int;
}): Component {
  let ground: Int = SigilColor.EMPTY;
  let plate: Sprite = -1;
  if (sigil !== null) {
    const type: Int = sigil.type;
    const tier: Int = sigil.tier;
    if (type === SigilType.COMBAT) {
      ground = SigilColor.COMBAT;
      plate = tier === 2 ? SigilArt.COMBAT_T2 : tier === 3 ? SigilArt.COMBAT_T3 : SigilArt.COMBAT_T1;
    } else if (type === SigilType.SKILLING) {
      ground = SigilColor.SKILLING;
      plate = tier === 2 ? SigilArt.SKILLING_T2 : tier === 3 ? SigilArt.SKILLING_T3 : SigilArt.SKILLING_T1;
    } else {
      ground = SigilColor.UTILITY;
      plate = tier === 2 ? SigilArt.UTILITY_T2 : tier === 3 ? SigilArt.UTILITY_T3 : SigilArt.UTILITY_T1;
    }
  }

  const label: Int = slot + 1;
  const bodyY: Int = Layout.SLOT_NAME_Y + titleH + Layout.SLOT_NAME_GAP;

  return (
    <>
      <rect
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        color={ground}
        fill
        transparency={Transparency.SLOT_GROUND}
      />

      <text
        x="center"
        y={Layout.SLOT_TITLE_Y}
        w={Layout.SLOT_TEXT_W}
        h={Layout.SLOT_TITLE_H}
        text={`Slot ${label}`}
        font={SigilFonts.SLOT_TITLE}
        color={SigilColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      {sigil !== null ? (
        <>
          <sprite x="center" y={Layout.SLOT_ART_Y} w={Layout.SLOT_ART} h={Layout.SLOT_ART} sprite={plate} />
          <sprite
            x="center"
            y={Layout.SLOT_ART_Y + Layout.SLOT_ICON_DY}
            w={Layout.SLOT_ICON}
            h={Layout.SLOT_ICON}
            sprite={sigil.icon}
          />
        </>
      ) : (
        <model
          x="center"
          y={Layout.SLOT_ART_Y}
          w={Layout.SLOT_ART}
          h={Layout.SLOT_ART}
          model={SigilModels.EMPTY_SLOT}
          pitch={Layout.SLOT_MODEL_PITCH}
          yaw={Layout.SLOT_MODEL_YAW}
          zoom={Layout.SLOT_MODEL_ZOOM}
        />
      )}

      <text
        x="center"
        y={Layout.SLOT_NAME_Y}
        w={Layout.SLOT_TEXT_W}
        h={titleH}
        text={title}
        font={SigilFonts.BODY}
        color={SigilColor.NAME}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x="center"
        y={bodyY}
        w={Layout.SLOT_TEXT_W}
        h={bodyH}
        text={body}
        font={SigilFonts.BODY}
        color={SigilColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <rect x={0} y="center" w={1} h="fill" color={SigilColor.RULE_DARK} />
      <rect x={1} y="center" w={1} h="fill" color={SigilColor.RULE_LIGHT} />
      <rect x="right" y="center" w={1} h="fill" color={SigilColor.RULE_DARK} />
      <rect x={{ right: 1 }} y="center" w={1} h="fill" color={SigilColor.RULE_LIGHT} />
    </>
  );
}
