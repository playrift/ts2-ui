        w={{ fill: 4 }}
        h={20}
        font={SidepanelFonts.TITLE}
        color={SidepanelColor.TITLE}
        shadow
        align="center"
        valign="bottom"
      />

      <layer x="center" y={35} w={{ fill: 4 }} h={{ fill: 71 }}>
        <rect
          x="center"
          y="center"
          w={{ fill: 6 }}
          h={{ fill: 6 }}
          fill
