import { StoneBoxSkin, StoneBoxSprites } from './gim-limited-sidepanel.constants';

export function StoneBox({ skin = StoneBoxSkin.PLAIN }: { skin?: Int }): Component {
  if (skin === StoneBoxSkin.ORNATE) {
    return (
      <>
        <sprite x="left" y="top" w={32} h={32} sprite={StoneBoxSprites.ORNATE_TOP_LEFT} tiling />
        <sprite x="right" y="top" w={32} h={32} sprite={StoneBoxSprites.ORNATE_TOP_RIGHT} tiling />
        <sprite x="left" y="bottom" w={32} h={32} sprite={StoneBoxSprites.ORNATE_BOTTOM_LEFT} tiling />
        <sprite x="right" y="bottom" w={32} h={32} sprite={StoneBoxSprites.ORNATE_BOTTOM_RIGHT} tiling />

        <sprite x="center" y={-13} w={{ fill: 64 }} h={32} sprite={StoneBoxSprites.ORNATE_TOP} tiling />
        <sprite x="center" y={{ bottom: -12 }} w={{ fill: 64 }} h={32} sprite={StoneBoxSprites.ORNATE_BOTTOM} tiling />
        <sprite x={-13} y="center" w={32} h={{ fill: 64 }} sprite={StoneBoxSprites.ORNATE_LEFT} tiling />
        <sprite x={{ right: -12 }} y="center" w={32} h={{ fill: 64 }} sprite={StoneBoxSprites.ORNATE_RIGHT} tiling />
      </>
    );
  }

  return (
    <>
      <sprite x="left" y="top" w={32} h={32} sprite={StoneBoxSprites.PLAIN_TOP_LEFT} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={StoneBoxSprites.PLAIN_TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={StoneBoxSprites.PLAIN_BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={StoneBoxSprites.PLAIN_BOTTOM_RIGHT} tiling />

      <sprite x="center" y={-14} w={{ fill: 64 }} h={32} sprite={StoneBoxSprites.PLAIN_HORIZONTAL} tiling />
      <sprite x="center" y={{ bottom: -12 }} w={{ fill: 64 }} h={32} sprite={StoneBoxSprites.PLAIN_HORIZONTAL} tiling />
      <sprite x={-14} y="center" w={32} h={{ fill: 64 }} sprite={StoneBoxSprites.PLAIN_VERTICAL} tiling />
      <sprite x={{ right: -12 }} y="center" w={32} h={{ fill: 64 }} sprite={StoneBoxSprites.PLAIN_VERTICAL} tiling />
    </>
  );
}

export function StoneBoxEntrypoint({ skin = StoneBoxSkin.PLAIN }: { skin?: Int }): Component {
  return <StoneBox skin={skin} />;
}
