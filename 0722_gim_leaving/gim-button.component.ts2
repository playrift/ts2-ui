import { useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { GimLeavingFonts } from './gim-leaving.constants';

export function GimButton({ label, color }: { label: String; color: Int }): Component {
  const [hovered, setHovered] = useState(0);

  if (onMobile()) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonOutFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          color={color}
          font={GimLeavingFonts.BODY}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseEnter={() => setHovered(1)} onMouseLeave={() => setHovered(0)}>
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        color={color}
        font={GimLeavingFonts.BODY}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
