import { useRef, useServerState } from 'ts2';
import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { opsound } from '../lib/lib.helpers';
import { InviteButton } from './invite-button.component';
import { PlayerList } from './player-list.component';
import { CreationStoneButton, StoneButtonInit } from './stone-button.component';
import {
  BACKDROP_TRANSPARENCY,
  CreationColor,
  CreationFonts,
  CreationSprites,
  CreationVarbits,
  Layout,
  REFRESH_OPSOUND_MASK,
  SUBJECT,
} from './gim-creation-sidepanel.constants';

export function GimCreationSidepanel(): Component {
  return (
    <>
      <RefreshButton />

      <PanelHeading />

      <layer x={0} y={Layout.CAPTION_Y} w={Layout.CAPTION_WIDTH} h={Layout.CAPTION_HEIGHT}>
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={`${SUBJECT} members`}
          font={CreationFonts.CAPTION}
          color={CreationColor.CAPTION}
          align="center"
          valign="middle"
          shadow
        />
      </layer>

      <layer x="center" y={Layout.LIST_BOX_Y} w={{ fill: Layout.LIST_BOX_INSET }} h={{ fill: Layout.LIST_BOX_BOTTOM }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          fill
          color={CreationColor.BACKDROP}
          transparency={BACKDROP_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.THIN_BOX_INSET }} h={{ fill: Layout.THIN_BOX_INSET }}>
          <layer x={0} y={0} w="fill" h="fill">
            <PlayerList />
          </layer>

          <ThinBoxEntrypoint />
        </layer>

        <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
      </layer>

      <CreationStoneButton
        x="right"
        y={{ bottom: Layout.BUTTON_ROW_TOP }}
        w={Layout.WIDE_BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
        liveLabel={`<col=ff981f>${SUBJECT} name</col>`}
        flatLabel={`<col=808080>${SUBJECT} name</col>`}
        option={`${SUBJECT} name`}
      />

      <InviteButton />

      <StoneButtonInit
        x={Layout.NARROW_BUTTON_X}
        y={{ bottom: Layout.BUTTON_ROW_BOTTOM }}
        w={Layout.NARROW_BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
        label="<col=ff0000>Cancel</col>"
        font={CreationFonts.BODY}
      />

      <CreationStoneButton
        x="right"
        y={{ bottom: Layout.BUTTON_ROW_BOTTOM }}
        w={Layout.WIDE_BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
        liveLabel="<col=0dc10d>Confirm</col>"
        flatLabel="<col=808080>Confirm</col>"
        option="Confirm"
      />

      <rect x={0} y={0} w={0} h={0} />
      <rect x={0} y={0} w={0} h={0} />
      <rect x={0} y={0} w={0} h={0} />
      <rect x={0} y={0} w={0} h={0} />
    </>
  );
}

function PanelHeading(): Component {
  const gimLeader: Int = useServerState(CreationVarbits.GIM_LEADER);
  const gimMember: Int = useServerState(CreationVarbits.GIM_MEMBER);

  let heading: String = `<col=ff981f>Form a ${SUBJECT}</col>`;
  if (gimLeader === 1 || gimMember === 1) {
    heading = `<col=ff981f>Create a ${SUBJECT}</col>`;
  }

  return (
    <text
      x={0}
      y={0}
      w="fill"
      h={Layout.TITLE_HEIGHT}
      text={heading}
      font={CreationFonts.TITLE}
      color={CreationColor.HEADING}
      align="center"
      valign="bottom"
      shadow
    />
  );
}

function RefreshButton(): Component {
  const icon = useRef();

  return (
    <layer
      x="right"
      y={0}
      w={Layout.REFRESH_SIZE}
      h={Layout.REFRESH_SIZE}
      options={['Refresh']}
      onMouseRepeat={() => setTransparency(icon, Layout.REFRESH_DIM)}
      onMouseLeave={() => setTransparency(icon, Layout.REFRESH_CLEAR)}
      onOptionSelect={(event) => opsound(event.option, REFRESH_OPSOUND_MASK)}
    >
      <sprite
        ref={icon}
        x="center"
        y="center"
        w={Layout.REFRESH_ICON_WIDTH}
        h={Layout.REFRESH_ICON_HEIGHT}
        sprite={CreationSprites.REFRESH}
      />
    </layer>
  );
}
