import { useServerState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { textWidth } from '../lib/lib.engine';
import { Access, BankColor, BankFonts, BankSprites, BankVarps, Layout } from './shared-bank.constants';

export function CapacityLine(): Component {
  const count: Int = useServerState(BankVarps.ITEM_COUNT);
  const access: Int = useServerState(BankVarps.ACCESS);

  let text: String = '';
  let textHidden: Boolean = false;
  let chestHidden: Boolean = true;
  if (access < Access.DEPOSIT_ONLY) {
    text = '<col=ff0000>View only</col>';
  } else if (access < Access.FULL) {
    text = '<col=ff0000>Deposit only</col>';
  } else if (count <= -1) {
    textHidden = true;
  } else {
    text = groupDigits(count, ',');
    chestHidden = false;
  }

  const width: Int = textWidth(text, Layout.BIGBUTTON_MEASURE, BankFonts.SMALL);

  return (
    <>
      <text
        x={{ right: Layout.CHEST_RIGHT }}
        y={Layout.CHEST_Y}
        w={width}
        h={Layout.CHEST_H}
        text={text}
        font={BankFonts.SMALL}
        color={BankColor.COUNT}
        align="right"
        valign="middle"
        shadow
        hide={textHidden}
      />
      <sprite
        x={{ right: Layout.CHEST_RIGHT + width + Layout.CHEST_GAP }}
        y={Layout.CHEST_Y}
        w={Layout.CHEST_W}
        h={Layout.CHEST_H}
        sprite={BankSprites.CHEST}
        hide={chestHidden}
      />
    </>
  );
}
