import { CS2, useState } from 'ts2';

import { snapshotOpen } from '../lib/game/varcs';
import { onMobile } from '../lib/lib.helpers';
import { mesText2Ref, mesTextRef } from '../0162_chatbox/chatbox.constants';
import { CHAT_LIMIT, KEYBOARD_STRING, keyboardShow, meslayerEcho, meslayerOpen } from '../0162_chatbox/meslayer';

export function meslayerMode11(): void {
  const [snapshot] = useState(snapshotOpen);
  if (snapshot === 1) {
    CS2.if_close();
  }
  meslayerOpen(11);
  mesTextRef.text = 'Show items whose names contain the following text:';
  meslayerEcho('');
  CS2.if_on_key_set(null, mesText2Ref);
  CS2.if_on_dialog_abort_set(null, mesText2Ref);
  if (onMobile()) {
    keyboardShow(KEYBOARD_STRING, CHAT_LIMIT);
  }
}
