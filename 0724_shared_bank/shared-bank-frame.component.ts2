import { SteelBorder } from '../lib/steel-border.component';
import { bankmainFilterString, bankmainSearching } from '../0012_bankmain/bankmain.helpers';
import { BankColor } from './shared-bank.constants';

export function SharedBankFrame(): Component {
  const searching: Boolean = bankmainSearching();
  const filter: String = bankmainFilterString();

  let title: String = 'Group Storage';
  if (searching) {
    if (filter.length > 0) {
      title = `Showing items: <col=ff0000>${filter}</col>`;
    } else {
      title = 'Showing items: <col=ff0000>*</col>';
    }
  }

  return <SteelBorder title={title} titleColor={BankColor.CAPTION} flags={1} />;
}
