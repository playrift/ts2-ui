import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { setTransparency } from '../lib/lib.components';
import {
  BankColor,
  BankFonts,
  BankScrollbar,
  BankSprites,
  ICON_HOVER,
  ICON_REST,
  Layout,
} from './shared-bank.constants';
import {
  capacityRef,
  closeRef,
  countdownRef,
  depositIcon,
  itemsRef,
  mainBankRef,
  occupiedRef,
  searchIcon,
  searchRef,
  shuffleIcon,
  universeRef,
  unlocksIcon,
} from './shared-bank.refs';
import {
  depositFlash,
  sharedBankCloseButton,
  sharedBankSearchReset,
  sharedBankSearchToggle,
} from './shared-bank.state';
import { CapacityLine } from './capacity-line.component';
import { SharedBankCountdown } from './countdown';
import { SharedBankFrame } from './shared-bank-frame.component';
import { SharedBankGrid } from './shared-bank-grid.component';
import { BackToBankButton, NotesToggle, QuantityButtons, SaveButton, SwapInsertToggle } from './bottom-bar.component';

export function SharedBank(): Component {
  return (
    <layer ref={universeRef} x="center" y="center" w="fill" h={Layout.FRAME_H} onLoad={() => sharedBankSearchReset()}>
      <layer x="center" y="center" w="fill" h="fill">
        <SharedBankFrame />
      </layer>

      <sprite
        ref={closeRef}
        x={{ right: 0 }}
        y={0}
        w={1}
        h={1}
        options={['*']}
        onLoad={(event) => sharedBankCloseButton(event.self)}
      />

      <text
        ref={occupiedRef}
        x={Layout.COUNTER_X}
        y={Layout.COUNTER_Y}
        w={Layout.COUNTER_W}
        h={Layout.COUNTER_H}
        font={BankFonts.SMALL}
        color={BankColor.CAPTION}
        shadow
        align="center"
        valign="top"
      />
      <line x={Layout.RULE_X} y={Layout.RULE_Y} w={Layout.RULE_W} color={BankColor.CAPTION} lineWidth={1} />
      <layer x={Layout.COUNTER_X} y={Layout.COUNTER_Y} w={Layout.COUNTER_W} h={Layout.COUNTER_H} noClickThrough>
        <text
          ref={capacityRef}
          x="center"
          y="center"
          w="fill"
          h="fill"
          font={BankFonts.SMALL}
          color={BankColor.CAPTION}
          shadow
          align="center"
          valign="bottom"
        />
      </layer>

      <layer
        static
        ref={countdownRef}
        x={Layout.COUNTDOWN_X}
        y={Layout.COUNTDOWN_Y}
        w={Layout.COUNTDOWN_W}
        h={Layout.COUNTDOWN_H}
      >
        <SharedBankCountdown />
      </layer>

      <layer
        ref={mainBankRef}
        x={Layout.MAIN_BANK_X}
        y={Layout.MAIN_BANK_Y}
        w={Layout.MAIN_BANK_W}
        h={Layout.MAIN_BANK_H}
        noClickThrough
      >
        <BackToBankButton />
      </layer>

      <layer
        static
        ref={itemsRef}
        x="center"
        y={Layout.ITEMS_Y}
        w={{ fill: Layout.ITEMS_INSET }}
        h={{ fill: Layout.ITEMS_DROP }}
      >
        <SharedBankGrid />
      </layer>

      <layer x={{ right: Layout.BAR_RIGHT }} y={Layout.ITEMS_Y} w={Layout.BAR_W} h={{ fill: Layout.ITEMS_DROP }}>
        <ScrollbarVertical
          content={itemsRef}
          track={BankScrollbar.TRACK}
          capTopSprite={BankScrollbar.CAP_TOP}
          thumbSprite={BankScrollbar.THUMB}
          capBottomSprite={BankScrollbar.CAP_BOTTOM}
          arrowUp={BankScrollbar.ARROW_UP}
          arrowDown={BankScrollbar.ARROW_DOWN}
        />
      </layer>

      <sprite
        x={Layout.TOOL_X}
        y={{ bottom: Layout.UNLOCKS_BOTTOM }}
        w={Layout.TOOL}
        h={Layout.TOOL}
        sprite={BankSprites.BUTTON_OFF}
        options={['Storage Unlocks']}
        onMouseEnter={() => setTransparency(unlocksIcon, ICON_HOVER)}
        onMouseLeave={() => setTransparency(unlocksIcon, ICON_REST)}
      />
      <sprite
        ref={unlocksIcon}
        x={Layout.ICON_X}
        y={{ bottom: Layout.UNLOCKS_ICON_BOTTOM }}
        w={Layout.ICON_W}
        h={Layout.ICON_H}
        sprite={BankSprites.UNLOCKS}
        shadowColor={BankColor.SHADOW}
      />

      <sprite
        x={Layout.TOOL_X}
        y={{ bottom: Layout.SHUFFLE_BOTTOM }}
        w={Layout.TOOL}
        h={Layout.TOOL}
        sprite={BankSprites.BUTTON_OFF}
        options={['Shuffle items up']}
        onMouseEnter={() => setTransparency(shuffleIcon, ICON_HOVER)}
        onMouseLeave={() => setTransparency(shuffleIcon, ICON_REST)}
        onOptionSelect={(event) =>
          depositFlash(event.self, BankSprites.BUTTON_ON, BankSprites.BUTTON_OFF, event.option)
        }
      />
      <sprite
        ref={shuffleIcon}
        x={Layout.ICON_X}
        y={{ bottom: Layout.SHUFFLE_ICON_BOTTOM }}
        w={Layout.ICON_W}
        h={Layout.ICON_H}
        sprite={BankSprites.SHUFFLE}
        shadowColor={BankColor.SHADOW}
      />

      <sprite
        ref={searchRef}
        x={Layout.TOOL_X}
        y={{ bottom: Layout.SEARCH_BOTTOM }}
        w={Layout.TOOL}
        h={Layout.TOOL}
        sprite={BankSprites.BUTTON_OFF}
        options={['Search']}
        onMouseEnter={() => setTransparency(searchIcon, ICON_HOVER)}
        onMouseLeave={() => setTransparency(searchIcon, ICON_REST)}
        onOptionSelect={(event) => sharedBankSearchToggle(event.option)}
      />
      <sprite
        ref={searchIcon}
        x={Layout.ICON_X}
        y={{ bottom: Layout.SEARCH_ICON_BOTTOM }}
        w={Layout.ICON_W}
        h={Layout.ICON_H}
        sprite={BankSprites.SEARCH}
        shadowColor={BankColor.SHADOW}
      />

      <sprite
        x={Layout.TOOL_X}
        y={{ bottom: Layout.DEPOSIT_BOTTOM }}
        w={Layout.TOOL}
        h={Layout.TOOL}
        sprite={BankSprites.BUTTON_OFF}
        options={['Deposit inventory']}
        onMouseEnter={() => setTransparency(depositIcon, ICON_HOVER)}
        onMouseLeave={() => setTransparency(depositIcon, ICON_REST)}
        onOptionSelect={(event) =>
          depositFlash(event.self, BankSprites.BUTTON_ON, BankSprites.BUTTON_OFF, event.option)
        }
      />
      <sprite
        ref={depositIcon}
        x={Layout.ICON_X}
        y={{ bottom: Layout.DEPOSIT_ICON_BOTTOM }}
        w={Layout.ICON_W}
        h={Layout.ICON_H}
        sprite={BankSprites.DEPOSIT_INV}
        shadowColor={BankColor.SHADOW}
      />

      <layer
        x="center"
        y={{ bottom: Layout.BOTTOM_BAR_BOTTOM }}
        w={{ fill: Layout.BOTTOM_BAR_INSET }}
        h={Layout.BOTTOM_BAR_H}
      >
        <layer x={Layout.SWAP_CELL_X} y="center" w={Layout.CELL_W} h="fill">
          <SwapInsertToggle />
        </layer>
        <layer x={Layout.NOTE_CELL_X} y="center" w={Layout.CELL_W} h="fill">
          <NotesToggle />
        </layer>
        <layer x={{ right: 0 }} y={Layout.QUANTITY_Y} w={Layout.QUANTITY_W} h="fill">
          <QuantityButtons />
        </layer>
        <text
          x={Layout.SAVE_TEXT_X}
          y={0}
          w={{ fill: Layout.SAVE_TEXT_INSET }}
          h={Layout.SAVE_TEXT_H}
          text="Save your changes"
          font={BankFonts.SMALL}
          color={BankColor.WHITE}
          shadow
          align="center"
          valign="middle"
        />
        <layer x={Layout.SAVE_X} y={{ bottom: 0 }} w={Layout.SAVE_W} h={{ fill: Layout.SAVE_DROP }}>
          <SaveButton />
        </layer>
      </layer>

      <layer x={{ center: Layout.SPARE_OFFSET }} y={{ center: Layout.SPARE_OFFSET }} w="fill" h="fill" />

      <CapacityLine />
    </layer>
  );
}
