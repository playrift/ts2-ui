import { useServerState, useState } from 'ts2';
import { onMobile, opsound } from '../lib/lib.helpers';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import {
  BUTTON_OPSOUND_MASK,
  Copy,
  GimSidepanelFonts,
  GimSidepanelVarbits,
  InvitationStatus,
} from './gim-sidepanel.constants';

export function InviteButton(): Component {
  const invitation: Int = useServerState(GimSidepanelVarbits.INVITATION);
  const [pressed, setPressed] = useState(0);

  let live: Int = 0;
  let label: String = Copy.DEAD;
  let option: String = Copy.INVITE;
  if (invitation === InvitationStatus.INVITING) {
    live = 1;
    label = Copy.INVITING;
    option = 'Inviting';
  } else if (invitation === InvitationStatus.NOT_INVITING) {
    live = 1;
    label = Copy.NOT_INVITING;
    option = 'Not inviting';
  }

  let skin: Int = 1;
  if (live === 1) {
    skin = pressed;
  }

  if (live === 0) {
    return (
      <layer w="fill" h="fill" options={[option]} onOptionSelect={() => opsound(0, 0)}>
        <StoneButtonDraw label={label} font={GimSidepanelFonts.BODY} pressed={skin} />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[option]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, BUTTON_OPSOUND_MASK)}
    >
      <StoneButtonDraw label={label} font={GimSidepanelFonts.BODY} pressed={skin} />
    </layer>
  );
}

export function SettingsButton(): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;
  return (
    <layer
      w="fill"
      h="fill"
      options={['Settings']}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, BUTTON_OPSOUND_MASK)}
    >
      <StoneButtonDraw label={Copy.SETTINGS} font={GimSidepanelFonts.BODY} pressed={skin} />
    </layer>
  );
}
