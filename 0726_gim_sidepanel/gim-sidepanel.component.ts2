import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { RefreshButton } from '../0701_clans_sidepanel/refresh-button.component';
import { InviteButton, SettingsButton } from './gim-buttons.component';
import { GimSubtitle, GimTitle } from './gim-header.component';
import { GimRoster } from './gim-roster.component';
import { BACKDROP_TRANSPARENCY, GimSidepanelColor, Layout } from './gim-sidepanel.constants';

export function GimSidepanel(): Component {
  return (
    <>
      <layer x={0} y={0} w={{ fill: Layout.title.inset }} h={Layout.title.h}>
        <GimTitle />
      </layer>

      <layer x="right" y={0} w={Layout.refresh.size} h={Layout.refresh.size}>
        <RefreshButton />
      </layer>

      <layer x={0} y={Layout.subtitle.y} w={{ fill: Layout.subtitle.inset }} h={Layout.subtitle.h}>
        <GimSubtitle />
      </layer>

      <layer x="center" y={Layout.frame.y} w={{ fill: Layout.frame.inset }} h={{ fill: Layout.frame.drop }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.backdrop.inset }}
          h={{ fill: Layout.backdrop.inset }}
          fill
          color={GimSidepanelColor.BACKDROP}
          transparency={BACKDROP_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.list.inset }} h={{ fill: Layout.list.inset }}>
          <GimRoster />
        </layer>

        <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
      </layer>

      <layer x={Layout.button.x} y={{ bottom: Layout.button.bottom }} w={Layout.button.w} h={Layout.button.h}>
        <InviteButton />
      </layer>

      <layer
        x={{ right: Layout.button.x }}
        y={{ bottom: Layout.button.bottom }}
        w={Layout.button.w}
        h={Layout.button.h}
      >
        <SettingsButton />
      </layer>
    </>
  );
}
