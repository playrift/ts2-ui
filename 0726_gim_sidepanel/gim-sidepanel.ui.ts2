import { createRef } from 'ts2';
import { GimSidepanel } from './gim-sidepanel.component';
import { Layout } from './gim-sidepanel.constants';

const gimSidepanelRef = createRef('gim_sidepanel');

export const gimSidepanelUi = (): UI => (
