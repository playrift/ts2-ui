import { sessionState, useState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';

export const popoutTipLeft = sessionState('');
export const popoutTipRight = sessionState('');
export const popoutTipAnchorY = sessionState(-1);
export const popoutTipDeadline = sessionState(-1);

export function showPopoutTip(left: String, right: String, anchorY: Int): void {
  clearPopoutTip();
  const [, setLeft] = useState(popoutTipLeft);
  const [, setRight] = useState(popoutTipRight);
  const [, setAnchor] = useState(popoutTipAnchorY);
  const [, setDeadline] = useState(popoutTipDeadline);
  setLeft(left);
  setRight(right);
  setAnchor(anchorY);
  if (onMobile()) {
    setDeadline(clientClock() + 240);
  }
}

export function clearPopoutTip(): void {
  const [, setLeft] = useState(popoutTipLeft);
  const [, setRight] = useState(popoutTipRight);
  const [, setDeadline] = useState(popoutTipDeadline);
  setLeft('');
  setRight('');
  setDeadline(-1);
}

export function tickPopoutTip(): void {
  const [deadline] = useState(popoutTipDeadline);
  if (deadline < 0 || clientClock() < deadline) {
    return;
  }
  clearPopoutTip();
}
