export function trackerPosition(skill: Int): Int {
  switch (skill) {
    case -1: {
      const [v] = useState(xptrackerPositionOverall);
      return v;
    }
    case 0: {
      const [v] = useState(xptrackerPositionAttack);
      return v;
    }
    case 2: {
      const [v] = useState(xptrackerPositionStrength);
      return v;
    }
    case 1: {
      const [v] = useState(xptrackerPositionDefence);
      return v;
    }
    case 4: {
      const [v] = useState(xptrackerPositionRanged);
      return v;
    }
    case 5: {
      const [v] = useState(xptrackerPositionPrayer);
      return v;
    }
    case 6: {
      const [v] = useState(xptrackerPositionMagic);
      return v;
    }
    case 20: {
      const [v] = useState(xptrackerPositionRunecraft);
      return v;
    }
    case 22: {
      const [v] = useState(xptrackerPositionConstruction);
      return v;
    }
    case 3: {
      const [v] = useState(xptrackerPositionHitpoints);
      return v;
    }
    case 16: {
      const [v] = useState(xptrackerPositionAgility);
      return v;
    }
    case 15: {
      const [v] = useState(xptrackerPositionHerblore);
      return v;
    }
    case 17: {
      const [v] = useState(xptrackerPositionThieving);
      return v;
    }
    case 12: {
      const [v] = useState(xptrackerPositionCrafting);
      return v;
    }
    case 9: {
      const [v] = useState(xptrackerPositionFletching);
      return v;
    }
    case 18: {
      const [v] = useState(xptrackerPositionSlayer);
      return v;
    }
    case 21: {
      const [v] = useState(xptrackerPositionHunter);
      return v;
    }
    case 14: {
      const [v] = useState(xptrackerPositionMining);
      return v;
    }
    case 13: {
      const [v] = useState(xptrackerPositionSmithing);
      return v;
    }
    case 10: {
      const [v] = useState(xptrackerPositionFishing);
      return v;
    }
    case 7: {
      const [v] = useState(xptrackerPositionCooking);
      return v;
    }
    case 11: {
      const [v] = useState(xptrackerPositionFiremaking);
      return v;
    }
    case 8: {
      const [v] = useState(xptrackerPositionWoodcutting);
      return v;
    }
    case 19: {
      const [v] = useState(xptrackerPositionFarming);
      return v;
    }
    case 23: {
      const [v] = useState(xptrackerPositionSailing);
      return v;
    }
  }
  return 0;
}

export function setTrackerPosition(skill: Int, value: Int): void {
  switch (skill) {
    case -1: {
      const [, set] = useState(xptrackerPositionOverall);
      set(value);
      return;
    }
    case 0: {
      const [, set] = useState(xptrackerPositionAttack);
      set(value);
      return;
    }
    case 2: {
      const [, set] = useState(xptrackerPositionStrength);
      set(value);
      return;
    }
    case 1: {
      const [, set] = useState(xptrackerPositionDefence);
      set(value);
      return;
    }
    case 4: {
      const [, set] = useState(xptrackerPositionRanged);
      set(value);
      return;
    }
    case 5: {
      const [, set] = useState(xptrackerPositionPrayer);
      set(value);
      return;
    }
