    }
    case 20: {
      const [, set] = useState(xptrackerPositionRunecraft);
      set(value);
      return;
    }
    case 22: {
      const [, set] = useState(xptrackerPositionConstruction);
      set(value);
      return;
    }
    case 3: {
      const [, set] = useState(xptrackerPositionHitpoints);
      set(value);
      return;
    }
    case 16: {
      const [, set] = useState(xptrackerPositionAgility);
      set(value);
      return;
    }
    case 15: {
      const [, set] = useState(xptrackerPositionHerblore);
      set(value);
      return;
    }
    case 17: {
      const [, set] = useState(xptrackerPositionThieving);
      set(value);
      return;
    }
    case 12: {
      const [, set] = useState(xptrackerPositionCrafting);
      set(value);
      return;
    }
    case 9: {
      const [, set] = useState(xptrackerPositionFletching);
      set(value);
      return;
    }
    case 18: {
      const [, set] = useState(xptrackerPositionSlayer);
      set(value);
      return;
    }
    case 21: {
      const [, set] = useState(xptrackerPositionHunter);
      set(value);
      return;
    }
    case 14: {
      const [, set] = useState(xptrackerPositionMining);
      set(value);
      return;
    }
    case 13: {
      const [, set] = useState(xptrackerPositionSmithing);
      set(value);
      return;
    }
    case 10: {
      const [, set] = useState(xptrackerPositionFishing);
      set(value);
      return;
    }
    case 7: {
      const [, set] = useState(xptrackerPositionCooking);
      set(value);
      return;
    }
    case 11: {
      const [, set] = useState(xptrackerPositionFiremaking);
      set(value);
      return;
    }
    case 8: {
      const [, set] = useState(xptrackerPositionWoodcutting);
      set(value);
      return;
    }
    case 19: {
      const [, set] = useState(xptrackerPositionFarming);
      set(value);
      return;
    }
    case 23: {
      const [, set] = useState(xptrackerPositionSailing);
      set(value);
