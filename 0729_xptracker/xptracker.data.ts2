export const DEFAULT_HITPOINTS_RATE = 4;

export function combatStyleRate(category: Int, style: Int, skill: Int): Int {
  const slot: Int = CombatCategorySlot.get(category) ?? -1;
  if (slot < 0) {
    return 0;
  }
  if (style < 0 || style > 5) {
    if (skill === 3) {
      return DEFAULT_HITPOINTS_RATE;
    }
    return 0;
  }
  const row: CombatStyleRow | null = CombatStyleRates.at(slot * 6 + style);
  if (row === null) {
    return 0;
  }
  switch (skill) {
    case 0:
      return row.attack;
    case 2:
      return row.strength;
    case 1:
      return row.defence;
    case 3:
      return row.hitpoints;
    case 4:
      return row.ranged;
  }
  return 0;
}

