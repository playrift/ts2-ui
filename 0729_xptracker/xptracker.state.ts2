import { useServerState, useState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { SkillByIndex } from '../lib/skills.data';
import { Varps } from '../lib/game/varps';
import {
  xptrackerCurrentId,
  xptrackerHasCheckedLogin,
  xptrackerInit,
  xptrackerLastCombatStyle,
  xptrackerNeedsVarReset,
} from '../lib/game/varcs';
import {
  setTrackerDrop,
  setTrackerLastXp,
  setTrackerPaused,
  setTrackerPosition,
  setTrackerStartXp,
  setTrackerTimeTrained,
  setTrackerUpdated,
  trackerDrop,
  trackerLastXp,
  trackerPaused,
  trackerPosition,
  trackerTimeTrained,
  trackerUpdated,
} from './xptracker.cells';
import { TrackedSkill, refreshTrackerLastHp, trackerIsCombat, trackerXp } from './xptracker.helpers';
import { TrackerSkillOrder } from './xptracker.data';

export function nextTrackerId(): Int {
  const [count, setCount] = useState(xptrackerCurrentId);
  let next: Int = count;
  if (next <= 0) {
    next = 1;
  }
  setCount(next + 1);
  return next;
}

export function xptrackerOpen(): void {
  setTrackerPosition(TrackedSkill.OVERALL, 0);
  renumberTrackers();
}

export function renumberTrackers(): void {
  const [, setCount] = useState(xptrackerCurrentId);
  setCount(1);
  let row: Int = 1;
  while (row <= 24) {
    const skill: Int = trackerAtPosition(row);
    if (skill !== TrackedSkill.OVERALL) {
      setTrackerPosition(skill, nextTrackerId());
      row = row + 1;
    } else {
      row = 25;
    }
  }
}

export function trackerAtPosition(row: Int): Int {
  let i: Int = 0;
  while (i < 24) {
    const skill: Int = TrackerSkillOrder.at(i) ?? -1;
    if (trackerPosition(skill) === row) {
      return skill;
    }
    i = i + 1;
  }
  return TrackedSkill.OVERALL;
}

export function addTracker(skill: Int): void {
  setTrackerPosition(skill, nextTrackerId());
}

export function clearTrackerDrops(skill: Int): void {
  let slot: Int = 0;
  while (slot < 10) {
    setTrackerDrop(skill, slot, 0);
    slot = slot + 1;
  }
}

export function pushTrackerDrop(skill: Int, drop: Int): void {
  let slot: Int = 9;
  while (slot > 0) {
    setTrackerDrop(skill, slot, trackerDrop(skill, slot - 1));
    slot = slot - 1;
  }
  setTrackerDrop(skill, 0, drop);
}

export function resetTracker(skill: Int, close: Int, xp: Int): void {
  if (skill !== TrackedSkill.OVERALL) {
    clearTrackerDrops(skill);
  }
  setTrackerStartXp(skill, xp);
  setTrackerLastXp(skill, xp);
  setTrackerTimeTrained(skill, -1);
  setTrackerPaused(skill, 0);
  setTrackerUpdated(skill, 0);
  if (close === 1) {
    setTrackerPosition(skill, -1);
  }
}

export function closeAllTrackersBut(keep: Int, close: Int): void {
  let key: Int = 1;
  let total: Int = 0;
  while (key <= 24) {
    const skill: Int = (SkillByIndex.get(key) ?? -1) as Int;
    if (skill !== keep) {
      resetTracker(skill, close, trackerXp(skill));
    } else if (close === 1) {
      setTrackerPosition(skill, 1);
    }
    total = total + trackerXp(skill);
    key = key + 1;
  }
  if (keep === TrackedSkill.OVERALL) {
    resetTracker(TrackedSkill.OVERALL, 0, total);
  }
  renumberTrackers();
}

export function closeTracker(skill: Int): void {
  const row: Int = trackerPosition(skill);
  resetTracker(skill, 1, trackerXp(skill));
  let key: Int = 0;
  while (key <= 24) {
    const other: Int = (SkillByIndex.get(key) ?? -1) as Int;
    const at: Int = trackerPosition(other);
    if (at > row) {
      setTrackerPosition(other, at - 1);
    }
    key = key + 1;
  }
  renumberTrackers();
}

export function pauseTracker(skill: Int, paused: Int): void {
  setTrackerPaused(skill, paused);
}

export function pauseOverall(all: Int, paused: Int): void {
  setTrackerPaused(TrackedSkill.OVERALL, paused);
  if (all === 1) {
    let key: Int = 1;
    while (key <= 24) {
      pauseTracker((SkillByIndex.get(key) ?? -1) as Int, paused);
      key = key + 1;
    }
  }
}

export function selectTrackerOption(option: Int, skill: Int): void {
  if (option === 8) {
    closeTracker(skill);
  } else if (option === 9) {
    closeAllTrackersBut(skill, 1);
  } else if (option === 10) {
    pauseTracker(skill, 1 - trackerPaused(skill));
  }
}

export function selectOverallOption(option: Int): void {
  if (option === 7) {
    closeAllTrackersBut(TrackedSkill.OVERALL, 1);
  } else if (option === 8) {
    pauseOverall(1, 1 - trackerPaused(TrackedSkill.OVERALL));
  }
}

export const TRACKER_ROW_STEP = 50;

export function trackerDropRow(mouseY: Int): Int {
  const [count] = useState(xptrackerCurrentId);
  let row: Int = (mouseY + TRACKER_ROW_STEP / 2) / TRACKER_ROW_STEP;
  if (row < 1) {
    row = 1;
  }
  if (row >= count) {
    row = count - 1;
  }
  return row;
}

export function dropTracker(mouseY: Int, from: Int, skill: Int): void {
  const target: Int = trackerDropRow(mouseY);
  let occupied: Boolean = false;
  let key: Int = 0;
  while (key <= 24) {
    const other: Int = (SkillByIndex.get(key) ?? -1) as Int;
    if (other !== TrackedSkill.OVERALL && trackerPosition(other) === target) {
      occupied = true;
    }
    key = key + 1;
  }
  if (!occupied) {
    return;
  }
  setTrackerPosition(skill, target);
  key = 1;
  while (key <= 24) {
    const other: Int = (SkillByIndex.get(key) ?? -1) as Int;
    const at: Int = trackerPosition(other);
    if (target < from) {
      if (at >= target && at <= from && other !== skill) {
        setTrackerPosition(other, at + 1);
      }
    } else if (from < target && at <= target && at >= from && other !== skill) {
      setTrackerPosition(other, at - 1);
    }
    key = key + 1;
  }
  renumberTrackers();
}

export function xptrackerSkillTransmit(): void {
  const [checked] = useState(xptrackerHasCheckedLogin);
  if (checked === 0) {
    return;
  }
  const [init, setInit] = useState(xptrackerInit);
  const [needsReset, setNeedsReset] = useState(xptrackerNeedsVarReset);
  let reset: Int = needsReset;
  if (init === 0) {
    reset = 1;
  }
  if (reset === 1) {
    closeAllTrackersBut(TrackedSkill.OVERALL, 1);
    setNeedsReset(0);
    setInit(1);
    const [, setCount] = useState(xptrackerCurrentId);
    setCount(1);
  }
  refreshTrackerLastHp();
  const style: Int = useServerState(Varps.COM_MODE);
  const [lastStyle, setLastStyle] = useState(xptrackerLastCombatStyle);
  let styleMoved: Int = 0;
  let key: Int = 1;
  while (key <= 24) {
    const skill: Int = (SkillByIndex.get(key) ?? -1) as Int;
    const xp: Int = trackerXp(skill);
    const last: Int = trackerLastXp(skill);
    if (xp < last) {
      closeTracker(skill);
      resetTracker(TrackedSkill.OVERALL, 0, xp);
    } else if (xp !== last) {
      pushTrackerDrop(skill, xp - last);
      setTrackerLastXp(TrackedSkill.OVERALL, xp - last + trackerLastXp(TrackedSkill.OVERALL));
      setTrackerLastXp(skill, xp);
      if (trackerPosition(skill) < 0) {
        pauseTracker(skill, 0);
        setTrackerTimeTrained(skill, 0);
        addTracker(skill);
      } else {
        pauseTracker(skill, 0);
        if (trackerTimeTrained(skill) < 0) {
          setTrackerTimeTrained(skill, 0);
        }
        setTrackerUpdated(skill, 1);
        if (trackerUpdated(TrackedSkill.OVERALL) === 0) {
          setTrackerUpdated(TrackedSkill.OVERALL, 1);
        }
      }
      if (trackerPaused(TrackedSkill.OVERALL) === 1) {
        pauseOverall(0, 0);
      }
      if (trackerTimeTrained(TrackedSkill.OVERALL) < 0) {
        setTrackerTimeTrained(TrackedSkill.OVERALL, 0);
      }
    } else if (lastStyle !== style && trackerIsCombat(skill)) {
      styleMoved = 1;
    }
    key = key + 1;
  }
  if (styleMoved === 1) {
    setLastStyle(style);
  }
}

export function xptrackerTick(): void {
  if (clientClock() % 60 !== 0) {
    return;
  }
  let key: Int = 1;
  while (key <= 24) {
    stepTracker((SkillByIndex.get(key) ?? -1) as Int);
    key = key + 1;
  }
  stepTracker(TrackedSkill.OVERALL);
}

function stepTracker(skill: Int): void {
  if (trackerTimeTrained(skill) >= 0 && trackerPaused(skill) === 0) {
    setTrackerTimeTrained(skill, trackerTimeTrained(skill) + 60);
    if (trackerUpdated(skill) !== 0) {
      setTrackerUpdated(skill, 0);
    }
  }
}
