import { createRef } from 'ts2';

import { Xptracker } from './xptracker.component';
import { xptrackerOpen } from './xptracker.state';

const xptrackerRef = createRef('xptracker');

export const xptrackerUi = (): UI => (
  <ui ref={xptrackerRef} x="center" y="center">
    <layer x={0} y={0} w={0} h={0} onLoad={() => xptrackerOpen()} />
    <Xptracker />
  </ui>
);
