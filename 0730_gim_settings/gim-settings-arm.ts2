import { CS2 } from 'ts2';

import { AFFINITY_LIVE, GimArm } from './gim-settings.constants';

export function gimSettingsArm(asGuest: Int, guestStatus: Int, status: Int): Int {
  if (asGuest === 1) {
    if (guestStatus === AFFINITY_LIVE) {
      if (CS2.activeclansettings_listened_find()) {
        return GimArm.GUEST;
      }
    }
  }
  if (asGuest === 0) {
    if (status === AFFINITY_LIVE) {
      if (CS2.activeclansettings_affined_find(1)) {
        return GimArm.MEMBER;
      }
    }
  }
  return GimArm.NONE;
}
