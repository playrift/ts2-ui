import { CS2, createRef, useServerState } from 'ts2';

import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { pvpaStatusText } from '../0762_pvp_arena_sidepanel/pvp-arena-sidepanel.helpers';
import { GimIcon } from './gim-icon.component';
import { GimSettingsButton } from './gim-settings-button.component';
import { gimSettingsArm } from './gim-settings-arm';
import {
  GimArm,
  GimArt,
  GimFonts,
  GimSlot,
  GimVarbits,
  Layout,
  LOADING_COLOR,
  LOADING_TEXT,
  STEELBORDER_FLAGS,
} from './gim-settings.constants';

const infoContainer = createRef('gim_settings_info_container');
const buttonContainer = createRef('gim_settings_button_container');

export function GimSettings(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h="fill">
      <GimSettingsFrame />

      <sprite x={{ right: Layout.CLOSE_RIGHT }} y="top" w={Layout.CLOSE_SIZE} h={Layout.CLOSE_SIZE} options={['*']} />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET_W }}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <layer x="right" y="center" w={Layout.ICONS_W} h={Layout.ICONS_H}>
          <GimIcon />
        </layer>

        <layer
          static
          ref={infoContainer}
          x={{ right: Layout.INFO_RIGHT }}
          y="center"
          w={{ fill: Layout.INFO_INSET_W }}
          h="fill"
          hide
        >
          <layer x="center" y="top" w="fill" h="fill">
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={GimArt.INFO_BACKING}
              tiling
            />
          </layer>

          <layer x="center" y="bottom" w="fill" h="fill">
            <layer
              x={Layout.EDITABLE_X}
              y="center"
              w={{ fill: Layout.EDITABLE_INSET_W }}
              h={{ fill: Layout.EDITABLE_INSET_H }}
            >
              <GimSettingRow />
              <GimSettingRow />
              <GimSettingRow />
            </layer>

            <layer x={{ right: Layout.BAR_RIGHT }} y="center" w={Layout.BAR_W} h={{ fill: Layout.BAR_INSET_H }} />

            <ThinBoxEntrypoint />
          </layer>
        </layer>

        <layer static ref={buttonContainer} x="left" y="center" w={Layout.BUTTON_COLUMN_W} h="fill" hide>
          <GimSettingsButton slot={GimSlot.HISCORES} x="center" y="top" w="fill" h={Layout.BUTTON_H} />
          <GimSettingsButton slot={GimSlot.STORAGE} x="center" y={Layout.BUTTON_STRIDE} w="fill" h={Layout.BUTTON_H} />
          <GimSettingsButton
            slot={GimSlot.OPTIONS}
            x="center"
            y={Layout.BUTTON_STRIDE * 2}
            w="fill"
            h={Layout.BUTTON_H}
          />
          <GimSettingsButton
            slot={GimSlot.RAFFLE}
            x="center"
            y={Layout.BUTTON_STRIDE * 3}
            w="fill"
            h={Layout.BUTTON_H}
            hide
          />
          <GimSettingsButton slot={GimSlot.QUIT} x="center" y={Layout.QUIT_Y} w="fill" h={Layout.BUTTON_H} />
        </layer>

        <GimSettingsLoading />
      </layer>

      <layer x="center" y="center" w="fill" h="fill" />
    </layer>
  );
}

function setContainerHidden(target: ComponentId, hidden: Boolean): void {
  target.hide = hidden;
}

function GimSettingRow(): Component {
  return <layer x="center" y="top" w="fill" h={0} options={['*']} />;
}

export function GimSettingsFrame(): Component {
  const asGuest: Int = useServerState(GimVarbits.LOAD_AS_GUEST);
  const guestStatus: Int = useServerState(GimVarbits.GUEST_AFFINITY);
  const status: Int = useServerState(GimVarbits.AFFINITY);

  let title: String = gimStatusText(asGuest, guestStatus, status);
  if (gimSettingsArm(asGuest, guestStatus, status) !== GimArm.NONE) {
    title = CS2.activeclansettings_clan_name_get();
  }

  return (
    <layer w="fill" h="fill">
      <SteelBorder title={title} titleColor={SteelborderColor.TITLE} flags={STEELBORDER_FLAGS} />
    </layer>
  );
}

export function gimStatusText(asGuest: Int, guestStatus: Int, status: Int): String {
  if (asGuest === 1) {
    return pvpaStatusText(guestStatus);
  }
  return pvpaStatusText(status);
}

export function GimSettingsLoading(): Component {
  const asGuest: Int = useServerState(GimVarbits.LOAD_AS_GUEST);
  const guestStatus: Int = useServerState(GimVarbits.GUEST_AFFINITY);
  const status: Int = useServerState(GimVarbits.AFFINITY);
  const arm: Int = gimSettingsArm(asGuest, guestStatus, status);

  let containersHidden: Boolean = true;
  let loadingHidden: Boolean = false;
  if (arm !== GimArm.NONE) {
    containersHidden = false;
    loadingHidden = true;
  }

  setContainerHidden(infoContainer, containersHidden);
  setContainerHidden(buttonContainer, containersHidden);

  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={LOADING_TEXT}
      font={GimFonts.LABEL}
      color={LOADING_COLOR}
      align="center"
      valign="middle"
      shadow
      hide={loadingHidden}
    />
  );
}
