import { createRef } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { Monitor, MonitorColors, MonitorFonts } from './ge-itemsink-monitor.constants';

const geItemsinkMonitor = createRef('ge_itemsink_monitor');

export function GeItemsinkMonitor(): Component {
  return (
    <layer x="center" y="center" w="fill" h={Monitor.PANEL_H}>
      <SteelBorderEntrypoint title="Grand Exchange Item Sink Monitoring" />

      <layer x={Monitor.OP_X} y={Monitor.OP_Y} w={Monitor.OP_W} h={Monitor.OP_H} options={['*']} />

      <layer
        x="center"
        y={{ bottom: Monitor.BODY_BOTTOM }}
        w={{ fill: Monitor.BODY_INSET_W }}
        h={{ fill: Monitor.BODY_INSET_H }}
      >
        <rect
          x={Monitor.DIV_1_X}
          y="center"
          w={Monitor.DIV_1_W}
          h="fill"
          fill
          color={MonitorColors.DIVIDER}
          transparency={MonitorColors.DIVIDER_FADE}
        />
        <rect
          x={Monitor.DIV_2_X}
          y="center"
          w={{ fill: Monitor.DIV_2_INSET_W }}
          h="fill"
          fill
          color={MonitorColors.DIVIDER}
          transparency={MonitorColors.DIVIDER_FADE}
        />

        <layer x="center" y={0} w="fill" h={Monitor.HEAD_H}>
          <text
            x={Monitor.NAME_X}
            y="center"
            w={Monitor.NAME_W}
            h="fill"
            font={MonitorFonts.ROW}
            color={MonitorColors.LABEL}
            shadow
            valign="middle"
            text=""
          />
          <text
            x={Monitor.VALUE_X}
            y={0}
            w={Monitor.VALUE_W}
            h="fill"
            font={MonitorFonts.HEADING}
            color={MonitorColors.LABEL}
            shadow
            align="center"
            valign="middle"
            text="Coffer <col=9f9f9f>Value</col>"
          />
          <text
            x={Monitor.QUOTA_X}
            y={0}
            w={Monitor.QUOTA_W}
            h="fill"
            font={MonitorFonts.HEADING}
            color={MonitorColors.LABEL}
            shadow
            align="center"
            valign="middle"
            text="Sunk <col=9f9f9f>Quota</col>"
          />
          <text
            x={Monitor.RATES_X}
            y={0}
            w={{ fill: Monitor.RATES_INSET_W }}
            h="fill"
            font={MonitorFonts.HEADING}
            color={MonitorColors.LABEL}
            shadow
            align="center"
            valign="middle"
            text="Time <col=9f9f9f>x</col> Rates"
          />
          <ThinStoneBoxEntrypoint />
        </layer>

        <layer
          x={Monitor.LIST_X}
          y={{ bottom: Monitor.LIST_BOTTOM }}
          w={{ fill: Monitor.LIST_INSET_W }}
          h={{ fill: Monitor.LIST_INSET_H }}
        />
        <layer
          x={{ right: Monitor.BAR_RIGHT }}
          y={{ bottom: Monitor.BAR_BOTTOM }}
          w={Monitor.BAR_W}
          h={{ fill: Monitor.BAR_INSET_H }}
        />

        <ThinStoneBoxEntrypoint />
      </layer>

      <layer x="center" y="center" w="fill" h="fill" />
    </layer>
  );
}

export const geItemsinkMonitorUi = (): UI => (
  <ui ref={geItemsinkMonitor} w={Monitor.ROOT_W} x="center" y="center">
    <GeItemsinkMonitor />
  </ui>
);
