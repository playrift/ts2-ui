import { useState } from 'ts2';

import { Layout, UnlockColor, UnlockFonts, UnlockSprites } from './league-3-unlocks.constants';

export function BossRow({
  icon,
  name,
  cost,
  colour,
  selected,
  unlocked,
  index,
  swap,
}: {
  icon: Sprite;
  name: String;
  cost: Int;
  colour: Int;
  selected: Int;
  unlocked: Int;
  index: Int;
  swap: Boolean;
}): Component {
  const [hovered, setHovered] = useState(0);

  const y: Int = index * Layout.ROW_H;
  const hoverable: Boolean = selected === 0 ? swap : false;

  let alpha: Int = 160;
  if (selected === 0) {
    alpha = index % 2 === 0 ? 200 : 220;
  }
  const backing: Int = hovered === 1 ? UnlockColor.WHITE : UnlockColor.BLACK;

  return (
    <>
      <rect
        x={0}
        y={y}
        w="fill"
        h={Layout.ROW_H}
        fill
        color={backing}
        transparency={alpha}
        options={selected === 0 ? ['Select'] : ['']}
        optionSubject={`<col=ff9040>${name}</col>`}
        onMouseEnter={hoverable ? () => setHovered(1) : undefined}
        onMouseLeave={hoverable ? () => setHovered(0) : undefined}
      />

      <sprite x={10} y={y + 4} w={25} h={25} sprite={icon} tiling />

      <text
        x={45}
        y={y}
        w={{ fill: 85 }}
        h={Layout.ROW_H}
        align="left"
        valign="middle"
        shadow
        font={UnlockFonts.BOLD}
        color={unlocked === 1 ? UnlockColor.MUTED : colour}
        text={name}
      />

      {unlocked === 1 ? (
        <sprite x={280} y={y + 7} w={17} h={17} sprite={UnlockSprites.OWNED_TICK} tiling />
      ) : (
        <text
          x={{ right: 10 }}
          y={y}
          w={27}
          h={Layout.ROW_H}
          align="right"
          valign="middle"
          shadow
          font={UnlockFonts.BOLD}
          color={colour}
          text={stringOf(cost)}
        />
      )}
    </>
  );
}
