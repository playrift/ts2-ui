import type { ButtonStyleRow } from './button-styles.data';

export function CappedStructBox({
  x,
  y,
  w,
  h,
  style,
}: {
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  style: ButtonStyleRow;
}): Component {
  const b: Int = style.border;
  const halfW: Int = (w - 3 * b) / 2;
  const halfH: Int = (h - 3 * b) / 2 + (b % 2 !== h % 2 ? 1 : 0);

  return (
    <>
      <sprite x={x + b} y={y + b} w={w - 2 * b} h={h - 2 * b} sprite={style.fill} tiling />

      <sprite x={x + b} y={y} w={halfW} h={b} sprite={style.edgeTop} tiling />
      <sprite x={x + w - halfW - b} y={y} w={halfW} h={b} sprite={style.edgeTop} tiling />
      <sprite x={x + w / 2 - b / 2} y={y} w={b} h={b} sprite={style.capTop} tiling />

      <sprite x={x + b} y={y + h - b} w={halfW} h={b} sprite={style.edgeBottom} tiling />
      <sprite x={x + w - halfW - b} y={y + h - b} w={halfW} h={b} sprite={style.edgeBottom} tiling />
      <sprite x={x + w / 2 - b / 2} y={y + h - b} w={b} h={b} sprite={style.capBottom} tiling />

      <sprite x={x} y={y + b} w={b} h={halfH} sprite={style.edgeLeft} tiling />
      <sprite x={x} y={y + h - halfH - b} w={b} h={halfH} sprite={style.edgeLeft} tiling />
      <sprite x={x} y={y + h / 2 - b / 2} w={b} h={b} sprite={style.capLeft} tiling />

      <sprite x={x + w - b} y={y + b} w={b} h={halfH} sprite={style.edgeRight} tiling />
      <sprite x={x + w - b} y={y + h - halfH - b} w={b} h={halfH} sprite={style.edgeRight} tiling />
      <sprite x={x + w - b} y={y + h / 2 - b / 2} w={b} h={b} sprite={style.capRight} tiling />

      <sprite x={x} y={y} w={b} h={b} sprite={style.cornerTl} tiling />
      <sprite x={x + w - b} y={y} w={b} h={b} sprite={style.cornerTr} tiling />
      <sprite x={x} y={y + h - b} w={b} h={b} sprite={style.cornerBl} tiling />
      <sprite x={x + w - b} y={y + h - b} w={b} h={b} sprite={style.cornerBr} tiling />
    </>
  );
}
