import { useDerived, useRef, useServerState } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBox } from '../lib/thin-box.component';
import { BossRow } from './boss-row.component';
import { BossUnlocks } from './boss-unlocks.data';
import { Layout, UnlockSprites, UnlockTab, UnlockVarps } from './league-3-unlocks.constants';
import { desktop, leagueBossUnlocked, questCost } from './league-3-unlocks.helpers';
import { leagueSkillUnlocked } from '../0240_xpreward/xpreward.helpers';
import { QuestRow } from './quest-row.component';
import { QuestUnlocks } from './quest-unlocks.data';
import { SkillTile } from './skill-tile.component';
import { SkillUnlocks } from './skill-unlocks.data';

export function SkillsContent({ colour, selection }: { colour: Int; selection: Int }): Component {
  const swap: Boolean = desktop();
  return (
    <layer x={Layout.SKILLS_X} y={Layout.SKILLS_Y} w={Layout.SKILLS_W} h={Layout.SKILLS_H}>
      {SkillUnlocks.map((row, key) => (
        <SkillTile
          icon={row.icon}
          name={row.name}
          cost={row.cost}
          colour={colour}
          selected={key + 1 === selection ? 1 : 0}
          unlocked={useDerived(() => leagueSkillUnlocked(row.skill))}
          index={key}
          swap={swap}
        />
      ))}
    </layer>
  );
}

export function BossesContent({ colour, selection }: { colour: Int; selection: Int }): Component {
  const list = useRef();
  const swap: Boolean = desktop();
  return (
    <>
      <layer
        ref={list}
        x={Layout.LIST_X}
        y={Layout.LIST_Y}
        w={Layout.LIST_W}
        h={Layout.LIST_H}
        scrollHeight={BossUnlocks.length * Layout.ROW_H}
      >
        {BossUnlocks.map((row, key) => (
          <BossRow
            icon={row.icon}
            name={row.name}
            cost={row.cost}
            colour={colour}
            selected={key + 1 === selection ? 1 : 0}
            unlocked={useDerived(() => leagueBossUnlocked(row.npc))}
            index={key}
            swap={swap}
          />
        ))}
      </layer>

      <layer x={134} y={49} w={311} h={148}>
        <ThinBox />
      </layer>

      <layer x={444} y={49} w={16} h={148}>
        <ScrollbarVertical
          content={list}
          track={UnlockSprites.SCROLL_TRACK}
          capTopSprite={UnlockSprites.SCROLL_CAP_TOP}
          thumbSprite={UnlockSprites.SCROLL_THUMB}
          capBottomSprite={UnlockSprites.SCROLL_CAP_BOTTOM}
          arrowUp={UnlockSprites.SCROLL_BAR_TOP}
          arrowDown={UnlockSprites.SCROLL_BAR_BOTTOM}
        />
      </layer>
    </>
  );
}

export function QuestsContent({ colour, selection }: { colour: Int; selection: Int }): Component {
  const list = useRef();
  const swap: Boolean = desktop();
  return (
    <>
      <layer
        ref={list}
        x={Layout.LIST_X}
        y={Layout.LIST_Y}
        w={Layout.LIST_W}
        h={Layout.LIST_H}
        scrollHeight={QuestUnlocks.length * Layout.ROW_H}
      >
        {QuestUnlocks.map((row, key) => (
          <QuestRow
            icon={UnlockSprites.TAB_QUESTS}
            name={row.name}
            subtitle={row.subtitle}
            cost={useDerived(() => questCost(row.costIndex))}
            colour={colour}
            selected={key + 1 === selection ? 1 : 0}
            unlocked={useDerived(() => questCost(row.costIndex)) === 0 ? 1 : 0}
            index={key}
            swap={swap}
          />
        ))}
      </layer>

      <layer x={134} y={49} w={311} h={148}>
        <ThinBox />
      </layer>

      <layer x={444} y={49} w={16} h={148}>
        <ScrollbarVertical
          content={list}
          track={UnlockSprites.SCROLL_TRACK}
          capTopSprite={UnlockSprites.SCROLL_CAP_TOP}
          thumbSprite={UnlockSprites.SCROLL_THUMB}
          capBottomSprite={UnlockSprites.SCROLL_CAP_BOTTOM}
          arrowUp={UnlockSprites.SCROLL_BAR_TOP}
          arrowDown={UnlockSprites.SCROLL_BAR_BOTTOM}
        />
      </layer>
    </>
  );
}
