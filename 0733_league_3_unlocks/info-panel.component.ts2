import { ThinBox } from '../lib/thin-box.component';
import { UnlockColor, UnlockFonts } from './league-3-unlocks.constants';

export function InfoPanel({ title, body, colour }: { title: String; body: String; colour: Int }): Component {
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" fill color={UnlockColor.BLACK} transparency={200} />

      <ThinBox />

      <text
        x={10}
        y={1}
        w={{ fill: 110 }}
        h={25}
        align="center"
        valign="middle"
        shadow
        font={UnlockFonts.BOLD}
        color={colour}
        text={title}
      />
      <text
        x={10}
        y={18}
        w={{ fill: 110 }}
        h={{ fill: 18 }}
        align="center"
        valign="middle"
        shadow
        lineHeight={13}
        font={UnlockFonts.BODY}
        color={colour}
        text={body}
      />
    </layer>
  );
}
