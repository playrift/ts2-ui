import { CS2, useServerState } from 'ts2';

import { replaceAll } from '../0889_nps/colour-tag';
import { stringFindAndReplace } from '../0491_barbassault_reward_shop/string-find-and-replace';
import { onMobile } from '../lib/lib.helpers';
import { Quest, questComplete } from '../lib/lib.quests';
import {
  League,
  LeagueBossLocks,
  LeagueQuestCosts,
  RfdDone,
  RfdVarbits,
  RfdVarps,
  UnlockSounds,
  UnlockVarbits,
} from './league-3-unlocks.constants';
import { LeagueAccents } from './league-accents.data';
import { RfdStep } from './quest-steps.data';

export function leagueColour(league: Int): Int {
  const theme = LeagueAccents.get(league);
  return theme === null ? 0xffffff : theme.colour;
}

export function leagueKnown(): Boolean {
  const league: Int = useServerState(UnlockVarbits.LEAGUE);
  if (LeagueAccents.get(league) === null) {
    return false;
  }
  return true;
}

export function leagueBossUnlocked(npc: Npc): Int {
  if (useServerState(UnlockVarbits.LEAGUE) !== League.THREE) {
    return 1;
  }
  if (npc === 239) return useServerState(LeagueBossLocks.KING_DRAGON);
  if (npc === 5779) return useServerState(LeagueBossLocks.MOLE);
  if (npc === 963) return useServerState(LeagueBossLocks.KALPHITE_QUEEN);
  if (npc === 7416) return useServerState(LeagueBossLocks.HILLGIANT);
  if (npc === 8195) return useServerState(LeagueBossLocks.MOSSGIANT);
  if (npc === 7849) return useServerState(LeagueBossLocks.GARGOYLE);
  if (npc === 1673) return useServerState(LeagueBossLocks.BARROWS);
  if (npc === 2265) return useServerState(LeagueBossLocks.DAGANNOTH);
  if (npc === 8583) return useServerState(LeagueBossLocks.HESPORI);
  if (npc === 8713) return useServerState(LeagueBossLocks.SARACHNIS);
  if (npc === 7286) return useServerState(LeagueBossLocks.SKOTIZO);
  if (npc === 9049) return useServerState(LeagueBossLocks.ZALCANO);
  if (npc === 494) return useServerState(LeagueBossLocks.KRAKEN);
  if (npc === 9021) return useServerState(LeagueBossLocks.GAUNTLET);
  if (npc === 499) return useServerState(LeagueBossLocks.SMOKEDEVIL);
  if (npc === 2042) return useServerState(LeagueBossLocks.ZULRAH);
  if (npc === 8061) return useServerState(LeagueBossLocks.VORKATH);
  if (npc === 5863) return useServerState(LeagueBossLocks.CERBERUS);
  if (npc === 3162) return useServerState(LeagueBossLocks.ARMADYL);
  if (npc === 2215) return useServerState(LeagueBossLocks.BANDOS);
  if (npc === 2205) return useServerState(LeagueBossLocks.SARADOMIN);
  if (npc === 3129) return useServerState(LeagueBossLocks.ZAMORAK);
  if (npc === 9460) return useServerState(LeagueBossLocks.NIGHTMARE);
  if (npc === 8615) return useServerState(LeagueBossLocks.HYDRA);
  if (npc === 7554) return useServerState(LeagueBossLocks.COX);
  if (npc === 8369) return useServerState(LeagueBossLocks.TOB);
  if (npc === 10572) return useServerState(LeagueBossLocks.TEMPOROSS);
  if (npc === 7371) return useServerState(LeagueBossLocks.WINTERTODT);
  if (npc === 319) return useServerState(LeagueBossLocks.CORP);
  if (npc === 5888) return useServerState(LeagueBossLocks.ABYSSAL_SIRE);
  if (npc === 11278) return useServerState(LeagueBossLocks.NEX);
  return 1;
}

export function questCost(costIndex: Int): Int {
  if (useServerState(UnlockVarbits.LEAGUE) !== League.THREE) {
    return 1;
  }
  switch (costIndex) {
    case 1:
      return useServerState(LeagueQuestCosts.GNOME_1);
    case 2:
      return useServerState(LeagueQuestCosts.GNOME_2);
    case 3:
      return useServerState(LeagueQuestCosts.ELF_1);
    case 4:
      return useServerState(LeagueQuestCosts.ELF_2);
    case 5:
      return useServerState(LeagueQuestCosts.ELF_3);
    case 6:
      return useServerState(LeagueQuestCosts.FREM_1);
    case 7:
      return useServerState(LeagueQuestCosts.FREM_2);
    case 8:
      return useServerState(LeagueQuestCosts.FREM_3);
    case 9:
      return useServerState(LeagueQuestCosts.DORGESHUUN);
    case 10:
      return useServerState(LeagueQuestCosts.CAMELOT_1);
    case 11:
      return useServerState(LeagueQuestCosts.CAMELOT_2);
    case 12:
      return useServerState(LeagueQuestCosts.TEMPLE_KNIGHT_1);
    case 13:
      return useServerState(LeagueQuestCosts.TEMPLE_KNIGHT_2);
    case 14:
      return useServerState(LeagueQuestCosts.PIRATE_1);
    case 15:
      return useServerState(LeagueQuestCosts.PIRATE_2);
    case 16:
      return useServerState(LeagueQuestCosts.MORYTANIA_1);
    case 17:
      return useServerState(LeagueQuestCosts.MORYTANIA_2);
    case 18:
      return useServerState(LeagueQuestCosts.MORYTANIA_3);
    case 19:
      return useServerState(LeagueQuestCosts.KARAMJA_1);
    case 20:
      return useServerState(LeagueQuestCosts.KARAMJA_2);
    case 21:
      return useServerState(LeagueQuestCosts.TROLL_1);
    case 22:
      return useServerState(LeagueQuestCosts.TROLL_2);
    case 23:
      return useServerState(LeagueQuestCosts.TROLL_3);
    case 24:
      return useServerState(LeagueQuestCosts.DESERT_1);
    case 25:
      return useServerState(LeagueQuestCosts.DESERT_2);
    case 26:
      return useServerState(LeagueQuestCosts.KOUREND_1);
    case 27:
      return useServerState(LeagueQuestCosts.KOUREND_2);
    case 28:
      return useServerState(LeagueQuestCosts.KOUREND_3);
    case 29:
      return useServerState(LeagueQuestCosts.FAIRY_1);
    case 30:
      return useServerState(LeagueQuestCosts.FAIRY_2);
    case 31:
      return useServerState(LeagueQuestCosts.ELEMENTAL);
    case 32:
      return useServerState(LeagueQuestCosts.DRUID);
    case 33:
      return useServerState(LeagueQuestCosts.CHAMPIONS);
    case 34:
      return useServerState(LeagueQuestCosts.HEROES);
    case 35:
      return useServerState(LeagueQuestCosts.LEGENDS);
    case 36:
      return useServerState(LeagueQuestCosts.MYTHS);
  }
  return 0;
}

export function rfdComplete(step: RfdStep): Int {
  switch (step) {
    case RfdStep.AWOWOGEI:
      return useServerState(RfdVarps.AWOWOGEI) === RfdDone.AWOWOGEI ? 1 : 0;
    case RfdStep.PIRATE_PETE:
      return useServerState(RfdVarbits.PIRATE_PETE) === RfdDone.PIRATE_PETE ? 1 : 0;
    case RfdStep.SKRACH:
      return useServerState(RfdVarbits.SKRACH) === RfdDone.SKRACH ? 1 : 0;
    case RfdStep.GOBLIN_GENERALS:
      return useServerState(RfdVarbits.GOBLIN_GENERALS) === RfdDone.GOBLIN_GENERALS ? 1 : 0;
    case RfdStep.MOUNTAIN_DWARF:
      return useServerState(RfdVarbits.MOUNTAIN_DWARF) === RfdDone.MOUNTAIN_DWARF ? 1 : 0;
    case RfdStep.SIR_AMIK:
      return useServerState(RfdVarbits.SIR_AMIK) === RfdDone.SIR_AMIK ? 1 : 0;
  }
  return 0;
}

export function questDone(quest: Quest): Int {
  if (questComplete(quest)) {
    return 1;
  }
  return 0;
}

export function encodeForUrl(text: String): String {
  let out: String = replaceAll(text, '%', '%25');
  out = stringFindAndReplace(out, ' ', '%20');
  out = stringFindAndReplace(out, '&', '%26');
  out = stringFindAndReplace(out, '+', '%2B');
  out = stringFindAndReplace(out, '|', '%7C');
  out = stringFindAndReplace(out, '`', '%60');
  out = stringFindAndReplace(out, '"', '%22');
  out = stringFindAndReplace(out, '<', '%3C');
  out = stringFindAndReplace(out, '>', '%3E');
  out = stringFindAndReplace(out, '{', '%7B');
  out = stringFindAndReplace(out, '}', '%7D');
  out = stringFindAndReplace(out, '^', '%5E');
  out = stringFindAndReplace(out, '\\', '%5C');
  out = stringFindAndReplace(out, '!', '%21');
  out = stringFindAndReplace(out, '$', '%24');
  out = stringFindAndReplace(out, '#', '%23');
  out = stringFindAndReplace(out, '(', '%28');
  out = stringFindAndReplace(out, ')', '%29');
  return out;
}

export function wikiSearch(name: String): void {
  CS2.sound_effect(UnlockSounds.CLICK, 1, 0);
  CS2.url_open(`https://oldschool.runescape.wiki/w/Special:Search?search=${encodeForUrl(name)}&utm_source=osrs`, true);
}

export function desktop(): Boolean {
  if (onMobile()) {
    return false;
  }
  return true;
}
