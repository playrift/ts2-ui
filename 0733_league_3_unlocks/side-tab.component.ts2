import { useState } from 'ts2';

import { Layout, UnlockColor, UnlockFonts } from './league-3-unlocks.constants';
import { desktop } from './league-3-unlocks.helpers';
import { PanelBox, PanelBoxes } from './panel-boxes.data';
import type { PanelBoxRow } from './panel-boxes.data';

export function SideTab({
  label,
  icon,
  index,
  selected,
  colour,
  menuHeight,
}: {
  label: String;
  icon: Sprite;
  index: Int;
  selected: Int;
  colour: Int;
  menuHeight: Int;
}): Component {
  const [hovered, setHovered] = useState(0);

  const top: Int = index * (Layout.TAB_H + Layout.TAB_GAP);
  const swap: Boolean = selected === 0 ? desktop() : false;

  let style: PanelBoxRow = PanelBoxes.at(PanelBox.INACTIVE);
  if (selected === 1) {
    style = PanelBoxes.at(PanelBox.ACTIVE);
  } else if (hovered === 1) {
    style = PanelBoxes.at(PanelBox.HOVER);
  }

  const b: Int = Layout.TAB_BORDER;
  const overlap: Int = Layout.TAB_OVERLAP;
  const fillInset: Int = selected === 1 ? b : 2 * b - overlap;
  const topInset: Int = top === 0 && selected === 1 ? b : 2 * b - overlap;
  const bottomInset: Int = top + Layout.TAB_H === menuHeight && selected === 1 ? b : 2 * b - overlap;

  const labelX: Int = 8 + 32;

  return (
    <>
      <rect
        x={1}
        y={top + 1}
        w={{ fill: b - overlap }}
        h={Layout.TAB_H - 2}
        fill
        color={UnlockColor.PANEL}
        options={selected === 0 ? ['View'] : ['']}
        optionSubject={`<col=ff9040>${label}</col>`}
        onMouseEnter={swap ? () => setHovered(1) : undefined}
        onMouseLeave={swap ? () => setHovered(0) : undefined}
      />

      <sprite x={b} y={top + 2} w={{ fill: fillInset }} h={Layout.TAB_H - 4} sprite={style.fill} tiling />
      <sprite x={b} y={top} w={{ fill: topInset }} h={b} sprite={style.edgeTop} tiling />
      <sprite x={b} y={top + Layout.TAB_H - b} w={{ fill: bottomInset }} h={b} sprite={style.edgeBottom} tiling />
      <sprite x={0} y={top + b} w={b} h={Layout.TAB_H - 2 * b} sprite={style.edgeLeft} tiling />
      <sprite x={0} y={top} w={b} h={b} sprite={style.cornerTl} tiling />
      <sprite x={0} y={top + Layout.TAB_H - b} w={b} h={b} sprite={style.cornerBl} tiling />

      <sprite x={3} y={top + Layout.TAB_H / 2 - 36 / 2} w={32} h={36} sprite={icon} tiling />

      <text
        x={labelX}
        y={top}
        w={{ fill: labelX + 6 }}
        h={Layout.TAB_H}
        align="left"
        valign="middle"
        shadow
        font={UnlockFonts.BODY}
        color={colour}
        text={label}
      />
    </>
  );
}
