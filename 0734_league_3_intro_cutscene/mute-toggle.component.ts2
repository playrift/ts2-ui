import { onMounted, useState } from 'ts2';
import { setTransparency } from '../lib/lib.components';
import { leagueIntroMuteOp, leagueIntroMusicRadio } from './league-3-intro-cutscene.state';
import { IntroLayout, IntroSprites, introMuted } from './league-3-intro-cutscene.constants';

export function IntroMuteToggle(): Component {
  const [muted] = useState(introMuted);

  onMounted(() => {
    leagueIntroMusicRadio();
  });

  return (
    <layer w="fill" h="fill">
      {muted === 0 ? (
        <sprite
          x={0}
          y={0}
          w="fill"
          h="fill"
          sprite={IntroSprites.MUTE}
          options={['Mute Music']}
          onMouseRepeat={(event) => setTransparency(event.self, IntroLayout.MUTE_HOVER_TRANSPARENCY)}
          onMouseLeave={(event) => setTransparency(event.self, IntroLayout.MUTE_REST_TRANSPARENCY)}
          onOptionSelect={() => leagueIntroMuteOp(1)}
        />
      ) : null}
      {muted === 1 ? (
        <sprite
          x={0}
          y={0}
          w="fill"
          h="fill"
          sprite={IntroSprites.UNMUTE}
          options={['Unmute Music']}
          onMouseRepeat={(event) => setTransparency(event.self, IntroLayout.MUTE_HOVER_TRANSPARENCY)}
          onMouseLeave={(event) => setTransparency(event.self, IntroLayout.MUTE_REST_TRANSPARENCY)}
          onOptionSelect={() => leagueIntroMuteOp(0)}
        />
      ) : null}
    </layer>
  );
}
