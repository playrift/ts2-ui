import { CS2, intArray, useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  FragmentColors,
  FragmentFonts,
  FragmentParams,
  Fragments,
  FragmentSetParams,
  FragmentSets,
  ScrollbarSprites as Bar,
} from './league-3-fragments.constants';
import {
  fragmentEffect,
  fragmentTier,
  leagueColour,
  loadoutSlot,
  setBlockHeight,
  setBonusLine,
  setLineHeight,
  setMembers,
  setMet,
} from './league-3-fragments.helpers';

const SET_COUNT = 15;

const LOADOUT_SLOTS = [0, 1, 2, 3, 4, 5, 6] as const;

function SectionHeader({ y, title }: { y: Int; title: String }): Component {
  return (
    <>
      <rect x={0} y={y} w="fill" h={18} color={0x000000} fill transparency={200} />
      <text
        x={5}
        y={y}
        w={{ fill: 10 }}
        h={18}
        text={title}
        align="center"
        valign="middle"
        shadow
        font={FragmentFonts.HEADER}
        color={leagueColour(3)}
      />
    </>
  );
}

function SetEffectBlock({ row, members, y }: { row: Row; members: Int; y: Int }): Component {
  const nameH: Int = setLineHeight(row.text(FragmentSetParams.NAME), FragmentFonts.HEADER, Body.TEXT_WIDTH);
  const descH: Int = setLineHeight(row.text(FragmentSetParams.DESCRIPTION), FragmentFonts.BODY, Body.TEXT_WIDTH);
  const firstH: Int = setLineHeight(setBonusLine(row, false), FragmentFonts.BODY, Body.TEXT_WIDTH);
  const secondY: Int = y + nameH + descH + 3 + firstH + 3;
  return (
    <>
      <text
        x={Body.MARGIN}
        y={y}
        w={{ fill: Body.MARGIN * 2 }}
        h={nameH}
        text={row.text(FragmentSetParams.NAME)}
        align="left"
        valign="top"
        lineHeight={Body.LINE}
        shadow
        font={FragmentFonts.HEADER}
        color={members < row.int(FragmentSetParams.THRESHOLD) ? FragmentColors.LABEL_DISABLED : leagueColour(3)}
      />
      <text
        x={Body.MARGIN}
        y={y + nameH}
        w={{ fill: Body.MARGIN * 2 }}
        h={descH}
        text={row.text(FragmentSetParams.DESCRIPTION)}
        align="left"
        valign="top"
        lineHeight={Body.LINE}
        shadow
        font={FragmentFonts.BODY}
        color={FragmentColors.LABEL_DISABLED}
      />
      <text
        x={Body.MARGIN}
        y={y + nameH + descH + 3}
        w={{ fill: Body.MARGIN * 2 }}
        h={firstH}
        text={setBonusLine(row, false)}
        align="left"
        valign="top"
        lineHeight={Body.LINE}
        shadow
        font={FragmentFonts.BODY}
        color={members < row.int(FragmentSetParams.THRESHOLD) ? FragmentColors.LABEL_DISABLED : leagueColour(3)}
      />
      {row.int(FragmentSetParams.THRESHOLD_2) > 0 && (
        <text
          x={Body.MARGIN}
          y={secondY}
          w={{ fill: Body.MARGIN * 2 }}
          h={setLineHeight(setBonusLine(row, true), FragmentFonts.BODY, Body.TEXT_WIDTH)}
          text={setBonusLine(row, true)}
          align="left"
          valign="top"
          lineHeight={Body.LINE}
          shadow
          font={FragmentFonts.BODY}
          color={members < row.int(FragmentSetParams.THRESHOLD_2) ? FragmentColors.LABEL_DISABLED : leagueColour(3)}
        />
      )}
    </>
  );
}

function NoneRow({ y }: { y: Int }): Component {
  return (
    <text
      x={5}
      y={y}
      w={{ fill: 10 }}
      h={15}
      text="None."
      align="left"
      valign="top"
      shadow
      font={FragmentFonts.BODY}
      color={FragmentColors.LABEL_DISABLED}
    />
  );
}

const enum Body {
  MARGIN = 5,
  LINE = 15,
  TEXT_WIDTH = 196,
}

export function FragmentDetail(): Component {
  const content = useRef();

  const headingY = intArray(7);
  const bodyY = intArray(7);
  const bodyH = intArray(7);
  let cursor: Int = 62;
  let slot: Int = 0;
  let anyEquipped: Boolean = false;
  while (slot < 7) {
    const fragment: Int = loadoutSlot(slot);
    if (fragment !== 0) {
      anyEquipped = true;
      headingY[slot] = cursor;
      cursor = cursor + Body.LINE + 2;
      bodyY[slot] = cursor;
      bodyH[slot] = CS2.paraheight(fragmentEffect(fragment), Body.TEXT_WIDTH, FragmentFonts.BODY) * Body.LINE;
      cursor = cursor + bodyH[slot] + 10;
    }
    slot = slot + 1;
  }
  const setsY: Int = anyEquipped ? cursor : cursor + Body.LINE + 10;
  const setY = intArray(16);
  let setCursor: Int = setsY + 22;
  let anySet: Boolean = false;
  let set: Int = 1;
  while (set <= SET_COUNT) {
    if (setMet(set, FragmentSets.at(set))) {
      anySet = true;
      setY[set] = setCursor;
      setCursor =
        setCursor + setBlockHeight(FragmentSets.at(set), Body.TEXT_WIDTH, FragmentFonts.HEADER, FragmentFonts.BODY);
    }
    set = set + 1;
  }

  const contentHeight: Int = anySet ? setCursor : setCursor + Body.LINE + 10;
  const scroll: Int = contentHeight > 167 ? contentHeight : 0;

  return (
    <>
      <layer right={27} y={{ bottom: 12 }} w={210} h={171}>
        <ThinBoxEntrypoint />
      </layer>

      <layer ref={content} right={29} y={{ bottom: 14 }} w={206} h={167} scrollHeight={scroll}>
        <rect x={0} y={0} w="fill" h="fill" color={0x000000} fill transparency={200} />

        <text
          x={5}
          y={5}
          w={{ fill: 10 }}
          h={15}
          text="Active Effects"
          align="center"
          valign="middle"
          shadow
          font={FragmentFonts.HEADER}
          color={leagueColour(3)}
        />
        <text
          x={5}
          y={22}
          w={{ fill: 10 }}
          h={15}
          text="Effects gained from Fragments."
          align="center"
          valign="middle"
          shadow
          font={FragmentFonts.LABEL}
          color={FragmentColors.LABEL_DISABLED}
        />

        <SectionHeader y={40} title="Base Effects" />
        {LOADOUT_SLOTS.map(
          (i) =>
            loadoutSlot(i) !== 0 && (
              <>
                <text
                  x={Body.MARGIN}
                  y={headingY[i]}
                  w={{ fill: Body.MARGIN * 2 }}
                  h={Body.LINE}
                  text={`${Fragments.at(loadoutSlot(i)).text(FragmentParams.NAME)} <col=cfcfcf>(${String(fragmentTier(loadoutSlot(i)))})`}
                  align="left"
                  valign="top"
                  shadow
                  font={FragmentFonts.HEADER}
                  color={leagueColour(3)}
                />
                <text
                  x={Body.MARGIN}
                  y={bodyY[i]}
                  w={{ fill: Body.MARGIN * 2 }}
                  h={bodyH[i]}
                  text={fragmentEffect(loadoutSlot(i))}
                  align="left"
                  valign="top"
                  lineHeight={Body.LINE}
                  shadow
                  font={FragmentFonts.BODY}
                  color={FragmentColors.LABEL_DISABLED}
                />
              </>
            ),
        )}
        {anyEquipped === false && <NoneRow y={62} />}

        <SectionHeader y={setsY} title="Set Effects" />
        {FragmentSets.map(
          (row, index) =>
            setMet(index + 1, row) && (
              <SetEffectBlock row={row} y={setY[index + 1]} members={setMembers(row.int(FragmentSetParams.GROUP))} />
            ),
        )}
        {anySet === false && <NoneRow y={setsY + 22} />}
      </layer>

      <layer right={12} y={{ bottom: 12 }} w={16} h={171}>
        <ScrollbarVertical
          content={content}
          track={Bar.TRACK}
          capTopSprite={Bar.CAP_TOP}
          thumbSprite={Bar.THUMB}
          capBottomSprite={Bar.CAP_BOTTOM}
          arrowUp={Bar.ARROW_UP}
          arrowDown={Bar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
