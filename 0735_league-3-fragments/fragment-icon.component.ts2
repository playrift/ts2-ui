import { FragmentBack, FragmentBase, FragmentGlow, FragmentLight, XP_MAX } from './league-3-fragments.constants';

export function FragmentIcon({ iconKey, xp, equipped }: { iconKey: Int; xp: Int; equipped: Boolean }): Component {
  const shortKey = iconKey < 20 ? iconKey : iconKey < 40 ? iconKey - 20 : iconKey - 40;
  const noXp = xp === 0 ? true : false;
  return (
    <>
      {iconKey < 60 && <sprite x={5} y={5} w={32} h={32} tiling sprite={FragmentBack.at(shortKey)} />}
      <sprite
        x={5}
        y={5}
        w={32}
        h={32}
        tiling
        sprite={FragmentBase.at(iconKey)}
        hide={noXp ? true : equipped}
        dragDeadZone={5}
        dragDeadTime={5}
      />
      <sprite
        x={5}
        y={5}
        w={32}
        h={32}
        tiling
        sprite={FragmentLight.at(iconKey)}
        transparency={130 - CS2.scale(xp, XP_MAX, 100)}
        hide={noXp}
      />
      {iconKey < 60 && (
        <sprite
          x={5}
          y={5}
          w={32}
          h={32}
          tiling
          sprite={FragmentGlow.at(shortKey)}
          transparency={125 + CS2.randominc(100)}
          hide={noXp}
        />
      )}
      <sprite x={5} y={5} w={32} h={32} tiling transparency={128} />
      <sprite x={5} y={5} w={32} h={32} tiling transparency={128} vflip />
    </>
  );
}
