import { FragmentIcon } from './fragment-icon.component';
import { fragmentIcon, fragmentXp, loadoutSlot, setActive } from './league-3-fragments.helpers';

const SLOTS = [0, 1, 2, 3, 4, 5, 6];

export function FragmentLoadoutIcons(): Component {
  return (
    <layer x="center" y={41} w={338} h={51}>
      {SLOTS.map((slot) => (
        <>
          {loadoutSlot(slot) !== 0 && (
            <FragmentIcon
              x={slot * 50 + 3}
              y={3}
              iconKey={fragmentIcon(loadoutSlot(slot))}
              xp={fragmentXp(loadoutSlot(slot))}
              equipped={false}
              inLoadout={setActive(loadoutSlot(slot))}
            />
          )}
          {loadoutSlot(slot) === 0 && (
            <>
              <rect hide />
              <rect hide />
              <rect hide />
              <rect hide />
              <rect hide />
              <rect hide />
            </>
          )}
        </>
      ))}
    </layer>
  );
}
