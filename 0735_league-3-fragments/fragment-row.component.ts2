import { FragmentIcon } from './fragment-icon.component';
import { FragmentColors, FragmentFonts, LEAGUE_3, ROW_HEIGHT } from './league-3-fragments.constants';
import { leagueColour } from './league-3-fragments.helpers';

export function FragmentRow({
  index,
  name,
  description,
  iconKey,
  xp,
  equipped,
}: {
  index: Int;
  name: String;
  description: String;
  iconKey: Int;
  xp: Int;
  equipped: Boolean;
}): Component {
  return (
    <layer
      y={index * ROW_HEIGHT}
      w="fill"
      h={ROW_HEIGHT}
      options={['View', 'Equip']}
      optionSubject={`<col=ff9040>${name}</col>`}
    >
      <rect w="fill" h="fill" color={0x000000} fill transparency={index % 2 === 0 ? 200 : 220} />
      <FragmentIcon iconKey={iconKey} xp={xp} equipped={equipped} />
      <text
        x={42}
        y={5}
        w={{ fill: 47 }}
        h={15}
        align="left"
        text={name}
        font={FragmentFonts.HEADER}
        shadow
        color={xp === 0 ? FragmentColors.LABEL_DISABLED : leagueColour(LEAGUE_3)}
      />
      <text
        x={42}
        y={24}
        w={{ fill: 47 }}
        h={15}
        align="left"
        text={description}
        font={FragmentFonts.LABEL}
        shadow
        color={FragmentColors.LABEL_DISABLED}
      />
    </layer>
  );
}
