export function equippedInLoadout(fragmentId: Int): Boolean {
  if (useServerState(FragmentLoadoutVarbits.SLOT_0) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_1) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_2) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_3) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_4) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_5) === fragmentId) return true;
  if (useServerState(FragmentLoadoutVarbits.SLOT_6) === fragmentId) return true;
  return false;
}

export function leagueColour(league: Int): Int {
  return LeagueThemes.get(league).colour;
}

export function leaguesEnabled(): Boolean {
  const flags = useServerState(LoadoutVarps.MAP_FLAGS);
  if (hasBit(flags, 29)) {
    return false;
  }
  return hasBit(flags, 30);
}

export function unlockedSlots(): Int {
  if (leaguesEnabled() === false) return 0;
  if (useServerState(LoadoutVarbits.LEAGUE) !== 3) return 0;
  const points = useServerState(LoadoutVarps.POINTS);
  if (points < 10) return 1;
  if (points < 300) return 2;
  if (points < 1500) return 3;
  if (points < 3000) return 4;
  if (points < 7500) return 5;
  if (points < 15000) return 6;
  return 7;
}

export function loadoutSlot(index: Int): Int {
  if (index === 0) return useServerState(FragmentLoadoutVarbits.SLOT_0);
  if (index === 1) return useServerState(FragmentLoadoutVarbits.SLOT_1);
  if (index === 2) return useServerState(FragmentLoadoutVarbits.SLOT_2);
  if (index === 3) return useServerState(FragmentLoadoutVarbits.SLOT_3);
  if (index === 4) return useServerState(FragmentLoadoutVarbits.SLOT_4);
  if (index === 5) return useServerState(FragmentLoadoutVarbits.SLOT_5);
  return useServerState(FragmentLoadoutVarbits.SLOT_6);
}

function slotInSet(slot: Int, set: Int): Int {
  const fragment: Int = loadoutSlot(slot);
  if (fragment === 0) {
    return 0;
  }
  const row = Fragments.get(fragment);
  let members: Int = 0;
  if (row.setA === set) {
    members = members + 1;
  }
  if (row.setB === set) {
    members = members + 1;
  }
  return members;
}

export function setMembers(set: Int): Int {
  const unlocked: Int = unlockedSlots();
  if (unlocked < 1) return 0;
  let members: Int = slotInSet(0, set);
  if (unlocked < 2) return members;
  members = members + slotInSet(1, set);
  if (unlocked < 3) return members;
  members = members + slotInSet(2, set);
  if (unlocked < 4) return members;
  members = members + slotInSet(3, set);
  if (unlocked < 5) return members;
  members = members + slotInSet(4, set);
  if (unlocked < 6) return members;
  members = members + slotInSet(5, set);
  if (unlocked < 7) return members;
  return members + slotInSet(6, set);
}

export function setActive(fragmentId: Int): Boolean {
  const row = Fragments.get(fragmentId);
  const first: Int = row.setA;
  if (setMembers(first) >= FragmentSets.get(first).threshold) {
    return true;
  }
  const second: Int = row.setB;
  if (setMembers(second) >= FragmentSets.get(second).threshold) {
    return true;
  }
  return false;
}

export function unlockProgress(width: Int): Int {
  if (leaguesEnabled() === false) return 0;
  if (useServerState(LoadoutVarbits.LEAGUE) !== 3) return 0;
  const points: Int = useServerState(LoadoutVarps.POINTS);
  if (points < 10) return scaled(points, 10, width);
  if (points < 300) return scaled(points - 10, 300 - 10, width);
  if (points < 1500) return scaled(points - 300, 1500 - 300, width);
  if (points < 3000) return scaled(points - 1500, 3000 - 1500, width);
  if (points < 7500) return scaled(points - 3000, 7500 - 3000, width);
  if (points < 15000) return scaled(points - 7500, 15000 - 7500, width);
  return 0;
}

export function fragmentTier(fragmentId: Int): Int {
  const xp: Int = fragmentXp(fragmentId);
  if (xp <= 0) return 0;
  if (xp < 2000) return 1;
  if (xp < 8000) return 2;
  return 3;
}

export function fragmentEffect(fragmentId: Int): String {
  const row = Fragments.get(fragmentId);
  const tier: Int = fragmentTier(fragmentId);
  if (tier === 3) return row.effect3;
  if (tier === 2) return row.effect2;
  return row.effect1;
}

export function setLineHeight(text: String, font: Font, width: Int): Int {
  return textLineCount(text, width, font) * 15;
}

export function setBlockHeight(row: FragmentSetsRow, width: Int, headerFont: Font, bodyFont: Font): Int {
  let height: Int = setLineHeight(row.name, headerFont, width);
  height = height + setLineHeight(row.description, bodyFont, width);
  height = height + 3;
  height = height + setLineHeight(setBonusLine(row, false), bodyFont, width);
  if (row.threshold2 > 0) {
    height = height + 3;
    height = height + setLineHeight(setBonusLine(row, true), bodyFont, width);
  }
  return height + 10;
}

export function setBonusLine(row: FragmentSetsRow, second: Boolean): String {
  if (second) {
    return `${stringOf(row.threshold2)} Fragments: <col=cfcfcf>${row.bonus2}`;
  }
  return `${stringOf(row.threshold)} Fragments: <col=cfcfcf>${row.bonus}`;
}

export function setMet(set: Int, row: FragmentSetsRow): Boolean {
  if (setMembers(set) >= row.threshold) {
    return true;
  }
  return false;
}
