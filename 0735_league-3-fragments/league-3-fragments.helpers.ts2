import type { FragmentSetsRow } from './fragment-sets.data';
import { useServerState } from 'ts2';
import {
  FragmentLoadoutVarbits,
  FragmentParams,
  Fragments,
  FragmentSetParams,
  FragmentSets,
  FragmentXpVarbits,
  LeagueThemeParams,
  LeagueThemes,
  LoadoutVarbits,
  LoadoutVarps,
} from './league-3-fragments.constants';
import { hasBit, scaled, textLineCount } from '../lib/lib.engine';

