import { useServerState } from 'ts2';

import { SteelborderColor } from '../lib/lib.constants';
import { Varbits } from '../lib/game/varbits';
import { LEAGUE_FIRST, LEAGUE_LAST } from './league-3-fragments.constants';
import { leagueColour } from './league-3-fragments.helpers';
import { ClearFiltersButton } from './clear-filters-button.component';
import { CloseButton } from './close-button.component';
import { DropdownPopup } from './dropdown-popup.component';
import { FilterPanel } from './filter-panel.component';
import { FragmentDetail } from './fragment-detail.component';
import { FragmentList } from './fragment-list.component';
import { FragmentLoadout } from './fragment-loadout.component';
import { FragmentLoadoutIcons } from './fragment-loadout-icons.component';
import { SteelBorder } from '../lib/steel-border.component';
import { StoneTabButton } from './stone-tab-button.component';

export function LeagueFragments(): Component {
  const league = useServerState(Varbits.LEAGUE_TYPE);

  return (
    <layer w="fill" h="fill">
      <layer x="center" y="center" w={480} h={314}>
        <SteelBorder
          title="League Fragments"
          flags={1}
          titleColor={league < LEAGUE_FIRST || league > LEAGUE_LAST ? SteelborderColor.TITLE : leagueColour(league)}
        />

        <CloseButton />

        <StoneTabButton
          x={12}
          y={99}
          w={110}
          h={30}
          op="Show"
          optionSubject="<col=ff9040>Filters</col>"
          label="Show Filters"
        />
        <ClearFiltersButton />
        <StoneTabButton
          x={243}
          y={99}
          w={110}
          h={30}
          op="View"
          optionSubject="<col=ff9040>Passive Effects</col>"
          label="Passive Effects"
        />
        <StoneTabButton
          x={358}
          y={99}
          w={110}
          h={30}
          selected
          op="View"
          optionSubject="<col=ff9040>Active Effects</col>"
          label="Active Effects"
        />
        <StoneTabButton x={414} y={41} w={54} h={51} op="Unequip all" optionSubject="" label="Unequip all" />

        <FragmentList />
        <FilterPanel />
        <FragmentDetail />
        <FragmentLoadout />
        <FragmentLoadoutIcons />

        <layer x={7} y={7} w={21} h={21} />
        <layer w="fill" h="fill" hide noClickThrough />
        <layer x={0} y={29} w={80} h={70} />

        <layer w="fill" h="fill" hide />
      </layer>

      <DropdownPopup />
    </layer>
  );
}
