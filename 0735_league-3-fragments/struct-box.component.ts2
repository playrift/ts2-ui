import { BoxParams } from './league-3-fragments.constants';

export function StructBox({
  x,
  y,
  w,
  h,
  style,
  fill,
  hideFill,
}: {
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  style: Row;
  fill: Int;
  hideFill: Boolean;
}): Component {
  const border: Int = style.int(BoxParams.BORDER);

  return (
    <>
      <rect x={x + 1} y={y + 1} w={w - 2} h={h - 2} color={fill} fill />

      <sprite x={x + 4} y={y + 4} w={w - 8} h={h - 8} sprite={style.sprite(BoxParams.FILL)} tiling hide={hideFill} />

      <sprite x={x + border} y={y} w={w - 2 * border} h={border} sprite={style.sprite(BoxParams.EDGE_TOP)} tiling />
      <sprite
        x={x + border}
        y={y + h - border}
        w={w - 2 * border}
        h={border}
        sprite={style.sprite(BoxParams.EDGE_BOTTOM)}
        tiling
      />
      <sprite x={x} y={y + border} w={border} h={h - 2 * border} sprite={style.sprite(BoxParams.EDGE_LEFT)} tiling />
      <sprite
        x={x + w - border}
        y={y + border}
        w={border}
        h={h - 2 * border}
        sprite={style.sprite(BoxParams.EDGE_RIGHT)}
        tiling
      />

      <sprite x={x} y={y} w={border} h={border} sprite={style.sprite(BoxParams.CORNER_TL)} tiling />
      <sprite x={x + w - border} y={y} w={border} h={border} sprite={style.sprite(BoxParams.CORNER_TR)} tiling />
      <sprite x={x} y={y + h - border} w={border} h={border} sprite={style.sprite(BoxParams.CORNER_BL)} tiling />
      <sprite
        x={x + w - border}
        y={y + h - border}
        w={border}
        h={border}
        sprite={style.sprite(BoxParams.CORNER_BR)}
        tiling
      />
    </>
  );
}
