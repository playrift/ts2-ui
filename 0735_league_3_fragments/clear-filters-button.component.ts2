import { useState } from 'ts2';
import {
  league3FragmentFilterCategory,
  league3FragmentFilterEffect,
  league3FragmentFilterLevel,
  league3FragmentFilterLock,
} from '../lib/game/varcs';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { FragmentColors, FragmentFonts } from './league-3-fragments.constants';

export function ClearFiltersButton(): Component {
  const [category] = useState(league3FragmentFilterCategory);
  const [effect] = useState(league3FragmentFilterEffect);
  const [level] = useState(league3FragmentFilterLevel);
  const [lock] = useState(league3FragmentFilterLock);

  return category < 1 && effect < 1 && level < 1 && lock < 1 ? (
    <layer x={127} y={99} w={110} h={30}>
      <text
        w="fill"
        h="fill"
        text="Clear Filters"
        font={FragmentFonts.LABEL}
        align="center"
        valign="middle"
        shadow
        color={FragmentColors.LABEL_DISABLED}
      />
      <StoneButtonPressedEntrypoint />
    </layer>
  ) : (
    <layer x={127} y={99} w={110} h={30}>
      <StoneButtonEntrypoint />
      <text
        w="fill"
        h="fill"
        text="Clear Filters"
        font={FragmentFonts.LABEL}
        align="center"
        valign="middle"
        shadow
        color={FragmentColors.LABEL}
      />
    </layer>
  );
}
