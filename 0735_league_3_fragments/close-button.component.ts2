import { closeInterface, onMobile } from '../lib/lib.helpers';
import { FragmentSprites } from './league-3-fragments.constants';

export function CloseButton(): Component {
  const mobile = onMobile();
  return (
    <sprite
      right={mobile ? 1 : 3}
      y={mobile ? 1 : 6}
      w={mobile ? 33 : 26}
      h={mobile ? 33 : 23}
      sprite={mobile ? FragmentSprites.CLOSE_MOBILE : FragmentSprites.CLOSE}
      hover={{ sprite: mobile ? FragmentSprites.CLOSE_MOBILE : FragmentSprites.CLOSE_HOVER }}
      tiling
      options={['Close']}
      onOptionSelect={() => closeInterface()}
    />
  );
}
