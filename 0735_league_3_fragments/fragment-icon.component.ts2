import { CS2 } from 'ts2';
import { FragmentBack, FragmentBase, FragmentGlow, FragmentLight, XP_MAX } from './league-3-fragments.constants';
import { scaled } from '../lib/lib.engine';

export function FragmentIcon({
  iconKey,
  xp,
  equipped,
  x,
  y,
  inLoadout,
}: {
  iconKey: Int;
  xp: Int;
  equipped: Boolean;
  x: Int;
  y: Int;
  inLoadout: Boolean;
}): Component {
  const shortKey = iconKey < 20 ? iconKey : iconKey < 40 ? iconKey - 20 : iconKey - 40;
  const noXp = xp === 0 ? true : false;
  return (
    <>
      {iconKey < 60 && <sprite x={x} y={y} w={32} h={32} tiling sprite={FragmentBack.at(shortKey) ?? -1} />}
      <sprite
        x={x}
        y={y}
        w={32}
        h={32}
        tiling
        sprite={FragmentBase.at(iconKey) ?? -1}
        hide={noXp ? true : equipped}
        dragDeadZone={5}
        dragDeadTime={5}
      />
      <sprite
        x={x}
        y={y}
        w={32}
        h={32}
        tiling
        sprite={FragmentLight.at(iconKey) ?? -1}
        transparency={130 - scaled(xp, XP_MAX, 100)}
        hide={noXp}
      />
      {iconKey < 60 && (
        <sprite
          x={x}
          y={y}
          w={32}
          h={32}
          tiling
          sprite={FragmentGlow.at(shortKey) ?? -1}
          transparency={inLoadout ? 238 : 125 + CS2.randominc(100)}
          hide={inLoadout ? false : noXp}
        />
      )}
      <sprite x={x} y={y} w={32} h={32} tiling transparency={128} />
      <sprite x={x} y={y} w={32} h={32} tiling transparency={128} vflip />
    </>
  );
}
