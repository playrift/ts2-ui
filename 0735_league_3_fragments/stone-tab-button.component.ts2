import { useRef } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { FragmentColors, FragmentFonts, Sounds } from './league-3-fragments.constants';
import { playSound } from '../lib/lib.engine';

export function StoneTabButton({
  x,
  y,
  w,
  h,
  op,
  optionSubject = '',
  label,
  selected = false,
}: {
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  op: String;
  optionSubject?: String;
  label: String;
  selected?: Boolean;
}): Component {
  const normal = useRef();
  const pressed = useRef();

  return selected ? (
    <layer
      x={x}
      y={y}
      w={w}
      h={h}
      options={[op]}
      optionSubject={optionSubject}
      onOptionSelect={() => {
        playSound(Sounds.SELECT);
      }}
    >
      <text
        w="fill"
        h="fill"
        text={label}
        font={FragmentFonts.LABEL}
        align="center"
        valign="middle"
        shadow
        color={FragmentColors.LABEL_DISABLED}
      />
      <StoneButtonPressedEntrypoint />
    </layer>
  ) : (
    <layer
      x={x}
      y={y}
      w={w}
      h={h}
      options={[op]}
      optionSubject={optionSubject}
      onOptionSelect={() => {
        playSound(Sounds.SELECT);
      }}
      onMouseEnter={() => {
        normal.hide = true;
        pressed.hide = false;
      }}
      onMouseLeave={() => {
        normal.hide = false;
        pressed.hide = true;
      }}
    >
      <layer ref={normal} w="fill" h="fill">
        <StoneButtonEntrypoint />
      </layer>
      <layer ref={pressed} w="fill" h="fill" hide>
        <StoneButtonPressedEntrypoint />
      </layer>
      <text
        w="fill"
        h="fill"
        text={label}
        font={FragmentFonts.LABEL}
        align="center"
        valign="middle"
        shadow
        color={FragmentColors.LABEL}
      />
    </layer>
  );
}
