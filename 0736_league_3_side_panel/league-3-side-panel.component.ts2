import { useServerState } from 'ts2';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { BuffTooltip } from './buff-tooltip.component';
import { PanelContent } from './panel-content.component';
import { RelicBuffToggle } from './relic-buff-toggle.component';
import {
  League,
  LeagueThemes,
  SidePanelColor,
  SidePanelFonts,
  SidePanelLayout,
  SidePanelText,
  SidePanelVarbits,
} from './league-3-side-panel.constants';

function SidePanelTitle(): Component {
  const theme = LeagueThemes.get(useServerState(SidePanelVarbits.LEAGUE) as League);
  return (
    <text
      x={SidePanelLayout.TITLE_X}
      y={0}
      w={{ fill: SidePanelLayout.TITLE_W_INSET }}
      h={SidePanelLayout.TITLE_H}
      text={SidePanelText.TITLE}
      font={SidePanelFonts.TITLE}
      color={theme === null ? SidePanelColor.ACCENT_DEFAULT : theme.accent}
      shadow
      align="left"
      valign="middle"
    />
  );
}

export function LeagueSidePanel(): Component {
  return (
    <layer x="center" y="center" w={SidePanelLayout.BODY_W} h={SidePanelLayout.BODY_H}>
      <SidePanelTitle />

      <layer x="center" y={SidePanelLayout.FRAME_Y} w="fill" h={{ fill: SidePanelLayout.FRAME_H_INSET }}>
        <rect
          x="center"
          y={0}
          w={{ fill: SidePanelLayout.WASH_INSET }}
          h={{ fill: SidePanelLayout.WASH_INSET }}
          fill
          color={0x000000}
          transparency={SidePanelLayout.WASH_TRANSPARENCY}
        />
        <PanelContent />
        <SteelFrameEntrypoint />
      </layer>

      <RelicBuffToggle />

      <layer x={0} y={0} w="fill" h="fill">
        <BuffTooltip />
      </layer>
    </layer>
  );
}
