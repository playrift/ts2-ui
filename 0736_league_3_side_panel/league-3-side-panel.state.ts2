import { predictServerState, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { tooltipDwellElapsed, tooltipDown, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import { onMobile } from '../lib/lib.helpers';
import { SidePanelLayout, SidePanelSounds, SidePanelVarbits } from './league-3-side-panel.constants';

export function buttonSelectSound(): void {
  playSound(SidePanelSounds.SELECT);
}

export function toggleRelicBuff(): void {
  playSound(SidePanelSounds.SELECT);
  predictServerState(SidePanelVarbits.BUFF_HIDDEN, 1 - useServerState(SidePanelVarbits.BUFF_HIDDEN));
}

export function showBuffTooltip(): void {
  if (onMobile()) {
    return;
  }
  tooltipMark();
  if (tooltipDown() && tooltipDwellElapsed(SidePanelLayout.TOOLTIP_DWELL)) {
    tooltipRaise();
  }
}

export function hideBuffTooltip(): void {
  tooltipHide();
}
