export enum League {
  ONE = 1,
  TWO = 2,
  THREE = 3,
  FOUR = 4,
  FIVE = 5,
  SIX = 6,
}

export const RelicTiers = listOf<Int>([0, 600, 1200, 2600, 5200, 8500, 16500, 28000]);

export const NoRelics = listOf<Int>([]);

export type LeagueTheme = {
  barFill: Sprite;
  barTrack: Sprite;
  accent: Int;
  relics: List<Int>;
};

export const LeagueThemes = mapOf<League, LeagueTheme>([
  [League.ONE, { barFill: 2386, barTrack: 2387, accent: 16750623, relics: RelicTiers }],
  [League.TWO, { barFill: 2718, barTrack: 2719, accent: 14733725, relics: RelicTiers }],
  [League.THREE, { barFill: 4109, barTrack: 4110, accent: 2752445, relics: NoRelics }],
  [League.FOUR, { barFill: 5445, barTrack: 5446, accent: 16742144, relics: RelicTiers }],
  [League.FIVE, { barFill: 6124, barTrack: 6125, accent: 2147070, relics: RelicTiers }],
  [League.SIX, { barFill: 8317, barTrack: 8318, accent: 16019731, relics: RelicTiers }],
]);

export const ShatteredTiers = mapOf<Int, Int>([
  [1, 0],
  [2, 10],
  [3, 300],
  [4, 1500],
  [5, 3000],
  [6, 7500],
  [7, 15000],
]);

export const TierNames = mapOf<Int, String>([
  [1, 'I'],
  [2, 'II'],
  [3, 'III'],
  [4, 'IV'],
  [5, 'V'],
  [6, 'VI'],
  [7, 'VII'],
]);

export const SHATTERED_TIER_COUNT = 7;
