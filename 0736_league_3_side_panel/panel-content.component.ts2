import { useServerState } from 'ts2';
import { SidePanelButton } from './side-panel-button.component';
import { relicBarWidth, tierThreshold, unlockedTier } from './league-3-side-panel.helpers';
import {
  League,
  LeagueThemes,
  SidePanelButtons,
  SidePanelColor,
  SidePanelFonts,
  SidePanelLayout,
  SidePanelSprites,
  SidePanelText,
  SidePanelVarbits,
  SidePanelVarps,
  TierNames,
} from './league-3-side-panel.constants';

function tierMessage(): String {
  const next: Int = tierThreshold(false, false);
  const points: Int = useServerState(SidePanelVarps.POINTS);
  const remaining: Int = next !== -1 ? next - points : -1;
  if (remaining <= 0) {
    return '<col=ffffff>You have unlocked all Tiers!</col>';
  }
  const tier: String = TierNames.get(unlockedTier() + 1) ?? 'null';
  return `<col=ffffff>${stringOf(remaining)}</col> points until Tier ${tier}.`;
}

export function PanelContent(): Component {
  const league: Int = useServerState(SidePanelVarbits.LEAGUE);
  const theme = LeagueThemes.get(league as League);
  const accent: Int = theme === null ? SidePanelColor.ACCENT_DEFAULT : theme.accent;
  const barFill: Sprite = theme === null ? SidePanelSprites.BAR_FILL_DEFAULT : theme.barFill;
  const barTrack: Sprite = theme === null ? SidePanelSprites.BAR_TRACK_DEFAULT : theme.barTrack;

  const tasks: Int = useServerState(SidePanelVarbits.TASKS);
  const points: Int = useServerState(SidePanelVarps.POINTS);
  const renown: Int = useServerState(SidePanelVarps.RENOWN);

  return (
    <layer
      x="center"
      y="center"
      w={{ fill: SidePanelLayout.CONTENT_INSET }}
      h={{ fill: SidePanelLayout.CONTENT_INSET }}
    >
      <text
        x="center"
        y={SidePanelLayout.MESSAGE_Y}
        w={SidePanelLayout.MESSAGE_W}
        h={SidePanelLayout.ROW_H}
        text={tierMessage()}
        font={SidePanelFonts.BODY}
        color={accent}
        shadow
        align="center"
        valign="middle"
      />

      <rect
        x={{ center: SidePanelLayout.BAR_DX }}
        y={SidePanelLayout.BAR_BED_Y}
        w={SidePanelLayout.BAR_BED_W}
        h={SidePanelLayout.BAR_BED_H}
        fill
        color={0x000000}
      />

      <layer
        x={{ center: SidePanelLayout.BAR_DX }}
        y={SidePanelLayout.BAR_Y}
        w={SidePanelLayout.BAR_W}
        h={SidePanelLayout.BAR_H}
      >
        <sprite x="center" y="center" w="fill" h="fill" sprite={barTrack} />
        <sprite x={0} y="center" w={relicBarWidth()} h="fill" sprite={barFill} />
      </layer>

      <sprite
        x={{ center: SidePanelLayout.BADGE_DX }}
        y={SidePanelLayout.BADGE_Y}
        w={SidePanelLayout.BADGE}
        h={SidePanelLayout.BADGE}
        sprite={SidePanelSprites.RELIC_BADGE}
      />

      <text
        x={{ center: SidePanelLayout.LABEL_DX }}
        y={SidePanelLayout.ROW_TASKS_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={SidePanelText.TASKS}
        font={SidePanelFonts.BODY}
        color={accent}
        shadow
        align="left"
        valign="middle"
      />
      <text
        x={{ center: SidePanelLayout.VALUE_DX }}
        y={SidePanelLayout.ROW_TASKS_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={stringOf(tasks)}
        font={SidePanelFonts.BODY}
        color={SidePanelColor.VALUE}
        shadow
        align="right"
        valign="middle"
      />

      <text
        x={{ center: SidePanelLayout.LABEL_DX }}
        y={SidePanelLayout.ROW_POINTS_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={SidePanelText.POINTS}
        font={SidePanelFonts.BODY}
        color={accent}
        shadow
        align="left"
        valign="middle"
      />
      <text
        x={{ center: SidePanelLayout.VALUE_DX }}
        y={SidePanelLayout.ROW_POINTS_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={stringOf(points)}
        font={SidePanelFonts.BODY}
        color={SidePanelColor.VALUE}
        shadow
        align="right"
        valign="middle"
      />

      <text
        x={{ center: SidePanelLayout.LABEL_DX }}
        y={SidePanelLayout.ROW_RENOWN_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={SidePanelText.RENOWN}
        font={SidePanelFonts.BODY}
        color={accent}
        shadow
        align="left"
        valign="middle"
      />
      <text
        x={{ center: SidePanelLayout.VALUE_DX }}
        y={SidePanelLayout.ROW_RENOWN_Y}
        w={SidePanelLayout.LABEL_W}
        h={SidePanelLayout.ROW_H}
        text={stringOf(renown)}
        font={SidePanelFonts.BODY}
        color={SidePanelColor.VALUE}
        shadow
        align="right"
        valign="middle"
      />

      <layer x="center" y={SidePanelLayout.BUTTONS_Y} w={SidePanelLayout.BUTTONS_W} h={SidePanelLayout.BUTTONS_H}>
        {SidePanelButtons.map((button) => (
          <layer
            x={button.right === 1 ? { right: SidePanelLayout.BUTTON_INSET } : SidePanelLayout.BUTTON_INSET}
            y={button.bottom === 1 ? { bottom: SidePanelLayout.BUTTON_INSET } : SidePanelLayout.BUTTON_INSET}
            w={SidePanelLayout.BUTTON_W}
            h={SidePanelLayout.BUTTON_H}
          >
            <SidePanelButton option={button.option} label={button.label} clicks={button.clicks} />
          </layer>
        ))}
      </layer>
    </layer>
  );
}
