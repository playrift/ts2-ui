import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { buttonSelectSound } from './league-3-side-panel.state';
import { SidePanelColor, SidePanelFonts, SidePanelLayout } from './league-3-side-panel.constants';

function SidePanelButtonMount({ option, clicks = 0 }: { option: String; clicks?: Int }): Component {
  const [hovered, setHovered] = useState(0);
  const mobile = onMobile();

  if (mobile && clicks === 1) {
    return (
      <layer w="fill" h="fill" options={[option]} onOptionSelect={() => buttonSelectSound()}>
        {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      </layer>
    );
  }
  if (mobile) {
    return (
      <layer w="fill" h="fill" options={[option]}>
        {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      </layer>
    );
  }
  if (clicks === 1) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[option]}
        onMouseEnter={() => setHovered(1)}
        onMouseLeave={() => setHovered(0)}
        onOptionSelect={() => buttonSelectSound()}
      >
        {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      </layer>
    );
  }
  return (
    <layer w="fill" h="fill" options={[option]} onMouseEnter={() => setHovered(1)} onMouseLeave={() => setHovered(0)}>
      {hovered === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
    </layer>
  );
}

export function SidePanelButton({
  option,
  label,
  clicks = 0,
}: {
  option: String;
  label: String;
  clicks?: Int;
}): Component {
  return (
    <layer w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={SidePanelColor.BUTTON_WASH}
        transparency={SidePanelLayout.BUTTON_WASH_TRANSPARENCY}
      />
      <layer x="center" y="center" w="fill" h="fill">
        <SidePanelButtonMount option={option} clicks={clicks} />
      </layer>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={SidePanelFonts.BODY}
        color={SidePanelColor.BUTTON_LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
