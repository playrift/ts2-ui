import { CappedBoxParams } from './league-3-select-class.constants';

export function CappedStructBox({ x, y, w, h, style }: { x: Int; y: Int; w: Int; h: Int; style: Row }): Component {
  const b: Int = style.int(CappedBoxParams.BORDER);
  const halfW: Int = (w - 3 * b) / 2;
  const halfH: Int = (h - 3 * b) / 2 + (b % 2 !== h % 2 ? 1 : 0);

  return (
    <>
      <sprite x={x + b} y={y + b} w={w - 2 * b} h={h - 2 * b} sprite={style.sprite(CappedBoxParams.FILL)} tiling />

      <sprite x={x + b} y={y} w={halfW} h={b} sprite={style.sprite(CappedBoxParams.EDGE_TOP)} tiling />
      <sprite x={x + w - halfW - b} y={y} w={halfW} h={b} sprite={style.sprite(CappedBoxParams.EDGE_TOP)} tiling />
      <sprite x={x + w / 2 - b / 2} y={y} w={b} h={b} sprite={style.sprite(CappedBoxParams.CAP_TOP)} tiling />

      <sprite x={x + b} y={y + h - b} w={halfW} h={b} sprite={style.sprite(CappedBoxParams.EDGE_BOTTOM)} tiling />
      <sprite
        x={x + w - halfW - b}
        y={y + h - b}
        w={halfW}
        h={b}
        sprite={style.sprite(CappedBoxParams.EDGE_BOTTOM)}
        tiling
      />
      <sprite
        x={x + w / 2 - b / 2}
        y={y + h - b}
        w={b}
        h={b}
        sprite={style.sprite(CappedBoxParams.CAP_BOTTOM)}
        tiling
      />

      <sprite x={x} y={y + b} w={b} h={halfH} sprite={style.sprite(CappedBoxParams.EDGE_LEFT)} tiling />
      <sprite x={x} y={y + h - halfH - b} w={b} h={halfH} sprite={style.sprite(CappedBoxParams.EDGE_LEFT)} tiling />
      <sprite x={x} y={y + h / 2 - b / 2} w={b} h={b} sprite={style.sprite(CappedBoxParams.CAP_LEFT)} tiling />

      <sprite x={x + w - b} y={y + b} w={b} h={halfH} sprite={style.sprite(CappedBoxParams.EDGE_RIGHT)} tiling />
      <sprite
        x={x + w - b}
        y={y + h - halfH - b}
        w={b}
        h={halfH}
        sprite={style.sprite(CappedBoxParams.EDGE_RIGHT)}
        tiling
      />
      <sprite x={x + w - b} y={y + h / 2 - b / 2} w={b} h={b} sprite={style.sprite(CappedBoxParams.CAP_RIGHT)} tiling />

      <sprite x={x} y={y} w={b} h={b} sprite={style.sprite(CappedBoxParams.CORNER_TL)} tiling />
      <sprite x={x + w - b} y={y} w={b} h={b} sprite={style.sprite(CappedBoxParams.CORNER_TR)} tiling />
      <sprite x={x} y={y + h - b} w={b} h={b} sprite={style.sprite(CappedBoxParams.CORNER_BL)} tiling />
      <sprite x={x + w - b} y={y + h - b} w={b} h={b} sprite={style.sprite(CappedBoxParams.CORNER_BR)} tiling />
    </>
  );
}
