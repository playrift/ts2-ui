import { useRef } from 'ts2';

import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { onMobile } from '../lib/lib.helpers';
import { SelectColors, SelectFonts, SelectLayout } from './league-3-select-class.constants';

export function ClassCard({ icon, title, body }: { icon: Sprite; title: String; body: String }): Component {
  const raised = useRef();
  const pressed = useRef();
  const mobile: Boolean = onMobile();

  return (
    <>
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        options={['Select']}
        onMouseOver={() => {
          if (!mobile) {
            raised.hide = true;
            pressed.hide = false;
          }
        }}
        onMouseLeave={() => {
          if (!mobile) {
            raised.hide = false;
            pressed.hide = true;
          }
        }}
      >
        <layer ref={raised} w="fill" h="fill">
          <StoneButton />
        </layer>
        <layer ref={pressed} w="fill" h="fill" hide>
          <StoneButtonPressed />
        </layer>
      </layer>

      <sprite x="center" y={SelectLayout.ICON_Y} w={SelectLayout.ICON_SIZE} h={SelectLayout.ICON_SIZE} sprite={icon} />

      <text
        x="center"
        y={SelectLayout.TITLE_Y}
        w={{ fill: SelectLayout.CARD_TEXT_INSET }}
        h={SelectLayout.TITLE_HEIGHT}
        text={title}
        font={SelectFonts.TITLE}
        color={SelectColors.HEADING}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x="center"
        y={SelectLayout.BODY_Y}
        w={{ fill: SelectLayout.CARD_TEXT_INSET }}
        h={SelectLayout.BODY_HEIGHT}
        text={body}
        font={SelectFonts.BODY}
        color={SelectColors.BODY}
        align="center"
        valign="top"
        lineHeight={SelectLayout.BODY_LINE_HEIGHT}
        shadow
      />
    </>
  );
}
