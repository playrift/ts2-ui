import { useRef } from 'ts2';

import { CappedStructBox } from './capped-struct-box.component';
import { onMobile } from '../lib/lib.helpers';
import { SelectLayout } from './league-3-select-class.constants';

export function ConfirmButton({
  offset,
  op,
  style,
  hoverStyle,
}: {
  offset: Int;
  op: String;
  style: Row;
  hoverStyle: Row;
}): Component {
  const normal = useRef();
  const hovered = useRef();
  const mobile: Boolean = onMobile();

  return (
    <layer
      x={{ center: offset }}
      y={{ bottom: SelectLayout.BUTTON_BOTTOM }}
      w={SelectLayout.BUTTON_WIDTH}
      h={SelectLayout.BUTTON_HEIGHT}
      options={[op]}
      onMouseOver={() => {
        if (!mobile) {
          normal.hide = true;
          hovered.hide = false;
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          normal.hide = false;
          hovered.hide = true;
        }
      }}
    >
      <layer ref={normal} w="fill" h="fill">
        <CappedStructBox x={0} y={0} w={SelectLayout.BUTTON_WIDTH} h={SelectLayout.BUTTON_HEIGHT} style={style} />
      </layer>
      <layer ref={hovered} w="fill" h="fill" hide>
        <CappedStructBox x={0} y={0} w={SelectLayout.BUTTON_WIDTH} h={SelectLayout.BUTTON_HEIGHT} style={hoverStyle} />
      </layer>
    </layer>
  );
}
