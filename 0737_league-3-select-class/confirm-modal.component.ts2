import { useServerState } from 'ts2';

import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { leagueColour } from '../0735_league-3-fragments/league-3-fragments.helpers';
import { ClassChoices } from './class-choices.data';
import { ConfirmButton } from './confirm-button.component';
import {
  ButtonStyle,
  ButtonStyles,
  League,
  SelectColors,
  SelectFonts,
  SelectLayout,
  SelectVarps,
} from './league-3-select-class.constants';

export function ConfirmModal(): Component {
  const choice: Int = useServerState(SelectVarps.CHOICE);
  if (choice < 1) {
    return null;
  }

  const accent: Int = leagueColour(League.ID);
  const chosen = ClassChoices.get(choice);
  if (chosen === null) {
    return null;
  }

  return (
    <layer w="fill" h="fill" noClickThrough>
      <rect w="fill" h="fill" color={SelectColors.SCRIM} fill transparency={200} />

      <layer x="center" y="center" w={SelectLayout.MESSAGE_WIDTH} h={SelectLayout.MESSAGE_HEIGHT}>
        <SteelFrame backdrop />

        <text
          x={SelectLayout.MESSAGE_TEXT_X}
          y={SelectLayout.MESSAGE_TOP_Y}
          w={{ fill: SelectLayout.MESSAGE_TEXT_INSET }}
          h={SelectLayout.MESSAGE_TEXT_HEIGHT}
          text={`<col=cfcfcf>Are you sure you wish to become a:<br>${chosen.title}<br><col=cfcfcf>Other combat skills and Fragments may still be unlocked later.`}
          font={SelectFonts.TITLE}
          color={accent}
          shadow
          align="center"
          valign="top"
          lineHeight={SelectLayout.MESSAGE_LINE_HEIGHT}
        />

        <sprite
          x="center"
          y={{ center: SelectLayout.MESSAGE_ICON_OFFSET }}
          w={SelectLayout.ICON_SIZE}
          h={SelectLayout.ICON_SIZE}
          sprite={chosen.icon}
          tiling
        />

        <text
          x={SelectLayout.MESSAGE_TEXT_X}
          y={SelectLayout.MESSAGE_BOTTOM_Y}
          w={{ fill: SelectLayout.MESSAGE_TEXT_INSET }}
          h={SelectLayout.MESSAGE_TEXT_HEIGHT}
          text={`${chosen.fragment} Fragment:<br><col=cfcfcf>${chosen.perk}`}
          font={SelectFonts.TITLE}
          color={accent}
          shadow
          align="center"
          valign="top"
          lineHeight={SelectLayout.MESSAGE_LINE_HEIGHT}
        />
      </layer>

      <ConfirmButton
        offset={-SelectLayout.BUTTON_OFFSET}
        op="Decline"
        style={ButtonStyles.at(ButtonStyle.DECLINE)}
        hoverStyle={ButtonStyles.at(ButtonStyle.DECLINE_HOVER)}
      />
      <text
        x={{ center: -SelectLayout.BUTTON_OFFSET + 1 }}
        y={{ bottom: SelectLayout.LABEL_BOTTOM }}
        w={SelectLayout.BUTTON_WIDTH}
        h={SelectLayout.LABEL_HEIGHT}
        text="Decline"
        font={SelectFonts.TITLE}
        color={SelectColors.DECLINE}
        align="center"
        valign="middle"
      />
      <text
        x={{ center: -SelectLayout.BUTTON_OFFSET }}
        y={{ bottom: SelectLayout.LABEL_SHADOW_BOTTOM }}
        w={SelectLayout.BUTTON_WIDTH}
        h={SelectLayout.LABEL_HEIGHT}
        text="Decline"
        font={SelectFonts.TITLE}
        align="center"
        valign="middle"
      />

      <ConfirmButton
        offset={SelectLayout.BUTTON_OFFSET}
        op="Accept"
        style={ButtonStyles.at(ButtonStyle.ACCEPT)}
        hoverStyle={ButtonStyles.at(ButtonStyle.ACCEPT_HOVER)}
      />
      <text
        x={{ center: SelectLayout.BUTTON_OFFSET }}
        y={{ bottom: SelectLayout.LABEL_BOTTOM }}
        w={SelectLayout.BUTTON_WIDTH}
        h={SelectLayout.LABEL_HEIGHT}
        text="Accept"
        font={SelectFonts.TITLE}
        color={SelectColors.ACCEPT}
        align="center"
        valign="middle"
      />
      <text
        x={{ center: SelectLayout.BUTTON_OFFSET - 1 }}
        y={{ bottom: SelectLayout.LABEL_SHADOW_BOTTOM }}
        w={SelectLayout.BUTTON_WIDTH}
        h={SelectLayout.LABEL_HEIGHT}
        text="Accept"
        font={SelectFonts.TITLE}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
