import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { ClassCard } from './class-card.component';
import { ClassChoices } from './class-choices.data';
import { SelectColors, SelectFonts, SelectLayout } from './league-3-select-class.constants';
import { ConfirmModal } from './confirm-modal.component';

const CARDS = [1, 2, 3];

export function SelectClass(): Component {
  return (
    <layer x="center" y="center" w={SelectLayout.PANEL_WIDTH} h={SelectLayout.PANEL_HEIGHT}>
      <layer x="center" y="center" w="fill" h="fill">
        <SteelFrame backdrop />
      </layer>

      <layer w={SelectLayout.PANEL_WIDTH} h={SelectLayout.PANEL_HEIGHT}>
        <text
          x="center"
          y={SelectLayout.HEADING_Y}
          w={{ fill: SelectLayout.HEADING_INSET }}
          h={SelectLayout.HEADING_HEIGHT}
          text="Please choose your starting combat class."
          font={SelectFonts.HEADING}
          color={SelectColors.HEADING}
          align="center"
          valign="middle"
          shadow
        />

        {CARDS.map((choice, index) => (
          <layer
            x={index === 0 ? SelectLayout.CARD_EDGE : index === 1 ? 'center' : { right: SelectLayout.CARD_EDGE }}
            y={SelectLayout.CARD_TOP}
            w={SelectLayout.CARD_WIDTH}
            h={{ fill: SelectLayout.CARD_BOTTOM }}
          >
            <ClassCard
              icon={ClassChoices.get(choice).icon}
              title={ClassChoices.get(choice).title}
              body={ClassChoices.get(choice).body}
            />
          </layer>
        ))}
      </layer>

      <ConfirmModal />
    </layer>
  );
}
