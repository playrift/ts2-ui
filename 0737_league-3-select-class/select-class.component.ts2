import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { ClassCard } from './class-card.component';
import { ClassIcons, SelectColors, SelectFonts, SelectLayout } from './league-3-select-class.constants';
import { ConfirmModal } from './confirm-modal.component';

export function SelectClass(): Component {
  return (
    <layer x="center" y="center" w={SelectLayout.PANEL_WIDTH} h={SelectLayout.PANEL_HEIGHT}>
      <layer x="center" y="center" w="fill" h="fill">
        <SteelFrame backdrop />
      </layer>

      <layer w={SelectLayout.PANEL_WIDTH} h={SelectLayout.PANEL_HEIGHT}>
        <text
          x="center"
          y={SelectLayout.HEADING_Y}
          w={{ fill: SelectLayout.HEADING_INSET }}
          h={SelectLayout.HEADING_HEIGHT}
          text="Please choose your starting combat class."
          font={SelectFonts.HEADING}
          color={SelectColors.HEADING}
          align="center"
          valign="middle"
          shadow
        />

        <layer
          x={SelectLayout.CARD_EDGE}
          y={SelectLayout.CARD_TOP}
          w={SelectLayout.CARD_WIDTH}
          h={{ fill: SelectLayout.CARD_BOTTOM }}
        >
          <ClassCard
            icon={ClassIcons.WARRIOR}
            title="Unwavering Warrior"
            body="As a warrior you will start with the <col=29ffbd>Attack</col> skill unlocked.<br><br>You will also receive a <col=29ffbd>Steel Scimitar</col> and the <col=29ffbd>Unholy Warrior</col> fragment."
          />
        </layer>

        <layer x="center" y={SelectLayout.CARD_TOP} w={SelectLayout.CARD_WIDTH} h={{ fill: SelectLayout.CARD_BOTTOM }}>
          <ClassCard
            icon={ClassIcons.RANGER}
            title="Focused Ranger"
            body="As a ranger you will start with the <col=29ffbd>Ranged</col> skill unlocked.<br><br>You will also receive a <col=29ffbd>Oak Longbow, Iron Arrows,</col> and the <br><col=29ffbd>Bottomless Quiver</col> fragment."
          />
        </layer>

        <layer
          x={{ right: SelectLayout.CARD_EDGE }}
          y={SelectLayout.CARD_TOP}
          w={SelectLayout.CARD_WIDTH}
          h={{ fill: SelectLayout.CARD_BOTTOM }}
        >
          <ClassCard
            icon={ClassIcons.WIZARD}
            title="Masterful Wizard"
            body="As a wizard you will start with the <col=29ffbd>Magic</col> skill unlocked.<br><br>You will also receive a <col=29ffbd>Staff, extra runes,</col> and the <col=29ffbd>Arcane Conduit</col> fragment."
          />
        </layer>
      </layer>

      <ConfirmModal />
    </layer>
  );
}
