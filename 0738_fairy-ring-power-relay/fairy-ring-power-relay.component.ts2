import { predictServerState, useRef, useServerState, useState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import {
  FairyColors,
  FairyFonts,
  FairyModels,
  FairySounds,
  FairySprites,
  Varbits,
} from './fairy-ring-power-relay.constants';
import { clampConnectors, meterHeight, refresh } from './fairy-ring-power-relay.helpers';
import { playSound } from '../lib/lib.engine';

export function FairyRingPowerRelay(): Component {
  const count1 = useServerState(Varbits.CONNECTORS_1);
  const count2 = useServerState(Varbits.CONNECTORS_2);
  const count3 = useServerState(Varbits.CONNECTORS_3);

  const [pressed, setPressed] = useState(0);

  const preview1 = useRef();
  const preview2 = useRef();
  const preview3 = useRef();

  const up1 = useRef();
  const down1 = useRef();
  const up2 = useRef();
  const down2 = useRef();
  const up3 = useRef();
  const down3 = useRef();

  const counter1 = useRef();
  const meter1 = useRef();
  const counter2 = useRef();
  const meter2 = useRef();
  const counter3 = useRef();
  const meter3 = useRef();

  return (
    <layer w="fill" h="fill">
      <SteelBorderEntrypoint title="Fairy Ring Power Relay">
        <layer x="center" y={{ bottom: 6 }} w={{ fill: 12 }} h={{ fill: 41 }}>
          <layer x={-5} y="center" w={274} h={261}>
            <model x="center" y="center" w={32} h={32} model={FairyModels.HUB} zoom={242} orthogonal />

            <layer x={{ center: -50 }} y="center" w={22} h={106}>
              <rect
                ref={meter1}
                x="center"
                y="bottom"
                w="fill"
                h={meterHeight(count1)}
                color={FairyColors.METER}
                fill
                transparency={120}
              />
            </layer>
            <model
              x={{ center: -50 }}
              y={{ center: 12 }}
              w={32}
              h={32}
              model={FairyModels.PRONG}
              zoom={220}
              orthogonal
            />
            <sprite ref={up1} x={{ center: -50 }} y={{ center: -62 }} w={10} h={10} sprite={FairySprites.UP_IDLE} />
            <sprite ref={down1} x={{ center: -50 }} y={{ center: 63 }} w={10} h={10} sprite={FairySprites.DOWN_IDLE} />
            <layer
              x={{ center: -50 }}
              y={{ center: -64 }}
              w={30}
              h={26}
              options={['Add']}
              onOptionSelect={() => {
                if (count1 < 15) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_1, count1 + 1);
                  refresh(counter1, meter1, count1 + 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter1, meter1, count1);
                }
                refresh(counter2, meter2, count2);
                refresh(counter3, meter3, count3);
              }}
              onMouseRepeat={() => {
                up1.sprite = FairySprites.UP_PRESSED;
                preview1.hide = false;
              }}
              onMouseLeave={() => {
                up1.sprite = FairySprites.UP_IDLE;
                preview1.hide = true;
              }}
            />
            <layer
              x={{ center: -50 }}
              y={{ center: 65 }}
              w={30}
              h={26}
              options={['Subtract']}
              onOptionSelect={() => {
                if (count1 > 0) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_1, count1 - 1);
                  refresh(counter1, meter1, count1 - 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter1, meter1, count1);
                }
                refresh(counter2, meter2, count2);
                refresh(counter3, meter3, count3);
              }}
              onMouseRepeat={() => {
                down1.sprite = FairySprites.DOWN_PRESSED;
                preview1.hide = false;
              }}
              onMouseLeave={() => {
                down1.sprite = FairySprites.DOWN_IDLE;
                preview1.hide = true;
              }}
            />
            <text
              ref={counter1}
              x={{ center: -50 }}
              y={{ center: 1 }}
              w={21}
              h={17}
              text={`${clampConnectors(count1)}`}
              font={FairyFonts.BODY}
              align="center"
              valign="middle"
              shadow
              color={FairyColors.COUNTER}
            />

            <layer x={{ center: -1 }} y="center" w={22} h={106}>
              <rect
                ref={meter2}
                x="center"
                y="bottom"
                w="fill"
                h={meterHeight(count2)}
                color={FairyColors.METER}
                fill
                transparency={120}
              />
            </layer>
            <model
              x={{ center: -1 }}
              y={{ center: 12 }}
              w={32}
              h={32}
              model={FairyModels.PRONG}
              zoom={220}
              orthogonal
            />
            <sprite ref={up2} x={{ center: -1 }} y={{ center: -62 }} w={10} h={10} sprite={FairySprites.UP_IDLE} />
            <sprite ref={down2} x={{ center: -1 }} y={{ center: 63 }} w={10} h={10} sprite={FairySprites.DOWN_IDLE} />
            <layer
              x={{ center: -1 }}
              y={{ center: -64 }}
              w={30}
              h={26}
              options={['Add']}
              onOptionSelect={() => {
                if (count2 < 15) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_2, count2 + 1);
                  refresh(counter2, meter2, count2 + 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter2, meter2, count2);
                }
                refresh(counter1, meter1, count1);
                refresh(counter3, meter3, count3);
              }}
              onMouseRepeat={() => {
                up2.sprite = FairySprites.UP_PRESSED;
                preview2.hide = false;
              }}
              onMouseLeave={() => {
                up2.sprite = FairySprites.UP_IDLE;
                preview2.hide = true;
              }}
            />
            <layer
              x={{ center: -1 }}
              y={{ center: 65 }}
              w={30}
              h={26}
              options={['Subtract']}
              onOptionSelect={() => {
                if (count2 > 0) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_2, count2 - 1);
                  refresh(counter2, meter2, count2 - 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter2, meter2, count2);
                }
                refresh(counter1, meter1, count1);
                refresh(counter3, meter3, count3);
              }}
              onMouseRepeat={() => {
                down2.sprite = FairySprites.DOWN_PRESSED;
                preview2.hide = false;
              }}
              onMouseLeave={() => {
                down2.sprite = FairySprites.DOWN_IDLE;
                preview2.hide = true;
              }}
            />
            <text
              ref={counter2}
              x={{ center: -1 }}
              y={{ center: 1 }}
              w={21}
              h={17}
              text={`${clampConnectors(count2)}`}
              font={FairyFonts.BODY}
              align="center"
              valign="middle"
              shadow
              color={FairyColors.COUNTER}
            />

            <layer x={{ center: 50 }} y="center" w={22} h={106}>
              <rect
                ref={meter3}
                x="center"
                y="bottom"
                w="fill"
                h={meterHeight(count3)}
                color={FairyColors.METER}
                fill
                transparency={120}
              />
            </layer>
            <model
              x={{ center: 50 }}
              y={{ center: 12 }}
              w={32}
              h={32}
              model={FairyModels.PRONG}
              zoom={220}
              orthogonal
            />
            <sprite ref={up3} x={{ center: 50 }} y={{ center: -62 }} w={10} h={10} sprite={FairySprites.UP_IDLE} />
            <sprite ref={down3} x={{ center: 50 }} y={{ center: 63 }} w={10} h={10} sprite={FairySprites.DOWN_IDLE} />
            <layer
              x={{ center: 50 }}
              y={{ center: -64 }}
              w={30}
              h={26}
              options={['Add']}
              onOptionSelect={() => {
                if (count3 < 15) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_3, count3 + 1);
                  refresh(counter3, meter3, count3 + 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter3, meter3, count3);
                }
                refresh(counter1, meter1, count1);
                refresh(counter2, meter2, count2);
              }}
              onMouseRepeat={() => {
                up3.sprite = FairySprites.UP_PRESSED;
                preview3.hide = false;
              }}
              onMouseLeave={() => {
                up3.sprite = FairySprites.UP_IDLE;
                preview3.hide = true;
              }}
            />
            <layer
              x={{ center: 50 }}
              y={{ center: 65 }}
              w={30}
              h={26}
              options={['Subtract']}
              onOptionSelect={() => {
                if (count3 > 0) {
                  playSound(FairySounds.ADJUST);
                  predictServerState(Varbits.CONNECTORS_3, count3 - 1);
                  refresh(counter3, meter3, count3 - 1);
                } else {
                  playSound(FairySounds.ADJUST_MAX);
                  refresh(counter3, meter3, count3);
                }
                refresh(counter1, meter1, count1);
                refresh(counter2, meter2, count2);
              }}
              onMouseRepeat={() => {
                down3.sprite = FairySprites.DOWN_PRESSED;
                preview3.hide = false;
              }}
              onMouseLeave={() => {
                down3.sprite = FairySprites.DOWN_IDLE;
                preview3.hide = true;
              }}
            />
            <text
              ref={counter3}
              x={{ center: 49 }}
              y={{ center: 1 }}
              w={22}
              h={17}
              text={`${clampConnectors(count3)}`}
              font={FairyFonts.BODY}
              align="center"
              valign="middle"
              shadow
              color={FairyColors.COUNTER}
            />
          </layer>

          <layer x="right" y="center" w={206} h={261}>
            <model x="center" y={98} w={32} h={32} model={FairyModels.BASE} zoom={912} orthogonal />
            <layer ref={preview1} x="center" y="center" w="fill" h="fill" hide>
              <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_1} zoom={912} orthogonal />
            </layer>
            <layer ref={preview2} x="center" y="center" w="fill" h="fill" hide>
              <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_2} zoom={912} orthogonal />
            </layer>
            <layer ref={preview3} x="center" y="center" w="fill" h="fill" hide>
              <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_3} zoom={912} orthogonal />
            </layer>

            <layer
              x="center"
              y={{ bottom: 6 }}
              w={122}
              h={32}
              onMouseRepeat={() => {
                setPressed(1);
              }}
              onMouseLeave={() => {
                setPressed(0);
              }}
            >
              {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
            </layer>
            <text
              x="center"
              y={{ bottom: 6 }}
              w={122}
              h={32}
              text="Confirm"
              font={FairyFonts.BODY}
              align="center"
              valign="middle"
              shadow
              color={FairyColors.CONFIRM_LABEL}
            />
          </layer>
        </layer>
      </SteelBorderEntrypoint>
    </layer>
  );
}
