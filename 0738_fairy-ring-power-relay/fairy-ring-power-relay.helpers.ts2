export function clampConnectors(count: Int): Int {
  return Math.clamp(0, 15, count);
}

export function meterHeight(count: Int): Int {
  const clamped = clampConnectors(count);
  if (clamped < 15) {
    return CS2.scale(106, 15, clamped);
  }
  return 106;
}

export function refresh(counter: Ref, meter: Ref, count: Int): void {
  counter.text = `${clampConnectors(count)}`;
  meter.height = meterHeight(count);
}
