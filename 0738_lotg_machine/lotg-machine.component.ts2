import { predictServerState, useServerState, useState, useWatch } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { FairyColors, FairyFonts, FairyModels, FairySounds, FairySprites, Varbits } from './lotg-machine.constants';
import { arrowSprite, clampConnectors, meterHeight } from './lotg-machine.helpers';

export function FairyRingPowerRelay(): Component {
  return (
    <layer w="fill" h="fill">
      <SteelBorderEntrypoint title="Fairy Ring Power Relay">
        <RelayBody />
      </SteelBorderEntrypoint>
    </layer>
  );
}

export function RelayBody(): Component {
  const count1 = useServerState(Varbits.CONNECTORS_1);
  const count2 = useServerState(Varbits.CONNECTORS_2);
  const count3 = useServerState(Varbits.CONNECTORS_3);

  const [drawn1, setDrawn1] = useState(0);
  const [drawn2, setDrawn2] = useState(0);
  const [drawn3, setDrawn3] = useState(0);

  const [up1, setUp1] = useState(0);
  const [down1, setDown1] = useState(0);
  const [up2, setUp2] = useState(0);
  const [down2, setDown2] = useState(0);
  const [up3, setUp3] = useState(0);
  const [down3, setDown3] = useState(0);
  const [preview1, setPreview1] = useState(0);
  const [preview2, setPreview2] = useState(0);
  const [preview3, setPreview3] = useState(0);

  useWatch(Varbits.CONNECTORS_1, () => {
    setDrawn1(count1);
    setDrawn2(count2);
    setDrawn3(count3);
  });

  return (
    <layer x="center" y={{ bottom: 6 }} w={{ fill: 12 }} h={{ fill: 41 }}>
      <layer x={-5} y="center" w={274} h={261}>
        <model x="center" y="center" w={32} h={32} model={FairyModels.HUB} zoom={242} orthogonal />

        <layer x={{ center: -50 }} y="center" w={22} h={106}>
          <rect
            x="center"
            y="bottom"
            w="fill"
            h={meterHeight(drawn1)}
            color={FairyColors.METER}
            fill
            transparency={120}
          />
        </layer>
        <model x={{ center: -50 }} y={{ center: 12 }} w={32} h={32} model={FairyModels.PRONG} zoom={220} orthogonal />
        <sprite
          x={{ center: -50 }}
          y={{ center: -62 }}
          w={10}
          h={10}
          sprite={arrowSprite(up1, FairySprites.UP_PRESSED, FairySprites.UP_IDLE)}
        />
        <sprite
          x={{ center: -50 }}
          y={{ center: 63 }}
          w={10}
          h={10}
          sprite={arrowSprite(down1, FairySprites.DOWN_PRESSED, FairySprites.DOWN_IDLE)}
        />
        <layer
          x={{ center: -50 }}
          y={{ center: -64 }}
          w={30}
          h={26}
          options={['Add']}
          onOptionSelect={() => {
            if (count1 < 15) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_1, count1 + 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setUp1(1);
              setPreview1(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setUp1(0);
              setPreview1(0);
            }
          }}
        />
        <layer
          x={{ center: -50 }}
          y={{ center: 65 }}
          w={30}
          h={26}
          options={['Subtract']}
          onOptionSelect={() => {
            if (count1 > 0) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_1, count1 - 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setDown1(1);
              setPreview1(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setDown1(0);
              setPreview1(0);
            }
          }}
        />
        <text
          x={{ center: -50 }}
          y={{ center: 1 }}
          w={21}
          h={17}
          text={`${clampConnectors(drawn1)}`}
          font={FairyFonts.BODY}
          align="center"
          valign="middle"
          shadow
          color={FairyColors.COUNTER}
        />

        <layer x={{ center: -1 }} y="center" w={22} h={106}>
          <rect
            x="center"
            y="bottom"
            w="fill"
            h={meterHeight(drawn2)}
            color={FairyColors.METER}
            fill
            transparency={120}
          />
        </layer>
        <model x={{ center: -1 }} y={{ center: 12 }} w={32} h={32} model={FairyModels.PRONG} zoom={220} orthogonal />
        <sprite
          x={{ center: -1 }}
          y={{ center: -62 }}
          w={10}
          h={10}
          sprite={arrowSprite(up2, FairySprites.UP_PRESSED, FairySprites.UP_IDLE)}
        />
        <sprite
          x={{ center: -1 }}
          y={{ center: 63 }}
          w={10}
          h={10}
          sprite={arrowSprite(down2, FairySprites.DOWN_PRESSED, FairySprites.DOWN_IDLE)}
        />
        <layer
          x={{ center: -1 }}
          y={{ center: -64 }}
          w={30}
          h={26}
          options={['Add']}
          onOptionSelect={() => {
            if (count2 < 15) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_2, count2 + 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setUp2(1);
              setPreview2(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setUp2(0);
              setPreview2(0);
            }
          }}
        />
        <layer
          x={{ center: -1 }}
          y={{ center: 65 }}
          w={30}
          h={26}
          options={['Subtract']}
          onOptionSelect={() => {
            if (count2 > 0) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_2, count2 - 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setDown2(1);
              setPreview2(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setDown2(0);
              setPreview2(0);
            }
          }}
        />
        <text
          x={{ center: -1 }}
          y={{ center: 1 }}
          w={21}
          h={17}
          text={`${clampConnectors(drawn2)}`}
          font={FairyFonts.BODY}
          align="center"
          valign="middle"
          shadow
          color={FairyColors.COUNTER}
        />

        <layer x={{ center: 50 }} y="center" w={22} h={106}>
          <rect
            x="center"
            y="bottom"
            w="fill"
            h={meterHeight(drawn3)}
            color={FairyColors.METER}
            fill
            transparency={120}
          />
        </layer>
        <model x={{ center: 50 }} y={{ center: 12 }} w={32} h={32} model={FairyModels.PRONG} zoom={220} orthogonal />
        <sprite
          x={{ center: 50 }}
          y={{ center: -62 }}
          w={10}
          h={10}
          sprite={arrowSprite(up3, FairySprites.UP_PRESSED, FairySprites.UP_IDLE)}
        />
        <sprite
          x={{ center: 50 }}
          y={{ center: 63 }}
          w={10}
          h={10}
          sprite={arrowSprite(down3, FairySprites.DOWN_PRESSED, FairySprites.DOWN_IDLE)}
        />
        <layer
          x={{ center: 50 }}
          y={{ center: -64 }}
          w={30}
          h={26}
          options={['Add']}
          onOptionSelect={() => {
            if (count3 < 15) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_3, count3 + 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setUp3(1);
              setPreview3(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setUp3(0);
              setPreview3(0);
            }
          }}
        />
        <layer
          x={{ center: 50 }}
          y={{ center: 65 }}
          w={30}
          h={26}
          options={['Subtract']}
          onOptionSelect={() => {
            if (count3 > 0) {
              playSound(FairySounds.ADJUST);
              predictServerState(Varbits.CONNECTORS_3, count3 - 1);
            } else {
              playSound(FairySounds.ADJUST_MAX);
            }
            setDrawn1(count1);
            setDrawn2(count2);
            setDrawn3(count3);
          }}
          onMouseRepeat={() => {
            if (!onMobile()) {
              setDown3(1);
              setPreview3(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setDown3(0);
              setPreview3(0);
            }
          }}
        />
        <text
          x={{ center: 49 }}
          y={{ center: 1 }}
          w={22}
          h={17}
          text={`${clampConnectors(drawn3)}`}
          font={FairyFonts.BODY}
          align="center"
          valign="middle"
          shadow
          color={FairyColors.COUNTER}
        />
      </layer>

      <layer x="right" y="center" w={206} h={261}>
        <model x="center" y={98} w={32} h={32} model={FairyModels.BASE} zoom={912} orthogonal />
        <layer x="center" y="center" w="fill" h="fill" hide={previewHidden(preview1)}>
          <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_1} zoom={912} orthogonal />
        </layer>
        <layer x="center" y="center" w="fill" h="fill" hide={previewHidden(preview2)}>
          <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_2} zoom={912} orthogonal />
        </layer>
        <layer x="center" y="center" w="fill" h="fill" hide={previewHidden(preview3)}>
          <model x="center" y={98} w={32} h={32} model={FairyModels.CONNECTOR_3} zoom={912} orthogonal />
        </layer>

        <layer x="center" y={{ bottom: 6 }} w={122} h={32}>
          <ConfirmButton />
        </layer>
        <text
          x="center"
          y={{ bottom: 6 }}
          w={122}
          h={32}
          text="Confirm"
          font={FairyFonts.BODY}
          align="center"
          valign="middle"
          shadow
          color={FairyColors.CONFIRM_LABEL}
        />
      </layer>
    </layer>
  );
}

export function ConfirmButton(): Component {
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setPressed(0);
        }
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
    </layer>
  );
}

function previewHidden(shown: Int): Boolean {
  return shown === 0;
}
