import { scaled } from '../lib/lib.engine';

export function clampConnectors(count: Int): Int {
  return Math.clamp(0, 15, count);
}

export function meterHeight(count: Int): Int {
  const clamped = clampConnectors(count);
  if (clamped < 15) {
    return scaled(106, 15, clamped);
  }
  return 106;
}

export function arrowSprite(held: Int, pressed: Sprite, idle: Sprite): Sprite {
  if (held !== 0) {
    return pressed;
  }
  return idle;
}
