import { useServerState } from 'ts2';
import { LotgAnimations, LotgLayout, LotgModels, LotgVarbits } from './lotg-makeover.constants';

export function GoblinPreview(): Component {
  const chosen: Int = useServerState(LotgVarbits.GOBLIN_TYPE);

  return (
    <model
      x={{ center: LotgLayout.MODEL_X }}
      y={{ center: LotgLayout.MODEL_Y }}
      w={LotgLayout.MODEL_W}
      h={LotgLayout.MODEL_H}
      model={
        chosen === 6
          ? LotgModels.GOBLIN_6
          : chosen === 5
            ? LotgModels.GOBLIN_5
            : chosen === 4
              ? LotgModels.GOBLIN_4
              : chosen === 3
                ? LotgModels.GOBLIN_3
                : chosen === 2
                  ? LotgModels.GOBLIN_2
                  : LotgModels.GOBLIN_1
      }
      anim={LotgAnimations.GOBLIN_IDLE}
      zoom={LotgLayout.MODEL_ZOOM}
      pitch={LotgLayout.MODEL_PITCH}
      yaw={LotgLayout.MODEL_YAW}
      orthogonal
    />
  );
}
