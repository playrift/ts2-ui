import { useRef, useServerState } from 'ts2';
import { colourSwapperUnlessMobile, selectGoblin } from './lotg-makeover.helpers';
import { LotgColors, LotgFonts, LotgLayout, LotgSprites, LotgVarbits } from './lotg-makeover.constants';

export function GoblinRow({ index, label }: { index: Int; label: String }): Component {
  const chosen: Int = useServerState(LotgVarbits.GOBLIN_TYPE);
  const labelText = useRef();

  return (
    <layer
      x="center"
      y={(index - 1) * LotgLayout.ROW_HEIGHT}
      w="fill"
      h={LotgLayout.ROW_HEIGHT}
      options={['Select']}
      optionSubject={`<col=ff9040>${label}`}
      onOptionSelect={() => selectGoblin(index)}
      onMouseRepeat={() => colourSwapperUnlessMobile(labelText, LotgColors.LABEL_HOVER)}
      onMouseLeave={() => colourSwapperUnlessMobile(labelText, LotgColors.LABEL)}
    >
      <text
        ref={labelText}
        x={LotgLayout.LABEL_X}
        y="center"
        w={LotgLayout.LABEL_W}
        h={LotgLayout.LABEL_H}
        text={label}
        font={LotgFonts.BODY}
        valign="middle"
        shadow
        color={LotgColors.LABEL}
      />

      <sprite
        x={LotgLayout.CHECK_X}
        y={LotgLayout.CHECK_Y}
        w={LotgLayout.CHECK_SIZE}
        h={LotgLayout.CHECK_SIZE}
        sprite={chosen === index ? LotgSprites.CHECK_ON : LotgSprites.CHECK_OFF}
      />
    </layer>
  );
}
