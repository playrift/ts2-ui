import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ConfirmButton } from './confirm-button.component';
import { GoblinPreview } from './goblin-preview.component';
import { GoblinRow } from './goblin-row.component';
import { LotgColors, LotgFonts, LotgLayout } from './lotg-makeover.constants';

export function LotgMakeover(): Component {
  return (
    <layer x="center" y="center" w={LotgLayout.WINDOW_WIDTH} h={LotgLayout.WINDOW_HEIGHT}>
      <SteelBorderEntrypoint title="Select Your Goblin" />

      <layer
        x="center"
        y={{ bottom: LotgLayout.CONTENT_BOTTOM }}
        w={{ fill: LotgLayout.CONTENT_INSET_W }}
        h={{ fill: LotgLayout.CONTENT_INSET_H }}
      >
        <layer
          x={{ right: LotgLayout.PREVIEW_RIGHT }}
          y="center"
          w={LotgLayout.PREVIEW_WIDTH}
          h={{ fill: LotgLayout.BOX_INSET_H }}
        >
          <rect
            x="center"
            y="center"
            w={{ fill: LotgLayout.BOX_INTERIOR }}
            h={{ fill: LotgLayout.BOX_INTERIOR }}
            color={LotgColors.BACKDROP}
            fill
            transparency={212}
          />

          <layer x="center" y="center" w={{ fill: LotgLayout.BOX_INTERIOR }} h={{ fill: LotgLayout.BOX_INTERIOR }}>
            <GoblinPreview />
          </layer>

          <ThinBoxEntrypoint />
        </layer>
        <layer
          x={LotgLayout.LIST_X}
          y="center"
          w={{ fill: LotgLayout.LIST_INSET_W }}
          h={{ fill: LotgLayout.BOX_INSET_H }}
        >
          <rect
            x="center"
            y="center"
            w={{ fill: LotgLayout.BOX_INTERIOR }}
            h={{ fill: LotgLayout.BOX_INTERIOR }}
            color={LotgColors.BACKDROP}
            fill
            transparency={212}
          />

          <layer x="center" y="center" w={{ fill: LotgLayout.BOX_INTERIOR }} h={{ fill: LotgLayout.BOX_INTERIOR }}>
            <layer x="center" y={LotgLayout.ROWS_Y} w="fill" h={LotgLayout.ROWS_HEIGHT}>
              <GoblinRow index={1} label="Goblin 1" />
              <GoblinRow index={2} label="Goblin 2" />
              <GoblinRow index={3} label="Goblin 3" />
              <GoblinRow index={4} label="Goblin 4" />
              <GoblinRow index={5} label="Goblin 5" />
              <GoblinRow index={6} label="Goblin 6" />
            </layer>

            <ConfirmButton
              x="center"
              y={{ bottom: LotgLayout.CONFIRM_BOTTOM }}
              w={LotgLayout.CONFIRM_W}
              h={LotgLayout.CONFIRM_H}
            />

            <text
              x="center"
              y={{ bottom: LotgLayout.CONFIRM_BOTTOM }}
              w={LotgLayout.CONFIRM_W}
              h={LotgLayout.CONFIRM_H}
              text="Confirm"
              font={LotgFonts.BODY}
              align="center"
              valign="middle"
              shadow
              color={LotgColors.LABEL}
            />
          </layer>

          <ThinBoxEntrypoint />
        </layer>
      </layer>
    </layer>
  );
}
