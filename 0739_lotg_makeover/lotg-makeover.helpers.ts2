import { predictServerState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { playSound } from '../lib/lib.engine';
import { LotgSounds, LotgVarbits } from './lotg-makeover.constants';

export function colourSwapperUnlessMobile(component: ComponentId, colour: Int): void {
  if (!onMobile()) {
    component.color = colour;
  }
}

export function selectGoblin(choice: Int): void {
  playSound(LotgSounds.SELECT);
  predictServerState(LotgVarbits.GOBLIN_TYPE, choice);
}
