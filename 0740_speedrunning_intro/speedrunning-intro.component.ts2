import { SteelborderSprite } from '../lib/lib.constants';
import { textLineCount } from '../lib/lib.engine';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { IntroButton } from './intro-button.component';
import { IntroColors, IntroFonts, IntroLayout } from './speedrunning-intro.constants';

export function speedrunningIntroText(): String {
  return '<col=ffffff>Speedrunning Worlds</col> are worlds where you can repeatedly play <col=ffffff>quests</col> as many times as you want!<br><br>Your main aim on these worlds is to complete <col=ffffff>quests</col> as fast as you can to set new <col=ffffff>best times</col>. In doing so, you can unlock <col=ffffff>Speedrun Trophies</col> and earn <col=ffffff>Speedrun Points</col>.<br><br>To get started, just head to your <col=ffffff>Quest List</col> in the<br><col=ffffff>Journal Panel</col> and select a <col=ffffff>quest</col> to <col=ffffff>speedrun</col>. Good luck!';
}

export function SpeedrunningIntro(): Component {
  const body: String = speedrunningIntroText();

  const lines: Int = textLineCount(body, IntroLayout.BODY_WIDTH, IntroFonts.BODY) + 1;
  const measured: Int = lines < IntroLayout.MIN_LINES ? IntroLayout.MIN_LINES : lines;
  const shortfall: Int = lines < IntroLayout.REFERENCE_LINES ? IntroLayout.REFERENCE_LINES - measured : 0;

  return (
    <>
      <layer w="fill" h="fill" noClickThrough />

      <layer
        x="center"
        y="center"
        w={IntroLayout.PANEL_WIDTH}
        h={IntroLayout.PANEL_HEIGHT - shortfall * IntroLayout.BODY_LINE_HEIGHT}
      >
        <layer w="fill" h="fill">
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={SteelborderSprite.BACKDROP} />
          <SteelFrameEntrypoint />
        </layer>

        <layer x="center" y="center" w={{ fill: IntroLayout.CONTENT_INSET }} h={{ fill: IntroLayout.CONTENT_INSET }}>
          <layer
            x="center"
            y={IntroLayout.HEADER_Y}
            w={{ fill: IntroLayout.HEADER_INSET }}
            h={IntroLayout.HEADER_HEIGHT}
          >
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text="Welcome to Speedrunning Worlds!"
              font={IntroFonts.HEADING}
              color={IntroColors.TEXT}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer
            x="center"
            y={IntroLayout.BODY_Y}
            w={{ fill: IntroLayout.BODY_INSET }}
            h={{ fill: IntroLayout.BODY_BOTTOM_INSET }}
          >
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={body}
              font={IntroFonts.BODY}
              color={IntroColors.TEXT}
              align="center"
              valign="middle"
              shadow
              lineHeight={IntroLayout.BODY_LINE_HEIGHT}
            />
          </layer>

          <IntroButton label="Exit Speedrunning" offset={-IntroLayout.BUTTON_OFFSET} />
          <IntroButton label="Get Started" offset={IntroLayout.BUTTON_OFFSET} />

          <layer
            x="center"
            y={{ bottom: IntroLayout.GRAPHIC_BOTTOM }}
            w={IntroLayout.GRAPHIC_WIDTH}
            h={IntroLayout.GRAPHIC_HEIGHT}
          />
        </layer>
      </layer>
    </>
  );
}
