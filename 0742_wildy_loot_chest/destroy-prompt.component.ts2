import { useRef, useState } from 'ts2';

import { LootColors, LootFonts, LootLayout, LootSprites, LootText } from './wildy-loot-chest.constants';
import { closeDestroyPrompt, destroyPromptOpen } from './wildy-loot-chest.state';

export function DestroyPrompt(): Component {
  const [open] = useState(destroyPromptOpen);
  const destroyLabel = useRef();
  const cancelLabel = useRef();

  if (open !== 1) {
    return null;
  }

  return (
    <layer x="center" y="center" w={LootLayout.WINDOW_W} h={LootLayout.WINDOW_H} noClickThrough>
      <rect
        x="center"
        y="center"
        w={{ fill: LootLayout.OVERLAY_DIM_INSET }}
        h={{ fill: LootLayout.OVERLAY_DIM_INSET }}
        fill
        color={LootColors.DIM}
        transparency={LootLayout.DIM_TRANSPARENCY}
      />
      <text
        x="center"
        y={LootLayout.PROMPT_Y}
        w={{ fill: LootLayout.PROMPT_INSET_X }}
        h={LootLayout.PROMPT_H}
        text={LootText.PROMPT_TITLE}
        font={LootFonts.PROMPT}
        color={LootColors.PROMPT_WARNING}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y={LootLayout.PROMPT_BODY_Y}
        w={{ fill: LootLayout.PROMPT_BODY_INSET_X }}
        h={LootLayout.PROMPT_BODY_H}
        text={LootText.PROMPT_BODY}
        font={LootFonts.SMALL}
        color={LootColors.LABEL}
        shadow
        align="center"
        valign="middle"
        lineHeight={LootLayout.PROMPT_BODY_LINE_HEIGHT}
      />
      <layer x="center" y={LootLayout.PROMPT_ROW_Y} w={LootLayout.PROMPT_ROW_W} h={LootLayout.PROMPT_ROW_H}>
        <sprite
          x={0}
          y={0}
          w={LootLayout.PROMPT_BUTTON_W}
          h={LootLayout.PROMPT_ROW_H}
          sprite={LootSprites.PROMPT_BUTTON}
          options={[LootText.CONFIRM_DESTROY]}
          onMouseEnter={() => {
            destroyLabel.color = LootColors.LABEL_HOVER;
          }}
          onMouseLeave={() => {
            destroyLabel.color = LootColors.LABEL;
          }}
          onOptionSelect={() => {
            closeDestroyPrompt();
          }}
        />
        <sprite
          x="right"
          y={0}
          w={LootLayout.PROMPT_BUTTON_W}
          h={LootLayout.PROMPT_ROW_H}
          sprite={LootSprites.PROMPT_BUTTON}
          options={[LootText.CANCEL]}
          onMouseEnter={() => {
            cancelLabel.color = LootColors.LABEL_HOVER;
          }}
          onMouseLeave={() => {
            cancelLabel.color = LootColors.LABEL;
          }}
          onOptionSelect={() => {
            closeDestroyPrompt();
          }}
        />
        <text
          ref={destroyLabel}
          x={0}
          y={0}
          w={LootLayout.PROMPT_BUTTON_W}
          h={LootLayout.PROMPT_ROW_H}
          text={LootText.DESTROY}
          font={LootFonts.PROMPT}
          color={LootColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
        <text
          ref={cancelLabel}
          x="right"
          y={0}
          w={LootLayout.PROMPT_BUTTON_W}
          h={LootLayout.PROMPT_ROW_H}
          text={LootText.CANCEL}
          font={LootFonts.PROMPT}
          color={LootColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </layer>
  );
}
