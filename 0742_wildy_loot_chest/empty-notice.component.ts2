import { useDerived } from 'ts2';

import { LootColors, LootFonts, LootLayout, LootText } from './wildy-loot-chest.constants';
import { selectedTabIsEmpty } from './wildy-loot-chest.helpers';

export function EmptyNotice(): Component {
  const empty: Int = useDerived(() => selectedTabIsEmpty());

  if (empty !== 1) {
    return null;
  }

  return (
    <text
      x={0}
      y={0}
      w="fill"
      h="fill"
      text={LootText.EMPTY}
      font={LootFonts.BODY}
      color={LootColors.LABEL}
      shadow
      align="center"
      valign="middle"
    />
  );
}

export function FooterGreyout(): Component {
  const empty: Int = useDerived(() => selectedTabIsEmpty());

  if (empty !== 1) {
    return null;
  }

  return <rect x={0} y={0} w="fill" h="fill" fill color={LootColors.DIM} transparency={LootLayout.DIM_TRANSPARENCY} />;
}
