import { useInventory, useServerState, useState } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { LootInventories, LootLayout, LootVarbits } from './wildy-loot-chest.constants';
import { destroyPromptOpen } from './wildy-loot-chest.state';

function LootCell({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={(slot % LootLayout.CELL_COLUMNS) * LootLayout.CELL_PITCH_X}
      y={(slot / LootLayout.CELL_COLUMNS) * LootLayout.CELL_PITCH_Y}
      w={LootLayout.CELL_W}
      h={LootLayout.CELL_H}
      item={item}
      itemCount={count}
      outline={LootLayout.CELL_OUTLINE}
      shadowColor={LootLayout.CELL_SHADOW}
      options={[
        'Take',
        'Take-5',
        'Take-10',
        'Take-X',
        'Take-All',
        'Bank-X',
        'Bank-All',
        'Destroy-X',
        'Destroy-All',
        'Examine',
      ]}
      optionSubject={`<col=ff981f>${itemName(item)}`}
    />
  );
}

export function LootGrid(): Component {
  const tab: Int = useServerState(LootVarbits.TAB);
  const [promptOpen] = useState(destroyPromptOpen);

  return (
    <layer w="fill" h="fill" hide={promptOpen === 1}>
      {tab === 1 ? (
        <layer w="fill" h="fill">
          <LootGridTier1 />
        </layer>
      ) : tab === 2 ? (
        <layer w="fill" h="fill">
          <LootGridTier2 />
        </layer>
      ) : tab === 3 ? (
        <layer w="fill" h="fill">
          <LootGridTier3 />
        </layer>
      ) : tab === 4 ? (
        <layer w="fill" h="fill">
          <LootGridTier4 />
        </layer>
      ) : (
        <layer w="fill" h="fill">
          <LootGridTier0 />
        </layer>
      )}
    </layer>
  );
}

function LootGridTier0(): Component {
  const chest = useInventory(LootInventories.TIER0);
  return (
    <layer w="fill" h="fill">
      {chest.map((item, slot) => (item !== -1 ? <LootCell item={item} count={chest.count(slot)} slot={slot} /> : null))}
    </layer>
  );
}

