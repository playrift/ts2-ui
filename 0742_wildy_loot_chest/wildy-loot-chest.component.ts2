import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { DestroyButton, WithdrawButton } from './action-buttons.component';
import { DestroyPrompt } from './destroy-prompt.component';
import { EmptyNotice, FooterGreyout } from './empty-notice.component';
import { LootGrid } from './loot-grid.component';
import { TabBar } from './tab-bar.component';
import { WithdrawToggle } from './withdraw-toggle.component';
import { LootColors, LootFonts, LootLayout, LootSprites, LootText } from './wildy-loot-chest.constants';

export function WildyLootChest(): Component {
  return (
    <>
      <layer x="center" y="center" w={LootLayout.WINDOW_W} h={LootLayout.WINDOW_H}>
        <StoneBorderEntrypoint title={LootText.TITLE} />

        <line
          x="center"
          y={LootLayout.RULE_Y}
          w={{ fill: LootLayout.RULE_INSET_X }}
          h={0}
          color={LootColors.DIVIDER}
          lineWidth={1}
        />

        <layer x={LootLayout.TABS_X} y={LootLayout.TABS_Y} w={{ fill: LootLayout.TABS_INSET_X }} h={LootLayout.TABS_H}>
          <TabBar />
        </layer>

        <layer x="center" y={LootLayout.GRID_Y} w={LootLayout.GRID_W} h={LootLayout.GRID_H}>
          <LootGrid />
        </layer>

        <layer x="center" y={LootLayout.GRID_Y} w={LootLayout.GRID_W} h={LootLayout.GRID_H}>
          <EmptyNotice />
        </layer>

        <sprite
          x={0}
          y={LootLayout.FOOTER_LEFT_Y}
          w={LootLayout.FOOTER_LEFT_W}
          h={LootLayout.FOOTER_LEFT_H}
          sprite={LootSprites.FOOTER_LEFT}
        />
        <sprite
          x={LootLayout.FOOTER_TILE_X}
          y={LootLayout.FOOTER_TILE_Y}
          w={{ fill: LootLayout.FOOTER_TILE_INSET }}
          h={LootLayout.FOOTER_TILE_H}
          sprite={LootSprites.FOOTER_TILE}
          tiling
        />
        <sprite
          x={{ right: LootLayout.FOOTER_RIGHT_X }}
          y={LootLayout.FOOTER_LEFT_Y}
          w={LootLayout.FOOTER_RIGHT_W}
          h={LootLayout.FOOTER_RIGHT_H}
          sprite={LootSprites.FOOTER_RIGHT}
        />

        <layer
          x={LootLayout.DESTROY_X}
          y={{ bottom: LootLayout.DESTROY_BOTTOM }}
          w={LootLayout.BUTTON_BOX}
          h={LootLayout.BUTTON_BOX}
        >
          <DestroyButton />
        </layer>

        <line
          x={LootLayout.RULE_LEFT_X}
          y={{ bottom: LootLayout.RULE_BOTTOM }}
          w={0}
          h={LootLayout.RULE_H}
          color={LootColors.DIVIDER}
          lineWidth={1}
        />

        <text
          x={LootLayout.WITHDRAW_LABEL_X}
          y={{ bottom: LootLayout.WITHDRAW_LABEL_BOTTOM }}
          w={LootLayout.WITHDRAW_LABEL_W}
          h={LootLayout.WITHDRAW_LABEL_H}
          text={LootText.WITHDRAW_AS}
          font={LootFonts.BODY}
          color={LootColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />

        <WithdrawToggle />

        <layer
          x={{ right: LootLayout.INVENTORY_RIGHT }}
          y={{ bottom: LootLayout.DESTROY_BOTTOM }}
          w={LootLayout.BUTTON_BOX}
          h={LootLayout.BUTTON_BOX}
        >
          <WithdrawButton
            icon={LootSprites.ICON_INVENTORY}
            centered={0}
            iconX={LootLayout.INVENTORY_ICON_X}
            iconY={LootLayout.INVENTORY_ICON_Y}
          />
        </layer>

        <line
          x={{ right: LootLayout.RULE_RIGHT_X }}
          y={{ bottom: LootLayout.RULE_BOTTOM }}
          w={0}
          h={LootLayout.RULE_H}
          color={LootColors.DIVIDER}
          lineWidth={1}
        />

        <text
          x={{ right: LootLayout.COUNTER_RIGHT }}
          y={{ bottom: LootLayout.COUNTER_BOTTOM }}
          w={LootLayout.COUNTER_W}
          h={LootLayout.COUNTER_H}
          font={LootFonts.SMALL}
          color={LootColors.LABEL}
          shadow
          align="center"
        />
        <line
          x={{ right: LootLayout.COUNTER_RULE_RIGHT }}
          y={{ bottom: LootLayout.COUNTER_RULE_BOTTOM }}
          w={LootLayout.COUNTER_RULE_W}
          h={0}
          color={LootColors.LABEL}
          lineWidth={1}
        />
        <text
          x={{ right: LootLayout.COUNTER_RIGHT }}
          y={{ bottom: LootLayout.COUNTER_BOTTOM }}
          w={LootLayout.COUNTER_W}
          h={LootLayout.COUNTER_H}
          font={LootFonts.SMALL}
          color={LootColors.LABEL}
          shadow
          align="center"
          valign="bottom"
        />

        <layer
          x={{ right: LootLayout.BANK_RIGHT }}
          y={{ bottom: LootLayout.DESTROY_BOTTOM }}
          w={LootLayout.BUTTON_BOX}
          h={LootLayout.BUTTON_BOX}
        >
          <WithdrawButton icon={LootSprites.ICON_BANK} centered={1} iconX={0} iconY={0} />
        </layer>

        <layer
          x="center"
          y={{ bottom: LootLayout.GREYOUT_BOTTOM }}
          w={{ fill: LootLayout.GREYOUT_INSET_X }}
          h={LootLayout.GREYOUT_H}
        >
          <FooterGreyout />
        </layer>
      </layer>

      <DestroyPrompt />
    </>
  );
}
