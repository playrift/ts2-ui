import { CS2, useServerState } from 'ts2';

import { LootVarbits, SLOTS_PER_TAB } from './wildy-loot-chest.constants';
import { LootKeyInventories } from './loot-key-inventories.data';

export function selectedTabIsEmpty(): Int {
  const chest: Inventory = LootKeyInventories.at(useServerState(LootVarbits.TAB)) ?? -1;
  let slot: Int = 0;
  while (slot < SLOTS_PER_TAB) {
    if (CS2.inv_item_get(chest, slot) !== -1) {
      return 0;
    }
    slot = slot + 1;
  }
  return 1;
}
