import { useServerState, useState } from 'ts2';

import {
  LootColors,
  LootFonts,
  LootLayout,
  LootSprites,
  LootText,
  LootVarbits,
  WithdrawMode,
} from './wildy-loot-chest.constants';
import { selectWithdrawMode } from './wildy-loot-chest.state';

export function WithdrawToggle(): Component {
  const mode: Int = useServerState(LootVarbits.WITHDRAW_NOTES);
  const notes: Int = mode === WithdrawMode.NOTE ? 1 : 0;

  const [itemHot, setItemHot] = useState(0);
  const [noteHot, setNoteHot] = useState(0);

  return (
    <layer w="fill" h="fill">
      <layer
        x={LootLayout.TOGGLE_ITEM_X}
        y={{ bottom: LootLayout.TOGGLE_BOTTOM }}
        w={LootLayout.TOGGLE_W}
        h={LootLayout.TOGGLE_H}
        options={[LootText.ITEM]}
        onMouseEnter={() => {
          setItemHot(1);
        }}
        onMouseLeave={() => {
          setItemHot(0);
        }}
        onOptionSelect={() => {
          selectWithdrawMode(WithdrawMode.ITEM, mode);
        }}
      >
        <sprite
          x={0}
          y={0}
          w={LootLayout.TOGGLE_CAP_W}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_A_LEFT : LootSprites.TOGGLE_B_LEFT}
        />
        <sprite
          x="center"
          y={0}
          w={{ fill: LootLayout.TOGGLE_MID_INSET }}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_A_MID : LootSprites.TOGGLE_B_MID}
          tiling
        />
        <sprite
          x="right"
          y={0}
          w={LootLayout.TOGGLE_CAP_W}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_A_RIGHT : LootSprites.TOGGLE_B_RIGHT}
        />
        <text
          x="center"
          y={0}
          w={LootLayout.TOGGLE_ITEM_LABEL_W}
          h={LootLayout.TOGGLE_H}
          text={LootText.ITEM}
          font={LootFonts.BODY}
          color={itemHot === 1 ? LootColors.LABEL_HOVER : LootColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <layer
        x={LootLayout.TOGGLE_NOTE_X}
        y={{ bottom: LootLayout.TOGGLE_BOTTOM }}
        w={LootLayout.TOGGLE_W}
        h={LootLayout.TOGGLE_H}
        options={[LootText.NOTE]}
        onOptionSelect={() => {
          selectWithdrawMode(WithdrawMode.NOTE, mode);
        }}
      >
        <sprite
          x={0}
          y={0}
          w={LootLayout.TOGGLE_CAP_W}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_B_LEFT : LootSprites.TOGGLE_A_LEFT}
          onMouseEnter={() => {
            setNoteHot(1);
          }}
          onMouseLeave={() => {
            setNoteHot(0);
          }}
        />
        <sprite
          x="center"
          y={0}
          w={{ fill: LootLayout.TOGGLE_MID_INSET }}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_B_MID : LootSprites.TOGGLE_A_MID}
          tiling
          onMouseEnter={() => {
            setNoteHot(1);
          }}
          onMouseLeave={() => {
            setNoteHot(0);
          }}
        />
        <sprite
          x="right"
          y={0}
          w={LootLayout.TOGGLE_CAP_W}
          h={LootLayout.TOGGLE_H}
          sprite={notes === 1 ? LootSprites.TOGGLE_B_RIGHT : LootSprites.TOGGLE_A_RIGHT}
          onMouseEnter={() => {
            setNoteHot(1);
          }}
          onMouseLeave={() => {
            setNoteHot(0);
          }}
        />
        <text
          x="center"
          y={0}
          w="fill"
          h={LootLayout.TOGGLE_H}
          text={LootText.NOTE}
          font={LootFonts.BODY}
          color={noteHot === 1 ? LootColors.LABEL_HOVER : LootColors.LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    </layer>
  );
}
