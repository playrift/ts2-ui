import { useInterval, useRef, useState } from 'ts2';

import { atmosphericRef, PORTAL_ANIM, Wipe } from './gotr-overlay.constants';
import { gotrOverlayReset, gotrOverlayTick } from './gotr-overlay.helpers';
import {
  gotrWipeBuilt,
  gotrWipeColour,
  gotrWipeModel,
  gotrWipeStartedAt,
  gotrWipeWash,
  gotrWipeZoom,
} from './gotr-overlay.state';

export function GotrOverlay(): Component {
  return (
    <layer ref={atmosphericRef} w="fill" h="fill" x="center" y="center" onLoad={() => gotrOverlayReset()}>
      <GotrWipe />
    </layer>
  );
}

function GotrWipe(): Component {
  const [built] = useState(gotrWipeBuilt);
  const [modelId] = useState(gotrWipeModel);
  const model: Model = modelId as Model;
  const [colour] = useState(gotrWipeColour);
  const [zoom] = useState(gotrWipeZoom);
  const [wash] = useState(gotrWipeWash);
  const [startedAt] = useState(gotrWipeStartedAt);
  const host = useRef();
  useInterval(() => gotrOverlayTick(), host);

  return (
    <layer x="center" y="center" w="fill" h="fill" rebuildOn={built}>
      <layer ref={host} x={0} y={0} w={1} h={1} hide={startedAt < 0} />
      {built > 0 && <WipeArt model={model} colour={colour} zoom={zoom} wash={wash} />}
    </layer>
  );
}

function WipeArt({ model, colour, zoom, wash }: { model: Model; colour: Int; zoom: Int; wash: Int }): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={model}
        anim={PORTAL_ANIM}
        offsetY={Wipe.MODEL_OFFSET_Y}
        zoom={zoom}
      />
      <rect x="center" y="center" w="fill" h="fill" color={colour} fill transparency={wash} />
    </>
  );
}
