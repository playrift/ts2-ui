import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { GLOSS_WASH, GotrArt, GotrColor, GotrContent, GotrFonts, GotrOverlay, Layout } from './gotr-hud.constants';

const timerHost = createRef('0746_gotr_hud_timer_host');

const content = createRef('gotr_hud_content');

function EnergyCounter({ icon, caption }: { icon: Sprite; caption: String }): Component {
  return (
    <>
      <sprite x="center" y={Layout.ICON_Y} w={Layout.ICON} h={Layout.ICON} sprite={icon} />
      <text
        x="center"
        y={{ bottom: Layout.CAPTION_DY }}
        w={Layout.CAPTION_W}
        h={Layout.CAPTION_H}
        text={caption}
        align="center"
        shadow
        font={GotrFonts.COUNTER}
        color={GotrColor.WHITE}
      />
    </>
  );
}

function RewardPlate({ icon }: { icon: Sprite }): Component {
  return (
    <>
      <sprite x="center" y={Layout.PLATE_ICON_Y} w={Layout.ICON} h={Layout.ICON} sprite={icon} />
      <text
        x="center"
        y={Layout.PLATE_LABEL_Y}
        w={Layout.PLATE_LABEL_W}
        h={Layout.PLATE_LABEL_H}
        align="center"
        valign="middle"
        shadow
        font={GotrFonts.COUNTER}
        color={GotrColor.WHITE}
      />
    </>
  );
}

export function GotrHud(): Component {
  useInterval(() => overlayRelayout(timerHost, content, GotrOverlay.DODGE, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer w="fill" h="fill" ref={timerHost}>
      <layer ref={content} x={0} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <layer x={Layout.BODY_X} y={0} w={{ fill: Layout.BODY_INSET_W }} h="fill">
          <layer x={0} y={0} w={{ fill: Layout.COLUMN_INSET_W }} h="fill">
            <text
              x={Layout.TIMER_X}
              y={{ center: Layout.TIMER_DY }}
              w={Layout.TIMER_W}
              h={Layout.TIMER_H}
              contentType={GotrContent.COMPONENT_5}
              font={GotrFonts.COUNTER}
              color={GotrColor.WHITE}
              shadow
            />

            <layer x="center" y={Layout.METER_Y} w={{ fill: Layout.METER_INSET_W }} h={Layout.METER_H}>
              <rect
                x="center"
                y="center"
                w={{ fill: Layout.TROUGH_INSET }}
                h="fill"
                color={GotrColor.METER_TROUGH}
                fill
              />

              <rect x={Layout.FILL_X} y={0} w={0} h="fill" color={GotrColor.METER_FILL} fill />

              <rect
                x={Layout.FILL_X}
                y={Layout.LINE_OFFSET}
                w={{ fill: Layout.TROUGH_INSET }}
                h={{ fill: Layout.GLOSS_INSET_H }}
                color={GotrColor.WHITE}
                fill
                transparency={GLOSS_WASH}
              />

              <line
                x={0}
                y="center"
                w={0}
                h={{ fill: Layout.LINE_INSET }}
                color={GotrColor.BLACK}
                lineWidth={Layout.LINE_W}
              />
              <line
                x={{ right: Layout.LINE_OFFSET }}
                y="center"
                w={0}
                h={{ fill: Layout.LINE_INSET }}
                color={GotrColor.BLACK}
                lineWidth={Layout.LINE_W}
              />

              <line
                x="center"
                y={0}
                w={{ fill: Layout.LINE_INSET }}
                h={0}
                color={GotrColor.BLACK}
                lineWidth={Layout.LINE_W}
              />
              <line
                x="center"
                y={{ bottom: Layout.LINE_OFFSET }}
                w={{ fill: Layout.LINE_INSET }}
                h={0}
                color={GotrColor.BLACK}
                lineWidth={Layout.LINE_W}
              />

              <rect
                x={Layout.LINE_OFFSET}
                y={Layout.LINE_OFFSET}
                w={Layout.PIP}
                h={Layout.PIP}
                color={GotrColor.BLACK}
              />
              <rect
                x={{ right: Layout.LINE_OFFSET }}
                y={Layout.LINE_OFFSET}
                w={Layout.PIP}
                h={Layout.PIP}
                color={GotrColor.BLACK}
              />
              <rect
                x={{ right: Layout.LINE_OFFSET }}
                y={{ bottom: Layout.LINE_OFFSET }}
                w={Layout.PIP}
                h={Layout.PIP}
                color={GotrColor.BLACK}
              />
              <rect
                x={Layout.LINE_OFFSET}
                y={{ bottom: Layout.LINE_OFFSET }}
                w={Layout.PIP}
                h={Layout.PIP}
                color={GotrColor.BLACK}
              />
            </layer>

            <text
              x="center"
              y={Layout.LABEL_Y}
              w={{ fill: Layout.LABEL_INSET_W }}
              h={Layout.LABEL_H}
              text="Guardian's Power: 0%"
              align="center"
              valign="middle"
              font={GotrFonts.POWER}
              color={GotrColor.BLACK}
            />

            <layer x={Layout.COUNTER_X} y={Layout.COUNTER_Y} w={Layout.COUNTER_W} h={{ fill: Layout.COUNTER_INSET_H }}>
              <EnergyCounter icon={GotrArt.ELEMENTAL} caption="Elemental<br>Energy: 0" />
            </layer>

            <layer
              x={{ right: Layout.COUNTER_X }}
              y={Layout.COUNTER_Y}
              w={Layout.COUNTER_W}
              h={{ fill: Layout.COUNTER_INSET_H }}
            >
              <EnergyCounter icon={GotrArt.CATALYTIC} caption="Catalytic<br>Energy: 0" />
            </layer>
          </layer>

          <layer x="right" y={0} w={{ fill: Layout.PLATE_INSET_W }} h={{ fill: Layout.PLATE_INSET_H }}>
            <RewardPlate icon={GotrArt.REWARD_UPPER} />
          </layer>

          <layer hide x="right" y="bottom" w={{ fill: Layout.PLATE_INSET_W }} h={{ fill: Layout.PLATE_INSET_H }}>
            <RewardPlate icon={GotrArt.REWARD_LOWER} />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
