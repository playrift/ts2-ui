import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  LINE_Y,
  StoneplaqueArt,
  StoneplaqueColor,
  StoneplaqueFont,
  StoneplaqueModel,
} from './stoneplaque.constants';

export function Stoneplaque(): Component {
  return (
    <>
      <model
        x={Layout.BACKGROUND_X}
        y={Layout.BACKGROUND_Y}
        w={Layout.BACKGROUND_W}
        h={Layout.BACKGROUND_H}
        model={StoneplaqueModel.BACKGROUND}
        zoom={Camera.ZOOM}
      />

      <layer x={{ center: Layout.CONTENT_X_OFFSET }} y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        {LINE_Y.map((y) => (
          <text
            x="center"
            y={y}
            w={{ fill: Layout.LINE_INSET }}
            h={Layout.LINE_H}
            font={StoneplaqueFont.LINE}
            color={StoneplaqueColor.INK}
            align="center"
            shadow
          />
        ))}
      </layer>

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_ICON_X}
          y={Layout.CLOSE_ICON_Y}
          w={Layout.CLOSE_ICON_W}
          h={Layout.CLOSE_ICON_H}
          sprite={StoneplaqueArt.CLOSE}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, StoneplaqueArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, StoneplaqueArt.CLOSE)}
        />
      </layer>
    </>
  );
}
