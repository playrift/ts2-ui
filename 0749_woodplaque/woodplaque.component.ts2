import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  LINE_Y,
  WoodplaqueArt,
  WoodplaqueColor,
  WoodplaqueFont,
  WoodplaqueModel,
} from './woodplaque.constants';

export function Woodplaque(): Component {
  return (
    <>
      <model
        x={{ center: Layout.BACKGROUND_X_OFFSET }}
        y={{ center: Layout.BACKGROUND_Y_OFFSET }}
        w={Layout.BACKGROUND_W}
        h={Layout.BACKGROUND_H}
        model={WoodplaqueModel.BACKGROUND}
        zoom={Camera.ZOOM}
        offsetX={Camera.OFFSET_X}
        orthogonal
      />

      <layer x={{ center: Layout.CONTENT_X_OFFSET }} y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        {LINE_Y.map((y) => (
          <text
            x="center"
            y={y}
            w={{ fill: Layout.LINE_INSET }}
            h={Layout.LINE_H}
            font={WoodplaqueFont.LINE}
            color={WoodplaqueColor.INK}
            align="center"
            shadow
          />
        ))}
      </layer>

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={WoodplaqueArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, WoodplaqueArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, WoodplaqueArt.CLOSE)}
      />
    </>
  );
}
