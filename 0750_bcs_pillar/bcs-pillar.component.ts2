import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { ConfirmButton, RotateButton } from './pillar-button.component';
import { PillarEmblem } from './pillar-emblem.component';
import { Layout, PillarArt, PillarColor, PillarFonts, PillarLabels, PillarModels } from './bcs-pillar.constants';

export function BcsPillar(): Component {
  return (
    <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: Layout.PLATE_INSET }} h={{ fill: Layout.PLATE_INSET }}>
        <model
          x={{ center: Layout.PLINTH_X }}
          y={{ center: Layout.PLINTH_Y }}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={PillarModels.PLINTH}
          zoom={PillarModels.PLINTH_ZOOM}
          offsetY={PillarModels.PLINTH_OFFSET_Y}
        />

        <PillarEmblem />

        <text
          x={{ center: Layout.CAPTION_X }}
          y={{ center: Layout.CAPTION_Y }}
          w={{ fill: Layout.CAPTION_INSET }}
          h={Layout.CAPTION_H}
          text={PillarLabels.CAPTION}
          font={PillarFonts.CAPTION}
          color={PillarColor.CAPTION}
          align="center"
          valign="middle"
          shadow
        />

        <RotateButton
          x={Layout.ARROW_INSET}
          y="center"
          w={Layout.ARROW_W}
          h={Layout.ARROW_H}
          sprite={PillarArt.ROTATE_CLOCKWISE}
          label={PillarLabels.CLOCKWISE}
          delta={1}
        />

        <RotateButton
          x={{ right: Layout.ARROW_INSET }}
          y="center"
          w={Layout.ARROW_W}
          h={Layout.ARROW_H}
          sprite={PillarArt.ROTATE_ANTICLOCKWISE}
          label={PillarLabels.ANTICLOCKWISE}
          delta={-1}
        />

        <ConfirmButton x="center" y={{ bottom: Layout.CONFIRM_INSET }} w={Layout.CONFIRM_W} h={Layout.CONFIRM_H} />
      </layer>

      <CloseButton />
    </layer>
  );
}
