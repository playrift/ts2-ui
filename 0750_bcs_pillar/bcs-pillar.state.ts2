import { predictServerState, useServerState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { PillarRotation, PillarSounds, PillarVarbits } from './bcs-pillar.constants';

export function rotateEmblem(delta: Int): void {
  playSound(PillarSounds.ROTATE);

  const next: Int = useServerState(PillarVarbits.ROTATION) + delta;
  if (next >= PillarRotation.STEPS) {
    predictServerState(PillarVarbits.ROTATION, 0);
  } else if (next < 0) {
    predictServerState(PillarVarbits.ROTATION, PillarRotation.MAX);
  } else {
    predictServerState(PillarVarbits.ROTATION, next);
  }
}
