import { useServerState } from 'ts2';

import { minmax } from '../0811_lockpicking/lockpicking.state';
import { Layout, PillarModels, PillarRotation, PillarVarbits } from './bcs-pillar.constants';

export function PillarEmblem(): Component {
  const notch: Int = minmax(0, PillarRotation.MAX, useServerState(PillarVarbits.ROTATION));
  const yaw: Int = notch * PillarRotation.YAW_STEP + PillarRotation.YAW_BIAS;

  return (
    <model
      x="center"
      y="center"
      w={Layout.MODEL_BOX}
      h={Layout.MODEL_BOX}
      model={PillarModels.EMBLEM}
      zoom={PillarModels.EMBLEM_ZOOM}
      pitch={PillarModels.EMBLEM_PITCH}
      yaw={yaw}
      orthogonal
    />
  );
}
