import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { BurnerArrows } from './burner-arrows.component';
import { BurnerAverageGauge, BurnerFlameModel, BurnerGauge } from './burner-gauge.component';
import { BurnerColor, BurnerColumn, BurnerModels, BurnerOpacity, Layout } from './bcs-burner.constants';

export function BcsBurner(): Component {
  return (
    <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: Layout.PLATE_INSET }} h={{ fill: Layout.PLATE_INSET }}>
        <model
          x={{ right: Layout.BRAZIER_X }}
          y={{ center: Layout.BRAZIER_Y }}
          w={Layout.MODEL_BOX}
          h={Layout.MODEL_BOX}
          model={BurnerModels.BRAZIER}
          zoom={BurnerModels.BRAZIER_ZOOM}
          pitch={BurnerModels.BRAZIER_PITCH}
        />

        <BurnerFlameModel />

        <layer x={Layout.COLUMNS_X} y="center" w={Layout.COLUMNS_BOX} h={Layout.COLUMNS_BOX}>
          <layer x={{ center: Layout.COLUMN_WEST }} y="center" w={Layout.GAUGE_W} h={Layout.GAUGE_H}>
            <BurnerGauge column={BurnerColumn.WEST} />
          </layer>
          <layer x={{ center: Layout.COLUMN_MIDDLE }} y="center" w={Layout.GAUGE_W} h={Layout.GAUGE_H}>
            <BurnerGauge column={BurnerColumn.CENTRE} />
          </layer>
          <layer x={{ center: Layout.COLUMN_EAST }} y="center" w={Layout.GAUGE_W} h={Layout.GAUGE_H}>
            <BurnerGauge column={BurnerColumn.EAST} />
          </layer>

          <model
            x={{ center: Layout.COLUMN_MIDDLE }}
            y={{ center: Layout.BURNER_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={BurnerModels.BURNER}
            zoom={BurnerModels.BURNER_ZOOM}
            orthogonal
          />
          <model
            x={{ center: Layout.COLUMN_WEST }}
            y={{ center: Layout.BURNER_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={BurnerModels.BURNER}
            zoom={BurnerModels.BURNER_ZOOM}
            orthogonal
          />
          <model
            x={{ center: Layout.COLUMN_EAST }}
            y={{ center: Layout.BURNER_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={BurnerModels.BURNER}
            zoom={BurnerModels.BURNER_ZOOM}
            orthogonal
          />

          <BurnerArrows />
        </layer>

        <layer x={{ right: Layout.AVERAGE_X }} y="center" w={Layout.AVERAGE_W} h={Layout.AVERAGE_H}>
          <layer x="center" y="center" w={Layout.GAUGE_W} h={Layout.GAUGE_H}>
            <BurnerAverageGauge />
          </layer>

          <rect
            x="center"
            y={{ center: Layout.TARGET_Y }}
            w={Layout.TARGET_W}
            h={Layout.TARGET_H}
            color={BurnerColor.TARGET}
            transparency={BurnerOpacity.TARGET}
            fill
          />

          <model
            x="center"
            y={{ center: Layout.BURNER_Y }}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={BurnerModels.BURNER}
            zoom={BurnerModels.BURNER_ZOOM}
            orthogonal
          />
        </layer>
      </layer>

      <CloseButton />
    </layer>
  );
}
