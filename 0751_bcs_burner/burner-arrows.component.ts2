import { useRef } from 'ts2';

import { graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { BurnerArt, BurnerColumn, BurnerLabels, BurnerPush, BurnerRange, Layout } from './bcs-burner.constants';
import { adjustBurners } from './bcs-burner.state';

export function BurnerArrows(): Component {
  const westUp = useRef();
  const centreUp = useRef();
  const eastUp = useRef();
  const westDown = useRef();
  const centreDown = useRef();
  const eastDown = useRef();

  return (
    <>
      <sprite
        ref={westUp}
        x={{ center: Layout.COLUMN_WEST }}
        y={{ center: Layout.ARROW_UP_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.UP}
      />
      <sprite
        ref={centreUp}
        x={{ center: Layout.COLUMN_MIDDLE }}
        y={{ center: Layout.ARROW_UP_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.UP}
      />
      <sprite
        ref={eastUp}
        x={{ center: Layout.COLUMN_EAST }}
        y={{ center: Layout.ARROW_UP_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.UP}
      />

      <sprite
        ref={westDown}
        x={{ center: Layout.COLUMN_WEST }}
        y={{ center: Layout.ARROW_DOWN_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.DOWN}
      />
      <sprite
        ref={centreDown}
        x={{ center: Layout.COLUMN_MIDDLE }}
        y={{ center: Layout.ARROW_DOWN_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.DOWN}
      />
      <sprite
        ref={eastDown}
        x={{ center: Layout.COLUMN_EAST }}
        y={{ center: Layout.ARROW_DOWN_Y }}
        w={Layout.ARROW_SIZE}
        h={Layout.ARROW_SIZE}
        sprite={BurnerArt.DOWN}
      />

      <layer
        x={{ center: Layout.COLUMN_WEST }}
        y={{ center: Layout.HIT_UP_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.INCREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(westUp, BurnerArt.UP_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(westUp, BurnerArt.UP)}
        onOptionSelect={() =>
          adjustBurners(BurnerRange.STEP, BurnerRange.STEP_DOWN, 0, BurnerColumn.WEST, BurnerPush.UP)
        }
      />

      <layer
        x={{ center: Layout.COLUMN_WEST }}
        y={{ center: Layout.HIT_DOWN_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.DECREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(westDown, BurnerArt.DOWN_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(westDown, BurnerArt.DOWN)}
        onOptionSelect={() =>
          adjustBurners(BurnerRange.STEP_DOWN, BurnerRange.STEP, 0, BurnerColumn.WEST, BurnerPush.DOWN)
        }
      />

      <layer
        x={{ center: Layout.COLUMN_MIDDLE }}
        y={{ center: Layout.HIT_UP_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.INCREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(centreUp, BurnerArt.UP_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(centreUp, BurnerArt.UP)}
        onOptionSelect={() =>
          adjustBurners(
            BurnerRange.STEP_DOWN,
            BurnerRange.STEP,
            BurnerRange.STEP_DOWN,
            BurnerColumn.CENTRE,
            BurnerPush.UP,
          )
        }
      />

      <layer
        x={{ center: Layout.COLUMN_MIDDLE }}
        y={{ center: Layout.HIT_DOWN_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.DECREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(centreDown, BurnerArt.DOWN_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(centreDown, BurnerArt.DOWN)}
        onOptionSelect={() =>
          adjustBurners(BurnerRange.STEP, BurnerRange.STEP_DOWN, BurnerRange.STEP, BurnerColumn.CENTRE, BurnerPush.DOWN)
        }
      />

      <layer
        x={{ center: Layout.COLUMN_EAST }}
        y={{ center: Layout.HIT_UP_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.INCREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(eastUp, BurnerArt.UP_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(eastUp, BurnerArt.UP)}
        onOptionSelect={() =>
          adjustBurners(BurnerRange.STEP_DOWN, 0, BurnerRange.STEP, BurnerColumn.EAST, BurnerPush.UP)
        }
      />

      <layer
        x={{ center: Layout.COLUMN_EAST }}
        y={{ center: Layout.HIT_DOWN_Y }}
        w={Layout.HIT_W}
        h={Layout.HIT_H}
        options={[BurnerLabels.DECREASE]}
        onMouseRepeat={() => graphicSwapperUnlessMobile(eastDown, BurnerArt.DOWN_HOVER)}
        onMouseLeave={() => graphicSwapperUnlessMobile(eastDown, BurnerArt.DOWN)}
        onOptionSelect={() =>
          adjustBurners(BurnerRange.STEP, 0, BurnerRange.STEP_DOWN, BurnerColumn.EAST, BurnerPush.DOWN)
        }
      />
    </>
  );
}
