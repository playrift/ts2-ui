import { CS2 } from 'ts2';

import { BurnerAnims, BurnerColor, BurnerFlame, BurnerOpacity, BurnerRange, Layout } from './bcs-burner.constants';
import { burnerAverage, burnerValue, gaugeHeight } from './bcs-burner.state';

export function BurnerGauge({ column }: { column: Int }): Component {
  const level: Int = burnerValue(column);
  const height: Int = gaugeHeight(level);

  return (
    <rect x="center" y="bottom" w="fill" h={height} color={BurnerColor.GAUGE} transparency={BurnerOpacity.GAUGE} fill />
  );
}

export function BurnerAverageGauge(): Component {
  const average: Int = burnerAverage();
  const height: Int = gaugeHeight(average);

  return (
    <rect x="center" y="bottom" w="fill" h={height} color={BurnerColor.GAUGE} transparency={BurnerOpacity.GAUGE} fill />
  );
}

export function BurnerFlameModel(): Component {
  const average: Int = burnerAverage();
  const zoom: Int = CS2.interpolate(BurnerFlame.ZOOM_MIN, BurnerFlame.ZOOM_MAX, 0, BurnerRange.MAX, average);
  const hidden: Boolean = average <= 0 ? true : false;

  return (
    <model
      x={{ right: Layout.FLAME_X }}
      y={{ center: Layout.FLAME_Y }}
      w={Layout.MODEL_BOX}
      h={Layout.MODEL_BOX}
      model={BurnerFlame.MODEL}
      anim={BurnerAnims.FLAME}
      offsetX={BurnerFlame.OFFSET_X}
      zoom={zoom}
      hide={hidden}
    />
  );
}
