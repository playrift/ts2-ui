import { createRef, useInterval } from 'ts2';
import { Fade, OverlayColor } from './bcs-akh-combat.constants';
import { fadeTintBox } from './bcs-akh-combat.helpers';

const timerHost = createRef('0752_bcs_akh_combat_timer_host');

export const tintBoxRef = createRef('bcs_akh_combat_tint_box');

export function BcsAkhCombat(): Component {
  useInterval(() => fadeTintBox(tintBoxRef), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill" ref={timerHost}>
      <rect ref={tintBoxRef} w="fill" h="fill" color={OverlayColor.TINT} fill={true} transparency={Fade.REST} />
    </layer>
  );
}
