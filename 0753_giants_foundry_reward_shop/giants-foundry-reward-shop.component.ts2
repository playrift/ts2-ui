import { useInterval, useServerState, useState, useWatch } from 'ts2';

import { DropdownButton } from '../0891_hotkey_settings_new/dropdown-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorder } from '../lib/steel-border.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import {
  Copy,
  Layout,
  ScrollbarArt,
  ShopBorder,
  ShopColor,
  ShopFont,
  ShopVars,
} from './giants-foundry-reward-shop.constants';
import {
  buyButtonLabel,
  rewardCost,
  rewardMould,
  rewardShopBreakpoint,
  rewardShopLayout,
  rewardShopPoints,
} from './giants-foundry-reward-shop.helpers';
import { RewardGrid } from './reward-grid.component';
import { RewardInfo } from './reward-info.component';
import {
  buyButton,
  content,
  filterLayer,
  infinity,
  info,
  infoLayer,
  list,
  listLayer,
  pointsLayer,
  universe,
} from './giants-foundry-reward-shop.refs';
import { ShopFilter, ShopFilters } from './reward-shop.data';

export function GiantsFoundryRewardShop(): Component {
  useInterval(() => rewardShopBreakpoint(infinity), infinity);
  useWatch(
    ShopVars.POINTS,
    () => rewardShopLayout(universe, content, listLayer, infoLayer, pointsLayer, buyButton, filterLayer),
    infinity,
  );

  return (
    <layer ref={infinity} w="fill" h="fill">
      <layer ref={universe} x="center" y="center" w={Layout.ROOT_W} h={Layout.ROOT_H}>
        <SteelBorder x="center" y="center" title={Copy.TITLE} titleColor={ShopColor.ACCENT} flags={ShopBorder.FLAGS} />

        <layer
          ref={content}
          x={Layout.CONTENT_X}
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_INSET_W }}
          h={{ fill: Layout.CONTENT_INSET_H }}
        >
          <layer ref={filterLayer} x={Layout.FILTER_X} y={Layout.FILTER_Y} w={Layout.FILTER_W} h={Layout.FILTER_H}>
            <ShopFilterDropdown />
          </layer>

          <layer
            ref={listLayer}
            x={Layout.LIST_X}
            y={{ bottom: Layout.LIST_BOTTOM }}
            w={{ fill: Layout.LIST_INSET_W }}
            h={{ fill: Layout.LIST_INSET_H }}
          >
            <rect x="center" y="center" w="fill" h="fill" fill color={ShopColor.WASH} transparency={200} />
            <layer x={0} y={0} w={{ fill: Layout.PANE_INSET_W }} h="fill">
              <ThinBoxEntrypoint />
            </layer>
            <layer
              ref={list}
              x={Layout.PANE_CONTENT_X}
              y={Layout.PANE_CONTENT_Y}
              w={{ fill: Layout.PANE_CONTENT_INSET_W }}
              h={{ fill: Layout.PANE_CONTENT_INSET_H }}
              dragTarget
            >
              <RewardGrid />
            </layer>
            <layer x="right" y={0} w={Layout.SCROLLER_W} h="fill">
              <ScrollbarVertical
                content={list}
                track={ScrollbarArt.TRACK}
                capTopSprite={ScrollbarArt.THUMB_TOP}
                thumbSprite={ScrollbarArt.THUMB_MID}
                capBottomSprite={ScrollbarArt.THUMB_BOTTOM}
                arrowUp={ScrollbarArt.ARROW_UP}
                arrowDown={ScrollbarArt.ARROW_DOWN}
                rebuilt
              />
            </layer>
          </layer>

          <layer
            ref={infoLayer}
            x={{ right: Layout.RIGHT_COLUMN_X }}
            y={Layout.INFO_Y}
            w={Layout.INFO_W}
            h={{ fill: Layout.INFO_INSET_H }}
          >
            <rect x="center" y="center" w="fill" h="fill" fill color={ShopColor.WASH} transparency={200} />
            <layer x={0} y={0} w={{ fill: Layout.PANE_INSET_W }} h="fill">
              <ThinBoxEntrypoint />
            </layer>
            <layer
              ref={info}
              x={Layout.PANE_CONTENT_X}
              y={Layout.PANE_CONTENT_Y}
              w={{ fill: Layout.PANE_CONTENT_INSET_W }}
              h={{ fill: Layout.PANE_CONTENT_INSET_H }}
            >
              <RewardInfo />
            </layer>
            <layer x="right" y={0} w={Layout.SCROLLER_W} h="fill">
              <ScrollbarVertical
                content={info}
                track={ScrollbarArt.TRACK}
                capTopSprite={ScrollbarArt.THUMB_TOP}
                thumbSprite={ScrollbarArt.THUMB_MID}
                capBottomSprite={ScrollbarArt.THUMB_BOTTOM}
                arrowUp={ScrollbarArt.ARROW_UP}
                arrowDown={ScrollbarArt.ARROW_DOWN}
                rebuilt
              />
            </layer>
          </layer>

          <layer
            ref={pointsLayer}
            x={{ right: Layout.RIGHT_COLUMN_X }}
            y={{ bottom: Layout.POINTS_BOTTOM }}
            w={Layout.PANEL_W}
            h={Layout.PANEL_H}
          >
            <rect x="center" y="center" w="fill" h="fill" fill color={ShopColor.WASH} />
            <layer x={0} y={0} w="fill" h="fill">
              <ThinBoxEntrypoint />
            </layer>
            <text
              x="center"
              y={Layout.POINTS_TITLE_Y}
              w={{ fill: Layout.POINTS_TEXT_INSET_W }}
              h={Layout.POINTS_TEXT_H}
              font={ShopFont.BOLD}
              text="Foundry Reputation"
              align="center"
              valign="middle"
              shadow
              color={ShopColor.ACCENT}
            />
            <RewardPoints />
          </layer>

          <layer
            ref={buyButton}
            x={{ right: Layout.RIGHT_COLUMN_X }}
            y={{ bottom: Layout.BUY_BOTTOM }}
            w={Layout.PANEL_W}
            h={Layout.PANEL_H}
            options={['Buy']}
          >
            <BuyButtonFace />
          </layer>
        </layer>
      </layer>

      <layer w="fill" h="fill" hide>
        <layer x={Layout.DROPDOWN_X} y={Layout.DROPDOWN_Y} w={Layout.DROPDOWN_W} h={Layout.DROPDOWN_H} noClickThrough>
          <layer x={0} y={0} w={{ fill: Layout.PANE_INSET_W }} h="fill" />
          <layer x="right" y={0} w={Layout.SCROLLER_W} h={Layout.DROPDOWN_H} />
        </layer>
      </layer>
    </layer>
  );
}

function ShopFilterDropdown(): Component {
  const filter: Int = useServerState(ShopVars.FILTER);
  return (
    <DropdownButton
      label={ShopFilters.at(filter as ShopFilter) ?? 'Show all'}
      entryCount={6}
      color={ShopColor.ACCENT}
    />
  );
}

function RewardPoints(): Component {
  return (
    <text
      x="center"
      y={{ bottom: Layout.POINTS_VALUE_BOTTOM }}
      w={{ fill: Layout.POINTS_TEXT_INSET_W }}
      h={Layout.POINTS_TEXT_H}
      font={ShopFont.READOUT}
      text={rewardShopPoints()}
      align="center"
      valign="middle"
      shadow
      color={ShopColor.ACCENT}
    />
  );
}

function BuyButtonFace(): Component {
  const selected: Int = useServerState(ShopVars.SELECTED);
  const points: Int = useServerState(ShopVars.POINTS);
  const cost: Int = rewardCost(selected);
  const mould: Int = rewardMould(selected);
  const mobile: Boolean = onMobile();

  let affordable: Boolean = false;
  if (cost > 0) {
    if (cost <= points) {
      affordable = true;
    }
  }

  const [hovered, setHovered] = useState(0);

  return (
    <>
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onMouseEnter={affordable && !mobile ? () => setHovered(1) : undefined}
        onMouseLeave={affordable && !mobile ? () => setHovered(0) : undefined}
      >
        {affordable && hovered === 0 ? <StoneButton /> : <StoneButtonPressedFilled />}
      </layer>

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={ShopFont.BOLD}
        text={buyButtonLabel(mould)}
        align="center"
        valign="middle"
        shadow
        color={affordable ? ShopColor.ACCENT : ShopColor.DISABLED}
      />
    </>
  );
}
