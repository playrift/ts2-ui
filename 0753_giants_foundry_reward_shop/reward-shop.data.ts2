export const ShopFilters = listOf<String>([
  'Show all',
  'Show all items',
  'Show all moulds',
  'Show forte moulds',
  'Show blade moulds',
  'Show tip moulds',
]);

export enum ShopFilter {
  ALL = 0,
  ITEMS = 1,
  MOULDS = 2,
  FORTE = 3,
  BLADE = 4,
  TIP = 5,
}

export function rewardRowCategory(mould: Int): Int {
  if (mould < 0) {
    return -1;
  }
  const row: MouldRow | null = Moulds.at(mould);
  return row === null ? -1 : row.category;
}

export function categoryFilter(category: Int): Int {
  if (category === MouldCategory.RICASSO) {
    return ShopFilter.FORTE;
  }
  if (category === MouldCategory.BLADE) {
    return ShopFilter.BLADE;
  }
  if (category === MouldCategory.TIP) {
    return ShopFilter.TIP;
  }
  return -1;
}
