import { createRef, useInterval } from 'ts2';

import { CompletionSections } from './completion-sections.component';
import {
  BACKDROP_WASH,
  COVER_WASH,
  FoundryColor,
  FoundrySprites,
  GrindPlate,
  HammerPlate,
  Layout,
  PolishPlate,
  TrackPlate,
} from './giants-foundry-hud.constants';
import { foundryLayout, foundryPointers, foundrySweetSpots } from './giants-foundry-hud.helpers';
import {
  completionBar,
  completionCover,
  completionHighlight,
  completionIcon,
  completionLayer,
  completionPointer,
  grindBar,
  grindHighlight,
  hammerBar,
  hammerHighlight,
  infinity,
  polishBar,
  polishHighlight,
  qualityBar,
  qualityFill,
  qualityFillBg,
  qualityIcon,
  qualityLayer,
  qualityLost,
  qualityPointer,
  temperatureBar,
  temperatureIcon,
  temperatureLayer,
  temperaturePointer,
  universe,
} from './giants-foundry-hud.refs';

const timerHost1 = createRef('0754_giants_foundry_hud_timer_host1');

function TrackFrame(): Component {
  return (
    <>
      <sprite
        x={Layout.PLATE_INSET}
        y={Layout.PLATE_INSET}
        w={Layout.PLATE_CORNER}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.TL}
      />
      <sprite
        x="center"
        y={Layout.PLATE_INSET}
        w={{ fill: Layout.PLATE_EDGE_INSET }}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.TOP}
      />
      <sprite
        x={{ right: Layout.PLATE_INSET }}
        y={Layout.PLATE_INSET}
        w={Layout.PLATE_CORNER}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.TR}
      />
      <sprite
        x={Layout.PLATE_INSET}
        y="center"
        w={Layout.PLATE_CORNER}
        h={{ fill: Layout.PLATE_EDGE_INSET }}
        sprite={TrackPlate.LEFT}
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: Layout.PLATE_EDGE_INSET }}
        h={{ fill: Layout.PLATE_EDGE_INSET }}
        sprite={TrackPlate.FILL}
      />
      <sprite
        x={{ right: Layout.PLATE_INSET }}
        y="center"
        w={Layout.PLATE_CORNER}
        h={{ fill: Layout.PLATE_EDGE_INSET }}
        sprite={TrackPlate.RIGHT}
      />
      <sprite
        x={Layout.PLATE_INSET}
        y={{ bottom: Layout.PLATE_INSET }}
        w={Layout.PLATE_CORNER}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.BL}
      />
      <sprite
        x="center"
        y={{ bottom: Layout.PLATE_INSET }}
        w={{ fill: Layout.PLATE_EDGE_INSET }}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.BOTTOM}
      />
      <sprite
        x={{ right: Layout.PLATE_INSET }}
        y={{ bottom: Layout.PLATE_INSET }}
        w={Layout.PLATE_CORNER}
        h={Layout.PLATE_CORNER}
        sprite={TrackPlate.BR}
      />
    </>
  );
}

function SpotFrame({
  tl,
  top,
  tr,
  left,
  fill,
  right,
  bl,
  bottom,
  br,
}: {
  tl: Sprite;
  top: Sprite;
  tr: Sprite;
  left: Sprite;
  fill: Sprite;
  right: Sprite;
  bl: Sprite;
  bottom: Sprite;
  br: Sprite;
}): Component {
  return (
    <>
      <sprite x="center" y={0} w={{ fill: Layout.SPOT_EDGE_INSET }} h={Layout.SPOT_CORNER} sprite={top} tiling />
      <sprite x={0} y="center" w={Layout.SPOT_CORNER} h={{ fill: Layout.SPOT_EDGE_INSET }} sprite={left} tiling />
      <sprite x="right" y="center" w={Layout.SPOT_CORNER} h={{ fill: Layout.SPOT_EDGE_INSET }} sprite={right} tiling />
      <sprite
        x="center"
        y="bottom"
        w={{ fill: Layout.SPOT_EDGE_INSET }}
        h={Layout.SPOT_CORNER}
        sprite={bottom}
        tiling
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: Layout.SPOT_EDGE_INSET }}
        h={{ fill: Layout.SPOT_EDGE_INSET }}
        sprite={fill}
        tiling
      />
      <sprite x={0} y={0} w={Layout.SPOT_CORNER} h={Layout.SPOT_CORNER} sprite={tl} tiling />
      <sprite x="right" y={0} w={Layout.SPOT_CORNER} h={Layout.SPOT_CORNER} sprite={tr} tiling />
      <sprite x={0} y="bottom" w={Layout.SPOT_CORNER} h={Layout.SPOT_CORNER} sprite={bl} tiling />
      <sprite x="right" y="bottom" w={Layout.SPOT_CORNER} h={Layout.SPOT_CORNER} sprite={br} tiling />
    </>
  );
}

export function GiantsFoundryHud(): Component {
  useInterval(
    () =>
      foundryLayout(
        timerHost1,
        infinity,
        universe,
        qualityIcon,
        temperatureIcon,
        completionIcon,
        qualityLayer,
        temperatureLayer,
        completionLayer,
        qualityBar,
        qualityFillBg,
      ),
    timerHost1,
  );
  useInterval(
    () =>
      foundryPointers(
        qualityBar,
        qualityPointer,
        qualityFill,
        qualityLost,
        temperaturePointer,
        completionPointer,
        completionHighlight,
        completionCover,
        hammerHighlight,
        grindHighlight,
        polishHighlight,
      ),
    universe,
  );
  useInterval(() => foundrySweetSpots(temperatureBar, polishBar, grindBar, hammerBar), temperatureBar);

  return (
    <layer ref={infinity} w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={universe} x="center" y={Layout.STRIP_Y} w={Layout.STRIP_W} h={Layout.STRIP_H}>
          <layer w="fill" h="fill">
            <rect w="fill" h="fill" fill color={FoundryColor.BACKDROP} transparency={BACKDROP_WASH} />

            <sprite
              ref={qualityIcon}
              x={Layout.ICON_X}
              y={Layout.ICON_QUALITY_Y}
              w={Layout.POINTER}
              h={Layout.POINTER}
              sprite={FoundrySprites.ICON_QUALITY}
            />
            <sprite
              ref={temperatureIcon}
              x={Layout.ICON_X}
              y={Layout.ICON_TEMPERATURE_Y}
              w={Layout.POINTER}
              h={Layout.POINTER}
              sprite={FoundrySprites.ICON_TEMPERATURE}
            />
            <sprite
              ref={completionIcon}
              x={Layout.ICON_X}
              y={Layout.ICON_COMPLETION_Y}
              w={Layout.POINTER}
              h={Layout.POINTER}
              sprite={FoundrySprites.ICON_COMPLETION}
            />

            <layer w="fill" h="fill" />

            <layer
              ref={qualityLayer}
              x="right"
              y={Layout.ROW_QUALITY_Y}
              w={{ fill: Layout.ROW_INSET_W }}
              h={Layout.ROW_H}
            >
              <layer ref={qualityBar} x="center" w={{ fill: Layout.TRACK_INSET_W }} h="fill">
                <rect x="center" w="fill" h="fill" color={FoundryColor.OUTLINE} />
                <TrackFrame />
                <rect
                  ref={qualityLost}
                  x={Layout.BAR_INSET}
                  y={Layout.BAR_INSET}
                  w={Layout.QUALITY_LOST_W}
                  h={{ fill: Layout.BAR_INSET_H }}
                  fill
                  color={FoundryColor.QUALITY_LOST}
                  transparency={BACKDROP_WASH}
                />
                <layer
                  ref={qualityFill}
                  x={Layout.BAR_INSET}
                  y={Layout.BAR_INSET}
                  w={Layout.QUALITY_FILL_W}
                  h={{ fill: Layout.BAR_INSET_H }}
                >
                  <sprite ref={qualityFillBg} w={Layout.GRADIENT_W} h="fill" sprite={FoundrySprites.QUALITY_GRADIENT} />
                </layer>
              </layer>

              <sprite
                ref={qualityPointer}
                y={{ bottom: Layout.POINTER_Y }}
                w={Layout.POINTER}
                h={Layout.POINTER}
                sprite={FoundrySprites.POINTER}
              />
            </layer>

            <layer
              ref={temperatureLayer}
              x="right"
              y={Layout.ROW_TEMPERATURE_Y}
              w={{ fill: Layout.ROW_INSET_W }}
              h={Layout.ROW_H}
            >
              <layer ref={temperatureBar} x="center" w={{ fill: Layout.TRACK_INSET_W }} h="fill">
                <rect x="center" w="fill" h="fill" fill color={FoundryColor.TRACK} />
                <rect x="center" w="fill" h="fill" color={FoundryColor.OUTLINE} />
                <TrackFrame />

                <layer
                  ref={polishBar}
                  x={Layout.SPOT_POLISH_X}
                  y="center"
                  w={Layout.SPOT_W}
                  h={{ fill: Layout.BAR_INSET_H }}
                >
                  <SpotFrame
                    tl={PolishPlate.TL}
                    top={PolishPlate.TOP}
                    tr={PolishPlate.TR}
                    left={PolishPlate.LEFT}
                    fill={PolishPlate.FILL}
                    right={PolishPlate.RIGHT}
                    bl={PolishPlate.BL}
                    bottom={PolishPlate.BOTTOM}
                    br={PolishPlate.BR}
                  />
                  <layer ref={polishHighlight} w="fill" h="fill" hide>
                    <rect y="bottom" w="fill" h="fill" color={FoundryColor.HIGHLIGHT} />
                  </layer>
                </layer>

                <layer
                  ref={grindBar}
                  x={Layout.SPOT_GRIND_X}
                  y="center"
                  w={Layout.SPOT_W}
                  h={{ fill: Layout.BAR_INSET_H }}
                >
                  <SpotFrame
                    tl={GrindPlate.TL}
                    top={GrindPlate.TOP}
                    tr={GrindPlate.TR}
                    left={GrindPlate.LEFT}
                    fill={GrindPlate.FILL}
                    right={GrindPlate.RIGHT}
                    bl={GrindPlate.BL}
                    bottom={GrindPlate.BOTTOM}
                    br={GrindPlate.BR}
                  />
                  <layer ref={grindHighlight} w="fill" h="fill" hide>
                    <rect y="bottom" w="fill" h="fill" color={FoundryColor.HIGHLIGHT} />
                  </layer>
                </layer>

                <layer
                  ref={hammerBar}
                  x={Layout.SPOT_HAMMER_X}
                  y="center"
                  w={Layout.SPOT_W}
                  h={{ fill: Layout.BAR_INSET_H }}
                >
                  <SpotFrame
                    tl={HammerPlate.TL}
                    top={HammerPlate.TOP}
                    tr={HammerPlate.TR}
                    left={HammerPlate.LEFT}
                    fill={HammerPlate.FILL}
                    right={HammerPlate.RIGHT}
                    bl={HammerPlate.BL}
                    bottom={HammerPlate.BOTTOM}
                    br={HammerPlate.BR}
                  />
                  <layer ref={hammerHighlight} w="fill" h="fill" hide>
                    <rect y="bottom" w="fill" h="fill" color={FoundryColor.HIGHLIGHT} />
                  </layer>
                </layer>
              </layer>

              <sprite
                ref={temperaturePointer}
                y={{ bottom: Layout.POINTER_Y }}
                w={Layout.POINTER}
                h={Layout.POINTER}
                sprite={FoundrySprites.POINTER}
              />
            </layer>

            <layer
              ref={completionLayer}
              x="right"
              y={Layout.ROW_COMPLETION_Y}
              w={{ fill: Layout.ROW_INSET_W }}
              h={Layout.ROW_TALL_H}
            >
              <layer ref={completionBar} x="center" w={{ fill: Layout.TRACK_INSET_W }} h="fill">
                <rect x="center" w="fill" h="fill" fill color={FoundryColor.TRACK} />
                <rect x="center" w="fill" h="fill" color={FoundryColor.OUTLINE} />
                <CompletionSections />
              </layer>

              <layer
                ref={completionHighlight}
                x={Layout.HIGHLIGHT_X}
                y={Layout.BAR_INSET}
                w={Layout.HIGHLIGHT_W}
                h={{ fill: Layout.BAR_INSET_H }}
              >
                <rect y="bottom" w="fill" h="fill" color={FoundryColor.HIGHLIGHT} />
              </layer>

              <rect
                ref={completionCover}
                x={{ center: Layout.BAR_INSET }}
                y={Layout.BAR_INSET}
                w={{ fill: Layout.TRACK_INSET_W }}
                h={{ fill: Layout.BAR_INSET_H }}
                fill
                color={FoundryColor.BACKDROP}
                transparency={COVER_WASH}
              />

              <sprite
                ref={completionPointer}
                y={{ bottom: Layout.POINTER_Y }}
                w={Layout.POINTER}
                h={Layout.POINTER}
                sprite={FoundrySprites.POINTER}
              />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
