import { scaled } from '../lib/lib.engine';
import {
  BreakpointGates,
  Breakpoints,
  DIFFICULTY_MAX,
  ICON,
  Layout,
  METER_MAX,
  ROW_GAP,
  SectionCounts,
  SectionGates,
} from './giants-foundry-hud.constants';

export function breakpointOf(width: Int, height: Int): Int {
  let level: Int = 0;
  if (width > BreakpointGates.W1 && height > BreakpointGates.H1) {
    level = 1;
  }
  if (width > BreakpointGates.W2 && height > BreakpointGates.H2) {
    level = 2;
  }
  if (width > BreakpointGates.W3 && height > BreakpointGates.H3) {
    level = 3;
  }
  return level;
}

export function rowHeight(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return Breakpoints.ONE.row;
  }
  if (breakpoint === 2) {
    return Breakpoints.TWO.row;
  }
  if (breakpoint === 3) {
    return Breakpoints.THREE.row;
  }
  return Breakpoints.BASE.row;
}

export function tallRowHeight(breakpoint: Int): Int {
  if (breakpoint === 3) {
    return Breakpoints.THREE.tallRow;
  }
  return Breakpoints.BASE.tallRow;
}

export function halfInset(breakpoint: Int): Int {
  if (breakpoint === 3) {
    return Breakpoints.THREE.halfInset;
  }
  return Breakpoints.BASE.halfInset;
}

export function stripWidth(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return Breakpoints.ONE.width;
  }
  if (breakpoint === 2) {
    return Breakpoints.TWO.width;
  }
  if (breakpoint === 3) {
    return Breakpoints.THREE.width;
  }
  return Breakpoints.BASE.width;
}

export function stripHeight(breakpoint: Int): Int {
  return rowHeight(breakpoint) * 2 + tallRowHeight(breakpoint) + ROW_GAP * 4;
}

export function iconY(above: Int, row: Int): Int {
  return above + (row - ICON) / 2;
}

export function trackWidth(breakpoint: Int): Int {
  return stripWidth(breakpoint) - halfInset(breakpoint) * 2 - Layout.TRACK_INSET_W;
}

export function sectionCount(difficulty: Int): Int {
  if (difficulty >= 0 && difficulty < SectionGates.G1) {
    return SectionCounts.BASE;
  }
  if (difficulty >= SectionGates.G1 && difficulty < SectionGates.G2) {
    return SectionCounts.ONE;
  }
  if (difficulty >= SectionGates.G2 && difficulty < SectionGates.G3) {
    return SectionCounts.TWO;
  }
  if (difficulty >= SectionGates.G3 && difficulty < SectionGates.G4) {
    return SectionCounts.THREE;
  }
  if (difficulty >= SectionGates.G4) {
    return SectionCounts.FOUR;
  }
  return SectionCounts.BASE;
}

export function spotWidth(difficulty: Int): Int {
  const third: Int = METER_MAX / 3;
  const half: Int = third - third / 2;
  return third - scaled(difficulty, DIFFICULTY_MAX, half);
}

export function spotStart(index: Int, difficulty: Int): Int {
  const third: Int = METER_MAX / 3;
  const width: Int = spotWidth(difficulty);
  if (index === 0) {
    return third / 2 + third * 2 - width / 2;
  }
  if (index === 1) {
    return third / 2 + third - width / 2;
  }
  return third / 2 - width / 2;
}

export function spotLit(temperature: Int, index: Int, difficulty: Int): Boolean {
  const start: Int = spotStart(index, difficulty);
  if (temperature >= start && temperature <= start + spotWidth(difficulty)) {
    return true;
  }
  return false;
}

export function pointerX(reading: Int, max: Int, span: Int): Int {
  return scaled(reading, max, span);
}

export function sectionRemainder(span: Int, count: Int): Int {
  return span % (span / count);
}

export function highlightX(cell: Int, reached: Int, remainder: Int): Int {
  return cell * reached + Layout.HIGHLIGHT_NUDGE + Math.min(remainder, reached);
}

export function sectionW(cell: Int, index: Int, remainder: Int): Int {
  if (index < remainder) {
    return cell + 1;
  }
  return cell;
}

export function sectionX(cell: Int, index: Int, remainder: Int): Int {
  return cell * index + Layout.SECTION_INSET + Math.min(remainder, index);
}
