import { useServerState, useState, useWatch } from 'ts2';

import { hasBit, membersWorld } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import {
  DuelBit,
  DuelLayout,
  DuelSprites,
  DuelVarbits,
  DuelVarps,
  WornIconAt,
  WornSlot,
} from './pvp-arena-legacyduel-options.constants';
import { DuelTip } from './pvp-arena-legacyduel-options.data';
import { DuelFlashSign, DuelPresetRow, DuelRuleRow } from './duel-rule-row.component';
import {
  flashFunWeapons,
  flashNoDrinks,
  flashNoFood,
  flashNoForfeit,
  flashNoMagic,
  flashNoMelee,
  flashNoMovement,
  flashNoPrayer,
  flashNoRanged,
  flashNoSpecial,
  flashNoSwitch,
  flashShowInv,
  flashWornAmmo,
  flashWornBody,
  flashWornCape,
  flashWornFeet,
  flashWornHands,
  flashWornHead,
  flashWornLegs,
  flashWornNeck,
  flashWornRing,
  flashWornShield,
  flashWornWeapon,
  hideDuelTooltip,
  hideTooltipIfUnbarred,
  showDuelTooltip,
} from './pvp-arena-legacyduel-options.state';

export function DuelRules(): Component {
  const options: Int = useServerState(DuelVarps.OPTIONS);
  const barred: Int = useServerState(DuelVarbits.WORN_OPTIONS);
  const mobile: Boolean = onMobile();
  const members: Boolean = membersWorld();

  const [sNoRanged] = useState(flashNoRanged);
  const [sNoMelee] = useState(flashNoMelee);
  const [sNoMagic] = useState(flashNoMagic);
  const [sNoSpecial] = useState(flashNoSpecial);
  const [sFunWeapons] = useState(flashFunWeapons);
  const [sNoForfeit] = useState(flashNoForfeit);
  const [sNoPrayer] = useState(flashNoPrayer);
  const [sNoDrinks] = useState(flashNoDrinks);
  const [sNoFood] = useState(flashNoFood);
  const [sNoMovement] = useState(flashNoMovement);
  const [sNoSwitch] = useState(flashNoSwitch);
  const [sShowInv] = useState(flashShowInv);
  const [sHead] = useState(flashWornHead);
  const [sCape] = useState(flashWornCape);
  const [sNeck] = useState(flashWornNeck);
  const [sAmmo] = useState(flashWornAmmo);
  const [sWeapon] = useState(flashWornWeapon);
  const [sBody] = useState(flashWornBody);
  const [sShield] = useState(flashWornShield);
  const [sLegs] = useState(flashWornLegs);
  const [sHands] = useState(flashWornHands);
  const [sFeet] = useState(flashWornFeet);
  const [sRing] = useState(flashWornRing);

  useWatch(DuelVarps.OPTIONS, () => hideTooltipIfUnbarred());

  let free: Boolean = false;
  let specialLabel: String = 'No Special Attacks';
  if (!members) {
    free = true;
    specialLabel = `<col=${DISABLED_HEX}>No Special Attacks</col>`;
  }

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x={0} y={0} w={DuelLayout.options.w} h={DuelLayout.options.h}>
        <DuelRuleRow
          x="center"
          y={0}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_RANGED}
          tip={DuelTip.NO_RANGED}
          name="No Ranged"
          label="No Ranged"
          radio={hasBit(options, DuelBit.NO_RANGED) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoRanged}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={22}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_MELEE}
          tip={DuelTip.NO_MELEE}
          name="No Melee"
          label="No Melee"
          radio={hasBit(options, DuelBit.NO_MELEE) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoMelee}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={44}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_MAGIC}
          tip={DuelTip.NO_MAGIC}
          name="No Magic"
          label="No Magic"
          radio={hasBit(options, DuelBit.NO_MAGIC) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoMagic}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={66}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_SPECIAL}
          tip={DuelTip.NO_SPECIAL}
          name="No Special Attacks"
          label={specialLabel}
          radio={hasBit(options, DuelBit.NO_SPECIAL) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoSpecial}
          mobile={mobile}
          disabled={free}
        />
        <DuelRuleRow
          x="center"
          y={88}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.FUN_WEAPONS}
          tip={DuelTip.FUN_WEAPONS}
          name="Fun Weapons"
          label="Fun Weapons"
          radio={hasBit(options, DuelBit.FUN_WEAPONS) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sFunWeapons}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={110}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_FORFEIT}
          tip={DuelTip.NO_FORFEIT}
          name="No Forfeit"
          label="No Forfeit"
          radio={hasBit(options, DuelBit.NO_FORFEIT) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoForfeit}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={132}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_PRAYER}
          tip={DuelTip.NO_PRAYER}
          name="No Prayer"
          label="No Prayer"
          radio={hasBit(options, DuelBit.NO_PRAYER) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoPrayer}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={154}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_DRINKS}
          tip={DuelTip.NO_DRINKS}
          name="No Drinks"
          label="No Drinks"
          radio={hasBit(options, DuelBit.NO_DRINKS) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoDrinks}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={176}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_FOOD}
          tip={DuelTip.NO_FOOD}
          name="No Food"
          label="No Food"
          radio={hasBit(options, DuelBit.NO_FOOD) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoFood}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={198}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_MOVEMENT}
          tip={DuelTip.NO_MOVEMENT}
          name="No Movement"
          label="No Movement"
          radio={hasBit(options, DuelBit.NO_MOVEMENT) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoMovement}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={220}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.NO_SWITCH}
          tip={DuelTip.NO_SWITCH}
          name="No Weapon Switch"
          label="No Weapon Switch"
          radio={hasBit(options, DuelBit.NO_SWITCH) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sNoSwitch}
          mobile={mobile}
          disabled={false}
        />
        <DuelRuleRow
          x="center"
          y={242}
          w="fill"
          h={DuelLayout.optionRow.h}
          bit={DuelBit.SHOW_INVENTORIES}
          tip={DuelTip.SHOW_INVENTORIES}
          name="Show Inventories"
          label="Show Inventories"
          radio={hasBit(options, DuelBit.SHOW_INVENTORIES) ? DuelSprites.RADIO_ON : DuelSprites.RADIO_OFF}
          since={sShowInv}
          mobile={mobile}
          disabled={false}
        />
      </layer>

      <layer right={DuelLayout.worn.right} y={0} w={DuelLayout.worn.w} h={DuelLayout.worn.h}>
        <sprite
          x="center"
          y={6}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.HEAD) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_HEAD)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: -41 }}
          y={45}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.CAPE) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_CAPE)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x="center"
          y={45}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.NECK) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_NECK)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: -42 }}
          y={84}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.WEAPON) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_WEAPON)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x="center"
          y={84}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.BODY) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_BODY)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: 41 }}
          y={84}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.SHIELD) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_SHIELD)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x="center"
          y={124}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.LEGS) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_LEGS)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: -42 }}
          y={164}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.HANDS) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_HANDS)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x="center"
          y={164}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.FEET) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_FEET)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: 41 }}
          y={164}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.RING) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_RING)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <sprite
          x={{ center: 41 }}
          y={45}
          w={32}
          h={32}
          sprite={DuelSprites.STOP}
          hide={hasBit(barred, WornSlot.AMMO) ? false : true}
          onMouseRepeat={() => showDuelTooltip(DuelTip.WORN_AMMO)}
          onMouseLeave={() => hideDuelTooltip()}
        />

        <DuelFlashSign x={WornIconAt.head.x + 10} y={WornIconAt.head.y} w={10} h={32} since={sHead} />
        <DuelFlashSign x={WornIconAt.cape.x + 10} y={WornIconAt.cape.y} w={10} h={32} since={sCape} />
        <DuelFlashSign x={WornIconAt.neck.x + 10} y={WornIconAt.neck.y} w={10} h={32} since={sNeck} />
        <DuelFlashSign x={WornIconAt.ammo.x + 10} y={WornIconAt.ammo.y} w={10} h={32} since={sAmmo} />
        <DuelFlashSign x={WornIconAt.weapon.x + 10} y={WornIconAt.weapon.y} w={10} h={32} since={sWeapon} />
        <DuelFlashSign x={WornIconAt.body.x + 10} y={WornIconAt.body.y} w={10} h={32} since={sBody} />
        <DuelFlashSign x={WornIconAt.shield.x + 10} y={WornIconAt.shield.y} w={10} h={32} since={sShield} />
        <DuelFlashSign x={WornIconAt.legs.x + 10} y={WornIconAt.legs.y} w={10} h={32} since={sLegs} />
        <DuelFlashSign x={WornIconAt.hands.x + 10} y={WornIconAt.hands.y} w={10} h={32} since={sHands} />
        <DuelFlashSign x={WornIconAt.feet.x + 10} y={WornIconAt.feet.y} w={10} h={32} since={sFeet} />
        <DuelFlashSign x={WornIconAt.ring.x + 10} y={WornIconAt.ring.y} w={10} h={32} since={sRing} />
      </layer>

      <layer
        right={DuelLayout.presets.right}
        y={{ bottom: 0 }}
        w={DuelLayout.presets.w}
        h={{ fill: DuelLayout.presets.drop }}
      >
        <DuelPresetRow
          x="center"
          y={0}
          w="fill"
          h={DuelLayout.presetRow.h}
          tip={DuelTip.SAVE}
          verb="Save settings"
          label="Save as preset"
          icon={DuelSprites.SAVE}
          mobile={mobile}
        />
        <DuelPresetRow
          x="center"
          y={19}
          w="fill"
          h={DuelLayout.presetRow.h}
          tip={DuelTip.LOAD}
          verb="Load preset settings"
          label="Load preset"
          icon={DuelSprites.LOAD}
          mobile={mobile}
        />
        <sprite
          right={DuelLayout.presetTick.right}
          y={20}
          w={17}
          h={17}
          sprite={DuelSprites.TICK}
          hide
          onMouseRepeat={() => showDuelTooltip(DuelTip.PRESET_MATCH)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <DuelPresetRow
          x="center"
          y={38}
          w="fill"
          h={DuelLayout.presetRow.h}
          tip={DuelTip.LOAD_LAST}
          verb="Load last duel's settings"
          label="Load last duel"
          icon={DuelSprites.LOAD}
          mobile={mobile}
        />
        <sprite
          right={DuelLayout.presetTick.right}
          y={39}
          w={17}
          h={17}
          sprite={DuelSprites.TICK}
          hide
          onMouseRepeat={() => showDuelTooltip(DuelTip.LAST_DUEL_MATCH)}
          onMouseLeave={() => hideDuelTooltip()}
        />
        <DuelPresetRow
          x={0}
          y={57}
          w={DuelLayout.presetHalf.w}
          h={DuelLayout.presetRow.h}
          tip={DuelTip.WHIP}
          verb={'"Whip" settings'}
          label={'"Whip"'}
          icon={-1}
          mobile={mobile}
        />
        <sprite x={0} y={58} w={17} h={17} sprite={DuelSprites.RADIO_PRESET} />
        <DuelPresetRow
          right={0}
          y={57}
          w={{ fill: DuelLayout.presetHalf.w }}
          h={DuelLayout.presetRow.h}
          tip={DuelTip.BOXING}
          verb={'"Boxing" settings'}
          label={'"Boxing"'}
          icon={-1}
          mobile={mobile}
        />
        <sprite x={68} y={58} w={17} h={17} sprite={DuelSprites.RADIO_PRESET} />
      </layer>
    </layer>
  );
}

const DISABLED_HEX = '999999';
