              fill
              color={DuelColor.HIGHLIGHT}
              transparency={RowWash.REST}
            />
            <text
              right={0}
              y="center"
              w={{ fill: DuelLayout.presetRow.textInset }}
              h="fill"
              text="Load last duel"
              font={DuelFonts.LABEL}
              color={DuelColor.OPTION}
              shadow
              align="left"
              valign="middle"
            />
            <sprite
              x={DuelLayout.presetRow.iconX}
              y="center"
              w={DuelLayout.presetRow.icon}
              h={DuelLayout.presetRow.icon}
              sprite={DuelSprites.LOAD}
            />
          </layer>
          <sprite
            right={DuelLayout.presetTick.right}
            y={39}
            w={17}
            h={17}
            sprite={DuelSprites.TICK}
            hide
            onMouseRepeat={() => showDuelTooltip(DuelTip.LAST_DUEL_MATCH)}
            onMouseLeave={() => hideDuelTooltip()}
          />
          <layer
            x={0}
            y={57}
            w={DuelLayout.presetHalf.w}
            h={DuelLayout.presetRow.h}
            options={['"Whip" settings', Copy.INFO]}
            onMouseRepeat={() => hoverDuelOption(washWhip, DuelTip.WHIP)}
            onMouseLeave={() => leaveDuelOption(washWhip)}
            onOptionSelect={(event) => clickDuelOption(event.option, DuelBit.NONE, DuelTip.WHIP, washWhip)}
          >
            <rect
              ref={washWhip}
              right={0}
              y="center"
              w="fill"
              h="fill"
              fill
              color={DuelColor.HIGHLIGHT}
              transparency={RowWash.REST}
            />
            <text
              right={0}
              y="center"
              w={{ fill: DuelLayout.presetRow.textInset }}
              h="fill"
              text={'"Whip"'}
              font={DuelFonts.LABEL}
              color={DuelColor.OPTION}
              shadow
              align="left"
              valign="middle"
            />
          </layer>
          <sprite x={0} y={58} w={17} h={17} sprite={DuelSprites.RADIO_PRESET} />
          <layer
            right={0}
            y={57}
            w={{ fill: DuelLayout.presetHalf.w }}
            h={DuelLayout.presetRow.h}
            options={['"Boxing" settings', Copy.INFO]}
            onMouseRepeat={() => hoverDuelOption(washBoxing, DuelTip.BOXING)}
            onMouseLeave={() => leaveDuelOption(washBoxing)}
            onOptionSelect={(event) => clickDuelOption(event.option, DuelBit.NONE, DuelTip.BOXING, washBoxing)}
          >
            <rect
              ref={washBoxing}
              right={0}
              y="center"
              w="fill"
              h="fill"
              fill
              color={DuelColor.HIGHLIGHT}
              transparency={RowWash.REST}
            />
            <text
              right={0}
              y="center"
              w={{ fill: DuelLayout.presetRow.textInset }}
              h="fill"
              text={'"Boxing"'}
              font={DuelFonts.LABEL}
              color={DuelColor.OPTION}
              shadow
              align="left"
              valign="middle"
            />
          </layer>
          <sprite x={68} y={58} w={17} h={17} sprite={DuelSprites.RADIO_PRESET} />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <DuelTooltip />
      </layer>
    </>
  );
}
