  iconWeapon,
  itemAmmo,
  itemBody,
  itemCape,
  itemFeet,
  itemHands,
  itemHead,
  itemLegs,
  itemNeck,
  itemRing,
  itemShield,
  itemWeapon,
  labelNoSpecial,
  radioFunWeapons,
  radioNoDrinks,
  radioNoFood,
  radioNoForfeit,
  radioNoMagic,
  radioNoMelee,
  radioNoMovement,
  radioNoPrayer,
  radioNoRanged,
  radioNoSpecial,
  radioNoSwitch,
  radioShowInv,
  signFunWeapons,
  signNoDrinks,
  signNoFood,
  signNoForfeit,
  signNoMagic,
  signNoMelee,
  signNoMovement,
  signNoPrayer,
