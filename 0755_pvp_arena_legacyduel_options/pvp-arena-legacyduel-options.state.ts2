import { CS2, predictServerState, sessionState, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { hasBit, playSound } from '../lib/lib.engine';
import { tooltipDown, tooltipDwellElapsed, tooltipHide, tooltipMark, tooltipRaise } from '../lib/tooltip.component';
import {
  DuelBit,
  DuelSounds,
  DuelVarbits,
  DuelVarps,
  FLASHER_HALF,
  FLASHER_LIFE,
  FLASHER_PERIOD,
  RowWash,
  WornBit,
  WornSlot,
} from './pvp-arena-legacyduel-options.constants';
import { DuelTip, DuelTips } from './pvp-arena-legacyduel-options.data';

export function onEnhancedMobile(): Boolean {
  const type: Int = CS2.clienttype();
  if (useServerState(Varbits.OSM_SIMULATE) === 1) {
    if (type === 4 || type === 5 || type === 10) {
      return true;
    }
  }
  if (type === 7 || type === 8) {
    return true;
  }
  return false;
}

export const duelTip = sessionState(-1);

export function showDuelTooltip(tip: Int): void {
  const [, setTip] = useState(duelTip);
  if (onEnhancedMobile()) {
    return;
  }
  const row = DuelTips.at(tip);
  if (row === null) {
    return;
  }
  tooltipMark();
  if (!tooltipDwellElapsed(row.dwell)) {
    return;
  }
  if (!tooltipDown()) {
    return;
  }
  setTip(tip);
  tooltipRaise();
}

export function hideDuelTooltip(): void {
  const [, setTip] = useState(duelTip);
  tooltipHide();
  setTip(DuelTip.NONE);
}

export function toggleDuelBit(bit: Int): void {
  const options: Int = useServerState(DuelVarps.OPTIONS);
  if (hasBit(options, bit)) {
    predictServerState(DuelVarps.OPTIONS, CS2.bit_clear(options, bit));
  } else {
    predictServerState(DuelVarps.OPTIONS, CS2.bit_set(options, bit));
  }
  hideTooltipIfUnbarred();
}

export function toggleWornOption(bit: Int): void {
  playSound(DuelSounds.SELECT);
  toggleDuelBit(bit);
}

export function hideTooltipIfUnbarred(): void {
  const barred: Int = useServerState(DuelVarbits.WORN_OPTIONS);
  if (
    !hasBit(barred, WornSlot.HEAD) ||
    !hasBit(barred, WornSlot.CAPE) ||
    !hasBit(barred, WornSlot.NECK) ||
    !hasBit(barred, WornSlot.WEAPON) ||
    !hasBit(barred, WornSlot.BODY) ||
    !hasBit(barred, WornSlot.SHIELD) ||
    !hasBit(barred, WornSlot.LEGS) ||
    !hasBit(barred, WornSlot.HANDS) ||
    !hasBit(barred, WornSlot.FEET) ||
    !hasBit(barred, WornSlot.RING) ||
    !hasBit(barred, WornSlot.AMMO)
  ) {
    hideDuelTooltip();
  }
}

export const flashNoForfeit = sessionState(-1);
export const flashNoMovement = sessionState(-1);
export const flashNoSwitch = sessionState(-1);
export const flashShowInv = sessionState(-1);
export const flashNoRanged = sessionState(-1);
export const flashNoMelee = sessionState(-1);
export const flashNoMagic = sessionState(-1);
export const flashNoDrinks = sessionState(-1);
export const flashNoFood = sessionState(-1);
export const flashNoPrayer = sessionState(-1);
export const flashFunWeapons = sessionState(-1);
export const flashNoSpecial = sessionState(-1);
export const flashWornHead = sessionState(-1);
export const flashWornCape = sessionState(-1);
export const flashWornNeck = sessionState(-1);
export const flashWornAmmo = sessionState(-1);
export const flashWornWeapon = sessionState(-1);
export const flashWornBody = sessionState(-1);
export const flashWornShield = sessionState(-1);
export const flashWornLegs = sessionState(-1);
export const flashWornHands = sessionState(-1);
export const flashWornFeet = sessionState(-1);
export const flashWornRing = sessionState(-1);

export function flasherAlpha(now: Int, since: Int): Int {
  const elapsed: Int = now - since;
  if (elapsed >= FLASHER_LIFE) {
    return RowWash.REST;
  }
  if (now % FLASHER_PERIOD >= FLASHER_HALF) {
    return RowWash.REST;
  }
  return CS2.interpolate(0, elapsed, 0, FLASHER_LIFE, RowWash.REST);
}

export function openDuelRules(): void {
  const [, setNoForfeit] = useState(flashNoForfeit);
  const [, setNoMovement] = useState(flashNoMovement);
  const [, setNoSwitch] = useState(flashNoSwitch);
  const [, setShowInv] = useState(flashShowInv);
  const [, setNoRanged] = useState(flashNoRanged);
  const [, setNoMelee] = useState(flashNoMelee);
  const [, setNoMagic] = useState(flashNoMagic);
  const [, setNoDrinks] = useState(flashNoDrinks);
  const [, setNoFood] = useState(flashNoFood);
  const [, setNoPrayer] = useState(flashNoPrayer);
  const [, setFunWeapons] = useState(flashFunWeapons);
  const [, setNoSpecial] = useState(flashNoSpecial);
  const [, setHead] = useState(flashWornHead);
  const [, setCape] = useState(flashWornCape);
  const [, setNeck] = useState(flashWornNeck);
  const [, setAmmo] = useState(flashWornAmmo);
  const [, setWeapon] = useState(flashWornWeapon);
  const [, setBody] = useState(flashWornBody);
  const [, setShield] = useState(flashWornShield);
  const [, setLegs] = useState(flashWornLegs);
  const [, setHands] = useState(flashWornHands);
  const [, setFeet] = useState(flashWornFeet);
  const [, setRing] = useState(flashWornRing);
  setNoForfeit(-1);
  setNoMovement(-1);
  setNoSwitch(-1);
  setShowInv(-1);
  setNoRanged(-1);
  setNoMelee(-1);
  setNoMagic(-1);
  setNoDrinks(-1);
  setNoFood(-1);
  setNoPrayer(-1);
  setFunWeapons(-1);
  setNoSpecial(-1);
  setHead(-1);
  setCape(-1);
  setNeck(-1);
  setAmmo(-1);
  setWeapon(-1);
  setBody(-1);
  setShield(-1);
  setLegs(-1);
  setHands(-1);
  setFeet(-1);
  setRing(-1);
  hideTooltipIfUnbarred();
}

export function flashDuelOption(option: Int): void {
  const [, setNoForfeit] = useState(flashNoForfeit);
  const [, setNoMovement] = useState(flashNoMovement);
  const [, setNoSwitch] = useState(flashNoSwitch);
  const [, setShowInv] = useState(flashShowInv);
  const [, setNoRanged] = useState(flashNoRanged);
  const [, setNoMelee] = useState(flashNoMelee);
  const [, setNoMagic] = useState(flashNoMagic);
  const [, setNoDrinks] = useState(flashNoDrinks);
  const [, setNoFood] = useState(flashNoFood);
  const [, setNoPrayer] = useState(flashNoPrayer);
  const [, setFunWeapons] = useState(flashFunWeapons);
  const [, setNoSpecial] = useState(flashNoSpecial);
  const [, setHead] = useState(flashWornHead);
  const [, setCape] = useState(flashWornCape);
  const [, setNeck] = useState(flashWornNeck);
  const [, setAmmo] = useState(flashWornAmmo);
  const [, setWeapon] = useState(flashWornWeapon);
  const [, setBody] = useState(flashWornBody);
  const [, setShield] = useState(flashWornShield);
  const [, setLegs] = useState(flashWornLegs);
  const [, setHands] = useState(flashWornHands);
  const [, setFeet] = useState(flashWornFeet);
  const [, setRing] = useState(flashWornRing);
  const now: Int = CS2.clientclock();
  switch (option) {
    case DuelBit.NO_FORFEIT: {
      setNoForfeit(now);
    }
    case DuelBit.NO_MOVEMENT: {
      setNoMovement(now);
    }
    case DuelBit.NO_SWITCH: {
      setNoSwitch(now);
    }
    case DuelBit.SHOW_INVENTORIES: {
      setShowInv(now);
    }
    case DuelBit.NO_RANGED: {
      setNoRanged(now);
    }
    case DuelBit.NO_MELEE: {
      setNoMelee(now);
    }
    case DuelBit.NO_MAGIC: {
      setNoMagic(now);
    }
    case DuelBit.NO_DRINKS: {
      setNoDrinks(now);
    }
    case DuelBit.NO_FOOD: {
      setNoFood(now);
    }
    case DuelBit.NO_PRAYER: {
      setNoPrayer(now);
    }
    case DuelBit.FUN_WEAPONS: {
      setFunWeapons(now);
    }
    case DuelBit.NO_SPECIAL: {
      setNoSpecial(now);
    }
    case WornBit.HEAD: {
      setHead(now);
    }
    case WornBit.CAPE: {
      setCape(now);
    }
    case WornBit.NECK: {
      setNeck(now);
    }
    case WornBit.AMMO: {
      setAmmo(now);
    }
    case WornBit.WEAPON: {
      setWeapon(now);
    }
    case WornBit.BODY: {
      setBody(now);
    }
    case WornBit.SHIELD: {
      setShield(now);
    }
    case WornBit.LEGS: {
      setLegs(now);
    }
    case WornBit.HANDS: {
      setHands(now);
    }
    case WornBit.FEET: {
      setFeet(now);
    }
    case WornBit.RING: {
      setRing(now);
    }
  }
}
