import { useServerState, useState } from 'ts2';

import { hasBit } from '../lib/lib.engine';
import {
  ConfirmBit,
  ConfirmColor,
  ConfirmFonts,
  ConfirmSprites,
  ConfirmTab,
  ConfirmVarps,
  Copy,
  Layout,
  confirmTab,
} from './pvp-arena-legacyduel-confirm.constants';

export function ConfirmPanes(): Component {
  const options: Int = useServerState(ConfirmVarps.OPTIONS);
  const [tab] = useState(confirmTab);

  let invHidden: Boolean = true;
  let wornHidden: Boolean = true;
  let notice: String = Copy.NOT_SHOWN;
  if (hasBit(options, ConfirmBit.SHOW_INVENTORIES)) {
    notice = '';
    if (tab === ConfirmTab.INVENTORY) {
      invHidden = false;
    } else {
      wornHidden = false;
    }
  }

  return (
    <>
      <layer hide={invHidden} x="center" y="bottom" w="fill" h={{ fill: Layout.otherPane.drop }} />

      <layer hide={wornHidden} x="center" y="bottom" w="fill" h={{ fill: Layout.otherPane.drop }}>
        <sprite x="center" y="center" w={36} h={144} sprite={ConfirmSprites.RAIL_V} tiling />
        <sprite x="center" y={{ center: -45 }} w={54} h={36} sprite={ConfirmSprites.RAIL_H} tiling />
        <sprite x="center" y="center" w={84} h={36} sprite={ConfirmSprites.RAIL_H} tiling />
        <sprite x={{ center: -60 }} y={{ center: 45 }} w={36} h={54} sprite={ConfirmSprites.RAIL_V} tiling />
        <sprite x={{ center: 60 }} y={{ center: 45 }} w={36} h={54} sprite={ConfirmSprites.RAIL_V} tiling />
        <layer x="center" y={{ center: -90 }} w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer
          x={{ center: -45 }}
          y={{ center: -45 }}
          w={36}
          h={36}
          options={['', '', '', '', '', '', '', '', '', '*']}
        />
        <layer x="center" y={{ center: -45 }} w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer x={{ center: -60 }} y="center" w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer x="center" y="center" w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer x={{ center: 60 }} y="center" w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer x="center" y={{ center: 45 }} w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer
          x={{ center: -60 }}
          y={{ center: 90 }}
          w={36}
          h={36}
          options={['', '', '', '', '', '', '', '', '', '*']}
        />
        <layer x="center" y={{ center: 90 }} w={36} h={36} options={['', '', '', '', '', '', '', '', '', '*']} />
        <layer
          x={{ center: 60 }}
          y={{ center: 90 }}
          w={36}
          h={36}
          options={['', '', '', '', '', '', '', '', '', '*']}
        />
        <layer
          x={{ center: 45 }}
          y={{ center: -45 }}
          w={36}
          h={36}
          options={['', '', '', '', '', '', '', '', '', '*']}
        />
      </layer>

      <text
        x="center"
        y="bottom"
        w={{ fill: Layout.notice.inset }}
        h={{ fill: Layout.notice.drop }}
        text={notice}
        font={ConfirmFonts.BODY}
        color={ConfirmColor.NOTICE}
        align="center"
        valign="middle"
        shadow
        lineHeight={Layout.notice.lineHeight}
      />
    </>
  );
}
