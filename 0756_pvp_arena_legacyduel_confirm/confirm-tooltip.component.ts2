import { useInterval, useState } from 'ts2';

import { tooltipBuilt } from '../lib/game/varcs';
import { textLineCount, textWidth } from '../lib/lib.engine';
import { TooltipBox, TooltipChrome, tooltipStale } from '../lib/tooltip.component';
import { ConfirmFonts, Layout } from './pvp-arena-legacyduel-confirm.constants';
import { ConfirmTips } from './pvp-arena-legacyduel-confirm.data';
import { confirmTip, hideConfirmTip } from './pvp-arena-legacyduel-confirm.state';

export function ConfirmTooltip(): Component {
  const [built] = useState(tooltipBuilt);
  const [key] = useState(confirmTip);

  useInterval(
    built === 1
      ? () => {
          if (tooltipStale()) {
            hideConfirmTip();
          }
        }
      : undefined,
  );

  const row = ConfirmTips.get(key);
  let text: String = '';
  let anchorX: Int = 0;
  let anchorY: Int = 0;
  let anchorH: Int = 0;
  let wrap: Int = 0;
  if (built === 1 && row !== null) {
    text = row.text;
    anchorX = row.x;
    anchorY = row.y;
    anchorH = row.h;
    wrap = row.wrap;
  }

  const hostW: Int = Layout.root.w;
  const hostH: Int = Layout.root.h;
  let measure: Int = wrap;
  if (measure > hostW) {
    measure = hostW;
  }
  measure = measure - TooltipBox.padX;
  const boxW: Int = TooltipBox.padX + textWidth(text, measure, ConfirmFonts.BODY);
  const boxH: Int = TooltipBox.padY + TooltipBox.line * textLineCount(text, measure, ConfirmFonts.BODY);

  let x: Int = anchorX + TooltipBox.nudge;
  if (x > hostW - boxW) {
    x = hostW - boxW;
  }
  let y: Int = anchorY + anchorH + TooltipBox.nudge;
  if (y > hostH - boxH) {
    y = anchorY - boxH - TooltipBox.nudge;
  }

  if (text.length === 0) {
    return <layer x={0} y={0} w={Layout.tooltip.w} h={Layout.tooltip.h} />;
  }

  return (
    <layer x={x} y={y} w={boxW} h={boxH}>
      <TooltipChrome text={text} font={ConfirmFonts.BODY} lineHeight={0} />
    </layer>
  );
}
