import { useWatch } from 'ts2';

import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ConfirmAcceptButton, ConfirmDeclineButton, ConfirmTabButton } from './confirm-buttons.component';
import { ConfirmPanes } from './confirm-panes.component';
import { ConfirmTooltip } from './confirm-tooltip.component';
import { ConfirmWornSlot } from './confirm-worn-slot.component';
import {
  ConfirmColor,
  ConfirmFonts,
  ConfirmSprites,
  ConfirmTab,
  ConfirmVarps,
  Copy,
  Layout,
  invTabRef,
  wornTabRef,
} from './pvp-arena-legacyduel-confirm.constants';
import { noteShowInventoriesCleared, openConfirmPanes } from './pvp-arena-legacyduel-confirm.state';

export function PvpArenaLegacyduelConfirm(): Component {
  useWatch(ConfirmVarps.OPTIONS, () => noteShowInventoriesCleared());

  return (
    <>
      <SteelBorderEntrypoint title={Copy.TITLE} />

      <rect
        x={Layout.ruleH.darkX}
        y={Layout.ruleH.darkY}
        w={Layout.ruleH.darkW}
        h={1}
        fill
        color={ConfirmColor.RULE_DARK}
        transparency={100}
      />
      <rect
        x={Layout.ruleH.lightX}
        y={Layout.ruleH.lightY}
        w={Layout.ruleH.lightW}
        h={1}
        fill
        color={ConfirmColor.RULE_LIGHT}
        transparency={100}
      />

      <rect
        x={Layout.ruleV.darkX}
        y={Layout.ruleV.darkY}
        w={1}
        h={{ fill: Layout.ruleV.darkDrop }}
        fill
        color={ConfirmColor.RULE_DARK}
        transparency={100}
      />
      <rect
        x={Layout.ruleV.lightX}
        y={Layout.ruleV.lightY}
        w={1}
        h={{ fill: Layout.ruleV.lightDrop }}
        fill
        color={ConfirmColor.RULE_LIGHT}
        transparency={100}
      />
      <rect
        right={Layout.ruleV.darkRight}
        y={Layout.ruleV.darkY}
        w={1}
        h={{ fill: Layout.ruleV.darkDrop }}
        fill
        color={ConfirmColor.RULE_DARK}
        transparency={100}
      />
      <rect
        right={Layout.ruleV.lightRight}
        y={Layout.ruleV.lightY}
        w={1}
        h={{ fill: Layout.ruleV.lightDrop }}
        fill
        color={ConfirmColor.RULE_LIGHT}
        transparency={100}
      />

      <layer
        x="center"
        y={{ bottom: Layout.body.bottom }}
        w={{ fill: Layout.body.inset }}
        h={{ fill: Layout.body.drop }}
      >
        <layer x={0} y="center" w={Layout.left.w} h="fill">
          <layer x={0} y={0} w={0} h={0} onLoad={() => openConfirmPanes()} />

          <layer x={0} y={0} w="fill" h={Layout.tabs.h}>
            <layer ref={invTabRef} x={{ center: -Layout.tabs.dx }} y={0} w={Layout.tabs.w} h="fill">
              <ConfirmTabButton tab={ConfirmTab.INVENTORY} icon={ConfirmSprites.TAB_INV} />
            </layer>
            <layer ref={wornTabRef} x={{ center: Layout.tabs.dx }} y={0} w={Layout.tabs.w} h="fill">
              <ConfirmTabButton tab={ConfirmTab.WORN} icon={ConfirmSprites.TAB_WORN} />
            </layer>
          </layer>

          <ConfirmPanes />
        </layer>

        <layer x={Layout.worn.x} y={0} w={Layout.worn.w} h={Layout.worn.h}>
          <sprite x="center" y="center" w={36} h={124} sprite={ConfirmSprites.RAIL_V} tiling />
          <sprite x="center" y={{ center: -40 }} w={48} h={36} sprite={ConfirmSprites.RAIL_H} tiling />
          <sprite x="center" y="center" w={74} h={36} sprite={ConfirmSprites.RAIL_H} tiling />
          <sprite x={{ center: -55 }} y={{ center: 40 }} w={36} h={44} sprite={ConfirmSprites.RAIL_V} tiling />
          <sprite x={{ center: 55 }} y={{ center: 40 }} w={36} h={44} sprite={ConfirmSprites.RAIL_V} tiling />

          <layer x="center" y={{ center: -80 }} w={36} h={36}>
            <ConfirmWornSlot slot={0} />
          </layer>
          <layer x={{ center: -42 }} y={{ center: -40 }} w={36} h={36}>
            <ConfirmWornSlot slot={1} />
          </layer>
          <layer x="center" y={{ center: -40 }} w={36} h={36}>
            <ConfirmWornSlot slot={2} />
          </layer>
          <layer x={{ center: -55 }} y="center" w={36} h={36}>
            <ConfirmWornSlot slot={3} />
          </layer>
          <layer x="center" y="center" w={36} h={36}>
            <ConfirmWornSlot slot={4} />
          </layer>
          <layer x={{ center: 55 }} y="center" w={36} h={36}>
            <ConfirmWornSlot slot={5} />
          </layer>
          <layer x="center" y={{ center: 40 }} w={36} h={36}>
            <ConfirmWornSlot slot={7} />
          </layer>
          <layer x={{ center: -55 }} y={{ center: 80 }} w={36} h={36}>
            <ConfirmWornSlot slot={9} />
          </layer>
          <layer x="center" y={{ center: 80 }} w={36} h={36}>
            <ConfirmWornSlot slot={10} />
          </layer>
          <layer x={{ center: 55 }} y={{ center: 80 }} w={36} h={36}>
            <ConfirmWornSlot slot={12} />
          </layer>
          <layer x={{ center: 42 }} y={{ center: -40 }} w={36} h={36}>
            <ConfirmWornSlot slot={13} />
          </layer>
        </layer>

        <text
          x={Layout.during.x}
          y={Layout.during.y}
          w={Layout.during.w}
          h={Layout.during.h}
          text=""
          font={ConfirmFonts.SMALL}
          color={ConfirmColor.DURING}
          align="center"
          valign="middle"
          shadow
          lineHeight={Layout.during.lineHeight}
        />

        <layer x={Layout.button.declineX} y="bottom" w={Layout.button.w} h={Layout.button.h}>
          <ConfirmDeclineButton />
        </layer>
        <layer right={Layout.button.acceptRight} y="bottom" w={Layout.button.w} h={Layout.button.h}>
          <ConfirmAcceptButton />
        </layer>

        <layer right={0} y={0} w={Layout.spare.w} h="fill">
          <layer x={0} y={0} w={{ fill: Layout.spare.barW }} h="fill" />
          <layer right={0} y={0} w={Layout.spare.barW} h="fill" />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill">
        <ConfirmTooltip />
      </layer>
    </>
  );
