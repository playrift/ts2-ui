import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { DisplayA, DisplayB, DisplayC } from './kit-displays.component';
import { OpponentPage } from './opponent-page.component';
import { StatsPage } from './stats-page.component';
import { UnrankedTabStrip } from './tabs.component';
import { Layout, UnrankedColor, UnrankedFonts } from './pvp-arena-unrankedduel.constants';
import { displayA, displayB, displayC, opponentPage, statsPage } from './pvp-arena-unrankedduel.refs';

export function PvpArenaUnrankedduel(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="" />

      <text
        x="center"
        y={Layout.title.y}
        w={{ fill: Layout.title.inset }}
        h={Layout.title.h}
        text=""
        font={UnrankedFonts.TITLE}
        color={UnrankedColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer
        static
        x="center"
        y={{ bottom: Layout.body.bottom }}
        w={{ fill: Layout.body.inset }}
        h={{ fill: Layout.body.drop }}
      >
        <layer static x="center" y={0} w={{ fill: Layout.tabs.inset }} h={Layout.tabs.h}>
          <UnrankedTabStrip />
          <rect static x="center" y="bottom" w="fill" h={Layout.rule.h} fill color={UnrankedColor.RULE} />
        </layer>

        <layer static ref={statsPage} x="center" y="bottom" w="fill" h={{ fill: Layout.page.drop }} hide>
          <StatsPage />
        </layer>

        <layer static ref={displayA} x="center" y="bottom" w="fill" h={{ fill: Layout.page.drop }} hide>
          <DisplayA />
        </layer>
        <layer static ref={displayB} x="center" y="bottom" w="fill" h={{ fill: Layout.page.drop }} hide>
          <DisplayB />
        </layer>
        <layer static ref={displayC} x="center" y="bottom" w="fill" h={{ fill: Layout.page.drop }} hide>
          <DisplayC />
        </layer>

        <layer static ref={opponentPage} x="center" y="bottom" w="fill" h={{ fill: Layout.page.drop }} hide>
          <OpponentPage />
        </layer>
      </layer>

      <layer static x="center" y="center" w="fill" h="fill" />
    </>
  );
}
