import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { BuildList } from '../lib/pvp-arena/build-list.component';
import { StatColumn, StatSide } from '../lib/pvp-arena/stat-column-side.component';
import { ChooseBuildSkill } from '../0765_pvp_arena_choosebuild/pvp-arena-choosebuild.constants';
import { SuppliesSprites } from '../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';
import { UnrankedBuildConfirm } from './confirm.component';
import { FighterCamera, FighterModel, Layout, UnrankedColor, UnrankedFonts } from './pvp-arena-unrankedduel.constants';

export function StatsPage(): Component {
  return (
    <>
      <layer x="center" y={0} w="fill" h={Layout.strip.h}>
        <sprite
          x="center"
          y={{ center: Layout.strip.backingNudge }}
          w={{ fill: Layout.strip.backingInset }}
          h={{ fill: Layout.strip.backingInset }}
          sprite={SuppliesSprites.STRIP_BACKING}
          tiling
        />
        <BuildList />
      </layer>

      <layer x="center" y={{ bottom: Layout.stats.bottom }} w={Layout.stats.w} h={Layout.stats.h}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.stats.backingInset }}
          h={{ fill: Layout.stats.backingInset }}
          sprite={SuppliesSprites.ROW_BACK}
          tiling
        />
        <rect
          x={Layout.stats.ruleX}
          y="center"
          w={Layout.stats.ruleW}
          h={{ fill: Layout.stats.ruleDrop }}
          fill
          color={UnrankedColor.RULE_LIGHT}
        />
        <rect
          x={{ right: Layout.stats.ruleX }}
          y="center"
          w={Layout.stats.ruleW}
          h={{ fill: Layout.stats.ruleDrop }}
          fill
          color={UnrankedColor.RULE_DARK}
        />
        <layer x={Layout.stats.columnInset} y="center" w={Layout.stats.columnW} h={{ fill: Layout.stats.columnDrop }}>
          <StatColumn
            side={StatSide.LEFT}
            skill0={ChooseBuildSkill.ATTACK}
            skill1={ChooseBuildSkill.STRENGTH}
            skill2={ChooseBuildSkill.RANGED}
            skill3={ChooseBuildSkill.MAGIC}
          />
        </layer>
        <layer
          x={{ right: Layout.stats.columnInset }}
          y="center"
          w={Layout.stats.columnW}
          h={{ fill: Layout.stats.columnDrop }}
        >
          <StatColumn
            side={StatSide.RIGHT}
            skill0={ChooseBuildSkill.DEFENCE}
            skill1={ChooseBuildSkill.HITPOINTS}
            skill2={ChooseBuildSkill.PRAYER}
            skill3={ChooseBuildSkill.AGILITY}
          />
        </layer>
        <ThinStoneBoxEntrypoint />
      </layer>

      <model
        x={0}
        y={{ bottom: Layout.fighter.leftBottom }}
        w={Layout.fighter.w}
        h={Layout.fighter.h}
        model={FighterModel.LEFT}
        zoom={FighterCamera.left.zoom}
        pitch={FighterCamera.left.pitch}
        yaw={FighterCamera.left.yaw}
        offsetY={FighterCamera.left.offsetY}
      />
      <model
        x={0}
        y={{ bottom: 0 }}
        w={Layout.fighter.w}
        h={Layout.fighter.h}
        model={FighterModel.CENTRE}
        zoom={FighterCamera.centre.zoom}
        pitch={FighterCamera.centre.pitch}
        yaw={FighterCamera.centre.yaw}
      />
      <model
        x={{ right: 0 }}
        y={{ bottom: Layout.fighter.rightBottom }}
        w={Layout.fighter.w}
        h={Layout.fighter.shortH}
        model={FighterModel.RIGHT}
        zoom={FighterCamera.right.zoom}
        pitch={FighterCamera.right.pitch}
        yaw={FighterCamera.right.yaw}
      />

      <layer x="center" y="center" w="fill" h="fill">
        <UnrankedBuildConfirm />
      </layer>

      <text
        x={{ right: Layout.buildSpare.right }}
        y={{ bottom: Layout.buildSpare.bottom }}
        w={Layout.buildSpare.w}
        h={Layout.buildSpare.h}
        text=""
        font={UnrankedFonts.BODY}
        color={UnrankedColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
