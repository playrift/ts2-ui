import { Build, SuppliesColor } from './pvp-arena-stagingarea-supplies.constants';
import { binLabelA, binLabelB, binLabelC } from './pvp-arena-stagingarea-supplies.refs';

export function binHover(build: Int, hot: Boolean): void {
  const colour: Int = hot ? SuppliesColor.WHITE : SuppliesColor.LABEL;
  if (build === Build.ZERKER) {
    binLabelB.color = colour;
    return;
  }
  if (build === Build.PURE) {
    binLabelC.color = colour;
    return;
  }
  binLabelA.color = colour;
}
