import { onMounted, onUpdated, useRef, useServerState, useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { xpdropsFake6 } from '../lib/game/varcs';
import { SuppliesTab } from '../lib/pvp-arena/kit-tab.component';
import { battleSettled, kitTabShown, kitTabX, selectDisplays } from './supplies-tabs';
import {
  Build,
  Copy,
  Layout,
  STATS_TAB,
  SuppliesColor,
  SuppliesFonts,
  SuppliesSounds,
  SuppliesSprites,
  SuppliesVarbits,
} from './pvp-arena-stagingarea-supplies.constants';

export function SuppliesTabStrip(): Component {
  const battleType: Int = useServerState(SuppliesVarbits.BATTLE_TYPE);
  const build: Int = useServerState(SuppliesVarbits.BUILD);
  const [tab] = useState(xpdropsFake6);
  const settled: Boolean = battleSettled(battleType);

  onMounted(() => selectDisplays(tab));
  onUpdated(() => selectDisplays(tab));

  return (
    <>
      <layer x={0} y="center" w={Layout.tabs.statsW} h="fill">
        <SuppliesTab index={STATS_TAB} label={Copy.TAB_STATS} active={tab === STATS_TAB} />
      </layer>
      <layer
        x={kitTabX(settled, Build.MAX_MED)}
        y="center"
        w={Layout.tabs.kitW}
        h="fill"
        hide={!kitTabShown(settled, build, Build.MAX_MED)}
      >
        <SuppliesTab index={Build.MAX_MED} label={Copy.TAB_MAX_MED} active={tab === Build.MAX_MED} />
      </layer>
      <layer
        x={kitTabX(settled, Build.ZERKER)}
        y="center"
        w={Layout.tabs.kitW}
        h="fill"
        hide={!kitTabShown(settled, build, Build.ZERKER)}
      >
        <SuppliesTab index={Build.ZERKER} label={Copy.TAB_ZERKER} active={tab === Build.ZERKER} />
      </layer>
      <layer
        x={kitTabX(settled, Build.PURE)}
        y="center"
        w={Layout.tabs.kitW}
        h="fill"
        hide={!kitTabShown(settled, build, Build.PURE)}
      >
        <SuppliesTab index={Build.PURE} label={Copy.TAB_PURE} active={tab === Build.PURE} />
      </layer>
    </>
  );
}
