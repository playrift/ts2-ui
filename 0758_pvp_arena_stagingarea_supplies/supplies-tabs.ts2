import { useState } from 'ts2';
import { xpdropsFake6 } from '../lib/game/varcs';
import { displayA, displayB, displayC, statsDisplay } from './pvp-arena-stagingarea-supplies.refs';
import { BattleType, Build, Layout, STATS_TAB } from './pvp-arena-stagingarea-supplies.constants';

export function battleSettled(battleType: Int): Boolean {
  if (
    battleType === BattleType.TOURNAMENT_UNRANKED ||
    battleType === BattleType.TOURNAMENT_RANKED ||
    battleType === BattleType.DUEL_UNRANKED ||
    battleType === BattleType.DUEL_RANKED
  ) {
    return true;
  }
  return false;
}

export function kitTabShown(settled: Boolean, build: Int, which: Int): Boolean {
  if (!settled) {
    return true;
  }
  if (build === Build.ZERKER) {
    return which === Build.ZERKER;
  }
  if (build === Build.PURE) {
    return which === Build.PURE;
  }
  return which === Build.MAX_MED;
}

export function kitTabX(settled: Boolean, which: Int): Int {
  if (settled) {
    return Layout.tabs.statsW;
  }
  if (which === Build.ZERKER) {
    return Layout.tabs.second;
  }
  if (which === Build.PURE) {
    return Layout.tabs.third;
  }
  return Layout.tabs.statsW;
}

export function selectDisplays(tab: Int): void {
  displayA.hide = tab !== Build.MAX_MED;
  displayB.hide = tab !== Build.ZERKER;
  displayC.hide = tab !== Build.PURE;
  statsDisplay.hide = tab === Build.MAX_MED || tab === Build.ZERKER || tab === Build.PURE;
}

export function suppliesInit(): void {
  const [, setTab] = useState(xpdropsFake6);
  setTab(STATS_TAB);
}
