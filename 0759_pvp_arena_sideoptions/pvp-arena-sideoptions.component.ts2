import { closeInterface } from '../lib/lib.helpers';
import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { FightLocationRow } from './fight-location-row.component';
import {
  SideOptionsColor,
  SideOptionsFonts,
  SideOptionsLayout,
  SideOptionsSprites,
} from './pvp-arena-sideoptions.constants';

export function PvpArenaSideOptions(): Component {
  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={SideOptionsSprites.BACKING} tiling />

      <text
        x="center"
        y={0}
        w="fill"
        h={SideOptionsLayout.title.h}
        text="Options"
        font={SideOptionsFonts.TITLE}
        color={SideOptionsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        right={SideOptionsLayout.close.inset}
        y={SideOptionsLayout.close.top}
        w={SideOptionsLayout.close.size}
        h={SideOptionsLayout.close.size}
        sprite={SideOptionsSprites.CLOSE}
        hover={{ sprite: SideOptionsSprites.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />

      <layer
        x="center"
        y={{ bottom: SideOptionsLayout.body.bottom }}
        w={{ fill: SideOptionsLayout.body.inset }}
        h={{ fill: SideOptionsLayout.body.drop }}
      >
        <text
          x={0}
          y={0}
          w="fill"
          h={SideOptionsLayout.label.h}
          text="Preferred fight location:"
          font={SideOptionsFonts.LABEL}
          color={SideOptionsColor.LABEL}
          align="left"
          valign="top"
          shadow
        />

        <FightLocationRow
          x="center"
          y={SideOptionsLayout.row.first}
          w="fill"
          h={SideOptionsLayout.row.h}
          label="USA"
          flag={SideOptionsSprites.FLAG_USA}
          index={0}
        />
        <FightLocationRow
          x="center"
          y={SideOptionsLayout.row.first + SideOptionsLayout.row.h}
          w="fill"
          h={SideOptionsLayout.row.h}
          label="UK"
          flag={SideOptionsSprites.FLAG_UK}
          index={1}
        />
        <FightLocationRow
          x="center"
          y={SideOptionsLayout.row.first + SideOptionsLayout.row.h * 2}
          w="fill"
          h={SideOptionsLayout.row.h}
          label="Australia"
          flag={SideOptionsSprites.FLAG_AUSTRALIA}
          index={2}
        />
      </layer>

      <StonePanelEntrypoint divider={SideOptionsLayout.title.h} />
    </>
  );
}
