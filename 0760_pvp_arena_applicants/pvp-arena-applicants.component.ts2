import { playSound } from '../lib/lib.engine';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { StoneTextButton } from './stone-text-button.component';
import {
  ApplicantRows,
  ApplicantsColor,
  ApplicantsFonts,
  ApplicantsSounds,
  ApplicantsSprites,
  Layout,
  PANEL_TITLE,
} from './pvp-arena-applicants.constants';

export function PvpArenaApplicants(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <SteelBorderEntrypoint title={PANEL_TITLE} />

        <layer
          x="center"
          y={{ bottom: Layout.CONTENTS_Y }}
          w={{ fill: Layout.CONTENTS_INSET_W }}
          h={{ fill: Layout.CONTENTS_INSET_H }}
        >
          <layer
            x={{ center: Layout.BUTTON_OFFSET }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            options={['Recruitment Board']}
            onOptionSelect={() => playSound(ApplicantsSounds.CLICK)}
          >
            <StoneTextButton label="Recruitment Board" />
          </layer>

          <layer
            x="center"
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            options={['Refresh']}
            onOptionSelect={() => playSound(ApplicantsSounds.CLICK)}
          >
            <StoneTextButton label="Refresh" />
          </layer>

          <layer
            x={{ center: Layout.BUTTON_OFFSET_LEFT }}
            y="bottom"
            w={Layout.BUTTON_W}
            h={Layout.BUTTON_H}
            options={['Unlist']}
            onOptionSelect={() => playSound(ApplicantsSounds.CLICK)}
          >
            <StoneTextButton label="Unlist group" />
          </layer>

          <layer x={0} y={0} w="fill" h={Layout.HEADER_H}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={ApplicantsSprites.BACKING}
              tiling
            />
            <layer x={Layout.SORT_NAME_X} y="center" w={Layout.SORT_W} h={{ fill: Layout.SORT_INSET_H }} />
            <layer x={Layout.SORT_RANK_X} y="center" w={Layout.SORT_W} h={{ fill: Layout.SORT_INSET_H }} />

            <ThinBoxEntrypoint />
          </layer>

          <layer
            x={0}
            y={{ bottom: Layout.HOLDER_Y }}
            w={{ fill: Layout.HOLDER_INSET_W }}
            h={{ fill: Layout.HOLDER_INSET_H }}
          >
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={ApplicantsSprites.BACKING}
              tiling
            />

            {ApplicantRows.map(() => (
              <layer x={0} y={0} w={0} h={0} />
            ))}

            <ThinBoxEntrypoint />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text="Loading..."
              font={ApplicantsFonts.LABEL}
              color={ApplicantsColor.PLACEHOLDER}
              align="center"
              valign="middle"
              shadow
            />
          </layer>

          <layer x="right" y={{ bottom: Layout.HOLDER_Y }} w={Layout.SCROLLBAR_W} h={{ fill: Layout.HOLDER_INSET_H }} />
        </layer>
      </layer>
    </layer>
  );
}
