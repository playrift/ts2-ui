import { useState } from 'ts2';

import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { ApplicantsColor, ApplicantsFonts } from './pvp-arena-applicants.constants';

export function StoneTextButton({ label }: { label: String }): Component {
  const [pressed, setPressed] = useState(0);

  return (
    <layer w="fill" h="fill" onMouseEnter={() => setPressed(1)} onMouseLeave={() => setPressed(0)}>
      {pressed === 1 ? <StoneButtonPressed /> : <StoneButton />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={ApplicantsFonts.LABEL}
        color={ApplicantsColor.BUTTON}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
