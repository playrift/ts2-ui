import { Anchor, overlayInit } from '../lib/lib.overlay';
import { opsound } from '../lib/lib.helpers';
import { Copy, Layout, PvpArenaHudDodge } from './pvp-arena-hud.constants';
import { PvpArenaHudInfo } from './pvp-arena-hud-info.component';
import { PvpArenaHudTimer } from './pvp-arena-hud-timer.component';
import { infoBox, infoDodger, timerBox, timerDodger } from './pvp-arena-hud.refs';

export function PvpArenaHud_(): Component {
  return (
    <>
      <layer
        ref={timerDodger}
        onLoad={() => overlayInit(timerDodger, timerBox, PvpArenaHudDodge.TIMER, Anchor.CENTRE, Anchor.TOP, 1)}
        x="center"
        y="center"
        w="fill"
        h="fill"
      >
        <layer ref={timerBox} x="center" y={Layout.TIMER_Y} w={Layout.TIMER_W} h={Layout.TIMER_H}>
          <PvpArenaHudTimer />
        </layer>
      </layer>

      <layer
        ref={infoDodger}
        onLoad={() => overlayInit(infoDodger, infoBox, PvpArenaHudDodge.INFO, Anchor.RIGHT, Anchor.TOP, 1)}
        x="center"
        y="center"
        w="fill"
        h="fill"
      >
        <layer
          ref={infoBox}
          x={{ right: Layout.INFO_INSET }}
          y={Layout.INFO_Y}
          w={Layout.INFO_SIZE}
          h={Layout.INFO_SIZE}
          noClickThrough
          options={[Copy.DEFINITION_OP]}
          onOptionSelect={(event) => opsound(event.option, 2)}
        >
          <PvpArenaHudInfo />
        </layer>
      </layer>
    </>
  );
}
