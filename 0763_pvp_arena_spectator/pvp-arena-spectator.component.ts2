import { Layout, Proportion, PvpaColor, PvpaFonts, PvpaSprites, PvpaText } from './pvp-arena-spectator.constants';
import { useInterval, useOnResize, useRef, useState, useUniverse } from 'ts2';

import { pvpaSpectatorLeftCombo, pvpaSpectatorRightCombo } from '../lib/game/varcs';
import {
  NOT_BOUND,
  pvpaLeftHp,
  pvpaLeftMaxHp,
  pvpaLeftMaxPrayer,
  pvpaLeftName,
  pvpaLeftPrayer,
  pvpaLeftSpecial,
  pvpaLeftTrailTarget,
  pvpaRightHp,
  pvpaRightMaxHp,
  pvpaRightMaxPrayer,
  pvpaRightName,
  pvpaRightPrayer,
  pvpaRightSpecial,
  pvpaRightTrailTarget,
} from './pvp-arena-spectator.state';
import {
  healthDrawn,
  healthLabel,
  nameLabel,
  prayerDrawn,
  prayerLabel,
  proportionPx,
  pvpaSpectatorLeftTrail,
  pvpaSpectatorRightTrail,
  Share,
  specialDrawn,
  specialLabel,
  trailDrawn,
} from './pvpa-spectator-stats';

export function PvpArenaSpectator(): Component {
  return (
    <>
      <layer x={0} y={0} w={Proportion.HALF} h="fill">
        <layer x={Layout.STRIP_INSET} y={Layout.STRIP_INSET} w={{ fill: Layout.STRIP_W_INSET }} h={Layout.STRIP_H}>
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={PvpaSprites.BACKING}
            tiling
          />

          <LeftStats />

          <rect x={0} y={0} w="fill" h="fill" />
        </layer>
      </layer>

      <layer x="right" y={0} w={Proportion.HALF} h="fill">
        <layer
          x={{ right: Layout.STRIP_INSET }}
          y={Layout.STRIP_INSET}
          w={{ fill: Layout.STRIP_W_INSET }}
          h={Layout.STRIP_H}
        >
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKING_INSET }}
            h={{ fill: Layout.BACKING_INSET }}
            sprite={PvpaSprites.BACKING}
            tiling
          />

          <RightStats />

          <rect x={0} y={0} w="fill" h="fill" />
        </layer>
      </layer>

      <layer x={Layout.INV_INSET} y={{ bottom: Layout.INV_INSET }} w={Layout.INV_W} h={Layout.INV_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKING_INSET }}
          h={{ fill: Layout.BACKING_INSET }}
          sprite={PvpaSprites.BACKING}
          tiling
        />
        <layer x="center" y="center" w={{ fill: Layout.INV_CONTENT_INSET }} h={{ fill: Layout.INV_CONTENT_INSET }} />
        <rect x={0} y={0} w="fill" h="fill" />
      </layer>

      <layer x={{ right: Layout.INV_INSET }} y={{ bottom: Layout.INV_INSET }} w={Layout.INV_W} h={Layout.INV_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKING_INSET }}
          h={{ fill: Layout.BACKING_INSET }}
          sprite={PvpaSprites.BACKING}
          tiling
        />
        <layer x="center" y="center" w={{ fill: Layout.INV_CONTENT_INSET }} h={{ fill: Layout.INV_CONTENT_INSET }} />
        <rect x={0} y={0} w="fill" h="fill" />
      </layer>

      <layer x="center" y={Layout.BAND_Y} w={{ fill: Layout.BAND_W_INSET }} h={{ fill: Layout.BAND_H_INSET }}>
        <layer x={0} y="center" w={Layout.BAND_SLOT_W} h="fill" />
        <layer x="right" y="center" w={Layout.BAND_SLOT_W} h="fill" />
      </layer>

      <layer x="center" y={Layout.SPACER_Y} w={Layout.SPACER_W} h={Layout.SPACER_H} />
    </>
  );
}

function LeftStats(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  const contentW: Int = universe.width - Layout.STRIP_CONTENT_INSET;

  const [called] = useState(pvpaLeftName);
  const [hp] = useState(pvpaLeftHp);
  const [maxHp] = useState(pvpaLeftMaxHp);
  const [prayer] = useState(pvpaLeftPrayer);
  const [maxPrayer] = useState(pvpaLeftMaxPrayer);
  const [special] = useState(pvpaLeftSpecial);
  const [trail] = useState(pvpaSpectatorLeftCombo);
  const [trailTarget] = useState(pvpaLeftTrailTarget);

  const name: String = nameLabel(hp, called, PvpaText.PLAYER_ONE);
  const healthText: String = healthLabel(hp);
  const prayerText: String = prayerLabel(hp, prayer, maxPrayer);
  const specialText: String = specialLabel(hp, special);
  const healthPx: Int = proportionPx(healthDrawn(hp, maxHp), contentW);
  const trailPx: Int = proportionPx(trailDrawn(trail), contentW);
  const specialInnerW: Int = proportionPx(Share.SPECIAL, contentW) - Layout.SPECIAL_INNER_INSET;
  const specialPx: Int = proportionPx(specialDrawn(hp, special), specialInnerW);
  const prayerPx: Int = proportionPx(prayerDrawn(hp, prayer, maxPrayer), proportionPx(Share.PRAYER, contentW));

  const walking: Boolean = trailTarget !== NOT_BOUND;
  const trailHost = useRef();
  useInterval(() => pvpaSpectatorLeftTrail(), trailHost);

  return (
    <layer
      x={Layout.STRIP_PAD}
      y={Layout.STRIP_PAD}
      w={{ fill: Layout.STRIP_CONTENT_INSET }}
      h={{ fill: Layout.STRIP_CONTENT_INSET }}
    >
      <text
        x={{ right: Layout.LEVEL_INSET }}
        y={Layout.LEVEL_INSET}
        w={Layout.LEVEL_W}
        h={Layout.LEVEL_H}
        hide
        text={PvpaText.DASH}
        font={PvpaFonts.NAME}
        color={PvpaColor.NAME}
        shadow
        align="center"
      />

      <layer x={0} y={0} w="fill" h={Layout.HEALTH_ROW_H}>
        <rect x="right" y="center" w="fill" h="fill" color={PvpaColor.HEALTH_GONE} fill />
        <rect x="right" y="center" w={trailPx} h="fill" color={PvpaColor.HEALTH_COMBO} fill />
        <layer ref={trailHost} x={0} y={0} w={1} h={1} hide={!walking} />
        <rect x="right" y="center" w={healthPx} h="fill" color={PvpaColor.HEALTH_LEFT} fill />
        <sprite
          x={{ right: Layout.HEART_INSET }}
          y="center"
          w={Layout.HEART}
          h={Layout.HEART}
          sprite={PvpaSprites.HEART}
        />
        <text
          x={{ right: Layout.HP_TEXT_INSET }}
          y={{ center: Layout.HP_TEXT_RISE }}
          w={Layout.HP_TEXT_W}
          h="fill"
          text={healthText}
          font={PvpaFonts.NAME}
          color={PvpaColor.BAR_TEXT}
          shadow
          align="center"
          valign="middle"
        />
        <rect x="center" y="center" w="fill" h="fill" />
      </layer>

      <layer x={0} y="bottom" w={Proportion.SPECIAL_SHARE} h={Layout.BAR_H}>
        <layer x={0} y={0} w={{ fill: Layout.SPECIAL_INNER_INSET }} h="fill">
          <rect x={0} y="center" w="fill" h="fill" color={PvpaColor.SPECIAL_GONE} fill />
          <rect x={0} y="center" w={specialPx} h="fill" color={PvpaColor.SPECIAL_LEFT} fill />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={specialText}
            font={PvpaFonts.BAR}
            color={PvpaColor.BAR_TEXT}
            shadow
            align="center"
            valign="middle"
          />
          <sprite x={Layout.ORB_INSET} y="center" w={Layout.ORB_W} h={Layout.ORB_H} sprite={PvpaSprites.SPECIAL_ORB} />
          <sprite
            x={{ right: Layout.ORB_INSET }}
            y="center"
            w={Layout.ORB_W}
            h={Layout.ORB_H}
            sprite={PvpaSprites.SPECIAL_ORB}
          />
          <rect x="center" y="center" w="fill" h="fill" />
        </layer>
      </layer>

      <layer x="right" y="bottom" w={Proportion.PRAYER_SHARE} h={Layout.BAR_H}>
        <rect x="right" y="center" w="fill" h="fill" color={PvpaColor.PRAYER_GONE} fill />
        <rect x="right" y="center" w={prayerPx} h="fill" color={PvpaColor.PRAYER_LEFT} fill />
        <text
          x={0}
          y="center"
          w={{ fill: Layout.PRAYER_TEXT_INSET }}
          h="fill"
          text={prayerText}
          font={PvpaFonts.BAR}
          color={PvpaColor.BAR_TEXT}
          shadow
          align="right"
          valign="middle"
        />
        <sprite x={Layout.ORB_INSET} y="center" w={Layout.ORB_W} h={Layout.ORB_H} sprite={PvpaSprites.PRAYER_ORB} />
        <sprite
          x={{ right: Layout.ORB_INSET }}
          y="center"
          w={Layout.ORB_W}
          h={Layout.ORB_H}
          sprite={PvpaSprites.PRAYER_ORB}
        />
        <rect x="center" y="center" w="fill" h="fill" />
      </layer>

      <text
        x={Layout.NAME_INSET_LEFT}
        y={0}
        w="fill"
        h={Layout.NAME_H}
        text={name}
        font={PvpaFonts.NAME}
        color={PvpaColor.NAME}
        shadow
      />
    </layer>
  );
}

function RightStats(): Component {
  const universe = useUniverse();
  useOnResize(universe);
  const contentW: Int = universe.width - Layout.STRIP_CONTENT_INSET;

  const [called] = useState(pvpaRightName);
  const [hp] = useState(pvpaRightHp);
  const [maxHp] = useState(pvpaRightMaxHp);
  const [prayer] = useState(pvpaRightPrayer);
  const [maxPrayer] = useState(pvpaRightMaxPrayer);
  const [special] = useState(pvpaRightSpecial);
  const [trail] = useState(pvpaSpectatorRightCombo);
  const [trailTarget] = useState(pvpaRightTrailTarget);

  const name: String = nameLabel(hp, called, PvpaText.PLAYER_TWO);
  const healthText: String = healthLabel(hp);
  const prayerText: String = prayerLabel(hp, prayer, maxPrayer);
  const specialText: String = specialLabel(hp, special);
  const healthPx: Int = proportionPx(healthDrawn(hp, maxHp), contentW);
  const trailPx: Int = proportionPx(trailDrawn(trail), contentW);
  const specialInnerW: Int = proportionPx(Share.SPECIAL, contentW) - Layout.SPECIAL_INNER_INSET;
  const specialPx: Int = proportionPx(specialDrawn(hp, special), specialInnerW);
  const prayerPx: Int = proportionPx(prayerDrawn(hp, prayer, maxPrayer), proportionPx(Share.PRAYER, contentW));

  const walking: Boolean = trailTarget !== NOT_BOUND;
  const trailHost = useRef();
  useInterval(() => pvpaSpectatorRightTrail(), trailHost);

  return (
    <layer
      x={Layout.STRIP_PAD}
      y={Layout.STRIP_PAD}
      w={{ fill: Layout.STRIP_CONTENT_INSET }}
      h={{ fill: Layout.STRIP_CONTENT_INSET }}
    >
      <text
        x={{ right: Layout.LEVEL_INSET }}
        y={Layout.LEVEL_INSET}
        w={Layout.LEVEL_W}
        h={Layout.LEVEL_H}
        hide
        text={PvpaText.DASH}
        font={PvpaFonts.NAME}
        color={PvpaColor.NAME}
        shadow
        align="center"
      />

      <layer x={0} y={0} w="fill" h={Layout.HEALTH_ROW_H}>
        <rect x="right" y="center" w="fill" h="fill" color={PvpaColor.HEALTH_GONE} fill />
        <rect x={0} y="center" w={trailPx} h="fill" color={PvpaColor.HEALTH_COMBO} fill />
        <layer ref={trailHost} x={0} y={0} w={1} h={1} hide={!walking} />
        <rect x={0} y="center" w={healthPx} h="fill" color={PvpaColor.HEALTH_LEFT} fill />
        <sprite x={Layout.HEART_INSET} y="center" w={Layout.HEART} h={Layout.HEART} sprite={PvpaSprites.HEART} />
        <text
          x={Layout.HP_TEXT_INSET_RIGHT}
          y={{ center: Layout.HP_TEXT_RISE }}
          w={Layout.HP_TEXT_W}
          h="fill"
          text={healthText}
          font={PvpaFonts.NAME}
          color={PvpaColor.BAR_TEXT}
          shadow
          align="center"
          valign="middle"
        />
        <rect x="center" y="center" w="fill" h="fill" />
      </layer>

      <layer x="right" y="bottom" w={Proportion.SPECIAL_SHARE} h={Layout.BAR_H}>
        <layer x="right" y={0} w={{ fill: Layout.SPECIAL_INNER_INSET }} h="fill">
          <rect x={0} y="center" w="fill" h="fill" color={PvpaColor.SPECIAL_GONE} fill />
          <rect x="right" y="center" w={specialPx} h="fill" color={PvpaColor.SPECIAL_LEFT} fill />
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={specialText}
            font={PvpaFonts.BAR}
            color={PvpaColor.BAR_TEXT}
            shadow
            align="center"
            valign="middle"
          />
          <sprite x={Layout.ORB_INSET} y="center" w={Layout.ORB_W} h={Layout.ORB_H} sprite={PvpaSprites.SPECIAL_ORB} />
          <sprite
            x={{ right: Layout.ORB_INSET }}
            y="center"
            w={Layout.ORB_W}
            h={Layout.ORB_H}
            sprite={PvpaSprites.SPECIAL_ORB}
          />
          <rect x="center" y="center" w="fill" h="fill" />
        </layer>
      </layer>

      <layer x={0} y="bottom" w={Proportion.PRAYER_SHARE} h={Layout.BAR_H}>
        <rect x="right" y="center" w="fill" h="fill" color={PvpaColor.PRAYER_GONE} fill />
        <rect x={0} y="center" w={prayerPx} h="fill" color={PvpaColor.PRAYER_LEFT} fill />
        <text
          x="right"
          y="center"
          w={{ fill: Layout.PRAYER_TEXT_INSET }}
          h="fill"
          text={prayerText}
          font={PvpaFonts.BAR}
          color={PvpaColor.BAR_TEXT}
          shadow
          valign="middle"
        />
        <sprite x={Layout.ORB_INSET} y="center" w={Layout.ORB_W} h={Layout.ORB_H} sprite={PvpaSprites.PRAYER_ORB} />
        <sprite
          x={{ right: Layout.ORB_INSET }}
          y="center"
          w={Layout.ORB_W}
          h={Layout.ORB_H}
          sprite={PvpaSprites.PRAYER_ORB}
        />
        <rect x="center" y="center" w="fill" h="fill" />
      </layer>

      <text
        x={{ right: Layout.NAME_INSET_RIGHT }}
        y={0}
        w="fill"
        h={Layout.NAME_H}
        text={name}
        font={PvpaFonts.NAME}
        color={PvpaColor.NAME}
        shadow
        align="right"
      />
    </layer>
  );
}
