                text={PvpaText.DASH}
                font={PvpaFonts.NAME}
                color={PvpaColor.BAR_TEXT}
                shadow
                align="center"
                valign="middle"
              />
              <rect x="center" y="center" w="fill" h="fill" />
            </layer>

            <layer x={0} y="bottom" w={Proportion.SPECIAL_SHARE} h={Layout.BAR_H}>
