import { useState } from 'ts2';

import { minmax } from '../0811_lockpicking/lockpicking.state';
import { clientClock, scaled } from '../lib/lib.engine';
import {
  pvpaSpectatorLeftCombo,
  pvpaSpectatorLeftHitTime,
  pvpaSpectatorLeftLastHp,
  pvpaSpectatorRightCombo,
  pvpaSpectatorRightHitTime,
  pvpaSpectatorRightLastHp,
} from '../lib/game/varcs';
import { Bar, Combo, PvpaText } from './pvp-arena-spectator.constants';
import {
  NOT_BOUND,
  NOT_CALLED,
  pvpaLeftHp,
  pvpaLeftMaxHp,
  pvpaLeftMaxPrayer,
  pvpaLeftName,
  pvpaLeftPrayer,
  pvpaLeftSpecial,
  pvpaLeftTrailHp,
  pvpaLeftTrailTarget,
  pvpaRightHp,
  pvpaRightMaxHp,
  pvpaRightMaxPrayer,
  pvpaRightName,
  pvpaRightPrayer,
  pvpaRightSpecial,
  pvpaRightTrailHp,
  pvpaRightTrailTarget,
} from './pvp-arena-spectator.state';

export const Share = {
  SPECIAL: 4915,
  PRAYER: 11468,
};

export function proportionPx(fraction: Int, parentPx: Int): Int {
  return (fraction * parentPx) / Bar.FULL;
}

export function healthFraction(hp: Int, maxHp: Int): Int {
  return minmax(Bar.MIN, Bar.FULL, scaled(hp, maxHp, Bar.FULL));
}

export function healthDrawn(hp: Int, maxHp: Int): Int {
  if (hp === NOT_CALLED) {
    return Bar.FULL;
  }
  return healthFraction(hp, maxHp);
}

export function prayerDrawn(hp: Int, prayer: Int, maxPrayer: Int): Int {
  if (hp === NOT_CALLED) {
    return Bar.FULL;
  }
  return minmax(Bar.MIN, Bar.FULL, scaled(prayer, maxPrayer, Bar.FULL));
}

export function specialDrawn(hp: Int, special: Int): Int {
  if (hp === NOT_CALLED) {
    return Bar.FULL;
  }
  return minmax(Bar.MIN, Bar.FULL, scaled(special, Bar.SPECIAL_FULL, Bar.FULL));
}

export function trailDrawn(trail: Int): Int {
  if (trail === -1) {
    return Bar.FULL;
  }
  return trail;
}

export function nameLabel(hp: Int, name: String, placeholder: String): String {
  if (hp === NOT_CALLED) {
    return placeholder;
  }
  return name;
}

export function healthLabel(hp: Int): String {
  if (hp === NOT_CALLED) {
    return PvpaText.DASH;
  }
  return stringOf(hp);
}

export function prayerLabel(hp: Int, prayer: Int, maxPrayer: Int): String {
  if (hp === NOT_CALLED) {
    return PvpaText.RATIO;
  }
  return `${stringOf(prayer)} / ${stringOf(maxPrayer)}`;
}

export function specialLabel(hp: Int, special: Int): String {
  if (hp === NOT_CALLED) {
    return PvpaText.PERCENT;
  }
  return `${stringOf(special / Bar.SPECIAL_SCALE)}%`;
}

export function pvpaSpectatorStats(
  name: String,
  hp: Int,
  maxHp: Int,
  prayer: Int,
  maxPrayer: Int,
  special: Int,
  side: Int,
): void {
  if (side === 1) {
    const [, setName] = useState(pvpaRightName);
    const [, setHp] = useState(pvpaRightHp);
    const [, setMaxHp] = useState(pvpaRightMaxHp);
    const [, setPrayer] = useState(pvpaRightPrayer);
    const [, setMaxPrayer] = useState(pvpaRightMaxPrayer);
    const [, setSpecial] = useState(pvpaRightSpecial);
    const [boundBefore, setTarget] = useState(pvpaRightTrailTarget);
    const [, setTrailHp] = useState(pvpaRightTrailHp);
    const fromRest: Boolean = boundBefore === NOT_BOUND;
    setName(name);
    setHp(hp);
    setMaxHp(maxHp);
    setPrayer(prayer);
    setMaxPrayer(maxPrayer);
    setSpecial(special);
    setTarget(healthFraction(hp, maxHp));
    setTrailHp(hp);
    if (fromRest) {
      pvpaSpectatorRightTrail();
    }
    return;
  }
  const [, setName] = useState(pvpaLeftName);
  const [, setHp] = useState(pvpaLeftHp);
  const [, setMaxHp] = useState(pvpaLeftMaxHp);
  const [, setPrayer] = useState(pvpaLeftPrayer);
  const [, setMaxPrayer] = useState(pvpaLeftMaxPrayer);
  const [, setSpecial] = useState(pvpaLeftSpecial);
  const [boundBefore, setTarget] = useState(pvpaLeftTrailTarget);
  const [, setTrailHp] = useState(pvpaLeftTrailHp);
  const fromRest: Boolean = boundBefore === NOT_BOUND;
  setName(name);
  setHp(hp);
  setMaxHp(maxHp);
  setPrayer(prayer);
  setMaxPrayer(maxPrayer);
  setSpecial(special);
  if (side === 0) {
    setTarget(healthFraction(hp, maxHp));
    setTrailHp(hp);
    if (fromRest) {
      pvpaSpectatorLeftTrail();
    }
  } else {
    setTarget(NOT_BOUND);
  }
}

export function pvpaSpectatorLeftTrail(): void {
  const [target, setTarget] = useState(pvpaLeftTrailTarget);
  if (target === NOT_BOUND) {
    return;
  }
  const [hp] = useState(pvpaLeftTrailHp);
  const [stored, setTrail] = useState(pvpaSpectatorLeftCombo);
  const [lastHp, setLastHp] = useState(pvpaSpectatorLeftLastHp);
  const [hitTime, setHitTime] = useState(pvpaSpectatorLeftHitTime);
  let trail: Int = stored;
  if (trail > target) {
    if (lastHp <= hp) {
      if (hitTime + Combo.HOLD_CYCLES <= clientClock()) {
        trail = Math.max(target, trail - Combo.STEP);
        setTrail(trail);
      }
    } else {
      setHitTime(clientClock());
    }
  } else {
    trail = target;
    setTrail(trail);
  }
  setLastHp(hp);
  if (trail === target) {
    setTarget(NOT_BOUND);
  }
}

export function pvpaSpectatorRightTrail(): void {
  const [target, setTarget] = useState(pvpaRightTrailTarget);
  if (target === NOT_BOUND) {
    return;
  }
  const [hp] = useState(pvpaRightTrailHp);
  const [stored, setTrail] = useState(pvpaSpectatorRightCombo);
  const [lastHp, setLastHp] = useState(pvpaSpectatorRightLastHp);
  const [hitTime, setHitTime] = useState(pvpaSpectatorRightHitTime);
  let trail: Int = stored;
  if (trail > target) {
    if (lastHp <= hp) {
      if (hitTime + Combo.HOLD_CYCLES <= clientClock()) {
        trail = Math.max(target, trail - Combo.STEP);
        setTrail(trail);
      }
    } else {
      setHitTime(clientClock());
    }
  } else {
    trail = target;
    setTrail(trail);
  }
  setLastHp(hp);
  if (trail === target) {
    setTarget(NOT_BOUND);
  }
}
