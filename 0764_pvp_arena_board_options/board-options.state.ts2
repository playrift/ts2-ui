import { CS2, predictServerState, sessionState, useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { BoardOptionsSounds, BoardOptionsVarps } from './pvp-arena-board-options.constants';

export const openControl = sessionState(-1);

export function dismissDropdown(): void {
  const [, setOpen] = useState(openControl);
  playSound(BoardOptionsSounds.SELECT);
  setOpen(-1);
}

export function chooseBoardOption(editing: Int, choice: Int, bitStart: Int, bitEnd: Int): void {
  predictServerState(BoardOptionsVarps.EDITING, CS2.bit_range_to_int_set(editing, choice, bitStart, bitEnd));
}
