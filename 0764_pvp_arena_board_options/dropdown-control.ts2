import { BoardOptionsColor, BoardOptionsSprites, BoardOptionsWash } from './pvp-arena-board-options.constants';

export function paintDropdownControl(strip: Ref, chevron: Ref, value: Ref, hovered: Boolean): void {
  if (hovered) {
    strip.transparency = BoardOptionsWash.CONTROL_HOVER;
    chevron.transparency = BoardOptionsWash.ARROW_HOVER;
    chevron.sprite = BoardOptionsSprites.ARROW_DOWN;
    value.color = BoardOptionsColor.LABEL_HOT;
    return;
  }
  strip.transparency = BoardOptionsWash.OPAQUE;
  chevron.transparency = BoardOptionsWash.OPAQUE;
  chevron.sprite = BoardOptionsSprites.ARROW_DOWN;
  value.color = BoardOptionsColor.LABEL;
}
