import { useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { chooseBoardOption, dismissDropdown } from './board-options.state';
import {
  BoardOptionsColor,
  BoardOptionsFonts,
  BoardOptionsLayout,
  BoardOptionsWash,
} from './pvp-arena-board-options.constants';

export function DropdownEntry({
  index,
  name,
  icon,
  entryHeight,
  editing,
  bitStart,
  bitEnd,
}: {
  index: Int;
  name: String;
  icon: Sprite;
  entryHeight: Int;
  editing: Int;
  bitStart: Int;
  bitEnd: Int;
}): Component {
  const top: Int = index * entryHeight;
  const [hover, setHover] = useState(0);

  return (
    <>
      <text
        x={BoardOptionsLayout.entry.textX}
        y={top}
        w={{ fill: BoardOptionsLayout.entry.textInset }}
        h={entryHeight}
        text={name}
        font={BoardOptionsFonts.VALUE}
        color={BoardOptionsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={BoardOptionsLayout.entry.iconX}
        y={top + entryHeight / 2 - 6}
        w={BoardOptionsLayout.entry.iconSize}
        h={BoardOptionsLayout.entry.iconSize}
        sprite={icon}
      />

      <rect
        x="center"
        y={top}
        w="fill"
        h={entryHeight}
        fill
        color={BoardOptionsColor.WASH}
        transparency={hover === 1 ? BoardOptionsWash.ENTRY_HOVER : BoardOptionsWash.CLEAR}
        options={['Select']}
        onMouseRepeat={() => {
          if (!onMobile()) {
            setHover(1);
          }
        }}
        onMouseLeave={() => {
          if (!onMobile()) {
            setHover(0);
          }
        }}
        onOptionSelect={() => {
          chooseBoardOption(editing, index, bitStart, bitEnd);
          dismissDropdown();
        }}
      />
    </>
  );
}
