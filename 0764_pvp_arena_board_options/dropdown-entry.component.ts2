import { onMobile } from '../lib/lib.helpers';
import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { chooseBoardOption, dismissDropdown } from './board-options.state';
import {
  BoardOptionsColor,
  BoardOptionsFonts,
  BoardOptionsLayout,
  BoardOptionsWash,
} from './pvp-arena-board-options.constants';

export function DropdownEntry({
  index,
  name,
  icon,
  entryHeight,
  editing,
  bitStart,
  bitEnd,
}: {
  index: Int;
  name: String;
  icon: Sprite;
  entryHeight: Int;
  editing: Int;
  bitStart: Int;
  bitEnd: Int;
}): Component {
  const top: Int = index * entryHeight;

  return (
    <>
      <text
        x={BoardOptionsLayout.entry.textX}
        y={top}
        w={{ fill: BoardOptionsLayout.entry.textInset }}
        h={entryHeight}
        text={name}
        font={BoardOptionsFonts.VALUE}
        color={BoardOptionsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        x={BoardOptionsLayout.entry.iconX}
        y={top + entryHeight / 2 - 6}
        w={BoardOptionsLayout.entry.iconSize}
        h={BoardOptionsLayout.entry.iconSize}
        sprite={icon}
      />

      <rect
        x="center"
        y={top}
        w="fill"
        h={entryHeight}
        fill
        color={BoardOptionsColor.WASH}
        transparency={BoardOptionsWash.CLEAR}
        options={['Select']}
        onMouseRepeat={(event) => {
          if (!onMobile()) {
            ccSetTrans(event.self, BoardOptionsWash.ENTRY_HOVER);
          }
        }}
        onMouseLeave={(event) => {
          if (!onMobile()) {
            ccSetTrans(event.self, BoardOptionsWash.CLEAR);
          }
        }}
        onOptionSelect={() => {
          chooseBoardOption(editing, index, bitStart, bitEnd);
          dismissDropdown();
        }}
      />
    </>
  );
}
