import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { StoneButtonInit } from '../0705_clans_creation_sidepanel/stone-button.component';
import { closeInterface } from '../lib/lib.helpers';
import { BoardOptionRow } from './board-option-row.component';
import { BoardOptionsPopup } from './board-options-popup.component';
import {
  BoardOptionDataset,
  BoardOptionsColor,
  BoardOptionsFonts,
  BoardOptionsLayout,
  BoardOptionsSprites,
} from './pvp-arena-board-options.constants';

export function PvpArenaBoardOptions(): Component {
  return (
    <layer
      x="center"
      y="center"
      w={{ fill: BoardOptionsLayout.root.inset }}
      h={{ fill: BoardOptionsLayout.root.inset }}
    >
      <sprite x="center" y="center" w="fill" h="fill" sprite={BoardOptionsSprites.BACKING} tiling />

      <text
        x="center"
        y={0}
        w="fill"
        h={BoardOptionsLayout.title.h}
        text="Settings"
        font={BoardOptionsFonts.TITLE}
        color={BoardOptionsColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <sprite
        right={BoardOptionsLayout.close.inset}
        y={BoardOptionsLayout.close.top}
        w={BoardOptionsLayout.close.size}
        h={BoardOptionsLayout.close.size}
        sprite={BoardOptionsSprites.CLOSE}
        hover={{ sprite: BoardOptionsSprites.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />

      <layer
        x="center"
        y={{ bottom: BoardOptionsLayout.body.bottom }}
        w={{ fill: BoardOptionsLayout.body.inset }}
        h={{ fill: BoardOptionsLayout.body.drop }}
      >
        <text
          x={0}
          y={0}
          w="fill"
          h={BoardOptionsLayout.hint.h}
          text="Changing the minimum and maximum ranks required to join will not kick anyone."
          font={BoardOptionsFonts.LABEL}
          color={BoardOptionsColor.HINT}
          align="center"
          valign="middle"
          shadow
        />

        <BoardOptionRow
          x="center"
          y={BoardOptionsLayout.row.firstY}
          w="fill"
          h={BoardOptionsLayout.row.h}
          index={0}
          heading="Min Rank allowed"
          dataset={BoardOptionDataset.RANKS}
          bitStart={0}
          bitEnd={2}
        />
        <BoardOptionRow
          x="center"
          y={BoardOptionsLayout.row.firstY + BoardOptionsLayout.row.gap}
          w="fill"
          h={BoardOptionsLayout.row.h}
          index={1}
          heading="Max Rank allowed"
          dataset={BoardOptionDataset.RANKS}
          bitStart={3}
          bitEnd={5}
        />
        <BoardOptionRow
          x="center"
          y={BoardOptionsLayout.row.firstY + BoardOptionsLayout.row.gap * 2}
          w="fill"
          h={BoardOptionsLayout.row.h}
          index={2}
          heading="Active Build"
          dataset={BoardOptionDataset.BUILDS}
          bitStart={6}
          bitEnd={7}
        />

        <StoneButtonInit
          x={{ center: BoardOptionsLayout.button.dx }}
          y={{ bottom: BoardOptionsLayout.button.bottom }}
          w={BoardOptionsLayout.button.w}
          h={BoardOptionsLayout.button.h}
          label="Save"
          font={BoardOptionsFonts.LABEL}
        />

        <StoneButtonInit
          x={{ center: -BoardOptionsLayout.button.dx }}
          y={{ bottom: BoardOptionsLayout.button.bottom }}
          w={BoardOptionsLayout.button.w}
          h={BoardOptionsLayout.button.h}
          label="<col=ff0000>Disband</col>"
          font={BoardOptionsFonts.LABEL}
        />
      </layer>

      <BoardOptionsPopup />

      <StonePanelEntrypoint divider={BoardOptionsLayout.title.h} />
    </layer>
  );
}
