import { Build } from './pvp-arena-choosebuild.constants';

export type BuildStatColumn = {
  row0: Int;
  row1: Int;
  row2: Int;
  row3: Int;
};

export const LeftStats = mapOf<Int, BuildStatColumn>([
  [Build.MAX_MED, { row0: 75, row1: 99, row2: 99, row3: 99 }],
  [Build.ZERKER, { row0: 60, row1: 99, row2: 99, row3: 99 }],
  [Build.PURE, { row0: 60, row1: 99, row2: 99, row3: 99 }],
]);

export const RightStats = mapOf<Int, BuildStatColumn>([
  [Build.MAX_MED, { row0: 70, row1: 99, row2: 77, row3: 99 }],
  [Build.ZERKER, { row0: 45, row1: 99, row2: 55, row3: 99 }],
  [Build.PURE, { row0: 1, row1: 99, row2: 52, row3: 99 }],
]);
