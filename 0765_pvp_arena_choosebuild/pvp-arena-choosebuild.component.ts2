import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { BuildList } from './build-list.component';
import { LeftStats, RightStats } from './build-stats.data';
import { StatColumn } from './stat-column.component';
import { StoneButtonInitEntrypoint } from './stone-button-init-entrypoint.component';
import {
  ChooseBuildColor,
  ChooseBuildFonts,
  ChooseBuildLayout,
  ChooseBuildModel,
  ChooseBuildSkill,
  ChooseBuildSprites,
  FighterCamera,
} from './pvp-arena-choosebuild.constants';

export function PvpArenaChooseBuild(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Choose a Build" />

      <layer
        x="center"
        y={{ bottom: ChooseBuildLayout.body.bottom }}
        w={{ fill: ChooseBuildLayout.body.inset }}
        h={{ fill: ChooseBuildLayout.body.drop }}
      >
        <layer x="center" y={0} w="fill" h={ChooseBuildLayout.strip.h}>
          <sprite
            x="center"
            y={{ center: ChooseBuildLayout.stripBacking.nudge }}
            w={{ fill: ChooseBuildLayout.stripBacking.inset }}
            h={{ fill: ChooseBuildLayout.stripBacking.inset }}
            sprite={ChooseBuildSprites.STRIP_BACKING}
            tiling
          />
          <BuildList />
        </layer>

        <layer x="center" y={{ bottom: 0 }} w={ChooseBuildLayout.stats.w} h={{ fill: ChooseBuildLayout.stats.drop }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: ChooseBuildLayout.statsBacking.inset }}
            h={{ fill: ChooseBuildLayout.statsBacking.inset }}
            sprite={ChooseBuildSprites.STATS_BACKING}
            tiling
          />

          <rect
            x={ChooseBuildLayout.statsRule.x}
            y="center"
            w={ChooseBuildLayout.statsRule.w}
            h={{ fill: ChooseBuildLayout.statsRule.drop }}
            fill
            color={ChooseBuildColor.RULE_LIGHT}
          />
          <rect
            right={ChooseBuildLayout.statsRule.x}
            y="center"
            w={ChooseBuildLayout.statsRule.w}
            h={{ fill: ChooseBuildLayout.statsRule.drop }}
            fill
            color={ChooseBuildColor.RULE_DARK}
          />

          <layer
            x={ChooseBuildLayout.statsColumn.inset}
            y="center"
            w={ChooseBuildLayout.statsColumn.w}
            h={{ fill: ChooseBuildLayout.statsColumn.drop }}
          >
            <StatColumn
              table={LeftStats}
              skill0={ChooseBuildSkill.ATTACK}
              skill1={ChooseBuildSkill.STRENGTH}
              skill2={ChooseBuildSkill.RANGED}
              skill3={ChooseBuildSkill.MAGIC}
            />
          </layer>

          <layer
            right={ChooseBuildLayout.statsColumn.inset}
            y="center"
            w={ChooseBuildLayout.statsColumn.w}
            h={{ fill: ChooseBuildLayout.statsColumn.drop }}
          >
            <StatColumn
              table={RightStats}
              skill0={ChooseBuildSkill.DEFENCE}
              skill1={ChooseBuildSkill.HITPOINTS}
              skill2={ChooseBuildSkill.PRAYER}
              skill3={ChooseBuildSkill.AGILITY}
            />
          </layer>

          <ThinStoneBoxEntrypoint />
        </layer>

        <model
          x={0}
          y={{ bottom: ChooseBuildLayout.fighter.raise }}
          w={ChooseBuildLayout.fighter.w}
          h={ChooseBuildLayout.fighter.h}
          model={ChooseBuildModel.LEFT}
          zoom={FighterCamera.left.zoom}
          pitch={FighterCamera.left.pitch}
          yaw={FighterCamera.left.yaw}
          offsetY={FighterCamera.left.offsetY}
        />
        <model
          x={0}
          y={{ bottom: 0 }}
          w={ChooseBuildLayout.fighter.w}
          h={ChooseBuildLayout.fighter.h}
          model={ChooseBuildModel.CENTRE}
          zoom={FighterCamera.centre.zoom}
          pitch={FighterCamera.centre.pitch}
          yaw={FighterCamera.centre.yaw}
          offsetY={FighterCamera.centre.offsetY}
        />
        <model
          right={0}
          y={{ bottom: ChooseBuildLayout.fighter.raise }}
          w={ChooseBuildLayout.fighter.w}
          h={ChooseBuildLayout.fighter.h}
          model={ChooseBuildModel.RIGHT}
          zoom={FighterCamera.right.zoom}
          pitch={FighterCamera.right.pitch}
          yaw={FighterCamera.right.yaw}
          offsetX={FighterCamera.right.offsetX}
          offsetY={FighterCamera.right.offsetY}
        />

        <layer
          right={ChooseBuildLayout.confirm.inset}
          y={{ bottom: 0 }}
          w={ChooseBuildLayout.confirm.w}
          h={ChooseBuildLayout.confirm.h}
        >
          <StoneButtonInitEntrypoint label="<col=0dc10d>Confirm</col>" font={ChooseBuildFonts.LABEL} />
        </layer>
      </layer>
    </>
  );
}
