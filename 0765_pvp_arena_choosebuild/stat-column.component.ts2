import { useServerState } from 'ts2';
import { BuildStatColumn } from './build-stats.data';
import {
  Build,
  ChooseBuildColor,
  ChooseBuildFonts,
  ChooseBuildLayout,
  ChooseBuildVarbits,
  SkillIcons,
} from './pvp-arena-choosebuild.constants';

export function StatColumn({
  table,
  skill0,
  skill1,
  skill2,
  skill3,
}: {
  table: Map<Int, BuildStatColumn>;
  skill0: Skill;
  skill1: Skill;
  skill2: Skill;
  skill3: Skill;
}): Component {
  const build: Int = useServerState(ChooseBuildVarbits.BUILD);

  let key: Int = Build.MAX_MED;
  if (build === Build.ZERKER) {
    key = Build.ZERKER;
  } else if (build === Build.PURE) {
    key = Build.PURE;
  }
  const stats = table.get(key);
  if (stats === null) {
    return null;
  }

  const row1: Int = ChooseBuildLayout.statRow.first + ChooseBuildLayout.statRow.pitch;
  const row2: Int = ChooseBuildLayout.statRow.first + ChooseBuildLayout.statRow.pitch * 2;
  const row3: Int = ChooseBuildLayout.statRow.first + ChooseBuildLayout.statRow.pitch * 3;
  const rule1: Int = row1 - ChooseBuildLayout.statRow.ruleLead;
  const rule2: Int = row2 - ChooseBuildLayout.statRow.ruleLead;
  const rule3: Int = row3 - ChooseBuildLayout.statRow.ruleLead;

  return (
    <>
      <sprite
        x={ChooseBuildLayout.statRow.iconX}
        y={ChooseBuildLayout.statRow.first}
        w={ChooseBuildLayout.statRow.icon}
        h={ChooseBuildLayout.statRow.icon}
        sprite={SkillIcons.get(skill0) ?? -1}
      />
      <text
        right={0}
        y={ChooseBuildLayout.statRow.first}
        w={{ fill: ChooseBuildLayout.statRow.valueInset }}
        h={ChooseBuildLayout.statRow.valueH}
        text={stringOf(stats.row0)}
        font={ChooseBuildFonts.BOLD}
        color={ChooseBuildColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <rect x="center" y={rule1} w="fill" h={1} fill color={ChooseBuildColor.RULE_LIGHT} />
      <rect x="center" y={rule1 + 1} w="fill" h={1} fill color={ChooseBuildColor.RULE_DARK} />
      <sprite
        x={ChooseBuildLayout.statRow.iconX}
        y={row1}
        w={ChooseBuildLayout.statRow.icon}
        h={ChooseBuildLayout.statRow.icon}
        sprite={SkillIcons.get(skill1) ?? -1}
      />
      <text
        right={0}
        y={row1}
        w={{ fill: ChooseBuildLayout.statRow.valueInset }}
        h={ChooseBuildLayout.statRow.valueH}
        text={stringOf(stats.row1)}
        font={ChooseBuildFonts.BOLD}
        color={ChooseBuildColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <rect x="center" y={rule2} w="fill" h={1} fill color={ChooseBuildColor.RULE_LIGHT} />
      <rect x="center" y={rule2 + 1} w="fill" h={1} fill color={ChooseBuildColor.RULE_DARK} />
      <sprite
        x={ChooseBuildLayout.statRow.iconX}
        y={row2}
        w={ChooseBuildLayout.statRow.icon}
        h={ChooseBuildLayout.statRow.icon}
        sprite={SkillIcons.get(skill2) ?? -1}
      />
      <text
        right={0}
        y={row2}
        w={{ fill: ChooseBuildLayout.statRow.valueInset }}
        h={ChooseBuildLayout.statRow.valueH}
        text={stringOf(stats.row2)}
        font={ChooseBuildFonts.BOLD}
        color={ChooseBuildColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />

      <rect x="center" y={rule3} w="fill" h={1} fill color={ChooseBuildColor.RULE_LIGHT} />
      <rect x="center" y={rule3 + 1} w="fill" h={1} fill color={ChooseBuildColor.RULE_DARK} />
      <sprite
        x={ChooseBuildLayout.statRow.iconX}
        y={row3}
        w={ChooseBuildLayout.statRow.icon}
        h={ChooseBuildLayout.statRow.icon}
        sprite={SkillIcons.get(skill3) ?? -1}
      />
      <text
        right={0}
        y={row3}
        w={{ fill: ChooseBuildLayout.statRow.valueInset }}
        h={ChooseBuildLayout.statRow.valueH}
        text={stringOf(stats.row3)}
        font={ChooseBuildFonts.BOLD}
        color={ChooseBuildColor.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </>
  );
}
