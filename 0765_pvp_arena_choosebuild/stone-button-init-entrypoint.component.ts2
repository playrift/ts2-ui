import { CS2, useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { STONEBUTTON_OP_SOUND_MASK } from './pvp-arena-choosebuild.constants';

export function StoneButtonInitEntrypoint({
  label,
  font,
  flags = 0,
}: {
  label: String;
  font: Font;
  flags?: Int;
}): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, STONEBUTTON_OP_SOUND_MASK)}
    >
      <StoneButtonDraw label={label} font={font} pressed={skin} flags={flags} />
    </layer>
  );
}
