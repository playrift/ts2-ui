import { useServerState } from 'ts2';

import { textLineCount, textWidth } from '../lib/lib.engine';
import {
  Hint,
  HintBox,
  Layout,
  Palette,
  PvpArenaStagingFonts,
  PvpArenaStagingVarbits,
  Wash,
} from './pvp-arena-stagingarea-hud.constants';

export function PvpArenaHint(): Component {
  let body: String = Hint.WAITING;
  if (useServerState(PvpArenaStagingVarbits.I_AM_READY) === 1) {
    body = Hint.READY;
  }

  const width: Int = textWidth(body, Layout.HINT_W, PvpArenaStagingFonts.HINT) + HintBox.PADDING_X;
  const height: Int = textLineCount(body, width, PvpArenaStagingFonts.HINT) * HintBox.LINE_HEIGHT + HintBox.PADDING_Y;

  return (
    <>
      <rect x="center" y={0} w={width} h={height} color={Palette.PLATE} fill transparency={Wash.PLATE} />
      <rect x="center" y={1} w={width - 2} h={height - 2} color={Palette.PLATE} fill transparency={Wash.PLATE} />
      <rect x="center" y={2} w={width - 4} h={height - 4} color={Palette.PLATE} fill transparency={Wash.PLATE} />

      <text
        x="center"
        y={HintBox.TEXT_INSET}
        w={width - 6}
        h={height - 6}
        font={PvpArenaStagingFonts.HINT}
        text={body}
        align="center"
        valign="middle"
        lineHeight={HintBox.LINE_HEIGHT}
        shadow
        color={Palette.TEXT}
      />
    </>
  );
}
