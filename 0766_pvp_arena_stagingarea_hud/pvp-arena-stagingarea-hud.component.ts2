import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, PvpArenaStagingHud } from './pvp-arena-stagingarea-hud.constants';
import { PvpArenaHint } from './pvp-arena-hint.component';
import { PvpArenaTimer } from './pvp-arena-timer.component';

const contents = createRef('pvp_arena_stagingarea_hud_contents2');

export function PvpArenaStagingareaHud_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, contents, PvpArenaStagingHud.DODGE, Anchor.CENTRE, Anchor.TOP, 0)
        }
      >
        <layer ref={contents} x="center" y="center" w="fill" h="fill">
          <layer x="center" y={Layout.TIMER_Y} w={Layout.TIMER_W} h={Layout.TIMER_H}>
            <PvpArenaTimer />
          </layer>

          <layer x="center" y="bottom" w={Layout.HINT_W} h={{ fill: Layout.HINT_FILL }}>
            <PvpArenaHint />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
