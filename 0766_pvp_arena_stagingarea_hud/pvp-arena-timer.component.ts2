import { useInterval, useRef, useServerState } from 'ts2';

import {
  Layout,
  NO_TIMER,
  Palette,
  PvpArenaStagingFonts,
  PvpArenaStagingSprites,
  PvpArenaStagingVarbits,
  ThinStoneBoxColor,
  Wash,
} from './pvp-arena-stagingarea-hud.constants';
import { pvpArenaCountdown } from './pvp-arena-stagingarea-hud.helpers';

export function PvpArenaTimer(): Component {
  const remaining: Int = useServerState(PvpArenaStagingVarbits.TIME_REMAINING);
  const clock = useRef();
  useInterval(remaining > 0 ? () => pvpArenaCountdown(clock) : undefined, clock);
  return (
    <>
      <sprite
        x="center"
        y="center"
        w={{ fill: Layout.TIMER_INSET }}
        h={{ fill: Layout.TIMER_INSET }}
        sprite={PvpArenaStagingSprites.BACKING}
        tiling
        transparency={Wash.BACKING}
      />

      <rect x="center" y="center" w="fill" h="fill" color={ThinStoneBoxColor.OUTER} />
      <rect
        x="center"
        y="center"
        w={{ fill: Layout.TIMER_INSET }}
        h={{ fill: Layout.TIMER_INSET }}
        color={ThinStoneBoxColor.INNER}
      />

      {remaining <= 0 ? (
        <text
          x="center"
          y="center"
          w={{ fill: Layout.TIMER_INSET }}
          h={{ fill: Layout.TIMER_INSET }}
          font={PvpArenaStagingFonts.TIMER}
          text={NO_TIMER}
          align="center"
          valign="middle"
          shadow
          color={Palette.TEXT}
        />
      ) : (
        <text
          x="center"
          y="center"
          w={{ fill: Layout.TIMER_INSET }}
          h={{ fill: Layout.TIMER_INSET }}
          font={PvpArenaStagingFonts.TIMER}
          text=""
          align="center"
          valign="middle"
          shadow
          color={Palette.TEXT}
          ref={clock}
        />
      )}
    </>
  );
}
