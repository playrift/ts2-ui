import { useState } from 'ts2';

import { pollId, pollYpos } from '../lib/game/varcs';
import { textWidth } from '../lib/lib.engine';
import { BoardFonts, Copy, Layout, bottomRef, mygroupRef, optionsRef, refreshRef } from './pvp-arena-board.constants';

export function layoutBoardButtons(): void {
  const [, setPollId] = useState(pollId);
  const [, setPollYpos] = useState(pollYpos);
  setPollId(0);
  setPollYpos(0);

  const mygroupW: Int =
    Layout.BUTTON_PAD +
    Math.max(
      textWidth(Copy.LIST_GROUP, Layout.MEASURE_W, BoardFonts.BODY),
      textWidth(Copy.VIEW_APPLICATIONS, Layout.MEASURE_W, BoardFonts.BODY),
    );
  const refreshW: Int = Layout.BUTTON_PAD + textWidth(Copy.REFRESH, Layout.MEASURE_W, BoardFonts.BODY);
  const optionsW: Int = Layout.BUTTON_PAD + textWidth(Copy.OPTIONS, Layout.MEASURE_W, BoardFonts.BODY);

  const gap: Int = (bottomRef.width - Layout.BOTTOM_INSET - (mygroupW + refreshW + optionsW)) / 4;

  let x: Int = Layout.BOTTOM_EDGE + gap;
  mygroupRef.width = mygroupW;
  mygroupRef.x = x;
  x = x + mygroupW + gap;
  optionsRef.width = optionsW;
  optionsRef.x = x;
  x = x + optionsW + gap;
  refreshRef.width = refreshW;
  refreshRef.x = x;
}
