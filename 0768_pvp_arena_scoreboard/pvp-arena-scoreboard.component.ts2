import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ScoreboardColor, ScoreboardFont, ScoreboardLayout, ScoreboardModel } from './pvp-arena-scoreboard.constants';

export function PvpArenaScoreboard(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Arena Scoreboard" />

      <layer
        x="center"
        y={{ bottom: ScoreboardLayout.frame.bottom }}
        w={{ fill: ScoreboardLayout.frame.inset }}
        h={{ fill: ScoreboardLayout.frame.drop }}
      >
        <model
          x="left"
          y="center"
          w={ScoreboardLayout.statue.w}
          h={ScoreboardLayout.statue.h}
          model={ScoreboardModel.STATUE}
          zoom={ScoreboardLayout.statue.zoom}
          pitch={ScoreboardLayout.statue.pitch}
          yaw={ScoreboardLayout.statue.yawLeft}
          offsetY={ScoreboardLayout.statue.offsetY}
        />

        <model
          x="right"
          y="center"
          w={ScoreboardLayout.statue.w}
          h={ScoreboardLayout.statue.h}
          model={ScoreboardModel.STATUE}
          zoom={ScoreboardLayout.statue.zoom}
          pitch={ScoreboardLayout.statue.pitch}
          yaw={ScoreboardLayout.statue.yawRight}
          offsetY={ScoreboardLayout.statue.offsetY}
        />

        <text
          x="center"
          y="center"
          w={{ fill: ScoreboardLayout.board.inset }}
          h="fill"
          text=""
          font={ScoreboardFont.BOARD}
          align="center"
          valign="middle"
          shadow
          color={ScoreboardColor.BOARD}
        />
      </layer>
    </>
  );
}
