import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { PvpaConfirm, PvpaPoints } from './pvpa-reward-footer.component';
import { PvpaRewardPane } from './pvpa-reward-pane.component';
import { PvpaFrame } from './pvp-arena-rewards.constants';

export function PvpArenaRewards(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="PvP Arena Rewards" />

      <layer
        x="center"
        y={{ bottom: PvpaFrame.BODY_BOTTOM }}
        w={{ fill: PvpaFrame.BODY_W_INSET }}
        h={{ fill: PvpaFrame.BODY_H_INSET }}
      >
        <PvpaRewardPane />
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x="center"
        y={{ bottom: PvpaFrame.FOOTER_BOTTOM }}
        w={{ fill: PvpaFrame.FOOTER_W_INSET }}
        h={PvpaFrame.FOOTER_H}
      >
        <PvpaPoints />
        <PvpaConfirm />
      </layer>

      <layer x="center" y="center" w="fill" h="fill" hide />
    </>
  );
}
