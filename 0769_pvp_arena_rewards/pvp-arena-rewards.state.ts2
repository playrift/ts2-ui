import { useState } from 'ts2';
import { chatMessage, playSound, textLineCount } from '../lib/lib.engine';
import {
  PvpaCounts,
  PvpaFonts,
  PvpaLayout,
  PvpaSounds,
  PvpaTitles,
  SelectedPvpaReward,
} from './pvp-arena-rewards.constants';

export function selectPvpaReward(index: Int): void {
  const [, setSelected] = useState(SelectedPvpaReward);
  playSound(PvpaSounds.SELECT);
  setSelected(index);
}

export function refusePvpaReward(message: String): void {
  const [, setSelected] = useState(SelectedPvpaReward);
  playSound(PvpaSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
}

export function confirmPvpaReward(): void {
  const [, setSelected] = useState(SelectedPvpaReward);
  playSound(PvpaSounds.SELECT);
  setSelected(-1);
}

export function pvpaRowTitle(index: Int): String {
  const base: String = PvpaTitles.at(index);
  const count: Int = PvpaCounts.at(index);
  if (count > 1) {
    return `${base} x${stringOf(count)}`;
  }
  return base;
}

export function pvpaTitleHeight(title: String, wrapWidth: Int): Int {
  return textLineCount(title, wrapWidth, PvpaFonts.TITLE) * PvpaLayout.TITLE_LINE + PvpaLayout.TITLE_PAD;
}

export function pvpaBodyHeight(body: String, wrapWidth: Int): Int {
  return textLineCount(body, wrapWidth, PvpaFonts.BODY) * PvpaLayout.BODY_LINE + PvpaLayout.BODY_PAD;
}
