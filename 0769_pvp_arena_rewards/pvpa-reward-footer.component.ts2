import { useServerState, useState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import {
  PestRewardsConfirm,
  PestRewardsConfirmDisabled,
  pressConfirm,
  releaseConfirm,
} from '../0645_br_reward_shop/pest-rewards.shared';
import { confirmPvpaReward } from './pvp-arena-rewards.state';
import {
  PvpaColor,
  PvpaFonts,
  PvpaFrame,
  PvpaTitles,
  PvpaVarps,
  SelectedPvpaReward,
} from './pvp-arena-rewards.constants';

export function PvpaPoints(): Component {
  const points: Int = useServerState(PvpaVarps.POINTS);

  return (
    <text
      x={0}
      y="center"
      w={PvpaFrame.POINTS_W}
      h="fill"
      text={`Points: <col=ffffff>${groupDigits(points, ',')}</col>`}
      font={PvpaFonts.TITLE}
      color={PvpaColor.PRICE_REST}
      shadow
      align="center"
      valign="middle"
    />
  );
}

export function PvpaConfirm(): Component {
  const [selected] = useState(SelectedPvpaReward);

  return (
    <layer x="right" y="center" w={{ fill: PvpaFrame.CONFIRM_W_INSET }} h="fill">
      <layer x="center" y="center" w="fill" h="fill">
        {selected !== -1 ? (
          <PestRewardsConfirm label={PvpaTitles.at(selected) ?? 'Reward'} />
        ) : (
          <PestRewardsConfirmDisabled />
        )}
      </layer>

      {selected !== -1 ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          options={['Confirm']}
          onMouseRepeat={() => pressConfirm()}
          onMouseLeave={() => releaseConfirm()}
          onOptionSelect={() => confirmPvpaReward()}
        />
      ) : null}
    </layer>
  );
}
