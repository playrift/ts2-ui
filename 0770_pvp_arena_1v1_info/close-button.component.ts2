import { graphicSwapper, onMobile, opsound } from '../lib/lib.helpers';
import { Copy, InfoSprites } from './pvp-arena-1v1-info.constants';

export function InfoCloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        right={1}
        y={1}
        w={33}
        h={33}
        sprite={InfoSprites.CLOSE_MOBILE}
        options={[{ label: Copy.CLOSE, hotkey: ESCAPE }]}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, InfoSprites.CLOSE_MOBILE);
        }}
        onOptionSelect={(event) => opsound(event.option, CLOSE_MASK)}
      />
    );
  }

  return (
    <sprite
      right={3}
      y={6}
      w={26}
      h={23}
      sprite={InfoSprites.CLOSE}
      hover={{ sprite: InfoSprites.CLOSE_HOVER }}
      options={[{ label: Copy.CLOSE, hotkey: ESCAPE }]}
      onOptionSelect={(event) => opsound(event.option, CLOSE_MASK)}
    />
  );
}

const ESCAPE = 13;
const CLOSE_MASK = 2;
