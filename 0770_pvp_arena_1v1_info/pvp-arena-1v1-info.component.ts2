            w="fill"
            h="fill"
            text=""
            font={InfoFonts.BODY}
            color={InfoColor.STATUS}
            align="center"
            valign="middle"
            shadow
          />
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer ref={preview} hide x={x} y={y} w={w} h={h}>
        <rect x="center" y="center" w="fill" h="fill" color={InfoColor.PREVIEW} transparency={100} />
        <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={InfoColor.PREVIEW} transparency={110} />
        <rect x="center" y="center" w={{ fill: 4 }} h={{ fill: 4 }} color={InfoColor.PREVIEW} transparency={120} />
        <rect x="center" y="center" w={{ fill: 6 }} h={{ fill: 6 }} color={InfoColor.PREVIEW} transparency={130} />
      </layer>

      <sprite
        x={handleX(0, x, w)}
        y={handleY(0, y, h)}
        w={handleW(0, w)}
        h={handleH(0, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
          event.self.sprite = -1;
          resizeDrag(
            0,
            event.mouseX - event.self.x,
            event.mouseY - event.self.y,
            top,
            availW,
            dodgerH,
            preview,
            content,
          );
          armResizeCommit(event.self);
        }}
      />
      <sprite
        x={handleX(1, x, w)}
        y={handleY(1, y, h)}
        w={handleW(1, w)}
        h={handleH(1, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
          event.self.sprite = -1;
          resizeDrag(
            1,
            event.mouseX - event.self.x,
            event.mouseY - event.self.y,
            top,
            availW,
            dodgerH,
            preview,
            content,
          );
          armResizeCommit(event.self);
        }}
      />
      <sprite
        x={handleX(2, x, w)}
        y={handleY(2, y, h)}
        w={handleW(2, w)}
        h={handleH(2, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
          event.self.sprite = -1;
          resizeDrag(
            2,
            event.mouseX - event.self.x,
            event.mouseY - event.self.y,
            top,
            availW,
            dodgerH,
            preview,
            content,
          );
          armResizeCommit(event.self);
        }}
      />
      <sprite
        x={handleX(3, x, w)}
        y={handleY(3, y, h)}
        w={handleW(3, w)}
        h={handleH(3, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
          event.self.sprite = -1;
          resizeDrag(
            3,
            event.mouseX - event.self.x,
            event.mouseY - event.self.y,
            top,
            availW,
            dodgerH,
            preview,
            content,
          );
          armResizeCommit(event.self);
        }}
      />
      <sprite
        x={handleX(4, x, w)}
        y={handleY(4, y, h)}
        w={handleW(4, w)}
        h={handleH(4, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
          event.self.sprite = -1;
          resizeDrag(
            4,
            event.mouseX - event.self.x,
            event.mouseY - event.self.y,
            top,
            availW,
            dodgerH,
            preview,
            content,
          );
          armResizeCommit(event.self);
        }}
      />
      <sprite
        x={handleX(5, x, w)}
        y={handleY(5, y, h)}
        w={handleW(5, w)}
        h={handleH(5, h)}
        sprite={InfoSprites.HANDLE}
        tiling
        transparency={Layout.handle.TRANSPARENT}
        draggable={dodger}
        dragDeadZone={Layout.handle.DEAD_ZONE}
        dragDeadTime={Layout.handle.DEAD_TIME}
        onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
        onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
        onDrag={(event) => {
