} from './pvp-arena-1v1-info.layout';
import { ScrollbarHorizontal } from './scrollbar-horizontal.component';

export function PvpArena1v1Info(): Component {
  const dodger = useRef();
  const content = useRef();
  const scrolling = useRef();
  const display = useRef();
  const preview = useRef();

  const universe = useUniverse();
  useOnResize(universe);

  const mobile = onMobile();
  const top: Int = mobile ? Layout.MOBILE_TOP : 0;
  const drop: Int = mobile ? 0 : dodgerDrop();

  const dodgerH: Int = universe.height - drop;
  const availW: Int = universe.width;
  const availH: Int = dodgerH - top;

  const rounds: Int = roundCount();
  const gap: Int = gapFor(rounds);
  const pitch: Int = Layout.bracket.CELL_W + gap;
  const gridW: Int = maxWidth(rounds) - Layout.bracket.PAD_W;
  const gridH: Int = maxHeight(rounds) - Layout.bracket.PAD_H;

  const w: Int = panelWidth(rounds, availW);
  const h: Int = panelHeight(rounds, availH);
  const x: Int = panelX(availW, rawWidth(), w);
  const y: Int = panelY(top, dodgerH, availH, rawHeight(), h);

  return (
    <layer ref={dodger} x="center" y={mobile ? 'center' : 'bottom'} w="fill" h={mobile ? 'fill' : { fill: drop }}>
      <layer ref={content} x={x} y={y} w={w} h={h}>
        <SteelBorder title={Copy.TITLE} titleColor={SteelborderColor.TITLE} flags={SteelFlags.INFO} noClickThrough />

        <InfoCloseButton />

        <layer
          x="center"
          y={{ bottom: Layout.scrollBox.y }}
          w={{ fill: Layout.scrollBox.insetW }}
          h={{ fill: Layout.scrollBox.insetH }}
