import { CS2, useRef } from 'ts2';

import { Layout } from './pvp-arena-1v1-info.constants';

export function ScrollbarHorizontal({
  content,
  track,
  capLeftSprite,
  thumbSprite,
  capRightSprite,
  arrowLeft,
  arrowRight,
  rebuilt = false,
}: {
  content: Ref;
  track: Sprite;
  capLeftSprite: Sprite;
  thumbSprite: Sprite;
  capRightSprite: Sprite;
  arrowLeft: Sprite;
  arrowRight: Sprite;
  rebuilt?: Boolean;
}): Component {
  const bar = useRef();
  const gutter = useRef();
  const thumb = useRef();
  const capLeft = useRef();
  const capRight = useRef();

  const scrollExtent: Int = content.scrollWidth;
  const extent: Int = scrollExtent > 0 ? scrollExtent : content.width;

  return (
    <layer ref={bar} w="fill" h="fill">
      <sprite
        ref={gutter}
        x="center"
        w={{ fill: Layout.ARROW * 2 }}
        h="fill"
        sprite={track}
        noClickThrough
        onScrollWheel={(event) => {
          content.scrollX = content.scrollX + event.mouseY * Layout.WHEEL_X;
          trackScrollX(gutter, thumb, capLeft, capRight, content);
        }}
        onClick={() => {
          CS2.cc_dragpickup(thumb.width / 2, 0);
        }}
      />
      <sprite
        ref={thumb}
        x={
          Layout.ARROW +
          ((gutter.width - thumbWidthOf(bar.width, content.width, extent, rebuilt)) * content.scrollX) /
            Math.max(1, content.scrollWidth - content.width)
        }
        y="center"
        h="fill"
        w={thumbWidthOf(bar.width, content.width, extent, rebuilt)}
        sprite={thumbSprite}
        noClickThrough
        draggable={gutter}
        dragMoves
        onDrag={(event) => {
          const offset: Int = event.mouseX;
          thumb.x = offset + Layout.ARROW;
          capLeft.x = offset + Layout.ARROW;
          capRight.x = offset + Layout.ARROW + thumb.width - Layout.CAP;

          const travel: Int = Math.max(1, gutter.width - thumb.width);
          const range: Int = content.scrollWidth - content.width;
          content.scrollX = (offset * range) / travel;
        }}
      />
      <sprite ref={capLeft} x={thumb.x} y="center" w={Layout.CAP} h="fill" sprite={capLeftSprite} />
      <sprite
        ref={capRight}
        x={thumb.x + thumb.width - Layout.CAP}
        y="center"
        w={Layout.CAP}
        h="fill"
        sprite={capRightSprite}
      />
      <sprite
        x="left"
        y="center"
        w={Layout.ARROW}
        h="fill"
        sprite={arrowLeft}
        noClickThrough
        onHold={() => {
          content.scrollX = content.scrollX - Layout.STEP_X;
          trackScrollX(gutter, thumb, capLeft, capRight, content);
        }}
      />
      <sprite
        x="right"
        y="center"
        w={Layout.ARROW}
        h="fill"
        sprite={arrowRight}
        noClickThrough
        onHold={() => {
          content.scrollX = content.scrollX + Layout.STEP_X;
          trackScrollX(gutter, thumb, capLeft, capRight, content);
        }}
      />
    </layer>
  );
}

function thumbWidthOf(barWidth: Int, contentWidth: Int, extent: Int, rebuilt: Boolean): Int {
  const raw: Int = Math.max(
    Layout.MIN_THUMB,
    extent > 0 ? ((barWidth - Layout.ARROW * 2) * contentWidth) / extent : barWidth - Layout.ARROW * 2,
  );
  if (rebuilt) {
    return Math.min(Math.max(Layout.MIN_THUMB, barWidth - Layout.ARROW * 2), raw);
  }
  return raw;
}

function trackScrollX(gutter: Ref, thumb: Ref, capLeft: Ref, capRight: Ref, content: Ref): void {
  const travel: Int = Math.max(1, gutter.width - thumb.width);
  const range: Int = Math.max(1, content.scrollWidth - content.width);
  const at: Int = Layout.ARROW + (travel * content.scrollX) / range;
  thumb.x = at;
  capLeft.x = at;
  capRight.x = at + thumb.width - Layout.CAP;
}
