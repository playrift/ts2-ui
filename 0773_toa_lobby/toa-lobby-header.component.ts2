import { useInterval, useRef, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { Layout, PartyStatus, ToaLobbyColor, ToaLobbyFonts } from './toa-lobby.constants';
import { toaHudNameFlasher, tobHudNameFlasher } from './toa-lobby.helpers';

export function ToaLobbyHeader(): Component {
  const timerHost = useRef();

  useInterval(() => toaHudNameFlasher(timerHost), timerHost);

  const status: Int = useServerState(Varbits.TOA_CLIENT_PARTYSTATUS);

  if (status === PartyStatus.READY) {
    return (
      <text
        x="center"
        y={Layout.HEADER_Y}
        w={{ fill: Layout.HEADER_INSET }}
        h={Layout.HEADER_H}
        text="Step Inside Now!"
        font={ToaLobbyFonts.HEADER}
        shadow
        align="center"
        valign="middle"
        color={tobHudNameFlasher()}
        ref={timerHost}
      />
    );
  }

  if (status === PartyStatus.NONE) {
    return (
      <text
        x="center"
        y={Layout.HEADER_Y}
        w={{ fill: Layout.HEADER_INSET }}
        h={Layout.HEADER_H}
        text="No Party"
        font={ToaLobbyFonts.HEADER}
        shadow
        align="center"
        valign="middle"
        color={ToaLobbyColor.LABEL}
      />
    );
  }

  return (
    <text
      x="center"
      y={Layout.HEADER_Y}
      w={{ fill: Layout.HEADER_INSET }}
      h={Layout.HEADER_H}
      text="Party"
      font={ToaLobbyFonts.HEADER}
      shadow
      align="center"
      valign="middle"
      color={ToaLobbyColor.LABEL}
    />
  );
}
