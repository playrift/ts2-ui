import { createRef } from 'ts2';

import { StonePanelEntrypoint } from '../0648_target_streaks/stone-panel-entrypoint.component';
import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ToaLobbyHeader } from './toa-lobby-header.component';
import { Layout, ToaLobbyColor, ToaLobbyDodge, ToaLobbyFonts, ToaLobbySprite } from './toa-lobby.constants';

const content = createRef('toa_lobby_content1');

export function ToaLobby(): Component {
  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      onTimer={(event) => overlayRelayout(event.component, content, ToaLobbyDodge.WORD, Anchor.LEFT, Anchor.TOP, 1)}
    >
      <layer static ref={content} x={Layout.CONTENT_X} y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <sprite
          x="center"
          y="center"
          w="fill"
          h="fill"
          sprite={ToaLobbySprite.BACKING}
          tiling
          transparency={Layout.BACKING_TRANSPARENCY}
        />

        <ToaLobbyHeader />

        <text
          x="center"
          y={{ bottom: Layout.NAMES_BOTTOM }}
          w={{ fill: Layout.NAMES_INSET }}
          h={{ fill: Layout.NAMES_H_INSET }}
          font={ToaLobbyFonts.NAMES}
          shadow
          align="center"
          valign="middle"
          color={ToaLobbyColor.LABEL}
          lineHeight={Layout.NAMES_LINE_H}
        />

        <StonePanelEntrypoint divider={Layout.DIVIDER} />
      </layer>
    </layer>
  );
}
