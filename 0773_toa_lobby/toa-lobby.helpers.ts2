import { CS2 } from 'ts2';

import { rgbToHex } from '../0259_area_task/area-task.helpers';
import { clientClock } from '../lib/lib.engine';
import { Flash } from './toa-lobby.constants';

export function tobHudNameFlasher(): Int {
  let phase: Int = clientClock() % Flash.PERIOD;
  if (phase > Flash.HALF) {
    phase = Flash.PERIOD - phase;
  }
  const level: Int = CS2.scale(
    CS2.invpow(phase * Flash.FULL, Flash.EASE),
    CS2.invpow(Flash.PEAK, Flash.EASE),
    Flash.FULL,
  );
  return rgbToHex(Flash.FULL, level, level);
}

export function toaHudNameFlasher(target: ComponentId): void {
  target.color = tobHudNameFlasher();
}
