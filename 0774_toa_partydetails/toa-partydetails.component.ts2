import { useOnResize, useUniverse } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { toaPanelHeight } from '../0772_toa_partylist/toa-partylist.helpers';
import {
  Color,
  Copy,
  Layout,
  ToaPartydetailsFonts,
  ToaPartydetailsScrollbar,
  ToaPartydetailsSprites,
  applicantsListRef,
  contentsRef,
  invocationsContentRef,
  membersListRef,
  summaryContentRef,
} from './toa-partydetails.constants';
import { resetToaPartyDetails } from './toa-partydetails.helpers';

export function ToaPartydetails(): Component {
  return (
    <layer
      ref={contentsRef}
      x="center"
      y="center"
      w={Layout.PANEL_W}
      h={Layout.PANEL_H}
      onLoad={() => resetToaPartyDetails()}
    >
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x={Layout.BACK_X} y={Layout.BACK_Y} w={Layout.BACK} h={Layout.BACK} hide />

      <layer x={Layout.TABS_X} y={Layout.TABS_Y} w={Layout.TABS_W} h={Layout.TABS_H}>
        <layer x={0} y={0} w={Layout.TAB_W} h="fill" hide />
        <layer x={Layout.TAB_1_X} y={0} w={Layout.TAB_W} h="fill" hide />
        <layer x={Layout.TAB_2_X} y={0} w={Layout.TAB_W} h="fill" hide />
        <layer x={Layout.TAB_3_X} y={0} w={Layout.TAB_W} h="fill" hide />
      </layer>

      <line
        x={Layout.BEVEL_LEFT_X}
        y={Layout.BEVEL_TOP_Y}
        w={Layout.BEVEL_LEFT_W}
        color={Color.BEVEL_DARK}
        lineWidth={Layout.HAIRLINE}
      />
      <line
        x={Layout.BEVEL_LEFT_X}
        y={Layout.BEVEL_BOTTOM_Y}
        w={Layout.BEVEL_LEFT_W}
        color={Color.BEVEL_LIGHT}
        lineWidth={Layout.HAIRLINE}
      />
      <line
        x={{ right: Layout.BEVEL_RIGHT_X }}
        y={Layout.BEVEL_TOP_Y}
        w={Layout.BEVEL_RIGHT_W}
        color={Color.BEVEL_DARK}
        lineWidth={Layout.HAIRLINE}
      />
      <line
        x={{ right: Layout.BEVEL_RIGHT_X }}
        y={Layout.BEVEL_BOTTOM_Y}
        w={Layout.BEVEL_RIGHT_W}
        color={Color.BEVEL_LIGHT}
        lineWidth={Layout.HAIRLINE}
      />

      <line
        x={Layout.FOOTER_X}
        y={{ bottom: Layout.FOOTER_TOP_Y }}
        w={Layout.FOOTER_W}
        color={Color.BEVEL_DARK}
        lineWidth={Layout.HAIRLINE}
      />
      <line
        x={Layout.FOOTER_X}
        y={{ bottom: Layout.FOOTER_BOTTOM_Y }}
        w={Layout.FOOTER_W}
        color={Color.BEVEL_LIGHT}
        lineWidth={Layout.HAIRLINE}
      />

      <layer x="center" y={Layout.MAIN_Y} w={{ fill: Layout.MAIN_W_INSET }} h={{ fill: Layout.MAIN_H_INSET }}>
        <ToaMembersPage />
        <ToaApplicantsPage />
        <ToaInvocationsPage />
        <ToaSummaryPage />

        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={Copy.LOADING}
          font={ToaPartydetailsFonts.BODY}
          color={Color.LOADING}
          align="center"
          valign="middle"
          shadow
        />
      </layer>

      <ToaInvocationsSidepanel />
      <ToaFooterBar />

      <layer x={0} y={0} w="fill" h="fill" />
    </layer>
  );
}

function ToaMembersPage(): Component {
  return (
    <layer x="center" y="center" w="fill" h={{ fill: Layout.PAGE_INSET }} hide>
      <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />

      <layer x="center" y={0} w="fill" h={Layout.HEADER_H} hide>
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={Color.WASH}
          fill
          transparency={Layout.HEADER_WASH_OPACITY}
        />
        <HeaderColumn x={Layout.M_NAME_X} w={Layout.M_NAME_W} />
        <HeaderColumn x={Layout.M_LEVEL_X} w={Layout.M_LEVEL_W} />
        <HeaderColumn x={Layout.M_ATTACK_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_STRENGTH_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_RANGED_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_MAGIC_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_DEFENCE_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_HITPOINTS_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_PRAYER_X} w={Layout.M_STAT_W} />
        <HeaderColumn x={Layout.M_COMPLETIONS_X} w={Layout.M_COMPLETIONS_W} />
        <ThinBoxEntrypoint />
      </layer>

      <layer x="center" y="bottom" w="fill" h={{ fill: Layout.LIST_BOX_H_INSET }}>
        <layer ref={membersListRef} x="center" y="center" w={Layout.MEMBERS_LIST_W} h={{ fill: Layout.LIST_INSET }} />
        <ThinBoxEntrypoint />
      </layer>
    </layer>
  );
}

function ToaApplicantsPage(): Component {
  return (
    <layer x="center" y="center" w="fill" h={{ fill: Layout.PAGE_INSET }} hide>
      <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />

      <layer x="center" y={0} w="fill" h={Layout.HEADER_H} hide>
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          color={Color.WASH}
          fill
          transparency={Layout.HEADER_WASH_OPACITY}
        />
        <HeaderColumn x={Layout.A_NAME_X} w={Layout.A_NAME_W} />
        <HeaderColumn x={Layout.A_LEVEL_X} w={Layout.A_LEVEL_W} />
        <HeaderColumn x={Layout.A_ATTACK_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_STRENGTH_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_RANGED_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_MAGIC_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_DEFENCE_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_HITPOINTS_X} w={Layout.A_STAT_W} />
        <HeaderColumn x={Layout.A_PRAYER_X} w={Layout.A_STAT_W} />
        <layer
          x={{ right: Layout.A_COMPLETIONS_RIGHT }}
          y="center"
          w={{ fill: Layout.A_COMPLETIONS_W_INSET }}
          h={{ fill: Layout.COLUMN_H_INSET }}
        />
        <ThinBoxEntrypoint />
      </layer>

      <layer x="center" y="bottom" w="fill" h={{ fill: Layout.LIST_BOX_H_INSET }}>
        <layer
          ref={applicantsListRef}
          x="center"
          y="center"
          w={{ fill: Layout.LIST_INSET }}
          h={{ fill: Layout.LIST_INSET }}
        />
        <ThinBoxEntrypoint />
      </layer>
    </layer>
  );
}

function HeaderColumn({ x, w }: { x: Int; w: Int }): Component {
  return <layer x={x} y="center" w={w} h={{ fill: Layout.COLUMN_H_INSET }} />;
}

function ToaInvocationsPage(): Component {
  return (
    <layer x={0} y="center" w={Layout.INVOCATIONS_W} h={Layout.INVOCATIONS_H} hide>
      <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />
      <layer
        ref={invocationsContentRef}
        x={Layout.PANE_X}
        y="center"
        w={{ fill: Layout.PANE_W_INSET }}
        h={{ fill: Layout.LIST_INSET }}
      />
      <layer x={{ right: Layout.SCROLLBAR_RIGHT }} y="center" w={Layout.SCROLLBAR_W} h={{ fill: Layout.LIST_INSET }}>
        <ScrollbarVertical
          content={invocationsContentRef}
          track={ToaPartydetailsScrollbar.TRACK}
          capTopSprite={ToaPartydetailsScrollbar.CAP_TOP}
          thumbSprite={ToaPartydetailsScrollbar.THUMB}
          capBottomSprite={ToaPartydetailsScrollbar.CAP_BOTTOM}
          arrowUp={ToaPartydetailsScrollbar.ARROW_UP}
          arrowDown={ToaPartydetailsScrollbar.ARROW_DOWN}
          rebuilt
        />
      </layer>
      <ThinBoxEntrypoint />
    </layer>
  );
}

function ToaSummaryPage(): Component {
  return (
    <layer x="center" y="center" w="fill" h={{ fill: Layout.PAGE_INSET }} hide>
      <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />
      <layer
        ref={summaryContentRef}
        x={Layout.PANE_X}
        y="center"
        w={{ fill: Layout.PANE_W_INSET }}
        h={{ fill: Layout.LIST_INSET }}
      />
      <layer x={{ right: Layout.SCROLLBAR_RIGHT }} y="center" w={Layout.SCROLLBAR_W} h={{ fill: Layout.LIST_INSET }}>
        <ScrollbarVertical
          content={summaryContentRef}
          track={ToaPartydetailsScrollbar.TRACK}
          capTopSprite={ToaPartydetailsScrollbar.CAP_TOP}
          thumbSprite={ToaPartydetailsScrollbar.THUMB}
          capBottomSprite={ToaPartydetailsScrollbar.CAP_BOTTOM}
          arrowUp={ToaPartydetailsScrollbar.ARROW_UP}
          arrowDown={ToaPartydetailsScrollbar.ARROW_DOWN}
          rebuilt
        />
      </layer>
      <ThinBoxEntrypoint />
    </layer>
  );
}

function ToaInvocationsSidepanel(): Component {
  return (
    <layer
      x={{ right: Layout.SIDEPANEL_RIGHT }}
      y={Layout.SIDEPANEL_Y}
      w={Layout.SIDEPANEL_W}
      h={{ fill: Layout.SIDEPANEL_H_INSET }}
    >
      <layer x="center" y={0} w={{ fill: Layout.SIDE_INSET }} h={Layout.SIDE_HEADER_H}>
        <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.PLATE_INSET }}
          h={{ fill: Layout.PLATE_INSET }}
          color={Color.PLATE}
          fill
          transparency={Layout.WASH_OPACITY}
        />
        <sprite
          x={Layout.ICON_X}
          y={Layout.ICON_Y}
          w={Layout.ICON_W}
          h={Layout.ICON_H}
          sprite={ToaPartydetailsSprites.ICON_INVOCATIONS}
        />
        <text
          x={Layout.COUNTER_X}
          y={Layout.COUNTER_Y}
          w={Layout.COUNTER_LEFT_W}
          h={Layout.COUNTER_H}
          text={Copy.INVOCATION_TOTAL}
          font={ToaPartydetailsFonts.COUNTER}
          color={Color.COUNTER}
          align="center"
          valign="middle"
          shadow
        />
        <sprite
          x={{ right: Layout.ICON_X }}
          y={Layout.ICON_Y}
          w={Layout.ICON_W}
          h={Layout.ICON_H}
          sprite={ToaPartydetailsSprites.ICON_ACTIVE}
        />
        <text
          x={{ right: Layout.COUNTER_X }}
          y={Layout.COUNTER_Y}
          w={Layout.COUNTER_RIGHT_W}
          h={Layout.COUNTER_H}
          text={Copy.INVOCATION_ACTIVE}
          font={ToaPartydetailsFonts.COUNTER}
          color={Color.COUNTER}
          align="center"
          valign="middle"
          shadow
        />
        <sprite
          x="center"
          y={Layout.DIFFICULTY_Y}
          w={Layout.DIFFICULTY}
          h={Layout.DIFFICULTY}
          sprite={ToaPartydetailsSprites.DIFFICULTY}
        />
        <sprite
          x={{ right: Layout.INFO_X }}
          y={Layout.INFO_Y}
          w={Layout.INFO}
          h={Layout.INFO}
          sprite={ToaPartydetailsSprites.INFO}
        />
        <layer
          x={Layout.LEVEL_BAR_X}
          y={Layout.LEVEL_BAR_Y}
          w={{ fill: Layout.LEVEL_BAR_W_INSET }}
          h={Layout.LEVEL_BAR_H}
          options={['*']}
          optionSubject="*"
        />
        <layer
          x={Layout.LEVEL_INFO_X}
          y={Layout.LEVEL_INFO_Y}
          w={{ fill: Layout.LEVEL_INFO_W_INSET }}
          h={Layout.LEVEL_INFO_H}
          options={['*']}
        />
        <ThinBoxEntrypoint />
      </layer>

      <layer x="center" y={Layout.LOOT_Y} w={{ fill: Layout.SIDE_INSET }} h={Layout.LOOT_H} hide>
        <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.PLATE_INSET }}
          h={{ fill: Layout.PLATE_INSET }}
          color={Color.PLATE}
          fill
          transparency={Layout.WASH_OPACITY}
        />
        <layer x="center" y="center" w={{ fill: Layout.PLATE_INSET }} h={{ fill: Layout.PLATE_INSET }} />
        <ThinBoxEntrypoint />
      </layer>

      <layer x="center" y="bottom" w={{ fill: Layout.SIDE_INSET }} h={{ fill: Layout.PRESETS_H_INSET }} hide>
        <layer x={0} y={0} w={Layout.PRESETS_INNER_W} h={Layout.PRESETS_INNER_H}>
          <rect x="center" y="center" w="fill" h="fill" color={Color.WASH} fill transparency={Layout.WASH_OPACITY} />
          <rect
            x="center"
            y="center"
            w={{ fill: Layout.PLATE_INSET }}
            h={{ fill: Layout.PLATE_INSET }}
            color={Color.PLATE}
            fill
            transparency={Layout.WASH_OPACITY}
          />
          <layer
            x={Layout.PRESETS_BUTTONS_X}
            y="center"
            w={{ fill: Layout.PRESETS_BUTTONS_W_INSET }}
            h={{ fill: Layout.LIST_INSET }}
          >
            <layer x={0} y={0} w="fill" h="fill" />
            <layer x={0} y={0} w="fill" h="fill" />
            <layer x={0} y={0} w="fill" h="fill" />
            <layer x={0} y={0} w="fill" h="fill" />
            <layer x={0} y={0} w="fill" h="fill" />
          </layer>
          <layer
            x={{ right: Layout.SCROLLBAR_RIGHT }}
            y="center"
            w={Layout.SCROLLBAR_W}
            h={{ fill: Layout.LIST_INSET }}
            contentType={Layout.PRESETS_SCROLLBAR_CONTENT_TYPE}
          />
          <ThinBoxEntrypoint />
        </layer>

        <layer
          x={{ center: -Layout.PRESET_BUTTON_OFFSET }}
          y={{ bottom: Layout.PRESET_BUTTON_BOTTOM }}
          w={Layout.PRESET_BUTTON_W}
          h={Layout.PRESET_BUTTON_H}
        />
        <layer
          x={{ center: Layout.PRESET_BUTTON_OFFSET }}
          y={{ bottom: Layout.PRESET_BUTTON_BOTTOM }}
          w={Layout.PRESET_BUTTON_W}
          h={Layout.PRESET_BUTTON_H}
        />
      </layer>
    </layer>
  );
}

function ToaFooterBar(): Component {
  return (
    <layer x="center" y={{ bottom: Layout.BOTTOM_Y }} w={{ fill: Layout.BOTTOM_W_INSET }} h={Layout.BOTTOM_H}>
      <FooterButtonSlot />
      <FooterButtonSlot />
      <FooterButtonSlot />
      <FooterButtonSlot />
      <FooterButtonSlot />
      <FooterButtonSlot />

      <layer
        x={{ right: Layout.COMPLETIONS_RIGHT }}
        y={Layout.BUTTON_Y}
        w={Layout.COMPLETIONS_W}
        h={Layout.COMPLETIONS_H}
        hide
      >
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.PLATE_FILL_INSET }}
          h={Layout.COMPLETIONS_H}
          sprite={ToaPartydetailsSprites.PLATE_FILL}
          tiling
        />
        <sprite
          x={0}
          y="center"
          w={Layout.PLATE_CAP_W}
          h={Layout.COMPLETIONS_H}
          sprite={ToaPartydetailsSprites.PLATE_LEFT}
        />
        <sprite
          x="right"
          y="center"
          w={Layout.PLATE_CAP_W}
          h={Layout.COMPLETIONS_H}
          sprite={ToaPartydetailsSprites.PLATE_RIGHT}
        />
      </layer>

      <text
        x={{ right: Layout.FOOTER_LABEL_RIGHT }}
        y="bottom"
        w={Layout.FOOTER_LABEL_W}
        h={Layout.FOOTER_LABEL_H}
        text={Copy.RAID_LEVEL}
        font={ToaPartydetailsFonts.BODY}
        color={Color.LABEL}
        align="center"
        valign="middle"
        shadow
      />
      <text
        x={{ right: Layout.FOOTER_LABEL_RIGHT }}
        y={0}
        w={Layout.FOOTER_LABEL_W}
        h={Layout.FOOTER_LABEL_H}
        text={Copy.RAID_MODE}
        font={ToaPartydetailsFonts.BODY}
        color={Color.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}

function FooterButtonSlot(): Component {
  return <layer x={0} y={Layout.BUTTON_Y} w={Layout.BUTTON_W} h={Layout.BUTTON_H} hide />;
}

export function ToaPanelResizer(): Component {
  const slot = useUniverse();
  useOnResize(slot);

  contentsRef.height = toaPanelHeight(slot.height);

  return <layer w={Layout.PIN} h={Layout.PIN} />;
}
