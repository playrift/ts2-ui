import { useRef } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { Layout, TabSprite, ToaScoreboardColor, ToaScoreboardFonts } from './toa-scoreboard.constants';
import { toaSelectedTab } from './toa-scoreboard.helpers';

export function ToaScoreboardTab({ label, tab }: { label: String; tab: Int }): Component {
  const selected: Int = toaSelectedTab() === tab ? 1 : 0;

  let hoverable: Int = 0;
  if (selected === 0) {
    if (!onMobile()) {
      hoverable = 1;
    }
  }

  if (hoverable === 0) {
    return (
      <layer w="fill" h="fill">
        <sprite
          x={0}
          y={0}
          w={Layout.TAB_CAP_W}
          h={Layout.TAB_FACE_H}
          sprite={selected === 1 ? TabSprite.SELECTED_CAP : TabSprite.REST_CAP}
        />
        <sprite
          x={Layout.TAB_CAP_W}
          y={0}
          w={{ fill: Layout.TAB_MID_INSET }}
          h={Layout.TAB_FACE_H}
          sprite={selected === 1 ? TabSprite.SELECTED_MID : TabSprite.REST_MID}
          tiling
        />
        <sprite
          x="right"
          y={0}
          w={Layout.TAB_CAP_W}
          h={Layout.TAB_FACE_H}
          sprite={selected === 1 ? TabSprite.SELECTED_CAP : TabSprite.REST_CAP}
          hflip
        />
        <text
          x="center"
          y={Layout.TAB_TEXT_Y}
          w="fill"
          h={Layout.TAB_TEXT_H}
          text={label}
          font={ToaScoreboardFonts.VALUE}
          shadow
          align="center"
          valign="middle"
          color={selected === 1 ? ToaScoreboardColor.TAB_SELECTED : ToaScoreboardColor.LABEL}
        />
      </layer>
    );
  }

  const capLeft = useRef();
  const middle = useRef();
  const capRight = useRef();
  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => swapToaTabFace(capLeft, middle, capRight, TabSprite.HOVER_CAP, TabSprite.HOVER_MID)}
      onMouseLeave={() => swapToaTabFace(capLeft, middle, capRight, TabSprite.REST_CAP, TabSprite.REST_MID)}
    >
      <sprite ref={capLeft} x={0} y={0} w={Layout.TAB_CAP_W} h={Layout.TAB_FACE_H} sprite={TabSprite.REST_CAP} />
      <sprite
        ref={middle}
        x={Layout.TAB_CAP_W}
        y={0}
        w={{ fill: Layout.TAB_MID_INSET }}
        h={Layout.TAB_FACE_H}
        sprite={TabSprite.REST_MID}
        tiling
      />
      <sprite
        ref={capRight}
        x="right"
        y={0}
        w={Layout.TAB_CAP_W}
        h={Layout.TAB_FACE_H}
        sprite={TabSprite.REST_CAP}
        hflip
      />
      <text
        x="center"
        y={Layout.TAB_TEXT_Y}
        w="fill"
        h={Layout.TAB_TEXT_H}
        text={label}
        font={ToaScoreboardFonts.VALUE}
        shadow
        align="center"
        valign="middle"
        color={ToaScoreboardColor.LABEL}
      />
    </layer>
  );
}

export function swapToaTabFace(capLeft: Ref, middle: Ref, capRight: Ref, cap: Sprite, mid: Sprite): void {
  capLeft.sprite = cap;
  middle.sprite = mid;
  capRight.sprite = cap;
}
