import { useRef } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ToaScoreboardTab } from './scoreboard-tab.component';
import { Layout, ToaScoreboardColor, ToaScoreboardFonts, ToaScrollbar, ToaTab } from './toa-scoreboard.constants';
import { selectToaTab } from './toa-scoreboard.helpers';

export function ToaScoreboard(): Component {
  return (
    <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <layer x={Layout.PANEL_X} y={Layout.PANEL_Y} w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <SteelBorderEntrypoint title="Tombs of Amascut Statistics" />

        <layer x={Layout.TABS_X} y={Layout.TABS_Y} w={Layout.TABS_W} h={Layout.TABS_H}>
          <layer
            x={0}
            y={0}
            w={Layout.TAB_W}
            h="fill"
            options={['View']}
            onOptionSelect={() => selectToaTab(ToaTab.STORY)}
          >
            <ToaScoreboardTab label="Entry" tab={ToaTab.STORY} />
          </layer>
          <layer
            x={Layout.TAB_2_X}
            y={0}
            w={Layout.TAB_W}
            h="fill"
            options={['View']}
            onOptionSelect={() => selectToaTab(ToaTab.NORMAL)}
          >
            <ToaScoreboardTab label="Normal" tab={ToaTab.NORMAL} />
          </layer>
          <layer
            x={Layout.TAB_3_X}
            y={0}
            w={Layout.TAB_W}
            h="fill"
            options={['View']}
            onOptionSelect={() => selectToaTab(ToaTab.EXPERT)}
          >
            <ToaScoreboardTab label="Expert" tab={ToaTab.EXPERT} />
          </layer>
        </layer>

        <line x={6} y={{ bottom: 246 }} w={7} h={0} color={ToaScoreboardColor.TAB_RULE_DARK} lineWidth={1} />
        <line x={6} y={{ bottom: 245 }} w={7} h={0} color={ToaScoreboardColor.TAB_RULE_LIGHT} lineWidth={1} />
        <line
          x={{ right: 7 }}
          y={{ bottom: 246 }}
          w={175}
          h={0}
          color={ToaScoreboardColor.TAB_RULE_DARK}
          lineWidth={1}
        />
        <line
          x={{ right: 7 }}
          y={{ bottom: 245 }}
          w={175}
          h={0}
          color={ToaScoreboardColor.TAB_RULE_LIGHT}
          lineWidth={1}
        />

        <layer x="center" y={Layout.BOX_Y} w={{ fill: Layout.BOX_INSET }} h={Layout.BOX_H}>
          <ScoreboardDetailsPane />

          <ThinBoxEntrypoint />
        </layer>
      </layer>
    </layer>
  );
}

