import { predictServerState, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { ToaTab } from './toa-scoreboard.constants';

export function toaSelectedTab(): Int {
  const tab: Int = useServerState(Varbits.TOA_SCOREBOARD_TAB);
  if (tab === ToaTab.STORY) {
    return ToaTab.STORY;
  }
  if (tab === ToaTab.EXPERT) {
    return ToaTab.EXPERT;
  }
  return ToaTab.NORMAL;
}

export function selectToaTab(tab: Int): void {
  predictServerState(Varbits.TOA_SCOREBOARD_TAB, tab);
}
