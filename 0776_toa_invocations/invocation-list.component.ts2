import { useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { InvocationRow } from './invocation-row.component';
import { eventInvocationsVisible } from './toa-invocations.helpers';
import { InvocationParams, Invocations, RowLayout, ScrollbarSprites as Bar } from './toa-invocations.constants';

const EVENT_CATEGORY = 15;

const INVOCATION_COUNT = 46;

export function InvocationList(): Component {
  const content = useRef();
  const showEvent: Boolean = eventInvocationsVisible();

  let extent: Int = 0;
  let i: Int = 0;
  while (i < INVOCATION_COUNT) {
    if (Invocations.at(i).int(InvocationParams.CATEGORY) !== EVENT_CATEGORY || showEvent) {
      extent = (i + 1) * RowLayout.HEIGHT;
    }
    i = i + 1;
  }

  return (
    <>
      <layer ref={content} x={2} y="center" w={{ fill: 20 }} h={{ fill: 4 }} scrollHeight={extent}>
        {Invocations.map((row, index) =>
          row.int(InvocationParams.CATEGORY) !== EVENT_CATEGORY || showEvent ? (
            <InvocationRow row={row} index={index} />
          ) : null,
        )}
      </layer>

      <layer x={{ right: 2 }} y="center" w={16} h={{ fill: 4 }}>
        <ScrollbarVertical
          content={content}
          track={Bar.TRACK}
          capTopSprite={Bar.CAP_TOP}
          thumbSprite={Bar.THUMB}
          capBottomSprite={Bar.CAP_BOTTOM}
          arrowUp={Bar.ARROW_UP}
          arrowDown={Bar.ARROW_DOWN}
        />
      </layer>
    </>
  );
}
