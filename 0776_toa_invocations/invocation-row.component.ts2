import { InvocationColor, InvocationFonts, RowLayout, RowTransparency } from './toa-invocations.constants';
import type { Invocation } from './invocations.data';

export function InvocationRow({ row, index }: { row: Invocation; index: Int }): Component {
  const top: Int = index * RowLayout.HEIGHT;
  const raidLevel: Int = row.raidLevel;
  const description: String = row.description;

  const body: String =
    raidLevel < 0
      ? `${description}<br><br>Decreases Raid Level by ${0 - raidLevel}.`
      : raidLevel > 0
        ? `${description}<br><br>Increases Raid Level by ${raidLevel}.`
        : description;

  return (
    <>
      <rect
        x={0}
        y={top}
        w="fill"
        h={RowLayout.HEIGHT}
        color={InvocationColor.ROW}
        fill
        transparency={index % 2 === 0 ? RowTransparency.EVEN : RowTransparency.ODD}
      />

      <line x={RowLayout.DIVIDER_X} y={top} w={0} h={RowLayout.HEIGHT} color={InvocationColor.DIVIDER} />

      <sprite
        x={RowLayout.ICON_X}
        y={top + RowLayout.ICON_Y}
        w={RowLayout.ICON}
        h={RowLayout.ICON}
        sprite={row.icon}
        transparency={RowTransparency.ICON}
      />

      <text
        x={RowLayout.NAME_X}
        y={top + RowLayout.NAME_DY + RowLayout.ICON_Y}
        w={RowLayout.NAME_W}
        h={RowLayout.NAME_H}
        text={row.name}
        font={InvocationFonts.ROW}
        color={InvocationColor.TEXT}
        align="center"
        valign="middle"
        shadow
      />

      <text
        x={RowLayout.BODY_X}
        y={top + RowLayout.BODY_DY}
        w={{ fill: RowLayout.BODY_INSET }}
        h={RowLayout.BODY_H}
        text={body}
        font={InvocationFonts.ROW}
        color={InvocationColor.TEXT}
        align="left"
        valign="top"
        shadow
      />
    </>
  );
}
