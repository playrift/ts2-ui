import { useServerState } from 'ts2';
import { hasBit } from '../lib/lib.engine';
import { InvocationVarps } from './toa-invocations.constants';

export function leagueWorld(): Boolean {
  const flags: Int = useServerState(InvocationVarps.MAP_FLAGS);
  if (hasBit(flags, 29)) {
    return false;
  }
  return hasBit(flags, 30);
}

export function eventInvocationsUnlocked(): Boolean {
  return hasBit(useServerState(InvocationVarps.MAP_FLAGS), 11);
}

export function eventInvocationsVisible(): Boolean {
  if (leagueWorld()) {
    return true;
  }
  return eventInvocationsUnlocked();
}
