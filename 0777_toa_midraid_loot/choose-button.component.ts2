import { useState } from 'ts2';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { BundleColor, BundleFonts, CHOOSE_LABEL } from './toa-midraid-loot.constants';

export function ChooseButton(): Component {
  const [pressed, setPressed] = useState(0);

  if (onMobile()) {
    return (
      <layer x="center" y={{ bottom: 7 }} w={130} h={28} options={[CHOOSE_LABEL]}>
        <StoneButtonOutFilled />
        <text
          w="fill"
          h="fill"
          text={CHOOSE_LABEL}
          font={BundleFonts.BUTTON}
          color={BundleColor.TEXT}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    );
  }

  return (
    <layer
      x="center"
      y={{ bottom: 7 }}
      w={130}
      h={28}
      options={[CHOOSE_LABEL]}
      onMouseRepeat={() => setPressed(1)}
      onMouseLeave={() => setPressed(0)}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y={pressed === 1 ? { center: 1 } : 'center'}
        w="fill"
        h="fill"
        text={CHOOSE_LABEL}
        font={BundleFonts.BUTTON}
        color={BundleColor.TEXT}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
