import { intArray, useInventory, useRef } from 'ts2';
import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { BundleColor, FADE_CYCLES, SlotLayout, SupplyBundles, Transparency } from './toa-midraid-loot.constants';

const BUNDLE_SIZE = 7;

function BundleSlot({ item, count, index }: { item: Item; count: Int; index: Int }): Component {
  const cell = useRef();

  return (
    <sprite
      ref={cell}
      x={SlotLayout.FIRST_X + (index % SlotLayout.COLUMNS) * SlotLayout.STRIDE_X}
      y={SlotLayout.FIRST_Y + (index / SlotLayout.COLUMNS) * SlotLayout.STRIDE_Y}
      w={SlotLayout.W}
      h={SlotLayout.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={BundleColor.SLOT_SHADOW}
      options={['Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={() => {
        flashFor(cell, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}

export function LifeBundleGrid(): Component {
  const items = useInventory(SupplyBundles.LIFE);

  const place = intArray(BUNDLE_SIZE);
  let seen: Int = 0;
  let slot: Int = 0;
  while (slot < BUNDLE_SIZE) {
    place[slot] = seen;
    if (items[slot] !== -1) {
      seen = seen + 1;
    }
    slot = slot + 1;
  }

  return (
    <layer w="fill" h="fill">
      {items.map(
        (item, index) => item !== -1 && <BundleSlot item={item} count={items.total(item)} index={place[index]} />,
      )}
    </layer>
  );
}

