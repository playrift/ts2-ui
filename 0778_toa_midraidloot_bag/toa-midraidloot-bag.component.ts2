import { closeInterface } from '../lib/lib.helpers';
import { RaidSuppliesGrid } from './raid-supplies-grid.component';
import { BAG_TITLE, BagArt, BagColor, BagFonts, BoxInset } from './toa-midraidloot-bag.constants';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';

export function ToaMidraidlootBag(): Component {
  return (
    <>
      <text
        x={0}
        y={0}
        w="fill"
        h={22}
        text={BAG_TITLE}
        font={BagFonts.TITLE}
        color={BagColor.TITLE}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        x={{ right: 3 }}
        y={3}
        w={16}
        h={16}
        sprite={BagArt.CLOSE}
        hover={{ sprite: BagArt.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />

      <layer x={9} y={22} w={172} h={228}>
        <sprite
          x="center"
          y="center"
          w={{ fill: BoxInset.BACKING }}
          h={{ fill: BoxInset.BACKING }}
          sprite={BagArt.BACKING}
          tiling
        />

        <layer x="center" y="center" w={{ fill: BoxInset.GRID }} h={{ fill: BoxInset.GRID }}>
          <RaidSuppliesGrid />
        </layer>

        <ThinStoneBoxEntrypoint />
      </layer>
    </>
  );
}
