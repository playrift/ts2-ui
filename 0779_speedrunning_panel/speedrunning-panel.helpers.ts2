export function questIndex(quest: Int): Int {
  if (quest < 0) {
    return -1;
  }
  const count: Int = SpeedrunQuests.length;
  let index: Int = 0;
  let found: Int = -1;
  let hit: Boolean = false;
  while (index < count) {
    const row = SpeedrunQuests.at(index);
    hit = false;
    if (row !== null) {
      if (row.quest === quest) {
        found = index;
        index = count;
        hit = true;
      }
    }
    if (!hit) {
      index = index + 1;
    }
  }
  return found;
}

export function speedrunQuestName(quest: Int): String {
  const index: Int = questIndex(quest);
  if (index < 0) {
    return '';
  }
  const row = SpeedrunQuests.at(index);
  if (row === null) {
    return '';
  }
  return row.displayname;
}

export function speedrunQuestId(quest: Int): Int {
  const index: Int = questIndex(quest);
  if (index < 0) {
    return -1;
  }
  const row = SpeedrunQuests.at(index);
  if (row === null) {
    return -1;
  }
  return row.id;
}

export function speedrunIndex(quest: Int): Int {
  if (quest < 0) {
    return -1;
  }
  const count: Int = Speedruns.length;
  let index: Int = 0;
  let found: Int = -1;
  let hit: Boolean = false;
  while (index < count) {
    const row = Speedruns.at(index);
    hit = false;
    if (row !== null) {
      if (row.quest === quest) {
        found = index;
        index = count;
        hit = true;
      }
    }
    if (!hit) {
      index = index + 1;
    }
  }
  return found;
}

export function speedrunBeta(quest: Int): Boolean {
  const index: Int = speedrunIndex(quest);
  if (index < 0) {
    return false;
  }
  const row = Speedruns.at(index);
  if (row === null) {
    return false;
  }
  return row.speedrunState === 2 || row.speedrunState === 3;
}

export function speedrunTitle(quest: Int): String {
  if (speedrunBeta(quest)) {
    return `${speedrunQuestName(quest)} (Beta)`;
  }
  return speedrunQuestName(quest);
}

