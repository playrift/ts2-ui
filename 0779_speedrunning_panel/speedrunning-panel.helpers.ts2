      return useServerState(QuestTrophyVarbits.ERNEST_THE_CHICKEN);
    }
    case Quest.KINGDOM_DIVIDED_A: {
      return useServerState(QuestTrophyVarbits.KINGDOM_DIVIDED);
    }
    case Quest.KNIGHT_S_SWORD_THE: {
      return useServerState(QuestTrophyVarbits.KNIGHTS_SWORD);
    }
    case Quest.PRINCE_ALI_RESCUE: {
      return useServerState(QuestTrophyVarbits.PRINCE_ALI_RESCUE);
    }
    case Quest.SINS_OF_THE_FATHER: {
      return useServerState(QuestTrophyVarbits.SINS_OF_THE_FATHER);
    }
    case Quest.SONG_OF_THE_ELVES: {
      return useServerState(QuestTrophyVarbits.SONG_OF_THE_ELVES);
    }
    case Quest.TASTE_OF_HOPE_A: {
