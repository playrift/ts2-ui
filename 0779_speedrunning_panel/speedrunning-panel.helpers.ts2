export function trophyTime(quest: Int, trophy: Int): Int {
  const index: Int = speedrunIndex(quest);
  if (index < 0) {
    return 0;
  }
  const count: Int = SpeedrunsSpeedrunTrophyTimes.length;
  let i: Int = 0;
  let time: Int = 0;
  let hit: Boolean = false;
  while (i < count) {
    const row = SpeedrunsSpeedrunTrophyTimes.at(i);
    hit = false;
    if (row !== null) {
      if (row.row === index && row.trophy === trophy) {
        time = row.time;
        i = count;
        hit = true;
      }
    }
    if (!hit) {
      i = i + 1;
    }
  }
  return time;
}

