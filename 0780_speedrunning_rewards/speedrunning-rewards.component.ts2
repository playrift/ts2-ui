import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ConfirmSheet } from './reward-confirm.component';
import { RewardConfirm, RewardPoints } from './reward-footer.component';
import { RewardPane } from './reward-pane.component';
import { RewardArt, RewardFrame } from './speedrunning-rewards.constants';

export function SpeedrunningRewards(): Component {
  return (
    <layer x="center" y="center" w={RewardFrame.WINDOW_W} h={RewardFrame.WINDOW_H}>
      <SteelBorderEntrypoint title="Speedrunning Reward Shop" />

      <layer w={RewardFrame.WINDOW_W} h={RewardFrame.WINDOW_H}>
        <layer
          x="center"
          y={{ bottom: RewardFrame.BODY_BOTTOM }}
          w={{ fill: RewardFrame.BODY_W_INSET }}
          h={{ fill: RewardFrame.BODY_H_INSET }}
        >
          <layer
            x="center"
            y={RewardFrame.BOX_Y}
            w={{ fill: RewardFrame.BOX_W_INSET }}
            h={{ fill: RewardFrame.BOX_H_INSET }}
          >
            <sprite
              x={RewardFrame.BACKING_X}
              y={RewardFrame.BACKING_X}
              w={{ fill: RewardFrame.BACKING_INSET }}
              h={{ fill: RewardFrame.BACKING_INSET }}
              sprite={RewardArt.BACKING}
              tiling
            />
            <RewardPane />
            <ThinBoxEntrypoint />
          </layer>

          <RewardPoints />

          <RewardConfirm />
        </layer>

        <ConfirmSheet />
      </layer>
    </layer>
  );
}
