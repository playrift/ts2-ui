import { predictServerState, useState } from 'ts2';
import { chatMessage, playSound } from '../lib/lib.engine';
import { ConfirmSheetOpen, RewardSounds, SelectedReward, SpeedrunVarbits } from './speedrunning-rewards.constants';

export function selectReward(index: Int): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.SELECT);
  setSelected(index);
  predictServerState(SpeedrunVarbits.SHOP_SELECTION, index);
}

export function refuseReward(message: String): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
  predictServerState(SpeedrunVarbits.SHOP_SELECTION, -1);
}

export function openConfirm(): void {
  const [, setOpen] = useState(ConfirmSheetOpen);
  playSound(RewardSounds.SELECT);
  setOpen(1);
}

export function buyReward(): void {
  const [, setOpen] = useState(ConfirmSheetOpen);
  const [, setSelected] = useState(SelectedReward);
  playSound(RewardSounds.SELECT);
  setOpen(0);
  setSelected(-1);
  predictServerState(SpeedrunVarbits.SHOP_SELECTION, -1);
}

export function cancelConfirm(): void {
  const [, setOpen] = useState(ConfirmSheetOpen);
  playSound(RewardSounds.SELECT);
  setOpen(0);
}
