import { QuestScrollCloseButton } from '../0153_questscroll/questscroll-close-button.component';
import { Layout, ScrollColors, ScrollFonts, ScrollModels } from './questscroll-speedrun.constants';
import { SpeedrunPointsLine, SpeedrunTrophiesLine } from './speedrun-totals.component';

export function QuestScrollSpeedrun(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <model
          x="center"
          y={{ center: -ScrollModels.BANNER.up }}
          w={ScrollModels.BANNER.w}
          h={ScrollModels.BANNER.h}
          model={ScrollModels.BANNER.model}
          zoom={ScrollModels.BANNER.zoom}
          pitch={ScrollModels.BANNER.pitch}
          yaw={ScrollModels.BANNER.yaw}
        />

        <text
          x="center"
          y={Layout.TITLE.y}
          w={Layout.TITLE.w}
          h={Layout.TITLE.h}
          text="Congratulations!"
          font={ScrollFonts.TITLE}
          color={ScrollColors.HEADING}
          align="center"
        />
        <text
          x="center"
          y={Layout.SUBTITLE.y}
          w={Layout.SUBTITLE.w}
          h={Layout.SUBTITLE.h}
          text="You have completed a quest speedrun!"
          font={ScrollFonts.BODY}
          color={ScrollColors.BODY}
          align="center"
        />

        <model
          x={ScrollModels.REWARD.x}
          y={ScrollModels.REWARD.y}
          w={ScrollModels.REWARD.w}
          h={ScrollModels.REWARD.h}
          zoom={ScrollModels.REWARD.zoom}
        />

        <SpeedrunPointsLine />
        <SpeedrunTrophiesLine />

        <model
          right={ScrollModels.CORNER.right}
          y={ScrollModels.CORNER.y}
          w={ScrollModels.CORNER.w}
          h={ScrollModels.CORNER.h}
          model={ScrollModels.CORNER.model}
          zoom={ScrollModels.CORNER.zoom}
          pitch={ScrollModels.CORNER.pitch}
        />

        <text
          x="center"
          y={Layout.DURATION_CAPTION_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text="Speedrun duration:"
          font={ScrollFonts.BODY}
          color={ScrollColors.HEADING}
          align="center"
        />
        <text
          x="center"
          y={Layout.DURATION_VALUE_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text="00:00"
          font={ScrollFonts.BODY}
          color={ScrollColors.BODY}
          align="center"
        />
        <text
          x="center"
          y={Layout.BEST_CAPTION_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text="Personal best:"
          font={ScrollFonts.BODY}
          color={ScrollColors.HEADING}
          align="center"
        />
        <text
          x="center"
          y={Layout.BEST_VALUE_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          text="00:00"
          font={ScrollFonts.BODY}
          color={ScrollColors.BODY}
          align="center"
        />

        <QuestScrollCloseButton />
      </layer>
    </layer>
  );
}
