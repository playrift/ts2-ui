import { useServerState } from 'ts2';
import { groupDigits } from '../lib/lib.format';
import { speedrunningWorld } from '../0153_questscroll/questscroll.helpers';
import { TROPHY_CAP, TrophyVarbits } from './questscroll-speedrun.constants';

export function speedrunTrophyCount(): Int {
  return (
    Math.min(useServerState(TrophyVarbits.BRONZE), TROPHY_CAP) +
    Math.min(useServerState(TrophyVarbits.SILVER), TROPHY_CAP) +
    Math.min(useServerState(TrophyVarbits.GOLD), TROPHY_CAP) +
    Math.min(useServerState(TrophyVarbits.PLATINUM), TROPHY_CAP) +
    Math.min(useServerState(TrophyVarbits.DIAMOND), TROPHY_CAP)
  );
}

export function speedrunTrophiesLabel(): String {
  const trophies: String = groupDigits(speedrunTrophyCount(), ',');

  if (speedrunningWorld()) {
    return `Speedrun Trophies: ${trophies}`;
  }
  return '';
}
