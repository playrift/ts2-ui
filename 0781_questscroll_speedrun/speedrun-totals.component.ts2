import { questPointsLabel } from '../0153_questscroll/questscroll.helpers';
import { Layout, ScrollColors, ScrollFonts } from './questscroll-speedrun.constants';
import { speedrunTrophiesLabel } from './questscroll-speedrun.helpers';

export function SpeedrunPointsLine(): Component {
  return (
    <text
      x="center"
      y={Layout.POINTS.y}
      w={Layout.POINTS.w}
      h={Layout.POINTS.h}
      text={questPointsLabel()}
      font={ScrollFonts.BODY}
      color={ScrollColors.HEADING}
      align="center"
    />
  );
}

export function SpeedrunTrophiesLine(): Component {
  return (
    <text
      x="center"
      y={Layout.TROPHIES.y}
      w={Layout.TROPHIES.w}
      h={Layout.TROPHIES.h}
      text={speedrunTrophiesLabel()}
      font={ScrollFonts.BODY}
      color={ScrollColors.HEADING}
      align="center"
    />
  );
}
