import { CS2, useInventory } from 'ts2';
import {
  ClanPartyDropColors,
  ClanPartyDropFonts,
  ClanPartyDropInventories,
  OtherInventory,
} from './clan-hall-partydrop-main.constants';

export function ClanChestCount(): Component {
  const chest = useInventory(ClanPartyDropInventories.CHEST);
  const slots: Int = chest.size;

  let occupied: Int = 0;
  let slot: Int = 0;
  while (slot < slots) {
    if (CS2.invother_item_get(OtherInventory.CHEST, slot) !== -1) {
      occupied = occupied + 1;
    }
    slot = slot + 1;
  }

  return (
    <text
      w="fill"
      h="fill"
      text={stringOf(occupied)}
      font={ClanPartyDropFonts.LABEL}
      color={ClanPartyDropColors.ORANGE}
      shadow
      align="center"
      valign="top"
    />
  );
}
