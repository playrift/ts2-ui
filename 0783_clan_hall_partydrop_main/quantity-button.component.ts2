import { predictServerState, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import {
  ClanPartyDropColors,
  ClanPartyDropFonts,
  ClanPartyDropSounds,
  ClanPartyDropVarbits,
  Layout,
} from './clan-hall-partydrop-main.constants';

export function QuantityButton({ label, mode, dy }: { label: String; mode: Int; dy: Int }): Component {
  const selected: Int = useServerState(ClanPartyDropVarbits.QUANTITY);

  if (selected === mode) {
    return (
      <layer
        x="center"
        y={{ center: dy }}
        w="fill"
        h={Layout.QUANTITY_H}
        options={[label]}
        onOptionSelect={(event) => {
          if (event.option !== 1) {
            return;
          }
          playSound(ClanPartyDropSounds.SELECT);
          predictServerState(ClanPartyDropVarbits.QUANTITY, mode);
        }}
      >
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={label}
          font={ClanPartyDropFonts.BUTTON}
          color={ClanPartyDropColors.WHITE}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      x="center"
      y={{ center: dy }}
      w="fill"
      h={Layout.QUANTITY_H}
      options={[label]}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(ClanPartyDropSounds.SELECT);
        predictServerState(ClanPartyDropVarbits.QUANTITY, mode);
      }}
    >
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={ClanPartyDropFonts.BUTTON}
        color={ClanPartyDropColors.ORANGE}
        hover={{ color: ClanPartyDropColors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
