import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { FswPanel, FswUniverse } from './fsw.constants';

export function fswClick(): void {
  playSound(Sounds.CLICK);
}

export function fswUniverseWidth(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return FswUniverse.ONE.w;
  }
  if (breakpoint === 2 || breakpoint === 3) {
    return FswUniverse.TWO.w;
  }
  return FswUniverse.BASE.w;
}

export function fswUniverseHeight(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return FswUniverse.ONE.h;
  }
  if (breakpoint === 2 || breakpoint === 3) {
    return FswUniverse.TWO.h;
  }
  return FswUniverse.BASE.h;
}

export function fswContentTop(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return FswUniverse.ONE.top;
  }
  if (breakpoint === 2 || breakpoint === 3) {
    return FswUniverse.TWO.top;
  }
  return FswUniverse.BASE.top;
}

export function fswBackgroundWidth(breakpoint: Int): Int {
  return fswUniverseWidth(breakpoint) - FswPanel.BACKGROUND_INSET;
}

export function fswBackgroundHeight(breakpoint: Int): Int {
  return fswUniverseHeight(breakpoint) - FswPanel.BACKGROUND_INSET;
}

export function fswContentWidth(breakpoint: Int): Int {
  return fswBackgroundWidth(breakpoint) - FswPanel.CONTENT_W_INSET;
}

export function fswContentHeight(breakpoint: Int): Int {
  return fswUniverseHeight(breakpoint) - FswPanel.CONTENT_H_INSET;
}

export function fswStripe(index: Int): Int {
  if (index % 2 === 0) {
    return 190;
  }
  return 225;
}

export function hideUnless(value: Int, wanted: Int): Boolean {
  if (value === wanted) {
    return false;
  }
  return true;
}

export function hideIf(value: Int, unwanted: Int): Boolean {
  if (value === unwanted) {
    return true;
  }
  return false;
}

export function breakpointOf(width: Int, height: Int): Int {
  let level: Int = 0;
  if (width > 640 && height > 480) {
    level = 1;
  }
  if (width > 800 && height > 600) {
    level = 2;
  }
  if (width > 1024 && height > 768) {
    level = 3;
  }
  return level;
}
