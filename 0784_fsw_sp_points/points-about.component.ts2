import { FswColor } from './fsw.constants';
import { AboutPage } from './points-table.constants';

export function PointsAboutView({
  contentW,
  contentH,
  y0,
  y1,
  y2,
  y3,
  y4,
  lineH,
  font,
}: {
  contentW: Int;
  contentH: Int;
  y0: Int;
  y1: Int;
  y2: Int;
  y3: Int;
  y4: Int;
  lineH: Int;
  font: Font;
}): Component {
  const textW: Int = contentW - AboutPage.INSET;
  const textH: Int = contentH - AboutPage.INSET;

  return (
    <>
      <rect
        x={0}
        y={0}
        w={{ fill: AboutPage.WASH_INSET }}
        h={{ fill: AboutPage.WASH_INSET }}
        fill
        color={FswColor.BLACK}
        transparency={AboutPage.WASH_TRANSPARENCY}
      />

      <Paragraph
        text="Achievement Points are a fun way to compare yourself with your friends."
        x={AboutPage.TEXT_X}
        y={y0}
        w={textW}
        h={textH}
        font={font}
        lineH={lineH}
        color={FswColor.CREAM}
      />
      <Paragraph
        text="Who is making the best progress? Who has the highest skill levels? Who has killed the most bosses?"
        x={AboutPage.TEXT_X}
        y={y1}
        w={textW}
        h={textH}
        font={font}
        lineH={lineH}
        color={FswColor.TAN}
      />
      <Paragraph
        text="Earn points by playing the game: skilling, quests, bosses, diaries, clues, they all earn you points."
        x={AboutPage.TEXT_X}
        y={y2}
        w={textW}
        h={textH}
        font={font}
        lineH={lineH}
        color={FswColor.CREAM}
      />
      <Paragraph
        text="The points are weighted to try and encourage trying out different things. The first time you kill a boss you'll get a 20x multiplier on that bosses points. So explore and fight as many different things as you can!"
        x={AboutPage.TEXT_X}
        y={y3}
        w={textW}
        h={textH}
        font={font}
        lineH={lineH}
        color={FswColor.TAN}
      />
      <Paragraph
        text="There are no buyable rewards for earned points, it's all pure competition!"
        x={AboutPage.TEXT_X}
        y={y4}
        w={textW}
        h={textH}
        font={font}
        lineH={lineH}
        color={FswColor.CREAM}
      />
    </>
  );
}

function Paragraph({
  text,
  x,
  y,
  w,
  h,
  font,
  lineH,
  color,
}: {
  text: String;
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  font: Font;
  lineH: Int;
  color: Int;
}): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={h}
      text={text}
      font={font}
      color={color}
      shadow
      align="center"
      valign="top"
      lineHeight={lineH}
    />
  );
}
