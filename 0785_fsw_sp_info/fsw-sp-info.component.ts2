import { FswInfoColor, FswInfoFonts, Layout } from './fsw-sp-info.constants';

export function FswSpInfo(): Component {
  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H}>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y="center" w="fill" h="fill">
        <rect x={0} y={0} w="fill" h="fill" fill color={FswInfoColor.WASH} transparency={Layout.WASH_TRANSPARENCY} />

        <layer x="center" y="center" w={{ fill: Layout.BACKGROUND_INSET }} h={{ fill: Layout.BACKGROUND_INSET }} />

        <layer
          x="center"
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_W_INSET }}
          h={{ fill: Layout.CONTENT_H_INSET }}
        />

        <text
          x={0}
          y={Layout.TITLE_Y}
          w="fill"
          h={Layout.TITLE_H}
          font={FswInfoFonts.TITLE}
          color={FswInfoColor.TITLE}
          shadow
          align="center"
          valign="middle"
        />

        <line
          x="center"
          y={Layout.RULE_Y}
          w={{ fill: Layout.RULE_W_INSET }}
          color={FswInfoColor.RULE}
          lineWidth={Layout.RULE_WIDTH}
          hide
        />

        <layer x="center" y={{ bottom: Layout.BUTTON_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} noClickThrough />
      </layer>
    </layer>
  );
}
