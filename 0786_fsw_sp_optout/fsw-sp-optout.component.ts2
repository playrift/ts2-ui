import { FswOptoutColor, FswOptoutFonts, Layout } from './fsw-sp-optout.constants';

export function FswSpOptout(): Component {
  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H}>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y="center" w="fill" h="fill">
        <rect x={0} y={0} w="fill" h="fill" fill color={FswOptoutColor.WASH} transparency={Layout.WASH_TRANSPARENCY} />

        <layer x="center" y="center" w={{ fill: Layout.BACKGROUND_INSET }} h={{ fill: Layout.BACKGROUND_INSET }} />

        <layer
          x="center"
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_W_INSET }}
          h={{ fill: Layout.CONTENT_H_INSET }}
        >
          <layer x={0} y={0} w="fill" h="fill" />

          <layer x={0} y={0} w="fill" h="fill">
            <layer x="center" y={{ bottom: Layout.PAGE_BOX_EDGE }} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="44.995%" />

            <layer x="center" y={Layout.PAGE_BOX_EDGE} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="34.998%">
              <layer x={0} y={0} w="fill" h="fill" />

              <layer
                x="center"
                y={{ center: Layout.BUTTON_CENTRE_Y }}
                w={Layout.BUTTON_W}
                h={Layout.BUTTON_H}
                noClickThrough
              />
            </layer>
          </layer>

          <layer x={0} y={0} w="fill" h="fill">
            <layer x="center" y={{ bottom: Layout.PAGE_BOX_EDGE }} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="44.995%" />

            <layer x="center" y={Layout.PAGE_BOX_EDGE} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="34.998%">
              <layer x={0} y={0} w="fill" h="fill" />

              <layer
                x="center"
                y={{ center: Layout.BUTTON_CENTRE_Y }}
                w={Layout.BUTTON_W}
                h={Layout.BUTTON_H}
                noClickThrough
              />
            </layer>
          </layer>

          <layer x={0} y={0} w="fill" h="fill">
            <layer x="center" y={Layout.PAGE_BOX_EDGE} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="44.995%" />

            <layer x="center" y={{ bottom: Layout.PAGE_BOX_EDGE }} w={{ fill: Layout.PAGE_BOX_W_INSET }} h="34.998%">
              <layer x={0} y={0} w="fill" h="fill" />

              <layer
                x="center"
                y={{ center: Layout.BUTTON_CENTRE_Y }}
                w={Layout.BUTTON_W}
                h={Layout.BUTTON_H}
                noClickThrough
              />

              <layer
                x="center"
                y={{ center: Layout.BUTTON_CENTRE_Y }}
                w={Layout.BUTTON_W}
                h={Layout.BUTTON_H}
                noClickThrough
              />
            </layer>
          </layer>
        </layer>

        <text
          x={0}
          y={Layout.TITLE_Y}
          w="fill"
          h={Layout.TITLE_H}
          font={FswOptoutFonts.TITLE}
          color={FswOptoutColor.TITLE}
          shadow
          align="center"
          valign="middle"
        />

        <layer x={0} y={0} w={Layout.SPARE_W} h={Layout.SPARE_H} />

        <line
          x="center"
          y={Layout.RULE_Y}
          w={{ fill: Layout.RULE_W_INSET }}
          color={FswOptoutColor.RULE}
          lineWidth={Layout.RULE_WIDTH}
          hide
        />

        <layer
          x={{ center: Layout.FOOTER_RIGHT_X }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        />

        <layer
          x={{ center: Layout.FOOTER_LEFT_X }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        />

        <layer
          x={{ center: Layout.FOOTER_LEFT_X }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        />

        <layer
          x={{ center: Layout.FOOTER_LEFT_X }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
          hide
        />

        <layer
          x={{ center: Layout.FOOTER_LEFT_X }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
          hide
        />
      </layer>
    </layer>
  );
}
