import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { FswArt, FswColor, FswFonts, Layout } from './fsw-sp.constants';

export function FswSp(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <text
        x={Layout.HEADER_X}
        y={0}
        w={{ fill: Layout.HEADER_W_INSET }}
        h={Layout.HEADER_H}
        text="Fresh Start Worlds"
        font={FswFonts.HEADING}
        color={FswColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer x="center" y={Layout.BORDER_Y} w="fill" h={{ fill: Layout.BORDER_H_INSET }}>
        <rect
          x="center"
          y={0}
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          fill
          transparency={Layout.BACKDROP_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.INNER_INSET }} h={{ fill: Layout.INNER_INSET }}>
          <layer x={0} y={0} w={Layout.BAND_W} h={Layout.BAND_H}>
            <layer x="center" y={Layout.BOX_Y} w={{ fill: Layout.BOX_W_INSET }} h={Layout.BOX_H} />

            <text
              x={Layout.POINTS_TITLE_X}
              y={Layout.TITLE_Y}
              w={Layout.TITLE_W}
              h={Layout.TITLE_H}
              text="Achievement Points"
              font={FswFonts.TITLE}
              color={FswColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />

            <layer x={{ right: Layout.BADGE_RIGHT }} y={Layout.BADGE_Y} w={Layout.BADGE} h={Layout.BADGE}>
              <layer x={0} y={0} w="fill" h="fill" />

              <sprite
                x={Layout.ICON_XY}
                y={Layout.ICON_XY}
                w={Layout.ICON}
                h={Layout.ICON}
                sprite={FswArt.REFRESH_ICON}
              />
            </layer>

            <text
              x="center"
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text="56857"
              font={FswFonts.HEADING}
              color={FswColor.VALUE}
              shadow
              align="center"
              valign="middle"
            />

            <layer x="center" y={Layout.BUTTON_Y} w={{ fill: Layout.BUTTON_W_INSET }} h={Layout.BUTTON_H} />
          </layer>

          <layer x={0} y={Layout.OPTOUT_Y} w={Layout.BAND_W} h={Layout.BAND_H}>
            <layer x="center" y={Layout.BOX_Y} w={{ fill: Layout.BOX_W_INSET }} h={Layout.BOX_H} />

            <text
              x="center"
              y={Layout.TITLE_Y}
              w={Layout.TITLE_W}
              h={Layout.TITLE_H}
              text="Opt-Out"
              font={FswFonts.TITLE}
              color={FswColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />

            <text
              x="center"
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text="You are not opting out"
              font={FswFonts.BODY}
              color={FswColor.VALUE}
              shadow
              align="center"
              valign="middle"
            />

            <layer x="center" y={Layout.BUTTON_Y} w={{ fill: Layout.BUTTON_W_INSET }} h={Layout.BUTTON_H} />
          </layer>
        </layer>

        <SteelFrameEntrypoint />
      </layer>

      <layer x={0} y={Layout.OTHER_Y} w="fill" h={Layout.OTHER_H}>
        <layer x={Layout.DURATION_X} y={0} w={Layout.CELL_W} h={Layout.CELL_H}>
          <text
            x={0}
            y={Layout.FOOTER_TITLE_Y}
            w="fill"
            h={Layout.FOOTER_ROW_H}
            text="Time Remaining"
            font={FswFonts.BODY}
            color={FswColor.LABEL}
            shadow
            valign="middle"
          />

          <text
            x={0}
            y={Layout.FOOTER_VALUE_Y}
            w="fill"
            h={Layout.FOOTER_ROW_H}
            text="0"
            font={FswFonts.BODY}
            color={FswColor.VALUE}
            shadow
            valign="middle"
          />
        </layer>

        <layer x="right" y={0} w={Layout.CELL_W} h={Layout.CELL_H}>
          <layer
            x={{ right: Layout.INFO_BUTTON_RIGHT }}
            y={Layout.INFO_BUTTON_Y}
            w={{ fill: Layout.INFO_BUTTON_INSET }}
            h={{ fill: Layout.INFO_BUTTON_INSET }}
          />
        </layer>
      </layer>

      <layer x="center" y="bottom" w={{ fill: Layout.HUD_W_INSET }} h={Layout.HUD_H} options={['*']} hide />

      <layer x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} hide />
    </layer>
  );
}
