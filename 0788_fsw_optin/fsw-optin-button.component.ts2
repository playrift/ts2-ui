import { useState } from 'ts2';

import { FswBoxFrame } from '../0784_fsw_sp_points/fsw-box-frame.component';
import { FswBoxStyle, FswBoxes } from '../0784_fsw_sp_points/fsw-box.data';
import { FswColor, FswFonts } from '../0784_fsw_sp_points/fsw.constants';
import { OptinButtonText, OptinLayout } from './fsw-optin.constants';
import { fswOptinAct } from './fsw-optin.helpers';

export function FswOptinButton({
  caption,
  label,
  hover,
  option,
  subject,
  action,
  choice,
  live,
}: {
  caption: String;
  label: String;
  hover: Int;
  option: String;
  subject: String;
  action: Int;
  choice: Int;
  live: Int;
}): Component {
  const [hot, setHot] = useState(0);
  const w: Int = OptinLayout.BUTTON_W;
  const h: Int = OptinLayout.BUTTON_H;
  const style = FswBoxes.at(FswBoxStyle.LOCKED);

  return (
    <>
      {live === 1 ? (
        <rect
          x={0}
          y={0}
          w="fill"
          h="fill"
          fill
          color={FswColor.WHITE}
          transparency={255}
          options={[option]}
          optionSubject={subject}
          onMouseRepeat={() => {
            setHot(1);
          }}
          onMouseLeave={() => {
            setHot(0);
          }}
          onOptionSelect={() => {
            setHot(0);
            fswOptinAct(action, choice);
          }}
        />
      ) : (
        <rect x={0} y={0} w="fill" h="fill" fill color={FswColor.WHITE} transparency={255} />
      )}

      <rect x={1} y={1} w={w - 2} h={h - 2} fill color={hot === 1 ? hover : FswColor.AMBER} />
      <FswBoxFrame x={0} y={0} w={w} h={h} style={style} />

      <text
        x={0}
        y={OptinButtonText.CAPTION_Y}
        w={w}
        h={h}
        text={caption}
        font={FswFonts.VERDANA_13}
        color={hot === 1 ? hover : FswColor.AMBER}
        shadow
        align="center"
        valign="top"
      />
      <text
        x={0}
        y={OptinButtonText.LABEL_Y}
        w={w}
        h={h}
        text={label}
        font={FswFonts.VERDANA_13_BOLD}
        color={hot === 1 ? hover : FswColor.WHITE}
        shadow
        align="center"
        valign="top"
      />
    </>
  );
}
