import { useState } from 'ts2';

import { FswBoxFrame } from '../0784_fsw_sp_points/fsw-box-frame.component';
import { FswBoxStyle, FswBoxes } from '../0784_fsw_sp_points/fsw-box.data';
import { FswColor, FswFonts } from '../0784_fsw_sp_points/fsw.constants';
import { OptinAction, OptinLayout } from './fsw-optin.constants';
import { fswOptinAct } from './fsw-optin.helpers';

export function MoreInfoButton({ built, live }: { built: Int; live: Int }): Component {
  const [hot, setHot] = useState(0);
  const unlocked = FswBoxes.at(FswBoxStyle.UNLOCKED);

  return (
    <>
      <layer x={0} y="bottom" w="fill" h="fill">
        <rect
          x={0}
          y={0}
          w="fill"
          h="fill"
          fill
          color={FswColor.WHITE}
          transparency={255}
          hide={built === 0}
          options={[live === 1 ? 'Select' : '']}
          optionSubject="<col=ff981f>Find out more</col>"
          onMouseRepeat={
            live === 1
              ? () => {
                  setHot(1);
                }
              : null
          }
          onMouseLeave={() => {
            setHot(0);
          }}
          onOptionSelect={
            live === 1
              ? () => {
                  setHot(0);
                  fswOptinAct(OptinAction.MORE, 0);
                }
              : null
          }
        />
        <rect
          x={1}
          y={1}
          w={OptinLayout.MORE_W - 2}
          h={OptinLayout.MORE_H - 2}
          fill
          color={hot === 1 ? FswColor.YELLOW : FswColor.AMBER}
          hide={built === 0}
        />
        <layer x={0} y={0} w="fill" h="fill" hide={built === 0}>
          <FswBoxFrame x={0} y={0} w={OptinLayout.MORE_W} h={OptinLayout.MORE_H} style={unlocked} />
        </layer>
      </layer>
      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        text="Find out more"
        font={FswFonts.VERDANA_13}
        color={hot === 1 ? FswColor.YELLOW : FswColor.WHITE}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
