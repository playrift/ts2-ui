import { Darkening, Layout } from './item-transmog.constants';

export function ItemTransmog(): Component {
  return (
    <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
      <layer x={0} y={0} w="fill" h="fill" />

      <layer x="center" y={Layout.CONTENT_Y} w={{ fill: Layout.CONTENT_W_INSET }} h={{ fill: Layout.CONTENT_H_INSET }}>
        <rect x={0} y={0} w="fill" h="fill" fill color={Darkening.COLOR} transparency={Darkening.TRANSPARENCY} />

        <layer x={0} y={0} w={{ fill: Layout.SCROLL_W_INSET }} h="fill">
          <layer x={0} y={0} w="fill" h="fill" />
          <layer x={0} y={0} w="fill" h="fill" />
        </layer>

        <layer x={{ right: 0 }} y={0} w={Layout.BAR_W} h="fill" />
      </layer>
    </layer>
  );
}
