import { TrickOrTreatButton } from './trickortreat-button.component';
import {
  TrickOrTreatColors,
  TrickOrTreatFonts,
  TrickOrTreatLayout,
  TrickOrTreatModel,
  TrickOrTreatText,
} from './hw22-trickortreat.constants';

export function Hw22TrickOrTreat(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={TrickOrTreatLayout.TARGET_W} h={TrickOrTreatLayout.TARGET_H} hide>
        <layer x={0} y={0} w="fill" h="fill" />

        <layer
          x="center"
          y={TrickOrTreatLayout.WELL_Y}
          w={{ fill: TrickOrTreatLayout.WELL_INSET_X }}
          h={{ fill: TrickOrTreatLayout.WELL_INSET_Y }}
        >
          <text
            x={TrickOrTreatLayout.COUNTER_X}
            y={{ bottom: TrickOrTreatLayout.COUNTER_BOTTOM }}
            w={TrickOrTreatLayout.COUNTER_W}
            h={TrickOrTreatLayout.COUNTER_H}
            text={TrickOrTreatText.COUNTER}
            font={TrickOrTreatFonts.COUNTER}
            color={TrickOrTreatColors.COUNTER}
            shadow
            valign="middle"
          />

          <model
            x={0}
            y={0}
            w={TrickOrTreatLayout.MODEL_W}
            h={TrickOrTreatLayout.MODEL_H}
            model={TrickOrTreatModel.CANDY}
            pitch={0}
            yaw={TrickOrTreatLayout.CANDY_YAW}
            roll={0}
            zoom={TrickOrTreatLayout.CANDY_ZOOM_TARGET}
            offsetX={0}
            offsetY={TrickOrTreatLayout.CANDY_OFFSET_Y}
          />

          <model
            x={{ right: TrickOrTreatLayout.TARGET_PUMPKIN_RIGHT }}
            y={TrickOrTreatLayout.TARGET_PUMPKIN_Y}
            w={TrickOrTreatLayout.MODEL_W}
            h={TrickOrTreatLayout.MODEL_H}
            model={TrickOrTreatModel.PUMPKIN}
            pitch={TrickOrTreatLayout.PUMPKIN_PITCH}
            yaw={0}
            roll={0}
            zoom={TrickOrTreatLayout.PUMPKIN_ZOOM}
            offsetX={0}
            offsetY={TrickOrTreatLayout.PUMPKIN_OFFSET_Y}
          />

          <layer
            x={{ center: -TrickOrTreatLayout.BUTTON_SPREAD }}
            y={{ bottom: TrickOrTreatLayout.BUTTON_BOTTOM }}
            w={TrickOrTreatLayout.BUTTON_W}
            h={TrickOrTreatLayout.BUTTON_H}
            options={[TrickOrTreatText.TREAT]}
          >
            <TrickOrTreatButton />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={TrickOrTreatText.TREAT}
              font={TrickOrTreatFonts.BODY}
              color={TrickOrTreatColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer
            x="center"
            y={{ bottom: TrickOrTreatLayout.BUTTON_BOTTOM }}
            w={TrickOrTreatLayout.BUTTON_W}
            h={TrickOrTreatLayout.BUTTON_H}
            options={[TrickOrTreatText.TRICK]}
          >
            <TrickOrTreatButton />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={TrickOrTreatText.TRICK}
              font={TrickOrTreatFonts.BODY}
              color={TrickOrTreatColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer
            x={{ center: TrickOrTreatLayout.BUTTON_SPREAD }}
            y={{ bottom: TrickOrTreatLayout.BUTTON_BOTTOM }}
            w={TrickOrTreatLayout.BUTTON_W}
            h={TrickOrTreatLayout.BUTTON_H}
            options={[TrickOrTreatText.NOTHING]}
          >
            <TrickOrTreatButton />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={TrickOrTreatText.NOTHING}
              font={TrickOrTreatFonts.BODY}
              color={TrickOrTreatColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <text
            x="center"
            y={TrickOrTreatLayout.PROMPT_Y}
            w={TrickOrTreatLayout.TARGET_PROMPT_W}
            h={TrickOrTreatLayout.PROMPT_H}
            font={TrickOrTreatFonts.BODY}
            color={TrickOrTreatColors.LABEL}
            shadow
            align="center"
            valign="middle"
            lineHeight={TrickOrTreatLayout.PROMPT_LINE_HEIGHT}
          />
        </layer>
      </layer>

      <layer x="center" y="center" w={TrickOrTreatLayout.INITIATOR_W} h={TrickOrTreatLayout.INITIATOR_H} hide>
        <layer x={0} y={0} w="fill" h="fill" />

        <layer
          x="center"
          y={TrickOrTreatLayout.WELL_Y}
          w={{ fill: TrickOrTreatLayout.WELL_INSET_X }}
          h={{ fill: TrickOrTreatLayout.WELL_INSET_Y }}
        >
          <text
            x={TrickOrTreatLayout.COUNTER_X}
            y={{ bottom: TrickOrTreatLayout.COUNTER_BOTTOM }}
            w={TrickOrTreatLayout.COUNTER_W}
            h={TrickOrTreatLayout.COUNTER_H}
            text={TrickOrTreatText.COUNTER}
            font={TrickOrTreatFonts.COUNTER}
            color={TrickOrTreatColors.COUNTER}
            shadow
            valign="middle"
          />

          <model
            x={{ right: TrickOrTreatLayout.INITIATOR_PUMPKIN_RIGHT }}
            y={{ bottom: TrickOrTreatLayout.INITIATOR_PUMPKIN_BOTTOM }}
            w={TrickOrTreatLayout.MODEL_W}
            h={TrickOrTreatLayout.MODEL_H}
            model={TrickOrTreatModel.PUMPKIN}
            pitch={TrickOrTreatLayout.PUMPKIN_PITCH}
            yaw={0}
            roll={0}
            zoom={TrickOrTreatLayout.PUMPKIN_ZOOM}
            offsetX={0}
            offsetY={TrickOrTreatLayout.PUMPKIN_OFFSET_Y}
          />

          <model
            x={TrickOrTreatLayout.INITIATOR_CANDY_X}
            y={0}
            w={TrickOrTreatLayout.MODEL_W}
            h={TrickOrTreatLayout.MODEL_H}
            model={TrickOrTreatModel.CANDY}
            pitch={0}
            yaw={TrickOrTreatLayout.CANDY_YAW}
            roll={0}
            zoom={TrickOrTreatLayout.CANDY_ZOOM_INITIATOR}
            offsetX={0}
            offsetY={TrickOrTreatLayout.CANDY_OFFSET_Y}
          />

          <text
            x="center"
            y={TrickOrTreatLayout.PROMPT_Y}
            w={TrickOrTreatLayout.INITIATOR_PROMPT_W}
            h={TrickOrTreatLayout.PROMPT_H}
            font={TrickOrTreatFonts.BODY}
            color={TrickOrTreatColors.LABEL}
            shadow
            align="center"
            valign="middle"
            lineHeight={TrickOrTreatLayout.PROMPT_LINE_HEIGHT}
          />

          <layer
            x="center"
            y={{ bottom: TrickOrTreatLayout.BUTTON_BOTTOM }}
            w={TrickOrTreatLayout.BUTTON_W}
            h={TrickOrTreatLayout.BUTTON_H}
            options={[TrickOrTreatText.WITHDRAW]}
          >
            <TrickOrTreatButton />
            <text
              x="center"
              y="center"
              w="fill"
              h="fill"
              text={TrickOrTreatText.WITHDRAW}
              font={TrickOrTreatFonts.BODY}
              color={TrickOrTreatColors.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
