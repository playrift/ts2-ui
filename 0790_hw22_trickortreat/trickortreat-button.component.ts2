import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { ButtonSkin } from './hw22-trickortreat.constants';

export function TrickOrTreatButton(): Component {
  const [skin, setSkin] = useState(ButtonSkin.REST);

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        onMouseLeave={() => setSkin(ButtonSkin.REST)}
        onHold={() => setSkin(ButtonSkin.PRESSED)}
        onRelease={() => setSkin(ButtonSkin.RAISED)}
      >
        {skin === ButtonSkin.PRESSED ? <StoneButtonPressedFilled /> : null}
        {skin === ButtonSkin.RAISED ? <StoneButtonOutFilled /> : null}
        {skin === ButtonSkin.REST ? <StoneButtonFilled /> : null}
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => setSkin(ButtonSkin.RAISED)}
      onMouseLeave={() => setSkin(ButtonSkin.REST)}
      onHold={() => setSkin(ButtonSkin.PRESSED)}
      onRelease={() => setSkin(ButtonSkin.RAISED)}
    >
      {skin === ButtonSkin.PRESSED ? <StoneButtonPressedFilled /> : null}
      {skin === ButtonSkin.RAISED ? <StoneButtonOutFilled /> : null}
      {skin === ButtonSkin.REST ? <StoneButtonFilled /> : null}
    </layer>
  );
}
