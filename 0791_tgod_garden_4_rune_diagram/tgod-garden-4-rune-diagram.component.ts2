import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { GardenArt, GardenColors, GardenFonts, Layout } from './tgod-garden-4-rune-diagram.constants';

export function TgodGarden4RuneDiagram(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <sprite x="center" y="center" w={Layout.PLATE_SIZE} h={Layout.PLATE_SIZE} sprite={GardenArt.PLATE} />

        <text
          x={Layout.COM_3_X}
          y={Layout.COM_3_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text="Tal"
          font={GardenFonts.LABEL}
          color={GardenColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <text
          x={Layout.COM_4_X}
          y={Layout.COM_4_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text="Yoka"
          font={GardenFonts.LABEL}
          color={GardenColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <text
          x={Layout.COM_5_X}
          y={Layout.COM_5_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text="Olkat"
          font={GardenFonts.LABEL}
          color={GardenColors.LABEL}
          align="center"
          valign="middle"
          shadow
        />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={GardenArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, GardenArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, GardenArt.CLOSE)}
        />
      </layer>
    </layer>
  );
}
