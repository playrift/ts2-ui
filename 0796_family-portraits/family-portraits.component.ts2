import { closeInterface, onMobile } from '../lib/lib.helpers';
import { Colors, Fonts, Sprites } from './family-portraits.constants';

export function FamilyPortraits(): Component {
  return (
    <layer x="center" y="center" w={512} h={334}>
      <sprite x="center" y="center" w={320} h={320} sprite={Sprites.BACKGROUND} />

      <text
        x={152}
        y={79}
        w={95}
        h={32}
        text="Ralo"
        font={Fonts.NAME}
        color={Colors.NAME}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={262}
        y={79}
        w={95}
        h={32}
        text="Rani"
        font={Fonts.NAME}
        color={Colors.NAME}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={149}
        y={245}
        w={95}
        h={32}
        text="Tal<br>Tlane"
        font={Fonts.NAME}
        color={Colors.NAME}
        shadow
        align="center"
        valign="middle"
      />
      <text
        x={270}
        y={244}
        w={95}
        h={32}
        text="Miki<br>Tlane"
        font={Fonts.NAME}
        color={Colors.NAME}
        shadow
        align="center"
        valign="middle"
      />

      <sprite
        x={{ right: 76 }}
        y={20}
        w={26}
        h={23}
        sprite={Sprites.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          if (!onMobile()) {
            event.self.sprite = Sprites.CLOSE_HOVER;
          }
        }}
        onMouseLeave={(event) => {
          if (!onMobile()) {
            event.self.sprite = Sprites.CLOSE;
          }
        }}
      />
    </layer>
  );
}
