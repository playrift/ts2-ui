import { ButtonInSprites, ButtonOutSprites, CORNER, Layout, TranslationsColors } from './tgod-translations.constants';

export function BeigeStoneButtonSkin({ pressed }: { pressed: Int }): Component {
  if (pressed === 1) {
    return (
      <>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.BUTTON_FACE_INSET }}
          h={{ fill: Layout.BUTTON_FACE_INSET }}
          fill
          color={TranslationsColors.BUTTON_FACE_PRESSED}
        />
        <sprite x="left" y="top" w={CORNER} h={CORNER} sprite={ButtonInSprites.TOP_LEFT} tiling />
        <sprite x="right" y="top" w={CORNER} h={CORNER} sprite={ButtonInSprites.TOP_RIGHT} tiling />
        <sprite x="left" y="bottom" w={CORNER} h={CORNER} sprite={ButtonInSprites.BOTTOM_LEFT} tiling />
        <sprite x="right" y="bottom" w={CORNER} h={CORNER} sprite={ButtonInSprites.BOTTOM_RIGHT} tiling />
        <sprite x="left" y="center" w={CORNER} h={{ fill: CORNER * 2 }} sprite={ButtonInSprites.LEFT} tiling />
        <sprite x="center" y="top" w={{ fill: CORNER * 2 }} h={CORNER} sprite={ButtonInSprites.TOP} tiling />
        <sprite x="right" y="center" w={CORNER} h={{ fill: CORNER * 2 }} sprite={ButtonInSprites.RIGHT} tiling />
        <sprite x="center" y="bottom" w={{ fill: CORNER * 2 }} h={CORNER} sprite={ButtonInSprites.BOTTOM} tiling />
      </>
    );
  }
  return (
    <>
      <rect
        x="center"
        y="center"
        w={{ fill: Layout.BUTTON_FACE_INSET }}
        h={{ fill: Layout.BUTTON_FACE_INSET }}
        fill
        color={TranslationsColors.BUTTON_FACE}
      />
      <sprite x="left" y="top" w={CORNER} h={CORNER} sprite={ButtonOutSprites.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={CORNER} h={CORNER} sprite={ButtonOutSprites.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={CORNER} h={CORNER} sprite={ButtonOutSprites.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={CORNER} h={CORNER} sprite={ButtonOutSprites.BOTTOM_RIGHT} tiling />
      <sprite x="left" y="center" w={CORNER} h={{ fill: CORNER * 2 }} sprite={ButtonOutSprites.LEFT} tiling />
      <sprite x="center" y="top" w={{ fill: CORNER * 2 }} h={CORNER} sprite={ButtonOutSprites.TOP} tiling />
      <sprite x="right" y="center" w={CORNER} h={{ fill: CORNER * 2 }} sprite={ButtonOutSprites.RIGHT} tiling />
      <sprite x="center" y="bottom" w={{ fill: CORNER * 2 }} h={CORNER} sprite={ButtonOutSprites.BOTTOM} tiling />
    </>
  );
}
