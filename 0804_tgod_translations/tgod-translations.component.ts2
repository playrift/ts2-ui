import { useState } from 'ts2';

import { closeInterface, graphicSwapperUnlessMobile, onMobile } from '../lib/lib.helpers';
import { BeigeStoneButtonSkin } from './beige-stone-button.component';
import {
  Copy,
  Layout,
  TranslationsColors,
  TranslationsFonts,
  TranslationsSprites,
} from './tgod-translations.constants';

export function TgodTranslations(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.STAGE_W} h={Layout.STAGE_H}>
        <sprite
          x={{ right: Layout.CLOSE_INSET }}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={TranslationsSprites.CLOSE_REST}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, TranslationsSprites.CLOSE_LIT)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, TranslationsSprites.CLOSE_REST)}
        />

        <model
          x={{ center: Layout.MODEL_X }}
          y={{ center: Layout.MODEL_Y }}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={Layout.MODEL_ID}
          pitch={Layout.MODEL_PITCH}
          yaw={Layout.MODEL_YAW}
          zoom={Layout.MODEL_ZOOM}
        />

        <text
          x={Layout.TITLE_X}
          y={Layout.TITLE_Y}
          w={Layout.TITLE_W}
          h={Layout.TITLE_H}
          text={Copy.TITLE}
          font={TranslationsFonts.SCROLL}
          color={TranslationsColors.PARCHMENT_INK}
          shadow
          align="center"
          valign="middle"
        />

        <TranslateButton
          x={{ center: Layout.BUTTON_X }}
          y={{ bottom: Layout.BUTTON_Y }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={[Copy.ATTEMPT]}
        />

        <layer x={{ center: Layout.BODY_X }} y={Layout.BODY_Y} w={Layout.BODY_W} h={Layout.BODY_H}>
          <text
            x="center"
            y={0}
            w="fill"
            h={Layout.BODY_TEXT_H}
            text={Copy.BODY_PLACEHOLDER}
            font={TranslationsFonts.SCROLL}
            color={TranslationsColors.PARCHMENT_INK}
            shadow
            align="center"
          />
        </layer>

        <layer x={{ right: Layout.BAR_INSET }} y={Layout.BODY_Y} w={Layout.BAR_W} h={Layout.BODY_H} />
      </layer>
    </layer>
  );
}

export function TranslateButton(): Component {
  const [pressed, setPressed] = useState(0);
  const mobile: Boolean = onMobile();

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={mobile ? undefined : () => setPressed(1)}
      onMouseLeave={mobile ? undefined : () => setPressed(0)}
    >
      <BeigeStoneButtonSkin pressed={pressed} />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={Copy.ATTEMPT}
        font={TranslationsFonts.SCROLL}
        color={TranslationsColors.PARCHMENT_INK}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
