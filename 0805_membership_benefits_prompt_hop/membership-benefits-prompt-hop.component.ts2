export function MembershipBenefitsPromptHop(): Component {
  return (
    <layer x={{ center: Layout.PANEL_NUDGE }} y="center" w={Layout.PANEL_WIDTH} h={Layout.PANEL_HEIGHT}>
      <model
        x={Layout.MODEL_INSET}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        zoom={Layout.MODEL_ZOOM}
      />
      <model
        x={{ right: Layout.MODEL_INSET }}
        y={{ center: Layout.MODEL_DROP }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        zoom={Layout.MODEL_ZOOM}
      />

      <text
        x="center"
        y={Layout.HEADLINE_Y}
        w={{ fill: Layout.HEADLINE_INSET }}
        h={Layout.HEADLINE_HEIGHT}
        font={HopFonts.MESSAGE}
        color={HopColors.LABEL}
        align="center"
        valign="middle"
      />
      <text
        x="center"
        y={Layout.BODY_Y}
        w={Layout.BODY_WIDTH}
        h={Layout.BODY_HEIGHT}
        font={HopFonts.MESSAGE}
        color={HopColors.LABEL}
        align="center"
        valign="middle"
      />

      <HopButton
        label="World Switcher"
        x={{ center: -Layout.BUTTON_SPREAD }}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />
      <HopButton
        label="Close"
        x={{ center: Layout.BUTTON_SPREAD }}
        y={{ bottom: Layout.BUTTON_BOTTOM }}
        w={Layout.BUTTON_WIDTH}
        h={Layout.BUTTON_HEIGHT}
      />
    </layer>
  );
