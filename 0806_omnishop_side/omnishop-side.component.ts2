import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { InfoWash, Layout } from './omnishop-side.constants';
import { omnishopSideInfoClose } from './omnishop-side.helpers';
import { infoLayer, items } from './omnishop-side.refs';

export function OmnishopSide(): Component {
  return (
    <>
      <layer ref={items} x={Layout.ITEMS_X} y={Layout.ITEMS_Y} w={Layout.ITEMS_W} h={Layout.ITEMS_H} />

      <layer
        ref={infoLayer}
        x="center"
        y="center"
        w={{ fill: Layout.INFO_INSET_W }}
        h={{ fill: Layout.INFO_INSET_H }}
        hide
      >
        <layer x="center" y="bottom" w="fill" h={Layout.BUTTONS_H}>
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['Buy 1']} />
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['Buy 5']} />
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['Buy 10']} />
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['Buy 50']} />
        </layer>

        <layer
          x="center"
          y={0}
          w={{ fill: Layout.CLOSE_INSET_W }}
          h={Layout.CLOSE_H}
          options={['Close Info']}
          onOptionSelect={() => omnishopSideInfoClose()}
        />

        <rect
          x={0}
          y={Layout.PANE_Y}
          w={{ fill: Layout.PANE_INSET_W }}
          h={{ fill: Layout.PANE_INSET_H }}
          color={InfoWash.COLOUR}
          fill
          transparency={InfoWash.TRANSPARENCY}
        />

        <layer x={0} y={Layout.PANE_Y} w={{ fill: Layout.PANE_INSET_W }} h={{ fill: Layout.PANE_INSET_H }}>
          <ThinBoxEntrypoint />
        </layer>

        <layer
          x={Layout.CONTENT_X}
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_INSET_W }}
          h={{ fill: Layout.CONTENT_INSET_H }}
        />

        <layer x="right" y={Layout.PANE_Y} w={Layout.SCROLLER_W} h={{ fill: Layout.PANE_INSET_H }} />
      </layer>
    </>
  );
}
