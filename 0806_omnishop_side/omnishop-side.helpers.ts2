import { predictServerState } from 'ts2';

import { Varps } from '../lib/game/varps';
import { infoLayer, items } from './omnishop-side.refs';

export function omnishopSideInfoClose(): void {
  items.hide = false;
  infoLayer.hide = true;
  predictServerState(Varps.OMNISHOP_SELECTED_SIDE_ID, -1);
}
