import { useRef } from 'ts2';
import { closeInterface, graphicSwapper, onMobile } from '../lib/lib.helpers';
import { CloseBox, CloseSprites } from './eventscroll.constants';

export function EventScrollCloseButton(): Component {
  if (onMobile()) {
    return (
      <layer
        right={CloseBox.RIGHT}
        y={CloseBox.Y}
        w={CloseBox.SIZE}
        h={CloseBox.SIZE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={{ center: CloseBox.FACE_DX }}
          y={{ center: CloseBox.FACE_DY }}
          w={CloseBox.FACE_W}
          h={CloseBox.FACE_H}
          sprite={CloseSprites.REST}
        />
      </layer>
    );
  }

  const face = useRef();
  return (
    <layer
      right={CloseBox.RIGHT}
      y={CloseBox.Y}
      w={CloseBox.SIZE}
      h={CloseBox.SIZE}
      options={['Close']}
      onOptionSelect={() => closeInterface()}
      onMouseEnter={() => graphicSwapper(face, CloseSprites.HOVER)}
      onMouseLeave={() => graphicSwapper(face, CloseSprites.REST)}
    >
      <sprite
        ref={face}
        x={{ center: CloseBox.FACE_DX }}
        y={{ center: CloseBox.FACE_DY }}
        w={CloseBox.FACE_W}
        h={CloseBox.FACE_H}
        sprite={CloseSprites.REST}
      />
    </layer>
  );
}
