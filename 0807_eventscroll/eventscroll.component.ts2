import { EventScrollCloseButton } from './eventscroll-close-button.component';
import { Layout, ScrollColors, ScrollFonts, ScrollModels } from './eventscroll.constants';

export function EventScroll(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill">
        <layer x="center" y="center" w={Layout.FRAME_W} h={Layout.FRAME_H}>
          <model
            x="center"
            y="center"
            w={ScrollModels.PARCHMENT.w}
            h={ScrollModels.PARCHMENT.h}
            model={ScrollModels.PARCHMENT.model}
            zoom={ScrollModels.PARCHMENT.zoom}
            pitch={ScrollModels.PARCHMENT.pitch}
            yaw={ScrollModels.PARCHMENT.yaw}
            offsetX={ScrollModels.PARCHMENT.dx}
            offsetY={ScrollModels.PARCHMENT.dy}
          />

          <layer w="fill" h="fill">
            <text
              x="center"
              y={Layout.TITLE.y}
              w={Layout.TITLE.w}
              h={Layout.TITLE.h}
              text="Event complete!"
              font={ScrollFonts.HEADING}
              color={ScrollColors.TITLE}
              align="center"
            />

            <text
              x="center"
              y={Layout.SUBTITLE.y}
              w={Layout.SUBTITLE.w}
              h={Layout.SUBTITLE.h}
              font={ScrollFonts.HEADING}
              color={ScrollColors.SUBTITLE}
              align="center"
            />

            <text
              x="center"
              y={{ center: -Layout.REWARDS_HEADING.up }}
              w={Layout.REWARDS_HEADING.w}
              h={Layout.REWARDS_HEADING.h}
              text="Rewards"
              font={ScrollFonts.HEADING}
              color={ScrollColors.TITLE}
              align="center"
            />

            <model
              x="center"
              y={ScrollModels.REWARD_ICON.y}
              w={ScrollModels.REWARD_ICON.w}
              h={ScrollModels.REWARD_ICON.h}
              zoom={ScrollModels.REWARD_ICON.zoom}
            />

            <text
              x="center"
              y={{ center: Layout.REWARD_LIST.down }}
              w={Layout.REWARD_LIST.w}
              h={Layout.REWARD_LIST.h}
              text="1y<br>2y<br>3y<br>4y<br>5y<br>6y"
              font={ScrollFonts.BODY}
              color={ScrollColors.BODY}
              align="center"
              lineHeight={Layout.REWARD_LIST.lineHeight}
            />

            <layer x="center" y={Layout.FOOTER.y} w={Layout.FOOTER.w} h={Layout.FOOTER.h}>
              <rect w="fill" h="fill" fill color={ScrollColors.FOOTER_PLATE} />

              <model
                x={{ center: ScrollModels.FOOTER_ICON.dx }}
                y="center"
                w={ScrollModels.FOOTER_ICON.w}
                h={ScrollModels.FOOTER_ICON.h}
                zoom={ScrollModels.FOOTER_ICON.zoom}
              />

              <text
                x={{ center: Layout.FOOTER_TEXT.dx }}
                w={Layout.FOOTER_TEXT.w}
                h={Layout.FOOTER_TEXT.h}
                font={ScrollFonts.BODY}
                color={ScrollColors.FOOTER_TEXT}
                align="center"
                valign="middle"
                lineHeight={Layout.FOOTER_TEXT.lineHeight}
              />
            </layer>
          </layer>

          <model
            right={ScrollModels.CORNER.right}
            y={ScrollModels.CORNER.y}
            w={ScrollModels.CORNER.w}
            h={ScrollModels.CORNER.h}
            model={ScrollModels.CORNER.model}
            zoom={ScrollModels.CORNER.zoom}
            pitch={ScrollModels.CORNER.pitch}
          />
        </layer>
      </layer>

      <EventScrollCloseButton />
    </>
  );
}
