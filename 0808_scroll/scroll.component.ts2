import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, LineY, ScrollArt, ScrollColors, ScrollFonts, ScrollModels } from './scroll.constants';

export function Scroll(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ScrollArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, ScrollArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, ScrollArt.CLOSE)}
        />

        <model
          x={{ center: Layout.MODEL_DX }}
          y={{ center: Layout.MODEL_DY }}
          w={Layout.MODEL_W}
          h={Layout.MODEL_H}
          model={ScrollModels.BACKGROUND}
          zoom={ScrollModels.ZOOM}
          pitch={ScrollModels.PITCH}
          yaw={ScrollModels.YAW}
        />

        <layer x={Layout.PANE_X} y={Layout.PANE_Y} w={Layout.PANE_W} h={Layout.PANE_H}>
          {LineY.map((y) => (
            <text
              x="center"
              y={y}
              w={Layout.LINE_W}
              h={Layout.LINE_H}
              font={ScrollFonts.LINE}
              color={ScrollColors.INK}
              align="center"
              shadow
            />
          ))}
        </layer>
      </layer>
    </layer>
  );
}
