import { useState } from 'ts2';

import {
  combinationLockValue0,
  combinationLockValue1,
  combinationLockValue2,
  combinationLockValue3,
  combinationLockValue4,
  combinationLockValue5,
} from '../lib/game/varcs';

export function facePositions(glyphs: Int, icons: Int): Int {
  return glyphs + icons;
}

export function offsetIndex(at: Int, positions: Int, delta: Int): Int {
  const next = (at + delta) % positions;
  if (next < 0) {
    return next + positions;
  }
  return next;
}

export function packDials(d0: Int, d1: Int, d2: Int, d3: Int, d4: Int, d5: Int): Int {
  return ((((d0 * 10 + d1) * 10 + d2) * 10 + d3) * 10 + d4) * 10 + d5;
}

export function setDialValue(dial: Int, value: Int): void {
  const [, setValue0] = useState(combinationLockValue0);
  const [, setValue1] = useState(combinationLockValue1);
  const [, setValue2] = useState(combinationLockValue2);
  const [, setValue3] = useState(combinationLockValue3);
  const [, setValue4] = useState(combinationLockValue4);
  const [, setValue5] = useState(combinationLockValue5);

  if (dial === 0) {
    setValue0(value);
  } else if (dial === 1) {
    setValue1(value);
  } else if (dial === 2) {
    setValue2(value);
  } else if (dial === 3) {
    setValue3(value);
  } else if (dial === 4) {
    setValue4(value);
  } else if (dial === 5) {
    setValue5(value);
  }
}

export function randomiseDials(dials: Int, positions: Int, randomise: Boolean): void {
  let dial = 0;
  while (dial < 6) {
    if (randomise && dial < dials) {
      setDialValue(dial, Random.int(positions));
    } else {
      setDialValue(dial, 0);
    }
    dial = dial + 1;
  }
}
