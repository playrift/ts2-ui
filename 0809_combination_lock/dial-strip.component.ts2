import { useState } from 'ts2';

import {
  combinationLockValue0,
  combinationLockValue1,
  combinationLockValue2,
  combinationLockValue3,
  combinationLockValue4,
  combinationLockValue5,
} from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import { graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  LOCK,
  LockColors,
  LockFonts,
  LockLayout,
  LockSounds,
  LockSprites,
  VARC_UNSET,
} from './combination-lock.constants';
import { LockDatasets } from './combination-lock.data';
import { facePositions, offsetIndex } from './combination-lock.state';

export function DialStrip(): Component {
  const [value0, setValue0] = useState(combinationLockValue0);
  const [value1, setValue1] = useState(combinationLockValue1);
  const [value2, setValue2] = useState(combinationLockValue2);
  const [value3, setValue3] = useState(combinationLockValue3);
  const [value4, setValue4] = useState(combinationLockValue4);
  const [value5, setValue5] = useState(combinationLockValue5);

  const lock = LockDatasets.get(LOCK);

  if (value0 === VARC_UNSET) {
    return null;
  }

  const face0 = lock.values.at(0);
  const positions0 = facePositions(face0.glyphs.length, face0.icons.length);
  const face1 = lock.values.at(1);
  const positions1 = facePositions(face1.glyphs.length, face1.icons.length);
  const face2 = lock.values.at(2);
  const positions2 = facePositions(face2.glyphs.length, face2.icons.length);
  const face3 = lock.values.at(3);
  const positions3 = facePositions(face3.glyphs.length, face3.icons.length);
  const face4 = lock.values.at(4);
  const positions4 = facePositions(face4.glyphs.length, face4.icons.length);
  const face5 = lock.values.at(5);
  const positions5 = facePositions(face5.glyphs.length, face5.icons.length);

  return (
    <>
      <sprite x={0} y="center" w={LockLayout.JOIN_WIDTH} h={LockLayout.STRIP_HEIGHT} sprite={LockSprites.EDGE} />

      <sprite x={10} y="center" w={LockLayout.DIAL_WIDTH} h={LockLayout.STRIP_HEIGHT} sprite={LockSprites.DIAL} />

      {lock.valueType === 0 ? (
        <text
          x={10 + LockLayout.GLYPH_X}
          y={{ center: LockLayout.CENTRE_Y }}
          w={LockLayout.GLYPH_WIDTH}
          h={LockLayout.GLYPH_HEIGHT}
          text={face0.glyphs.at(value0) ?? ''}
          font={LockFonts.GLYPH}
          color={LockColors.GLYPH}
          shadow
          align="center"
          valign="middle"
        />
      ) : (
        <sprite
          x={10 + LockLayout.ICON_X}
          y={{ center: LockLayout.CENTRE_Y }}
          w={LockLayout.ICON_WIDTH}
          h={LockLayout.ICON_HEIGHT}
          sprite={face0.icons.at(value0) ?? -1}
        />
      )}

      <sprite
        x={10 + LockLayout.ARROW_X}
        y={{ center: LockLayout.BELOW_ARROW_Y }}
        w={LockLayout.ARROW_SIZE}
        h={LockLayout.ARROW_SIZE}
        sprite={LockSprites.ARROW_DOWN}
        options={['Turn Dial']}
        onMouseRepeat={(event) => {
          graphicSwapperUnlessMobile(event.component, LockSprites.ARROW_DOWN_LIT);
        }}
        onMouseLeave={(event) => {
          graphicSwapperUnlessMobile(event.component, LockSprites.ARROW_DOWN);
        }}
        onOptionSelect={() => {
          setValue0(offsetIndex(value0, positions0, -1));
          playSound(LockSounds.DIAL_TURN);
        }}
      />
      <sprite
