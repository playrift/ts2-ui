        onOptionSelect={() => {
          setValue5(offsetIndex(value5, positions5, 1));
          playSound(LockSounds.DIAL_TURN);
        }}
      />

      {lock.valueType === 0 ? (
        <>
          <text
            x={290 + LockLayout.GLYPH_X}
            y={{ center: LockLayout.BELOW_GLYPH_Y }}
            w={LockLayout.GLYPH_WIDTH}
            h={LockLayout.GLYPH_HEIGHT}
            text={face5.glyphs.at(offsetIndex(value5, positions5, -1)) ?? ''}
            font={LockFonts.GLYPH}
            color={LockColors.GLYPH}
            shadow
            align="center"
            valign="middle"
          />
          <text
            x={290 + LockLayout.GLYPH_X}
            y={{ center: LockLayout.ABOVE_GLYPH_Y }}
            w={LockLayout.GLYPH_WIDTH}
            h={LockLayout.GLYPH_HEIGHT}
            text={face5.glyphs.at(offsetIndex(value5, positions5, 1)) ?? ''}
            font={LockFonts.GLYPH}
            color={LockColors.GLYPH}
            shadow
            align="center"
            valign="middle"
          />
        </>
      ) : (
        <>
          <sprite
            x={290 + LockLayout.ICON_X}
            y={{ center: LockLayout.BELOW_GLYPH_Y }}
            w={LockLayout.ICON_WIDTH}
            h={LockLayout.ICON_HEIGHT}
            sprite={face5.icons.at(offsetIndex(value5, positions5, -1)) ?? -1}
          />
          <sprite
            x={290 + LockLayout.ICON_X}
            y={{ center: LockLayout.ABOVE_GLYPH_Y }}
            w={LockLayout.ICON_WIDTH}
            h={LockLayout.ICON_HEIGHT}
            sprite={face5.icons.at(offsetIndex(value5, positions5, 1)) ?? -1}
          />
        </>
      )}

      <sprite
        x={290 + LockLayout.DIAL_WIDTH}
        y="center"
        w={LockLayout.JOIN_WIDTH}
        h={LockLayout.STRIP_HEIGHT}
        sprite={LockSprites.END}
      />
    </>
  );
}
