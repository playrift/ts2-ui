import { useState } from 'ts2';

import { directionalLockInput, directionalLockLength } from '../lib/game/varcs';
import { LockLayout, StripLayout } from './directional-lock.constants';
import { arrowFor, zeroed } from './directional-lock.state';

export function CodeStrip(): Component {
  const [rawLength] = useState(directionalLockLength);
  const [rawInput] = useState(directionalLockInput);
  const length: Int = zeroed(rawLength);
  const input: Int = zeroed(rawInput);

  return (
    <layer w="fill" h="fill">
      <layer
        x="center"
        y="center"
        w={length * StripLayout.PITCH + StripLayout.WIDTH_PAD}
        h={{ fill: LockLayout.STRIP_INNER_INSET_Y }}
      >
        {CodeSlots.map((slot) =>
          slot < length ? (
            <sprite
              x={slot * StripLayout.PITCH + StripLayout.INSET}
              y="center"
              w={StripLayout.ICON_BOX}
              h={StripLayout.ICON_BOX}
              sprite={arrowFor(input, slot)}
            />
          ) : null,
        )}
      </layer>
    </layer>
  );
}

const CodeSlots = [0, 1, 2, 3, 4, 5, 6, 7, 8];
