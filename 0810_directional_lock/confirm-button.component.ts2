import { CS2, useState } from 'ts2';

import { directionalLockInput, directionalLockLength } from '../lib/game/varcs';
import { clientClock, playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import {
  CONFIRM_PENDING_LABEL,
  DEBOUNCE,
  LockColors,
  LockFonts,
  LockSounds,
  LockText,
} from './directional-lock.constants';
import { zeroed } from './directional-lock.state';

export function ConfirmButton(): Component {
  const [pendingUntil, setPendingUntil] = useState(0);
  const [pressed, setPressed] = useState(0);

  const [rawInput] = useState(directionalLockInput);
  const [rawLength] = useState(directionalLockLength);
  const input: Int = zeroed(rawInput);
  const length: Int = zeroed(rawLength);

  if (clientClock() < pendingUntil) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonPressedFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={CONFIRM_PENDING_LABEL}
          font={LockFonts.BUTTON}
          color={LockColors.BUTTON_LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[LockText.CONFIRM]}
        onOptionSelect={() => {
          if (length <= 0) {
            playSound(LockSounds.WRONG);
            return;
          }
          playSound(LockSounds.ATTEMPT);
          CS2.countdialog_resume(CS2.tostring(input * 10 + length));
          setPressed(0);
          setPendingUntil(clientClock() + DEBOUNCE);
        }}
      >
        <StoneButtonOutFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={LockText.CONFIRM}
          font={LockFonts.BUTTON}
          color={LockColors.BUTTON_LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[LockText.CONFIRM]}
      onMouseRepeat={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
      onOptionSelect={() => {
        if (length <= 0) {
          playSound(LockSounds.WRONG);
          return;
        }
        playSound(LockSounds.ATTEMPT);
        CS2.countdialog_resume(CS2.tostring(input * 10 + length));
        setPressed(0);
        setPendingUntil(clientClock() + DEBOUNCE);
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={LockText.CONFIRM}
        font={LockFonts.BUTTON}
        color={LockColors.BUTTON_LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
