import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { LockLayout } from './directional-lock.constants';
import { pressDirection } from './directional-lock.state';

export function DirectionButton({
  label,
  icon,
  direction,
}: {
  label: String;
  icon: Sprite;
  direction: Int;
}): Component {
  const [pressed, setPressed] = useState(0);

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[label]}
        onOptionSelect={() => {
          pressDirection(direction);
        }}
      >
        <StoneButtonOutFilled />
        <sprite x="center" y="center" w={LockLayout.ICON_BOX} h={LockLayout.ICON_BOX} sprite={icon} />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
      onOptionSelect={() => {
        pressDirection(direction);
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <sprite x="center" y="center" w={LockLayout.ICON_BOX} h={LockLayout.ICON_BOX} sprite={icon} />
    </layer>
  );
}
