import { CS2, useState } from 'ts2';

import { SteelborderSprite } from '../lib/lib.constants';
import { clientClock } from '../lib/lib.engine';
import { graphicSwapper, onMobile } from '../lib/lib.helpers';
import { CANCEL_COUNT, DEBOUNCE, LockLayout, LockText } from './directional-lock.constants';

export function DirectionalLockCloseButton(): Component {
  const [readyAt, setReadyAt] = useState(0);

  if (onMobile()) {
    return (
      <sprite
        right={LockLayout.CLOSE_MOBILE_INSET}
        y={LockLayout.CLOSE_MOBILE_INSET}
        w={LockLayout.CLOSE_MOBILE_BOX}
        h={LockLayout.CLOSE_MOBILE_BOX}
        sprite={SteelborderSprite.CLOSE_MOBILE}
        options={[LockText.CLOSE]}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, SteelborderSprite.CLOSE_MOBILE);
        }}
        onOptionSelect={() => {
          if (clientClock() < readyAt) {
            return;
          }
          CS2.countdialog_resume(CS2.tostring(CANCEL_COUNT));
          setReadyAt(clientClock() + DEBOUNCE);
        }}
      />
    );
  }

  return (
    <sprite
      right={LockLayout.CLOSE_RIGHT}
      y={LockLayout.CLOSE_Y}
      w={LockLayout.CLOSE_W}
      h={LockLayout.CLOSE_H}
      sprite={SteelborderSprite.CLOSE_OFF}
      hover={{ sprite: SteelborderSprite.CLOSE_HOVER }}
      options={[LockText.CLOSE]}
      onOptionSelect={() => {
        if (clientClock() < readyAt) {
          return;
        }
        CS2.countdialog_resume(CS2.tostring(CANCEL_COUNT));
        setReadyAt(clientClock() + DEBOUNCE);
      }}
    />
  );
}
