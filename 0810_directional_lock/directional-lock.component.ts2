import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { CodeStrip } from './code-strip.component';
import { ConfirmButton } from './confirm-button.component';
import { DirectionButton } from './direction-button.component';
import { DirectionalLockCloseButton } from './directional-lock-close-button.component';
import { ResetButton } from './reset-button.component';
import { Direction, LockColors, LockLayout, LockSprites, LockText } from './directional-lock.constants';

export function DirectionalLock(): Component {
  return (
    <layer x="center" y="center" w={LockLayout.WINDOW_W} h={LockLayout.WINDOW_H}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: LockLayout.WELL_INSET }} h={{ fill: LockLayout.WELL_INSET }}>
        <layer x="center" y={LockLayout.DIAL_Y} w={LockLayout.DIAL_BOX} h={LockLayout.DIAL_BOX}>
          <sprite x="center" y="center" w={LockLayout.BODY_W} h={LockLayout.BODY_H} sprite={LockSprites.BODY} />

          <layer x="center" y={LockLayout.ARROW_INSET} w={LockLayout.ARROW_BOX} h={LockLayout.ARROW_BOX}>
            <DirectionButton label={LockText.UP} icon={LockSprites.ARROW_UP} direction={Direction.UP} />
          </layer>

          <layer x="center" y={{ bottom: LockLayout.ARROW_INSET }} w={LockLayout.ARROW_BOX} h={LockLayout.ARROW_BOX}>
            <DirectionButton label={LockText.DOWN} icon={LockSprites.ARROW_DOWN} direction={Direction.DOWN} />
          </layer>

          <layer x={LockLayout.ARROW_INSET} y="center" w={LockLayout.ARROW_BOX} h={LockLayout.ARROW_BOX}>
            <DirectionButton label={LockText.LEFT} icon={LockSprites.ARROW_LEFT} direction={Direction.LEFT} />
          </layer>

          <layer x={{ right: LockLayout.ARROW_INSET }} y="center" w={LockLayout.ARROW_BOX} h={LockLayout.ARROW_BOX}>
            <DirectionButton label={LockText.RIGHT} icon={LockSprites.ARROW_RIGHT} direction={Direction.RIGHT} />
          </layer>
        </layer>

        <layer x="center" y={{ bottom: LockLayout.STRIP_BOTTOM }} w={LockLayout.STRIP_W} h={LockLayout.STRIP_H}>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            fill
            color={LockColors.STRIP_BACKING}
            transparency={LockLayout.STRIP_BACKING_TRANSPARENCY}
          />
          <CodeStrip />
          <ThinBoxEntrypoint />
        </layer>

        <layer
          x={{ center: -LockLayout.BUTTON_SPREAD }}
          y={{ bottom: LockLayout.BUTTON_BOTTOM }}
          w={LockLayout.BUTTON_W}
          h={LockLayout.BUTTON_H}
        >
          <ResetButton />
        </layer>

        <layer
          x={{ center: LockLayout.BUTTON_SPREAD }}
          y={{ bottom: LockLayout.BUTTON_BOTTOM }}
          w={LockLayout.BUTTON_W}
          h={LockLayout.BUTTON_H}
        >
          <ConfirmButton />
        </layer>
      </layer>

      <DirectionalLockCloseButton />
    </layer>
  );
}
