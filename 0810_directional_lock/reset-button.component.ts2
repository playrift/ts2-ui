import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { LockColors, LockFonts, LockText } from './directional-lock.constants';
import { resetCode } from './directional-lock.state';

export function ResetButton(): Component {
  const [pressed, setPressed] = useState(0);

  if (onMobile()) {
    return (
      <layer
        w="fill"
        h="fill"
        options={[LockText.RESET]}
        onOptionSelect={() => {
          resetCode();
        }}
      >
        <StoneButtonOutFilled />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={LockText.RESET}
          font={LockFonts.BUTTON}
          color={LockColors.BUTTON_LABEL}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[LockText.RESET]}
      onMouseRepeat={() => {
        setPressed(1);
      }}
      onMouseLeave={() => {
        setPressed(0);
      }}
      onOptionSelect={() => {
        resetCode();
      }}
    >
      {pressed !== 0 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={LockText.RESET}
        font={LockFonts.BUTTON}
        color={LockColors.BUTTON_LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
