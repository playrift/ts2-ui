import { COLUMN_LABELS, LockColors, LockFonts, LockLayout } from './lockpicking.constants';

export function ColumnHeader({ cellWidth }: { cellWidth: Int }): Component {
  return (
    <layer x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }}>
      {COLUMN_LABELS.map((label, index) => (
        <>
          <rect
            x={index * (cellWidth - 1)}
            y="bottom"
            w={cellWidth}
            h={LockLayout.CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />
          <text
            x={index * (cellWidth - 1)}
            y="bottom"
            w={cellWidth}
            h={LockLayout.CELL_HEIGHT}
            text={label}
            font={LockFonts.LABEL}
            color={LockColors.LABEL}
            shadow
            align="center"
            valign="middle"
          />
        </>
      ))}
    </layer>
  );
}
