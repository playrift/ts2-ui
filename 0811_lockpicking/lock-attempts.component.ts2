import { CS2, useState } from 'ts2';

import {
  lockpickingHint1,
  lockpickingHint2,
  lockpickingHint3,
  lockpickingHint4,
  lockpickingHint5,
  lockpickingHint6,
  lockpickingHint7,
  lockpickingHint8,
  lockpickingInput1,
  lockpickingInput2,
  lockpickingInput3,
  lockpickingInput4,
  lockpickingInput5,
  lockpickingInput6,
  lockpickingInput7,
  lockpickingInput8,
  lockpickingPin0,
} from '../lib/game/varcs';
import {
  HINT_TRANSPARENCY,
  LAST_ATTEMPT_ROW,
  LockColors,
  LockFonts,
  LockLayout,
  PIN_COLUMNS,
  VARC_UNSET,
} from './lockpicking.constants';

export function LockAttempts(): Component {
  const [input1] = useState(lockpickingInput1);
  const [hint1] = useState(lockpickingHint1);
  const [input2] = useState(lockpickingInput2);
  const [hint2] = useState(lockpickingHint2);
  const [input3] = useState(lockpickingInput3);
  const [hint3] = useState(lockpickingHint3);
  const [input4] = useState(lockpickingInput4);
  const [hint4] = useState(lockpickingHint4);
  const [input5] = useState(lockpickingInput5);
  const [hint5] = useState(lockpickingHint5);
  const [input6] = useState(lockpickingInput6);
  const [hint6] = useState(lockpickingHint6);
  const [input7] = useState(lockpickingInput7);
  const [hint7] = useState(lockpickingHint7);
  const [input8] = useState(lockpickingInput8);
  const [hint8] = useState(lockpickingHint8);

  const [pin0] = useState(lockpickingPin0);
  if (pin0 === VARC_UNSET) {
    return null;
  }

  return (
    <>
      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 0 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input1 >= 0 && (hint1 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 0 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint1 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input1 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 0 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input1 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 1 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input2 >= 0 && (hint2 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 1 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint2 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input2 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 1 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input2 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 2 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input3 >= 0 && (hint3 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 2 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint3 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input3 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 2 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input3 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 3 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input4 >= 0 && (hint4 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 3 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint4 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input4 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 3 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input4 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 4 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input5 >= 0 && (hint5 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 4 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint5 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input5 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 4 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input5 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 5 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input6 >= 0 && (hint6 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 5 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint6 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input6 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 5 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input6 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 6 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input7 >= 0 && (hint7 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 6 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint7 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input7 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 6 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input7 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <>
          <rect
            x={column * LockLayout.ATTEMPT_STEP}
            y={{ bottom: 7 * LockLayout.ATTEMPT_STEP }}
            w={LockLayout.ATTEMPT_CELL}
            h={LockLayout.ATTEMPT_CELL}
            color={LockColors.LATTICE}
            fill={false}
          />

          {input8 >= 0 && (hint8 / CS2.pow(3, column)) % 3 !== 0 && (
            <rect
              x={column * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET}
              y={{ bottom: 7 * LockLayout.ATTEMPT_STEP + LockLayout.HINT_INSET }}
              w={LockLayout.HINT_SIZE}
              h={LockLayout.HINT_SIZE}
              fill
              transparency={HINT_TRANSPARENCY}
              color={(hint8 / CS2.pow(3, column)) % 3 === 2 ? LockColors.HINT_CORRECT : LockColors.HINT_PARTIAL}
            />
          )}

          {input8 >= 0 && (
            <text
              x={column * LockLayout.ATTEMPT_STEP}
              y={{ bottom: 7 * LockLayout.ATTEMPT_STEP }}
              w={LockLayout.ATTEMPT_CELL}
              h={LockLayout.ATTEMPT_TEXT_HEIGHT}
              text={stringOf(((input8 / CS2.pow(6, column)) % 6) + 1)}
              font={LockFonts.BODY}
              color={LockColors.DIGIT}
              shadow
              align="center"
              valign="middle"
            />
          )}
        </>
      ))}

      {PIN_COLUMNS.map((column) => (
        <rect
          x={column * LockLayout.ATTEMPT_STEP}
          y={{ bottom: LAST_ATTEMPT_ROW * LockLayout.ATTEMPT_STEP }}
          w={LockLayout.ATTEMPT_CELL}
          h={LockLayout.ATTEMPT_CELL}
          color={LockColors.LATTICE}
          fill={false}
        />
      ))}
    </>
  );
}
