import { useState } from 'ts2';

import {
  lockpickingPin0,
  lockpickingPin1,
  lockpickingPin2,
  lockpickingPin3,
  lockpickingPin4,
  lockpickingPin5,
} from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import {
  LockColors,
  LockFonts,
  LockLayout,
  LockSounds,
  LockSprites,
  PIN_CLICK_TRANSPARENCY,
  PIN_POSITIONS,
  VARC_UNSET,
} from './lockpicking.constants';
import { minmax } from './lockpicking.state';

export function LockPins(): Component {
  const [pinA, setPinA] = useState(lockpickingPin0);
  const [pinB, setPinB] = useState(lockpickingPin1);
  const [pinC, setPinC] = useState(lockpickingPin2);
  const [pinD, setPinD] = useState(lockpickingPin3);
  const [pinE, setPinE] = useState(lockpickingPin4);
  const [pinF, setPinF] = useState(lockpickingPin5);

  if (pinA === VARC_UNSET) {
    return null;
  }

  return (
    <>
      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={0 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinA && (
            <>
              <sprite
                x={0 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={0 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinA + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinA && (
            <sprite
              x={0 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={0 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin A']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinA(minmax(0, 5, step));
            }}
          />
        </>
      ))}

      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={1 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinB && (
            <>
              <sprite
                x={1 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={1 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinB + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinB && (
            <sprite
              x={1 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={1 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin B']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinB(minmax(0, 5, step));
            }}
          />
        </>
      ))}

      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={2 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinC && (
            <>
              <sprite
                x={2 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={2 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinC + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinC && (
            <sprite
              x={2 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={2 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin C']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinC(minmax(0, 5, step));
            }}
          />
        </>
      ))}

      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={3 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinD && (
            <>
              <sprite
                x={3 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={3 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinD + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinD && (
            <sprite
              x={3 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={3 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin D']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinD(minmax(0, 5, step));
            }}
          />
        </>
      ))}

      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={4 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinE && (
            <>
              <sprite
                x={4 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={4 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinE + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinE && (
            <sprite
              x={4 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={4 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin E']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinE(minmax(0, 5, step));
            }}
          />
        </>
      ))}

      {PIN_POSITIONS.map((step) => (
        <>
          <rect
            x={5 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CELL_WIDTH}
            h={LockLayout.PIN_CELL_HEIGHT}
            color={LockColors.LATTICE}
            fill={false}
          />

          {step === pinF && (
            <>
              <sprite
                x={5 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                sprite={LockSprites.PIN_SET}
              />
              <text
                x={5 * LockLayout.PIN_COLUMN_STEP}
                y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
                w={LockLayout.PIN_CELL_WIDTH}
                h={LockLayout.PIN_CELL_HEIGHT}
                text={stringOf(pinF + 1)}
                font={LockFonts.LABEL}
                color={LockColors.DIGIT}
                shadow
                align="center"
                valign="middle"
              />
            </>
          )}

          {step > pinF && (
            <sprite
              x={5 * LockLayout.PIN_COLUMN_STEP}
              y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
              w={LockLayout.PIN_CELL_WIDTH}
              h={LockLayout.PIN_CELL_HEIGHT}
              sprite={LockSprites.PIN_EMPTY}
            />
          )}

          <rect
            x={5 * LockLayout.PIN_COLUMN_STEP}
            y={{ bottom: step * LockLayout.PIN_ROW_STEP }}
            w={LockLayout.PIN_CLICK_WIDTH}
            h={LockLayout.PIN_CLICK_HEIGHT}
            color={LockColors.PIN_CLICK}
            fill
            transparency={PIN_CLICK_TRANSPARENCY}
            options={['Adjust Pin F']}
            onOptionSelect={() => {
              playSound(LockSounds.ADJUST_PIN);
              setPinF(minmax(0, 5, step));
            }}
          />
        </>
      ))}
    </>
  );
}
