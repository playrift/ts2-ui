import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ColumnHeader } from './column-header.component';
import { ConfirmButton } from './confirm-button.component';
import { LockAttempts } from './lock-attempts.component';
import { LockPins } from './lock-pins.component';
import { LockpickingCloseButton } from './lockpicking-close-button.component';
import { BACKDROP_TRANSPARENCY, LockColors, LockLayout } from './lockpicking.constants';
import { SteelFrame } from './steel-frame.component';

export function Lockpicking(): Component {
  return (
    <layer x="center" y="center" w={352} h={282}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: 12 }} h={{ fill: 12 }}>
        <layer x={25} y="center" w={165} h={220}>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={LockColors.BACKDROP}
            fill
            transparency={BACKDROP_TRANSPARENCY}
          />

          <layer x="center" y={0} w="fill" h={26}>
            <ColumnHeader cellWidth={LockLayout.PIN_CELL_WIDTH} />
            <ThinBoxEntrypoint />
          </layer>

          <layer x="center" y="bottom" w="fill" h={{ fill: 25 }}>
            <layer x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }}>
              <LockPins />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
        </layer>

        <layer right={25} y={25} w={111} h={172}>
          <rect
            x="center"
            y="center"
            w="fill"
            h="fill"
            color={LockColors.BACKDROP}
            fill
            transparency={BACKDROP_TRANSPARENCY}
          />

          <layer x="center" y={0} w="fill" h={26}>
            <ColumnHeader cellWidth={LockLayout.ATTEMPT_CELL_WIDTH} />
            <ThinBoxEntrypoint />
          </layer>

          <layer x="center" y="bottom" w="fill" h={{ fill: 25 }}>
            <layer x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }}>
              <LockAttempts />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
        </layer>

        <layer right={25} bottom={25} w={111} h={34}>
          <ConfirmButton />
        </layer>
      </layer>

      <LockpickingCloseButton />
    </layer>
  );
}
