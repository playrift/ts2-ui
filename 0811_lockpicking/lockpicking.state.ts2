import { CS2, useState } from 'ts2';

import {
  lockpickingHint1,
  lockpickingHint2,
  lockpickingHint3,
  lockpickingHint4,
  lockpickingHint5,
  lockpickingHint6,
  lockpickingHint7,
  lockpickingHint8,
  lockpickingInput1,
  lockpickingInput2,
  lockpickingInput3,
  lockpickingInput4,
  lockpickingInput5,
  lockpickingInput6,
  lockpickingInput7,
  lockpickingInput8,
  lockpickingPin0,
  lockpickingPin1,
  lockpickingPin2,
  lockpickingPin3,
  lockpickingPin4,
  lockpickingPin5,
} from '../lib/game/varcs';

export function minmax(low: Int, high: Int, value: Int): Int {
  if (high <= low) {
    return Math.max(high, Math.min(low, value));
  }
  return Math.max(low, Math.min(high, value));
}

export function packPins(
  d9: Int,
  d8: Int,
  d7: Int,
  d6: Int,
  d5: Int,
  d4: Int,
  d3: Int,
  d2: Int,
  d1: Int,
  d0: Int,
): Int {
  return (
    minmax(0, 5, d9) * CS2.pow(6, 9) +
    minmax(0, 5, d8) * CS2.pow(6, 8) +
    minmax(0, 5, d7) * CS2.pow(6, 7) +
    minmax(0, 5, d6) * CS2.pow(6, 6) +
    minmax(0, 5, d5) * CS2.pow(6, 5) +
    minmax(0, 5, d4) * CS2.pow(6, 4) +
    minmax(0, 5, d3) * CS2.pow(6, 3) +
    minmax(0, 5, d2) * CS2.pow(6, 2) +
    minmax(0, 5, d1) * 6 +
    minmax(0, 5, d0)
  );
}

export function resetLock(): void {
  const [, setPin0] = useState(lockpickingPin0);
  const [, setPin1] = useState(lockpickingPin1);
  const [, setPin2] = useState(lockpickingPin2);
  const [, setPin3] = useState(lockpickingPin3);
  const [, setPin4] = useState(lockpickingPin4);
  const [, setPin5] = useState(lockpickingPin5);
  const [, setInput1] = useState(lockpickingInput1);
  const [, setInput2] = useState(lockpickingInput2);
  const [, setInput3] = useState(lockpickingInput3);
  const [, setInput4] = useState(lockpickingInput4);
  const [, setInput5] = useState(lockpickingInput5);
  const [, setInput6] = useState(lockpickingInput6);
  const [, setInput7] = useState(lockpickingInput7);
  const [, setInput8] = useState(lockpickingInput8);
  const [, setHint1] = useState(lockpickingHint1);
  const [, setHint2] = useState(lockpickingHint2);
  const [, setHint3] = useState(lockpickingHint3);
  const [, setHint4] = useState(lockpickingHint4);
  const [, setHint5] = useState(lockpickingHint5);
  const [, setHint6] = useState(lockpickingHint6);
  const [, setHint7] = useState(lockpickingHint7);
  const [, setHint8] = useState(lockpickingHint8);

  setPin0(0);
  setPin1(0);
  setPin2(0);
  setPin3(0);
  setPin4(0);
  setPin5(0);
  setInput1(0);
  setInput2(0);
  setInput3(0);
  setInput4(0);
  setInput5(0);
  setInput6(0);
  setInput7(0);
  setInput8(0);
  setHint1(0);
  setHint2(0);
  setHint3(0);
  setHint4(0);
  setHint5(0);
  setHint6(0);
  setHint7(0);
  setHint8(0);
}

export function recordAttempt(row: Int, input: Int, hint: Int): void {
  const [, setInput1] = useState(lockpickingInput1);
  const [, setHint1] = useState(lockpickingHint1);
  const [, setInput2] = useState(lockpickingInput2);
  const [, setHint2] = useState(lockpickingHint2);
  const [, setInput3] = useState(lockpickingInput3);
  const [, setHint3] = useState(lockpickingHint3);
  const [, setInput4] = useState(lockpickingInput4);
  const [, setHint4] = useState(lockpickingHint4);
  const [, setInput5] = useState(lockpickingInput5);
  const [, setHint5] = useState(lockpickingHint5);
  const [, setInput6] = useState(lockpickingInput6);
  const [, setHint6] = useState(lockpickingHint6);
  const [, setInput7] = useState(lockpickingInput7);
  const [, setHint7] = useState(lockpickingHint7);
  const [, setInput8] = useState(lockpickingInput8);
  const [, setHint8] = useState(lockpickingHint8);

  if (row === 0) {
    setInput1(input);
    setHint1(hint);
  } else if (row === 1) {
    setInput2(input);
    setHint2(hint);
  } else if (row === 2) {
    setInput3(input);
    setHint3(hint);
  } else if (row === 3) {
    setInput4(input);
    setHint4(hint);
  } else if (row === 4) {
    setInput5(input);
    setHint5(hint);
  } else if (row === 5) {
    setInput6(input);
    setHint6(hint);
  } else if (row === 6) {
    setInput7(input);
    setHint7(hint);
  } else if (row === 7) {
    setInput8(input);
    setHint8(hint);
  }
}
