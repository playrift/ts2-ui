import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, SotnArt, SotnColors, SotnFonts, SotnModels, SotnText } from './sotn-numbers.constants';

export function SotnNumbers(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
        <model
          x={{ center: Layout.PARCHMENT_DX }}
          y={{ center: Layout.PARCHMENT_DY }}
          w={Layout.PARCHMENT}
          h={Layout.PARCHMENT}
          model={SotnModels.PARCHMENT}
          pitch={Layout.PARCHMENT_PITCH}
          zoom={Layout.PARCHMENT_ZOOM}
        />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SotnArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, SotnArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, SotnArt.CLOSE)}
        />

        <layer
          x={{ center: Layout.CONTENT_DX }}
          y={{ center: Layout.CONTENT_DY }}
          w={Layout.CONTENT_W}
          h={Layout.CONTENT_H}
        >
          <text
            x="center"
            y="center"
            w={Layout.NUMBER_W}
            h={Layout.NUMBER_H}
            text={SotnText.NUMBER}
            font={SotnFonts.NUMBER}
            color={SotnColors.INK}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <text
          x={Layout.HINT_X}
          y={Layout.HINT_Y}
          w={Layout.HINT_W}
          h={Layout.HINT_H}
          text={SotnText.HINT}
          font={SotnFonts.HINT}
          color={SotnColors.INK}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    </layer>
  );
}
