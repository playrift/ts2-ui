import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, SotnMapArt, SotnMapColors, SotnMapFonts, SotnMapText } from './sotn-map.constants';

export function SotnMap(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <sprite x="center" y="center" w={Layout.MAP_W} h={Layout.MAP_H} sprite={SotnMapArt.MAP} />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={SotnMapArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, SotnMapArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, SotnMapArt.CLOSE)}
        />

        <text
          x={Layout.GHORROCK_X}
          y={Layout.GHORROCK_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.GHORROCK}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.ANNAKARL_X}
          y={Layout.ANNAKARL_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.ANNAKARL}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.CARRALLANGER_X}
          y={Layout.CARRALLANGER_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.CARRALLANGER}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.DAREEYAK_X}
          y={Layout.DAREEYAK_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.DAREEYAK}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.LASSAR_X}
          y={Layout.LASSAR_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.LASSAR}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.KHARYRLL_X}
          y={Layout.KHARYRLL_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.KHARYRLL}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.SENNTISTEN_X}
          y={Layout.SENNTISTEN_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.SENNTISTEN}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.PADDEWWA_X}
          y={Layout.PADDEWWA_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.PADDEWWA}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.KHARID_ET_X}
          y={Layout.KHARID_ET_Y}
          w={Layout.LABEL_W}
          h={Layout.LABEL_H}
          text={SotnMapText.KHARID_ET}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
        <text
          x={Layout.HINT_X}
          y={Layout.HINT_Y}
          w={Layout.HINT_W}
          h={Layout.LABEL_H}
          text={SotnMapText.HINT}
          font={SotnMapFonts.LABEL}
          color={SotnMapColors.INK}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    </layer>
  );
}
