import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { CrestArt, CrestCamera, CrestLayout, CrestModels } from './sotn-crest.constants';

export function SotnCrest(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={CrestLayout.PANEL_W} h={CrestLayout.PANEL_H}>
        <model
          x={{ center: CrestLayout.MODEL_X }}
          y={{ center: CrestLayout.MODEL_Y }}
          w={CrestLayout.MODEL_SIZE}
          h={CrestLayout.MODEL_SIZE}
          model={CrestModels.CREST}
          zoom={CrestCamera.ZOOM}
          pitch={CrestCamera.PITCH}
        />

        <sprite
          x={{ right: CrestLayout.CLOSE_RIGHT }}
          y={CrestLayout.CLOSE_TOP}
          w={CrestLayout.CLOSE_W}
          h={CrestLayout.CLOSE_H}
          sprite={CrestArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, CrestArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, CrestArt.CLOSE);
          }}
        />
      </layer>
    </layer>
  );
}
