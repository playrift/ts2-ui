import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Layout,
  LeftRows,
  ListArt,
  ListColors,
  ListFonts,
  ListModels,
  ListText,
  RightRows,
} from './sotn-list.constants';

export function SotnList(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
        <model
          x={{ center: Layout.PARCHMENT_DX }}
          y={{ center: Layout.PARCHMENT_DY }}
          w={Layout.PARCHMENT}
          h={Layout.PARCHMENT}
          model={ListModels.PARCHMENT}
          pitch={Layout.PARCHMENT_PITCH}
          zoom={Layout.PARCHMENT_ZOOM}
        />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={ListArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, ListArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, ListArt.CLOSE)}
        />

        <layer
          x={{ center: Layout.CONTENT_DX }}
          y={{ center: Layout.CONTENT_DY }}
          w={Layout.CONTENT_W}
          h={Layout.CONTENT_H}
        >
          {LeftRows.map((row) => (
            <layer x={Layout.ROW_X} y={row.y} w={Layout.ROW_W} h={Layout.ROW_H}>
              <sprite x={0} y="center" w={Layout.MARK} h={Layout.MARK} sprite={row.mark} />
              <text
                x="right"
                y={{ center: Layout.NAME_DY }}
                w={{ fill: Layout.NAME_INSET }}
                h={Layout.NAME_H}
                text={row.name}
                font={ListFonts.INK}
                color={ListColors.INK}
                valign="middle"
                shadow
              />
            </layer>
          ))}

          {RightRows.map((row) => (
            <layer x={{ right: Layout.ROW_X }} y={row.y} w={Layout.ROW_W} h={Layout.ROW_H}>
              <sprite x={0} y="center" w={Layout.MARK} h={Layout.MARK} sprite={row.mark} />
              <text
                x="right"
                y={{ center: Layout.NAME_DY }}
                w={{ fill: Layout.NAME_INSET }}
                h={Layout.NAME_H}
                text={row.name}
                font={ListFonts.INK}
                color={ListColors.INK}
                valign="middle"
                shadow
              />
            </layer>
          ))}
        </layer>

        <text
          x={{ right: Layout.HINT_RIGHT }}
          y={Layout.HINT_TOP}
          w={Layout.HINT_W}
          h={Layout.HINT_H}
          text={ListText.HINT}
          font={ListFonts.INK}
          color={ListColors.INK}
          align="center"
          valign="middle"
          shadow
        />
      </layer>
    </layer>
  );
}
