import { Fade, OverlayColor } from './muspah-overlay.constants';
import { fadeTintBox } from './muspah-overlay.helpers';

export function MuspahOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        w="fill"
        h="fill"
        color={OverlayColor.TINT}
        fill={true}
        transparency={Fade.REST}
        onTimer={(event) => fadeTintBox(event.component)}
      />

      <rect x="center" y="center" w="fill" h="fill" color={OverlayColor.BLACK} fill={true} transparency={Fade.REST} />

      <rect x="center" y="center" w="fill" h="fill" color={OverlayColor.BLACK} fill={true} transparency={Fade.REST} />
    </layer>
  );
}
