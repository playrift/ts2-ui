import { CS2, useState } from 'ts2';
import { muspahOverlayFade } from '../lib/game/varcs';
import { Fade } from './muspah-overlay.constants';

export function fadeTintBox(box: ComponentId): void {
  const [target] = useState(muspahOverlayFade);
  if (CS2.if_trans_get(box) > target) {
    CS2.if_transparency_set(Math.max(Fade.FLOOR, CS2.if_trans_get(box) - 1), box);
  } else if (CS2.if_trans_get(box) < target) {
    CS2.if_transparency_set(Math.min(Fade.REST, CS2.if_trans_get(box) + 1), box);
  }
}
