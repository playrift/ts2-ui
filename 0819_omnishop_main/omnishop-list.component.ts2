import { CS2, useRef, useServerState, useState, useUniverse } from 'ts2';
import { StructBoxFrame } from '../0823_forestry_kit_main/struct-box-frame.component';
import { CellBoxes } from '../0823_forestry_kit_main/cell-box.data';
import { itemName } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Sprites } from '../lib/game/sprites';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { OmnishopShops, OmnishopStock, ShopStockSlots, StockFilterIds } from './omnishop.data';
import { ShopColors, ShopFonts } from './omnishop-main.constants';
import { omnishopListSelect } from './omnishop-main.entry';
import { lineHidden, slotObj, slotStockCount, stockLineAt } from './omnishop-main.helpers';
import { omnishopCalls, omnishopInventory, omnishopSelectedSlot, omnishopShop } from './omnishop-main.state';

const enum Card {
  GAP = 3,
  HEIGHT = 74,
  HEIGHT_EXPANDED = 50,
  TARGET_W = 110,
  TARGET_W_EXPANDED = 54,
  ICON_DY = 7,
  ICON_W = 36,
  ICON_H = 32,
  NAME_X = 7,
  NAME_Y = 34,
  NAME_TRIM = 14,
  NAME_H = 40,
  NAME_LINE = 16,
  SHADOW = 0x333333,
  PANE_X = 2,
  PANE_INSET_W = 19,
  PANE_INSET_H = 4,
  SCROLLER_W = 16,
}

export function slotShown(shopIndex: Int, inventory: Int, slot: Int, filter: Int): Boolean {
  const item: Item = slotObj(shopIndex, inventory, slot);
  if ((item as Int) === -1) {
    return false;
  }
  const line: Int = stockLineAt(shopIndex, slot);
  if (line < 0) {
    return filter <= 0;
  }
  const row = OmnishopStock.at(line);
  if (row === null) {
    return false;
  }
  if (filter > 0) {
    let matched: Boolean = false;
    let index: Int = 0;
    while (index < row.filterCount) {
      const id: Int = StockFilterIds.at(row.filterBase + index) ?? -1;
      if (id === filter) {
        matched = true;
      }
      index = index + 1;
    }
    if (!matched) {
      return false;
    }
  }
  if (!row.buyable) {
    return false;
  }
  if (row.restrictedUim !== 0) {
    const ironman: Int = useServerState(Varbits.IRONMAN);
    if (row.restrictedUim === 1 && ironman === 2) {
      return false;
    }
    if (row.restrictedUim === 2 && ironman !== 2) {
      return false;
    }
  }
  return !lineHidden(line, item);
}

export function slotName(shopIndex: Int, inventory: Int, slot: Int, forCard: Boolean): String {
  const item: Item = slotObj(shopIndex, inventory, slot);
  let name: String = item.shopDisplayName ?? '';
  const line: Int = stockLineAt(shopIndex, slot);
  const row = OmnishopStock.at(line);
  let multiplier: Int = 1;
  if (row !== null) {
    if (CS2.string_length(row.nameOverride) > 0) {
      name = row.nameOverride;
    }
    multiplier = row.multiplier;
  }
  if (CS2.string_length(name) === 0) {
    name = itemName(item);
  }
  if (forCard && row !== null) {
    if (row.useShortname) {
      name = row.shortname;
    }
  }
  if (multiplier > 1) {
    name = `${name} (x${CS2.tostring(multiplier)})`;
  }
  return name;
}

export function ShopList(): Component {
  const universe = useUniverse();
  const list = useRef();
  const [shopIndex] = useState(omnishopShop);
  const [inventory] = useState(omnishopInventory);
  const [selectedSlot] = useState(omnishopSelectedSlot);
  const [calls] = useState(omnishopCalls);
  const expanded: Int = useServerState(Varps.OMNISHOP_VIEW_EXPANDED);
  const filter: Int = useServerState(Varps.OMNISHOP_FILTER);
  const shop: Int = shopIndex;
  const inv: Int = inventory;
  const picked: Int = selectedSlot;
  const call: Int = calls;
  const mobile: Int = onMobile() ? 1 : 0;

  const paneWidth: Int = universe.width - Card.PANE_INSET_W;
  const target: Int = expanded === 1 ? Card.TARGET_W_EXPANDED : Card.TARGET_W;
  const height: Int = expanded === 1 ? Card.HEIGHT_EXPANDED : Card.HEIGHT;
  const columns: Int = Math.max(1, paneWidth / target);
  const cellWidth: Int = (paneWidth - (columns + 1) * Card.GAP) / columns;

  const shopRow = OmnishopShops.at(shop);
  let count: Int = 0;
  let base: Int = 0;
  if (shopRow !== null) {
    count = shopRow.stockCount;
    base = shopRow.stockBase;
  }
  let visible: Int = 0;
  let slot: Int = 0;
  while (slot < count) {
    if (slotShown(shop, inv, slot, filter)) {
      visible = visible + 1;
    }
    slot = slot + 1;
  }
  const rows: Int = (visible + columns - 1) / columns;
  const content: Int = visible > 0 ? rows * (height + Card.GAP) + Card.GAP : 0;

  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={0} fill transparency={200} />
      <layer x={0} y={0} w={{ fill: 15 }} h="fill">
        <ThinBoxEntrypoint />
      </layer>
      <layer
        ref={list}
        x={Card.PANE_X}
        y={Card.PANE_X}
        w={{ fill: Card.PANE_INSET_W }}
        h={{ fill: Card.PANE_INSET_H }}
        scrollHeight={content}
      >
        {call > 0 &&
          ShopStockSlots.filter((line, key) => key >= base && key < base + count).scan(
            (line, slot, visible) =>
              slotShown(shop, inv, slot, filter) && (
                <ShopCard
                  shopIndex={shop}
                  inventory={inv}
                  slot={slot}
                  visible={visible}
                  columns={columns}
                  cellWidth={cellWidth}
                  height={height}
                  selected={slot === picked && expanded === 0 ? 1 : 0}
                  mobile={mobile}
                  expanded={expanded}
                />
              ),
            (line, slot) => (slotShown(shop, inv, slot, filter) ? 1 : 0),
          )}
      </layer>
      <layer x="right" y={0} w={Card.SCROLLER_W} h="fill">
        <ScrollbarVertical
          content={list}
          track={Sprites.SCROLLBAR_DRAGGER_V2_3}
          capTopSprite={Sprites.SCROLLBAR_DRAGGER_V2_0}
          thumbSprite={Sprites.SCROLLBAR_DRAGGER_V2_1}
          capBottomSprite={Sprites.SCROLLBAR_DRAGGER_V2_2}
          arrowUp={Sprites.SCROLLBAR_V2_0}
          arrowDown={Sprites.SCROLLBAR_V2_1}
        />
      </layer>
    </>
  );
}

function ShopCard({
  shopIndex,
  inventory,
  slot,
  visible,
  columns,
  cellWidth,
  height,
  selected,
  mobile,
  expanded,
}: {
  shopIndex: Int;
  inventory: Int;
  slot: Int;
  visible: Int;
  columns: Int;
  cellWidth: Int;
  height: Int;
  selected: Int;
  mobile: Int;
  expanded: Int;
}): Component {
  const left: Int = (visible % columns) * (cellWidth + Card.GAP) + Card.GAP;
  const top: Int = (visible / columns) * (height + Card.GAP) + Card.GAP;
  const rest: Int = selected === 1 ? ShopColors.ORANGE : ShopColors.CARD;
  const hovered: Int = mobile === 1 || selected === 1 ? rest : ShopColors.CARD_HOVER;
  const item: Item = slotObj(shopIndex, inventory, slot);
  const stock: Int = slotStockCount(shopIndex, inventory, slot);
  const name: String = slotName(shopIndex, inventory, slot, true);
  const shop = OmnishopShops.at(shopIndex);
  let verb: String = 'Buy';
  if (shop !== null) {
    verb = shop.mainOpText;
  }
  const line: Int = stockLineAt(shopIndex, slot);
  const row = OmnishopStock.at(line);
  let shown: Item = item;
  if (row !== null) {
    if (row.displayObj !== -1) {
      shown = row.displayObj as Item;
    }
  }
  const unlimited: Boolean = stock === -1;
  const iconY: Int = Card.ICON_DY + (expanded === 1 ? 2 : 0);
  return (
    <layer x={left} y={top} w={cellWidth} h={height}>
      <rect
        x={1}
        y={1}
        w={cellWidth - 2}
        h={height - 2}
        fill
        color={rest}
        hover={{ color: hovered }}
        options={[
          'Select',
          stock > 0 || unlimited ? (stock === 1 ? verb : `${verb}-1`) : '',
          stock >= 5 || unlimited ? `${verb}-5` : '',
          stock >= 10 || unlimited ? `${verb}-10` : '',
          stock >= 50 || unlimited ? `${verb}-50` : '',
          '',
          '',
          '',
          '',
          'Examine',
        ]}
        optionSubject={`<col=ff9040>${name}</col>`}
        onOptionSelect={(event) => omnishopListSelect(selected === 1 ? -1 : slot, event.option)}
      />
      <StructBoxFrame x={0} y={0} w={cellWidth} h={height} style={CellBoxes.at(0)} />
      <sprite
        x={cellWidth / 2 - Card.ICON_W / 2 + 2}
        y={iconY}
        w={Card.ICON_W}
        h={Card.ICON_H}
        item={shown}
        itemCount={stock}
        outline={1}
        shadowColor={Card.SHADOW}
      />
      <text
        x={Card.NAME_X}
        y={Card.NAME_Y}
        w={cellWidth - Card.NAME_TRIM}
        h={Card.NAME_H}
        text={name}
        font={ShopFonts.P12}
        color={ShopColors.ORANGE}
        shadow
        align="center"
        valign="middle"
        lineHeight={Card.NAME_LINE}
        hide={expanded === 1}
      />
    </layer>
  );
}
