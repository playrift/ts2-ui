import { useServerState, useState } from 'ts2';
import { SteelBorder } from '../lib/steel-border.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Varps } from '../lib/game/varps';
import { OmnishopShops } from './omnishop.data';
import { ShopColors, ShopLayout } from './omnishop-main.constants';
import { ShopList } from './omnishop-list.component';
import { RightColumn } from './omnishop-info.component';
import { ControlBarContents } from './omnishop-controls.component';
import { omnishopShop } from './omnishop-main.state';

export function OmnishopMain(): Component {
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer x="center" y="center" w={ShopLayout.UNIVERSE_W} h={ShopLayout.UNIVERSE_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <FrameTitle />
        </layer>
        <layer
          x={ShopLayout.CONTENT_X}
          y={ShopLayout.CONTENT_Y}
          w={{ fill: ShopLayout.CONTENT_INSET_X }}
          h={{ fill: ShopLayout.CONTENT_INSET_Y }}
        >
          <ControlBar />
          <ListLayer />
        </layer>
        <RightColumn />
      </layer>
      <layer x={0} y={0} w="fill" h="fill" hide>
        <layer x={192} y={176} w={123} h={99} noClickThrough>
          <layer x={0} y={0} w={{ fill: 15 }} h="fill" />
          <layer x="right" y={0} w={16} h={99} />
        </layer>
      </layer>
    </layer>
  );
}

function FrameTitle(): Component {
  const [shopIndex] = useState(omnishopShop);
  const index: Int = shopIndex;
  const shop = OmnishopShops.at(index);
  let title: String = '';
  if (shop !== null) {
    title = shop.name;
  }
  return (
    <layer x="center" y="center" w="fill" h="fill">
      {index >= 0 ? <SteelBorder title={title} titleColor={ShopColors.ORANGE} flags={16} /> : null}
    </layer>
  );
}

function ControlBar(): Component {
  const expanded: Int = useServerState(Varps.OMNISHOP_VIEW_EXPANDED);
  let column: Int = ShopLayout.RIGHT_COL_W;
  if (expanded === 1) {
    column = ShopLayout.EXPANDED_COL;
  }
  return (
    <layer
      x={ShopLayout.PAD}
      y={ShopLayout.PAD}
      w={{ fill: column + ShopLayout.RIGHT_COL_GUTTER }}
      h={ShopLayout.CONTROL_H}
    >
      <ControlBarContents />
    </layer>
  );
}

function ListLayer(): Component {
  const expanded: Int = useServerState(Varps.OMNISHOP_VIEW_EXPANDED);
  let column: Int = ShopLayout.RIGHT_COL_W;
  if (expanded === 1) {
    column = ShopLayout.EXPANDED_COL;
  }
  return (
    <layer
      x={ShopLayout.PAD}
      y={{ bottom: ShopLayout.PAD }}
      w={{ fill: column + ShopLayout.RIGHT_COL_GUTTER }}
      h={{ fill: ShopLayout.LIST_INSET_Y }}
    >
      <ShopList />
    </layer>
  );
}
