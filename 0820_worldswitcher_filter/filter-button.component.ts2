import { CS2, useState } from 'ts2';
import { onMobile, opsound } from '../lib/lib.helpers';
import { playSound } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { dismissDialog } from '../0862_bond_convert/bond-convert.helpers';
import { Caption, FilterAction, FilterFonts } from './worldswitcher-filter.constants';

export function FilterButton({ action }: { action: Int }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;
  const label: String = action === FilterAction.CLEAR ? Caption.CLEAR : Caption.DONE;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => {
        if (action === FilterAction.CLEAR) {
          opsound(event.option, 2);
          return;
        }
        playSound(Sounds.CLICK);
        dismissDialog(0);
      }}
    >
      <StoneButtonDraw label={label} font={FilterFonts.BODY} pressed={skin} flags={0} />
    </layer>
  );
}
