import { CS2, predictServerState } from 'ts2';
import { textWidth } from '../lib/lib.engine';
import { FilterFonts, FilterPage, FilterVarbits, IconSize, Layout } from './worldswitcher-filter.constants';
import { WorldFilterCountries, WorldFilterMembers, WorldFilterThemes } from './world-filter.data';

export function filterBitSet(mask: Int, bit: Int): Boolean {
  if (bit !== -1 && CS2.testbit(mask, bit)) {
    return true;
  }
  return false;
}

export function toggleFilterBit(page: Int, mask: Int, bit: Int): void {
  if (bit === -1) {
    return;
  }
  let next: Int = CS2.bit_set(mask, bit);
  if (CS2.testbit(mask, bit)) {
    next = CS2.bit_clear(mask, bit);
  }
  if (page === FilterPage.MEMBER) {
    predictServerState(FilterVarbits.MEMBER, next);
  } else if (page === FilterPage.COUNTRY) {
    predictServerState(FilterVarbits.COUNTRY, next);
  } else if (page === FilterPage.THEME) {
    predictServerState(FilterVarbits.THEME, next);
  }
}

export function pageIconWidth(page: Int): Int {
  if (page === FilterPage.MEMBER) {
    return IconSize.member.w;
  }
  if (page === FilterPage.COUNTRY) {
    return IconSize.country.w;
  }
  return IconSize.theme.w;
}

export function pageIconHeight(page: Int): Int {
  if (page === FilterPage.MEMBER) {
    return IconSize.member.h;
  }
  if (page === FilterPage.COUNTRY) {
    return IconSize.country.h;
  }
  return IconSize.theme.h;
}

export function pageRowCount(page: Int): Int {
  if (page === FilterPage.MEMBER) {
    return WorldFilterMembers.length;
  }
  if (page === FilterPage.COUNTRY) {
    return WorldFilterCountries.length;
  }
  return WorldFilterThemes.length;
}

export function pageWidestLabel(page: Int): Int {
  if (page === FilterPage.MEMBER) {
    return Math.max(
      textWidth(WorldFilterMembers.at(0).label, Layout.measureW, FilterFonts.BODY),
      textWidth(WorldFilterMembers.at(1).label, Layout.measureW, FilterFonts.BODY),
    );
  }
  if (page === FilterPage.COUNTRY) {
    return Math.max(
      Math.max(
        Math.max(
          textWidth(WorldFilterCountries.at(0).label, Layout.measureW, FilterFonts.BODY),
          textWidth(WorldFilterCountries.at(1).label, Layout.measureW, FilterFonts.BODY),
        ),
        Math.max(
          textWidth(WorldFilterCountries.at(2).label, Layout.measureW, FilterFonts.BODY),
          textWidth(WorldFilterCountries.at(3).label, Layout.measureW, FilterFonts.BODY),
        ),
      ),
      Math.max(
        Math.max(
          textWidth(WorldFilterCountries.at(4).label, Layout.measureW, FilterFonts.BODY),
          textWidth(WorldFilterCountries.at(5).label, Layout.measureW, FilterFonts.BODY),
        ),
        textWidth(WorldFilterCountries.at(6).label, Layout.measureW, FilterFonts.BODY),
      ),
    );
  }
  return Math.max(
    Math.max(
      Math.max(
        textWidth(WorldFilterThemes.at(0).label, Layout.measureW, FilterFonts.BODY),
        textWidth(WorldFilterThemes.at(1).label, Layout.measureW, FilterFonts.BODY),
      ),
      Math.max(
        textWidth(WorldFilterThemes.at(2).label, Layout.measureW, FilterFonts.BODY),
        textWidth(WorldFilterThemes.at(3).label, Layout.measureW, FilterFonts.BODY),
      ),
    ),
    Math.max(
      Math.max(
        textWidth(WorldFilterThemes.at(4).label, Layout.measureW, FilterFonts.BODY),
        textWidth(WorldFilterThemes.at(5).label, Layout.measureW, FilterFonts.BODY),
      ),
      Math.max(
        textWidth(WorldFilterThemes.at(6).label, Layout.measureW, FilterFonts.BODY),
        textWidth(WorldFilterThemes.at(7).label, Layout.measureW, FilterFonts.BODY),
      ),
    ),
  );
}
