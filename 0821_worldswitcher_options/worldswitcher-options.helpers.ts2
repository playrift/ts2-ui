import { CS2, useState } from 'ts2';

import {
  worldswitcherSearch00,
  worldswitcherSearch01,
  worldswitcherSearch02,
  worldswitcherSearch03,
  worldswitcherSearch04,
  worldswitcherSearch06,
  worldswitcherSearch07,
  xpdropsFake5,
} from '../lib/game/varcs';
import { SEARCH_ALPHABET } from './worldswitcher-options.constants';
import { WorldSwitcherSearchChars } from './search-chars.data';

export function worldSwitcherSearchGet(): String {
  const [c0] = useState(worldswitcherSearch00);
  const [c1] = useState(worldswitcherSearch01);
  const [c2] = useState(worldswitcherSearch02);
  const [c3] = useState(worldswitcherSearch03);
  const [c4] = useState(worldswitcherSearch04);
  const [c5] = useState(xpdropsFake5);
  const [c6] = useState(worldswitcherSearch06);
  const [c7] = useState(worldswitcherSearch07);
  return `${WorldSwitcherSearchChars.at(c0 - 1) ?? ''}${WorldSwitcherSearchChars.at(c1 - 1) ?? ''}${WorldSwitcherSearchChars.at(c2 - 1) ?? ''}${WorldSwitcherSearchChars.at(c3 - 1) ?? ''}${WorldSwitcherSearchChars.at(c4 - 1) ?? ''}${WorldSwitcherSearchChars.at(c5 - 1) ?? ''}${WorldSwitcherSearchChars.at(c6 - 1) ?? ''}${WorldSwitcherSearchChars.at(c7 - 1) ?? ''}`;
}

function searchKeyAt(text: String, length: Int, index: Int): Int {
  if (length > index) {
    return CS2.string_indexof_string(SEARCH_ALPHABET, CS2.substring(text, index, index + 1), 0) + 1;
  }
  return 0;
}

export function worldSwitcherSearchSet(search: String): void {
  const length: Int = CS2.string_length(search);
  const text: String = CS2.lowercase(search);
  const [, set0] = useState(worldswitcherSearch00);
  const [, set1] = useState(worldswitcherSearch01);
  const [, set2] = useState(worldswitcherSearch02);
  const [, set3] = useState(worldswitcherSearch03);
  const [, set4] = useState(worldswitcherSearch04);
  const [, set5] = useState(xpdropsFake5);
  const [, set6] = useState(worldswitcherSearch06);
  const [, set7] = useState(worldswitcherSearch07);
  set0(searchKeyAt(text, length, 0));
  set1(searchKeyAt(text, length, 1));
  set2(searchKeyAt(text, length, 2));
  set3(searchKeyAt(text, length, 3));
  set4(searchKeyAt(text, length, 4));
  set5(searchKeyAt(text, length, 5));
  set6(searchKeyAt(text, length, 6));
  set7(searchKeyAt(text, length, 7));
}
