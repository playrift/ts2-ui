export const ForestryKitItems = mapOf<Item, Int>([
  [28134, 1],
  [28152, 1],
  [28157, 1],
  [28161, 1],
  [6020, 1],
  [6022, 1],
  [6024, 1],
  [6028, 1],
  [6026, 1],
  [6030, 1],
  [10939, 1],
  [10940, 1],
  [10941, 1],
  [10933, 1],
  [28169, 1],
  [28171, 1],
  [28173, 1],
  [28175, 1],
  [9807, 1],
  [9808, 1],
]);

export function isForestryKitItem(item: Item): Boolean {
  if (ForestryKitItems.get(item) === 1) {
    return true;
  }
  return false;
}
