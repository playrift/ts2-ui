import { SteelBorder } from '../lib/steel-border.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { InfoPane } from './info-pane.component';
import { KitListPane } from './kit-list-pane.component';
import { FillEmptyBar, WithdrawBar } from './kit-bars.component';
import { KitColor, KitFonts, Layout, STEEL_FLAGS, TITLE } from './forestry-kit-main.constants';

export function ForestryKitMain(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.universe.w} h={Layout.universe.h}>
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorder title={TITLE} titleColor={KitColor.TEXT} flags={STEEL_FLAGS} />
        </layer>

        <layer
          x={Layout.content.x}
          y={Layout.content.y}
          w={{ fill: Layout.content.insetW }}
          h={{ fill: Layout.content.insetH }}
        >
          <layer
            x={Layout.listLayer.x}
            y={Layout.listLayer.y}
            w={{ fill: Layout.listLayer.insetW }}
            h={{ fill: Layout.listLayer.insetH }}
          >
            <rect x="center" y="center" w="fill" h="fill" fill color={KitColor.BACKDROP} transparency={200} />
            <layer w={{ fill: Layout.pane.thinboxInsetW }} h="fill">
              <ThinBoxEntrypoint />
            </layer>
            <KitListPane />
          </layer>

          <layer
            x={{ right: Layout.infoLayer.x }}
            y={Layout.infoLayer.y}
            w={Layout.infoLayer.w}
            h={{ fill: Layout.infoLayer.insetH }}
          >
            <rect x="center" y="center" w="fill" h="fill" fill color={KitColor.BACKDROP} transparency={200} />
            <layer w={{ fill: Layout.pane.thinboxInsetW }} h="fill">
              <ThinBoxEntrypoint />
            </layer>
            <InfoPane />
          </layer>

          <layer
            x={Layout.buttonsList.x}
            y={{ bottom: Layout.buttonsList.y }}
            w={{ fill: Layout.buttonsList.insetW }}
            h={Layout.buttonsList.h}
          >
            <FillEmptyBar />
          </layer>

          <layer
            x={{ right: Layout.buttonsInfo.x }}
            y={{ bottom: Layout.buttonsInfo.y }}
            w={Layout.buttonsInfo.w}
            h={Layout.buttonsInfo.h}
          >
            <text
              x="center"
              w={Layout.withdrawText.w}
              h={Layout.withdrawText.h}
              text="Withdraw"
              font={KitFonts.BUTTON}
              color={KitColor.TEXT}
              shadow
              align="center"
            />
            <WithdrawBar />
          </layer>
        </layer>
      </layer>
    </>
  );
}
