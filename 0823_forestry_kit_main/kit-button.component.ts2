import { useState } from 'ts2';
import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { KitColor, KitFonts } from './forestry-kit-main.constants';

export function KitButton({ label, enabled }: { label: String; enabled: Int }): Component {
  const [hovered, setHovered] = useState(0);

  if (enabled === 1 && hovered === 0) {
    return (
      <layer w="fill" h="fill" onMouseEnter={() => setHovered(onMobile() ? 0 : 1)} onMouseLeave={() => setHovered(0)}>
        <StoneButton>
          <text
            w="fill"
            h="fill"
            text={label}
            font={KitFonts.BUTTON}
            color={KitColor.TEXT}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButton>
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseEnter={() => setHovered(onMobile() ? 0 : 1)} onMouseLeave={() => setHovered(0)}>
      <StoneButtonPressedFilled>
        <text
          w="fill"
          h="fill"
          text={label}
          font={KitFonts.BUTTON}
          color={enabled === 1 ? KitColor.TEXT : KitColor.DISABLED}
          shadow
          align="center"
          valign="middle"
        />
      </StoneButtonPressedFilled>
    </layer>
  );
}
