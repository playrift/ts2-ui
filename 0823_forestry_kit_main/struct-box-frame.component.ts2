import { type CellBoxRow } from './forestry-kit-main.constants';

export function StructBoxFrame({
  x,
  y,
  w,
  h,
  style,
}: {
  x: Int;
  y: Int;
  w: Int;
  h: Int;
  style: CellBoxRow;
}): Component {
  const border: Int = style.border;
  const fill: Sprite = style.fill;
  let blank: Boolean = false;
  if (fill === -1) {
    blank = true;
  }

  return (
    <>
      <sprite x={x + 4} y={y + 4} w={w - 8} h={h - 8} sprite={fill} tiling hide={blank} />

      <sprite x={x + border} y={y} w={w - 2 * border} h={border} sprite={style.edgeTop} tiling />
      <sprite x={x + border} y={y + h - border} w={w - 2 * border} h={border} sprite={style.edgeBottom} tiling />
      <sprite x={x} y={y + border} w={border} h={h - 2 * border} sprite={style.edgeLeft} tiling />
      <sprite x={x + w - border} y={y + border} w={border} h={h - 2 * border} sprite={style.edgeRight} tiling />

      <sprite x={x} y={y} w={border} h={border} sprite={style.cornerTl} tiling />
      <sprite x={x + w - border} y={y} w={border} h={border} sprite={style.cornerTr} tiling />
      <sprite x={x} y={y + h - border} w={border} h={border} sprite={style.cornerBl} tiling />
      <sprite x={x + w - border} y={y + h - border} w={border} h={border} sprite={style.cornerBr} tiling />
    </>
  );
}
