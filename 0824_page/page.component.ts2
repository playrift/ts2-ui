import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, PageArt, PageColors, PageFonts, PageModel } from './page.constants';

export function Page(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <model
        x={Layout.MODEL_X}
        y={{ center: Layout.MODEL_DY }}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={PageModel.BACKGROUND}
        zoom={PageModel.ZOOM}
        pitch={PageModel.PITCH}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PageArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, PageArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, PageArt.CLOSE)}
      />

      <layer x={{ center: Layout.PANE_DX }} y={{ center: Layout.PANE_DY }} w={Layout.PANE_W} h={Layout.PANE_H}>
        <text
          x="center"
          y={Layout.LINE1_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE2_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE3_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE4_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE5_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE6_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE7_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE8_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE9_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE10_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE11_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE12_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
          font={PageFonts.LINE}
          color={PageColors.INK}
        />
        <text
          x="center"
          y={Layout.LINE13_Y}
          w={Layout.LINE_W}
          h={Layout.LINE_H}
