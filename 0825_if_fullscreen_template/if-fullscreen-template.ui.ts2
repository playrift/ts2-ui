import { createRef } from 'ts2';

const ifFullscreenTemplate = createRef('if_fullscreen_template');

export function IfFullscreenTemplate(): Component {
  return <layer x={0} y={0} w={512} h={334} />;
}

export const ifFullscreenTemplateUi = (): UI => (
  <ui ref={ifFullscreenTemplate}>
    <IfFullscreenTemplate />
  </ui>
);
