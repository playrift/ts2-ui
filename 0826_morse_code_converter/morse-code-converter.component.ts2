import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Ink, Layout, MorseArt, MorseCells, MorseFonts, MorseModel } from './morse-code-converter.constants';

export function MorseCodeConverter(): Component {
  return (
    <layer w="fill" h="fill" x="center" y="center">
      <layer w={Layout.STAGE_W} h={Layout.STAGE_H} x="center" y="center">
        <model
          x={{ center: Layout.MODEL_DX }}
          y={{ center: Layout.MODEL_DY }}
          w={Layout.MODEL}
          h={Layout.MODEL}
          model={MorseModel.TELEGRAPH_KEY}
          zoom={Layout.MODEL_ZOOM}
          pitch={Layout.MODEL_PITCH}
        />

        <sprite
          x={{ right: Layout.CLOSE_INSET }}
          y={Layout.CLOSE_INSET}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={MorseArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, MorseArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, MorseArt.CLOSE)}
        />

        <layer x={{ center: Layout.GRID_DX }} y={{ center: Layout.GRID_DY }} w={Layout.GRID_W} h={Layout.GRID_H}>
          {MorseCells.map((cell) => (
            <layer x={cell.x} y={cell.y} w={Layout.CELL_W} h={Layout.CELL_H}>
              <sprite x={Layout.STRIP_X} y="center" w={Layout.STRIP_W} h={Layout.STRIP_H} sprite={cell.sprite} />
              <text
                x="right"
                y="center"
                w={Layout.LETTER_W}
                h="fill"
                font={MorseFonts.LETTER}
                color={Ink.LETTER}
                shadow
                align="center"
                valign="middle"
                text={cell.letter}
              />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
