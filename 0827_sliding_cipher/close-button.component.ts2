import { closeInterface, graphicSwapper, onMobile } from '../lib/lib.helpers';
import { CipherArt, Layout } from './sliding-cipher.constants';

export function CipherCloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        right={Layout.CLOSE_MOBILE_INSET}
        y={Layout.CLOSE_MOBILE_INSET}
        w={Layout.CLOSE_MOBILE}
        h={Layout.CLOSE_MOBILE}
        sprite={CipherArt.CLOSE_MOBILE}
        options={['Close']}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, CipherArt.CLOSE_MOBILE);
        }}
        onOptionSelect={() => {
          closeInterface();
        }}
      />
    );
  }

  return (
    <sprite
      right={Layout.CLOSE_RIGHT}
      y={Layout.CLOSE_Y}
      w={Layout.CLOSE_W}
      h={Layout.CLOSE_H}
      sprite={CipherArt.CLOSE}
      hover={{ sprite: CipherArt.CLOSE_HOVER }}
      options={['Close']}
      onOptionSelect={() => {
        closeInterface();
      }}
    />
  );
}
