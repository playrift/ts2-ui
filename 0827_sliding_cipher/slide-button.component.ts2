import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { Layout } from './sliding-cipher.constants';

export function SlideButtonSkin({ arrow }: { arrow: Sprite }): Component {
  const [pressed, setPressed] = useState(0);
  const touch: Boolean = onMobile();

  return (
    <layer w="fill" h="fill" onMouseRepeat={touch ? undefined : () => setPressed(1)} onMouseLeave={() => setPressed(0)}>
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <sprite x="center" y="center" w={Layout.ARROW} h={Layout.ARROW} sprite={arrow} />
    </layer>
  );
}
