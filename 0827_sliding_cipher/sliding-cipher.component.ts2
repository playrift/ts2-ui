import { CipherWheel } from './cipher-wheel.component';
import { CipherCloseButton } from './close-button.component';
import { SlideButtonSkin } from './slide-button.component';
import { CipherArt, Layout, SlideDirection } from './sliding-cipher.constants';
import { slideCipher } from './sliding-cipher.state';
import { SteelFrame } from './steel-frame.component';

export function SlidingCipher(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: Layout.CONTENT_INSET }} h={{ fill: Layout.CONTENT_INSET }}>
        <layer x="center" y={{ center: Layout.BUTTONS_DY }} w={{ fill: Layout.BUTTONS_INSET }} h={Layout.BUTTONS_H}>
          <layer y="center" w={Layout.BUTTON_HALF} h="fill">
            <layer
              x="center"
              y="center"
              w={Layout.BUTTON_W}
              h={Layout.BUTTON_H}
              options={['Slide Left']}
              onOptionSelect={() => slideCipher(SlideDirection.FORWARD)}
            >
              <SlideButtonSkin arrow={CipherArt.ARROW_LEFT} />
            </layer>
          </layer>

          <layer x="right" y="center" w={Layout.BUTTON_HALF} h="fill">
            <layer
              x="center"
              y="center"
              w={Layout.BUTTON_W}
              h={Layout.BUTTON_H}
              options={['Slide Right']}
              onOptionSelect={() => slideCipher(SlideDirection.BACKWARD)}
            >
              <SlideButtonSkin arrow={CipherArt.ARROW_RIGHT} />
            </layer>
          </layer>
        </layer>

        <layer x="center" y={{ center: Layout.WHEEL_DY }} w={{ fill: Layout.WHEEL_INSET }} h={Layout.WHEEL_H}>
          <CipherWheel />
        </layer>
      </layer>

      <CipherCloseButton />
    </layer>
  );
}
