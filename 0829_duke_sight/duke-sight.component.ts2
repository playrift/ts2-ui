import { Camera, DukeSightAnim, DukeSightColor, DukeSightModel, Layout } from './duke-sight.constants';

export function DukeSight(): Component {
  return (
    <>
      <rect w={Layout.flash.w} h={Layout.flash.h} hide fill color={DukeSightColor.FLASH} />

      <model w="fill" h="fill" model={DukeSightModel.EYE} anim={DukeSightAnim.EYE_IDLE} orthogonal zoom={Camera.ZOOM} />
    </>
  );
}
