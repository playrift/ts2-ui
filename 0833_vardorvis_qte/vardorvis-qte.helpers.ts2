import { CS2, useState } from 'ts2';

import { minmax } from '../0811_lockpicking/lockpicking.state';
import { clientClock } from '../lib/lib.engine';
import { Fade, Qte, QteAnims, QteFraming } from './vardorvis-qte.constants';
import { qteIntroCalls, qteIntroCount, qteIntroSettleAt, qteOutroCalls, qteOutroCloseAt } from './vardorvis-qte.state';

export function vardorvisQteStart(count: Int): void {
  const [calls, setCalls] = useState(qteIntroCalls);
  const [, setCount] = useState(qteIntroCount);
  const [, setSettleAt] = useState(qteIntroSettleAt);
  setCount(count);
  setSettleAt(clientClock() + Qte.HOLD_CYCLES);
  setCalls(calls + 1);
}

export function vardorvisQteEnd(): void {
  const [calls, setCalls] = useState(qteOutroCalls);
  const [, setCloseAt] = useState(qteOutroCloseAt);
  setCloseAt(clientClock() + Qte.HOLD_CYCLES);
  setCalls(calls + 1);
}

export function vardorvisQteReset(): void {
  const [, setIntroCalls] = useState(qteIntroCalls);
  const [, setOutroCalls] = useState(qteOutroCalls);
  setIntroCalls(0);
  setOutroCalls(0);
}

export function introCallsNow(): Int {
  const [calls] = useState(qteIntroCalls);
  return calls;
}

export function introCountNow(): Int {
  const [count] = useState(qteIntroCount);
  return count;
}

export function introSettleAtNow(): Int {
  const [settleAt] = useState(qteIntroSettleAt);
  return settleAt;
}

export function outroCallsNow(): Int {
  const [calls] = useState(qteOutroCalls);
  return calls;
}

export function outroCloseAtNow(): Int {
  const [closeAt] = useState(qteOutroCloseAt);
  return closeAt;
}

export function sporeX(cell: Int): Int {
  const pitch: Int = (QteFraming.MAIN_W - Qte.MARGIN) / Qte.COLUMNS;
  return pitch * (cell % Qte.COLUMNS) + Qte.INSET + CS2.randominc(pitch - QteFraming.SPORE);
}

export function sporeY(cell: Int): Int {
  const pitch: Int = (QteFraming.MAIN_H - Qte.MARGIN) / Qte.ROWS;
  return pitch * (cell / Qte.COLUMNS) + Qte.INSET + CS2.randominc(pitch - QteFraming.SPORE);
}

export function fadeInStep(level: Int): Int {
  return minmax(0, Qte.CLEAR, level - Qte.FADE_STEP);
}

export function fadeOutStep(level: Int): Int {
  return minmax(0, Qte.CLEAR, level + Qte.FADE_STEP);
}

export function sporeArmed(fade: Int, anim: Int): Boolean {
  return fade === Fade.IN || (fade === Fade.NONE && anim === QteAnims.SPORE_IDLE);
}

export function animationOf(id: Int): Animation {
  if (id === QteAnims.BACKGROUND_SPAWN) {
    return QteAnims.BACKGROUND_SPAWN;
  }
  if (id === QteAnims.BACKGROUND_IDLE) {
    return QteAnims.BACKGROUND_IDLE;
  }
  if (id === QteAnims.BACKGROUND_DESPAWN) {
    return QteAnims.BACKGROUND_DESPAWN;
  }
  if (id === QteAnims.TENTACLES_SPAWN) {
    return QteAnims.TENTACLES_SPAWN;
  }
  if (id === QteAnims.TENTACLES_IDLE) {
    return QteAnims.TENTACLES_IDLE;
  }
  if (id === QteAnims.TENTACLES_DESPAWN) {
    return QteAnims.TENTACLES_DESPAWN;
  }
  if (id === QteAnims.SPORE_SPAWN) {
    return QteAnims.SPORE_SPAWN;
  }
  if (id === QteAnims.SPORE_IDLE) {
    return QteAnims.SPORE_IDLE;
  }
  if (id === QteAnims.SPORE_DEATH) {
    return QteAnims.SPORE_DEATH;
  }
  return -1;
}
