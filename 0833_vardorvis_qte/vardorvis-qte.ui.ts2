import { createRef } from 'ts2';
import { VardorvisQte } from './vardorvis-qte.component';
import { vardorvisQteReset } from './vardorvis-qte.helpers';

export const vardorvisQteRef = createRef('vardorvis_qte');

export const vardorvisQteUi = (): UI => (
  <ui ref={vardorvisQteRef} x="center" y="center">
    <layer x={0} y={0} w={0} h={0} onLoad={() => vardorvisQteReset()} />
    <VardorvisQte />
  </ui>
);
