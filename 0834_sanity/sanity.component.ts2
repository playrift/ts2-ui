import { onMounted, onUpdated, useInterval, useRef, useServerState, useState, useWatch } from 'ts2';

import { responsiveCurrentBreakpoint } from '../lib/game/varcs';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  dodger,
  Layout,
  overlay,
  ROOT_H,
  ROOT_W,
  Sanity,
  SanityColor,
  SanityFonts,
  SanitySprites,
  SanityVarbits,
  SHINE_H,
  SHINE_WASH,
  universe,
} from './sanity.constants';
import {
  barTarget,
  glyphAlphaFor,
  overlayWidth,
  publishBreakpoint,
  sanityBar,
  sanityCaption,
  sanityTick,
  Snap,
} from './sanity.helpers';
import { sanityBarPx, sanityGlyphAlpha, sanityLaidOutAt, sanityMeasuredPx } from './sanity.state';

export function Sanity_(): Component {
  useInterval(() => publishBreakpoint(), universe);

  return (
    <layer ref={universe} w={ROOT_W} h={ROOT_H}>
      <layer w="fill" h="fill" hide>
        <rect w="fill" h="fill" fill color={SanityColor.FADE} />
      </layer>

      <layer w="fill" h="fill" ref={dodger}>
        <layer static ref={overlay} x={Layout.CARD_X} y={Layout.CARD_Y} w={Layout.CARD_W} h={Layout.CARD_H}>
          <SanityCard />
        </layer>
      </layer>
    </layer>
  );
}

function placeCard(width: Int, breakpoint: Int): void {
  overlay.props = { w: width, h: Layout.CARD_H };
  overlayInit(dodger, overlay, Sanity.DODGE, Anchor.LEFT, Anchor.TOP, 1);
  const [, setLaidOutAt] = useState(sanityLaidOutAt);
  setLaidOutAt(breakpoint);
}

function SanityCard(): Component {
  const track = useRef();

  const sanity: Int = useServerState(SanityVarbits.SANITY);
  const [breakpoint] = useState(responsiveCurrentBreakpoint);
  const [barPx] = useState(sanityBarPx);
  const [alpha] = useState(sanityGlyphAlpha);
  const [measured] = useState(sanityMeasuredPx);
  const [laidOutAt] = useState(sanityLaidOutAt);

  const width: Int = overlayWidth(breakpoint);
  const trackW: Int = width - Layout.BAR_INSET_W;
  const target: Int = barTarget(sanity, trackW);
  const caption: String = sanityCaption(sanity);
  let captionColor: Int = SanityColor.TEXT;
  if (sanity === 0) {
    captionColor = SanityColor.INSANE;
  }

  let drawn: Int = barPx;
  let shownAlpha: Int = alpha;
  if (measured !== trackW) {
    drawn = target;
    shownAlpha = glyphAlphaFor(target, trackW);
    if (sanity === 0) {
      shownAlpha = 255;
    }
  } else if (sanity > 0 && drawn <= 0) {
    drawn = 1;
  }

  let relayout: Boolean = false;
  if (laidOutAt !== breakpoint) {
    relayout = true;
  }
  onMounted(() => placeCard(width, breakpoint));
  onUpdated(() => {
    if (relayout) {
      placeCard(width, breakpoint);
    }
  });

  useWatch(SanityVarbits.SANITY, () => sanityBar(Snap.WALK), track);
  useInterval(() => sanityTick());

  return (
    <>
      <layer ref={track} x={Layout.BAR_X} y="center" w={{ fill: Layout.BAR_INSET_W }} h={{ fill: Layout.BAR_INSET_H }}>
        <rect w="fill" h="fill" fill color={SanityColor.BAR_BACK} />

        <rect w={drawn} h="fill" fill color={SanityColor.BAR_FILL} />

        <rect w="fill" h={SHINE_H} fill color={SanityColor.SHINE} transparency={SHINE_WASH} />

        <text
          x="center"
          y={{ center: Layout.PERCENT_Y }}
          w={Layout.PERCENT_W}
          h={Layout.PERCENT_H}
          text={caption}
          font={SanityFonts.PERCENT}
          align="center"
          valign="middle"
          shadow
          color={captionColor}
        />

        <rect
          x={{ right: Layout.DOT_INSET }}
          y={{ bottom: Layout.DOT_INSET }}
          w={Layout.DOT}
          h={Layout.DOT}
          fill
          color={SanityColor.CORNER}
        />
        <rect
          x={{ right: Layout.DOT_INSET }}
          y={Layout.DOT_INSET}
          w={Layout.DOT}
          h={Layout.DOT}
          fill
          color={SanityColor.CORNER}
        />

        <ThinBoxEntrypoint />
      </layer>

      <layer w={Layout.ICON_W} h={Layout.ICON_H}>
        <sprite x={Layout.ORB_X} y={Layout.ORB_Y} w={Layout.ORB} h={Layout.ORB} sprite={SanitySprites.ORB} />
        <sprite
          x={Layout.GLYPH_X}
          y={Layout.GLYPH_Y}
          w={Layout.GLYPH}
          h={Layout.GLYPH}
          sprite={SanitySprites.ICON_BACK}
        />
        <sprite
          x={Layout.GLYPH_X}
          y={Layout.GLYPH_Y}
          w={Layout.GLYPH}
          h={Layout.GLYPH}
          sprite={SanitySprites.ICON}
          transparency={shownAlpha}
        />
      </layer>
    </>
  );
}
