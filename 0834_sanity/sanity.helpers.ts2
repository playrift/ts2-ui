import { useServerState, useState } from 'ts2';

import { responsiveCurrentBreakpoint } from '../lib/game/varcs';
import { scaled } from '../lib/lib.engine';
import {
  BreakpointGates,
  INSANE_TEXT,
  Layout,
  OverlayWidths,
  SANITY_MAX,
  SanityVarbits,
  universe,
} from './sanity.constants';
import { sanityBarPx, sanityGlyphAlpha, sanityMeasuredPx, sanityWalkTarget, sanityWalkTrackPx } from './sanity.state';

export const enum Snap {
  WALK = 0,
  NOW = 1,
}

const CLEAR = 255;

export function breakpointOf(width: Int, height: Int): Int {
  let level: Int = 0;
  if (width > BreakpointGates.W1 && height > BreakpointGates.H1) {
    level = 1;
  }
  if (width > BreakpointGates.W2 && height > BreakpointGates.H2) {
    level = 2;
  }
  if (width > BreakpointGates.W3 && height > BreakpointGates.H3) {
    level = 3;
  }
  return level;
}

export function overlayWidth(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return OverlayWidths.ONE;
  }
  if (breakpoint === 2) {
    return OverlayWidths.TWO;
  }
  if (breakpoint === 3) {
    return OverlayWidths.THREE;
  }
  return OverlayWidths.BASE;
}

export function cardWidth(): Int {
  const [breakpoint] = useState(responsiveCurrentBreakpoint);
  return overlayWidth(breakpoint);
}

export function trackWidth(): Int {
  return cardWidth() - Layout.BAR_INSET_W;
}

export function barTarget(sanity: Int, trackW: Int): Int {
  if (sanity === 0) {
    return 0;
  }
  const target: Int = scaled(sanity, SANITY_MAX, trackW);
  if (target < 1) {
    return 1;
  }
  return target;
}

export function glyphAlphaFor(px: Int, trackW: Int): Int {
  return CLEAR - scaled(px, trackW, CLEAR);
}

export function sanityCaption(sanity: Int): String {
  if (sanity === 0) {
    return INSANE_TEXT;
  }
  let pct: Int = scaled(sanity, SANITY_MAX, 100);
  if (pct < 1) {
    pct = 1;
  }
  return `Sanity: ${pct}%`;
}

export function publishBreakpoint(): void {
  const [, setBreakpoint] = useState(responsiveCurrentBreakpoint);
  setBreakpoint(breakpointOf(universe.width, universe.height));
}

export function sanityBar(snap: Int): void {
  const sanity: Int = useServerState(SanityVarbits.SANITY);
  const [barPx, setBarPx] = useState(sanityBarPx);
  const [, setAlpha] = useState(sanityGlyphAlpha);
  const [, setWalkTarget] = useState(sanityWalkTarget);
  const [, setWalkTrackPx] = useState(sanityWalkTrackPx);

  if (sanity === 0) {
    setBarPx(0);
    setAlpha(CLEAR);
    return;
  }

  const trackW: Int = trackWidth();
  const target: Int = barTarget(sanity, trackW);
  if (barPx <= 0) {
    setBarPx(1);
  }
  setWalkTarget(target);
  setWalkTrackPx(trackW);
  if (snap === Snap.NOW) {
    sanityBarWalk(snap);
  }
}

export function sanityBarWalk(snap: Int): void {
  const [walkTarget, setWalkTarget] = useState(sanityWalkTarget);
  if (walkTarget === -1) {
    return;
  }
  const [walkTrackPx] = useState(sanityWalkTrackPx);
  const [shown, setBarPx] = useState(sanityBarPx);
  const [, setAlpha] = useState(sanityGlyphAlpha);
  const trackW: Int = trackWidth();

  let next: Int = shown;
  if (walkTrackPx !== trackW) {
    next = walkTarget;
  } else if (snap === Snap.NOW || shown === 0) {
    next = walkTarget;
  } else if (shown < walkTarget) {
    next = shown + 1;
  } else if (shown > walkTarget) {
    next = shown - 1;
  }

  setBarPx(next);
  setAlpha(glyphAlphaFor(next, trackW));
  if (next === walkTarget) {
    setWalkTarget(-1);
  }
}

export function sanityTick(): void {
  const trackW: Int = trackWidth();
  const [measured, setMeasured] = useState(sanityMeasuredPx);
  if (measured !== trackW) {
    setMeasured(trackW);
    sanityBar(Snap.NOW);
  }
  sanityBarWalk(Snap.WALK);
}
