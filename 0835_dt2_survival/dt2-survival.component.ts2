import { useInterval, useRef, useServerState, useState, useWatch } from 'ts2';

import { Varps } from '../lib/game/varps';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  dodger,
  Dt2Color,
  Dt2Fonts,
  Dt2Survival,
  Dt2Varbits,
  GLOSS_H,
  GLOSS_WASH,
  INNER_H,
  INNER_W,
  Layout,
  overlay,
  TITLE_TEXT,
} from './dt2-survival.constants';
import {
  clockFor,
  clockLabel,
  dt2SurvivalHealth,
  dt2SurvivalReset,
  dt2SurvivalTick,
  healthCaption,
} from './dt2-survival.helpers';
import { dt2SurvivalBarPx, dt2SurvivalClockFrom, dt2SurvivalCycles } from './dt2-survival.state';

export function Dt2Survival_(): Component {
  return (
    <layer w="100%" h="100%">
      <layer w="fill" h="fill" hide>
        <rect w="fill" h="fill" fill />
      </layer>

      <layer
        w="fill"
        h="fill"
        ref={dodger}
        onLoad={() => overlayInit(dodger, overlay, Dt2Survival.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer static ref={overlay} x={Layout.CARD_X} y={Layout.CARD_Y} w={Layout.CARD_W} h={Layout.CARD_H}>
          <SurvivalCard />
        </layer>
      </layer>
    </layer>
  );
}

function SurvivalCard(): Component {
  const label = useRef();
  const track = useRef();

  const units: Int = useServerState(Dt2Varbits.TIME_REMAINING);
  const hp: Int = useServerState(Dt2Varbits.KASONDE_HP);
  const stranglewood: Int = useServerState(Varps.STRANGLEWOOD);
  const [cycles] = useState(dt2SurvivalCycles);
  const [from] = useState(dt2SurvivalClockFrom);
  const [barPx] = useState(dt2SurvivalBarPx);

  let count: Int = cycles;
  if (from !== stranglewood) {
    count = clockFor(units);
  }
  const clock: String = clockLabel(count);
  const caption: String = healthCaption(hp);
  let drawn: Int = barPx;
  if (hp > 0 && drawn <= 0) {
    drawn = 1;
  }

  useWatch(Dt2Varbits.TIME_REMAINING, () => dt2SurvivalReset(), label);
  useWatch(Dt2Varbits.KASONDE_HP, () => dt2SurvivalHealth(), track);
  useInterval(() => dt2SurvivalTick());

  return (
    <layer w={INNER_W} h={INNER_H}>
      <text
        w="fill"
        h={Layout.ROW_H}
        text={TITLE_TEXT}
        font={Dt2Fonts.TITLE}
        align="center"
        valign="middle"
        shadow
        color={Dt2Color.TITLE}
      />

      <text
        ref={label}
        x="center"
        y="bottom"
        w={Layout.TIME_W}
        h={Layout.ROW_H}
        text={clock}
        font={Dt2Fonts.TIME}
        valign="middle"
        shadow
        color={Dt2Color.TEXT}
      />

      <layer ref={track} y="center" w="fill" h={Layout.ROW_H}>
        <rect w="fill" h="fill" fill color={Dt2Color.HEALTH_LOST} />

        <rect w={drawn} h="fill" fill color={Dt2Color.HEALTH_LEFT} />

        <rect w="fill" h={GLOSS_H} fill color={Dt2Color.GLOSS} transparency={GLOSS_WASH} />

        <text
          x="center"
          y={{ center: Layout.PERCENT_Y }}
          w={Layout.PERCENT_W}
          h={Layout.PERCENT_H}
          text={caption}
          font={Dt2Fonts.PERCENT}
          align="center"
          valign="middle"
          shadow
          color={Dt2Color.TEXT}
        />

        <rect
          x={{ right: Layout.DOT_INSET }}
          y={{ bottom: Layout.DOT_INSET }}
          w={Layout.DOT}
          h={Layout.DOT}
          fill
          color={Dt2Color.CORNER}
        />
        <rect
          x={{ right: Layout.DOT_INSET }}
          y={Layout.DOT_INSET}
          w={Layout.DOT}
          h={Layout.DOT}
          fill
          color={Dt2Color.CORNER}
        />
        <rect
          x={Layout.DOT_INSET}
          y={{ bottom: Layout.DOT_INSET }}
          w={Layout.DOT}
          h={Layout.DOT}
          fill
          color={Dt2Color.CORNER}
        />
        <rect x={Layout.DOT_INSET} y={Layout.DOT_INSET} w={Layout.DOT} h={Layout.DOT} fill color={Dt2Color.CORNER} />

        <ThinBoxEntrypoint />
      </layer>
    </layer>
  );
}
