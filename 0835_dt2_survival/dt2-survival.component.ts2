import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  Dt2Color,
  Dt2Fonts,
  Dt2Survival,
  GLOSS_H,
  GLOSS_WASH,
  INNER_H,
  INNER_W,
  Layout,
  PERCENT_TEXT,
  TIME_TEXT,
  TITLE_TEXT,
} from './dt2-survival.constants';
import { dt2SurvivalHealth, dt2SurvivalTime } from './dt2-survival.helpers';
import { healthBar, healthPercent } from './dt2-survival.refs';

const overlay = createRef('dt2_survival_overlay');

export function Dt2Survival_(): Component {
  return (
    <layer w="100%" h="100%">
      <layer w="fill" h="fill" hide>
        <rect w="fill" h="fill" fill />
      </layer>

      <layer
        w="fill"
        h="fill"
        onTimer={(event) => overlayRelayout(event.component, overlay, Dt2Survival.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={overlay} x={Layout.CARD_X} y={Layout.CARD_Y} w={Layout.CARD_W} h={Layout.CARD_H}>
          <layer w={INNER_W} h={INNER_H}>
            <text
              w="fill"
              h={Layout.ROW_H}
              text={TITLE_TEXT}
              font={Dt2Fonts.TITLE}
              align="center"
              valign="middle"
              shadow
              color={Dt2Color.TITLE}
            />

            <text
              x="center"
              y="bottom"
              w={Layout.TIME_W}
              h={Layout.ROW_H}
              text={TIME_TEXT}
              font={Dt2Fonts.TIME}
              valign="middle"
              shadow
              color={Dt2Color.TEXT}
              onTimer={(event) => dt2SurvivalTime(event.component)}
            />

            <layer
              y="center"
              w="fill"
              h={Layout.ROW_H}
              onTimer={(event) => dt2SurvivalHealth(event.component, healthPercent, healthBar)}
            >
              <rect w="fill" h="fill" fill color={Dt2Color.HEALTH_LOST} />

              <rect ref={healthBar} w="fill" h="fill" fill color={Dt2Color.HEALTH_LEFT} />

              <rect w="fill" h={GLOSS_H} fill color={Dt2Color.GLOSS} transparency={GLOSS_WASH} />

              <text
                ref={healthPercent}
                x="center"
                y={{ center: Layout.PERCENT_Y }}
                w={Layout.PERCENT_W}
                h={Layout.PERCENT_H}
                text={PERCENT_TEXT}
                font={Dt2Fonts.PERCENT}
                align="center"
                valign="middle"
                shadow
                color={Dt2Color.TEXT}
              />

              <rect
                x={{ right: Layout.DOT_INSET }}
                y={{ bottom: Layout.DOT_INSET }}
                w={Layout.DOT}
                h={Layout.DOT}
                fill
                color={Dt2Color.CORNER}
              />
              <rect
                x={{ right: Layout.DOT_INSET }}
                y={Layout.DOT_INSET}
                w={Layout.DOT}
                h={Layout.DOT}
                fill
                color={Dt2Color.CORNER}
              />
              <rect
                x={Layout.DOT_INSET}
                y={{ bottom: Layout.DOT_INSET }}
                w={Layout.DOT}
                h={Layout.DOT}
                fill
                color={Dt2Color.CORNER}
              />
              <rect
                x={Layout.DOT_INSET}
                y={Layout.DOT_INSET}
                w={Layout.DOT}
                h={Layout.DOT}
                fill
                color={Dt2Color.CORNER}
              />

              <ThinBoxEntrypoint />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
