import { useServerState, useState } from 'ts2';

import { Varps } from '../lib/game/varps';
import { scaled } from '../lib/lib.engine';
import {
  CYCLES_PER_SECOND,
  CYCLES_PER_UNIT,
  DEAD_TEXT,
  Dt2Varbits,
  KASONDE_MAX_HP,
  SECONDS_PER_MINUTE,
  TRACK_W,
} from './dt2-survival.constants';
import {
  dt2SurvivalBarPx,
  dt2SurvivalClockFrom,
  dt2SurvivalCycles,
  dt2SurvivalOpened,
  dt2SurvivalWalkTarget,
} from './dt2-survival.state';

export function clockLabel(cycles: Int): String {
  let left: Int = cycles;
  if (left < 0) {
    left = 0;
  }
  const seconds: Int = left / CYCLES_PER_SECOND;
  const minutes: Int = seconds / SECONDS_PER_MINUTE;
  const rest: Int = seconds % SECONDS_PER_MINUTE;
  if (rest < 10) {
    return `Time Left: ${minutes}:0${rest}`;
  }
  return `Time Left: ${minutes}:${rest}`;
}

export function clockFor(units: Int): Int {
  return units * CYCLES_PER_UNIT;
}

export function dt2SurvivalReset(): void {
  const units: Int = useServerState(Dt2Varbits.TIME_REMAINING);
  const [, setCycles] = useState(dt2SurvivalCycles);
  const [, setFrom] = useState(dt2SurvivalClockFrom);
  setCycles(clockFor(units));
  setFrom(useServerState(Varps.STRANGLEWOOD));
}

export function healthWidth(hp: Int): Int {
  const width: Int = scaled(hp, KASONDE_MAX_HP, TRACK_W);
  if (width > 1) {
    return width;
  }
  return 1;
}

export function healthCaption(hp: Int): String {
  if (hp <= 0) {
    return DEAD_TEXT;
  }
  let pct: Int = scaled(hp, KASONDE_MAX_HP, 100);
  if (pct < 1) {
    pct = 1;
  }
  return `${pct}%`;
}

export function dt2SurvivalHealth(): void {
  const hp: Int = useServerState(Dt2Varbits.KASONDE_HP);
  const [barPx, setBarPx] = useState(dt2SurvivalBarPx);
  const [, setWalkTarget] = useState(dt2SurvivalWalkTarget);

  if (hp <= 0) {
    setBarPx(0);
    return;
  }
  if (barPx <= 0) {
    setBarPx(1);
  }
  setWalkTarget(healthWidth(hp));
}

export function dt2SurvivalHealthWalk(): void {
  const [walkTarget, setWalkTarget] = useState(dt2SurvivalWalkTarget);
  if (walkTarget === -1) {
    return;
  }
  const [shown, setBarPx] = useState(dt2SurvivalBarPx);
  if (shown === walkTarget) {
    setWalkTarget(-1);
    return;
  }
  if (shown === 0) {
    setBarPx(walkTarget);
  } else if (shown < walkTarget) {
    setBarPx(shown + 1);
  } else if (shown > walkTarget) {
    setBarPx(shown - 1);
  }
}

export function dt2SurvivalTick(): void {
  const [opened, setOpened] = useState(dt2SurvivalOpened);
  if (opened === 0) {
    setOpened(1);
    dt2SurvivalReset();
    dt2SurvivalHealth();
  }
  const [cycles, setCycles] = useState(dt2SurvivalCycles);
  let left: Int = cycles;
  if (left < 0) {
    left = 0;
  }
  setCycles(left - 1);
  dt2SurvivalHealthWalk();
}
