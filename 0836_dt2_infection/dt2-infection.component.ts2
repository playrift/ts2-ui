import { createRef, useInterval } from 'ts2';

import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  InfectionColor,
  InfectionFonts,
  InfectionSprites,
  Layout,
  PERCENT_TEXT,
  ROOT_H,
  ROOT_W,
  SHINE_H,
  SHINE_WASH,
} from './dt2-infection.constants';
import { infectionBar, infectionRelayout } from './dt2-infection.helpers';

const timerHost1 = createRef('0836_dt2_infection_timer_host1');

const timerHost2 = createRef('0836_dt2_infection_timer_host2');

const universe = createRef('dt2_infection_universe');

const overlay = createRef('dt2_infection_overlay');

const barFill = createRef('dt2_infection_infection_bar_foreground');
const percentage = createRef('dt2_infection_infection_percentage');
const glyph = createRef('dt2_infection_infection_icon');

export function Dt2Infection(): Component {
  useInterval(() => infectionRelayout(timerHost1, universe, overlay), timerHost1);
  useInterval(() => infectionBar(timerHost2, percentage, barFill, glyph), timerHost2);

  return (
    <layer ref={universe} w={ROOT_W} h={ROOT_H}>
      <layer w="fill" h="fill" hide>
        <rect w="fill" h="fill" fill color={InfectionColor.FADE} />
      </layer>

      <layer w="fill" h="fill" ref={timerHost1}>
        <layer ref={overlay} x={Layout.CARD_X} y={Layout.CARD_Y} w={Layout.CARD_W} h={Layout.CARD_H}>
          <layer
            x={Layout.BAR_X}
            y="center"
            w={{ fill: Layout.BAR_INSET_W }}
            h={{ fill: Layout.BAR_INSET_H }}
            ref={timerHost2}
          >
            <rect w="fill" h="fill" fill color={InfectionColor.BAR_BACK} />

            <rect ref={barFill} w="fill" h="fill" fill color={InfectionColor.BAR_FILL} />

            <rect w="fill" h={SHINE_H} fill color={InfectionColor.SHINE} transparency={SHINE_WASH} />

            <text
              ref={percentage}
              x="center"
              y={{ center: Layout.PERCENT_Y }}
              w={Layout.PERCENT_W}
              h={Layout.PERCENT_H}
              text={PERCENT_TEXT}
              font={InfectionFonts.PERCENT}
              align="center"
              valign="middle"
              shadow
              color={InfectionColor.TEXT}
            />

            <rect
              x={{ right: Layout.DOT_INSET }}
              y={{ bottom: Layout.DOT_INSET }}
              w={Layout.DOT}
              h={Layout.DOT}
              fill
              color={InfectionColor.CORNER}
            />
            <rect
              x={{ right: Layout.DOT_INSET }}
              y={Layout.DOT_INSET}
              w={Layout.DOT}
              h={Layout.DOT}
              fill
              color={InfectionColor.CORNER}
            />

            <ThinBoxEntrypoint />
          </layer>

          <layer w={Layout.ICON_W} h={Layout.ICON_H}>
            <sprite x={Layout.ORB_X} y={Layout.ORB_Y} w={Layout.ORB} h={Layout.ORB} sprite={InfectionSprites.ORB} />
            <sprite
              x={Layout.GLYPH_X}
              y={Layout.GLYPH_Y}
              w={Layout.GLYPH}
              h={Layout.GLYPH}
              sprite={InfectionSprites.ICON_BACK}
            />
            <sprite
              ref={glyph}
              x={Layout.GLYPH_X}
              y={Layout.GLYPH_Y}
              w={Layout.GLYPH}
              h={Layout.GLYPH}
              sprite={InfectionSprites.ICON}
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
