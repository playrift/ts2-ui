import { useServerState, useState } from 'ts2';

import { responsiveCurrentBreakpoint } from '../lib/game/varcs';
import { scaled } from '../lib/lib.engine';
import {
  BreakpointGates,
  HEALTHY_TEXT,
  INFECTION_MAX,
  InfectionVarbits,
  Layout,
  OverlayWidths,
  STRANGLED_TEXT,
  universe,
} from './dt2-infection.constants';
import {
  infectionBarPx,
  infectionGlyphAlpha,
  infectionMeasuredPx,
  infectionWalkTarget,
  infectionWalkTrackPx,
} from './dt2-infection.state';

export const enum Snap {
  WALK = 0,
  NOW = 1,
}

const CLEAR = 255;

export function breakpointOf(width: Int, height: Int): Int {
  let level: Int = 0;
  if (width > BreakpointGates.W1 && height > BreakpointGates.H1) {
    level = 1;
  }
  if (width > BreakpointGates.W2 && height > BreakpointGates.H2) {
    level = 2;
  }
  if (width > BreakpointGates.W3 && height > BreakpointGates.H3) {
    level = 3;
  }
  return level;
}

export function overlayWidth(breakpoint: Int): Int {
  if (breakpoint === 1) {
    return OverlayWidths.ONE;
  }
  if (breakpoint === 2) {
    return OverlayWidths.TWO;
  }
  if (breakpoint === 3) {
    return OverlayWidths.THREE;
  }
  return OverlayWidths.BASE;
}

export function cardWidth(): Int {
  const [breakpoint] = useState(responsiveCurrentBreakpoint);
  return overlayWidth(breakpoint);
}

export function trackWidth(): Int {
  return cardWidth() - Layout.BAR_INSET_W;
}

export function barTarget(infection: Int, trackW: Int): Int {
  if (infection === 0) {
    return 0;
  }
  if (infection === INFECTION_MAX) {
    return trackW;
  }
  const target: Int = scaled(infection, INFECTION_MAX, trackW);
  if (target < 1) {
    return 1;
  }
  return target;
}

export function glyphAlphaFor(px: Int, trackW: Int): Int {
  return scaled(px, trackW, CLEAR);
}

export function infectionCaption(infection: Int): String {
  if (infection === 0) {
    return HEALTHY_TEXT;
  }
  if (infection === INFECTION_MAX) {
    return STRANGLED_TEXT;
  }
  let pct: Int = scaled(infection, INFECTION_MAX, 100);
  if (pct < 1) {
    pct = 1;
  }
  return `Infection: ${pct}%`;
}

export function publishBreakpoint(): void {
  const [, setBreakpoint] = useState(responsiveCurrentBreakpoint);
  setBreakpoint(breakpointOf(universe.width, universe.height));
}

export function infectionBar(snap: Int): void {
  const infection: Int = useServerState(InfectionVarbits.INFECTION);
  const [barPx, setBarPx] = useState(infectionBarPx);
  const [, setWalkTarget] = useState(infectionWalkTarget);
  const [, setWalkTrackPx] = useState(infectionWalkTrackPx);

  if (infection === 0) {
    setBarPx(0);
    return;
  }
  const trackW: Int = trackWidth();
  if (infection === INFECTION_MAX) {
    setBarPx(trackW);
    return;
  }

  const target: Int = barTarget(infection, trackW);
  if (barPx <= 0) {
    setBarPx(1);
  }
  setWalkTarget(target);
  setWalkTrackPx(trackW);
  if (snap === Snap.NOW) {
    infectionBarWalk(snap);
  }
}

export function infectionBarWalk(snap: Int): void {
  const [walkTarget, setWalkTarget] = useState(infectionWalkTarget);
  if (walkTarget === -1) {
    return;
  }
  const [walkTrackPx] = useState(infectionWalkTrackPx);
  const [shown, setBarPx] = useState(infectionBarPx);
  const [, setAlpha] = useState(infectionGlyphAlpha);
  const trackW: Int = trackWidth();

  let next: Int = shown;
  if (walkTrackPx !== trackW) {
    next = walkTarget;
  } else if (snap === Snap.NOW || shown === 0) {
    next = walkTarget;
  } else if (shown < walkTarget) {
    next = shown + 1;
  } else if (shown > walkTarget) {
    next = shown - 1;
  }

  setBarPx(next);
  setAlpha(glyphAlphaFor(next, trackW));
  if (next === walkTarget) {
    setWalkTarget(-1);
  }
}

export function infectionTick(): void {
  const trackW: Int = trackWidth();
  const [measured, setMeasured] = useState(infectionMeasuredPx);
  if (measured !== trackW) {
    setMeasured(trackW);
    infectionBar(Snap.NOW);
  }
  infectionBarWalk(Snap.WALK);
}
