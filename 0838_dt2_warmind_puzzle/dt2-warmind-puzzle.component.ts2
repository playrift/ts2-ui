import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import {
  GridLines,
  Hints,
  Layout,
  SectionWalls,
  WarmindArt,
  WarmindColors,
  WarmindFonts,
  WarmindModels,
} from './dt2-warmind-puzzle.constants';
import { PowerOnButton, powerOnSound } from './power-on-button.component';
import { WarmindGrid } from './warmind-grid.component';
import { WarmindPieces } from './warmind-pieces.component';

export function WarmindPuzzle(): Component {
  return (
    <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
      <layer w="fill" h="fill">
        <layer x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={WarmindArt.BACKDROP} />
        </layer>

        <layer
          x={Layout.BUTTON_X}
          y={Layout.BUTTON_Y}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          options={['Power-on']}
          onOptionSelect={() => powerOnSound()}
        >
          <PowerOnButton />
        </layer>

        <CloseButton />

        <layer right={Layout.RULES_RIGHT} y={Layout.RULES_Y} w={Layout.RULES_W} h={Layout.RULES_H}>
          <model x={70} y={86} w={25} h={33} model={WarmindModels.CELL} zoom={2648} pitch={461} yaw={57} roll={5} />
          <model
            x={55}
            y={10}
            w={32}
            h={32}
            model={WarmindModels.SIGIL}
            zoom={1854}
            pitch={176}
            yaw={581}
            roll={1950}
          />
          {Hints.map((hint) => (
            <text
              x={hint.x}
              y={hint.y}
              w={hint.w}
              h={hint.h}
              text={hint.text}
              font={WarmindFonts.HINT}
              shadow
              lineHeight={14}
              color={WarmindColors.HINT}
            />
          ))}
        </layer>

        <SteelFrameEntrypoint />
      </layer>

      <layer x={Layout.BOARD_X} y={Layout.BOARD_Y} w={Layout.BOARD} h={Layout.BOARD}>
        <layer x={0} y={0} w={Layout.BOARD} h={Layout.BOARD}>
          {GridLines.map((line) => (
            <rect x={line.x} y={line.y} w={line.w} h={line.h} color={WarmindColors.RULE} fill />
          ))}
          <rect w="fill" h="fill" color={WarmindColors.BOARD} fill />
          <WarmindGrid />
        </layer>

        <layer w="fill" h="fill">
          {SectionWalls.map((wall) => (
            <rect x={wall.x} y={wall.y} w={wall.w} h={wall.h} color={WarmindColors.WALL} fill />
          ))}
        </layer>

        <layer w="fill" h="fill">
          <WarmindPieces />
        </layer>
      </layer>
    </layer>
  );
}
