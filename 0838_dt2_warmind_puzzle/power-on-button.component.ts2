import { useState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { ButtonLabel, WarmindColors, WarmindFonts, WarmindSounds } from './dt2-warmind-puzzle.constants';

export function powerOnSound(): void {
  playSound(WarmindSounds.POWER_ON);
}

export function PowerOnButton(): Component {
  const [held, setHeld] = useState(0);

  if (onMobile()) {
    return (
      <layer w="fill" h="fill">
        <StoneButtonFilled>
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={ButtonLabel.TEXT}
            font={WarmindFonts.BUTTON}
            shadow
            align="center"
            valign="middle"
            lineHeight={ButtonLabel.LINE_HEIGHT}
            color={WarmindColors.BUTTON_LABEL}
          />
        </StoneButtonFilled>
      </layer>
    );
  }

  if (held === 1) {
    return (
      <layer w="fill" h="fill" onMouseRepeat={() => setHeld(1)} onMouseLeave={() => setHeld(0)}>
        <StoneButtonPressedFilled>
          <text
            x="center"
            y="center"
            w="fill"
            h="fill"
            text={ButtonLabel.TEXT}
            font={WarmindFonts.BUTTON}
            shadow
            align="center"
            valign="middle"
            lineHeight={ButtonLabel.LINE_HEIGHT}
            color={WarmindColors.BUTTON_LABEL}
          />
        </StoneButtonPressedFilled>
      </layer>
    );
  }

  return (
    <layer w="fill" h="fill" onMouseRepeat={() => setHeld(1)} onMouseLeave={() => setHeld(0)}>
      <StoneButtonFilled>
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={ButtonLabel.TEXT}
          font={WarmindFonts.BUTTON}
          shadow
          align="center"
          valign="middle"
          lineHeight={ButtonLabel.LINE_HEIGHT}
          color={WarmindColors.BUTTON_LABEL}
        />
      </StoneButtonFilled>
    </layer>
  );
}
