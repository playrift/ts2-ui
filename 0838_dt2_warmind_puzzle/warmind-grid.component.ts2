import { intArray } from 'ts2';

import { Grid, SectionColors, WarmindSections } from './dt2-warmind-puzzle.constants';

export function WarmindGrid(): Component {
  const tint = intArray(64);

  let section: Int = 0;
  while (section < 8) {
    const cells: List<Int> = WarmindSections.at(section);
    let i: Int = 0;
    while (i < cells.length) {
      tint[cells.at(i)] = SectionColors.at(section);
      i = i + 1;
    }
    section = section + 1;
  }

  return (
    <>
      {tint.map((color, cell) => (
        <rect
          x={Grid.ORIGIN + Grid.STRIDE * (cell % Grid.ACROSS)}
          y={Grid.ORIGIN + Grid.STRIDE * (cell / Grid.ACROSS)}
          w={Grid.CELL}
          h={Grid.CELL}
          color={color}
          fill
          transparency={Grid.TINT}
        />
      ))}
    </>
  );
}
