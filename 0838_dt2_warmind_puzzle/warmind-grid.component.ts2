import { intArray } from 'ts2';

import { Grid, SECTION_COLOR_DEFAULT, SectionColors, WarmindSections } from './dt2-warmind-puzzle.constants';

export function WarmindGrid(): Component {
  const tint = intArray(64);

  let section: Int = 0;
  while (section < 8) {
    const cells: List<Int> | null = WarmindSections.at(section);
    if (cells !== null) {
      let i: Int = 0;
      while (i < cells.length) {
        const cell: Int | null = cells.at(i);
        if (cell !== null) {
          tint[cell] = SectionColors.at(section) ?? SECTION_COLOR_DEFAULT;
        }
        i = i + 1;
      }
    }
    section = section + 1;
  }

  return (
    <>
      {tint.map((color, cell) => (
        <rect
          x={Grid.ORIGIN + Grid.STRIDE * (cell % Grid.ACROSS)}
          y={Grid.ORIGIN + Grid.STRIDE * (cell / Grid.ACROSS)}
          w={Grid.CELL}
          h={Grid.CELL}
          color={color}
          fill
          transparency={Grid.TINT}
        />
      ))}
    </>
  );
}
