import { SmokeTint } from './dt2-smokeoverlay.constants';

export function Dt2Smokeoverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect x={0} y={0} w="fill" h="fill" color={SmokeTint.COLOR} fill={true} transparency={SmokeTint.TRANSPARENCY} />
    </layer>
  );
}
