import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  GhorrockArt,
  GhorrockColors,
  GhorrockFonts,
  GhorrockModels,
  GridLines,
  Layout,
  Letters,
  Rule,
} from './ghorrock-square-cipher.constants';

export function GhorrockSquareCipher(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
        <model
          x={{ center: Layout.PARCHMENT_DX }}
          y={{ center: Layout.PARCHMENT_DY }}
          w={Layout.PARCHMENT}
          h={Layout.PARCHMENT}
          model={GhorrockModels.PARCHMENT}
          pitch={Layout.PARCHMENT_PITCH}
          zoom={Layout.PARCHMENT_ZOOM}
        />

        <sprite
          x={{ right: Layout.CLOSE_RIGHT }}
          y={Layout.CLOSE_TOP}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={GhorrockArt.CLOSE}
          options={['Close']}
          onOptionSelect={() => {
            closeInterface();
          }}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, GhorrockArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, GhorrockArt.CLOSE)}
        />

        <layer
          x={{ center: Layout.CONTENT_DX }}
          y={{ center: Layout.CONTENT_DY }}
          w={Layout.CONTENT_W}
          h={Layout.CONTENT_H}
        >
          <layer x="center" y="center" w={Layout.GRID} h={Layout.GRID}>
            {GridLines.map((rule) => (
              <line
                x={Rule.SHADOW_START}
                y={rule.back}
                w={{ fill: Rule.INSET }}
                h={0}
                color={GhorrockColors.SHADOW}
                lineWidth={Rule.WIDTH}
              />
            ))}

            {GridLines.map((rule) => (
              <line
                x={rule.back}
                y={Rule.SHADOW_START}
                w={0}
                h={{ fill: Rule.INSET }}
                color={GhorrockColors.SHADOW}
                lineWidth={Rule.WIDTH}
              />
            ))}

            {GridLines.map((rule) => (
              <line
                x={Rule.INK_START}
                y={rule.front}
                w={{ fill: Rule.INSET }}
                h={0}
                color={GhorrockColors.INK}
                lineWidth={Rule.WIDTH}
              />
            ))}

            {GridLines.map((rule) => (
              <line
                x={rule.front}
                y={Rule.INK_START}
                w={0}
                h={{ fill: Rule.INSET }}
                color={GhorrockColors.INK}
                lineWidth={Rule.WIDTH}
              />
            ))}

            {GridLines.map((rule) => (
              <text
                x={rule.back}
                y={Rule.INK_START}
                w={Layout.GLYPH}
                h={Layout.GLYPH}
                text={rule.label}
                font={GhorrockFonts.INK}
                color={GhorrockColors.COLUMN}
                align="center"
                valign="middle"
                shadow
              />
            ))}

            {GridLines.map((rule) => (
              <text
                x={Rule.INK_START}
                y={rule.back}
                w={Layout.GLYPH}
                h={Layout.GLYPH}
                text={rule.label}
                font={GhorrockFonts.INK}
                color={GhorrockColors.ROW}
                align="center"
                valign="middle"
                shadow
              />
            ))}

            {Letters.map((letter) => (
              <text
                x={letter.x}
                y={letter.y}
                w={Layout.GLYPH}
                h={Layout.GLYPH}
                text={letter.text}
                font={GhorrockFonts.INK}
                color={GhorrockColors.INK}
                align="center"
                valign="middle"
                shadow
              />
            ))}
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
