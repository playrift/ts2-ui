import { createRef } from 'ts2';

import { modelDynamicZoom } from '../lib/lib.models';
import { CutsceneAnims, CutsceneCamera, CutsceneFade, CutsceneModel } from './dt2-smokeoverlay-cutscene.constants';

const cutsceneHaze = createRef('dt2_smokeoverlay_cutscene_haze');

export function Dt2SmokeoverlayCutscene(): Component {
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onTimer={(event) =>
        modelDynamicZoom(
          event.component,
          cutsceneHaze,
          CutsceneCamera.NEAR,
          CutsceneCamera.FAR,
          CutsceneCamera.OFFSET_X,
          CutsceneCamera.OFFSET_Y,
          CutsceneCamera.PITCH,
          CutsceneCamera.YAW,
          CutsceneCamera.ROLL,
        )
      }
    >
      <model
        ref={cutsceneHaze}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={CutsceneModel.HAZE}
        anim={CutsceneAnims.HAZE}
        zoom={CutsceneCamera.NEAR}
      />

      <rect
        x={0}
        y={0}
        w="fill"
        h="fill"
        color={CutsceneFade.COLOR}
        fill={true}
        transparency={CutsceneFade.TRANSPARENCY}
      />
    </layer>
  );
}
