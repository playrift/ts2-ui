import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Layout, SpArt, SpColor, SpFonts } from './deadman-sp.constants';

export function DeadmanSp(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <text
        x={Layout.HEADER_X}
        y={0}
        w={{ fill: Layout.HEADER_W_INSET }}
        h={Layout.HEADER_H}
        text="Deadman Annihilation"
        font={SpFonts.HEADING}
        color={SpColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer x="center" y={Layout.BORDER_Y} w="fill" h={{ fill: Layout.BORDER_H_INSET }}>
        <layer x="center" y="center" w={{ fill: Layout.INNER_W_INSET }} h={{ fill: Layout.INNER_H_INSET }}>
          <layer x={0} y={0} w={Layout.POINTS_W} h={Layout.POINTS_H}>
            <layer x="center" y={Layout.BAND_Y} w={{ fill: Layout.BAND_W_INSET }} h={Layout.BAND_H} />

            <text
              x={0}
              y={Layout.TITLE_Y}
              w="fill"
              h={Layout.TITLE_H}
              text="Total Points"
              font={SpFonts.TITLE}
              color={SpColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />

            <layer x={{ right: Layout.BADGE_RIGHT }} y={Layout.BADGE_Y} w={Layout.BADGE} h={Layout.BADGE}>
              <layer x={0} y={0} w="fill" h="fill" />

              <sprite
                x={Layout.ICON_XY}
                y={Layout.ICON_XY}
                w={Layout.ICON}
                h={Layout.ICON}
                sprite={SpArt.REFRESH_ICON}
              />
            </layer>

            <text
              x="center"
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text="56857"
              font={SpFonts.HEADING}
              color={SpColor.VALUE}
              shadow
              align="center"
              valign="middle"
            />

            <layer x="center" y={Layout.POINTS_BUTTON_Y} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
              <layer x={0} y={0} w="fill" h="fill" />
            </layer>
          </layer>

          <layer x={0} y={Layout.DURATION_Y} w={Layout.DURATION_W} h={Layout.DURATION_H}>
            <layer x="center" y={Layout.BAND_Y} w={{ fill: Layout.BAND_W_INSET }} h={Layout.BAND_H} />

            <text
              x="center"
              y={Layout.TITLE_Y}
              w={Layout.TITLE_W}
              h={Layout.TITLE_H}
              text="Time Remaining"
              font={SpFonts.TITLE}
              color={SpColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />

            <text
              x="center"
              y={Layout.VALUE_Y}
              w={Layout.VALUE_W}
              h={Layout.VALUE_H}
              text="You are out of time"
              font={SpFonts.BODY}
              color={SpColor.VALUE}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>

        <ThinBoxEntrypoint />
      </layer>

      <layer x={0} y={Layout.OTHER_Y} w="fill" h={Layout.OTHER_H}>
        <layer x="right" y={0} w="fill" h="fill">
          <layer x={Layout.INFO_BUTTON_X} y={Layout.INFO_BUTTON_Y} w={Layout.BUTTON_W} h={Layout.BUTTON_H}>
            <layer x={0} y={0} w="fill" h="fill" />
          </layer>
        </layer>
      </layer>

      <layer x="center" y="bottom" w={{ fill: Layout.HUD_W_INSET }} h={Layout.HUD_H} options={['*']} hide />

      <layer x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} hide />
    </layer>
  );
}
