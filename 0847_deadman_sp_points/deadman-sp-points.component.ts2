import { Layout, PointsArt, PointsColor, PointsFonts } from './deadman-sp-points.constants';

export function DeadmanSpPoints(): Component {
  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H}>
      <layer x="center" y="center" w="fill" h="fill" />

      <layer x="center" y="center" w="fill" h="fill">
        <layer x="center" y="center" w={{ fill: Layout.BACKGROUND_INSET }} h={{ fill: Layout.BACKGROUND_INSET }} />

        <layer x={0} y={0} w={{ fill: Layout.CONTENT_W_INSET }} h={{ fill: Layout.CONTENT_H_INSET }} />

        <text
          x={0}
          y={Layout.TITLE_Y}
          w="fill"
          h={Layout.TITLE_H}
          font={PointsFonts.TITLE}
          color={PointsColor.TEXT}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x="center"
          y={Layout.DESCRIPTION_Y}
          w={{ fill: Layout.DESCRIPTION_W_INSET }}
          h={Layout.DESCRIPTION_H}
          font={PointsFonts.BODY}
          color={PointsColor.TEXT}
          shadow
          align="center"
        />

        <sprite x={0} y={0} w={Layout.ICON} h={Layout.ICON} sprite={PointsArt.BOSS_ICON} hide />

        <line
          x="center"
          y={Layout.RULE_Y}
          w={{ fill: Layout.RULE_W_INSET }}
          color={PointsColor.RULE}
          lineWidth={Layout.RULE_WIDTH}
          hide
        />

        <layer x="center" y={Layout.TABLE_Y} w={{ fill: Layout.TABLE_W_INSET }} h={{ fill: Layout.TABLE_H_INSET }}>
          <layer x={0} y={0} w="fill" h="fill" />

          <layer x={0} y={0} w="fill" h="fill">
            <layer x={0} y={0} w={{ fill: Layout.HEADER_W_INSET }} h={Layout.HEADER_H}>
              <layer x={0} y={0} w="fill" h="fill" />
              <layer x={0} y={0} w={Layout.COL_1_W} h="fill" />
              <layer x={Layout.COL_2_X} y={0} w={Layout.COL_2_W} h="fill" />
              <layer x={Layout.COL_3_X} y={0} w={{ fill: Layout.COL_3_W_INSET }} h="fill" />
            </layer>

            <layer x={0} y={Layout.BODY_Y} w={{ fill: Layout.BODY_W_INSET }} h={{ fill: Layout.BODY_H_INSET }}>
              <layer x={0} y={0} w="fill" h="fill" />
              <layer x={0} y={0} w={Layout.COL_1_W} h="fill" />
              <layer x={Layout.COL_2_X} y={0} w={Layout.COL_2_W} h="fill">
                <layer x={0} y={0} w="fill" h="fill" />
              </layer>
              <layer x={Layout.COL_3_X} y={0} w={{ fill: Layout.COL_3_W_INSET }} h="fill" />
            </layer>

            <layer x={{ right: Layout.SCROLL_RIGHT }} y={0} w={Layout.SCROLL_W} h="fill" />
          </layer>

          <layer x={0} y={0} w="fill" h="fill">
            <layer x={0} y={Layout.PANE_Y} w={{ fill: Layout.PANE_W_INSET }} h={{ fill: Layout.PANE_H_INSET }} />
            <layer x={{ right: Layout.SCROLL_RIGHT }} y={0} w={Layout.SCROLL_W} h="fill" />
          </layer>

          <layer x={0} y={0} w="fill" h="fill">
            <layer x={0} y={Layout.ABOUT_Y} w="fill" h={{ fill: Layout.ABOUT_H_INSET }} />
          </layer>
        </layer>

        <layer
          x={{ center: Layout.BUTTON_LEFT_DX }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        >
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        </layer>

        <layer
          x={{ center: Layout.BUTTON_LEFT_DX }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        >
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        </layer>

        <layer x="center" y={{ bottom: Layout.BUTTON_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} noClickThrough>
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        </layer>

        <layer x="center" y={{ bottom: Layout.BUTTON_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} noClickThrough>
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        </layer>

        <layer
          x={{ center: Layout.BUTTON_RIGHT_DX }}
          y={{ bottom: Layout.BUTTON_BOTTOM }}
          w={Layout.BUTTON_W}
          h={Layout.BUTTON_H}
          noClickThrough
        >
          <layer x={0} y={0} w={Layout.BUTTON_W} h={Layout.BUTTON_H} />
        </layer>
      </layer>
    </layer>
  );
}
