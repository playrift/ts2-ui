import { useServerState } from 'ts2';

import { examineLabel } from './pog-coin-machine.helpers';
import { graphicPairSwapperUnlessMobile } from '../lib/lib.helpers';
import { insertLabel } from '../lib/lib.labels';
import { PogArt, PogVarps } from './pog-coin-machine.constants';

export function CoinWindowOps({
  slot1,
  window1,
  slot2,
  window2,
  slot3,
  window3,
}: {
  slot1: Ref;
  window1: Ref;
  slot2: Ref;
  window2: Ref;
  slot3: Ref;
  window3: Ref;
}): Component {
  const selected: Item = useServerState(PogVarps.SELECTED) as Item;
  const display1: Item = useServerState(PogVarps.DISPLAY_1) as Item;
  const display2: Item = useServerState(PogVarps.DISPLAY_2) as Item;
  const display3: Item = useServerState(PogVarps.DISPLAY_3) as Item;
  const target1: Item = useServerState(PogVarps.TARGET_1) as Item;
  const target2: Item = useServerState(PogVarps.TARGET_2) as Item;
  const target3: Item = useServerState(PogVarps.TARGET_3) as Item;

  return (
    <>
      <layer
        x={{ center: -48 }}
        y={{ center: -80 }}
        w={64}
        h={45}
        options={[insertLabel(display1, selected)]}
        onMouseRepeat={() => {
          graphicPairSwapperUnlessMobile(slot1, PogArt.SLOT_LIT, window1, PogArt.WINDOW_LIT);
        }}
        onMouseLeave={() => {
          graphicPairSwapperUnlessMobile(slot1, PogArt.SLOT, window1, PogArt.WINDOW);
        }}
      />
      <layer
        x={{ center: -48 }}
        y={{ center: -17 }}
        w={64}
        h={45}
        options={[insertLabel(display2, selected)]}
        onMouseRepeat={() => {
          graphicPairSwapperUnlessMobile(slot2, PogArt.SLOT_LIT, window2, PogArt.WINDOW_LIT);
        }}
        onMouseLeave={() => {
          graphicPairSwapperUnlessMobile(slot2, PogArt.SLOT, window2, PogArt.WINDOW);
        }}
      />
      <layer
        x={{ center: -48 }}
        y={{ center: 38 }}
        w={64}
        h={45}
        options={[insertLabel(display3, selected)]}
        onMouseRepeat={() => {
          graphicPairSwapperUnlessMobile(slot3, PogArt.SLOT_LIT, window3, PogArt.WINDOW_LIT);
        }}
        onMouseLeave={() => {
          graphicPairSwapperUnlessMobile(slot3, PogArt.SLOT, window3, PogArt.WINDOW);
        }}
      />

      <layer
        x={{ center: 12 }}
        y={{ center: -80 }}
        w={45}
        h={45}
        options={['', '', '', '', '', '', '', '', '', examineLabel(target1)]}
      />
      <layer
        x={{ center: 57 }}
        y={{ center: -80 }}
        w={45}
        h={45}
        options={['', '', '', '', '', '', '', '', '', examineLabel(target2)]}
      />
      <layer
        x={{ center: 36 }}
        y={{ center: 10 }}
        w={45}
        h={45}
        options={['', '', '', '', '', '', '', '', '', examineLabel(target3)]}
      />
    </>
  );
}
