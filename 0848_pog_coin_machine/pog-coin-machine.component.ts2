import { useRef } from 'ts2';

import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { CoinWindowOps } from './coin-window-ops.component';
import { graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { PogArt } from './pog-coin-machine.constants';

export function PogCoinMachine(): Component {
  const slot1 = useRef();
  const slot2 = useRef();
  const slot3 = useRef();
  const window1 = useRef();
  const window2 = useRef();
  const window3 = useRef();

  const reset = useRef();
  const submit = useRef();

  return (
    <layer x="center" y="center" w={390} h={292}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: 12 }} h={{ fill: 12 }}>
        <sprite x="center" y="center" w={322} h={280} sprite={PogArt.MACHINE} />

        <sprite ref={slot1} x={110} y={38} w={17} h={43} sprite={PogArt.SLOT} />
        <sprite ref={slot2} x={110} y={101} w={17} h={43} sprite={PogArt.SLOT} />
        <sprite ref={slot3} x={110} y={156} w={17} h={43} sprite={PogArt.SLOT} />
        <sprite ref={window1} x={129} y={38} w={43} h={43} sprite={PogArt.WINDOW} />
        <sprite ref={window2} x={129} y={101} w={43} h={43} sprite={PogArt.WINDOW} />
        <sprite ref={window3} x={129} y={156} w={43} h={43} sprite={PogArt.WINDOW} />

        <sprite ref={reset} x={189} y={228} w={29} h={29} sprite={PogArt.RESET} />
        <sprite ref={submit} x={228} y={228} w={29} h={29} sprite={PogArt.SUBMIT} />

        <model x={{ center: -39 }} y={{ center: -81 }} w={32} h={32} zoom={400} />
        <model x={{ center: -39 }} y={{ center: -18 }} w={32} h={32} zoom={272} />
        <model x={{ center: -39 }} y={{ center: 37 }} w={32} h={32} zoom={400} />
        <model x={{ center: 11 }} y={{ center: -81 }} w={32} h={32} zoom={400} />
        <model x={{ center: 56 }} y={{ center: -81 }} w={32} h={32} zoom={400} />
        <model x={{ center: 35 }} y={{ center: 9 }} w={32} h={32} zoom={400} />

        <CoinWindowOps
          slot1={slot1}
          window1={window1}
          slot2={slot2}
          window2={window2}
          slot3={slot3}
          window3={window3}
        />

        <layer
          x={{ center: 15 }}
          y={{ center: 103 }}
          w={33}
          h={33}
          options={['Reset']}
          onMouseRepeat={() => {
            graphicSwapperUnlessMobile(reset, PogArt.RESET_LIT);
          }}
          onMouseLeave={() => {
            graphicSwapperUnlessMobile(reset, PogArt.RESET);
          }}
        />
        <layer
          x={{ center: 54 }}
          y={{ center: 103 }}
          w={33}
          h={33}
          options={['Submit']}
          onMouseRepeat={() => {
            graphicSwapperUnlessMobile(submit, PogArt.SUBMIT_LIT);
          }}
          onMouseLeave={() => {
            graphicSwapperUnlessMobile(submit, PogArt.SUBMIT);
          }}
        />
      </layer>

      <CloseButton />
    </layer>
  );
}
