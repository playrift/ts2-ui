import { useInventory, useRef, useServerState } from 'ts2';

import { graphicPairSwapperUnlessMobile } from '../lib/lib.helpers';
import { insertLabel } from '../lib/lib.labels';
import { PogArt, PogInventories, PogVarps } from './pog-coin-exchanger.constants';

export function CoinInput({ slot }: { slot: Int }): Component {
  const input = useInventory(PogInventories.IN);
  const selected: Item = useServerState(PogVarps.SELECTED) as Item;

  const held: Item = input[slot];

  const coinSlot = useRef();
  const coinWindow = useRef();

  return (
    <>
      <sprite ref={coinSlot} x={1} y="center" w={17} h={43} sprite={PogArt.SLOT} />

      <sprite ref={coinWindow} x={{ right: 1 }} y="center" w={43} h={43} sprite={PogArt.WINDOW} />

      <model x={{ right: 7 }} y="center" w={32} h={32} zoom={800} />

      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        options={[insertLabel(held, selected)]}
        onMouseRepeat={() => {
          graphicPairSwapperUnlessMobile(coinSlot, PogArt.SLOT_LIT, coinWindow, PogArt.WINDOW_LIT);
        }}
        onMouseLeave={() => {
          graphicPairSwapperUnlessMobile(coinSlot, PogArt.SLOT, coinWindow, PogArt.WINDOW);
        }}
      />
    </>
  );
}
