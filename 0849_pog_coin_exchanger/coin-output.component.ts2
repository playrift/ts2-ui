import { useInventory } from 'ts2';

import { examineLabel } from './pog-coin-exchanger.helpers';
import { PogInventories } from './pog-coin-exchanger.constants';

export function CoinOutput({ slot }: { slot: Int }): Component {
  const output = useInventory(PogInventories.OUT);
  const offered: Item = output[slot];

  return (
    <>
      <model x="center" y="center" w={32} h={32} zoom={800} />
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        options={['', '', '', '', '', '', '', '', '', examineLabel(offered)]}
      />
    </>
  );
}
