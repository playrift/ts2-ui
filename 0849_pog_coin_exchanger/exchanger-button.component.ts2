import { useRef } from 'ts2';

import { graphicSwapperUnlessMobile } from '../lib/lib.helpers';

export function ExchangerButton({
  label,
  faceWidth,
  faceHeight,
  resting,
  lit,
}: {
  label: String;
  faceWidth: Int;
  faceHeight: Int;
  resting: Sprite;
  lit: Sprite;
}): Component {
  const face = useRef();

  return (
    <>
      <sprite ref={face} x="center" y="center" w={faceWidth} h={faceHeight} sprite={resting} />
      <layer
        x="center"
        y="center"
        w="fill"
        h="fill"
        options={[label]}
        onMouseRepeat={() => {
          graphicSwapperUnlessMobile(face, lit);
        }}
        onMouseLeave={() => {
          graphicSwapperUnlessMobile(face, resting);
        }}
      />
    </>
  );
}
