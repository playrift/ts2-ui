import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { CoinInput } from './coin-input.component';
import { CoinOutput } from './coin-output.component';
import { ExchangerButton } from './exchanger-button.component';
import { PogArt } from './pog-coin-exchanger.constants';

export function PogCoinExchanger(): Component {
  return (
    <layer x="center" y="center" w={360} h={280}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: 12 }} h={{ fill: 12 }}>
        <sprite x="center" y="center" w={277} h={231} sprite={PogArt.EXCHANGER} />

        <layer x={77} y={52} w={65} h={45}>
          <CoinInput slot={0} />
        </layer>
        <layer x={77} y={98} w={65} h={45}>
          <CoinInput slot={1} />
        </layer>
        <layer x={77} y={144} w={65} h={45}>
          <CoinInput slot={2} />
        </layer>

        <layer x={193} y={56} w={45} h={45}>
          <CoinOutput slot={0} />
        </layer>
        <layer x={240} y={56} w={45} h={45}>
          <CoinOutput slot={1} />
        </layer>
        <layer x={193} y={103} w={45} h={45}>
          <CoinOutput slot={2} />
        </layer>
        <layer x={240} y={103} w={45} h={45}>
          <CoinOutput slot={3} />
        </layer>

        <layer x={66} y={194} w={33} h={33}>
          <ExchangerButton label="Reset" faceWidth={29} faceHeight={29} resting={PogArt.RESET} lit={PogArt.RESET_LIT} />
        </layer>
        <layer x={105} y={194} w={33} h={33}>
          <ExchangerButton
            label="Confirm"
            faceWidth={29}
            faceHeight={29}
            resting={PogArt.CONFIRM}
            lit={PogArt.CONFIRM_LIT}
          />
        </layer>
        <layer x={143} y={89} w={48} h={27}>
          <ExchangerButton
            label="Exchange"
            faceWidth={46}
            faceHeight={17}
            resting={PogArt.EXCHANGE}
            lit={PogArt.EXCHANGE_LIT}
          />
        </layer>
      </layer>

      <CloseButton />
    </layer>
  );
}
