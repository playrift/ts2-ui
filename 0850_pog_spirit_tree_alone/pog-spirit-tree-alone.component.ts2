import { createRef, useInterval } from 'ts2';

import { Camera, Layout, PogColor, PogModel, Spin } from './pog-spirit-tree-alone.constants';
import { spinner } from './pog-spirit-tree-alone.helpers';

const timerHost = createRef('0850_pog_spirit_tree_alone_timer_host');

export function PogSpiritTreeAlone(): Component {
  useInterval(() => {
    spinner(Spin.PITCH_STEP, Spin.YAW_STEP, Spin.ROLL_STEP, timerHost);
  }, timerHost);

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <rect x="center" y="center" w="fill" h="fill" color={PogColor.BLACK} fill={true} />

      <model
        x="center"
        y={{ center: Layout.TREE_Y_FROM_CENTER }}
        w={Layout.TREE_W}
        h={Layout.TREE_H}
        model={PogModel.SPIRIT_TREE}
        zoom={Camera.ZOOM}
        ref={timerHost}
      />

      <rect x="center" y="center" w="fill" h="fill" color={PogColor.BLACK} fill={true} />
    </>
  );
}
