import { CS2 } from 'ts2';

const TURN = 2047;

export function spinner(pitchStep: Int, yawStep: Int, rollStep: Int, target: ComponentId): void {
  CS2.if_model_angle_set(
    0,
    0,
    (CS2.if_model_angle_x_get(target) + pitchStep) & TURN,
    (CS2.if_model_angle_y_get(target) + yawStep) & TURN,
    (CS2.if_model_angle_z_get(target) + rollStep) & TURN,
    CS2.if_model_zoom_get(target),
    target,
  );
}
