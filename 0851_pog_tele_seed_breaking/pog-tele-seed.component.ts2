import { useState, useUniverse } from 'ts2';

import { Camera, Layout, SeedColors, SeedModels } from './pog-tele-seed.constants';
import { seedBackdropZoom, seedClampedHeight, seedY, seedZoom } from './pog-tele-seed.helpers';

export function PogTeleSeed({ anim }: { anim: Animation }): Component {
  const universe = useUniverse();
  const measured: Int = universe.height;

  const [seen, setSeen] = useState(0);
  universe.onResize = () => {
    setSeen(universe.height);
  };

  const clamped: Int = seedClampedHeight(seen === 0 ? measured : seen);

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <rect x="center" y="center" w="fill" h="fill" fill color={SeedColors.WASH} />

      <model
        x={{ center: Layout.BACKDROP_X }}
        y={{ center: Layout.BACKDROP_Y }}
        w={Layout.BACKDROP_W}
        h={Layout.BACKDROP_H}
        model={SeedModels.BACKDROP}
        pitch={Camera.BACKDROP_PITCH}
        yaw={Camera.BACKDROP_YAW}
        zoom={seedBackdropZoom(clamped)}
      />

      <model
        x={{ center: Layout.SEED_X }}
        y={{ center: seedY(clamped) }}
        w={Layout.SEED_W}
        h={Layout.SEED_H}
        model={SeedModels.SEED}
        anim={anim}
        pitch={Camera.SEED_PITCH}
        yaw={Camera.SEED_YAW}
        zoom={seedZoom(clamped)}
      />

      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        fill
        color={SeedColors.WASH}
        transparency={Layout.VEIL_TRANSPARENCY}
      />
    </>
  );
}
