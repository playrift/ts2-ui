import { CS2 } from 'ts2';

import { SeedCurve } from './pog-tele-seed.constants';

export const seedClampedHeight = (height: Int): Int => {
  let clamped: Int = height;
  if (clamped < SeedCurve.MIN_HEIGHT) {
    clamped = SeedCurve.MIN_HEIGHT;
  } else if (clamped > SeedCurve.MAX_HEIGHT) {
    clamped = SeedCurve.MAX_HEIGHT;
  }
  return clamped;
};

export const seedInterpolant = (clamped: Int, span: Int): Int => {
  const excess: Int = CS2.invpow(clamped - SeedCurve.MIN_HEIGHT, SeedCurve.ROOT);
  const full: Int = CS2.invpow(SeedCurve.MAX_HEIGHT - SeedCurve.MIN_HEIGHT, SeedCurve.ROOT);
  return CS2.interpolate(0, excess, 0, full, span);
};

export const seedBackdropZoom = (clamped: Int): Int =>
  SeedCurve.BACKDROP_NEAR - seedInterpolant(clamped, SeedCurve.BACKDROP_SPAN);

export const seedZoom = (clamped: Int): Int => SeedCurve.SEED_NEAR - seedInterpolant(clamped, SeedCurve.SEED_SPAN);

export const seedY = (clamped: Int): Int => SeedCurve.SEED_Y_NEAR - seedInterpolant(clamped, SeedCurve.SEED_Y_SPAN);
