import { Layout, PosterAnims, PosterColors, PosterModels } from './pog-poster-01.constants';

export function PogPoster01(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <rect x="center" y="center" w="fill" h="fill" fill color={PosterColors.GROUND} />

      <model
        x="center"
        y={{ center: Layout.WALL_DY }}
        w={Layout.WALL_W}
        h={Layout.WALL_H}
        model={PosterModels.WALL}
        zoom={Layout.WALL_ZOOM}
        offsetY={Layout.WALL_OFFSET_Y}
      />

      <model
        x={{ center: Layout.BOLRIE_DX }}
        y={{ center: Layout.BOLRIE_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.BOLRIE_POSTER}
        anim={PosterAnims.BOLRIE_POSTER}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />

      <model
        x={{ center: Layout.ARG_DX }}
        y={{ center: Layout.ARG_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.ARG_POSTER}
        anim={PosterAnims.ARG_POSTER}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />

      <model
        x={{ center: Layout.HAND_DX }}
        y={{ center: Layout.HAND_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.HAND}
        anim={PosterAnims.HAND}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />

      <model
        x={{ center: Layout.BRUSH_DX }}
        y={{ center: Layout.BRUSH_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.HAND_BRUSH}
        anim={PosterAnims.HAND_BRUSH}
        pitch={Layout.BRUSH_PITCH}
        roll={Layout.BRUSH_ROLL}
        zoom={Layout.BRUSH_ZOOM}
      />
    </layer>
  );
}
