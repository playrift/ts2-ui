import { Layout, OverlayAnims, OverlayColors, OverlayModels } from './pog-rs-map-overlay.constants';

export function PogRsMapOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <rect x="center" y="center" w="fill" h="fill" fill color={OverlayColors.GROUND} />

      <model
        x={{ center: Layout.MAP_DX }}
        y={{ center: Layout.MAP_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={OverlayModels.MAP}
        pitch={Layout.MAP_PITCH}
        yaw={Layout.MAP_YAW}
        zoom={Layout.MAP_ZOOM}
      />

      <model
        x={{ center: Layout.HEALTHORG_DX }}
        y={{ center: Layout.HEALTHORG_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={OverlayModels.HEALTHORG_BANNER}
        anim={OverlayAnims.BANNER}
        pitch={Layout.HEALTHORG_PITCH}
        yaw={Layout.HEALTHORG_YAW}
        zoom={Layout.HEALTHORG_ZOOM}
      />

      <model
        x={{ center: Layout.BOLRIE_DX }}
        y={{ center: Layout.BOLRIE_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={OverlayModels.BOLRIE_BANNER}
        anim={OverlayAnims.BANNER}
        pitch={Layout.BOLRIE_PITCH}
        yaw={Layout.BOLRIE_YAW}
        zoom={Layout.BOLRIE_ZOOM}
      />

      <model
        x={{ center: Layout.HUMAN_DX }}
        y={{ center: Layout.HUMAN_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={OverlayModels.HUMAN_BANNER}
        anim={OverlayAnims.BANNER}
        pitch={Layout.HUMAN_PITCH}
        yaw={Layout.HUMAN_YAW}
        zoom={Layout.HUMAN_ZOOM}
      />

      <rect x="center" y="center" w="fill" h="fill" fill color={OverlayColors.FADE} />
    </layer>
  );
}
