import { Layout, PosterAnims, PosterColors, PosterModels } from './pog-poster-03.constants';

export function PogPoster03(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <rect x="center" y="center" w="fill" h="fill" fill color={PosterColors.GROUND} />

      <model
        x="center"
        y={{ center: Layout.WALL_DY }}
        w={Layout.WALL_W}
        h={Layout.WALL_H}
        model={PosterModels.WALL}
        zoom={Layout.WALL_ZOOM}
        offsetY={Layout.WALL_OFFSET_Y}
      />

      <model
        x={{ center: Layout.BOLRIE_DX }}
        y={{ center: Layout.BOLRIE_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.BOLRIE_POSTER}
        anim={PosterAnims.BOLRIE_POSTER_RIP}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />

      <model
        x={{ center: Layout.ARG_DX }}
        y={{ center: Layout.ARG_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.ARG_POSTER}
        anim={PosterAnims.ARG_POSTER_STATIC}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />

      <model
        x={{ center: Layout.HAND_DX }}
        y={{ center: Layout.HAND_DY }}
        w={Layout.PROP}
        h={Layout.PROP}
        model={PosterModels.HAND}
        anim={PosterAnims.HAND_RIP}
        pitch={Layout.PROP_PITCH}
        zoom={Layout.PROP_ZOOM}
      />
    </layer>
  );
}
