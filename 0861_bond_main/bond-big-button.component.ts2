import { createRef, useInterval, useRef, useState } from 'ts2';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { Sounds } from '../lib/lib.constants';
import { clientClock, playSound, textWidth } from '../lib/lib.engine';
import { BondColors, BondFonts, Layout } from './bond-main.constants';

const timerHost = createRef('0861_bond_main_timer_host');

export function BondBigButton({ label }: { label: String }): Component {
  useInterval(() => {
    if (clientClock() < pressedUntil) {
      return;
    }
    setPressedUntil(0);
  }, timerHost);

  const labelRef = useRef();
  const [pressedUntil, setPressedUntil] = useState(0);

  const width: Int = textWidth(label, Layout.BIG_BUTTON_MEASURE, BondFonts.BIG_BUTTON) + Layout.BIG_BUTTON_PADDING;

  if (clientClock() < pressedUntil) {
    return (
      <layer w={width} h="fill" options={[label]} ref={timerHost}>
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          font={BondFonts.BIG_BUTTON}
          color={BondColors.BIG_BUTTON_LIT}
          shadow
          align="center"
          valign="middle"
          text={label}
        />
      </layer>
    );
  }

  return (
    <layer
      w={width}
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        labelRef.color = BondColors.BIG_BUTTON_LIT;
      }}
      onMouseLeave={() => {
        labelRef.color = BondColors.LABEL;
      }}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(Sounds.CLICK);
        setPressedUntil(clientClock() + Layout.BIG_BUTTON_PRESSED_CYCLES);
      }}
    >
      <ButtonBackground />
      <text
        ref={labelRef}
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={BondFonts.BIG_BUTTON}
        color={BondColors.LABEL}
        shadow
        align="center"
        valign="middle"
        text={label}
      />
    </layer>
  );
}
