import { groupDigits } from '../lib/lib.format';
import { MAX_INT } from './bond-main.constants';

export function bondTotal(tradeable: Int, untradeable: Int): Int {
  if (MAX_INT - tradeable < untradeable) {
    return MAX_INT;
  }
  return tradeable + untradeable;
}

export function bondSummary(total: Int): String {
  if (total > 1) {
    return `You have <col=ffffff>${groupDigits(total, ',')}</col> bonds in your <col=ffffff>inventory</col>, <col=ffffff>bank</col> & <col=ffffff>bond pouch</col>.<br>You can <col=ffffff>redeem</col> them below.`;
  }
  if (total === 1) {
    return 'You have <col=ffffff>one</col> bond in your <col=ffffff>inventory</col>, <col=ffffff>bank</col> & <col=ffffff>bond pouch</col>.<br>You can <col=ffffff>redeem</col> it below.';
  }
  return `You have <col=ffffff>${groupDigits(0, ',')}</col> bonds in your <col=ffffff>inventory</col>, <col=ffffff>bank</col> & <col=ffffff>bond pouch</col>. Visit the <col=ffffff>store</col> or buy bonds from <col=ffffff>other players</col>.`;
}
