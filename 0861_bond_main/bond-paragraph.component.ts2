import { textLineCount } from '../lib/lib.engine';
import { BondColors, BondFonts, PARA_LINE_HEIGHT, PARA_PADDING } from './bond-main.constants';

export function paragraphHeight(text: String, width: Int): Int {
  return textLineCount(text, width, BondFonts.BODY) * PARA_LINE_HEIGHT + PARA_PADDING;
}

export function BondParagraph({ text, width, top }: { text: String; width: Int; top: Int }): Component {
  return (
    <text
      x="center"
      y={top}
      w={width}
      h={paragraphHeight(text, width)}
      text={text}
      font={BondFonts.BODY}
      color={BondColors.LABEL}
      align="left"
      valign="top"
      lineHeight={PARA_LINE_HEIGHT}
      shadow
    />
  );
}
