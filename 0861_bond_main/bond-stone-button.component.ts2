import { CS2, useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { StoneButtonFlags } from '../0705_clans_creation_sidepanel/clans-creation-sidepanel.constants';
import { onMobile, opsound } from '../lib/lib.helpers';
import { BondFonts } from './bond-main.constants';

export function BondStoneButton({ label }: { label: String }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, 2)}
    >
      <StoneButtonDraw label={label} font={BondFonts.BUTTON} pressed={skin} flags={1} />
    </layer>
  );
}
