import { useServerState, useUniverse } from 'ts2';
import { IronmanType, isGroupIronman } from '../0551_raids_storage_side/raids-storage-side.helpers';
import { groupDigits } from '../lib/lib.format';
import { ConvertColors, ConvertFonts, ConvertVarbits, ConvertVarps, Layout, SEPARATOR } from './bond-convert.constants';

export function ConvertBlurb(): Component {
  const contents = useUniverse();
  const paneWidth: Int = contents.width - Layout.PANE_INSET;

  const cost: Int = useServerState(ConvertVarps.CONVERSION_COST);
  const ironman: Int = useServerState(ConvertVarbits.IRONMAN);

  const price: String = groupDigits(cost, SEPARATOR);

  let body: String = '';
  if (ironman !== IronmanType.NONE) {
    if (isGroupIronman(ironman)) {
      body = `For <col=ffffff>${price} coins</col>, you can convert <col=ffffff>untradeable bonds</col> into <col=ffffff>tradeable bonds</col>.<br><br>You can then trade them to other members of your group.`;
    } else {
      body = `For <col=ffffff>${price} coins</col>, you can convert <col=ffffff>untradeable bonds</col> into <col=ffffff>tradeable bonds</col>.<br><br>You can then <col=ffffff>use them on players</col> to give as free gifts.`;
    }
  } else {
    body = `For <col=ffffff>${price} coins</col>, you can convert <col=ffffff>untradeable bonds</col> into <col=ffffff>tradeable bonds</col>.<br><br>You can then sell them to other players, such as on the <col=ffffff>Grand Exchange</col>, or <col=ffffff>use them on players</col> to give as free gifts.<br><br>Coins may be paid from your <col=ffffff>inventory</col> or <col=ffffff>bank</col>.`;
  }

  return (
    <text
      x={0}
      y="center"
      w={{ fill: paneWidth + Layout.BLURB_GAP }}
      h="fill"
      text={body}
      font={ConvertFonts.LABEL}
      color={ConvertColors.LABEL}
      shadow
      align="left"
      valign="top"
      lineHeight={Layout.LINE_HEIGHT}
    />
  );
}
