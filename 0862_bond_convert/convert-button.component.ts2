import { useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile } from '../lib/lib.helpers';

export function ConvertStoneButton({ label, font }: { label: String; font: Font }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
    >
      <StoneButtonDraw label={label} font={font} pressed={skin} flags={1} />
    </layer>
  );
}
