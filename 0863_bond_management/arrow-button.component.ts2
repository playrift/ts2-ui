import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { ArrowDirection, Layout, ManagementSprites } from './bond-management.constants';

export function ArrowButton({
  direction,
  label,
  subject,
}: {
  direction: Int;
  label: String;
  subject: String;
}): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      optionSubject={subject}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => opsound(event.option, 2)}
    >
      {skin === 1 ? (
        <StoneButtonPressedFilled>
          <ArrowIcon
            sprite={
              direction === ArrowDirection.IN ? ManagementSprites.ARROW_IN_PRESSED : ManagementSprites.ARROW_OUT_PRESSED
            }
          />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonFilled>
          <ArrowIcon
            sprite={direction === ArrowDirection.IN ? ManagementSprites.ARROW_IN : ManagementSprites.ARROW_OUT}
          />
        </StoneButtonFilled>
      )}
    </layer>
  );
}

function ArrowIcon({ sprite }: { sprite: Sprite }): Component {
  return <sprite x="center" y="center" w={Layout.ARROW_ICON_W} h={Layout.ARROW_ICON_H} sprite={sprite} />;
}
