import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { BondBigButton } from '../0861_bond_main/bond-big-button.component';
import { ArrowButton } from './arrow-button.component';
import { BondSlots } from './bond-slots.component';
import { ConvertBox } from './convert-box.component';
import { QuantityButton } from './quantity-button.component';
import {
  ArrowDirection,
  BondKind,
  Copy,
  Layout,
  ManagementColors,
  ManagementFonts,
  ManagementSprites,
  Quantity,
} from './bond-management.constants';
import { PARA_LINE_HEIGHT } from '../0861_bond_main/bond-main.constants';

export function BondManagement(): Component {
  return (
    <>
      <SteelBorderEntrypoint title="Your Bonds" />

      <BondBigButton
        x={Layout.BIG_BUTTON_X}
        y={Layout.BIG_BUTTON_Y}
        w={Layout.BIG_BUTTON_W}
        h={Layout.BIG_BUTTON_H}
        label={Copy.BIG_BUTTON}
      />

      <layer
        x="center"
        y={{ bottom: Layout.BODY_BOTTOM }}
        w={{ fill: Layout.BODY_W_INSET }}
        h={{ fill: Layout.BODY_H_INSET }}
      >
        <layer x="center" y={0} w="fill" h={Layout.BLURB_H}>
          <sprite
            x="right"
            y="center"
            w={Layout.GRAPHIC_W}
            h={Layout.GRAPHIC_H}
            sprite={ManagementSprites.BOND_GRAPHIC}
          />
          <text
            x={0}
            y="center"
            w={{ fill: Layout.GRAPHIC_W }}
            h="fill"
            text={Copy.BLURB}
            font={ManagementFonts.BODY}
            color={ManagementColors.LABEL}
            align="left"
            valign="middle"
            lineHeight={PARA_LINE_HEIGHT}
            shadow
          />
        </layer>

        <layer x="center" y="bottom" w="fill" h={{ fill: Layout.LOWER_H_INSET }}>
          <layer x={0} y={0} w={{ fill: Layout.LEDGER_W_INSET }} h={Layout.LEDGER_H}>
            <sprite
              x="center"
              y="center"
              w={{ fill: 2 }}
              h={{ fill: 2 }}
              sprite={ManagementSprites.LEDGER_BACKING}
              tiling
            />

            <layer
              x="center"
              y={Layout.HEADER_TOP}
              w={{ fill: Layout.HEADER_W_INSET }}
              h={{ fill: Layout.HEADER_H_INSET }}
            >
              <sprite
                x={Layout.HEADER_POUCH_X}
                y="center"
                w={Layout.ICON_W}
                h={Layout.ICON_H}
                sprite={ManagementSprites.ICON_POUCH}
              />
              <sprite
                x={{ right: Layout.HEADER_INVENTORY_RIGHT }}
                y="center"
                w={Layout.ICON_W}
                h={Layout.ICON_H}
                sprite={ManagementSprites.ICON_INVENTORY}
              />
              <sprite
                x={{ right: Layout.HEADER_BANK_RIGHT }}
                y="center"
                w={Layout.ICON_W}
                h={Layout.ICON_H}
                sprite={ManagementSprites.ICON_BANK}
              />
            </layer>

            <layer x="center" y={{ bottom: Layout.TRADEABLE_BOTTOM }} w={{ fill: Layout.ROW_W_INSET }} h={Layout.ROW_H}>
              <rect
                x="center"
                y={0}
                w="fill"
                h="fill"
                fill
                color={ManagementColors.WASH}
                transparency={Layout.WASH_TRANSPARENCY}
                contentType={Layout.WASH_CONTENT_TYPE}
              />
              <ArrowButton
                x={Layout.ARROW_X}
                y={Layout.ARROW_INSET}
                w={{ fill: Layout.ARROW_W_INSET }}
                h={Layout.ARROW_H}
                direction={ArrowDirection.OUT}
                label={Copy.MOVE_TO_INVENTORY}
                subject={Copy.TRADEABLE_SUBJECT}
              />
              <ArrowButton
                x={Layout.ARROW_X}
                y={{ bottom: Layout.ARROW_INSET }}
                w={{ fill: Layout.ARROW_W_INSET }}
                h={Layout.ARROW_H}
                direction={ArrowDirection.IN}
                label={Copy.MOVE_TO_POUCH}
                subject={Copy.TRADEABLE_SUBJECT}
              />
              <text
                x={0}
                y="center"
                w={Layout.ROW_LABEL_W}
                h="fill"
                text={Copy.TRADEABLE_ROW}
