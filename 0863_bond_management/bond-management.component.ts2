                color={ManagementColors.LABEL}
                align="center"
                valign="middle"
                lineHeight={PARA_LINE_HEIGHT}
                shadow
              />
              <BondSlots x={0} y={0} w="fill" h="fill" kind={BondKind.TRADEABLE} />
            </layer>

            <layer
              x="center"
              y={{ bottom: Layout.UNTRADEABLE_BOTTOM }}
              w={{ fill: Layout.ROW_W_INSET }}
              h={Layout.ROW_H}
            >
              <ArrowButton
