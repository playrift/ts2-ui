                align="center"
                valign="middle"
                lineHeight={PARA_LINE_HEIGHT}
                shadow
              />
              <BondSlots x={0} y={0} w="fill" h="fill" kind={BondKind.UNTRADEABLE} />
            </layer>

            <ThinBoxEntrypoint />
          </layer>

          <layer x={0} y="bottom" w={{ fill: Layout.LEDGER_W_INSET }} h={{ fill: Layout.QUANTITY_H_INSET }}>
            <QuantityButton
              x={{ center: Layout.QUANTITY_DX_1 }}
              y="center"
              w={Layout.QUANTITY_W}
              h="fill"
              label="1"
              value={Quantity.ONE}
