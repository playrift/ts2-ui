            <QuantityButton
              x={{ center: Layout.QUANTITY_DX_5 }}
              y="center"
              w={Layout.QUANTITY_W}
              h="fill"
              label="5"
              value={Quantity.FIVE}
            />
            <QuantityButton
              x={{ center: Layout.QUANTITY_DX_X }}
              y="center"
              w={Layout.QUANTITY_W}
              h="fill"
              label="X"
              value={Quantity.X}
            />
            <QuantityButton
              x={{ center: Layout.QUANTITY_DX_ALL }}
