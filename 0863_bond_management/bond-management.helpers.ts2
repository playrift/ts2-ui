import { predictServerState } from 'ts2';
import { isGroupIronman } from '../0551_raids_storage_side/raids-storage-side.helpers';
import { Sounds } from '../lib/lib.constants';
import { playSound } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { ManagementVarbits, Quantity } from './bond-management.constants';

export function convertFeeText(fee: Int, ironman: Int): String {
  if (ironman !== 0 && !isGroupIronman(ironman)) {
    return `If you'd like to <col=ffffff>give away</col> an <col=ffffff>untradeable</col> bond, you can make it <col=ffffff>tradeable</col> for a fee of <col=ffffff>${groupDigits(fee, ',')}</col> coins:`;
  }
  return `If you'd like to <col=ffffff>sell</col> or <col=ffffff>give away</col> an <col=ffffff>untradeable</col> bond, you can make it <col=ffffff>tradeable</col> for a fee of <col=ffffff>${groupDigits(fee, ',')}</col> coins:`;
}

export function selectedQuantity(setting: Int): Int {
  if (setting === Quantity.FIVE) {
    return Quantity.FIVE;
  }
  if (setting === Quantity.X) {
    return Quantity.X;
  }
  if (setting === Quantity.ALL) {
    return Quantity.ALL;
  }
  return Quantity.ONE;
}

export function selectQuantity(option: Int, value: Int): void {
  if (option === 1) {
    playSound(Sounds.CLICK);
    predictServerState(ManagementVarbits.QUANTITY, value);
  }
}
