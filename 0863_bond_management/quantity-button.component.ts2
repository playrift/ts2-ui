import { CS2, useServerState, useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile } from '../lib/lib.helpers';
import { selectQuantity, selectedQuantity } from './bond-management.helpers';
import { ManagementFonts, ManagementVarbits } from './bond-management.constants';

export function QuantityButton({ label, value }: { label: String; value: Int }): Component {
  const setting: Int = useServerState(ManagementVarbits.QUANTITY);
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  if (selectedQuantity(setting) === value) {
    return (
      <layer w="fill" h="fill" options={[CS2.tags_remove(label)]}>
        <StoneButtonDraw label={`<col=ffffff>${label}</col>`} font={ManagementFonts.BODY} pressed={1} flags={1} />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => selectQuantity(event.option, value)}
    >
      <StoneButtonDraw label={label} font={ManagementFonts.BODY} pressed={skin} flags={1} />
    </layer>
  );
}
