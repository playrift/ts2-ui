import { ColosseumBoxStyles } from './colosseum-art.data';

export function ColosseumBoxFrame({ style, colour }: { style: Int; colour: Int }): Component {
  const skin = ColosseumBoxStyles.at(style);
  const fill: Sprite = skin === null ? -1 : skin.fill;
  const edgeTop: Sprite = skin === null ? -1 : skin.edgeTop;
  const edgeBottom: Sprite = skin === null ? -1 : skin.edgeBottom;
  const edgeLeft: Sprite = skin === null ? -1 : skin.edgeLeft;
  const edgeRight: Sprite = skin === null ? -1 : skin.edgeRight;
  const cornerTl: Sprite = skin === null ? -1 : skin.cornerTl;
  const cornerTr: Sprite = skin === null ? -1 : skin.cornerTr;
  const cornerBl: Sprite = skin === null ? -1 : skin.cornerBl;
  const cornerBr: Sprite = skin === null ? -1 : skin.cornerBr;
  const border: Int = skin === null ? 0 : skin.border;

  return (
    <>
      <rect x={1} y={1} w={{ fill: 2 }} h={{ fill: 2 }} fill color={colour} />
      <sprite x={4} y={4} w={{ fill: 8 }} h={{ fill: 8 }} sprite={fill} tiling />
      <sprite x={border} y={0} w={{ fill: border * 2 }} h={border} sprite={edgeTop} tiling />
      <sprite x={border} y="bottom" w={{ fill: border * 2 }} h={border} sprite={edgeBottom} tiling />
      <sprite x={0} y={border} w={border} h={{ fill: border * 2 }} sprite={edgeLeft} tiling />
      <sprite x="right" y={border} w={border} h={{ fill: border * 2 }} sprite={edgeRight} tiling />
      <sprite x={0} y={0} w={border} h={border} sprite={cornerTl} tiling />
      <sprite x="right" y={0} w={border} h={border} sprite={cornerTr} tiling />
      <sprite x={0} y="bottom" w={border} h={border} sprite={cornerBl} tiling />
      <sprite x="right" y="bottom" w={border} h={border} sprite={cornerBr} tiling />
    </>
  );
}

export enum BoxStyle {
  PLAIN = 0,
  HOVERED = 1,
  INSET = 2,
}
