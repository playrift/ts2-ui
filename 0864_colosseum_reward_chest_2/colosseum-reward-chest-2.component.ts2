import { useInventory, useRef, useState } from 'ts2';

import { colosseumRewardChest2Tab } from '../lib/game/varcs';
import { itemName } from '../lib/lib.engine';
import { groupDigits } from '../lib/lib.format';
import { onMobile } from '../lib/lib.helpers';
import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { ThinBoxOutline } from '../lib/thin-box.component';
import { BoxStyle, ColosseumBoxFrame } from './colosseum-box-frame.component';
import { ColosseumTab } from './colosseum-tab.component';
import {
  BACKDROP_TRANSPARENCY,
  ColosseumColor,
  ColosseumFonts,
  ColosseumInventories,
  ColosseumSprites,
} from './colosseum.constants';
import { chestHeldModifiers, chestLootValue, chestWave } from './colosseum-reward-chest-2.state';
import { ModifierStrip } from './modifier-strip.component';
import { WaveSummary } from './wave-summary.component';

export function ColosseumRewardChest2(): Component {
  return (
    <layer x="center" y="center" w={480} h={314}>
      <layer x="center" y="center" w={264} h="fill">
        <SteelBorder title="Fortis Colosseum" titleColor={SteelborderColor.TITLE} flags={0} />
      </layer>
      <layer x="center" y={{ bottom: 6 }} w={{ fill: 240 }} h={{ fill: 41 }}>
        <layer x="center" y={6} w={240} h={{ fill: 12 }}>
          <ChestBody />
        </layer>
        <layer x="center" y="center" w="fill" h="fill" hide>
          <rect x="center" y="center" w="fill" h="fill" fill transparency={100} />
          <layer x="center" y="center" w={300} h={175} />
          <layer x="center" y="center" w={276} h={151}>
            <layer x="right" y="bottom" w={135} h={30} options={['Confirm']} />
            <layer x={0} y="bottom" w={135} h={30} options={['Cancel']} />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}

function ChestBody(): Component {
  const [tab] = useState(colosseumRewardChest2Tab);
  const [wave] = useState(chestWave);
  const [held] = useState(chestHeldModifiers);

  return (
    <>
      <layer x="center" y="bottom" w="fill" h={{ fill: 28 }}>
        <ColosseumBoxFrame style={BoxStyle.PLAIN} colour={ColosseumColor.BED} />
      </layer>
      <layer x="center" y={0} w="fill" h={32}>
        <ColosseumTab
          index={0}
          width={118}
          gap={4}
          height={32}
          label="Loot"
          selected={tab === 0}
          last={false}
          strip={0}
        />
        <ColosseumTab index={1} width={118} gap={4} height={32} label="Summary" selected={tab === 1} last strip={0} />
      </layer>
      <layer x="center" y={{ bottom: 8 }} w={{ fill: 16 }} h={{ fill: 46 }} hide={tab !== 1}>
        <layer x="center" y="bottom" w="fill" h={60}>
          <ModifierStrip held={held} />
        </layer>
        <WaveSummary wave={wave} held={held} top={5} />
      </layer>
      <layer x="center" y={{ bottom: 8 }} w={{ fill: 16 }} h={{ fill: 46 }} hide={tab !== 0}>
        <LootPane />
      </layer>
    </>
  );
}

function LootPane(): Component {
  const [value] = useState(chestLootValue);
  const [discardDown, setDiscardDown] = useState(0);
  const [takeDown, setTakeDown] = useState(0);
  const [bankDown, setBankDown] = useState(0);
  const discard: Int = discardDown;
  const take: Int = takeDown;
  const bank: Int = bankDown;

  return (
    <>
      <layer
        x={0}
        y="bottom"
        w={71}
        h={30}
        options={['', '', '', '', '', 'Discard-all']}
        onMouseRepeat={() => {
          if (!onMobile()) {
            setDiscardDown(1);
          }
        }}
        onMouseLeave={() => setDiscardDown(0)}
      >
        <LootButtonFace pressed={discard} icon={ColosseumSprites.DISCARD_ICON} />
      </layer>
      <layer
        x="right"
        y="bottom"
        w={70}
        h={30}
        options={['Take-all']}
        onMouseRepeat={() => {
          if (!onMobile()) {
            setTakeDown(1);
          }
        }}
        onMouseLeave={() => setTakeDown(0)}
      >
        <LootButtonFace pressed={take} icon={ColosseumSprites.TAKE_ICON} />
      </layer>
      <layer
        x="center"
        y="bottom"
        w={71}
        h={30}
        options={['', '', '', '', '', 'Bank-all']}
        onMouseRepeat={() => {
          if (!onMobile()) {
            setBankDown(1);
          }
        }}
        onMouseLeave={() => setBankDown(0)}
      >
        <LootButtonFace pressed={bank} icon={ColosseumSprites.BANK_ICON} />
      </layer>
      <layer x={0} y={0} w="fill" h={{ fill: 36 }}>
        <rect
          x="center"
          y={0}
          w="fill"
          h="fill"
          fill
          color={ColosseumColor.BLACK}
          transparency={BACKDROP_TRANSPARENCY}
        />
        <ThinBoxOutline />
      </layer>
      <layer x={2} y={2} w={{ fill: 4 }} h={{ fill: 40 }}>
        <text
          x="center"
          y="bottom"
          w="fill"
          h={20}
          text={`${groupDigits(value, ',')} GP`}
          font={ColosseumFonts.BODY}
          color={ColosseumColor.WHITE}
          shadow
          align="center"
          valign="middle"
        />
        <LootGrid />
      </layer>
    </>
  );
}

function LootButtonFace({ pressed, icon }: { pressed: Int; icon: Sprite }): Component {
  return (
    <>
      {pressed === 1 ? <StoneButtonPressed /> : <StoneButton />}
      <sprite x="center" y="center" w={29} h={22} sprite={icon} tiling />
    </>
  );
}

function LootGrid(): Component {
  const loot = useInventory(ColosseumInventories.LOOT);
  const grid = useRef();
  const drawn: Int = lootCount();

  return (
    <layer ref={grid} x={0} y={0} w="fill" h="fill">
      {loot.scan(
        (item, slot, n) =>
          item !== -1 && (
            <sprite
              x={(n % 5) * 36 + ((n % 5) + 1) * ((grid.width - 180) / 6)}
              y={(n / 5) * 32 + (n / 5 + 1) * ((grid.width - 180) / 6)}
              w={36}
              h={32}
              item={item}
              itemCount={loot.count(slot)}
              outline={1}
              shadowColor={ColosseumColor.ITEM_SHADOW}
              options={['Take', 'Take-5', 'Take-All', 'Take-X', 'Examine']}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
            />
          ),
        (item) => (item !== -1 ? 1 : 0),
      )}
      {drawn === 0 ? (
        <text
          x="center"
          y={{ center: -20 }}
          w={{ fill: 40 }}
          h={{ fill: 40 }}
          text="You do not have any more loot."
          font={ColosseumFonts.BODY}
          color={ColosseumColor.ORANGE}
          shadow
          align="center"
          valign="middle"
        />
      ) : null}
    </layer>
  );
}

function lootCount(): Int {
  const loot = useInventory(ColosseumInventories.LOOT);
  let count: Int = 0;
  let slot: Int = 0;
  while (slot < loot.size) {
    if (loot[slot] !== -1) {
      count = count + 1;
    }
    slot = slot + 1;
  }
  return count;
}
