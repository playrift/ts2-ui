import { sessionState, useState } from 'ts2';

import { colosseumRewardChest2Tab } from '../lib/game/varcs';

export const chestWave = sessionState(0);
export const chestHeldModifiers = sessionState(0);
export const chestLootValue = sessionState(0);

export function colosseumRewardChest2Open(wave: Int, held: Int): void {
  const [, setWave] = useState(chestWave);
  const [, setHeld] = useState(chestHeldModifiers);
  const [, setTab] = useState(colosseumRewardChest2Tab);
  setWave(wave);
  setHeld(held);
  setTab(0);
}

export function colosseumRewardChest2SetValue(value: Int): void {
  const [, setValue] = useState(chestLootValue);
  setValue(value);
}
