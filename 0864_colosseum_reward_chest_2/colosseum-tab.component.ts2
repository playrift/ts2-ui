import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { ColosseumBoxStyles } from './colosseum-art.data';
import { BoxStyle } from './colosseum-box-frame.component';
import { ColosseumColor, ColosseumFonts } from './colosseum.constants';
import { pickColosseumTab } from './colosseum.state';

export function ColosseumTab({
  index,
  width,
  gap,
  height,
  label,
  selected,
  last,
  strip,
}: {
  index: Int;
  width: Int;
  gap: Int;
  height: Int;
  label: String;
  selected: Boolean;
  last: Boolean;
  strip: Int;
}): Component {
  const [hovered, setHovered] = useState(0);

  const left: Int = index * (width + gap);
  const state: Int = selected ? BoxStyle.PLAIN : hovered === 1 ? BoxStyle.HOVERED : BoxStyle.INSET;
  const skin = ColosseumBoxStyles.at(state);
  const fill: Sprite = skin === null ? -1 : skin.fill;
  const edgeLeft: Sprite = skin === null ? -1 : skin.edgeLeft;
  const edgeTop: Sprite = skin === null ? -1 : skin.edgeTop;
  const edgeRight: Sprite = skin === null ? -1 : skin.edgeRight;
  const cornerTl: Sprite = skin === null ? -1 : skin.cornerTl;
  const cornerTr: Sprite = skin === null ? -1 : skin.cornerTr;
  const side: Int = selected ? 4 : 7;
  const leftSide: Int = left === 0 && selected ? 4 : 7;
  const rightSide: Int = last && selected ? 4 : 7;

  return (
    <>
      {selected ? (
        <rect
          x={left + 1}
          y={1}
          w={width - 2}
          h={{ fill: 3 }}
          fill
          color={ColosseumColor.BED}
          onClick={() => pickColosseumTab(strip, index)}
        />
      ) : (
        <rect
          x={left + 1}
          y={1}
          w={width - 2}
          h={{ fill: 3 }}
          fill
          color={ColosseumColor.BED}
          options={['View']}
          optionSubject={`<col=ff9040>${label}</col>`}
          onClick={() => pickColosseumTab(strip, index)}
          onMouseEnter={() => {
            if (!onMobile()) {
              setHovered(1);
            }
          }}
          onMouseLeave={() => {
            if (!onMobile()) {
              setHovered(0);
            }
          }}
        />
      )}

      <sprite x={left + 2} y={4} w={width - 4} h={{ fill: side }} sprite={fill} tiling />
      <sprite x={left} y={4} w={4} h={{ fill: leftSide }} sprite={edgeLeft} tiling />
      <sprite x={left + 4} y={0} w={width - 8} h={4} sprite={edgeTop} tiling />
      <sprite x={left + width - 4} y={4} w={4} h={{ fill: rightSide }} sprite={edgeRight} tiling />
      <sprite x={left} y={0} w={4} h={4} sprite={cornerTl} tiling />
      <sprite x={left + width - 4} y={0} w={4} h={4} sprite={cornerTr} tiling />
      <sprite x={left + 4} y={(height + 1) / 2} w={0} h={0} sprite={-1} tiling />
      <text
        x={left + 8}
        y={4}
        w={width - 16}
        h={{ fill: 7 }}
        text={label}
        font={ColosseumFonts.BODY}
        color={ColosseumColor.ORANGE}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
