import { sessionState, useState } from 'ts2';

import { colosseumIntermission2Tab, colosseumRewardChest2Tab } from '../lib/game/varcs';

export const intermissionPreview = sessionState(0);

export function pickColosseumTab(strip: Int, index: Int): void {
  const [, setChestTab] = useState(colosseumRewardChest2Tab);
  const [, setIntermissionTab] = useState(colosseumIntermission2Tab);
  const [, setPreview] = useState(intermissionPreview);
  if (strip === 0) {
    setChestTab(index);
  } else {
    setIntermissionTab(index);
    setPreview(0);
  }
}
