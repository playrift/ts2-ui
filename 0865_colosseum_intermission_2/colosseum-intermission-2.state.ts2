import { createRef, sessionState, useState } from 'ts2';

import { groupDigits } from '../lib/lib.format';

import { intermissionPreview } from '../0864_colosseum_reward_chest_2/colosseum.state';
import { colosseumIntermission2Tab } from '../lib/game/varcs';

export const intermissionWave = sessionState(0);
export const intermissionChoice1 = sessionState(0);
export const intermissionChoice2 = sessionState(0);
export const intermissionChoice3 = sessionState(0);
export const LAST_VALUE = createRef();
export const NEXT_VALUE = createRef();
export const CONFIRM_BOX = createRef();
export const intermissionTotalValue = sessionState(0);
export const intermissionHeld = sessionState(0);
export const intermissionConfirming = sessionState(0);

export function colosseumIntermission2Open(
  wave: Int,
  choice1: Int,
  choice2: Int,
  choice3: Int,
  lastValue: Int,
  nextValue: Int,
  totalValue: Int,
  held: Int,
): void {
  const [, setWave] = useState(intermissionWave);
  const [, setChoice1] = useState(intermissionChoice1);
  const [, setChoice2] = useState(intermissionChoice2);
  const [, setChoice3] = useState(intermissionChoice3);
  const [, setTotal] = useState(intermissionTotalValue);
  const [, setHeld] = useState(intermissionHeld);
  const [, setConfirming] = useState(intermissionConfirming);
  const [, setTab] = useState(colosseumIntermission2Tab);
  const [, setPreview] = useState(intermissionPreview);
  setWave(wave);
  setChoice1(choice1);
  setChoice2(choice2);
  setChoice3(choice3);
  LAST_VALUE.text = `${groupDigits(lastValue, ',')} GP`;
  NEXT_VALUE.text = `${groupDigits(nextValue, ',')} GP`;
  setTotal(totalValue);
  setHeld(held);
  setConfirming(0);
  CONFIRM_BOX.hide = true;
  setTab(0);
  setPreview(0);
}

export function openClaimConfirm(): void {
  const [, setConfirming] = useState(intermissionConfirming);
  setConfirming(1);
  CONFIRM_BOX.hide = false;
}

export function closeClaimConfirm(): void {
  const [, setConfirming] = useState(intermissionConfirming);
  setConfirming(0);
  CONFIRM_BOX.hide = true;
}
