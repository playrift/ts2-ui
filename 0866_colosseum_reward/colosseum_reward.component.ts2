import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { NextWaveSlots, RewardColor, RewardFont, RewardModel, RewardPlate } from './colosseum_reward.constants';

export function ColosseumReward(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <SteelBorderEntrypoint title="Wave Complete!" />

      <layer x={0} y={40} w={{ fill: 4 }} h="fill">
        <layer x={2} y={5} w={{ fill: 302 }} h="fill">
          <model x={15} y={19} w={32} h={32} model={RewardModel.LOOT_ICON} zoom={4500} pitch={171} yaw={1824} />
          <text
            x={55}
            y={15}
            w={{ fill: 70 }}
            h={32}
            text="Loot earned so far"
            font={RewardFont.HEADING}
            color={RewardColor.HEADING}
            shadow
            align="center"
            valign="middle"
          />

          <layer x="center" y={45} w={192} h={{ fill: 140 }}>
            <layer x="center" y={16} w="fill" h={{ fill: 67 }}>
              <ThinBoxEntrypoint />
            </layer>
            <rect
              x="center"
              y={16}
              w={{ fill: 2 }}
              h={{ fill: 69 }}
              fill
              color={RewardColor.PLATE}
              transparency={RewardPlate.TRANSPARENCY}
            />
            <layer x="center" y={16} w={{ fill: 4 }} h={{ fill: 71 }} />

            <layer x="center" y={{ bottom: 8 }} w="fill" h={35}>
              <text
                x="center"
                y="center"
                w={{ fill: 4 }}
                h={{ fill: 4 }}
                text="Estimated Value:<br> 100 coins"
                font={RewardFont.HEADING}
                color={RewardColor.HEADING}
                shadow
                align="center"
                valign="middle"
                lineHeight={15}
              />
            </layer>
          </layer>

          <layer x="center" y={240} w={150} h={40} options={['*']} />
        </layer>

        <layer x="right" y={0} w={{ fill: 212 }} h="fill">
          <text
            x={2}
            y={15}
            w={{ fill: 176 }}
            h={32}
            text="Loot next wave..."
            font={RewardFont.HEADING}
            color={RewardColor.HEADING}
            shadow
            align="center"
            valign="middle"
          />

          <layer x={{ right: 4 }} y={8} w={171} h={45}>
            <ThinBoxEntrypoint />
            <rect
              x="center"
              y={0}
              w={{ fill: 2 }}
              h={{ fill: 2 }}
              fill
              color={RewardColor.PLATE}
              transparency={RewardPlate.TRANSPARENCY}
            />
            <layer x={2} y={0} w={{ fill: 4 }} h={{ fill: 4 }} />
          </layer>

          {NextWaveSlots.map((top) => (
            <layer x={0} y={top} w={{ fill: 4 }} h={70}>
              <layer x={2} y={2} w={220} h={{ fill: 4 }}>
                <rect
                  x={0}
                  y={0}
                  w="fill"
                  h="fill"
                  fill
                  color={RewardColor.PLATE}
                  transparency={RewardPlate.TRANSPARENCY}
                />
                <text
                  x="center"
                  y="center"
                  w={{ fill: 6 }}
                  h={{ fill: 6 }}
                  font={RewardFont.SLOT}
                  color={RewardColor.PLATE}
                  shadow
                  lineHeight={15}
                />
                <ThinBoxEntrypoint />
              </layer>
              <layer x={{ right: 5 }} y="center" w={60} h={40} options={['*']} />
            </layer>
          ))}
        </layer>
      </layer>
    </layer>
  );
}
