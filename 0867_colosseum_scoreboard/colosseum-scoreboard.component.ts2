import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { GloryPanel } from './glory-panel.component';
import {
  Camera,
  ColosseumArt,
  ColosseumColor,
  ColosseumFonts,
  ColosseumModel,
  GlobalRows,
  Layout,
  PersonalRows,
  TITLE,
} from './colosseum-scoreboard.constants';

export function ColosseumScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={ColosseumModel.BACKDROP}
        zoom={Camera.ZOOM}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={ColosseumArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, ColosseumArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, ColosseumArt.CLOSE);
          }}
        />
      </layer>

      <GloryPanel />

      <layer x={{ center: Layout.PANEL_X_OFFSET }} y="center" w={Layout.PANEL_W} h={Layout.STATS_PANEL_H}>
        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_W_INSET }} h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ColosseumFonts.HEADING}
            color={ColosseumColor.GOLD}
            align="center"
            shadow
            text={TITLE}
          />
        </layer>

        <layer
          x="center"
          y={{ bottom: Layout.BODY_BAND_BOTTOM }}
          w={{ fill: Layout.BODY_BAND_W_INSET }}
          h={Layout.BODY_BAND_H}
        >
          {PersonalRows.map((row) => (
            <text
              x={Layout.COL_LEFT}
              y={row.y}
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              font={row.heading ? ColosseumFonts.HEADING : ColosseumFonts.VALUE}
              color={ColosseumColor.GOLD}
              align="center"
              shadow
              text={row.text}
            />
          ))}

          {GlobalRows.map((row) => (
            <text
              x={Layout.COL_RIGHT}
              y={row.y}
              w={Layout.LABEL_W}
              h={Layout.LABEL_H}
              font={row.heading ? ColosseumFonts.HEADING : ColosseumFonts.VALUE}
              color={ColosseumColor.GOLD}
              align="center"
              shadow
              text={row.text}
            />
          ))}
        </layer>
      </layer>
    </>
  );
}
