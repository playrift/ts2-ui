import { ColosseumColor, ColosseumFonts, Glory, GloryText, Layout } from './colosseum-scoreboard.constants';

export function GloryPanel(): Component {
  return (
    <layer x={{ center: Layout.PANEL_X_OFFSET }} y="center" w={Layout.PANEL_W} h={Layout.GLORY_PANEL_H} hide>
      <layer
        x={{ center: Glory.HEADER_LAYER_X_OFFSET }}
        y={Glory.HEADER_LAYER_Y}
        w={{ fill: Glory.HEADER_LAYER_W_INSET }}
        h={Glory.HEADER_LAYER_H}
      >
        <text
          x={{ center: Glory.HEADER_X_OFFSET }}
          y={{ center: Glory.HEADER_Y_OFFSET }}
          w="fill"
          h={{ fill: Glory.HEADER_H_INSET }}
          font={ColosseumFonts.GLORY_HEADER}
          color={ColosseumColor.GOLD}
          align="center"
          valign="middle"
          shadow
          text={GloryText.HEADER}
        />
        <line
          x="center"
          y={{ bottom: Glory.HEADER_RULE_BOTTOM }}
          w={Glory.RULE_W}
          h={0}
          color={ColosseumColor.RULE}
          lineWidth={1}
        />
      </layer>

      <layer x={Glory.STATS_X} y={Glory.STATS_Y} w={{ fill: Glory.STATS_W_INSET }} h={Glory.STATS_H}>
        <layer w={Glory.PROGRESS_W} h={Glory.PROGRESS_H}>
          <rect
            x={Glory.BAR_X}
            y={Glory.BAR_Y}
            w={Glory.BAR_W}
            h={Glory.BAR_H}
            fill
            color={ColosseumColor.BAR_BACK}
            hide
          />
          <rect x={Glory.BAR_X} y={Glory.BAR_Y} w={Glory.BAR_W} h={Glory.BAR_H} color={ColosseumColor.BAR_EDGE} hide />
          <rect
            x={Glory.BAR_FILL_X}
            y={Glory.BAR_FILL_Y}
            w={Glory.BAR_FILL_W}
            h={Glory.BAR_FILL_H}
            fill
            color={ColosseumColor.BAR_FILL}
            hide
          />
          <text
            x={Glory.BAR_TEXT_X}
            y={Glory.BAR_TEXT_Y}
            w={Glory.BAR_TEXT_W}
            h={Glory.BAR_TEXT_H}
            font={ColosseumFonts.VALUE}
            color={ColosseumColor.PALE}
            align="center"
            valign="middle"
            shadow
            text={GloryText.BAR}
            hide
          />
        </layer>

        <text
          x={{ center: Glory.STATUS_LABEL_X_OFFSET }}
          y={Glory.ROW_1_Y}
          w={Glory.STATUS_LABEL_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.PALE}
          valign="middle"
          shadow
          text={GloryText.STATUS_LABEL}
        />
        <text
          x={{ center: Glory.STATUS_VALUE_X_OFFSET }}
          y={Glory.ROW_1_Y}
          w={Glory.VALUE_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.GOLD}
          align="right"
          valign="middle"
          shadow
          text={GloryText.STATUS_VALUE}
        />

        <text
          x={{ center: Glory.GLORY_LABEL_X_OFFSET }}
          y={Glory.ROW_2_Y}
          w={Glory.GLORY_LABEL_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.PALE}
          valign="middle"
          shadow
          text={GloryText.GLORY_LABEL}
        />
        <text
          x={{ center: Glory.VALUE_X_OFFSET }}
          y={Glory.ROW_2_Y}
          w={Glory.VALUE_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.GOLD}
          align="right"
          valign="middle"
          shadow
          text={GloryText.GLORY_VALUE}
        />

        <text
          x={{ center: Glory.BEST_LABEL_X_OFFSET }}
          y={Glory.ROW_3_Y}
          w={Glory.BEST_LABEL_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.PALE}
          valign="middle"
          shadow
          text={GloryText.BEST_LABEL}
        />
        <text
          x={{ center: Glory.VALUE_X_OFFSET }}
          y={Glory.ROW_3_Y}
          w={Glory.VALUE_W}
          h={Glory.ROW_H}
          font={ColosseumFonts.GLORY_ROW}
          color={ColosseumColor.GOLD}
          align="right"
          valign="middle"
          shadow
          text={GloryText.BEST_VALUE}
        />
      </layer>

      <layer x={Glory.REWARDS_X} y={Glory.REWARDS_Y} w={Glory.REWARDS_W} h={Glory.REWARDS_H}>
        <text
          x={{ center: Glory.BENEFIT_1_X_OFFSET }}
          y={{ center: Glory.BENEFIT_1_Y_OFFSET }}
          w={{ fill: Glory.BENEFIT_1_W_INSET }}
          h={{ fill: Glory.BENEFIT_H_INSET }}
          font={ColosseumFonts.BENEFIT}
          color={ColosseumColor.BODY}
          lineHeight={Glory.BENEFIT_LINE_HEIGHT}
          text={GloryText.BENEFITS_1}
        />
        <text
          x={{ center: Glory.BENEFIT_2_X_OFFSET }}
          y={{ center: Glory.BENEFIT_2_Y_OFFSET }}
          w={{ fill: Glory.BENEFIT_2_W_INSET }}
          h={{ fill: Glory.BENEFIT_H_INSET }}
          font={ColosseumFonts.BENEFIT}
          color={ColosseumColor.BODY}
          lineHeight={Glory.BENEFIT_LINE_HEIGHT}
          text={GloryText.BENEFITS_2}
        />
        <text
          x="center"
          y={{ center: Glory.REWARDS_TITLE_Y_OFFSET }}
          w={Glory.REWARDS_TITLE_W}
          h={Glory.REWARDS_TITLE_H}
          font={ColosseumFonts.REWARDS_TITLE}
          color={ColosseumColor.PALE}
          align="center"
          valign="middle"
          shadow
          text={GloryText.REWARDS_TITLE}
        />
        <line x="center" y={Glory.REWARDS_RULE_Y} w={Glory.RULE_W} h={0} color={ColosseumColor.RULE} lineWidth={1} />
      </layer>
    </layer>
  );
}
