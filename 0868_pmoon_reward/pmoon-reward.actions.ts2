import { createRef } from 'ts2';

export const confirmation = createRef('pmoon_reward_confirmation');
export const noclick = createRef('pmoon_reward_noclick');

export function showDiscardPrompt(): void {
  confirmation.hide = false;
  noclick.hide = false;
}

export function hideDiscardPrompt(): void {
  confirmation.hide = true;
  noclick.hide = true;
}

export function promptDiscardAll(option: Int): void {
  if (option !== 1) return;
  showDiscardPrompt();
}

export function cancelDiscardAll(option: Int): void {
  if (option !== 1) return;
  hideDiscardPrompt();
}
