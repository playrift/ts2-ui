export function showDiscardPrompt(prompt: Ref, blocker: Ref): void {
  prompt.hide = false;
  blocker.hide = false;
}

export function hideDiscardPrompt(prompt: Ref, blocker: Ref): void {
  prompt.hide = true;
  blocker.hide = true;
}

export function promptDiscardAll(option: Int, prompt: Ref, blocker: Ref): void {
  if (option !== 1) return;
  showDiscardPrompt(prompt, blocker);
}

export function cancelDiscardAll(option: Int, prompt: Ref, blocker: Ref): void {
  if (option !== 1) return;
  hideDiscardPrompt(prompt, blocker);
}
