import { useRef } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { setTransparency } from '../lib/lib.components';
import { cancelDiscardAll, promptDiscardAll } from './pmoon-reward.actions';
import { Layout, PlateFade, PmoonArt, PmoonColor, PmoonFont, Scrim } from './pmoon-reward.constants';

export function PmoonReward(): Component {
  const prompt = useRef();
  const blocker = useRef();

  return (
    <>
      <SteelBorderEntrypoint title="Lunar Chest" />

      <layer y="bottom" w="fill" h={{ fill: Layout.CONTENT_INSET }}>
        <layer x="center" y={Layout.BUTTONS_Y} w={{ fill: Layout.BUTTONS_W_INSET }} h={Layout.BUTTONS_H}>
          <layer x="right" y={0} w={Layout.BUTTON} h={Layout.BUTTON} options={['Take-all']}>
            <sprite
              w={Layout.BUTTON}
              h={Layout.BUTTON}
              sprite={PmoonArt.BUTTON_PLATE}
              onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
            />
            <sprite x="center" y="center" w={Layout.ICON_W} h={Layout.ICON_H} sprite={PmoonArt.INVENTORY_ICON} />
          </layer>

          <layer x={{ right: Layout.BANK_RIGHT }} y={0} w={Layout.BUTTON} h={Layout.BUTTON} options={['Bank-all']}>
            <sprite
              w={Layout.BUTTON}
              h={Layout.BUTTON}
              sprite={PmoonArt.BUTTON_PLATE}
              onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
            />
            <sprite x="center" y="center" w={Layout.ICON_W} h={Layout.ICON_H} sprite={PmoonArt.BANK_ICON} />
          </layer>

          <layer
            x={0}
            y={0}
            w={Layout.BUTTON}
            h={Layout.BUTTON}
            options={['Discard-all']}
            onOptionSelect={(event) => promptDiscardAll(event.option, prompt, blocker)}
          >
            <sprite
              w={Layout.BUTTON}
              h={Layout.BUTTON}
              sprite={PmoonArt.BUTTON_PLATE}
              onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
              onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
            />
            <sprite x="center" y="center" w={Layout.ICON_W} h={Layout.ICON_H} sprite={PmoonArt.DISCARD_ICON} />
          </layer>
        </layer>

        <layer
          x={{ center: Layout.ITEMS_DX }}
          y={Layout.ITEMS_Y}
          w={{ fill: Layout.ITEMS_W_INSET }}
          h={{ fill: Layout.ITEMS_H_INSET }}
        />
      </layer>

      <layer ref={blocker} w="fill" h="fill" hide noClickThrough />

      <layer ref={prompt} x="center" y="center" w="fill" h="fill" hide>
        <rect x="center" y="center" w="fill" h="fill" fill color={PmoonColor.SCRIM} transparency={Scrim.TRANSPARENCY} />

        <text
          x="center"
          y={Layout.HEADING_Y}
          w={Layout.HEADING_W}
          h={Layout.HEADING_H}
          text="Discard all items?"
          font={PmoonFont.HEADING}
          color={PmoonColor.TEXT}
          shadow
          align="center"
          valign="middle"
        />

        <text
          x="center"
          y={{ center: Layout.BODY_UP }}
          w={{ fill: Layout.BODY_W_INSET }}
          h={Layout.BODY_H}
          text="All items will be destroyed for good."
          font={PmoonFont.BODY}
          color={PmoonColor.TEXT}
          shadow
          align="center"
        />

        <layer x="center" y={{ bottom: Layout.PROMPT_BOX_UP }} w={Layout.PROMPT_BOX_W} h={Layout.PROMPT_BOX_H}>
          <layer x="center" y={Layout.YES_Y} w={Layout.PROMPT_BUTTON_W} h={Layout.PROMPT_BUTTON_H} options={['Yes']}>
            <layer w="fill" h="fill">
              <sprite
                w="fill"
                h="fill"
                sprite={PmoonArt.BUTTON_BACKING}
                onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
                onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
              />
              <StoneButtonEntrypoint />
            </layer>
            <text
              x="center"
              y="center"
              w={Layout.CAPTION_W}
              h={Layout.CAPTION_H}
              text="Yes"
              font={PmoonFont.BUTTON}
              color={PmoonColor.TEXT}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer
            x="center"
            y={Layout.NO_Y}
            w={Layout.PROMPT_BUTTON_W}
            h={Layout.PROMPT_BUTTON_H}
            options={['No']}
            onOptionSelect={(event) => cancelDiscardAll(event.option, prompt, blocker)}
          >
            <layer w="fill" h="fill">
              <sprite
                w="fill"
                h="fill"
                sprite={PmoonArt.BUTTON_BACKING}
                onMouseEnter={(event) => setTransparency(event.component, PlateFade.HOVER)}
                onMouseLeave={(event) => setTransparency(event.component, PlateFade.CLEAR)}
              />
              <StoneButtonEntrypoint />
            </layer>
            <text
              x="center"
              y="center"
              w={Layout.CAPTION_W}
              h={Layout.CAPTION_H}
              text="No"
              font={PmoonFont.BUTTON}
              color={PmoonColor.TEXT}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </>
  );
}
