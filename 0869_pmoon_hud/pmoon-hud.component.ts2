import { createRef } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { LABEL, Layout, PmoonHud, PmoonHudFonts, PmoonHudSprites } from './pmoon-hud.constants';
import { pmoonHudTick } from './pmoon-hud.helpers';

const content = createRef('pmoon_hud_content1');

const blueCheck = createRef('pmoon_hud_blue_check');

const bloodCheck = createRef('pmoon_hud_blood_check');

const eclipseCheck = createRef('pmoon_hud_eclipse_check');

export function PmoonHud_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        x={0}
        y={0}
        w="fill"
        h="fill"
        onTimer={(event) =>
          overlayRelayout(event.component, content, PmoonHud.DODGE, Anchor.RIGHT, Anchor.BOTTOM, PmoonHud.SIDEWAYS)
        }
      >
        <layer
          ref={content}
          x={{ right: Layout.PLATE_RIGHT }}
          y={{ bottom: Layout.PLATE_BOTTOM }}
          w={Layout.PLATE_W}
          h={Layout.PLATE_H}
          onTimer={() => pmoonHudTick(blueCheck, bloodCheck, eclipseCheck)}
        >
          <sprite
            ref={blueCheck}
            x={Layout.CHECK_X}
            y={{ bottom: Layout.BLUE_CHECK_BOTTOM }}
            w={Layout.CHECK_W}
            h={Layout.CHECK_H}
            sprite={PmoonHudSprites.TICK}
          />

          <sprite
            ref={bloodCheck}
            x={Layout.CHECK_X}
            y={{ bottom: Layout.BLOOD_CHECK_BOTTOM }}
            w={Layout.CHECK_W}
            h={Layout.CHECK_H}
            sprite={PmoonHudSprites.TICK}
          />

          <sprite
            ref={eclipseCheck}
            x={Layout.CHECK_X}
            y={{ bottom: Layout.ECLIPSE_CHECK_BOTTOM }}
            w={Layout.CHECK_W}
            h={Layout.CHECK_H}
            sprite={PmoonHudSprites.TICK}
          />

          <text
            x={Layout.LABEL_X}
            y={{ bottom: Layout.BLUE_LABEL_BOTTOM }}
            w={{ fill: Layout.LABEL_FILL }}
            h={Layout.LABEL_H}
            font={PmoonHudFonts.LABEL}
            text="Blue Moon"
            valign="middle"
            shadow
            color={LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={{ bottom: Layout.BLOOD_LABEL_BOTTOM }}
            w={{ fill: Layout.LABEL_FILL }}
            h={Layout.LABEL_H}
            font={PmoonHudFonts.LABEL}
            text="Blood Moon"
            valign="middle"
            shadow
            color={LABEL}
          />

          <text
            x={Layout.LABEL_X}
            y={{ bottom: Layout.ECLIPSE_LABEL_BOTTOM }}
            w={{ fill: Layout.LABEL_FILL }}
            h={Layout.LABEL_H}
            font={PmoonHudFonts.LABEL}
            text="Eclipse Moon"
            valign="middle"
            shadow
            color={LABEL}
          />
        </layer>
      </layer>
    </layer>
  );
}
