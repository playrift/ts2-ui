import { useServerState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { PmoonHudVarbits, TICK_PERIOD } from './pmoon-hud.constants';

export function pmoonHudChecks(blue: ComponentId, blood: ComponentId, eclipse: ComponentId): void {
  if (useServerState(PmoonHudVarbits.BLUE_DEAD) === 1) {
    blue.hide = false;
  } else {
    blue.hide = true;
  }
  if (useServerState(PmoonHudVarbits.BLOOD_DEAD) === 1) {
    blood.hide = false;
  } else {
    blood.hide = true;
  }
  if (useServerState(PmoonHudVarbits.ECLIPSE_DEAD) === 1) {
    eclipse.hide = false;
  } else {
    eclipse.hide = true;
  }
}

export function pmoonHudTick(blue: ComponentId, blood: ComponentId, eclipse: ComponentId): void {
  if (clientClock() % TICK_PERIOD !== 0) {
    return;
  }
  pmoonHudChecks(blue, blood, eclipse);
}
