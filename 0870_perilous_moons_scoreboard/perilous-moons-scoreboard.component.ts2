import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';

import {
  MoonsArt,
  MoonsBackdrop,
  MoonsColor,
  MoonsFonts,
  MoonsLayout,
  VALUE_PLACEHOLDER,
} from './perilous-moons-scoreboard.constants';

export function PerilousMoonsScoreboard(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <model
        x={MoonsBackdrop.X}
        y={MoonsBackdrop.Y}
        w={MoonsBackdrop.W}
        h={MoonsBackdrop.H}
        model={MoonsBackdrop.MODEL}
        zoom={MoonsBackdrop.ZOOM}
      />

      <layer
        x={MoonsLayout.CLOSE_BOX_X}
        y={MoonsLayout.CLOSE_BOX_Y}
        w={MoonsLayout.CLOSE_BOX_W}
        h={MoonsLayout.CLOSE_BOX_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={MoonsLayout.CLOSE_ICON_X}
          y={MoonsLayout.CLOSE_ICON_Y}
          w={MoonsLayout.CLOSE_ICON_W}
          h={MoonsLayout.CLOSE_ICON_H}
          sprite={MoonsArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, MoonsArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, MoonsArt.CLOSE);
          }}
        />
      </layer>

      <layer x={{ center: MoonsLayout.CONTENT_DX }} y="center" w={MoonsLayout.CONTENT_W} h={MoonsLayout.CONTENT_H}>
        <layer
          x="center"
          y={MoonsLayout.TITLE_BAND_Y}
          w={{ fill: MoonsLayout.TITLE_BAND_INSET }}
          h={MoonsLayout.TITLE_BAND_H}
        >
          <text
            x="center"
            y="center"
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.LABEL}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text="Perilous Moons Statistics"
          />
        </layer>

        <layer
          x="center"
          y={MoonsLayout.STATS_BAND_Y}
          w={{ fill: MoonsLayout.TITLE_BAND_INSET }}
          h={MoonsLayout.STATS_BAND_H}
        >
          <text
            x={MoonsLayout.COL_LEFT_X}
            y={MoonsLayout.ROW_TOP_LABEL_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.LABEL}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text="Personal Chest Count"
          />
          <text
            x={MoonsLayout.COL_LEFT_X}
            y={MoonsLayout.ROW_TOP_VALUE_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.VALUE}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={MoonsLayout.COL_LEFT_X}
            y={MoonsLayout.ROW_BOTTOM_LABEL_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.LABEL}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text="Personal Deaths"
          />
          <text
            x={MoonsLayout.COL_LEFT_X}
            y={MoonsLayout.ROW_BOTTOM_VALUE_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.VALUE}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={MoonsLayout.COL_RIGHT_X}
            y={MoonsLayout.ROW_TOP_LABEL_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.LABEL}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text="Global Chest Count"
          />
          <text
            x={MoonsLayout.COL_RIGHT_X}
            y={MoonsLayout.ROW_TOP_VALUE_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.VALUE}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={MoonsLayout.COL_RIGHT_X}
            y={MoonsLayout.ROW_BOTTOM_LABEL_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.LABEL}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text="Global Deaths"
          />
          <text
            x={MoonsLayout.COL_RIGHT_X}
            y={MoonsLayout.ROW_BOTTOM_VALUE_Y}
            w={MoonsLayout.TEXT_W}
            h={MoonsLayout.TEXT_H}
            font={MoonsFonts.VALUE}
            color={MoonsColor.TEXT}
            shadow
            align="center"
            text={VALUE_PLACEHOLDER}
          />
        </layer>
      </layer>
    </layer>
  );
}
