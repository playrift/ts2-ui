import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { IconButton } from './icon-button.component';
import { QuantityButton } from './quantity-button.component';
import { HuntsmansKitPane } from './huntsmans-kit-pane.component';
import { Body, Button, Column, Decor, Quantity, TITLE, KitArt } from './huntsmans-kit.constants';

export function HuntsmansKit(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={TITLE} />

      <layer x="center" y={{ bottom: Body.BOTTOM }} w={{ fill: Body.W_INSET }} h={{ fill: Body.H_INSET }}>
        <model
          x={Decor.X}
          y={Decor.Y}
          w={Decor.W}
          h={Decor.H}
          model={Decor.MODEL}
          zoom={Decor.ZOOM}
          pitch={Decor.PITCH}
          yaw={Decor.YAW}
          roll={Decor.ROLL}
        />

        <layer x={Button.QTY_1_X} y="bottom" w={Button.SIZE} h={Button.SIZE}>
          <QuantityButton label="1" quantity={Quantity.ONE} />
        </layer>
        <layer x={Button.QTY_5_X} y="bottom" w={Button.SIZE} h={Button.SIZE}>
          <QuantityButton label="5" quantity={Quantity.FIVE} />
        </layer>
        <layer x={Button.QTY_X_X} y="bottom" w={Button.SIZE} h={Button.SIZE}>
          <QuantityButton label="X" quantity={Quantity.X} />
        </layer>
        <layer x={Button.QTY_ALL_X} y="bottom" w={Button.SIZE} h={Button.SIZE}>
          <QuantityButton label="All" quantity={Quantity.ALL} />
        </layer>

        <layer x={Button.ICON_X} y={Button.FILL_Y} w={Button.SIZE} h={Button.SIZE}>
          <IconButton icon={KitArt.FILL} label="Fill" />
        </layer>
        <layer x={Button.ICON_X} y={Button.EMPTY_Y} w={Button.SIZE} h={Button.SIZE}>
          <IconButton icon={KitArt.EMPTY} label="Empty" />
        </layer>

        <layer x="right" y={0} w={Column.W} h="fill">
          <HuntsmansKitPane />
        </layer>
      </layer>
    </>
  );
}
