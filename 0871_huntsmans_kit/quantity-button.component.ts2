import { predictServerState, useRef, useServerState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { KitColor, KitFonts, KitSounds, KitVarbits } from './huntsmans-kit.constants';

export function QuantityButton({ label, quantity }: { label: String; quantity: Int }): Component {
  const armed: Int = useServerState(KitVarbits.QUANTITY);
  const face = useRef();

  if (armed === quantity) {
    return (
      <layer w="fill" h="fill" options={[label]}>
        <StoneButtonPressedFilled>
          <text
            w="fill"
            h="fill"
            text={label}
            font={KitFonts.LABEL}
            color={KitColor.SELECTED}
            shadow
            align="center"
            valign="middle"
          />
        </StoneButtonPressedFilled>
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[label]}
      onMouseRepeat={() => {
        face.color = KitColor.SELECTED;
      }}
      onMouseLeave={() => {
        face.color = KitColor.IDLE;
      }}
      onOptionSelect={() => {
        playSound(KitSounds.CLICK);
        predictServerState(KitVarbits.QUANTITY, quantity);
      }}
    >
      <StoneButtonOutFilled>
        <text
          ref={face}
          w="fill"
          h="fill"
          text={label}
          font={KitFonts.LABEL}
          color={KitColor.IDLE}
          shadow
          align="center"
          valign="middle"
        />
      </StoneButtonOutFilled>
    </layer>
  );
}
