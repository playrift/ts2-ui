import { graphicSwapper } from '../lib/lib.helpers';
import { QuetzalMap } from './quetzal-map.component';
import { Layout, QuetzalArt, QuetzalSprites } from './quetzal-menu.constants';
import { closeQuetzalMenu } from './quetzal-menu.helpers';

export function QuetzalMenu(): Component {
  return (
    <layer w={Layout.panel.w} h={Layout.panel.h} x="center" y="center">
      <layer w="fill" h="fill" x="center" y="center">
        <model x="center" y="center" w={32} h={32} model={QuetzalArt.MAP_SHEET} pitch={513} zoom={575} orthogonal />
        <model x="center" y="center" w={32} h={32} model={QuetzalArt.MAP_OVERLAY} pitch={513} zoom={600} orthogonal />
        <model
          x={131}
          y={{ bottom: 190 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_131_190}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={65}
          y={{ bottom: 256 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_65_256}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={84}
          y={{ bottom: 227 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_TREES}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={115}
          y={{ bottom: 264 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_TREES}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={143}
          y={{ bottom: 235 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_TREES}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={293}
          y={{ bottom: 197 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_PEAKS}
          pitch={513}
          zoom={600}
          orthogonal
        />
        <model
          x={214}
          y={{ bottom: 214 }}
          w={40}
          h={40}
          model={QuetzalArt.DECOR_PEAKS}
          pitch={513}
          zoom={600}
          orthogonal
        />
      </layer>

      <QuetzalMap />

      <sprite
        x={{ right: Layout.close.x }}
        y={Layout.close.y}
        w={Layout.close.w}
        h={Layout.close.h}
        sprite={QuetzalSprites.CLOSE}
        options={['Close']}
        onOptionSelect={closeQuetzalMenu}
        onMouseEnter={(event) => graphicSwapper(event.component, QuetzalSprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, QuetzalSprites.CLOSE)}
      />
    </layer>
  );
}
