import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { ButtonIn, ButtonOut, ReportColour, ReportFonts } from './reportabuse.constants';

export function ReportButton({ label, lineHeight }: { label: String; lineHeight: Int }): Component {
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setPressed(0);
        }
      }}
    >
      {pressed === 1 ? (
        <>
          <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={ReportColour.PRESSED_FILL} fill />
          <sprite x="left" y="top" w={9} h={9} sprite={ButtonIn.TOP_LEFT} tiling />
          <sprite x="right" y="top" w={9} h={9} sprite={ButtonIn.TOP_RIGHT} tiling />
          <sprite x="left" y="bottom" w={9} h={9} sprite={ButtonIn.BOTTOM_LEFT} tiling />
          <sprite x="right" y="bottom" w={9} h={9} sprite={ButtonIn.BOTTOM_RIGHT} tiling />
          <sprite x="left" y="center" w={9} h={{ fill: 18 }} sprite={ButtonIn.LEFT} tiling />
          <sprite x="center" y="top" w={{ fill: 18 }} h={9} sprite={ButtonIn.TOP} tiling />
          <sprite x="right" y="center" w={9} h={{ fill: 18 }} sprite={ButtonIn.RIGHT} tiling />
          <sprite x="center" y="bottom" w={{ fill: 18 }} h={9} sprite={ButtonIn.BOTTOM} tiling />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={ButtonOut.FILL} tiling />
          <sprite x="left" y="top" w={9} h={9} sprite={ButtonOut.TOP_LEFT} tiling />
          <sprite x="right" y="top" w={9} h={9} sprite={ButtonOut.TOP_RIGHT} tiling />
          <sprite x="left" y="bottom" w={9} h={9} sprite={ButtonOut.BOTTOM_LEFT} tiling />
          <sprite x="right" y="bottom" w={9} h={9} sprite={ButtonOut.BOTTOM_RIGHT} tiling />
          <sprite x="left" y="center" w={9} h={{ fill: 18 }} sprite={ButtonOut.LEFT} tiling />
          <sprite x="center" y="top" w={{ fill: 18 }} h={9} sprite={ButtonOut.TOP} tiling />
          <sprite x="right" y="center" w={9} h={{ fill: 18 }} sprite={ButtonOut.RIGHT} tiling />
          <sprite x="center" y="bottom" w={{ fill: 18 }} h={9} sprite={ButtonOut.BOTTOM} tiling />
        </>
      )}
      <text
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        text={label}
        font={ReportFonts.BODY}
        color={ReportColour.INK}
        align="center"
        valign="middle"
        lineHeight={lineHeight}
      />
    </layer>
  );
}
