import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { Camera, Layout, WgsWantedPosterArt, WgsWantedPosterModel } from './wgs-wanted-poster.constants';

export function WgsWantedPoster(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={WgsWantedPosterModel.POSTER}
        orthogonal
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={WgsWantedPosterArt.CLOSE}
        options={['Close']}
        dragTarget
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, WgsWantedPosterArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, WgsWantedPosterArt.CLOSE)}
      />
    </>
  );
}
