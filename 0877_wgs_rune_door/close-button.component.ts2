import { closeInterface, graphicSwapper, onMobile } from '../lib/lib.helpers';
import { closeOnEscape } from './close-on-escape';
import { RuneDoorArt } from './rune-door.constants';

export function CloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        right={1}
        y={1}
        w={33}
        h={33}
        sprite={RuneDoorArt.CLOSE_MOBILE}
        options={['Close']}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, RuneDoorArt.CLOSE_MOBILE);
        }}
        onOptionSelect={() => {
          closeInterface();
        }}
        onKey={(event) => {
          closeOnEscape(event.keyCode);
        }}
      />
    );
  }

  return (
    <sprite
      right={3}
      y={6}
      w={26}
      h={23}
      sprite={RuneDoorArt.CLOSE}
      hover={{ sprite: RuneDoorArt.CLOSE_HOVER }}
      options={['Close']}
      onOptionSelect={() => {
        closeInterface();
      }}
      onKey={(event) => {
        closeOnEscape(event.keyCode);
      }}
    />
  );
}
