import { CS2, useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { dialogueMayAdvance } from '../lib/lib.dialogue';
import { GameframeSlot, gameframeSlot } from '../lib/lib.gameframe';

const ESCAPE = 13;

export function closeOnEscape(keyCode: Int): Boolean {
  if (dialogueMayAdvance(-1, -1) === false) {
    return true;
  }

  const viewport: ComponentId = gameframeSlot(GameframeSlot.VIEWPORT);
  if (
    viewport !== -1 &&
    keyCode === ESCAPE &&
    useServerState(Varbits.KEYBINDING_ESC_TO_CLOSE) === 1 &&
    CS2.if_sub_has(viewport)
  ) {
    CS2.if_close();
    return true;
  }
  return false;
}
