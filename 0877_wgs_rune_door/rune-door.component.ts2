import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { CloseButton } from './close-button.component';
import { INSCRIPTIONS, RuneDoorColors, RuneDoorFonts, RuneDoorModels } from './rune-door.constants';

export function RuneDoor(): Component {
  return (
    <layer x="center" y="center" w={512} h={334}>
      <SteelFrame backdrop />

      <layer x="center" y="center" w={{ fill: 12 }} h={{ fill: 12 }}>
        <rect x="center" y="center" w="fill" h="fill" color={RuneDoorColors.SHADOW} fill />

        <model
          x={-17}
          y={{ center: 31 }}
          w={534}
          h={477}
          model={RuneDoorModels.DOOR}
          zoom={493}
          pitch={512}
          yaw={512}
          offsetX={-15}
          offsetY={2}
        />

        {INSCRIPTIONS.map((line) => (
          <>
            <text
              x={{ center: 1 }}
              y={line.y + 1}
              w={line.w}
              h={line.h}
              text={line.text}
              font={RuneDoorFonts.SCRATCHED}
              align="center"
              shadow
              color={RuneDoorColors.SHADOW}
            />
            <text
              x={{ center: 1 }}
              y={line.y - 1}
              w={line.w}
              h={line.h}
              text={line.text}
              font={RuneDoorFonts.SCRATCHED}
              align="center"
              shadow
              color={RuneDoorColors.SHADOW}
            />
            <text
              x={{ center: -1 }}
              y={line.y + 1}
              w={line.w}
              h={line.h}
              text={line.text}
              font={RuneDoorFonts.SCRATCHED}
              align="center"
              shadow
              color={RuneDoorColors.SHADOW}
            />
            <text
              x={{ center: -1 }}
              y={line.y - 1}
              w={line.w}
              h={line.h}
              text={line.text}
              font={RuneDoorFonts.SCRATCHED}
              align="center"
              shadow
              color={RuneDoorColors.SHADOW}
            />
            <text
              x="center"
              y={line.y}
              w={line.w}
              h={line.h}
              text={line.text}
              font={RuneDoorFonts.SCRATCHED}
              align="center"
              shadow
              color={RuneDoorColors.SCRATCH}
            />
          </>
        ))}
      </layer>

      <CloseButton />
    </layer>
  );
}
