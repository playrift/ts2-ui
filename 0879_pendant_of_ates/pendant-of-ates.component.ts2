import { chatDefaultStopInput } from '../0608_fossil_mushtrees/chatdefault-input';
import { graphicSwapper } from '../lib/lib.helpers';
import { DestinationRow } from './destination-row.component';
import { Layout, MapCamera, PendantSprites } from './pendant-of-ates.constants';
import { closePendantOfAtes } from './pendant-of-ates.helpers';

export function PendantOfAtes(): Component {
  return (
    <>
      <layer x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H} onLoad={() => chatDefaultStopInput()}>
        <layer x="center" y="center" w="fill" h="fill">
          <model
            x="center"
            y="center"
            w={Layout.SEA}
            h={Layout.SEA}
            model={51193}
            zoom={MapCamera.ZOOM_SEA}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x="center"
            y="center"
            w={Layout.SEA}
            h={Layout.SEA}
            model={51200}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={131}
            y={{ bottom: 190 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51207}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={65}
            y={{ bottom: 256 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51206}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={84}
            y={{ bottom: 227 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51192}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={115}
            y={{ bottom: 264 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51192}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={143}
            y={{ bottom: 235 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51192}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={214}
            y={{ bottom: 214 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51183}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
          <model
            x={293}
            y={{ bottom: 197 }}
            w={Layout.PIECE}
            h={Layout.PIECE}
            model={51183}
            zoom={MapCamera.ZOOM}
            pitch={MapCamera.PITCH}
            orthogonal
          />
        </layer>

        <layer x={Layout.LANDMARKS_X} y={{ bottom: Layout.LANDMARKS_Y }} w={Layout.LANDMARKS_W} h={Layout.LANDMARKS_H}>
          <Landmark x={291} y={111} model={54545} />
          <Landmark x={216} y={55} model={51194} />
          <Landmark x={148} y={140} model={51197} />
          <Landmark x={230} y={96} model={51182} />
          <Landmark x={161} y={107} model={51203} />
          <Landmark x={272} y={23} model={51195} />
          <Landmark x={277} y={68} model={51207} />
          <Landmark x={353} y={90} model={51204} />
          <Landmark x={142} y={28} model={54540} />
          <Landmark x={206} y={162} model={54538} />
          <Landmark x={272} y={165} model={54549} />
          <Landmark x={107} y={78} model={56664} />
          <Landmark x={134} y={201} model={56661} />
          <Landmark x={54} y={109} model={56666} />
        </layer>

        <layer w="fill" h="fill">
          <DestinationRow id={6} x={122} y={201} w={122} />
          <DestinationRow id={2} x={286} y={168} w={122} />
          <DestinationRow id={1} x={221} y={185} w={84} />
          <DestinationRow id={3} x={206} y={124} w={94} />
          <DestinationRow id={4} x={168} y={47} w={114} />
          <DestinationRow id={5} x={142} y={110} w={72} />
        </layer>

        <sprite
          x={{ right: Layout.CLOSE_X }}
          y={Layout.CLOSE_Y}
          w={Layout.CLOSE_W}
          h={Layout.CLOSE_H}
          sprite={PendantSprites.CLOSE}
          options={['Close']}
          onOptionSelect={closePendantOfAtes}
          onMouseEnter={(event) => graphicSwapper(event.component, PendantSprites.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapper(event.component, PendantSprites.CLOSE)}
        />
      </layer>

      <rect x={0} y={0} w={1} h={1} color={0} />
      <rect x={0} y={0} w={1} h={1} color={0} />
      <rect x={0} y={0} w={1} h={1} color={0} />
      <rect x={0} y={0} w={1} h={1} color={0} />
      <rect x={0} y={0} w={1} h={1} color={0} />
      <rect x={0} y={0} w={1} h={1} color={0} />
    </>
  );
}

function Landmark({ x, y, model }: { x: Int; y: Int; model: Model }): Component {
  return (
    <model
      x={x}
      y={{ bottom: y }}
      w={Layout.LANDMARK}
      h={Layout.LANDMARK}
      model={model}
      zoom={MapCamera.ZOOM}
      pitch={MapCamera.PITCH}
      orthogonal
    />
  );
}
