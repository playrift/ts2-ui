import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { chatMessage, playSound } from '../lib/lib.engine';
import { closeInterface } from '../lib/lib.helpers';
import { NOT_ACTIVATED, PendantSounds } from './pendant-of-ates.constants';

export function pendantFound(id: Int): Int {
  switch (id) {
    case 1:
      return useServerState(Varbits.PENDANT_OF_ATES_DARKFROST_FOUND) === 1 ? 1 : 0;
    case 2:
      return useServerState(Varbits.PENDANT_OF_ATES_TWILIGHT_FOUND) === 1 ? 1 : 0;
    case 3:
      return useServerState(Varbits.PENDANT_OF_ATES_RALOS_FOUND) === 1 ? 1 : 0;
    case 4:
      return useServerState(Varbits.PENDANT_OF_ATES_ALDARIN_FOUND) === 1 ? 1 : 0;
    case 5:
      return useServerState(Varbits.PENDANT_OF_ATES_TLATI_FOUND) === 1 ? 1 : 0;
    case 6:
      return useServerState(Varbits.PENDANT_OF_ATES_AUBURN_FOUND) === 1 ? 1 : 0;
  }
  return 0;
}

export function closePendantOfAtes(): void {
  playSound(PendantSounds.CLOSE);
  closeInterface();
}

export function selectRefused(id: Int): Boolean {
  playSound(PendantSounds.SELECT);
  if (pendantFound(id) === 0) {
    chatMessage(NOT_ACTIVATED);
    return true;
  }
  return false;
}
