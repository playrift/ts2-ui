import { createRef, useWatch } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { Layout, MmOverlay, MmSkills } from './mm-overlay.constants';
import { content, tooltipHost } from './mm-overlay.refs';
import { MmOrders } from './mm-orders.component';
import { MmTooltip } from './mm-tooltip.component';
import { bumpMmSkillTick } from './mm-overlay.state';

const dodger = createRef('mm_overlay_dodger');

export function MmOverlay_(): Component {
  useWatch(MmSkills.HERBLORE, () => bumpMmSkillTick(), content);

  return (
    <layer w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <layer
        ref={dodger}
        onLoad={() => overlayInit(dodger, content, MmOverlay.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
        w={Layout.PLATE_W}
        h={Layout.PLATE_H}
      >
        <layer ref={content} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <MmOrders />
        </layer>

        <layer ref={tooltipHost} w={Layout.TOOLTIP_HOST} h={Layout.TOOLTIP_HOST} />

        <layer x={0} y={0} w="fill" h="fill">
          <MmTooltip />
        </layer>
      </layer>
    </layer>
  );
}
