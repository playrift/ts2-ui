import { CS2, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { tooltipBuilt, tooltipTime } from '../lib/game/varcs';
import { clientClock } from '../lib/lib.engine';
import { Tip, Tooltip } from './mm-overlay.constants';
import { tooltipHost } from './mm-overlay.refs';

function onEnhancedMobile(): Boolean {
  const type: Int = CS2.clienttype();
  if (useServerState(Varbits.OSM_SIMULATE) === 1) {
    if (type === 4 || type === 5 || type === 10) {
      return true;
    }
  }
  if (type === 7 || type === 8) {
    return true;
  }
  return false;
}

function dwellElapsed(): Boolean {
  const [until, setUntil] = useState(tooltipTime);
  if (until < clientClock() + Tooltip.DWELL) {
    if (until < clientClock()) {
      setUntil(clientClock() + 2);
    } else {
      setUntil(until + 2);
    }
    return false;
  }
  setUntil(clientClock() + Tooltip.DWELL + 10);
  return true;
}

function hiddenComponent(component: ComponentId): Boolean {
  return CS2.if_hide_get(component);
}

function tooltipReady(): Boolean {
  const [built] = useState(tooltipBuilt);
  if (built === Tip.NONE) {
    if (!hiddenComponent(tooltipHost)) {
      return true;
    }
  }
  return false;
}

export function showMmOrderTooltip(index: Int): void {
  const [, setTip] = useState(tooltipBuilt);
  if (onEnhancedMobile()) {
    return;
  }
  if (tooltipReady()) {
    if (dwellElapsed()) {
      setTip(Tip.ORDER_1 + index);
    }
  }
}

export function showMmModifierTooltip(index: Int): void {
  const [, setTip] = useState(tooltipBuilt);
  if (onEnhancedMobile()) {
    return;
  }
  if (tooltipReady()) {
    if (dwellElapsed()) {
      setTip(Tip.MODIFIER_1 + index);
    }
  }
}

export function showMmReagentTooltip(index: Int): void {
  const [, setTip] = useState(tooltipBuilt);
  if (onEnhancedMobile()) {
    return;
  }
  if (tooltipReady()) {
    if (dwellElapsed()) {
      setTip(Tip.REAGENT_1 + index);
    }
  }
}

export function hideMmTooltip(): void {
  const [, setTip] = useState(tooltipBuilt);
  setTip(Tip.NONE);
}
