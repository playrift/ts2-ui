import { closeInterface } from '../lib/lib.helpers';
import { CloseSprites } from './mm-formulas.constants';

export function CloseButton(): Component {
  return (
    <sprite
      w="fill"
      h="fill"
      sprite={CloseSprites.CLOSE}
      hover={{ sprite: CloseSprites.CLOSE_HOVER }}
      onClick={() => closeInterface()}
    />
  );
}
