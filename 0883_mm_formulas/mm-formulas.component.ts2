import { CloseButton } from './close-button.component';
import { FORMULAS, Layout, MixologyFonts, MixologyModels, MixologySprites } from './mm-formulas.constants';

export function MmFormulas(): Component {
  return (
    <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <CloseButton x={{ right: Layout.CLOSE_RIGHT }} y={Layout.CLOSE_Y} w={Layout.CLOSE_W} h={Layout.CLOSE_H} />

      <model
        x="center"
        y={{ center: Layout.POSTER_DY }}
        w={Layout.POSTER_W}
        h={Layout.POSTER_H}
        model={MixologyModels.POSTER}
        zoom={Layout.POSTER_ZOOM}
        pitch={Layout.POSTER_PITCH}
      />

      <layer x={0} y={0} w={Layout.ROOT_W} h={Layout.ROOT_H}>
        <sprite x={441} y={261} w={Layout.LEGEND_ICON} h={Layout.LEGEND_ICON} sprite={MixologySprites.HOMOGENOUS} />

        <text
          x={415}
          y={Layout.LEGEND_LABEL_Y}
          w={Layout.LEGEND_LABEL_W}
          h={Layout.LEGEND_LABEL_H}
          text="Homogenous"
          align="center"
          font={MixologyFonts.LEGEND}
        />
        <text
          x={338}
          y={Layout.LEGEND_LABEL_Y}
          w={Layout.LEGEND_LABEL_W}
          h={Layout.LEGEND_LABEL_H}
          text="Crystallised"
          align="center"
          font={MixologyFonts.LEGEND}
        />
        <text
          x={261}
          y={Layout.LEGEND_LABEL_Y}
          w={Layout.LEGEND_LABEL_W}
          h={Layout.LEGEND_LABEL_H}
          text="Concentrated"
          align="center"
          font={MixologyFonts.LEGEND}
        />

        <sprite x={287} y={262} w={Layout.LEGEND_ICON} h={Layout.LEGEND_ICON} sprite={MixologySprites.CONCENTRATED} />
        <sprite x={364} y={261} w={Layout.LEGEND_ICON} h={Layout.LEGEND_ICON} sprite={MixologySprites.CRYSTALLISED} />

        <text
          x={Layout.TITLE_X}
          y={Layout.TITLE_Y}
          w={Layout.TITLE_W}
          h={Layout.TITLE_H}
          text="Lab notes"
          font={MixologyFonts.TITLE}
        />

        {FORMULAS.map((row) => (
          <>
            <text
              x={row.x}
              y={row.y}
              w={Layout.NAME_W}
              h={Layout.NAME_H}
              text={row.name}
              align="center"
              valign="middle"
              font={MixologyFonts.FORMULA}
            />
            <sprite
              x={row.x + Layout.ICON_DX}
              y={row.y + Layout.ICON_DY}
              w={Layout.ICON}
              h={Layout.ICON}
              sprite={row.first}
            />
            <sprite
              x={row.x + Layout.ICON_DX + Layout.ICON_GAP}
              y={row.y + Layout.ICON_DY}
              w={Layout.ICON}
              h={Layout.ICON}
              sprite={row.second}
            />
            <sprite
              x={row.x + Layout.ICON_DX + Layout.ICON_GAP + Layout.ICON_GAP}
              y={row.y + Layout.ICON_DY}
              w={Layout.ICON}
              h={Layout.ICON}
              sprite={row.third}
            />
          </>
        ))}
      </layer>
    </layer>
  );
}
