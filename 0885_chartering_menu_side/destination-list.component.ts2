import { useRef } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBox } from '../lib/thin-box.component';
import { Charter, Destinations } from './chartering-destinations.data';
import { CharterBar, Layout } from './chartering-menu-side.constants';
import { charterListed, charterRowText, currentCharter } from './chartering.helpers';
import { DestinationRow } from './destination-row.component';

export function DestinationList(): Component {
  const content = useRef();
  const here: Charter = currentCharter();

  return (
    <layer w="fill" h="fill">
      <layer x={0} y={0} w={{ fill: Layout.BACKING_W_INSET }} h="fill">
        <ThinBox />
      </layer>

      <layer
        ref={content}
        x={Layout.CONTENT_X}
        y={Layout.CONTENT_Y}
        w={{ fill: Layout.CONTENT_W_INSET }}
        h={{ fill: Layout.CONTENT_H_INSET }}
        scrollHeight={visibleCharters(here) * Layout.ROW_H}
      >
        {Destinations.scan(
          (row, index, top) =>
            charterListed(here, index) ? (
              <DestinationRow label={charterRowText(index, row.name)} name={row.name} top={top} dark={darkRow(top)} />
            ) : null,
          (row, index) => (charterListed(here, index) ? Layout.ROW_H : 0),
          0,
        )}
      </layer>

      <layer x={{ right: 0 }} y={0} w={Layout.BAR_W} h="fill">
        <ScrollbarVertical
          content={content}
          track={CharterBar.TRACK}
          capTopSprite={CharterBar.CAP_TOP}
          thumbSprite={CharterBar.THUMB}
          capBottomSprite={CharterBar.CAP_BOTTOM}
          arrowUp={CharterBar.ARROW_UP}
          arrowDown={CharterBar.ARROW_DOWN}
          rebuilt
        />
      </layer>
    </layer>
  );
}

function darkRow(top: Int): Boolean {
  if (top % (Layout.ROW_H * 2) === 0) {
    return true;
  }
  return false;
}

function visibleCharters(here: Charter): Int {
  let shown: Int = 0;
  if (charterListed(here, Charter.PORT_SARIM)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.BRIMHAVEN)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.CATHERBY)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.MOS_LE_HARMLESS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.MUSA_POINT)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PORT_KHAZARD)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PORT_PHASMATYS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.KARAMJA_SHIPYARD)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PORT_TYRAS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.CORSAIR_COVE)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PRIFDDINAS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PORT_PISCARILIUS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.LANDS_END)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.CIVITAS_ILLA_FORTIS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.ALDARIN)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.SUNSET_COAST)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.TEMPESTUS)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.CRANDOR)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.THE_PANDEMONIUM)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.THE_SUMMER_SHORE)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.RED_ROCK)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.BARRACUDA_HQ)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.DEEPFIN_POINT)) {
    shown = shown + 1;
  }
  if (charterListed(here, Charter.PORT_ROBERTS)) {
    shown = shown + 1;
  }
  return shown;
}
