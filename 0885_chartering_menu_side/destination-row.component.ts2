import { useRef } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import { CharterArt, CharterColors, CharterFonts, Layout } from './chartering-menu-side.constants';

export function DestinationRow({
  label,
  name,
  top,
  dark,
}: {
  label: String;
  name: String;
  top: Int;
  dark: Boolean;
}): Component {
  const text = useRef();

  return (
    <>
      <sprite
        x={0}
        y={top}
        w="fill"
        h={Layout.ROW_H}
        sprite={dark ? CharterArt.ROW_DARK : CharterArt.ROW}
        tiling
        options={[name]}
        onOptionSelect={(event) => opsound(event.option, 2)}
        onMouseEnter={() => {
          text.color = CharterColors.ROW_HOVER;
        }}
        onMouseLeave={() => {
          text.color = CharterColors.ROW;
        }}
      />
      <text
        ref={text}
        x={Layout.TEXT_X}
        y={top}
        w={{ fill: Layout.TEXT_W_INSET }}
        h={Layout.ROW_H}
        text={label}
        font={CharterFonts.ROW}
        color={CharterColors.ROW}
        align="left"
        valign="middle"
        shadow
      />
    </>
  );
}
