import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  PrepotColors,
  PrepotFonts,
  PrepotLayout,
  PrepotModel,
  PrepotSprites,
  PrepotText,
} from './prepot-device.constants';

export function PrepotDevice(): Component {
  return (
    <layer x={{ center: PrepotLayout.ROOT_X }} y={PrepotLayout.ROOT_Y} w={PrepotLayout.ROOT_W} h={PrepotLayout.ROOT_H}>
      <layer x={0} y={0} w={PrepotLayout.ROOT_W} h={PrepotLayout.ROOT_H} />

      <model
        x={PrepotLayout.BARREL_X}
        y={PrepotLayout.BARREL_Y}
        w={PrepotLayout.BARREL_BOX}
        h={PrepotLayout.BARREL_BOX}
        model={PrepotModel.BARREL}
        orthogonal
        pitch={PrepotLayout.BARREL_PITCH}
        yaw={PrepotLayout.BARREL_YAW}
        roll={0}
        zoom={PrepotLayout.BARREL_ZOOM}
        offsetX={0}
        offsetY={PrepotLayout.BARREL_OFFSET_Y}
      />

      <model
        x={{ right: PrepotLayout.BARREL_X }}
        y={PrepotLayout.BARREL_Y}
        w={PrepotLayout.BARREL_BOX}
        h={PrepotLayout.BARREL_BOX}
        model={PrepotModel.BARREL}
        orthogonal
        pitch={PrepotLayout.BARREL_PITCH}
        yaw={PrepotLayout.BARREL_YAW}
        roll={0}
        zoom={PrepotLayout.BARREL_ZOOM}
        offsetX={0}
        offsetY={PrepotLayout.BARREL_OFFSET_Y}
      />

      <layer x="center" y={PrepotLayout.TOP_Y} w={PrepotLayout.TOP_W} h={PrepotLayout.TOP_H}>
        <sprite x={0} y={0} w="fill" h="fill" sprite={PrepotSprites.BACKING} tiling />
        <ThinBoxEntrypoint />
        <layer
          x={PrepotLayout.TOP_CONTENT_X}
          y={PrepotLayout.TOP_CONTENT_Y}
          w={{ fill: PrepotLayout.CONTENT_INSET_X }}
          h={{ fill: PrepotLayout.CONTENT_INSET_Y }}
        />
        <text
          x={0}
          y={0}
          w="fill"
          h={PrepotLayout.CAPTION_H}
          text={PrepotText.TOP}
          font={PrepotFonts.CAPTION}
          color={PrepotColors.CAPTION}
          shadow
          align="center"
          valign="bottom"
        />
      </layer>

      <layer x="center" y={{ bottom: PrepotLayout.BOTTOM_MARGIN }} w={PrepotLayout.BOTTOM_W} h={PrepotLayout.BOTTOM_H}>
        <sprite x={0} y={0} w="fill" h="fill" sprite={PrepotSprites.BACKING} tiling />
        <ThinBoxEntrypoint />
        <layer
          x={PrepotLayout.BOTTOM_CONTENT_X}
          y={PrepotLayout.BOTTOM_CONTENT_Y}
          w={{ fill: PrepotLayout.CONTENT_INSET_X }}
          h={{ fill: PrepotLayout.CONTENT_INSET_Y }}
        />
        <text
          x={0}
          y={0}
          w={PrepotLayout.BOTTOM_W}
          h={PrepotLayout.CAPTION_H}
          text={PrepotText.BOTTOM}
          font={PrepotFonts.CAPTION}
          color={PrepotColors.CAPTION}
          shadow
          align="center"
          valign="bottom"
        />
      </layer>
    </layer>
  );
}
