import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { INSPECT_SUBJECT, INSPECT_VERB, PREPOT_TITLE, PrepotLayout } from './prepot-device-debug.constants';

export function PrepotDeviceDebug(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={PREPOT_TITLE} />

      <layer y={PrepotLayout.BODY_TOP} w="fill" h={{ fill: PrepotLayout.BODY_INSET_H }}>
        <layer
          x="center"
          y="center"
          w={PrepotLayout.BUTTON}
          h={PrepotLayout.BUTTON}
          spellTargets={['component']}
          optionSubject={INSPECT_SUBJECT}
          targetVerb={INSPECT_VERB}
        />
      </layer>
    </>
  );
}
