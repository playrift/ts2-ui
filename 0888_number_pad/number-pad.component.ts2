import { useInterval } from 'ts2';

import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { Layout, PadSprites } from './number-pad.constants';
import { confirmRef, closeRef, displayRef, padRef } from './number-pad.refs';
import { closeButtonInit, numberPadRearmTick, submitButtonBuild } from './number-pad.builders';
import { chatDefaultStopInput } from './chatdefault';

export function NumberPad(): Component {
  useInterval(() => numberPadRearmTick(), confirmRef);

  return (
    <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H} onLoad={() => chatDefaultStopInput()}>
      <layer x="center" y="center" w="fill" h="fill">
        <SteelFrame backdrop />
      </layer>

      <layer x="center" y="center" w={{ fill: Layout.INNER_INSET }} h={{ fill: Layout.INNER_INSET }}>
        <sprite x="center" y="center" w={Layout.ART_W} h={Layout.ART_H} sprite={PadSprites.BACKGROUND} />

        <layer
          static
          ref={displayRef}
          x="center"
          y={{ center: Layout.DISPLAY_DY }}
          w={Layout.DISPLAY_W}
          h={Layout.DISPLAY_H}
        />

        <layer static ref={padRef} x="center" y={{ center: Layout.PAD_DY }} w={Layout.PAD_W} h={Layout.PAD_H}>
          <layer
            static
            ref={confirmRef}
            x={{ right: 0 }}
            y={{ bottom: 0 }}
            w={Layout.KEY}
            h={Layout.KEY}
            onLoad={(event) => submitButtonBuild(event.self)}
          />
        </layer>
      </layer>

      <sprite
        ref={closeRef}
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        onLoad={(event) => closeButtonInit(event.self)}
      />
    </layer>
  );
}
