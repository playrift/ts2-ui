import { sessionState, useState } from 'ts2';

import { numberPadValue0, numberPadValue1, numberPadValue2, numberPadValue3 } from '../lib/game/varcs';

export function numberPadPush(digit: Int): Boolean {
  const [v0, set0] = useState(numberPadValue0);
  const [v1, set1] = useState(numberPadValue1);
  const [v2, set2] = useState(numberPadValue2);
  const [v3, set3] = useState(numberPadValue3);
  if (v0 <= 0) {
    set0(digit + 1);
  } else if (v1 <= 0) {
    set1(digit + 1);
  } else if (v2 <= 0) {
    set2(digit + 1);
  } else if (v3 <= 0) {
    set3(digit + 1);
  } else {
    return false;
  }
  return true;
}

export function numberPadPop(): Boolean {
  const [v0, set0] = useState(numberPadValue0);
  const [v1, set1] = useState(numberPadValue1);
  const [v2, set2] = useState(numberPadValue2);
  const [v3, set3] = useState(numberPadValue3);
  if (v3 > 0) {
    set3(0);
  } else if (v2 > 0) {
    set2(0);
  } else if (v1 > 0) {
    set1(0);
  } else if (v0 > 0) {
    set0(0);
  } else {
    return false;
  }
  return true;
}

export function numberPadDigit(cell: Int): Int {
  const [v0] = useState(numberPadValue0);
  const [v1] = useState(numberPadValue1);
  const [v2] = useState(numberPadValue2);
  const [v3] = useState(numberPadValue3);
  switch (cell) {
    case 0:
      return v0 - 1;
    case 1:
      return v1 - 1;
    case 2:
      return v2 - 1;
    case 3:
      return v3 - 1;
  }
  return -1;
}

export function numberPadClear(): void {
  const [, set0] = useState(numberPadValue0);
  const [, set1] = useState(numberPadValue1);
  const [, set2] = useState(numberPadValue2);
  const [, set3] = useState(numberPadValue3);
  set0(0);
  set1(0);
  set2(0);
  set3(0);
}

export function numberPadValue(): Int {
  const [v0] = useState(numberPadValue0);
  const [v1] = useState(numberPadValue1);
  const [v2] = useState(numberPadValue2);
  const [v3] = useState(numberPadValue3);
  return (v0 - 1) * 1000 + (v1 - 1) * 100 + (v2 - 1) * 10 + (v3 - 1);
}

export const numberPadSubmitRearm = sessionState(-1);

export const numberPadCloseRearm = sessionState(-1);
