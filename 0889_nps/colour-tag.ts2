import { hexToRgb } from '../0259_area_task/area-task.helpers';
import { HexLetters } from './nps.constants';

export function replaceAll(subject: String, search: String, replacement: String): String {
  let out: String = '';
  let from: Int = 0;
  let at: Int = subject.indexOf(search, from);
  while (at !== -1) {
    out = `${out}${subject.substring(from, at)}${replacement}`;
    from = at + search.length;
    at = subject.indexOf(search, from);
  }
  return `${out}${subject.substring(from, subject.length)}`;
}

function hexDigit(nibble: Int): String {
  if (nibble < 10) {
    return stringOf(nibble);
  }
  return HexLetters.get(nibble - 9) ?? '';
}

function hexByte(channel: Int): String {
  return `${hexDigit(channel / 16)}${hexDigit(channel % 16)}`;
}

export function colourTag(colour: Int, tag: String): String {
  const packed: Int = colour === -1 ? 0xff981f : colour;
  const [red, green, blue] = hexToRgb(packed);

  let out: String = '<col=xxyyzz>';
  if (tag.length > 0) {
    out = replaceAll(out, 'col', tag);
  }
  out = replaceAll(out, 'xx', hexByte(red));
  out = replaceAll(out, 'yy', hexByte(green));
  return replaceAll(out, 'zz', hexByte(blue));
}
