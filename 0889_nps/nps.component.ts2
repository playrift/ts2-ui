import { useRef } from 'ts2';
import { closeButtonClickSound } from '../0108_cr_tutorial/close-button-click-sound';
import { hoverSwapUnlessMobile } from './hover-swap';
import { ScoreButton } from './score-button.component';
import { CloseSprites, NpsColors, NpsFonts, NpsLayout, ScoreOffsets } from './nps.constants';

export function Nps(): Component {
  const closeIcon = useRef();

  return (
    <layer x="center" y="center" w={{ fill: NpsLayout.INNER_INSET_W }} h={{ fill: NpsLayout.INNER_INSET_H }}>
      <layer
        x="right"
        y={0}
        w={NpsLayout.CLOSE_W}
        h={NpsLayout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeButtonClickSound()}
        onMouseEnter={() => {
          hoverSwapUnlessMobile(closeIcon, CloseSprites.OVER);
        }}
        onMouseLeave={() => {
          hoverSwapUnlessMobile(closeIcon, CloseSprites.OUT);
        }}
      >
        <sprite
          ref={closeIcon}
          x="center"
          y="center"
          w={NpsLayout.CLOSE_ICON_W}
          h={NpsLayout.CLOSE_ICON_H}
          sprite={CloseSprites.OUT}
        />
      </layer>

      <text
        x="center"
        y={0}
        w={{ fill: NpsLayout.HEADING_INSET_W }}
        h={NpsLayout.HEADING_H}
        font={NpsFonts.HEADING}
        color={NpsColors.LABEL}
        align="center"
        valign="middle"
        lineHeight={NpsLayout.HEADING_LINE}
      />

      {ScoreOffsets.map((dx, score) => (
        <ScoreButton
          score={score}
          x={{ center: dx }}
          y={NpsLayout.SCORE_Y}
          w={NpsLayout.SCORE_W}
          h={NpsLayout.SCORE_H}
        />
      ))}

      <text
        x="center"
        y="bottom"
        w={NpsLayout.SCALE_LABEL_W}
        h={{ fill: NpsLayout.SCALE_LABEL_INSET_H }}
        font={NpsFonts.SCALE_LABEL}
        color={NpsColors.LABEL}
        valign="middle"
      />
      <text
        x="center"
        y="bottom"
        w={NpsLayout.SCALE_LABEL_W}
        h={{ fill: NpsLayout.SCALE_LABEL_INSET_H }}
        font={NpsFonts.SCALE_LABEL}
        color={NpsColors.LABEL}
        align="right"
        valign="middle"
      />
    </layer>
  );
}
