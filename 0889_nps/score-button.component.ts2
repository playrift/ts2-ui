import { useState } from 'ts2';
import { closeButtonClickSound } from '../0108_cr_tutorial/close-button-click-sound';
import { onMobile } from '../lib/lib.helpers';
import { scaleColour } from '../0259_area_task/area-task.helpers';
import { colourTag } from './colour-tag';
import { NpsColors, NpsFonts, NpsScale, StoneButtonIn, StoneButtonOut } from './nps.constants';

export function ScoreButton({ score }: { score: Int }): Component {
  const [pressed, setPressed] = useState(0);

  const tint: Int = scaleColour(NpsColors.SCALE_FROM, NpsColors.SCALE_TO, score, NpsScale.MAX);

  return (
    <layer
      w="fill"
      h="fill"
      options={[stringOf(score)]}
      onOptionSelect={() => closeButtonClickSound()}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setPressed(0);
        }
      }}
    >
      {pressed === 1 ? (
        <>
          <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={NpsColors.PRESSED_FILL} fill />
          <sprite x="left" y="top" w={9} h={9} sprite={StoneButtonIn.TOP_LEFT} tiling />
          <sprite x="right" y="top" w={9} h={9} sprite={StoneButtonIn.TOP_RIGHT} tiling />
          <sprite x="left" y="bottom" w={9} h={9} sprite={StoneButtonIn.BOTTOM_LEFT} tiling />
          <sprite x="right" y="bottom" w={9} h={9} sprite={StoneButtonIn.BOTTOM_RIGHT} tiling />
          <sprite x="left" y="center" w={9} h={{ fill: 18 }} sprite={StoneButtonIn.LEFT} tiling />
          <sprite x="center" y="top" w={{ fill: 18 }} h={9} sprite={StoneButtonIn.TOP} tiling />
          <sprite x="right" y="center" w={9} h={{ fill: 18 }} sprite={StoneButtonIn.RIGHT} tiling />
          <sprite x="center" y="bottom" w={{ fill: 18 }} h={9} sprite={StoneButtonIn.BOTTOM} tiling />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={StoneButtonOut.FILL} tiling />
          <sprite x="left" y="top" w={9} h={9} sprite={StoneButtonOut.TOP_LEFT} tiling />
          <sprite x="right" y="top" w={9} h={9} sprite={StoneButtonOut.TOP_RIGHT} tiling />
          <sprite x="left" y="bottom" w={9} h={9} sprite={StoneButtonOut.BOTTOM_LEFT} tiling />
          <sprite x="right" y="bottom" w={9} h={9} sprite={StoneButtonOut.BOTTOM_RIGHT} tiling />
          <sprite x="left" y="center" w={9} h={{ fill: 18 }} sprite={StoneButtonOut.LEFT} tiling />
          <sprite x="center" y="top" w={{ fill: 18 }} h={9} sprite={StoneButtonOut.TOP} tiling />
          <sprite x="right" y="center" w={9} h={{ fill: 18 }} sprite={StoneButtonOut.RIGHT} tiling />
          <sprite x="center" y="bottom" w={{ fill: 18 }} h={9} sprite={StoneButtonOut.BOTTOM} tiling />
        </>
      )}

      <text
        x="center"
        y="center"
        w={{ fill: 2 }}
        h={{ fill: 2 }}
        text={`${colourTag(tint, 'col')}${stringOf(score)}</col>`}
        font={NpsFonts.HEADING}
        color={NpsColors.LABEL}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
