import { useServerState } from 'ts2';
import { ThinBox } from '../lib/thin-box.component';
import {
  IconBox,
  IronmanColor,
  IronmanFonts,
  IronmanMode,
  IronmanVarbits,
  ModeIcons,
  ModeNames,
} from './ironman-setup.constants';

export function CurrentMode(): Component {
  const mode: Int = useServerState(IronmanVarbits.IRONMAN);
  const icon: Item = ModeIcons.get(mode) ?? 11526;
  const name: String = ModeNames.get(mode) ?? 'None';
  const ghost: Int = mode !== IronmanMode.NONE ? IconBox.SOLID : IconBox.GHOSTED;

  return (
    <layer w="fill" h="fill">
      <ThinBox />

      <sprite
        x={IconBox.HEADER_INSET}
        y="center"
        w={IconBox.W}
        h={IconBox.H}
        item={icon}
        itemCount={-1}
        outline={IconBox.OUTLINE}
        shadowColor={IronmanColor.ICON_SHADOW}
        transparency={ghost}
      />
      <sprite
        x={{ right: IconBox.HEADER_INSET }}
        y="center"
        w={IconBox.W}
        h={IconBox.H}
        item={icon}
        itemCount={-1}
        outline={IconBox.OUTLINE}
        shadowColor={IronmanColor.ICON_SHADOW}
        transparency={ghost}
      />

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={`Your mode: <col=ffffff>${name}</col>`}
        font={IronmanFonts.TITLE}
        color={IronmanColor.LABEL}
        align="center"
        valign="middle"
        lineHeight={13}
        shadow
      />
    </layer>
  );
}
