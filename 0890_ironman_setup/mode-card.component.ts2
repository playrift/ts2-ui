import { useServerState } from 'ts2';
import { ThinBox } from '../lib/thin-box.component';
import { isModeSelectable } from './ironman-setup.helpers';
import {
  CardBox,
  IconBox,
  IronmanColor,
  IronmanFonts,
  IronmanMode,
  IronmanSprites,
  IronmanVarbits,
  IronmanVarps,
  ModeDescriptions,
  ModeIcons,
} from './ironman-setup.constants';

export function ModeCard({ mode }: { mode: Int }): Component {
  const current: Int = useServerState(IronmanVarbits.IRONMAN);
  const disabled: Int = useServerState(IronmanVarps.SETUP_DISABLED);
  const open: Int = useServerState(IronmanVarps.SETUP_OPEN);

  const live: Int = isModeSelectable(current, disabled, open, mode);
  const backdrop: Sprite =
    current === mode || live === 1 ? IronmanSprites.BACKDROP_LIGHT : IronmanSprites.BACKDROP_DARK;

  const icon: Item = ModeIcons.get(mode) ?? 11526;
  const ghost: Int = mode !== IronmanMode.NONE ? IconBox.SOLID : IconBox.GHOSTED;

  return (
    <layer w="fill" h="fill">
      <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={backdrop} tiling />

      <ThinBox />

      <sprite
        x={IconBox.CARD_LEFT}
        y={IconBox.CARD_TOP}
        w={IconBox.W}
        h={IconBox.H}
        item={icon}
        itemCount={-1}
        outline={IconBox.OUTLINE}
        shadowColor={IronmanColor.ICON_SHADOW}
        transparency={ghost}
      />
      <sprite
        x="right"
        y={IconBox.CARD_TOP}
        w={IconBox.W}
        h={IconBox.H}
        item={icon}
        itemCount={-1}
        outline={IconBox.OUTLINE}
        shadowColor={IronmanColor.ICON_SHADOW}
        transparency={ghost}
      />

      <text
        x="center"
        y={CardBox.TEXT_TOP}
        w={{ fill: CardBox.TEXT_INSET_W }}
        h={{ fill: CardBox.TEXT_INSET_H }}
        text={ModeDescriptions.get(mode) ?? 'No Ironman restrictions apply to this character.'}
        font={IronmanFonts.BODY}
        color={IronmanColor.LABEL}
        align="center"
        valign="middle"
        lineHeight={CardBox.LINE_HEIGHT}
        shadow
      />
    </layer>
  );
}
