import { useState } from 'ts2';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import {
  ActionParams,
  DRAG_X_OFFSET,
  HotkeyColor,
  HotkeyFonts,
  HotkeySprites,
  Hotkeys,
  Layout,
} from './hotkey-settings-new.constants';
import { dragIdle } from './hotkey-settings-new.helpers';
import { draggingAction, draggingMouseX, draggingMouseY } from './hotkey-settings-new.state';

export function DraggingSlot(): Component {
  const [action] = useState(draggingAction);
  const [mouseX] = useState(draggingMouseX);
  const [mouseY] = useState(draggingMouseY);

  const row: Row = Hotkeys.get(action);

  return (
    <layer
      x={mouseX + DRAG_X_OFFSET}
      y={mouseY + Layout.draggingSlot.h}
      w={Layout.draggingSlot.w}
      h={Layout.draggingSlot.h}
      hide={dragIdle(row)}
    >
      <sprite x="center" y="center" w="fill" h="fill" sprite={HotkeySprites.BACKING} />

      <sprite
        x={Layout.draggingIcon.x}
        y="center"
        w={Layout.draggingIcon.w}
        h={Layout.draggingIcon.h}
        sprite={row === -1 ? -1 : row.sprite(ActionParams.ICON)}
      />

      <text
        x={Layout.draggingLabel.x}
        y="center"
        w={{ fill: Layout.draggingLabel.insetW }}
        h="fill"
        text={row === -1 ? '' : row.text(ActionParams.NAME)}
        font={HotkeyFonts.HEADER}
        color={HotkeyColor.LABEL}
        shadow
        align="center"
        valign="middle"
        lineHeight={Layout.draggingLabel.lineHeight}
      />

      <ThinBoxEntrypoint />
    </layer>
  );
}
