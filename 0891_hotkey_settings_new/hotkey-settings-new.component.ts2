import { useRef } from 'ts2';
import { SteelBorder } from '../lib/steel-border.component';
import { ThinBox } from '../lib/thin-box.component';
import { ActionPane } from './action-pane.component';
import { DraggingSlot } from './dragging-slot.component';
import { FilterDropdown, LoadoutDropdown } from './dropdown-button.component';
import { LoadoutSlots } from './loadout-slots.component';
import { StoneButtonInit } from './stone-button.component';
import { HotkeyColor, HotkeyFonts, Layout, STEEL_FLAGS } from './hotkey-settings-new.constants';

export function HotkeySettingsNew(): Component {
  const frame = useRef();

  return (
    <>
      <layer x="center" y="center" w={Layout.universe.w} h={Layout.universe.h}>
        <layer ref={frame} x="center" y="center" w="fill" h="fill">
          <SteelBorder title="Hotkey Settings" titleColor={HotkeyColor.LABEL} flags={STEEL_FLAGS} />
        </layer>

        <layer
          x={Layout.content.x}
          y={Layout.content.y}
          w={{ fill: Layout.content.insetW }}
          h={{ fill: Layout.content.insetH }}
        >
          <layer w="fill" h={Layout.topBar.h}>
            <layer
              x={Layout.topBarInner.inset}
              y={Layout.topBarInner.inset}
              w={{ fill: Layout.topBarInner.insetWH }}
              h={{ fill: Layout.topBarInner.insetWH }}
            >
              <text
                y={{ center: Layout.loadoutLabel.dy }}
                w={Layout.loadoutLabel.w}
                h={Layout.loadoutLabel.h}
                text="Loadout:"
                font={HotkeyFonts.LABEL}
                color={HotkeyColor.LABEL}
                shadow
                align="right"
                valign="middle"
              />
              <LoadoutDropdown />
              <text
                x={{ right: Layout.filterLabel.right }}
                y={{ center: Layout.filterLabel.dy }}
                w={Layout.filterLabel.w}
                h={Layout.filterLabel.h}
                text="Filter Actions:"
                font={HotkeyFonts.LABEL}
                color={HotkeyColor.LABEL}
                shadow
                align="right"
                valign="middle"
              />
              <FilterDropdown />
            </layer>
          </layer>

          <layer y={Layout.leftColumn.y} w={Layout.leftColumn.w} h={{ fill: Layout.leftColumn.insetH }}>
            <layer
              x={Layout.contentLeft.inset}
              y={Layout.contentLeft.inset}
              w={{ fill: Layout.contentLeft.insetWH }}
              h={{ fill: Layout.contentLeft.insetWH }}
            >
              <layer
                x={Layout.makeActive.x}
                y={Layout.makeActive.y}
                w={{ fill: Layout.makeActive.insetW }}
                h={Layout.makeActive.h}
              >
                <StoneButtonInit label="Make active" font={HotkeyFonts.BODY} />
              </layer>

              <LoadoutSlots />

              <layer
                x={Layout.clearLoadout.x}
                y={{ bottom: Layout.clearLoadout.bottom }}
                w={{ fill: Layout.clearLoadout.insetW }}
                h={Layout.clearLoadout.h}
              >
                <StoneButtonInit label="Clear loadout" font={HotkeyFonts.BODY} />
              </layer>

              <ThinBox />
            </layer>
          </layer>

          <layer
            x="right"
            y={Layout.rightColumn.y}
            w={{ fill: Layout.rightColumn.insetW }}
            h={{ fill: Layout.rightColumn.insetH }}
          >
            <ActionPane frame={frame} />
          </layer>
        </layer>
      </layer>

      <DropdownOverlay />
      <DropdownOverlay />

      <DraggingSlot />
    </>
  );
}

function DropdownOverlay(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill" hide>
      <layer
        x={Layout.dropdownPanel.x}
        y={Layout.dropdownPanel.y}
        w={Layout.dropdownPanel.w}
        h={Layout.dropdownPanel.h}
        noClickThrough
      >
        <layer w={{ fill: Layout.dropdownContent.insetW }} h="fill" />
        <layer x="right" w={Layout.dropdownScroller.w} h={Layout.dropdownScroller.h} />
      </layer>
    </layer>
  );
}
