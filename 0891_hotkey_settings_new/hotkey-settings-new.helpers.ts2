import type { ActionsRow } from './actions.data';
import { predictServerState, useServerState, useState } from 'ts2';
import { chatMessage } from '../lib/lib.engine';
import { osmHotkeySettingsInfoExpandIndex } from '../lib/game/varcs';
import { draggingAction, draggingMouseX, draggingMouseY } from './hotkey-settings-new.state';
import { Actions, HotkeyVarbits, LOGOUT_ACTION, TUTORIAL_DONE } from './hotkey-settings-new.constants';

export function hotkeyAt(loadout: Int, slot: Int): Int {
  switch (loadout) {
    case 0:
      switch (slot) {
        case 0:
          return useServerState(HotkeyVarbits.ACTIVE_0);
        case 1:
          return useServerState(HotkeyVarbits.ACTIVE_1);
        case 2:
          return useServerState(HotkeyVarbits.ACTIVE_2);
        case 3:
          return useServerState(HotkeyVarbits.ACTIVE_3);
        case 4:
          return useServerState(HotkeyVarbits.ACTIVE_4);
      }
      break;
    case 1:
      switch (slot) {
        case 0:
          return useServerState(HotkeyVarbits.LOADOUT1_0);
        case 1:
          return useServerState(HotkeyVarbits.LOADOUT1_1);
        case 2:
          return useServerState(HotkeyVarbits.LOADOUT1_2);
        case 3:
          return useServerState(HotkeyVarbits.LOADOUT1_3);
        case 4:
          return useServerState(HotkeyVarbits.LOADOUT1_4);
      }
      break;
    case 2:
      switch (slot) {
        case 0:
          return useServerState(HotkeyVarbits.LOADOUT2_0);
        case 1:
          return useServerState(HotkeyVarbits.LOADOUT2_1);
        case 2:
          return useServerState(HotkeyVarbits.LOADOUT2_2);
        case 3:
          return useServerState(HotkeyVarbits.LOADOUT2_3);
        case 4:
          return useServerState(HotkeyVarbits.LOADOUT2_4);
      }
      break;
    case 3:
      switch (slot) {
        case 0:
          return useServerState(HotkeyVarbits.LOADOUT3_0);
        case 1:
          return useServerState(HotkeyVarbits.LOADOUT3_1);
        case 2:
          return useServerState(HotkeyVarbits.LOADOUT3_2);
        case 3:
          return useServerState(HotkeyVarbits.LOADOUT3_3);
        case 4:
          return useServerState(HotkeyVarbits.LOADOUT3_4);
      }
      break;
  }
  return -1;
}

export function setHotkeyAt(loadout: Int, slot: Int, action: Int): void {
  switch (loadout) {
    case 0:
      switch (slot) {
        case 0:
          predictServerState(HotkeyVarbits.ACTIVE_0, action);
          break;
        case 1:
          predictServerState(HotkeyVarbits.ACTIVE_1, action);
          break;
        case 2:
          predictServerState(HotkeyVarbits.ACTIVE_2, action);
          break;
        case 3:
          predictServerState(HotkeyVarbits.ACTIVE_3, action);
          break;
        case 4:
          predictServerState(HotkeyVarbits.ACTIVE_4, action);
          break;
      }
      break;
    case 1:
      switch (slot) {
        case 0:
          predictServerState(HotkeyVarbits.LOADOUT1_0, action);
          break;
        case 1:
          predictServerState(HotkeyVarbits.LOADOUT1_1, action);
          break;
        case 2:
          predictServerState(HotkeyVarbits.LOADOUT1_2, action);
          break;
        case 3:
          predictServerState(HotkeyVarbits.LOADOUT1_3, action);
          break;
        case 4:
          predictServerState(HotkeyVarbits.LOADOUT1_4, action);
          break;
      }
      break;
    case 2:
      switch (slot) {
        case 0:
          predictServerState(HotkeyVarbits.LOADOUT2_0, action);
          break;
        case 1:
          predictServerState(HotkeyVarbits.LOADOUT2_1, action);
          break;
        case 2:
          predictServerState(HotkeyVarbits.LOADOUT2_2, action);
          break;
        case 3:
          predictServerState(HotkeyVarbits.LOADOUT2_3, action);
          break;
        case 4:
          predictServerState(HotkeyVarbits.LOADOUT2_4, action);
          break;
      }
      break;
    case 3:
      switch (slot) {
        case 0:
          predictServerState(HotkeyVarbits.LOADOUT3_0, action);
          break;
        case 1:
          predictServerState(HotkeyVarbits.LOADOUT3_1, action);
          break;
        case 2:
          predictServerState(HotkeyVarbits.LOADOUT3_2, action);
          break;
        case 3:
          predictServerState(HotkeyVarbits.LOADOUT3_3, action);
          break;
        case 4:
          predictServerState(HotkeyVarbits.LOADOUT3_4, action);
          break;
      }
      break;
  }
}

export function hotkeyLocked(actionId: Int, direction: Int, tutorial: Int, tutorial2: Int): Boolean {
  const action: ActionsRow | null = Actions.at(actionId - 1);
  if (action === null) {
    return false;
  }
  if (tutorial < TUTORIAL_DONE && tutorial2 < TUTORIAL_DONE) {
    if (action === Actions.at(LOGOUT_ACTION) && direction === 0) {
      return true;
    }
    if (action.tutorialLocked === 1) {
      return true;
    }
  }
  return false;
}

export function assignHotkey(
  actionId: Int,
  loadout: Int,
  slot: Int,
  currentId: Int,
  tutorial: Int,
  tutorial2: Int,
): void {
  if (hotkeyLocked(currentId, 0, tutorial, tutorial2)) {
    const current: ActionsRow | null = Actions.at(currentId - 1);
    if (current !== null) {
      chatMessage(`You cannot remove the ${current.name} hotkey right now`);
    }
    return;
  }
  if (hotkeyLocked(actionId, 1, tutorial, tutorial2)) {
    const dragged: ActionsRow | null = Actions.at(actionId - 1);
    if (dragged !== null) {
      chatMessage(`You cannot assign the ${dragged.name} hotkey right now`);
    }
    return;
  }
  setHotkeyAt(loadout, slot, actionId);
}

export function toggleInfoExpand(rawIndex: Int, expanded: Int): void {
  const [, setExpanded] = useState(osmHotkeySettingsInfoExpandIndex);
  if (expanded === rawIndex) {
    setExpanded(-1);
  } else {
    setExpanded(rawIndex);
  }
}

export function trackDrag(action: Int, mouseX: Int, mouseY: Int): void {
  const [, setAction] = useState(draggingAction);
  const [, setX] = useState(draggingMouseX);
  const [, setY] = useState(draggingMouseY);
  setAction(action);
  setX(mouseX);
  setY(mouseY);
}

export function endDrag(): void {
  const [, setAction] = useState(draggingAction);
  setAction(-1);
}

export function slotClearHidden(filled: Int, missing: Int): Boolean {
  if (filled === 1 && missing === 1) {
    return true;
  }
  return false;
}

export function dragIdle(row: ActionsRow | null): Boolean {
  if (row === null) {
    return true;
  }
  return false;
}
