import { CS2, useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile, opsound } from '../lib/lib.helpers';
import { HotkeyColor, OPSOUND_MASK } from './hotkey-settings-new.constants';

export function StoneButtonInit({ label, font }: { label: String; font: Font }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onOptionSelect={(event) => opsound(event.option, OPSOUND_MASK)}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
    >
      {skin === 1 ? (
        <StoneButtonPressedFilled>
          <StoneButtonLabel label={label} font={font} />
        </StoneButtonPressedFilled>
      ) : (
        <StoneButtonFilled>
          <StoneButtonLabel label={label} font={font} />
        </StoneButtonFilled>
      )}
    </layer>
  );
}

function StoneButtonLabel({ label, font }: { label: String; font: Font }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={font}
      color={HotkeyColor.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}
