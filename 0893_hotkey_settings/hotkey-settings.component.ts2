import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { HOTKEY_ROWS, HotkeyColor, HotkeyFonts, HotkeySprites, Layout } from './hotkey-settings.constants';

export function HotkeySettings(): Component {
  return (
    <>
      <layer w="fill" h={Layout.frame.h}>
        <StoneBorderEntrypoint title="Hotkey Settings" />
      </layer>

      <layer
        x="center"
        y={{ bottom: Layout.body.bottom }}
        w={{ fill: Layout.body.insetW }}
        h={{ fill: Layout.body.insetH }}
      >
        <layer w="fill" h={Layout.typeBar.h}>
          <sprite w="fill" h="fill" sprite={HotkeySprites.TYPE_BAR} tiling />
          <text
            w={Layout.typeLabel.w}
            h="fill"
            text="Action Type:"
            font={HotkeyFonts.LABEL}
            color={HotkeyColor.LABEL}
            shadow
            align="right"
            valign="middle"
          />
          <layer
            x={Layout.typeDropdown.x}
            y="center"
            w={Layout.typeDropdown.w}
            h={Layout.typeDropdown.h}
            options={['*']}
          />
          <ThinBoxEntrypoint />
        </layer>

        <layer x="center" y={Layout.list.y} w="fill" h={{ fill: Layout.list.insetH }}>
          <layer x="right" w={Layout.gutter.w} h="fill" />
          <layer w={{ fill: Layout.gutter.w }} h="fill">
            <ThinBoxEntrypoint />
          </layer>
          <layer w={{ fill: Layout.gutter.w }} h="fill">
            {HOTKEY_ROWS.map(() => (
              <layer hide options={['*']} />
            ))}
          </layer>
        </layer>

        <layer y="bottom" w="fill" h={Layout.footer.h} />
      </layer>

      <layer x="center" y="center" w="fill" h="fill" hide noClickThrough>
        <rect x="center" y="center" w="fill" h="fill" fill transparency={255} options={['Close dropdown']} />

        <layer w={Layout.dropdown.w} h={Layout.dropdown.h} noClickThrough>
          <sprite x="center" y="center" w="fill" h="fill" sprite={HotkeySprites.DROPDOWN} tiling />
          <layer
            x={Layout.dropdownEntries.x}
            y="center"
            w={{ fill: Layout.dropdownEntries.insetW }}
            h={{ fill: Layout.dropdownEntries.insetH }}
            noClickThrough
          >
            <layer y="center" w="fill" h="fill" hide noClickThrough />
            <layer y="center" w="fill" h="fill" hide noClickThrough />
          </layer>
          <layer
            x={{ right: Layout.dropdownGutter.right }}
            y="center"
            w={Layout.dropdownGutter.w}
            h={{ fill: Layout.dropdownGutter.insetH }}
            noClickThrough
          />
          <ThinBoxEntrypoint />
        </layer>
      </layer>
    </>
  );
}
