import { createRef } from 'ts2';
import { HotkeySettings } from './hotkey-settings.component';
import { Layout } from './hotkey-settings.constants';

const hotkeySettingsRef = createRef('hotkey_settings');

export const hotkeySettingsUi = (): UI => (
  <ui ref={hotkeySettingsRef} x={Layout.root.x} w={Layout.root.w} h={Layout.root.h}>
    <HotkeySettings />
  </ui>
);
