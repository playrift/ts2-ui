import { textWidth } from '../lib/lib.engine';
import { onEnhancedMobile } from '../0134_settings/settings.helpers';

import { Drop, Frame, HiscoresArt, HiscoresColour, HiscoresFonts } from './hiscores.constants';
import { typeIcon, typeName } from './hiscores.helpers';

export function HiscoresTypeControl({ type, open }: { type: Int; open: Boolean }): Component {
  const mobile: Boolean = onEnhancedMobile();
  const label: String = typeName(type);
  const labelW: Int = textWidth(label, Drop.MEASURE_W, HiscoresFonts.VALUE);

  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={HiscoresArt.PLATE} tiling />
      <rect x="center" y="center" w="fill" h="fill" fill={false} color={HiscoresColour.BORDER_OUTER} />
      <rect
        x="center"
        y="center"
        w={{ fill: Frame.INNER_INSET }}
        h={{ fill: Frame.INNER_INSET }}
        fill={false}
        color={HiscoresColour.BORDER_INNER}
      />
      <sprite
        x={{ right: Drop.CHEVRON_X }}
        y="center"
        w={Drop.CHEVRON}
        h={Drop.CHEVRON}
        sprite={open ? HiscoresArt.DROP_OPEN : HiscoresArt.DROP_CLOSED}
      />
      <text
        x={{ center: Drop.LABEL_DX }}
        y="center"
        w={labelW}
        h={{ fill: Drop.LABEL_INSET_H }}
        font={HiscoresFonts.VALUE}
        shadow
        color={HiscoresColour.ORANGE}
        align="center"
        valign="middle"
        text={label}
      />
      <sprite
        x={{ center: Drop.FLAG_DX - labelW / 2 }}
        y="center"
        w={Drop.FLAG}
        h={Drop.FLAG}
        sprite={typeIcon(type)}
      />
      {mobile ? (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          fill
          color={HiscoresColour.BLACK}
          transparency={Drop.PLATE_REST}
        />
      ) : (
        <rect
          x="center"
          y="center"
          w="fill"
          h="fill"
          fill
          color={HiscoresColour.BLACK}
          transparency={Drop.PLATE_REST}
          hover={{ transparency: Drop.PLATE_HOVER }}
        />
      )}
    </>
  );
}
