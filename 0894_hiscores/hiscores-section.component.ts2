import { Frame, HiscoresArt, HiscoresColour, HiscoresFonts } from './hiscores.constants';

export function SectionHeaderPlate({ title, closed }: { title: String; closed: Boolean }): Component {
  return (
    <>
      <sprite x="center" y="top" w="fill" h={Frame.HEADER_H} sprite={HiscoresArt.PLATE} tiling />
      <rect x="center" y="top" w="fill" h={Frame.HEADER_H} fill={false} color={HiscoresColour.BORDER_OUTER} />
      <rect
        x="center"
        y={Frame.INNER_DY}
        w={{ fill: Frame.INNER_INSET }}
        h={Frame.HEADER_H - Frame.INNER_INSET}
        fill={false}
        color={HiscoresColour.BORDER_INNER}
      />
      <text
        x="right"
        y="top"
        w={{ fill: Frame.TITLE_INSET_W }}
        h={Frame.HEADER_H}
        font={HiscoresFonts.TITLE}
        shadow
        color={HiscoresColour.ORANGE}
        align="left"
        valign="middle"
        text={title}
      />
      <sprite
        x={{ right: Frame.CHEVRON_X }}
        y={Frame.CHEVRON_Y}
        w={Frame.CHEVRON}
        h={Frame.CHEVRON}
        sprite={closed ? HiscoresArt.CHEVRON_CLOSED : HiscoresArt.CHEVRON_OPEN}
      />
    </>
  );
}

export function SectionBodyPlate(): Component {
  return (
    <>
      <sprite x="center" y={Frame.HEADER_H} w="fill" h={{ fill: Frame.CLOSED_H }} sprite={HiscoresArt.PLATE} tiling />
      <rect
        x="center"
        y={{ bottom: Frame.BODY_BORDER_BOTTOM }}
        w="fill"
        h={{ fill: Frame.BODY_BORDER_INSET_H }}
        fill={false}
        color={HiscoresColour.BORDER_OUTER}
      />
      <rect
        x="center"
        y={{ bottom: Frame.BODY_INNER_BOTTOM }}
        w={{ fill: Frame.INNER_INSET }}
        h={{ fill: Frame.BODY_INNER_INSET_H }}
        fill={false}
        color={HiscoresColour.BORDER_INNER}
      />
    </>
  );
}
