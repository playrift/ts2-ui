import { CS2 } from 'ts2';

import { chatMessage } from '../lib/lib.engine';
import { enhancedAny, rentalWorld } from '../0134_settings/settings.helpers';
import { buttonsRef, ComponentType, HOP_OP, Root, SizeMode, WORLD_MAX, WorldRange } from './ehc-worldhop.constants';

export function EhcWorldhop(): Component {
  return <layer static ref={buttonsRef} w={Root.W} h={Root.H} hide />;
}

export function ehcWorldhopInit(buttons: ComponentId = buttonsRef): void {
  if (enhancedAny() === false) {
    return;
  }

  CS2.cc_all_delete(buttons);

  let world: Int = 0;
  while (world <= WORLD_MAX) {
    CS2.cc_create(buttons, ComponentType.SPRITE, world, false);
    CS2.cc_size_set(1, 1, SizeMode.MINUS, SizeMode.ABSOLUTE);
    CS2.cc_hide_set(true);
    world = world + 1;
  }
}

export function ehcWorldhopJoin(world: Int, buttons: ComponentId = buttonsRef): void {
  if (enhancedAny() === false) {
    return;
  }

  if (
    rentalWorld() === false &&
    (world === WorldRange.NONE || world > WorldRange.MAX || world <= WorldRange.BELOW_OSRS)
  ) {
    chatMessage('That player is not on an Old School RuneScape world.');
  } else if (CS2.cc_find(buttons, world)) {
    chatMessage('Attempting to switch worlds...');
    CS2.cc_triggerop(HOP_OP);
  } else {
    chatMessage("Unable to join that player's world.");
  }
}
