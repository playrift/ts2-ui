const gridMountRef = createRef('orbs_osm_nomap_grid1');

export function OrbsOsmNomap(): Component {
  return (
    <>
      <layer static ref={gridMountRef} x={0} y={0} w={0} h={0}>
        <sprite x={0} y={0} w={0} h={0} hide />
      </layer>
      <layer x="right" y={0} w={137} h={178}>
        <XpDropsButton left={110} top={3} fromRight />
        <HealthOrb left={44} top={0} fromRight wide clickY={5} clickW={58} clickH={25} />
        <PrayerOrb left={44} top={36} fromRight wide clickY={6} clickW={58} clickH={25} />
        <RunOrb left={44} top={72} fromRight wide clickY={6} clickW={58} clickH={25} />
        <SpecOrb
          left={44}
          top={108}
          fromRight
          panel={OrbsPanel.OSM_NOMAP}
          wide
          clickY={6}
          clickW={58}
          clickH={25}
