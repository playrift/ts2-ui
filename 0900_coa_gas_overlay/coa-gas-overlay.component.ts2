import { createRef } from 'ts2';

import { modelDynamicZoom } from '../lib/lib.models';
import { GasAnims, GasCamera, GasFade, GasModel } from './coa-gas-overlay.constants';

const gasHaze = createRef('coa_gas_overlay_haze');

export function CoaGasOverlay(): Component {
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onTimer={(event) =>
        modelDynamicZoom(
          event.component,
          gasHaze,
          GasCamera.NEAR,
          GasCamera.FAR,
          GasCamera.OFFSET_X,
          GasCamera.OFFSET_Y,
          GasCamera.PITCH,
          GasCamera.YAW,
          GasCamera.ROLL,
        )
      }
    >
      <model
        ref={gasHaze}
        x="center"
        y="center"
        w="fill"
        h="fill"
        model={GasModel.HAZE}
        anim={GasAnims.HAZE}
        zoom={GasCamera.NEAR}
      />

      <rect x={0} y={0} w="fill" h="fill" color={GasFade.COLOR} fill={true} transparency={GasFade.TRANSPARENCY} />
    </layer>
  );
}
