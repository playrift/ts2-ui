import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  Camera,
  CoaTablet2Art,
  CoaTablet2Color,
  CoaTablet2Font,
  CoaTablet2Model,
  Layout,
} from './coa-tablet-2.constants';

export function CoaTablet2(): Component {
  return (
    <layer x="center" y="center" w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
      <model
        x={{ center: Layout.MODEL_X_OFFSET }}
        y={{ center: Layout.MODEL_Y_OFFSET }}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={CoaTablet2Model.BACKGROUND}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
        yaw={Camera.YAW}
        offsetY={Camera.OFFSET_Y}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CoaTablet2Art.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapper(event.component, CoaTablet2Art.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapper(event.component, CoaTablet2Art.CLOSE);
        }}
      />

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={CoaTablet2Font.BODY}
        color={CoaTablet2Color.INK}
        shadow
      />
    </layer>
  );
}
