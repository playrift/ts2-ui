import { CloseButton } from '../0877_wgs_rune_door/close-button.component';
import { graphicSwapper } from '../lib/lib.helpers';
import {
  ButtonLabel,
  DecoderArt,
  DecoderColor,
  DecoderFont,
  DecoderModel,
  DecoderText,
  DigitRows,
  Layout,
  LeverCamera,
  MachineCamera,
  ReadoutPlaces,
  RowLetters,
  StripLabel,
  StripY,
} from './coa-decoder-panel.constants';

export function CoaDecoderPanel(): Component {
  return (
    <layer x="center" y="center" w={Layout.stage.W} h={Layout.stage.H}>
      <model
        x={Layout.machine.X}
        y={Layout.machine.Y}
        w={Layout.machine.W}
        h={Layout.machine.H}
        model={DecoderModel.MACHINE}
        orthogonal
        zoom={MachineCamera.ZOOM}
        pitch={MachineCamera.PITCH}
        offsetX={MachineCamera.OFFSET_X}
        offsetY={MachineCamera.OFFSET_Y}
      />

      <layer x={Layout.face.X} y={0} w={{ fill: Layout.face.INSET_W }} h="fill">
        {RowLetters.map((row) => (
          <text
            x={row.x}
            y={row.y}
            w={Layout.letter.W}
            h={Layout.letter.H}
            text={row.text}
            font={DecoderFont.LETTER}
            color={DecoderColor.GREY}
          />
        ))}

        {DigitRows.map((row) => (
          <text
            x={Layout.digits.X}
            y={row.y}
            w={Layout.digits.W}
            h={Layout.digits.H}
            text={row.text}
            font={DecoderFont.DIGITS}
            color={DecoderColor.GREY}
          />
        ))}

        <sprite
          x={Layout.up.X}
          y={Layout.up.Y}
          w={Layout.button.W}
          h={Layout.button.H}
          sprite={DecoderArt.UP}
          options={['Press']}
          optionSubject={ButtonLabel.UP}
          onMouseRepeat={(event) => graphicSwapper(event.component, DecoderArt.UP_PRESSED)}
          onMouseLeave={(event) => graphicSwapper(event.component, DecoderArt.UP)}
        />
        <sprite
          x={Layout.down.X}
          y={Layout.down.Y}
          w={Layout.button.W}
          h={Layout.button.H}
          sprite={DecoderArt.DOWN}
          options={['Press']}
          optionSubject={ButtonLabel.DOWN}
          onMouseRepeat={(event) => graphicSwapper(event.component, DecoderArt.DOWN_PRESSED)}
          onMouseLeave={(event) => graphicSwapper(event.component, DecoderArt.DOWN)}
        />
        <sprite
          x={Layout.enter.X}
          y={Layout.enter.Y}
          w={Layout.button.W}
          h={Layout.button.H}
          sprite={DecoderArt.ENTER}
          options={['Press']}
          optionSubject={ButtonLabel.ENTER}
          onMouseRepeat={(event) => graphicSwapper(event.component, DecoderArt.ENTER_PRESSED)}
          onMouseLeave={(event) => graphicSwapper(event.component, DecoderArt.ENTER)}
        />
        <sprite
          x={Layout.back.X}
          y={Layout.back.Y}
          w={Layout.button.W}
          h={Layout.button.H}
          sprite={DecoderArt.BACK}
          options={['Press']}
          optionSubject={ButtonLabel.BACK}
          onMouseRepeat={(event) => graphicSwapper(event.component, DecoderArt.BACK_PRESSED)}
          onMouseLeave={(event) => graphicSwapper(event.component, DecoderArt.BACK)}
        />

        <model
          x={Layout.lever.X}
          y={Layout.lever.Y}
          w={Layout.lever.W}
          h={Layout.lever.H}
          model={DecoderModel.LEVER}
          zoom={LeverCamera.ZOOM}
          pitch={LeverCamera.PITCH}
        />

        {ReadoutPlaces.map((x) => (
          <text
            x={x}
            y={Layout.readout.Y}
            w={Layout.readout.W}
            h={Layout.readout.H}
            text={DecoderText.DASH}
            font={DecoderFont.READOUT}
            align="center"
            valign="middle"
          />
        ))}
      </layer>

      <layer x="right" y={0} w={Layout.column.W} h="fill">
        <sprite x="right" y={0} w={Layout.backing.W} h={Layout.backing.H} sprite={DecoderArt.BACKING} />

        <CloseButton />
      </layer>

      <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
        <sprite
          x={Layout.strip.X}
          y={StripY.ONE}
          w={Layout.strip.W}
          h={Layout.strip.H}
          sprite={DecoderArt.STRIP_1}
          options={['Select']}
          optionSubject={StripLabel.ONE}
        />
        <sprite
          x={Layout.strip.X}
          y={StripY.TWO}
          w={Layout.strip.W}
          h={Layout.strip.H}
          sprite={DecoderArt.STRIP_2}
          options={['Select']}
          optionSubject={StripLabel.TWO}
        />
        <sprite
          x={Layout.strip.X}
          y={StripY.THREE}
          w={Layout.strip.W}
          h={Layout.strip.H}
          sprite={DecoderArt.STRIP_3}
          options={['Select']}
          optionSubject={StripLabel.THREE}
        />
        <sprite
          x={Layout.strip.X}
          y={StripY.FOUR}
          w={Layout.strip.W}
          h={Layout.strip.H}
          sprite={DecoderArt.STRIP_4}
          options={['Select']}
          optionSubject={StripLabel.FOUR}
        />
      </layer>

      <layer x={0} y={0} w={Layout.stage.W} h={Layout.stage.H}>
        <sprite x={0} y={0} w={Layout.corner.W} h={Layout.corner.H} sprite={DecoderArt.CORNER_TL} />
        <sprite x="right" y={0} w={Layout.corner.W} h={Layout.corner.H} sprite={DecoderArt.CORNER_TR} />
        <sprite x={0} y="bottom" w={Layout.corner.W} h={Layout.corner.H} sprite={DecoderArt.CORNER_BL} />
        <sprite x="right" y="bottom" w={Layout.corner.W} h={Layout.corner.H} sprite={DecoderArt.CORNER_BR} />

        <sprite
          x={Layout.rail.X}
          y="center"
          w={Layout.rail.W}
          h={{ fill: Layout.rail.INSET_H }}
          sprite={DecoderArt.EDGE_LEFT}
          tiling
        />
        <sprite
          x={{ right: Layout.rail.X }}
          y="center"
          w={Layout.rail.W}
          h={{ fill: Layout.rail.INSET_H }}
          sprite={DecoderArt.EDGE_RIGHT}
          tiling
        />

        <sprite
          x="center"
          y={Layout.bar.Y}
          w={{ fill: Layout.bar.INSET_W }}
          h={Layout.bar.H}
          sprite={DecoderArt.EDGE_TOP}
          tiling
        />
        <sprite
          x="center"
          y={{ bottom: Layout.bar.Y }}
          w={{ fill: Layout.bar.INSET_W }}
          h={Layout.bar.H}
          sprite={DecoderArt.EDGE_BOTTOM}
          tiling
        />

        <sprite
          x={{ right: Layout.divider.X }}
          y="center"
          w={Layout.divider.W}
          h={{ fill: Layout.divider.INSET_H }}
          sprite={DecoderArt.DIVIDER}
          tiling
        />
      </layer>
    </layer>
  );
}
