import { useRef } from 'ts2';
import { closeButtonClickSound } from '../0108_cr_tutorial/close-button-click-sound';
import { hoverSwapUnlessMobile } from '../0889_nps/hover-swap';
import { SurveyBox } from './survey-box.component';
import { CloseSprites, CsatArt, CsatLayout, CsatTransparency } from './csat.constants';

export function CustomerSatisfaction(): Component {
  const closeIcon = useRef();

  return (
    <>
      <sprite
        x="center"
        y="center"
        w="fill"
        h="fill"
        sprite={CsatArt.BACKDROP}
        tiling
        transparency={CsatTransparency.BACKDROP_0}
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: CsatLayout.BACKDROP_INSET_1 }}
        h={{ fill: CsatLayout.BACKDROP_INSET_1 }}
        sprite={CsatArt.BACKDROP}
        tiling
        transparency={CsatTransparency.BACKDROP_1}
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: CsatLayout.BACKDROP_INSET_2 }}
        h={{ fill: CsatLayout.BACKDROP_INSET_2 }}
        sprite={CsatArt.BACKDROP}
        tiling
        transparency={CsatTransparency.BACKDROP_2}
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: CsatLayout.BACKDROP_INSET_3 }}
        h={{ fill: CsatLayout.BACKDROP_INSET_3 }}
        sprite={CsatArt.BACKDROP}
        tiling
        transparency={CsatTransparency.BACKDROP_3}
      />
      <sprite
        x="center"
        y="center"
        w={{ fill: CsatLayout.BACKDROP_INSET_4 }}
        h={{ fill: CsatLayout.BACKDROP_INSET_4 }}
        sprite={CsatArt.BACKDROP}
        tiling
      />

      <layer
        x={{ right: CsatLayout.CLOSE_X }}
        y={CsatLayout.CLOSE_Y}
        w={CsatLayout.CLOSE_W}
        h={CsatLayout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeButtonClickSound()}
        onMouseEnter={() => {
          hoverSwapUnlessMobile(closeIcon, CloseSprites.OVER);
        }}
        onMouseLeave={() => {
          hoverSwapUnlessMobile(closeIcon, CloseSprites.OUT);
        }}
      >
        <sprite
          ref={closeIcon}
          x="center"
          y="center"
          w={CsatLayout.CLOSE_ICON_W}
          h={CsatLayout.CLOSE_ICON_H}
          sprite={CloseSprites.OUT}
        />
      </layer>

      <SurveyBox />
    </>
  );
}
