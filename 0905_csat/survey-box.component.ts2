import { useRef, useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { closeInterface } from '../lib/lib.helpers';
import { Sounds } from '../lib/lib.constants';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { hoverSwapUnlessMobile } from '../0889_nps/hover-swap';
import { CsatColors, CsatFonts, CsatLayout, CsatTiming, Rating, RatingFaces } from './csat.constants';

export function SurveyBox(): Component {
  const face1 = useRef();
  const face2 = useRef();
  const face3 = useRef();
  const face4 = useRef();
  const face5 = useRef();

  const [chosen, setChosen] = useState(Rating.NONE);
  const [closeAt, setCloseAt] = useState(0);

  return (
    <layer
      x="center"
      y={CsatLayout.BOX_Y}
      w={CsatLayout.BOX_W}
      h={CsatLayout.QUESTION_MIN_H + CsatLayout.BOX_EXTRA_H}
      onTimer={() => {
        if (closeAt !== 0 && clientClock() >= closeAt) {
          closeInterface();
        }
      }}
    >
      <text
        x="center"
        y={0}
        w="fill"
        h={CsatLayout.QUESTION_MIN_H}
        font={CsatFonts.QUESTION}
        color={CsatColors.QUESTION}
        shadow
        align="center"
        valign="middle"
        lineHeight={CsatLayout.QUESTION_LINE_H}
      />

      <layer x="center" y="bottom" w="fill" h={{ fill: CsatLayout.QUESTION_MIN_H }}>
        <layer
          x={{ center: CsatLayout.RATING_DX_1 }}
          y="center"
          w={CsatLayout.FACE_W}
          h="fill"
          options={['1']}
          onOptionSelect={() => {
            if (chosen !== Rating.NONE) {
              return;
            }
            playSound(Sounds.CLICK);
            setChosen(Rating.WORST);
            setCloseAt(clientClock() + CsatTiming.CLOSE_CYCLES);
          }}
          onMouseRepeat={() => {
            hoverSwapUnlessMobile(face1, RatingFaces.OVER_1);
          }}
          onMouseLeave={() => {
            hoverSwapUnlessMobile(face1, RatingFaces.REST_1);
          }}
        >
          {chosen === Rating.WORST ? <ButtonBackgroundPressed /> : <ButtonBackground />}
          <sprite
            ref={face1}
            x="center"
            y="center"
            w={CsatLayout.FACE_ICON_W}
            h={CsatLayout.FACE_ICON_H}
            sprite={RatingFaces.REST_1}
          />
        </layer>

        <layer
          x={{ center: CsatLayout.RATING_DX_2 }}
          y="center"
          w={CsatLayout.FACE_W}
          h="fill"
          options={['2']}
          onOptionSelect={() => {
            if (chosen !== Rating.NONE) {
              return;
            }
            playSound(Sounds.CLICK);
            setChosen(Rating.POOR);
            setCloseAt(clientClock() + CsatTiming.CLOSE_CYCLES);
          }}
          onMouseRepeat={() => {
            hoverSwapUnlessMobile(face2, RatingFaces.OVER_2);
          }}
          onMouseLeave={() => {
            hoverSwapUnlessMobile(face2, RatingFaces.REST_2);
          }}
        >
          {chosen === Rating.POOR ? <ButtonBackgroundPressed /> : <ButtonBackground />}
          <sprite
            ref={face2}
            x="center"
            y="center"
            w={CsatLayout.FACE_ICON_W}
            h={CsatLayout.FACE_ICON_H}
            sprite={RatingFaces.REST_2}
          />
        </layer>

        <layer
          x={{ center: CsatLayout.RATING_DX_3 }}
          y="center"
          w={CsatLayout.FACE_W}
          h="fill"
          options={['3']}
          onOptionSelect={() => {
            if (chosen !== Rating.NONE) {
              return;
            }
            playSound(Sounds.CLICK);
            setChosen(Rating.OK);
            setCloseAt(clientClock() + CsatTiming.CLOSE_CYCLES);
          }}
          onMouseRepeat={() => {
            hoverSwapUnlessMobile(face3, RatingFaces.OVER_3);
          }}
          onMouseLeave={() => {
            hoverSwapUnlessMobile(face3, RatingFaces.REST_3);
          }}
        >
          {chosen === Rating.OK ? <ButtonBackgroundPressed /> : <ButtonBackground />}
          <sprite
            ref={face3}
            x="center"
            y="center"
            w={CsatLayout.FACE_ICON_W}
            h={CsatLayout.FACE_ICON_H}
            sprite={RatingFaces.REST_3}
          />
        </layer>

        <layer
          x={{ center: CsatLayout.RATING_DX_4 }}
          y="center"
          w={CsatLayout.FACE_W}
          h="fill"
          options={['4']}
          onOptionSelect={() => {
            if (chosen !== Rating.NONE) {
              return;
            }
            playSound(Sounds.CLICK);
            setChosen(Rating.GOOD);
            setCloseAt(clientClock() + CsatTiming.CLOSE_CYCLES);
          }}
          onMouseRepeat={() => {
            hoverSwapUnlessMobile(face4, RatingFaces.OVER_4);
          }}
          onMouseLeave={() => {
            hoverSwapUnlessMobile(face4, RatingFaces.REST_4);
          }}
        >
          {chosen === Rating.GOOD ? <ButtonBackgroundPressed /> : <ButtonBackground />}
          <sprite
            ref={face4}
            x="center"
            y="center"
            w={CsatLayout.FACE_ICON_W}
            h={CsatLayout.FACE_ICON_H}
            sprite={RatingFaces.REST_4}
          />
        </layer>

        <layer
          x={{ center: CsatLayout.RATING_DX_5 }}
          y="center"
          w={CsatLayout.FACE_W}
          h="fill"
          options={['5']}
          onOptionSelect={() => {
            if (chosen !== Rating.NONE) {
              return;
            }
            playSound(Sounds.CLICK);
            setChosen(Rating.BEST);
            setCloseAt(clientClock() + CsatTiming.CLOSE_CYCLES);
          }}
          onMouseRepeat={() => {
            hoverSwapUnlessMobile(face5, RatingFaces.OVER_5);
          }}
          onMouseLeave={() => {
            hoverSwapUnlessMobile(face5, RatingFaces.REST_5);
          }}
        >
          {chosen === Rating.BEST ? <ButtonBackgroundPressed /> : <ButtonBackground />}
          <sprite
            ref={face5}
            x="center"
            y="center"
            w={CsatLayout.FACE_ICON_W}
            h={CsatLayout.FACE_ICON_H}
            sprite={RatingFaces.REST_5}
          />
        </layer>
      </layer>
    </layer>
  );
}
