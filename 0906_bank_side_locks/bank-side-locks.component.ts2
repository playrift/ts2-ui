import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Layout, LockSprites } from './bank-side-locks.constants';

export function BankSideLocks(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" fill transparency={Layout.FADER_TRANSPARENCY} />

      <layer x="center" y="center" w={Layout.WINDOW_W} h={Layout.WINDOW_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={LockSprites.WINDOW} tiling />
        </layer>

        <layer x={Layout.SLOTS_X} y="center" w={Layout.SLOTS_W} h={{ fill: Layout.SLOTS_H_INSET }}>
          <sprite
            x="center"
            y="center"
            w={{ fill: 2 }}
            h={{ fill: 2 }}
            sprite={LockSprites.SLOTS}
            tiling
            transparency={Layout.SLOTS_FILL_TRANSPARENCY}
          />
          <layer x="center" y="center" w={{ fill: Layout.SLOTS_PANE_INSET }} h={{ fill: Layout.SLOTS_PANE_INSET }} />
          <ThinBoxEntrypoint />
        </layer>

        <layer
          x={{ right: Layout.RIGHT_X }}
          y="center"
          w={{ fill: Layout.RIGHT_W_INSET }}
          h={{ fill: Layout.RIGHT_H_INSET }}
        >
          <layer x="center" y={0} w="fill" h={Layout.ROW_H} options={['*']} />
          <layer x="center" y={0} w="fill" h={Layout.ROW_H} options={['*']} />
          <layer x="center" y="bottom" w={Layout.DONE_W} h={Layout.DONE_H} />
        </layer>
      </layer>
    </layer>
  );
}
