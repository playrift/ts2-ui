import { graphicSwapper, onMobile, opsound } from '../lib/lib.helpers';
import { Copy, KEY_ESCAPE, Layout, OverviewSprites } from './collection-overview.constants';

export function CollectionOverviewClose(): Component {
  if (onMobile()) {
    return (
      <sprite
        right={Layout.CLOSE_MOBILE_XY}
        y={Layout.CLOSE_MOBILE_XY}
        w={Layout.CLOSE_MOBILE}
        h={Layout.CLOSE_MOBILE}
        sprite={OverviewSprites.CLOSE_MOBILE}
        options={[Copy.CLOSE, { label: '', hotkey: KEY_ESCAPE }]}
        onOptionSelect={(event) => opsound(event.option, CLOSE_MASK)}
      />
    );
  }
  return (
    <sprite
      right={Layout.CLOSE_X}
      y={Layout.CLOSE_Y}
      w={Layout.CLOSE_W}
      h={Layout.CLOSE_H}
      sprite={OverviewSprites.CLOSE}
      options={[Copy.CLOSE, { label: '', hotkey: KEY_ESCAPE }]}
      onOptionSelect={(event) => opsound(event.option, CLOSE_MASK)}
      onMouseEnter={(event) => graphicSwapper(event.self, OverviewSprites.CLOSE_LIT)}
      onMouseLeave={(event) => graphicSwapper(event.self, OverviewSprites.CLOSE)}
    />
  );
}

const CLOSE_MASK = 2;
