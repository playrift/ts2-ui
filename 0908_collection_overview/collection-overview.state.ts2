import { CS2, useServerState, useState } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { collectionOverviewHasBeenMoved } from '../lib/game/varcs';
import { Rank, WindowMode } from './collection-overview.constants';

export function overviewResizable(): Boolean {
  if (CS2.window_mode_get() === WindowMode.FIXED) {
    return false;
  }
  if (onMobile()) {
    return false;
  }
  if (useServerState(Varbits.SETTINGS_INTERFACE_RESIZING) === 0) {
    return false;
  }
  return true;
}

export function overviewAtDefaultPosition(): Boolean {
  const [moved] = useState(collectionOverviewHasBeenMoved);
  if (!overviewResizable()) {
    return true;
  }
  if (moved === 0) {
    return true;
  }
  return false;
}

export function collectionGildedThreshold(): Int {
  const max: Int = useServerState(Varps.COLLECTION_COUNT_MAX);
  if (max === 0) {
    return Rank.UNREACHABLE;
  }
  return Rank.STEP * (CS2.scale(90, 100, max) / Rank.STEP);
}

export function collectionRanks(): [Int, Int, Int, Int] {
  const live: Int = useServerState(Varps.COLLECTION_COUNT);
  const hiscore: Int = useServerState(Varps.COLLECTION_COUNT_HIGHSCORES);
  const count: Int = live === 0 ? hiscore : live;

  const gilded: Int = collectionGildedThreshold();
  if (count >= gilded) {
    return [Rank.GILDED, gilded, Rank.NONE, -1];
  }
  if (count >= 1200) {
    return [Rank.DRAGON, 1200, Rank.GILDED, gilded];
  }
  if (count >= 1100) {
    return [Rank.RUNE, 1100, Rank.DRAGON, 1200];
  }
  if (count >= 1000) {
    return [Rank.ADAMANT, 1000, Rank.RUNE, 1100];
  }
  if (count >= 900) {
    return [Rank.MITHRIL, 900, Rank.ADAMANT, 1000];
  }
  if (count >= 700) {
    return [Rank.BLACK, 700, Rank.MITHRIL, 900];
  }
  if (count >= 500) {
    return [Rank.STEEL, 500, Rank.BLACK, 700];
  }
  if (count >= 300) {
    return [Rank.IRON, 300, Rank.STEEL, 500];
  }
  if (count >= 100) {
    return [Rank.BRONZE, 100, Rank.IRON, 300];
  }
  return [Rank.NONE, -1, Rank.BRONZE, 100];
}

export function subsectionCounts(slot: Int): [Int, Int] {
  switch (slot) {
    case 0:
      return [useServerState(Varps.COLLECTION_COUNT_BOSSES), useServerState(Varps.COLLECTION_COUNT_BOSSES_MAX)];
    case 1:
      return [useServerState(Varps.COLLECTION_COUNT_RAIDS), useServerState(Varps.COLLECTION_COUNT_RAIDS_MAX)];
    case 2:
      return [useServerState(Varps.COLLECTION_COUNT_CLUES), useServerState(Varps.COLLECTION_COUNT_CLUES_MAX)];
    case 3:
      return [useServerState(Varps.COLLECTION_COUNT_MINIGAMES), useServerState(Varps.COLLECTION_COUNT_MINIGAMES_MAX)];
    case 4:
      return [useServerState(Varps.COLLECTION_COUNT_OTHER), useServerState(Varps.COLLECTION_COUNT_OTHER_MAX)];
  }
  return [0, 0];
}

export function latestItem(slot: Int): Item {
  switch (slot) {
    case 0:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM0) as Item;
    case 1:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM1) as Item;
    case 2:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM2) as Item;
    case 3:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM3) as Item;
    case 4:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM4) as Item;
    case 5:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM5) as Item;
    case 6:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM6) as Item;
    case 7:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM7) as Item;
    case 8:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM8) as Item;
    case 9:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM9) as Item;
    case 10:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM10) as Item;
    case 11:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM11) as Item;
  }
  return -1 as Item;
}

export function latestItemDate(slot: Int): Int {
  switch (slot) {
    case 0:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM0_DATE);
    case 1:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM1_DATE);
    case 2:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM2_DATE);
    case 3:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM3_DATE);
    case 4:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM4_DATE);
    case 5:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM5_DATE);
    case 6:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM6_DATE);
    case 7:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM7_DATE);
    case 8:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM8_DATE);
    case 9:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM9_DATE);
    case 10:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM10_DATE);
    case 11:
      return useServerState(Varps.COLLECTION_OVERVIEW_LAST_ITEM11_DATE);
  }
  return 0;
}

export function latestItemShown(slot: Int): Boolean {
  const item: Item = latestItem(slot);
  if (item === -1) {
    return false;
  }
  return itemName(item).length > 0;
}
