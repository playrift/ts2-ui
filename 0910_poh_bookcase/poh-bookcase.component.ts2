import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { StonePanelResizableEntrypoint } from './stone-panel-resizable.component';
import { BookList } from './book-list.component';
import { BookcaseArt, Layout } from './poh-bookcase.constants';

export function PohBookcase(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.MAIN_W} h={{ fill: Layout.CONTENT_BOTTOM }}>
        <SteelBorderEntrypoint title="Bookcase" />

        <layer
          x="center"
          y={{ bottom: Layout.CONTENT_BOTTOM }}
          w={{ fill: Layout.CONTENT_INSET_W }}
          h={{ fill: Layout.CONTENT_INSET_H }}
        >
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.BACKDROP_INSET }}
            h={{ fill: Layout.BACKDROP_INSET }}
            sprite={BookcaseArt.BACKDROP}
            tiling
          />

          <BookList />

          <sprite
            x={{ center: Layout.DIVIDER_DX }}
            y="center"
            w={Layout.DIVIDER_W}
            h={{ fill: Layout.DIVIDER_INSET_H }}
            sprite={BookcaseArt.DIVIDER}
            tiling
          />

          <StonePanelResizableEntrypoint />
        </layer>
      </layer>
    </layer>
  );
}
