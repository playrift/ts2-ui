import { stopTimer } from 'ts2';

import { hasBit, clientClock } from '../lib/lib.engine';
import { Fade } from './poh-bookcase.constants';

export function bookRead(bits0: Int, bits1: Int, bits2: Int, bits3: Int, bits4: Int, bit: Int): Boolean {
  if (bit < 32) {
    return hasBit(bits0, bit);
  }
  if (bit < 64) {
    return hasBit(bits1, bit - 32);
  }
  if (bit < 96) {
    return hasBit(bits2, bit - 64);
  }
  if (bit < 128) {
    return hasBit(bits3, bit - 96);
  }
  return hasBit(bits4, bit - 128);
}

export function pressRow(target: ComponentId, restore: Int): void {
  const restoreAt: Int = clientClock() + Fade.PRESS_CYCLES;
  target.transparency = Fade.PRESSED;
  target.onTimer = () => {
    if (clientClock() < restoreAt) {
      return;
    }
    target.transparency = restore;
    stopTimer(target);
  };
}
