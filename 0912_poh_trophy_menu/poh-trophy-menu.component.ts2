import { useServerState } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { TrophyRow } from './trophy-row.component';
import { bandCount } from './poh-trophy-menu.helpers';
import { Band, Layout, TrophySet, TrophyVarps } from './poh-trophy-menu.constants';

export function PohTrophyMenu(): Component {
  const set: Int = useServerState(TrophyVarps.SET);
  let chosen: Int = 0;
  if (set === TrophySet.SLAYER || set === TrophySet.FISHING) {
    chosen = 1;
  }

  const content: Int =
    chosen === 1
      ? Math.max(
          Math.max(Layout.MIN_CONTENT, bandCount(set, Band.BASIC_MIN, Band.BASIC_MAX) * Layout.STRIDE),
          Math.max(
            bandCount(set, Band.SUPERIOR_MIN, Band.SUPERIOR_MAX) * Layout.STRIDE,
            bandCount(set, Band.SUPERLATIVE_MIN, Band.SUPERLATIVE_MAX) * Layout.STRIDE,
          ),
        )
      : Layout.MIN_CONTENT;

  return (
    <layer x="center" y="center" w={content + Layout.PANEL_PADDING} h={Layout.PANEL_HEIGHT}>
      <SteelBorderEntrypoint title="Mounted Trophies" />

      {chosen === 1 && (
        <layer
          x="center"
          y={{ bottom: Layout.RACK_BOTTOM }}
          w={{ fill: Layout.RACK_INSET_X }}
          h={{ fill: Layout.RACK_INSET_Y }}
        >
          <layer x="center" y="top" w="fill" h={Layout.ROW_HEIGHT}>
            <TrophyRow tier={1} title="Basic trophies" min={Band.BASIC_MIN} max={Band.BASIC_MAX} />
          </layer>
          <layer x="center" y="center" w="fill" h={Layout.ROW_HEIGHT}>
            <TrophyRow tier={2} title="Superior trophies" min={Band.SUPERIOR_MIN} max={Band.SUPERIOR_MAX} />
          </layer>
          <layer x="center" y="bottom" w="fill" h={Layout.ROW_HEIGHT}>
            <TrophyRow tier={3} title="Superlative trophies" min={Band.SUPERLATIVE_MIN} max={Band.SUPERLATIVE_MAX} />
          </layer>
        </layer>
      )}
    </layer>
  );
}
