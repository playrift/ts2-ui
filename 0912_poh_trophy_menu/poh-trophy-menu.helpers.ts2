import { Trophies, TROPHY_COUNT, Trophy } from './trophies.data';

export function bandCount(set: Int, min: Int, max: Int): Int {
  let found: Int = 0;
  let i: Int = 0;
  while (i < TROPHY_COUNT) {
    const trophy: Trophy | null = Trophies.at(i);
    const trophySet: Int = trophy === null ? -1 : trophy.set;
    const level: Int = trophy === null ? -1 : trophy.level;
    if (trophySet === set && level >= min && level < max) {
      found = found + 1;
    }
    i = i + 1;
  }
  return found;
}
