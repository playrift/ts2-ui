import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  SUBHEADER_PLACEHOLDER,
  VALUE_PLACEHOLDER,
  YamaArt,
  YamaColor,
  YamaFonts,
  YamaModel,
} from './yama-scoreboard.constants';

export function YamaScoreboard(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={YamaModel.BACKDROP}
        zoom={Camera.ZOOM}
        pitch={Camera.PITCH}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={YamaArt.CLOSE_REST}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, YamaArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, YamaArt.CLOSE_LEAVE);
          }}
        />
      </layer>

      <layer x="center" y={Layout.PANEL_Y} w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_W_INSET }} h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.TITLE_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.HEADING}
            align="center"
            shadow
            text="Yama Statistics"
          />
        </layer>

        <layer
          x="center"
          y={{ bottom: Layout.BODY_BAND_BOTTOM }}
          w={{ fill: Layout.BODY_BAND_W_INSET }}
          h={Layout.BODY_BAND_H}
        >
          <text
            x={{ center: Layout.COL_1 }}
            y={Layout.PERSONAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Personal Killcount"
          />
          <text
            x={{ center: Layout.COL_1 }}
            y={Layout.PERSONAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x="center"
            y={Layout.PERSONAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Personal Deaths"
          />
          <text
            x="center"
            y={Layout.PERSONAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={{ center: Layout.COL_3 }}
            y={Layout.PERSONAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Personal Best Time"
          />
          <text
            x={{ center: Layout.COL_3 }}
            y={Layout.PERSONAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={{ center: Layout.COL_1 }}
            y={Layout.GLOBAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Global Killcount"
          />
          <text
            x={{ center: Layout.COL_1 }}
            y={Layout.GLOBAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x="center"
            y={Layout.GLOBAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Global Deaths"
          />
          <text
            x="center"
            y={Layout.GLOBAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={{ center: Layout.COL_3 }}
            y={Layout.GLOBAL_LABEL}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text="Global Best Time"
          />
          <text
            x={{ center: Layout.COL_3 }}
            y={Layout.GLOBAL_VALUE}
            w={Layout.STAT_W}
            h={Layout.LABEL_H}
            font={YamaFonts.VALUE}
            color={YamaColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x="center"
            y={Layout.SUBHEADER_Y}
            w={Layout.TITLE_W}
            h={Layout.LABEL_H}
            font={YamaFonts.HEADING}
            color={YamaColor.HEADING}
            align="center"
            shadow
            text={SUBHEADER_PLACEHOLDER}
          />
        </layer>
      </layer>
    </>
  );
}
