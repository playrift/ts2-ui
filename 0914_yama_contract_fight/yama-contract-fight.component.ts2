import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { Layout, YamaColor, YamaContentType, YamaDodge, YamaFont, YamaModel } from './yama-contract-fight.constants';

const timerHost = createRef('0914_yama_contract_fight_timer_host');

const contents = createRef('yama_contract_fight_contents');

export function YamaContractFight_(): Component {
  useInterval(() => overlayRelayout(timerHost, contents, YamaDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" w="fill" h="fill" contentType={YamaContentType.CONTRACT_FIGHT}>
      <layer x="center" w="fill" h="fill" ref={timerHost}>
        <layer ref={contents} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <text
            x={Layout.LABEL_X}
            y={Layout.LABEL_Y}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={YamaFont.LABEL}
            text="Contract X"
            valign="middle"
            shadow
            color={YamaColor.CONTRACT}
          />

          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={YamaModel.SIGIL}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
            orthogonal
          />
        </layer>
      </layer>
    </layer>
  );
}
