import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { Layout, YamaArt, YamaColors, YamaContent, YamaFonts, YamaModels, YamaText } from './yama-contract.constants';

export function YamaContract(): Component {
  return (
    <layer x="center" y={0} w="fill" h="fill" contentType={YamaContent.UNIVERSE}>
      <model
        x="center"
        y="center"
        w={Layout.SCROLL}
        h={Layout.SCROLL}
        model={YamaModels.SCROLL}
        pitch={Layout.SCROLL_PITCH}
        zoom={Layout.SCROLL_ZOOM}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_BOX}
        h={Layout.CLOSE_BOX}
        options={['Close']}
        onOptionSelect={() => {
          closeInterface();
        }}
      >
        <sprite
          x={Layout.ICON_X}
          y={Layout.ICON_Y}
          w={Layout.ICON_W}
          h={Layout.ICON_H}
          sprite={YamaArt.CLOSE}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, YamaArt.CLOSE_HOVER)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, YamaArt.CLOSE)}
        />
      </layer>

      <layer x="center" y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <layer x="center" y={0} w="fill" h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.HEADING_W}
            h="fill"
            text={YamaText.TERMS_HEADING}
            font={YamaFonts.LABEL}
            color={YamaColors.HEADING}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer x="center" y={Layout.TERMS_BAND_Y} w="fill" h={Layout.TERMS_BAND_H}>
          <text
            x="center"
            y={Layout.TERM_1_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
          <text
            x="center"
            y={Layout.TERM_2_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
          <text
            x="center"
            y={Layout.TERM_3_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
          <text
            x="center"
            y={Layout.TERM_4_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
          <text
            x="center"
            y={Layout.TERM_5_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
          <text
            x="center"
            y={Layout.TERM_6_Y}
            w="fill"
            h={Layout.TERM_H}
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer x="center" y={{ bottom: Layout.REWARDS_BAND_BOTTOM }} w="fill" h={Layout.REWARDS_BAND_H}>
          <text
            x="center"
            y={{ center: Layout.REWARD_HEADING_DY }}
            w={Layout.HEADING_W}
            h="fill"
            text={YamaText.REWARD_HEADING}
            font={YamaFonts.LABEL}
            color={YamaColors.HEADING}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer x="center" y={Layout.REWARD_BAND_Y} w="fill" h={Layout.REWARD_BAND_H}>
          <text
            x="center"
            y={0}
            w="fill"
            h="fill"
            font={YamaFonts.LABEL}
            color={YamaColors.BODY}
            align="center"
            valign="middle"
            shadow
          />
        </layer>
      </layer>
    </layer>
  );
}
