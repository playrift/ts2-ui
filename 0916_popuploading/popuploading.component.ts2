import { Fonts } from '../lib/game/fonts';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';

enum PopupColor {
  DIM = 0x000000,
  LABEL = 0xffffff,
}

export function PopupLoading(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w="fill" h="fill">
        <rect x="center" y="center" w="fill" h="fill" fill color={PopupColor.DIM} transparency={255} />

        <layer x="center" y="center" w={200} h={200}>
          <layer x="center" y="center" w="fill" h="fill" />

          <layer x="center" y={{ bottom: 10 }} w={{ fill: 20 }} h={{ fill: 20 }}>
            <ThinBoxEntrypoint />

            <layer x="center" y={0} w="fill" h={{ fill: 21 }} />

            <text
              x="center"
              y={{ bottom: 0 }}
              w="fill"
              h={21}
              font={Fonts.P12_FULL}
              color={PopupColor.LABEL}
              shadow
              align="center"
              valign="middle"
            />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
