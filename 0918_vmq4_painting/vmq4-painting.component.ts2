import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { MURAL_STARS, MuralArt, MuralCamera, MuralLayout, MuralModels, STAR_COLOR } from './vmq4-painting.constants';

export function Vmq4Painting(): Component {
  return (
    <layer x="center" y="center" w={MuralLayout.PANEL.W} h={MuralLayout.PANEL.H}>
      <layer w={MuralLayout.PANEL.W} h={MuralLayout.PANEL.H}>
        {MURAL_STARS.map((star) => (
          <rect x={star.X} y={star.Y} w={star.W} h={star.H} color={STAR_COLOR} fill />
        ))}
      </layer>

      <model
        x={MuralLayout.MURAL.X}
        y={MuralLayout.MURAL.Y}
        w={MuralLayout.MURAL.W}
        h={MuralLayout.MURAL.H}
        model={MuralModels.MURAL}
        zoom={MuralCamera.ZOOM}
        offsetY={MuralCamera.OFFSET_Y}
      />

      <sprite
        x={{ right: MuralLayout.CLOSE.RIGHT }}
        y={MuralLayout.CLOSE.Y}
        w={MuralLayout.CLOSE.W}
        h={MuralLayout.CLOSE.H}
        sprite={MuralArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => {
          graphicSwapperUnlessMobile(event.component, MuralArt.CLOSE_HOVER);
        }}
        onMouseLeave={(event) => {
          graphicSwapperUnlessMobile(event.component, MuralArt.CLOSE);
        }}
      />
    </layer>
  );
}
