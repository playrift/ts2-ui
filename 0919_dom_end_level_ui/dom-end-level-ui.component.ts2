import { DomColors, DomFonts, DomLayout, DomOptions, DomSprites, DomText } from './dom-end-level-ui.constants';

export function DomEndLevelUi(): Component {
  return (
    <layer x="center" y="center" w={DomLayout.PANEL_W} h={DomLayout.PANEL_H} noClickThrough>
      <layer x={0} y={0} w="fill" h="fill" />

      <layer
        x="center"
        y={{ bottom: DomLayout.CONTENT_BOTTOM }}
        w={{ fill: DomLayout.CONTENT_INSET_X }}
        h={{ fill: DomLayout.CONTENT_INSET_Y }}
      >
        <layer x="center" y={DomLayout.UPPER_Y} w={{ fill: DomLayout.UPPER_INSET_X }} h={DomLayout.UPPER_H}>
          <layer x="center" y={DomLayout.LOOT_Y} w="fill" h={{ fill: DomLayout.LOOT_INSET_Y }}>
            <sprite x={0} y={0} w="fill" h="fill" sprite={DomSprites.PANE_BACKING} tiling />
            <layer x={0} y={0} w="fill" h="fill" />
            <layer
              x="center"
              y={DomLayout.GRID_Y}
              w={{ fill: DomLayout.GRID_INSET_X }}
              h={{ fill: DomLayout.GRID_INSET_Y }}
            />
            <text
              x={{ right: DomLayout.AMOUNT_RIGHT }}
              y={{ bottom: DomLayout.AMOUNT_BOTTOM }}
              w={{ fill: DomLayout.AMOUNT_INSET_X }}
              h={DomLayout.AMOUNT_H}
              text={DomText.AMOUNT}
              font={DomFonts.AMOUNT}
              color={DomColors.BODY}
              shadow
              align="center"
              valign="middle"
            />
          </layer>

          <layer x={0} y={0} w="fill" h={DomLayout.ROW_H}>
            <text
              x={0}
              y="bottom"
              w={DomLayout.EARNED_W}
              h="fill"
              text={DomText.EARNED}
              font={DomFonts.HEADING}
              color={DomColors.HEADING}
              shadow
              valign="middle"
            />
            <text
              x={DomLayout.EARNED_BODY_X}
              y="bottom"
              w={DomLayout.EARNED_BODY_W}
              h="fill"
              text={DomText.EARNED_BODY}
              font={DomFonts.BODY}
              color={DomColors.BODY}
              shadow
              valign="middle"
            />
          </layer>

          <layer x={0} y={0} w="fill" h={DomLayout.ROW_H}>
            <text
              x={0}
              y="bottom"
              w={DomLayout.CLAIM_W}
              h="fill"
              text={DomText.CLAIM}
              font={DomFonts.HEADING}
              color={DomColors.HEADING}
              shadow
              valign="middle"
            />
          </layer>

          <layer x="right" y="bottom" w="fill" h={DomLayout.BUTTON_ROW_H}>
            <layer x="right" y={0} w={DomLayout.BUTTON_W} h="fill" options={[DomOptions.PLACEHOLDER]} />
          </layer>

          <layer x={0} y="bottom" w="fill" h={DomLayout.BUTTON_ROW_H}>
            <layer x="center" y={0} w={DomLayout.BUTTON_W} h="fill" options={[DomOptions.PLACEHOLDER]} />
            <layer x="right" y={0} w={DomLayout.SMALL_BUTTON_W} h="fill" options={[DomOptions.TAKE_ALL]} />
            <layer
              x={{ right: DomLayout.BANK_ALL_RIGHT }}
              y={0}
              w={DomLayout.SMALL_BUTTON_W}
              h="fill"
              options={[DomOptions.BANK_ALL]}
            />
          </layer>
        </layer>

        <layer x="center" y={DomLayout.LOWER_Y} w={{ fill: DomLayout.UPPER_INSET_X }} h={DomLayout.LOWER_H}>
          <layer x="center" y={DomLayout.DELVE_PANE_Y} w="fill" h={{ fill: DomLayout.DELVE_PANE_INSET_Y }} />
          <layer
            x="center"
            y={{ bottom: DomLayout.DELVE_BUTTON_BOTTOM }}
            w={DomLayout.BUTTON_W}
            h={DomLayout.BUTTON_ROW_H}
            options={[DomOptions.PLACEHOLDER]}
          />
          <text
            x={0}
            y={0}
            w={DomLayout.DELVE_LABEL_W}
            h={DomLayout.ROW_H}
            text={DomText.DELVE}
            font={DomFonts.HEADING}
            color={DomColors.HEADING}
            shadow
            valign="middle"
          />
          <text
            x={DomLayout.DELVE_BODY_X}
            y={0}
            w={DomLayout.DELVE_BODY_W}
            h={DomLayout.ROW_H}
            text={DomText.DELVE_BODY}
            font={DomFonts.BODY}
            color={DomColors.BODY}
            shadow
            valign="middle"
          />
        </layer>
      </layer>

      <layer x="center" y="center" w="fill" h="fill" />
    </layer>
  );
}
