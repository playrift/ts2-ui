import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  DomArt,
  DomColor,
  DomFonts,
  DomModel,
  GENERAL_ROW_H,
  GENERAL_ROW_W,
  GENERAL_VALUE_DY,
  GeneralRows,
  Layout,
  LevelRows,
  RULE_WIDTH,
  TableLayout,
  VALUE_PLACEHOLDER,
} from './dom-scoreboard.constants';

export function DomScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_SIZE}
        h={Layout.MODEL_SIZE}
        model={DomModel.BACKDROP}
        zoom={Camera.ZOOM}
      />

      <layer
        x={{ center: Layout.CONTENT_X_OFFSET }}
        y={{ center: Layout.CONTENT_Y_OFFSET }}
        w={Layout.CONTENT_W}
        h={Layout.CONTENT_H}
      >
        <layer
          x={{ center: Layout.GENERAL_X_OFFSET }}
          y={{ center: Layout.GENERAL_Y_OFFSET }}
          w={Layout.GENERAL_W}
          h={Layout.GENERAL_H}
          hide
        >
          {GeneralRows.map((row) => (
            <>
              <text
                x={row.x}
                y={row.y}
                w={GENERAL_ROW_W}
                h={GENERAL_ROW_H}
                text={row.heading}
                font={DomFonts.HEADING}
                color={DomColor.GOLD}
                align="center"
                shadow
              />
              <text
                x={row.x}
                y={row.y + GENERAL_VALUE_DY}
                w={GENERAL_ROW_W}
                h={GENERAL_ROW_H}
                text={VALUE_PLACEHOLDER}
                font={DomFonts.BODY}
                color={DomColor.GOLD}
                align="center"
                shadow
              />
            </>
          ))}
        </layer>

        <layer x={Layout.LEVELS_X} y={{ center: Layout.LEVELS_Y_OFFSET }} w={Layout.LEVELS_W} h={Layout.LEVELS_H}>
          <layer w="fill" h="fill">
            <text
              x={TableLayout.TITLE_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.TITLE_W}
              h={TableLayout.ROW_H}
              text="Personal"
              font={DomFonts.HEADING}
              color={DomColor.GOLD}
              align="center"
              shadow
            />
            <text
              x={TableLayout.COMPLETIONS_HEADER_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.COMPLETIONS_HEADER_W}
              h={TableLayout.ROW_H}
              text="Completions"
              font={DomFonts.BODY}
              color={DomColor.GOLD}
              align="center"
              shadow
            />
            <text
              x={TableLayout.PERSONAL_TIMES_HEADER_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.TIMES_HEADER_W}
              h={TableLayout.ROW_H}
              text="Times"
              font={DomFonts.BODY}
              color={DomColor.TIME}
              align="center"
              shadow
            />

            <text
              x={TableLayout.PERSONAL_LABEL_X}
              y={TableLayout.PERSONAL_TOTAL_Y}
              w={TableLayout.PERSONAL_LABEL_W}
              h={TableLayout.ROW_H}
              text="Total"
              font={DomFonts.BODY}
              color={DomColor.GOLD}
              valign="middle"
              shadow
            />
            <text
              x={TableLayout.PERSONAL_VALUE_X}
              y={TableLayout.PERSONAL_TOTAL_Y}
              w={TableLayout.VALUE_W}
              h={TableLayout.ROW_H}
              text={VALUE_PLACEHOLDER}
              font={DomFonts.BODY}
              color={DomColor.GOLD}
              align="center"
              valign="middle"
              shadow
            />

            {LevelRows.map((row) => (
              <>
                <text
                  x={TableLayout.PERSONAL_LABEL_X}
                  y={row.y}
                  w={TableLayout.PERSONAL_LABEL_W}
                  h={TableLayout.ROW_H}
                  text={row.label}
                  font={DomFonts.BODY}
                  color={DomColor.GOLD}
                  valign="middle"
                  shadow
                />
                <text
                  x={TableLayout.PERSONAL_VALUE_X}
                  y={row.y}
                  w={TableLayout.VALUE_W}
                  h={TableLayout.ROW_H}
                  text={VALUE_PLACEHOLDER}
                  font={DomFonts.BODY}
                  color={DomColor.GOLD}
                  align="center"
                  valign="middle"
                  shadow
                />
                <text
                  x={TableLayout.PERSONAL_TIME_X}
                  y={row.y}
                  w={TableLayout.VALUE_W}
                  h={TableLayout.ROW_H}
                  text={VALUE_PLACEHOLDER}
                  font={DomFonts.BODY}
                  color={DomColor.TIME}
                  align="center"
                  valign="middle"
                  shadow
                />
              </>
            ))}
          </layer>

          <layer x={Layout.GLOBAL_X} w={{ fill: Layout.GLOBAL_W_INSET }} h="fill">
            <text
              x={TableLayout.TITLE_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.TITLE_W}
              h={TableLayout.ROW_H}
              text="Global"
              font={DomFonts.HEADING}
              color={DomColor.GOLD}
              align="center"
              shadow
            />
            <text
              x={TableLayout.COMPLETIONS_HEADER_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.COMPLETIONS_HEADER_W}
              h={TableLayout.ROW_H}
              text="Completions"
              font={DomFonts.BODY}
              color={DomColor.GOLD}
              align="center"
              shadow
            />
            <text
              x={TableLayout.GLOBAL_TIMES_HEADER_X}
              y={TableLayout.TITLE_Y}
              w={TableLayout.TIMES_HEADER_W}
              h={TableLayout.ROW_H}
              text="Times"
              font={DomFonts.BODY}
              color={DomColor.TIME}
              align="center"
              shadow
            />

            {LevelRows.map((row) => (
              <>
                <text
                  x={TableLayout.GLOBAL_LABEL_X}
                  y={row.y}
                  w={TableLayout.GLOBAL_LABEL_W}
                  h={TableLayout.ROW_H}
                  text={row.label}
                  font={DomFonts.BODY}
                  color={DomColor.GOLD}
                  shadow
                />
                <text
                  x={TableLayout.GLOBAL_VALUE_X}
                  y={row.y}
                  w={TableLayout.VALUE_W}
                  h={TableLayout.ROW_H}
                  text={VALUE_PLACEHOLDER}
                  font={DomFonts.BODY}
                  color={DomColor.GOLD}
                  align="center"
                  valign="middle"
                  shadow
                />
                <text
                  x={TableLayout.GLOBAL_TIME_X}
                  y={row.y}
                  w={TableLayout.VALUE_W}
                  h={row.lastTime === 1 ? TableLayout.GLOBAL_LAST_TIME_H : TableLayout.ROW_H}
                  text={VALUE_PLACEHOLDER}
                  font={DomFonts.BODY}
                  color={DomColor.TIME}
                  align="center"
                  valign="middle"
                  shadow
                />
              </>
            ))}
          </layer>

          <line
            x={Layout.RULE_V_X}
            y={Layout.RULE_V_Y}
            w={0}
            h={Layout.RULE_V_H}
            color={DomColor.RULE}
            lineWidth={RULE_WIDTH}
          />

          <line
            x={Layout.RULE_H_X}
            y={Layout.RULE_H_Y}
            w={{ fill: Layout.RULE_H_W_INSET }}
            h={0}
            color={DomColor.RULE}
            lineWidth={RULE_WIDTH}
          />
        </layer>
      </layer>

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_SIZE}
        h={Layout.CLOSE_SIZE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={DomArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, DomArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, DomArt.CLOSE);
          }}
        />

        <sprite w={Layout.CLOSE_SIZE} h={Layout.CLOSE_SIZE} />
      </layer>
    </>
  );
}
