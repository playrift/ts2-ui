import { CloseButton } from '../0883_mm_formulas/close-button.component';
import { JigsawBacking, JigsawPreview, JigsawPreviewButton, JigsawShuffleButton } from './jigsaw-buttons.component';
import { ScrambledPieces, SolvedPieces } from './jigsaw-pieces.component';
import { JigsawArt, JigsawColor, JigsawLayout, scrambledLayer } from './jigsaw.constants';

export function Jigsaw(): Component {
  return (
    <>
      <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H}>
        <model
          x="center"
          y={0}
          w="fill"
          h="fill"
          model={JigsawLayout.BACKDROP_MODEL}
          zoom={JigsawLayout.BACKDROP_ZOOM}
          offsetY={JigsawLayout.BACKDROP_OFFSET_Y}
        />
        <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H}>
          <JigsawBacking />
        </layer>
      </layer>

      <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H} />

      <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H}>
        <SolvedPieces />
      </layer>

      <layer static ref={scrambledLayer} w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H}>
        <model
          x={JigsawLayout.SLOT_8_X}
          y={JigsawLayout.SLOT_8_Y}
          w={JigsawLayout.SLOT_SIZE}
          h={JigsawLayout.SLOT_SIZE}
          zoom={JigsawLayout.SLOT_ZOOM}
        />
        <model
          x={JigsawLayout.SLOT_9_X}
          y={JigsawLayout.SLOT_9_Y}
          w={JigsawLayout.SLOT_SIZE}
          h={JigsawLayout.SLOT_SIZE}
          zoom={JigsawLayout.SLOT_ZOOM}
        />
        <ScrambledPieces />
      </layer>

      <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H} hide noClickThrough>
        <rect w="fill" h="fill" color={JigsawColor.DIM} fill transparency={JigsawLayout.DIM_TRANSPARENCY} />
        <model
          x={JigsawLayout.PREVIEW_DEF_X}
          y={JigsawLayout.PREVIEW_DEF_Y}
          w={JigsawLayout.SLOT_SIZE}
          h={JigsawLayout.SLOT_SIZE}
          model={JigsawLayout.PREVIEW_DEF_MODEL}
          zoom={JigsawLayout.PREVIEW_DEF_ZOOM}
          orthogonal
          hide
        />
      </layer>
      <JigsawPreview />

      <layer
        x={JigsawLayout.BUTTON_X}
        y={JigsawLayout.PREVIEW_BUTTON_Y}
        w={JigsawLayout.BUTTON_SIZE}
        h={JigsawLayout.BUTTON_SIZE}
        noClickThrough
      >
        <JigsawPreviewButton />
      </layer>

      <layer
        x={JigsawLayout.BUTTON_X}
        y={JigsawLayout.SHUFFLE_BUTTON_Y}
        w={JigsawLayout.BUTTON_SIZE}
        h={JigsawLayout.BUTTON_SIZE}
        noClickThrough
      >
        <JigsawShuffleButton />
      </layer>

      <layer
        x={{ right: JigsawLayout.CLOSE_RIGHT }}
        y={JigsawLayout.CLOSE_Y}
        w={JigsawLayout.CLOSE_SIZE}
        h={JigsawLayout.CLOSE_SIZE}
      >
        <CloseButton w={JigsawLayout.CLOSE_SKIN_W} h={JigsawLayout.CLOSE_SKIN_H} />
      </layer>

      <layer w={JigsawLayout.BOARD_W} h={JigsawLayout.BOARD_H}>
        <sprite
          x={{ right: JigsawLayout.BORDER_SIDE_OUT }}
          y={JigsawLayout.BORDER_EDGE_X}
          w={JigsawLayout.BORDER_CORNER}
          h={{ fill: JigsawLayout.BORDER_EDGE_INSET }}
          sprite={JigsawArt.EDGE_RIGHT}
          tiling
        />
        <sprite
          x="right"
          y="bottom"
          w={JigsawLayout.BORDER_CORNER}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.CORNER_BR}
        />
        <sprite
          x="right"
          y={0}
          w={JigsawLayout.BORDER_CORNER}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.CORNER_TR}
        />
        <sprite
          x={JigsawLayout.BORDER_EDGE_X}
          y={JigsawLayout.BORDER_TOP_OUT}
          w={{ fill: JigsawLayout.BORDER_EDGE_INSET }}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.EDGE_TOP}
        />
        <sprite
          x={JigsawLayout.BORDER_EDGE_X}
          y={{ bottom: JigsawLayout.BORDER_BOTTOM_OUT }}
          w={{ fill: JigsawLayout.BORDER_EDGE_INSET }}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.EDGE_BOTTOM}
        />
        <sprite
          x={JigsawLayout.BORDER_SIDE_OUT_LEFT}
          y={JigsawLayout.BORDER_EDGE_X}
          w={JigsawLayout.BORDER_CORNER}
          h={{ fill: JigsawLayout.BORDER_EDGE_INSET }}
          sprite={JigsawArt.EDGE_LEFT}
          tiling
        />
        <sprite
          x={0}
          y={0}
          w={JigsawLayout.BORDER_CORNER}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.CORNER_TL}
        />
        <sprite
          x={0}
          y="bottom"
          w={JigsawLayout.BORDER_CORNER}
          h={JigsawLayout.BORDER_CORNER}
          sprite={JigsawArt.CORNER_BL}
        />
      </layer>
    </>
  );
}
