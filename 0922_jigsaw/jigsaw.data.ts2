};

export type JigsawPuzzle = {
  pieces: List<JigsawPiece>;
  startPoints: List<JigsawPoint>;
  backing: Model;
  pieceName: String;
  pieceZoom: Int;
  pieceWidth: Int;
  pieceHeight: Int;
  previewModel: Model;
  previewX: Int;
  previewY: Int;
  previewZoom: Int;
};

