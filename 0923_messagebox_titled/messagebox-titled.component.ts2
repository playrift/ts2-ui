import { Fonts } from '../lib/game/fonts';

const LABEL = Fonts.Q8_FULL;

enum ChatColors {
  TITLE = 0x800000,
  CONTINUE = 0x0000ff,
  CONTINUE_HOVER = 0xffffff,
  BODY = 0x000000,
}

export function MessageBoxTitled(): Component {
  return (
    <layer x={{ center: 1 }} y="center" w={506} h={129}>
      <layer x={{ center: -1 }} y={{ center: 1 }} w={481} h={110}>
        <layer x="center" y="center" w={479} h={96}>
          <text x="center" y={0} w="fill" h={17} font={LABEL} color={ChatColors.TITLE} align="center" />
          <text
            x="center"
            y={80}
            w="fill"
            h={17}
            font={LABEL}
            color={ChatColors.CONTINUE}
            align="center"
            continueOp
            hover={{ color: ChatColors.CONTINUE_HOVER }}
          />
          <text x="center" y={16} w="fill" h={67} font={LABEL} color={ChatColors.BODY} align="center" lineHeight={16} />
        </layer>
      </layer>
    </layer>
  );
}
