import { WelcomeColors, WelcomeCopy, WelcomeFonts, WelcomeLayout, WelcomeSprites } from './bingo-welcome.constants';
import { SteelBorderNoClose } from './steel-border-noclose.component';
import { WelcomeButton } from './welcome-button.component';

export function BingoWelcome(): Component {
  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <layer x="center" y="center" w={WelcomeLayout.PANEL_WIDTH} h={WelcomeLayout.PANEL_HEIGHT}>
        <layer w="fill" h="fill">
          <SteelBorderNoClose title={WelcomeCopy.TITLE} />

          <sprite
            x={WelcomeLayout.RELIC_18_X}
            y={WelcomeLayout.RELIC_18_Y}
            w={WelcomeLayout.RELIC_SIZE}
            h={WelcomeLayout.RELIC_SIZE}
            sprite={WelcomeSprites.RELIC_18}
          />
          <sprite
            x={WelcomeLayout.RELIC_10_X}
            y={WelcomeLayout.RELIC_10_Y}
            w={WelcomeLayout.RELIC_SIZE}
            h={WelcomeLayout.RELIC_SIZE}
            sprite={WelcomeSprites.RELIC_10}
          />
          <sprite
            x={WelcomeLayout.MASTERY_X}
            y={WelcomeLayout.MASTERY_Y}
            w={WelcomeLayout.MASTERY_SIZE}
            h={WelcomeLayout.MASTERY_SIZE}
            sprite={WelcomeSprites.MASTERY}
          />
          <sprite
            x={WelcomeLayout.COMPASS_X}
            y={WelcomeLayout.COMPASS_Y}
            w={WelcomeLayout.COMPASS_SIZE}
            h={WelcomeLayout.COMPASS_SIZE}
            sprite={WelcomeSprites.COMPASS_ROSE}
          />

          <text
            x={WelcomeLayout.TEXT_X}
            y={WelcomeLayout.TEXT_TOP_Y}
            w={{ fill: WelcomeLayout.PAGE1_TEXT_INSET }}
            h={WelcomeLayout.TEXT_TOP_HEIGHT}
            text={WelcomeCopy.PAGE1_TOP}
            font={WelcomeFonts.BODY}
            color={WelcomeColors.BODY}
            shadow
            lineHeight={WelcomeLayout.LINE_HEIGHT}
          />
          <text
            x={WelcomeLayout.TEXT_X}
            y={WelcomeLayout.TEXT_BOTTOM_Y}
            w={{ fill: WelcomeLayout.PAGE1_TEXT_INSET }}
            h={WelcomeLayout.TEXT_BOTTOM_HEIGHT}
            text={WelcomeCopy.PAGE1_BOTTOM}
            font={WelcomeFonts.BODY}
            color={WelcomeColors.BODY}
            shadow
            lineHeight={WelcomeLayout.LINE_HEIGHT}
          />

          <WelcomeButton
            label={WelcomeCopy.START}
            width={WelcomeLayout.START_WIDTH}
            offset={WelcomeLayout.START_OFFSET}
          />
          <WelcomeButton label={WelcomeCopy.EXIT} width={WelcomeLayout.EXIT_WIDTH} offset={WelcomeLayout.EXIT_OFFSET} />
        </layer>

        <layer w={WelcomeLayout.PANEL_WIDTH} h={WelcomeLayout.PAGE2_HEIGHT} hide>
          <SteelBorderNoClose title={WelcomeCopy.TITLE} />

          <layer x={WelcomeLayout.ORB_X} y={WelcomeLayout.ORB_Y} w={WelcomeLayout.ORB_SIZE} h={WelcomeLayout.ORB_SIZE}>
            <sprite
              x="center"
              y="center"
              w={WelcomeLayout.ORB_RING_W}
              h={WelcomeLayout.ORB_RING_H}
              sprite={WelcomeSprites.ORB_RING}
            />
            <sprite
              x="center"
              y="center"
              w={WelcomeLayout.ORB_ICON_W}
              h={WelcomeLayout.ORB_ICON_H}
              sprite={WelcomeSprites.ORB_ICON}
            />
          </layer>

          <text
            x={WelcomeLayout.TEXT_X}
            y={WelcomeLayout.TEXT_TOP_Y}
            w={{ fill: WelcomeLayout.PAGE2_TEXT_INSET }}
            h={WelcomeLayout.PAGE2_TOP_HEIGHT}
            text={WelcomeCopy.PAGE2_TOP}
            font={WelcomeFonts.BODY}
            color={WelcomeColors.BODY}
            shadow
            lineHeight={WelcomeLayout.LINE_HEIGHT}
          />
          <text
            x={WelcomeLayout.TEXT_X}
            y={WelcomeLayout.TEXT_BOTTOM_Y}
            w={{ fill: WelcomeLayout.PAGE2_TEXT_INSET }}
            h={WelcomeLayout.TEXT_BOTTOM_HEIGHT}
            text={WelcomeCopy.PAGE2_BOTTOM}
            font={WelcomeFonts.BODY}
            color={WelcomeColors.BODY}
            shadow
          />
        </layer>
      </layer>
    </>
  );
}
