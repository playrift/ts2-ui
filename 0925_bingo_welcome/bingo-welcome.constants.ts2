export const WelcomeCopy = {
  PAGE1_TOP:
    "Grid Master is a time-limited game mode that gives you a new way to experience the world of Gielinor. While playing you'll be using a separate character to usual worlds and you'll only be able to play this character on a Grid Master world, in the same vein as other game modes such as Leagues and Deadman.",
  PAGE1_BOTTOM:
    'The aim of Grid Master is to complete <col=ffffff>Challenges</col> to earn <col=ffffff>Powerups</col>, <col=ffffff>Rewards</col> & <col=ffffff>Grid Points</col>. These Grid Points can then be exchanged for various unlocks and rewards in the main game. To begin your journey to becoming a Grid Master, use the Get Started button below. Otherwise you can use the Exit button to logout.',
  PAGE2_TOP:
    "The Grid holds all information about Grid Masters, but importantly:<br><br>- What <col=ffffff>Challenges</col> you need to complete<br>- What <col=ffffff>Powerups</col> you can and have unlocked<br>- How many <col=ffffff>Grid Points</col> you've earned",
  PAGE2_BOTTOM: "To access the grid, you'll want to select its orb on your interface.",
  TITLE: 'Welcome to Grid Master!',
  START: 'Get Started',
