import { CS2, useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { WelcomeColors, WelcomeFonts, WelcomeLayout } from './bingo-welcome.constants';

export function WelcomeButton({ label, width, offset }: { label: String; width: Int; offset: Int }): Component {
  const mobile: Boolean = onMobile();
  const [pressed, setPressed] = useState(0);

  const op: String = CS2.tags_remove(label);

  return (
    <layer
      x={{ center: offset }}
      y={{ bottom: WelcomeLayout.BUTTON_BOTTOM }}
      w={width}
      h={WelcomeLayout.BUTTON_HEIGHT}
      options={[op]}
      onMouseRepeat={() => {
        if (!mobile) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => {
        if (!mobile) {
          setPressed(0);
        }
      }}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}

      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={label}
        font={WelcomeFonts.BODY}
        color={WelcomeColors.LABEL}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}
