export const BINGO_XP_SKILL_DEFAULT = 'this skill';

export const enum BingoMastery {
  MELEE = 0,
  RANGED = 1,
  MAGIC = 2,
}

export const BingoMasteryNames = mapOf<BingoMastery, String>([
  [BingoMastery.MELEE, 'Melee Mastery'],
  [BingoMastery.RANGED, 'Ranged Mastery'],
  [BingoMastery.MAGIC, 'Magic Mastery'],
]);

export const BingoMeleeMasteryTiers = listOf<String>([
  '<col=0xffffff>Melee</col> hits have a 25% chance to roll damage twice and take the highest result.',
  '<col=0xffffff>Melee</col> hits have a 10% chance to generate an echo hit<br>(additional melee hit, 50% max-hit, respects Accuracy, PvM only).',
  '<col=0xffffff>Melee</col> attack rate set to 80%, rounding down.',
  '<col=0xffffff>Melee</col> hits have a 5% chance to heal 40% of damage dealt.',
  '<col=0xffffff>Melee</col> attack rate set to 50%, rounded down above 5t, rounded up below 4t.',
  'Your chance to generate an echo increases to 20%, and your echoes can generate additional echoes (Up to 8 times in a row).',
]);

export const BingoRangedMasteryTiers = listOf<String>([
  'Damage rolls beneath 30% of max hit with <col=0xffffff>Ranged</col> are increased to 30%.',
  'Each subsequent <col=0xffffff>Ranged</col> attack has its max hit increased by an additional 5%. Resets after +20%.',
  '<col=0xffffff>Ranged</col> attack rate set to 80%, rounding down.',
  'Every 5th <col=0xffffff>Ranged</col> hit, heal 5 hitpoints.',
  '<col=0xffffff>Ranged</col> attack rate set to 50%, rounded down above 5t, rounded up below 4t.',
  'Never miss with <col=0xffffff>Ranged</col> (PvM only).',
]);

export const BingoMagicMasteryTiers = listOf<String>([
  'When you roll above 90% of your max hit with <col=0xffffff>Magic</col>, damage is increased by 50%.',
  '<col=0xffffff>Magic</col> max hit is increased by 5% per tick in-between your attacks (Up to +40%).',
  '<col=0xffffff>Magic</col> attack rate set to 80%, rounding down.',
  'When you roll above 90% of your max hit with <col=0xffffff>Magic</col>, heal 10% of damage dealt.',
  '<col=0xffffff>Magic</col> attack rate set to 50%, rounded down above 5t, rounded up below 4t.',
  'Max hit with <col=0xffffff>Magic</col> is increased by 1% for every 100 Hitpoints remaining on target (Up to 10%).<br>On a successful <col=0xffffff>Magic</col> hit, if your target has less health than your max hit, you max hit.',
]);

export const BingoMasteryTiers = mapOf<BingoMastery, List<String>>([
  [BingoMastery.MELEE, BingoMeleeMasteryTiers],
  [BingoMastery.RANGED, BingoRangedMasteryTiers],
  [BingoMastery.MAGIC, BingoMagicMasteryTiers],
]);

type BingoEventRelicRow = {
  relic: Int;
  index: Int;
  name: String;
  description: String;
};

export const BingoEventRelics = listOf<BingoEventRelicRow>([
  {
    relic: 1118,
    index: 2,
    name: 'Animal Wrangler',
    description:
      "- This harpoon will act as a non-degradable variant of the crystal equivalent with no requirements.<br><br>- When this item is in your inventory or equipped, you gain the following perks:<br><br>- On failing to fish a spot, you will have a separate 50% chance to succeed.<br><br>- Items gathered from Fishing are automatically sent to your Bank.<br><br>- Fish caught have a 50% chance to be automatically cooked, granting Cooking experience regardless of level requirements.<br><br>- Attempt to catch fish 1 tick faster.<br><br>- It will also work for fish that don't require a harpoon to be caught, and your harpoon can be substituted as a Net, Big Net, Lobster Pot, or any Rod whilst Fishing.<br><br>Alongside the Echo harpoon effects you will get the following perks to <col=#>Hunter</col>:<br><br>- Hunter catching will never fail.<br><br>- Box traps catch chinchompas faster.<br><br>- Chinchompas are doubled when caught, also giving double XP.<br><br>- Impling jars no longer break upon opening them.<br><br>Lastly, you never burn food when Cooking.",
  },
  {
    relic: 1121,
    index: 21,
    name: 'Bank Heist',
    description:
      "- This item will allow you to teleport to any <col=#>Deposit box</col>, <col=#>Bank</col>, or <col=#>Bank chest</col>.<br><br>- This item ignores wilderness teleport restrictions.<br><br>- This item cannot be used to teleport to an area you haven't unlocked.",
  },
  {
    relic: 4719,
    index: 8,
    name: "Banker's Note",
    description:
      "- This item will allow you to note and unnote items anywhere in Gielinor.<br><br>- You can manually use items on the Banker's Note to unnote or note them all, much like a Bank.<br><br>- The 'Activate' option allows you to note and unnote items in one action with a specified quantity. An object must first be used on the Banker's Note in order for this to work.<br><br>- You can customise how many items the Banker's note will note and unnote using the quantity options.",
  },
  {
    relic: 6263,
    index: 18,
    name: 'Bottomless Brew',
    description:
      'You gain the <col=#>Bottomless Brew</col> perk.<br>Potions will no longer be consumed when you drink them.',
  },
  {
    relic: 1120,
    index: 6,
    name: 'Clue Compass',
    description:
      "- This item will allow you to <col=#>Teleport</col> to any S.T.A.S.H unit and Falo the Bard (Respecting area unlocks).<br><br>- It has the ability to teleport you to your current clue step, if you have one. Note - this will not work on clue steps that require you to kill a certain NPC.<br><br>- This item ignores wilderness teleport restrictions.<br><br>- This item cannot be used to teleport to an area you haven't unlocked.",
  },
  {
    relic: 1123,
    index: 3,
    name: 'Corner Cutter',
    description:
      "- While equipped, Sage's Greaves will grant Agility XP based on your Agility level while you run.<br><br>- Completing an Agility course grants two completion count and 25% bonus XP.<br><br>- 100% success rate on all Agility checks.<br><br>- Marks of Grace will also spawn with 10,000 coins.<br><br>- Double Quantity of Pyramid Tops, Hallowed Marks and Agility Vouchers, and Crystal shards (from agility).",
  },
  {
    relic: 1125,
    index: 4,
    name: 'Dodgy Deals',
    description:
      'You gain the following perks to <col=#>Thieving</col>:<br><br>- Pickpocketing an NPC will also pickpocket all NPCs of similar type in a 11x11 square, granting extra loot for each NPC pickpocketed.<br><br>- 100% success rate on all Thieving checks.<br><br> - Automatically re-pickpocket an NPC or stall until you can no longer do so.<br><br>- Items obtained from pickpocketing are noted.<br><br>- Maximum coin pouch count increased by 3x.<br><br>- Stalls do not deplete when you steal from them.',
  },
  {
    relic: 6264,
    index: 23,
    name: 'Exposure',
    description: 'You gain the <col=#>Exposure</col> perk. Special attacks have a 50% chance to deal 50% more damage.',
  },
  {
    relic: 1725,
    index: 7,
    name: "Fairy's Flight",
    description:
      "- This item will allow you to <col=#>Teleport</col> to any fairy ring, spirit tree, or tool leprechaun.<br><br>- Unlocking this will autocomplete the Tree Gnome Village quest.<br><br>- This item ignores wilderness teleport restrictions.<br><br>- This item cannot be used to teleport to an area you haven't unlocked.",
  },
  {
    relic: 4722,
    index: 22,
    name: "Farmer's Fortune",
    description:
      '- You will harvest patches at a rate of up to 20x per action, noting any contents you receive.<br><br>- All patches will give 3x the yield.<br><br>- Farming patches grow instantly.<br><br>- Your plants will never die.<br><br>- You have a 20%~ chance to not use a seed or sapling when planting items in patches.',
  },
  {
    relic: 1124,
    index: 10,
    name: 'Friendly Forager',
    description:
      "While the <col=#>Forager's pouch</col> is worn or in your inventory, you gain the following benefits:<br><br>- When you gather resources from <col=#>Woodcutting</col>, <col=#>Fishing</col>, <col=#>Mining</col> and <col=#>Hunter</col>, the pouch will find and store a random grimy herb.<br><br>- This herb is limited to any which your <col=#>Herblore</col> level + 25 can clean. This action also provides a small amount of <col=#>Herblore</col> XP.<br><br>- The pouch will only find herbs it has room to store, but will always attempt to give you a herb you can receive.<br><br>- The pouch also functions as a <col=#>Silklined herb sack</col>, and shares an inventory with it.<br><br>Additionally, you gain the following perks to <col=#>Herblore</col>:<br>- All items are processed at once.</col><br>- Secondary ingredients have a 90% chance to not be consumed, this stacks additively with other sources.<br>- Potions created will have 4 doses instead of 3.",
  },
  {
    relic: 1131,
    index: 5,
    name: 'Golden God',
    description:
      'You gain the following perks to the <col=#>High and Low Alchemy spells</col>:<br><br>- The spells have no rune cost or level requirement.<br><br>- Items give 15% more gold, and have a 65% chance to not be consumed.<br><br>- When cast on a stack of items, the spells will automatically be recast over time, until the stack is depleted or moved.<br><br>You gain the following perks to <col=#>Prayer</col>:<br><br> - 20,000 Coins can be offered at Prayer altars in exchange for Prayer XP equivalent to using a dragon bone. This respects altar XP modifiers. Normal altars have no modifiers.<br><br>- All items purchased from some select shops can be noted, provided the item can be noted at all.<br>   - There will be a new button on select shops which toggles this effect.',
  },
  {
    relic: 1132,
    index: 19,
    name: 'Grimoire',
    description:
      '- The <col=#>Grimoire</col> can be used to freely swap between spellbooks.<br><br>- The <col=#>Grimoire</col> acts as a <col=#>Book of the dead</col>.<br><br>Additionally, when you select this, you will unlock access to all prayers and spells. Regardless of area, quest, or diary requirements.',
  },
  {
    relic: 4728,
    index: 24,
    name: 'Guardian',
    description:
      "- This item will allow you to summon a powerful <col=#>Guardian Thrall</col>, lasting 30 minutes.<br><br>- The guardian will attack your target with whatever style it is weak to.<br><br>- When you are in multi-combat it will cast an AoE attack if the target is weak to range or magic.<br><br>- The Guardian's stats are:<br>   - Min hit: 5<br>   - Max hit: 13<br>   - Attack Speed: 4<br>   - Accuracy: 45000<br><br>- The Guardian does not work in PvP.<br><br>- This perk will also work inside The Gauntlet.",
  },
  {
    relic: 1135,
    index: 12,
    name: 'Last Stand',
    description:
      'You gain the <col=#>Last Stand</col> perk, which works as follows:<br><br>- If damage would reduce you to 0 hp, you are reduced to 1 hp instead.<br><br>- Your combat stats are instantly boosted to 255 but begin draining rapidly back down to their base level + 15.<br><br>- For the next 16 ticks after this ability is activated, you cannot be reduced to 0 HP.<br><br>- When the effect ends, all incoming damage is nullified and the player is healed based on the damage they dealt over the last 16 ticks.<br><br>Once this ability is used, it cannot be used again until you die or 3 minutes have passed.',
  },
  {
    relic: 1119,
    index: 1,
    name: 'Lumberjack',
    description:
      '- This axe will act as a non-degradable variant of the crystal equivalent with no requirements.<br><br>- When this item is in your inventory or equipped, you gain the following perks:<br><br>- On failing to chop a tree, you will have a separate 50% chance to succeed.<br><br>- Items gathered from Woodcutting are automatically sent to your Bank.<br><br>You will be able to toggle the following effects on or off for the Axe:<br><br>- Automatically burning logs for Firemaking XP (regardless of your Firemaking level).<br><br>- Automatically Fletching logs into arrowshafts for Fletching XP (regardless of your Fletching level).<br><br>Additionally, you gain the following perks to <col=#>Firemaking</col>:<br><br>- Never fail to make fires with any logs at any Firemaking level.',
  },
  {
    relic: 6261,
    index: 16,
    name: 'Minimum Potential',
    description:
      'You gain the <col=#>Minimum Potential</col> perk. Your Melee, Ranged & Magic hits will never deal below 5 damage.',
  },
  {
    relic: 1117,
    index: 0,
    name: 'Power Miner',
    description:
      '- This pickaxe will act as a non-degradable variant of the crystal equivalent with no requirements.<br><br>- When this item is in your inventory or equipped, you gain the following perks:<br><br>- On failing to mine a rock, you will have a separate 50% chance to succeed.<br><br>- Items gathered from Mining are automatically sent to your Bank.<br><br>- The Echo Pickaxe will cause the rock to not deplete until you have mined 4 ore.<br><br>- This buff does stack with the existing Mining Gloves, with a cap of 7 ores from a given node.<br><br>You will be able to toggle the following effects on or off for the Pickaxe:<br><br>- Collected ores are automatically smelted and grant Smithing XP (regardless of your smithing level).<br><br>- Gems gathered from Mining are automatically cut and grant Crafting XP regardless of your Crafting level.',
  },
  {
    relic: 1116,
    index: 11,
    name: 'Production Prodigy',
    description:
      '- When doing the following activities, all items are processed at once:<br><br>- Smelting ores, Smithing bars (does not work with the Superheat item spell) and making Cannonballs.<br><br>- Fletching logs, stringing Bows and cutting bolt tips.<br><br>- Making headless arrows, regular arrows, bolts, darts, and javelins (capped at 10x the regular amount per action).<br><br>- Cleaning herbs and making Potions which do not have a stackable secondary ingredient.<br><br>- Cooking food and making Jugs of Wine.<br><br>- Crafting leather, uncut gems, glassblowing, jewellery, pottery, Battlestaves and spinning flax or wool.<br><br>- Full XP is given for items processed using this Relic.<br><br>- There is a 25% chance that you will make an extra product, which will be sent to your Bank if you have space. The additional product will also grant XP.<br><br>- Additionally Crafting, Smithing, Herblore, Fletching and Cooking are boosted by +12.',
  },
  {
    relic: 6260,
    index: 15,
    name: 'Rune Saviour',
    description:
      'You gain the <col=#>Rune Saviour</col> perk. Magic spells no longer require or consume Runes. This includes charges when using powered staves or tomes such as the Tome of Fire, Trident of the Seas, Trident of the Swamp, Sanguinesti Staff and the Enchanted Slayer Staff.',
  },
  {
    relic: 1129,
    index: 14,
    name: 'Slayer Master',
    description:
      "You gain the following perks to <col=#>Slayer</col>:<br><br>- Always on task for all eligible slayer monsters.<br><br>- Unlock all Slayer Task perks for free.<br><br>- Rune Pouches, Herb Sacks and Looting Bags in the Slayer Point store are all free.<br><br>- Skip and block Tasks for free.<br><br>- Gain 1000-15,000 bonus Slayer XP for the first time you kill the 100th of each unique Slayer monster, scaled by the monster's Slayer level requirement (XP stated is before multipliers).",
  },
  {
    relic: 1134,
    index: 20,
    name: 'Specialist',
    description:
      'You gain the following perks to <col=#>special attacks</col>:<br><br>- All special attacks cost 20% and have +100% accuracy.<br><br>- For each failed accuracy roll with a special attack, gain 10% Special Attack Energy.<br><br>- Whenever you kill an NPC, restore 15% Special Attack Energy.',
  },
  {
    relic: 6262,
    index: 17,
    name: 'Spiky Aura',
    description:
      "You gain the <col=#>Spiky Aura</col> perk. Whenever you take damage you'll reflect at least 25% of the damage received. This effect stacks with other recoil effects.",
  },
  {
    relic: 1130,
    index: 9,
    name: 'Total Recall',
    description:
      "- This item can be used to store any single coordinate, alongside your Hitpoints, Prayer and Special Attack Energy, and teleport back to it at a later date, restoring those stats to what they were.<br><br>- This item ignores wilderness teleport restrictions.<br><br>- The Crystal of Echoes cannot store coordinates whilst inside an instance.<br><br>- There are various other locations this item won't store coordinates in, including quest areas, certain minigames, etc.",
  },
  {
    relic: 729,
