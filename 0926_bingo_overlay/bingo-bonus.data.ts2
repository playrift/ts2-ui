export function bingoChallengeShowRelevant(id: Int): Boolean {
  return BingoChallengeShowRelevant.get(id) ?? true;
}

export function bingoChallengeItemCount(id: Int): Int {
  let count: Int = 0;
  let i: Int = 0;
  while (i < BingoChallengeItems.length) {
    const held = BingoChallengeItems.at(i);
    if (held !== null) {
      if (held.challenge === id) {
        count = count + 1;
      }
    }
    i = i + 1;
  }
  return count;
}

