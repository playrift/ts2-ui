export function bingoEventRow(): Int {
  if (!featureFlag(BINGO_FEATURE_FLAG)) {
    return -1;
  }
  return 0;
}

export function bingoEventActive(): Boolean {
  return bingoEventRow() !== -1;
}

export function bingoGridCount(): Int {
  if (bingoEventRow() === -1) {
    return 0;
  }
  return 1;
}

export function bingoGridLayout(grid: Int): Int {
  if (grid < 0 || grid >= bingoGridCount()) {
    return 0;
  }
  const row = BingoGrids.at(BingoEvents.at(0).grid);
  if (row === null) {
    return 0;
  }
  return row.gridLayout;
}

export function bingoSquare(side: Int): Int {
  if (side < 1) {
    return 0;
  }
  return side * side;
}

export function bingoRewardSlots(side: Int): Int {
  if (side < 2) {
    return 0;
  }
  return side * 2 + 2;
}

export function bingoGridSide(grid: Int): Int {
  const layout: Int = bingoGridLayout(grid);
  if (layout === 1) {
    return 3;
  }
  if (layout === 2) {
    return 4;
  }
  if (layout === 3) {
    return 5;
  }
  if (layout === 4 || layout === 5) {
    return 7;
  }
  return 0;
}

export function bingoTileCount(grid: Int): Int {
  return bingoSquare(bingoGridSide(grid));
}

export function bingoRewardCount(grid: Int): Int {
  return bingoRewardSlots(bingoGridSide(grid));
}

export function bingoTileCell(grid: Int, index: Int): [Int, Int] {
  const side: Int = bingoGridSide(grid);
  if (side === 0 || index < 0 || index >= bingoSquare(side)) {
    return [-1, -1];
  }
  return [index % side, index / side];
}

export function bingoChallengeId(grid: Int, index: Int): Int {
  if (grid < 0 || grid >= bingoGridCount() || index < 0 || index >= bingoTileCount(grid)) {
    return -1;
  }
  let before: Int = 0;
  let g: Int = 0;
  while (g < grid) {
    before = before + bingoTileCount(g);
    g = g + 1;
  }
  return before + index;
}

export function bingoChallenge(id: Int): BingoChallengeRow | null {
  return BingoChallenges.at(id);
}

export function bingoChallengePoints(id: Int): Int {
  const row: BingoChallengeRow | null = bingoChallenge(id);
  if (row === null) {
    return 0;
  }
  return row.points;
}

export function bingoPointsToProgress(grid: Int): Int {
  if (grid < 0 || grid >= bingoGridCount()) {
    return 0;
  }
  const row = BingoGrids.at(BingoEvents.at(0).grid);
  if (row === null) {
    return 0;
  }
  return row.bingoPointsToProgress;
}

export function bingoCompleteWord(word: Int): Int {
  if (word === 0) {
    return useServerState(Varps.BINGO_CHALLENGE_COMPLETE_VAR_0);
  }
  if (word === 1) {
    return useServerState(Varps.BINGO_CHALLENGE_COMPLETE_VAR_1);
  }
  return 0;
}

export function bingoChallengeComplete(id: Int): Boolean {
  if (id < 0) {
    return false;
  }
  return hasBit(bingoCompleteWord(id / 32), id % 32);
}

export function bingoChallengeProgress(id: Int): Int {
  const raw: Int = bingoProgressVar(id);
  if (id === BINGO_CUSTOM_TRACKING_CHALLENGE) {
    return CS2.bitcount(raw);
  }
  return raw;
}

export function bingoGridPoints(grid: Int): [Int, Int] {
  const first: Int = bingoChallengeId(grid, 0);
  if (first === -1) {
    return [-1, -1];
  }
  let earned: Int = 0;
  const last: Int = first + bingoTileCount(grid);
  let id: Int = first;
  while (id < last) {
    if (bingoChallengeComplete(id)) {
      earned = earned + bingoChallengePoints(id);
    }
    id = id + 1;
  }
  return [earned, bingoPointsToProgress(grid)];
}

export function bingoUnlockedGrids(): [Int, Int, Int] {
  let earned: Int = 0;
  let needed: Int = 0;
  let grid: Int = 0;
  while (grid < bingoGridCount() && bingoGridLayout(grid) !== 0) {
    const [gridEarned, gridNeeded] = bingoGridPoints(grid);
    earned = earned + gridEarned;
    needed = needed + gridNeeded;
    grid = grid + 1;
    if (earned < needed) {
      return [grid, earned, needed];
    }
  }
  return [grid, earned, needed];
}

export function bingoTileRewardSlot(grid: Int, index: Int): Int {
  if (index < 0 || index >= bingoTileCount(grid)) {
    return -1;
  }
  if (bingoGridLayout(grid) === 5) {
    return bingoRewardSlots(bingoGridSide(grid)) + index;
  }
  return -1;
}

