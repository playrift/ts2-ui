import { SkinPieces } from '../0945_reusable_floater/floater-button.component';
import { FloaterSounds } from '../0945_reusable_floater/reusable-floater.constants';
import {
  Piece,
  clickWhenDisabled,
  hoverSkin,
  normalSkin,
  pressedSkin,
  skinBorder,
  skinInset,
  skinSprite,
  skinTiling,
  wornHoverSkin,
  wornStyle,
} from '../0945_reusable_floater/floater-styles';
import { Varps } from '../lib/game/varps';
import { bingoLookupPhrase, bingoSelectedTile } from '../lib/game/varcs';
import { BingoButtonStyle, BingoColour } from './bingo-overlay.constants';
import {
  BINGO_XP_SKILL_DEFAULT,
  BingoMastery,
  BingoMasteryNames,
  BingoMasteryTiers,
  BingoXpSkillNames,
} from './bingo-bonus.data';
