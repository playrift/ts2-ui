import { useState } from 'ts2';
import { Fonts } from '../lib/game/fonts';
import { onMobile } from '../lib/lib.helpers';
import { BingoButtonStyle, BingoColour, BingoLayout } from './bingo-overlay.constants';
import { BingoChallenges } from './bingo-overlay.data';
import { BingoPanelButton } from './bingo-rows.component';
import { BINGO_TUTORIAL_CHALLENGE, BingoPanelAction, BingoPanelStyle, bingoTutorialPage } from './bingo-panels.state';

export function BingoTutorialContent(): Component {
  const [page] = useState(bingoTutorialPage);
  const phone: Boolean = onMobile();

  const central = BingoChallenges.at(BINGO_TUTORIAL_CHALLENGE);
  let centralName: String = '';
  if (central !== null) {
    centralName = central.name;
  }

  let body: String = '';
  let label: String = 'Next Step';
  let icon: Sprite = -1;
  let iconStyle: Int = BingoButtonStyle.NONE;

  if (page === 0) {
    body = `Welcome to the Grid Master interface.<br><br>Here you can view all the Grid Master challenges, just like our central challenge <col=ffffff>${centralName}</col>.<br><br>Selecting a challenge will show you any relevant information about it, what it'll reward you with and how many grid points you'll receive.`;
    icon = 6764;
    iconStyle = BingoButtonStyle.TIER_1;
  }
  if (page === 1) {
    if (phone) {
      body =
        "To view a challenge's rewards you can either:<br> - Select a challenge then select its specific rewards (like the icon below).<br> - Toggle the <col=ffffff>R</col> button to flip all the tiles over, showing their reward side.";
    } else {
      body =
        "To view a challenge's rewards you can either:<br> - Select a challenge then select its specific rewards (like the icon below).<br> - Toggle the <col=ffffff>R</col> button, or hold the <col=ffffff>CTRL</col> key to flip all the tiles over, showing their reward side.";
    }
    body = `${body}<br><br>The rewards at the edges of the grid are obtainable after completing the row / column they're attached to.`;
    icon = 6675;
    iconStyle = BingoPanelStyle.BLUE;
  }
  if (page === 2) {
    if (phone) {
      body = 'This interface will stay open while playing the game, so you can keep it open for reference.';
    } else {
      body =
        'This interface is fully resizable and movable, it will also scale to the size you select.<br>It will also stay open while playing the game, so you can keep it open for reference.';
    }
    body = `${body}<br><br><br>To start you off in Grid Master, we've given you some initial Powerups, Auto-Completed a chunk of quests automatically for you and given you a Dramen staff to get started with.<br><br><br><br><col=ffffff>Don't forget to claim your central tile reward for completing the Grid Master Tutorial!</col>`;
    label = 'Complete Tutorial';
  }

  const buttonY: Int = BingoLayout.TUTORIAL_CARD_H - BUTTON_H - BUTTON_INSET;
  const nextX: Int = BingoLayout.TUTORIAL_CARD_W - BUTTON_W - BUTTON_INSET;
  const iconX: Int = (BingoLayout.TUTORIAL_CARD_W - ICON_BOX) / 2;
  const iconY: Int = BingoLayout.TUTORIAL_CARD_H - ICON_BOX - ICON_BOTTOM;

  return (
    <>
      <text
        x="center"
        y={10}
        w={273}
        h={100}
        font={Fonts.P12_FULL}
        shadow
        color={BingoColour.ORANGE}
        align="center"
        valign="top"
        lineHeight={13}
        text={body}
      />
      <BingoPanelButton
        x={nextX}
        y={buttonY}
        w={BUTTON_W}
        h={BUTTON_H}
        hide={false}
        style={BingoPanelStyle.STONE}
        toggled={0}
        disabled={false}
        op={label}
        action={BingoPanelAction.TUTORIAL_NEXT}
      >
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          font={Fonts.P12_FULL}
          shadow
          color={BingoColour.ORANGE}
          align="center"
          valign="middle"
          text={label}
        />
      </BingoPanelButton>
      <BingoPanelButton
        x={BUTTON_INSET}
        y={buttonY}
        w={BUTTON_W}
        h={BUTTON_H}
        hide={page === 0}
        style={BingoPanelStyle.STONE}
        toggled={0}
        disabled={false}
        op="Back"
        action={BingoPanelAction.TUTORIAL_BACK}
      >
        <text
          x={0}
          y={0}
          w="fill"
          h="fill"
          font={Fonts.P12_FULL}
          shadow
          color={BingoColour.ORANGE}
          align="center"
          valign="middle"
          text="Back"
        />
      </BingoPanelButton>
      <BingoPanelButton
        x={iconX}
        y={iconY}
        w={ICON_BOX}
        h={ICON_BOX}
        hide={icon === -1}
        style={iconStyle}
        toggled={0}
        disabled={true}
        op=""
        action={BingoPanelAction.NONE}
      >
        <sprite x="center" y="center" w={{ fill: 10 }} h={{ fill: 10 }} sprite={icon} />
      </BingoPanelButton>
    </>
  );
}

const BUTTON_W = 120;
const BUTTON_H = 35;
const BUTTON_INSET = 17;
const ICON_BOX = 80;
const ICON_BOTTOM = 60;
