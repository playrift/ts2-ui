import { useWatch } from 'ts2';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { EventConfirm, EventPoints } from './event-reward-footer.component';
import { EventRewardPane } from './event-reward-pane.component';
import { EventConfirmSheet } from './event-reward-sheet.component';
import { pointsTransmitted } from './event-rewards.state';
import { EventArt, EventFrame, EventVarps } from './event-rewards.constants';

export function EventRewards(): Component {
  useWatch(EventVarps.POINTS, () => pointsTransmitted());

  return (
    <layer x="center" y="center" w={EventFrame.WINDOW_W} h={EventFrame.WINDOW_H}>
      <SteelBorderEntrypoint title="Events Reward Shop" />

      <layer w={EventFrame.WINDOW_W} h={EventFrame.WINDOW_H}>
        <layer
          x="center"
          y={{ bottom: EventFrame.BODY_BOTTOM }}
          w={{ fill: EventFrame.BODY_W_INSET }}
          h={{ fill: EventFrame.BODY_H_INSET }}
        >
          <layer
            x="center"
            y={EventFrame.BOX_Y}
            w={{ fill: EventFrame.BOX_W_INSET }}
            h={{ fill: EventFrame.BOX_H_INSET }}
          >
            <sprite
              x={EventFrame.BACKING_X}
              y={EventFrame.BACKING_X}
              w={{ fill: EventFrame.BACKING_INSET }}
              h={{ fill: EventFrame.BACKING_INSET }}
              sprite={EventArt.BACKING}
              tiling
            />
            <EventRewardPane />
            <ThinBoxEntrypoint />
          </layer>

          <EventPoints />

          <EventConfirm />
        </layer>

        <EventConfirmSheet />
      </layer>
    </layer>
  );
}
