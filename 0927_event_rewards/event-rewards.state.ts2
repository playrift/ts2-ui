import { predictServerState, useState } from 'ts2';
import { chatMessage, playSound } from '../lib/lib.engine';
import {
  ConfirmSheetOpen,
  ErrorShown,
  ErrorText,
  EventSounds,
  EventVarbits,
  LoadingOpen,
  SelectedReward,
} from './event-rewards.constants';

export function selectReward(index: Int): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(EventSounds.SELECT);
  setSelected(index);
  predictServerState(EventVarbits.SHOP_SELECTION, index);
}

export function refusePurchase(message: String): void {
  const [, setSelected] = useState(SelectedReward);
  playSound(EventSounds.REFUSE);
  chatMessage(message);
  setSelected(-1);
  predictServerState(EventVarbits.SHOP_SELECTION, -1);
}

export function openConfirm(): void {
  const [, setOpen] = useState(ConfirmSheetOpen);
  playSound(EventSounds.SELECT);
  setOpen(1);
}

export function buyReward(): void {
  const [, setLoading] = useState(LoadingOpen);
  playSound(EventSounds.SELECT);
  setLoading(1);
  clearError();
}

export function clearError(): void {
  const [, setError] = useState(ErrorText);
  const [, setShown] = useState(ErrorShown);
  setError('');
  setShown(0);
}

export function showError(message: String): void {
  const [, setError] = useState(ErrorText);
  const [, setShown] = useState(ErrorShown);
  setError(message);
  setShown(1);
}

export function cancelConfirm(): void {
  const [, setOpen] = useState(ConfirmSheetOpen);
  playSound(EventSounds.SELECT);
  setOpen(0);
}

export function pointsTransmitted(): void {
  const [, setSelected] = useState(SelectedReward);
  setSelected(-1);
  predictServerState(EventVarbits.SHOP_SELECTION, -1);
}
