import { TileArt, TileLayout } from './event-rewards.constants';

export function FilterTile({
  x,
  y,
  size,
  height,
  icon,
  label,
}: {
  x: Int;
  y: Int;
  size: Int;
  height: Int;
  icon: Sprite;
  label: String;
}): Component {
  const inner: Int = size - TileLayout.CORNER * 2;
  const iconW: Int = icon === TileArt.SMALL_ICON ? TileLayout.SMALL_ICON_W : TileLayout.ICON_W;
  const iconH: Int = icon === TileArt.SMALL_ICON ? TileLayout.SMALL_ICON_H : TileLayout.ICON_H;
  const iconY: Int = y + (height - iconH) / 2;

  return (
    <>
      <sprite x={x} y={y} w={TileLayout.CORNER} h={TileLayout.CORNER} sprite={TileArt.NW} />
      <sprite x={x + TileLayout.CORNER} y={y} w={inner} h={inner} sprite={TileArt.NC} tiling />
      <sprite x={{ right: x }} y={y} w={TileLayout.CORNER} h={TileLayout.CORNER} sprite={TileArt.NE} />
      <sprite x={x} y={y + TileLayout.CORNER} w={TileLayout.CORNER} h={inner} sprite={TileArt.CW} tiling />
      <sprite x={x + TileLayout.CORNER} y={y + TileLayout.CORNER} w={inner} h={inner} sprite={TileArt.CC} tiling />
      <sprite x={{ right: x }} y={y + TileLayout.CORNER} w={TileLayout.CORNER} h={inner} sprite={TileArt.CE} tiling />
      <sprite x={x} y={y + TileLayout.CORNER + inner} w={TileLayout.CORNER} h={TileLayout.CORNER} sprite={TileArt.SW} />
      <sprite
        x={x + TileLayout.CORNER}
        y={y + TileLayout.CORNER + inner}
        w={inner}
        h={TileLayout.CORNER}
        sprite={TileArt.SC}
        tiling
      />
      <sprite
        x={{ right: x }}
        y={y + TileLayout.CORNER + inner}
        w={TileLayout.CORNER}
        h={TileLayout.CORNER}
        sprite={TileArt.SE}
      />
      <sprite x="center" y={iconY} w={iconW} h={iconH} sprite={icon} />
      <sprite x={x} y={y} w={inner + TileLayout.CORNER} h={inner + TileLayout.CORNER} options={[label]} />
    </>
  );
}
