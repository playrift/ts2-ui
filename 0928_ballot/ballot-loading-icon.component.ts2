import { useInterval, useRef, useUniverse } from 'ts2';
import { scaled } from '../lib/lib.engine';
import {
  CosineDegrees,
  LoadingRingItems,
  SineDegrees,
} from '../0284_membership_benefits_prompt/membership-benefits-prompt.constants';

export const BallotLoading = {
  DEGREES_PER_ITEM: 27,
  DEGREES_SPARE: 9,
  RADIUS: 4,
  TRIG_UNIT: 100000,
  ZOOM_MIN: 500,
  ZOOM_MAX: 3000,
  ZOOM_STEP: 192,
  ZOOM_PER_CYCLE: 30,
  PITCH: 512,
  YAW: 1024,
  ROLL: 0,
  STACK: 1,
  SIZE_DIVISOR: 4,
} as const;

export function BallotLoadingIcon(): Component {
  const universe = useUniverse();
  const size: Int = Math.min(universe.width, universe.height) / BallotLoading.SIZE_DIVISOR;
  const centerX: Int = (universe.width - size) / 2;
  const centerY: Int = (universe.height - size) / 2;

  return (
    <layer x="center" y="center" w="fill" h="fill">
      {LoadingRingItems.map((item, index) => (
        <BallotLoadingItem item={item} index={index} centerX={centerX} centerY={centerY} size={size} />
      ))}
    </layer>
  );
}

function BallotLoadingItem({
  item,
  index,
  centerX,
  centerY,
  size,
}: {
  item: Item;
  index: Int;
  centerX: Int;
  centerY: Int;
  size: Int;
}): Component {
  const angle: Int = index * BallotLoading.DEGREES_PER_ITEM + Math.min(index + 1, BallotLoading.DEGREES_SPARE);

  const zoom: Int = Math.max(BallotLoading.ZOOM_MAX - index * BallotLoading.ZOOM_STEP, BallotLoading.ZOOM_MIN);

  const me = useRef();

  useInterval(() => {
    const next: Int = me.zoom + BallotLoading.ZOOM_PER_CYCLE;
    me.props = {
      offsetX: 0,
      offsetY: 0,
      pitch: BallotLoading.PITCH,
      yaw: BallotLoading.YAW,
      roll: BallotLoading.ROLL,
      zoom: next > BallotLoading.ZOOM_MAX ? BallotLoading.ZOOM_MIN : next,
    };
  }, me);

  return (
    <model
      ref={me}
      x={centerX + scaled(cosDegrees(angle), BallotLoading.TRIG_UNIT, BallotLoading.RADIUS)}
      y={centerY + scaled(sinDegrees(angle), BallotLoading.TRIG_UNIT, BallotLoading.RADIUS)}
      w={size}
      h={size}
      item={item}
      itemCount={BallotLoading.STACK}
      pitch={BallotLoading.PITCH}
      yaw={BallotLoading.YAW}
      roll={BallotLoading.ROLL}
      zoom={zoom}
    />
  );
}

function sinDegrees(degrees: Int): Int {
  return SineDegrees.at(degrees) ?? 0;
}

function cosDegrees(degrees: Int): Int {
  return CosineDegrees.at(degrees) ?? 0;
}
