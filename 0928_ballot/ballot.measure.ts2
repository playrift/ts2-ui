import { resultsAnswersHeight } from './results.state';
import {
  VoteKind,
  voteContainerFlags,
  voteRankHeight,
  voteShapeCount,
  voteShapeKind,
  voteShapeSkip,
  voteTextHeight,
} from './vote.state';

export function ballotAnswerStackHeight(voting: Boolean, blob: String, question: Int, shape: Int, width: Int): Int {
  if (!voting) {
    return resultsAnswersHeight(blob, question, width);
  }

  const kind: Int = voteShapeKind(shape);

  if (kind === VoteKind.TEXT) {
    return voteTextHeight(voteContainerFlags(shape), width);
  }

  if (kind === VoteKind.RANK) {
    return voteRankHeight(voteShapeCount(shape), voteShapeSkip(shape), width);
  }

  return 0;
}
