import { sessionState, useServerState } from 'ts2';
import { Varbits } from '../lib/game/varbits';

export const ballotPage = sessionState(-1);

export const ballotTitle = sessionState('');

export const ballotLoadingShown = sessionState(0);

export const ballotVoteContentShown = sessionState(1);

export const ballotVoteBarBuild = sessionState(0);

export const ballotModalShown = sessionState(0);

export const ballotDisplayFrame = sessionState(-1);

export const ballotMarkerIndex = sessionState(-1);
export const ballotMarkerText = sessionState('');

export const ballotSubmitShown = sessionState(0);

export const voteContentTotal = sessionState(0);

export const pollsRowsContentTotal = sessionState(0);

export const ballotQ0Text = sessionState('');
export const ballotQ1Text = sessionState('');
export const ballotQ2Text = sessionState('');
export const ballotQ3Text = sessionState('');
export const ballotQ4Text = sessionState('');
export const ballotQ5Text = sessionState('');
export const ballotQ6Text = sessionState('');
export const ballotQ7Text = sessionState('');

export function ballotPollState(): Int {
  return useServerState(Varbits.POLL_VOTE_STATUS);
}

export const BallotPollState = {
  OPEN: 3,
  UNSUBMITTED: 4,
  LOCKED: 5,
} as const;

export function ballotVotable(): Boolean {
  const state: Int = ballotPollState();
  return state === BallotPollState.OPEN || state === BallotPollState.UNSUBMITTED;
}

export const ballotQuestionWide = sessionState(0);
