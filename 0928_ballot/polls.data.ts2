type PollCategoriesRow = {
  category: Boolean;
  id: Int;
  opbase: String;
  icon: Sprite;
  desc: String;
};

export const PollCategories = listOf<PollCategoriesRow>([
  {
    category: true,
    id: 0,
    opbase: 'Lock-in Polls',
    icon: 6793,
    desc: 'A <col=ffb83f>lock-in poll</col> is a <col=ffb83f>commitment to release</col> the proposed game update, if reasonably possible, provided it gets sufficient support in the poll.<br><br>An update that has passed its lock-in poll <col=ffb83f>may still need to be amended or cancelled</col> if problems arise during its development, but otherwise the update should be delivered once it is ready.',
  },
  {
    category: true,
    id: 1,
    opbase: 'Greenlight Polls',
    icon: 6794,
    desc: 'A <col=ffb83f>greenlight poll</col> is an <col=ffb83f>offer to explore designs</col> for the proposed game update, provided it gets sufficient support in the poll.<br><br>After a more detailed design has been published, players would be invited to vote in a <col=ffb83f>lock-in poll</col>, stating whether or not they still want the update locked-in for release.',
  },
  {
    category: true,
    id: 2,
    opbase: 'Opinion Surveys',
    icon: 6795,
    desc: 'An <col=ffb83f>opinion survey</col> asks players about their preferences and opinions, whether about Old School RuneScape, about gaming in general, about themselves or any other topic.<br><br>Although topics may include potential future changes to Old School RuneScape, these informal opinion surveys <col=ffb83f>do not confirm</col> that such ideas will be taken further.',
  },
  { category: false, id: 0, opbase: 'Polls that are not open', icon: 6789, desc: '' },
  { category: false, id: 1, opbase: 'Open polls in which you have voted', icon: 6791, desc: '' },
  { category: false, id: 2, opbase: 'Open polls for which you are ineligible to vote', icon: 6790, desc: '' },
  { category: false, id: 3, opbase: 'Open polls in which you may vote', icon: 6792, desc: '' },
]);
