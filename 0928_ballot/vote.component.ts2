export function VotePage({}: {}): Component {
  const [page] = useState(ballotPage);
  const [contentShown] = useState(ballotVoteContentShown);
  const width: Int = CS2.if_width_get(ballotVotePaneRef);
  const votable: Boolean = true;

  return (
    <layer x={0} y={0} w="fill" h="fill" hide={page !== BallotPage.VOTE || !ballotVotePaneLive() || contentShown === 0}>
      <VoteQuestionSlot0 y={0} width={width} votable={votable} />
    </layer>
  );
}
