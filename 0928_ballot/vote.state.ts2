  if (question === 0) {
    setBlob0(blob);
  } else if (question === 1) {
    setBlob1(blob);
  } else if (question === 2) {
    setBlob2(blob);
  } else if (question === 3) {
    setBlob3(blob);
  } else if (question === 4) {
    setBlob4(blob);
  } else if (question === 5) {
    setBlob5(blob);
  } else if (question === 6) {
    setBlob6(blob);
  } else if (question === 7) {
    setBlob7(blob);
  }
}

function voteBuild(
  kind: Int,
  question: Int,
  flags: Int,
  answer: Int,
  allowSkip: Boolean,
  seed: Int,
  firstMask: Int,
  lastMask: Int,
  labels: Strings,
): void {
  const count: Int = CS2.min(labels.length, VOTE_MAX_ANSWERS);
  const order: Ints = voteAnswerOrder(seed, labels.length, firstMask, lastMask);
  voteStoreBlob(question, voteBlobEncode(labels, order, count));
  voteStore(question, voteShapePack(kind, allowSkip, count, flags, false, false), answer);
}

export function voteBuildRadio(
  question: Int,
  flags: Int,
  answer: Int,
  allowSkip: Boolean,
  seed: Int,
  firstMask: Int,
  lastMask: Int,
  labels: Strings,
): void {
  voteBuild(VoteKind.RADIO, question, flags, answer, allowSkip, seed, firstMask, lastMask, labels);
}

export function voteBuildCheck(
  question: Int,
  flags: Int,
  answer: Int,
  allowSkip: Boolean,
  seed: Int,
  firstMask: Int,
  lastMask: Int,
  labels: Strings,
): void {
  voteBuild(VoteKind.CHECK, question, flags, answer, allowSkip, seed, firstMask, lastMask, labels);
}

function voteSelect(question: Int, flags: Int, answer: Int, empty: Int): void {
  const [shape0] = useState(voteQ0Shape);
  const [shape1] = useState(voteQ1Shape);
  const [shape2] = useState(voteQ2Shape);
  const [shape3] = useState(voteQ3Shape);
  const [shape4] = useState(voteQ4Shape);
  const [shape5] = useState(voteQ5Shape);
  const [shape6] = useState(voteQ6Shape);
  const [shape7] = useState(voteQ7Shape);

  let shape: Int = shape0;
  if (question === 1) {
    shape = shape1;
  } else if (question === 2) {
    shape = shape2;
  } else if (question === 3) {
    shape = shape3;
  } else if (question === 4) {
    shape = shape4;
  } else if (question === 5) {
    shape = shape5;
  } else if (question === 6) {
    shape = shape6;
  } else if (question === 7) {
    shape = shape7;
  }
  if (voteShapeKind(shape) === VoteKind.NONE) {
    return;
  }
  voteStore(question, voteShapeReflag(shape, flags), hasBit(flags, 1) ? empty : answer);
}

export function voteSelectRadio(question: Int, flags: Int, answer: Int): void {
  voteSelect(question, flags, answer, -1);
}

export function voteSelectCheck(question: Int, flags: Int, mask: Int): void {
  voteSelect(question, flags, mask, 0);
}

export const VOTE_MAX_GRID_ITEMS = 32;

export const VOTE_MAX_GRID_COLUMNS = 8;

const VOTE_GRID_HEADER = 8;

const VoteGridItemWord = {
  INDEX_START: 0,
  INDEX_END: 4,
  CHOICE_START: 5,
  CHOICE_END: 10,
  SKIP_BIT: 11,
} as const;

function voteGridPack(item: Int, choice: Int, skippable: Boolean): Int {
  let word: Int = CS2.bit_range_to_int_set(0, item, VoteGridItemWord.INDEX_START, VoteGridItemWord.INDEX_END);
  word = CS2.bit_range_to_int_set(word, choice + 1, VoteGridItemWord.CHOICE_START, VoteGridItemWord.CHOICE_END);
  if (skippable) {
    word = CS2.bit_set(word, VoteGridItemWord.SKIP_BIT);
  }
  return word;
}

function voteGridEncode(
  items: Strings,
  columns: Strings,
  choices: Ints,
  order: Ints,
  skipMask: Int,
  mirror: Boolean,
): String {
  const itemCount: Int = CS2.min(items.length, VOTE_MAX_GRID_ITEMS);
  const columnCount: Int = CS2.min(columns.length, VOTE_MAX_GRID_COLUMNS);

  let blob: String = `${voteField(itemCount)}${voteField(columnCount)}`;

  let i: Int = 0;
  while (i < itemCount) {
    const item: Int = order[i];
    const label: String = items[item];
    const word: Int = voteGridPack(item, choices[item], CS2.testbit(skipMask, item));
    blob = `${blob}${voteField(word)}${voteField(CS2.string_length(label))}${label}`;
    i = i + 1;
  }

  let c: Int = 0;
  while (c < columnCount) {
    const column: Int = mirror ? columnCount - (c + 1) : c;
    const label: String = columns[column];
    blob = `${blob}${voteField(column)}${voteField(CS2.string_length(label))}${label}`;
    c = c + 1;
  }
  return blob;
}

export function voteGridItemCount(blob: String): Int {
  return CS2.string_length(blob) === 0 ? 0 : voteRecordHead(blob, 0);
}

export function voteGridColumnCount(blob: String): Int {
  return CS2.string_length(blob) === 0 ? 0 : voteRecordHead(blob, VOTE_FIELD);
}

function voteGridItemAt(blob: String, i: Int): Int {
  return voteSeekFrom(blob, VOTE_GRID_HEADER, i);
}

function voteGridColumnAt(blob: String, c: Int): Int {
  return voteSeekFrom(blob, VOTE_GRID_HEADER, voteGridItemCount(blob) + c);
}

export function voteGridItemLabel(blob: String, i: Int): String {
  return voteRecordText(blob, voteGridItemAt(blob, i));
}

export function voteGridItemIndex(blob: String, i: Int): Int {
  return CS2.bit_range_get(
    voteRecordHead(blob, voteGridItemAt(blob, i)),
    VoteGridItemWord.INDEX_START,
    VoteGridItemWord.INDEX_END,
  );
}

export function voteGridItemChoice(blob: String, i: Int): Int {
  return (
    CS2.bit_range_get(
      voteRecordHead(blob, voteGridItemAt(blob, i)),
      VoteGridItemWord.CHOICE_START,
      VoteGridItemWord.CHOICE_END,
    ) - 1
  );
}

export function voteGridItemSkippable(blob: String, i: Int): Boolean {
  return CS2.testbit(voteRecordHead(blob, voteGridItemAt(blob, i)), VoteGridItemWord.SKIP_BIT);
}

export function voteGridColumnLabel(blob: String, c: Int): String {
  return voteRecordText(blob, voteGridColumnAt(blob, c));
}

export function voteGridColumnIndex(blob: String, c: Int): Int {
  return voteRecordHead(blob, voteGridColumnAt(blob, c));
}

function voteGridReChoose(blob: String, choices: Ints): String {
  const itemCount: Int = voteGridItemCount(blob);
  const columnCount: Int = voteGridColumnCount(blob);

  let out: String = `${voteField(itemCount)}${voteField(columnCount)}`;

  let i: Int = 0;
  while (i < itemCount) {
    const at: Int = voteGridItemAt(blob, i);
    const head: Int = voteRecordHead(blob, at);
    const label: String = voteRecordText(blob, at);
    const item: Int = CS2.bit_range_get(head, VoteGridItemWord.INDEX_START, VoteGridItemWord.INDEX_END);
    const word: Int = voteGridPack(item, choices[item], CS2.testbit(head, VoteGridItemWord.SKIP_BIT));
    out = `${out}${voteField(word)}${voteField(CS2.string_length(label))}${label}`;
    i = i + 1;
  }

  let c: Int = 0;
  while (c < columnCount) {
    const at: Int = voteGridColumnAt(blob, c);
    const span: Int = VOTE_RECORD_HEADER + CS2.parseint(blob.substring(at + VOTE_FIELD, at + VOTE_RECORD_HEADER));
    out = `${out}${blob.substring(at, at + span)}`;
    c = c + 1;
  }
  return out;
}

export function voteBuildGrid(
  question: Int,
  flags: Int,
  choices: Ints,
  items: Strings,
  columns: Strings,
  skipMask: Int,
  allowSkipRow: Boolean,
  seed: Int,
  firstMask: Int,
  lastMask: Int,
): void {
  const order: Ints = voteAnswerOrder(seed, items.length, firstMask, lastMask);
  const mirror: Boolean = ballotNameSeed() % 2 === 1;

  voteStoreBlob(question, voteGridEncode(items, columns, choices, order, skipMask, mirror));
  voteStore(
    question,
    voteShapePack(
      VoteKind.GRID,
      allowSkipRow,
      CS2.min(items.length, VOTE_MAX_GRID_ITEMS),
      flags,
      false,
      skipMask !== 0,
    ),
    skipMask,
  );
}

export function voteUpdateGrid(question: Int, flags: Int, choices: Ints): void {
  const shape: Int = voteReadShape(question);
  if (voteShapeKind(shape) !== VoteKind.GRID) {
    return;
  }
  voteStoreBlob(question, voteGridReChoose(voteReadBlob(question), choices));
  voteStoreShape(question, voteShapeReflag(shape, flags));
}

export function voteBuildText(
  question: Int,
  flags: Int,
  allowSkip: Boolean,
  limit: Int,
  multiline: Boolean,
  text: String,
): void {
  voteStoreBlob(question, text);
  voteStore(question, voteShapePack(VoteKind.TEXT, allowSkip, 0, flags, multiline, false), limit);
}

export function voteUpdateText(question: Int, flags: Int, text: String): void {
  const shape: Int = voteReadShape(question);
  if (voteShapeKind(shape) !== VoteKind.TEXT) {
    return;
  }
  voteStoreBlob(question, text);
  voteStoreShape(question, voteShapeReflag(shape, flags));
}

export function voteStackHeightBlob(blob: String, count: Int, allowSkip: Boolean, width: Int): Int {
  let y: Int = 0;
  let k: Int = 0;
  while (k < count) {
    if (y > 0) {
      y = y + VoteMetric.ROW_GAP;
    }
    y = y + voteRowHeight(voteBlobLabel(blob, k), width);
    k = k + 1;
  }
  if (allowSkip) {
    if (y > 0) {
      y = y + VoteMetric.ROW_GAP;
    }
    y = y + voteRowHeight(VOTE_SKIP_ROW_LABEL, width);
  }
  return y;
}

export const VOTE_RANK_DRAG_MAX = 30;

export const voteRankQuestion = sessionState(-1);
export const voteRankFrom = sessionState(-1);
export const voteRankTo = sessionState(-1);
export const voteRankDragging = sessionState(0);
export const voteRankDragX = sessionState(0);
export const voteRankDragY = sessionState(0);

export const voteRankHoverQuestion = sessionState(-1);
export const voteRankHoverSlot = sessionState(-1);

export function voteRankShift(mouseY: Int, rowY: Int): Int {
  const d: Int = mouseY - rowY;
  if (d < 0) {
    return (d - VoteMetric.RANK_ROW_H / 2) / VoteMetric.RANK_ROW_H;
  }
  return (d + VoteMetric.RANK_ROW_H / 2) / VoteMetric.RANK_ROW_H;
}

function voteRankLockedLead(mask: Int, rows: Int): Int {
  let n: Int = 0;
  let i: Int = 0;
  let lead: Boolean = true;
  while (i < rows) {
    if (hasBit(mask, i)) {
      if (lead) {
        n = n + 1;
      }
    } else {
      lead = false;
    }
    i = i + 1;
  }
  return n;
}

function voteRankLockedTail(mask: Int, rows: Int): Int {
  let n: Int = 0;
  let i: Int = 0;
  let lead: Boolean = true;
  while (i < rows) {
    if (hasBit(mask, i)) {
      if (!lead) {
        n = n + 1;
      }
    } else {
      lead = false;
    }
    i = i + 1;
  }
  return n;
}

export function voteRankTargetSlot(from: Int, delta: Int, rows: Int, mask: Int): Int {
  const n: Int = CS2.min(VOTE_RANK_DRAG_MAX, rows);
  if (delta < 0) {
    return CS2.max(voteRankLockedLead(mask, n), from + delta);
  }
  if (delta > 0) {
    return CS2.min(n - 1 - voteRankLockedTail(mask, n), from + delta);
  }
  return from;
}

export function voteRankDrawSlot(k: Int, from: Int, to: Int): Int {
  if (from === -1 || to === from) {
    return k;
  }
  if (to < from) {
    if (k === from) {
      return to;
    }
    if (k >= to && k < from) {
      return k + 1;
    }
    return k;
  }
  if (k === from) {
    return to;
  }
  if (k > from && k <= to) {
    return k - 1;
  }
  return k;
}

export function voteRankSourceAt(p: Int, from: Int, to: Int): Int {
  if (from === -1 || to === from) {
    return p;
  }
  if (to < from) {
    if (p === to) {
      return from;
    }
    if (p > to && p <= from) {
      return p - 1;
    }
    return p;
  }
  if (p === to) {
    return from;
  }
  if (p >= from && p < to) {
    return p + 1;
  }
  return p;
}

export function voteRankOrder(blob: String, rows: Int): Ints {
  const order: AnyArray = CS2.array_create(VOTE_INT_ARRAY, 0, rows);
  let k: Int = 0;
  while (k < rows) {
    CS2.array_push(voteBlobAnswer(blob, k), order);
    k = k + 1;
  }
  return order as unknown as Ints;
}

export function voteRankOrderShifted(blob: String, rows: Int, from: Int, to: Int): Ints {
  const order: AnyArray = CS2.array_create(VOTE_INT_ARRAY, 0, rows);
  let p: Int = 0;
  while (p < rows) {
    CS2.array_push(voteBlobAnswer(blob, voteRankSourceAt(p, from, to)), order);
    p = p + 1;
  }
  return order as unknown as Ints;
}

export function voteRankSend(question: Int, order: Ints, host: ComponentId, hostSub: Int): void {
  CS2.if_runscript(VoteServerScript.RANK, host, hostSub, question, order as unknown as Int, 'i*');
}

export function voteBuildRank(
  question: Int,
  flags: Int,
  lockedMask: Int,
  allowSkipRow: Boolean,
  order: Ints,
  labels: Strings,
): void {
  const rows: Int = CS2.min(order.length, VOTE_MAX_ANSWERS);

  voteStoreBlob(question, voteBlobEncode(labels, order, rows));
  voteStore(question, voteShapePack(VoteKind.RANK, allowSkipRow, rows, flags, false, false), lockedMask);
}

export function voteUpdateRank(question: Int, flags: Int, order: Ints): void {
  const [rankQuestion, setRankQuestion] = useState(voteRankQuestion);
  const [, setRankFrom] = useState(voteRankFrom);
  const [, setRankTo] = useState(voteRankTo);
  const [, setDragging] = useState(voteRankDragging);

  const shape: Int = voteReadShape(question);
  if (voteShapeKind(shape) !== VoteKind.RANK) {
    return;
  }

  voteStoreBlob(question, voteRankApply(voteReadBlob(question), voteShapeCount(shape), order));
  voteStoreShape(question, voteShapeReflag(shape, flags));

  if (rankQuestion === question) {
    setRankQuestion(-1);
    setRankFrom(-1);
    setRankTo(-1);
    setDragging(0);
  }
}

function voteRankApply(blob: String, rows: Int, order: Ints): String {
  let out: String = '';
  let k: Int = 0;
  while (k < rows && k < order.length) {
    const at: Int = voteRankSeekHead(blob, rows, order[k]);
    if (at !== -1) {
      const span: Int = VOTE_RECORD_HEADER + CS2.parseint(blob.substring(at + VOTE_FIELD, at + VOTE_RECORD_HEADER));
      out = `${out}${blob.substring(at, at + span)}`;
    }
    k = k + 1;
  }
  return out;
}

function voteRankSeekHead(blob: String, rows: Int, head: Int): Int {
  let k: Int = 0;
  while (k < rows) {
    const at: Int = voteSeek(blob, k);
    if (voteRecordHead(blob, at) === head) {
      return at;
    }
    k = k + 1;
  }
  return -1;
}
