  if (question === 0) {
    setShape0(shape);
  } else if (question === 1) {
    setShape1(shape);
  } else if (question === 2) {
    setShape2(shape);
  } else if (question === 3) {
    setShape3(shape);
  } else if (question === 4) {
    setShape4(shape);
  } else if (question === 5) {
    setShape5(shape);
  } else if (question === 6) {
    setShape6(shape);
