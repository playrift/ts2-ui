}

function voteStoreBlob(question: Int, blob: String): void {
  const [, setBlob0] = useState(voteQ0Blob);
  const [, setBlob1] = useState(voteQ1Blob);
  const [, setBlob2] = useState(voteQ2Blob);
  const [, setBlob3] = useState(voteQ3Blob);
  const [, setBlob4] = useState(voteQ4Blob);
  const [, setBlob5] = useState(voteQ5Blob);
  const [, setBlob6] = useState(voteQ6Blob);
