import { CS2, sessionState, useState } from 'ts2';
import { Fonts } from '../lib/game/fonts';
import { hasBit, scaled, textLineCount, textWidth } from '../lib/lib.engine';
import { ballotVotePaneRef } from './ballot.constants';
import { ballotNameSeed } from './ballot.helpers';

const VOTE_SMALL = Fonts.P11_FULL;
const VOTE_INT_ARRAY = 105;

const VOTE_BODY = Fonts.P12_FULL;

export const VoteMetric = {
  LABEL_INSET_X: 21,
  ROW_PAD: 2,
  LINE_H: 16,
  ROW_GAP: 4,
  FIELD_LINES: 1,
  FIELD_LINES_MULTI: 3,
  FIELD_PAD: 8,
  GRID_COLUMN_PERCENT: 65,
  CELL_PAD: 4,
  CELL_GAP: 1,
  GRID_HEADER_LINE_H: 13,
  GRID_ROW_LINE_H: 15,
  RANK_ROW_H: 24,
} as const;

export const VOTE_SKIP_COLUMN_LABEL = 'Skip';
export const VOTE_SKIP_ROW_LABEL = 'Skip question';

export const voteTextDirty = sessionState(0);

export const voteGridHoverQuestion = sessionState(-1);
export const voteGridHoverItem = sessionState(-1);
export const voteGridHoverColumn = sessionState(-2);

export const VoteServerScript = {
  SELECT: -1686257893,
  TEXT: -880770536,
  MATRIX: 667475298,
  RANK: 1137418264,
  MULTI_SELECT: -1221106738,
} as const;

export const VoteTextMode = {
  COMMIT: 0,
  SKIP: 1,
  UNSKIP: 2,
} as const;

export const VOTE_NULL_TEXT = 'null';

export function voteRowHeight(label: String, width: Int): Int {
  const lines: Int =
    CS2.string_length(label) === 0 ? 1 : textLineCount(label, width - VoteMetric.LABEL_INSET_X, VOTE_BODY);
  return VoteMetric.ROW_PAD + lines * VoteMetric.LINE_H;
}

function voteStackHeight(labels: Strings, allowSkip: Boolean, width: Int): Int {
  let y: Int = 0;
  let i: Int = 0;
  while (i < labels.length) {
    if (y > 0) {
      y = y + VoteMetric.ROW_GAP;
    }
    y = y + voteRowHeight(labels[i], width);
    i = i + 1;
  }
  if (allowSkip) {
    if (y > 0) {
      y = y + VoteMetric.ROW_GAP;
    }
    y = y + voteRowHeight(VOTE_SKIP_ROW_LABEL, width);
  }
  return y;
}

export function voteRadioHeight(labels: Strings, allowSkip: Boolean, width: Int): Int {
  return voteStackHeight(labels, allowSkip, width);
}

export function voteCheckHeight(labels: Strings, allowSkip: Boolean, width: Int): Int {
  return voteStackHeight(labels, allowSkip, width);
}

export function voteTextHeight(flags: Int, width: Int): Int {
  const lines: Int = hasBit(flags, 3) ? VoteMetric.FIELD_LINES_MULTI : VoteMetric.FIELD_LINES;
  return lines * VoteMetric.LINE_H + VoteMetric.FIELD_PAD;
}

export function voteGridHeight(items: Strings, columns: Strings, flags: Int, allowSkipRow: Boolean, width: Int): Int {
  const allowSkip: Boolean = hasBit(flags, 2);

  let columnsWidth: Int = scaled(width, 100, VoteMetric.GRID_COLUMN_PERCENT);
  let skipWidth: Int = 0;
  let skipStride: Int = 0;
  if (allowSkip) {
    const label: Int = textWidth(VOTE_SKIP_COLUMN_LABEL, columnsWidth, VOTE_SMALL);
    skipWidth = label + VoteMetric.CELL_PAD;
    skipStride = skipWidth + VoteMetric.CELL_GAP;
    columnsWidth = columnsWidth - skipStride;
  }

  const columnCount: Int = columns.length;
  const stride: Int = columnsWidth / columnCount;
  const cellTextW: Int = stride - VoteMetric.CELL_GAP - VoteMetric.CELL_PAD;
  const gutterW: Int = width - stride * columnCount - skipStride;
  const gutterTextW: Int = gutterW - VoteMetric.CELL_PAD;

  let headerLines: Int = 1;
  let c: Int = 0;
  while (c < columnCount) {
    headerLines = CS2.max(headerLines, textLineCount(columns[c], cellTextW, VOTE_SMALL));
    c = c + 1;
  }
  if (allowSkip) {
    headerLines = CS2.max(headerLines, textLineCount(VOTE_SKIP_COLUMN_LABEL, cellTextW, VOTE_SMALL));
  }

  let y: Int = headerLines * VoteMetric.GRID_HEADER_LINE_H + VoteMetric.CELL_PAD;

  let i: Int = 0;
  while (i < items.length) {
    y = y + VoteMetric.CELL_GAP;
    const rowLines: Int = textLineCount(items[i], gutterTextW, VOTE_SMALL);
    y = y + rowLines * VoteMetric.GRID_ROW_LINE_H + VoteMetric.CELL_PAD;
    i = i + 1;
  }

  if (allowSkipRow) {
    y = y + VoteMetric.ROW_GAP + voteRowHeight(VOTE_SKIP_ROW_LABEL, width);
  }
  return y;
}

export function voteRankHeight(rowCount: Int, allowSkipRow: Boolean, width: Int): Int {
  let y: Int = rowCount * VoteMetric.RANK_ROW_H;
  if (allowSkipRow) {
    y = y + VoteMetric.ROW_GAP + voteRowHeight(VOTE_SKIP_ROW_LABEL, width);
  }
  return y;
}

export function voteTextCommit(question: Int, text: String, host: ComponentId, hostSub: Int): void {
  const [dirty, setDirty] = useState(voteTextDirty);
  if (!hasBit(dirty, question)) {
    return;
  }
  setDirty(CS2.bit_clear(dirty, question));
  CS2.if_runscript(VoteServerScript.TEXT, host, hostSub, question, 0, text, 'iis');
}

export function voteCommitPendingAnswers(): void {
  const [dirty, setDirty] = useState(voteTextDirty);
  if (dirty === 0) {
    return;
  }

  let left: Int = dirty;
  let question: Int = 0;
  while (question < VOTE_MAX_QUESTIONS) {
    if (hasBit(left, question) && voteShapeKind(voteReadShape(question)) === VoteKind.TEXT) {
      left = CS2.bit_clear(left, question);
      CS2.if_runscript(VoteServerScript.TEXT, ballotVotePaneRef, -1, question, 0, voteReadBlob(question), 'iis');
    }
    question = question + 1;
  }
  setDirty(left);
}

export function voteShuffleOrder(seed: Int, nameHash: Int, count: Int, firstMask: Int, lastMask: Int): Ints {
  const pinned: Int = firstMask | lastMask;
  const order: AnyArray = CS2.array_create(VOTE_INT_ARRAY, 0, count);

  let i: Int = 0;
  while (i < count) {
    if (!hasBit(pinned, i)) {
      CS2.array_push(i, order);
    }
    i = i + 1;
  }

  CS2.array_randomise(order, seed, nameHash);

  i = 0;
  let at: Int = 0;
  while (i < count) {
    if (hasBit(firstMask, i)) {
      CS2.array_insert(i, at, order);
      at = at + 1;
    }
    if (hasBit(lastMask, i)) {
      CS2.array_push(i, order);
    }
    i = i + 1;
  }
  return order as unknown as Ints;
}

export const VOTE_MAX_ANSWERS = 32;

export const VOTE_MAX_QUESTIONS = 8;

const VOTE_STRING_ARRAY = 115;

const VOTE_FIELD = 4;
const VOTE_RECORD_HEADER = 8;

function voteField(value: Int): String {
  return CS2.tostring(value).padStart(VOTE_FIELD, '0');
}

function voteSeekFrom(blob: String, start: Int, k: Int): Int {
  let at: Int = start;
  let i: Int = 0;
  while (i < k) {
    at = at + VOTE_RECORD_HEADER + CS2.parseint(blob.substring(at + VOTE_FIELD, at + VOTE_RECORD_HEADER));
    i = i + 1;
  }
  return at;
}

function voteSeek(blob: String, k: Int): Int {
  return voteSeekFrom(blob, 0, k);
}

function voteRecordText(blob: String, at: Int): String {
  const len: Int = CS2.parseint(blob.substring(at + VOTE_FIELD, at + VOTE_RECORD_HEADER));
  return blob.substring(at + VOTE_RECORD_HEADER, at + VOTE_RECORD_HEADER + len);
}

function voteRecordHead(blob: String, at: Int): Int {
  return CS2.parseint(blob.substring(at, at + VOTE_FIELD));
}

export function voteBlobLabel(blob: String, k: Int): String {
  return voteRecordText(blob, voteSeek(blob, k));
}

export function voteBlobAnswer(blob: String, k: Int): Int {
  return voteRecordHead(blob, voteSeek(blob, k));
}

export function voteAnswerOrder(seed: Int, count: Int, firstMask: Int, lastMask: Int): Ints {
  if (seed !== 0) {
    return voteShuffleOrder(seed, ballotNameSeed(), count, firstMask, lastMask);
  }
  const order: AnyArray = CS2.array_create(VOTE_INT_ARRAY, count, count);
  CS2.array_generaterange(order, 0, 0, -1);
  return order as unknown as Ints;
}

function voteBlobEncode(labels: Strings, order: Ints, count: Int): String {
  let blob: String = '';
  let k: Int = 0;
  while (k < count) {
    const answer: Int = order[k];
    const label: String = labels[answer];
    blob = `${blob}${voteField(answer)}${voteField(CS2.string_length(label))}${label}`;
    k = k + 1;
  }
  return blob;
}

const VoteShape = {
  KIND_START: 0,
  KIND_END: 3,
  SKIP_BIT: 4,
  COUNT_START: 5,
  COUNT_END: 10,
  SKIPPED_BIT: 11,
  READONLY_BIT: 12,
  MULTILINE_BIT: 13,
  GRID_SKIP_COLUMN_BIT: 14,
} as const;

export const VoteKind = {
  NONE: 0,
  RADIO: 1,
  CHECK: 2,
  TEXT: 3,
  GRID: 4,
  RANK: 5,
} as const;

function voteShapePack(
  kind: Int,
  allowSkip: Boolean,
  count: Int,
  flags: Int,
  multiline: Boolean,
  gridSkipColumn: Boolean,
): Int {
  let shape: Int = CS2.bit_range_to_int_set(0, kind, VoteShape.KIND_START, VoteShape.KIND_END);
  shape = CS2.bit_range_to_int_set(shape, count, VoteShape.COUNT_START, VoteShape.COUNT_END);
  if (allowSkip) {
    shape = CS2.bit_set(shape, VoteShape.SKIP_BIT);
  }
  if (hasBit(flags, 1)) {
    shape = CS2.bit_set(shape, VoteShape.SKIPPED_BIT);
  }
  if (hasBit(flags, 2)) {
    shape = CS2.bit_set(shape, VoteShape.READONLY_BIT);
  }
  if (multiline) {
    shape = CS2.bit_set(shape, VoteShape.MULTILINE_BIT);
  }
  if (gridSkipColumn) {
    shape = CS2.bit_set(shape, VoteShape.GRID_SKIP_COLUMN_BIT);
  }
  return shape;
}

function voteShapeReflag(shape: Int, flags: Int): Int {
  return voteShapePack(
    voteShapeKind(shape),
    CS2.testbit(shape, VoteShape.SKIP_BIT),
    voteShapeCount(shape),
    flags,
    voteShapeMultiline(shape),
    voteShapeGridSkipColumn(shape),
  );
}

export function voteShapeKind(shape: Int): Int {
  return CS2.bit_range_get(shape, VoteShape.KIND_START, VoteShape.KIND_END);
}

export function voteShapeCount(shape: Int): Int {
  return CS2.bit_range_get(shape, VoteShape.COUNT_START, VoteShape.COUNT_END);
}

export function voteShapeSkip(shape: Int): Boolean {
  return CS2.testbit(shape, VoteShape.SKIP_BIT);
}

export function voteShapeSkipped(shape: Int): Boolean {
  return CS2.testbit(shape, VoteShape.SKIPPED_BIT);
}

export function voteShapeReadOnly(shape: Int): Boolean {
  return CS2.testbit(shape, VoteShape.READONLY_BIT);
}

export function voteShapeMultiline(shape: Int): Boolean {
  return CS2.testbit(shape, VoteShape.MULTILINE_BIT);
}

export function voteShapeGridSkipColumn(shape: Int): Boolean {
  return CS2.testbit(shape, VoteShape.GRID_SKIP_COLUMN_BIT);
}

export function voteContainerFlags(shape: Int): Int {
  let flags: Int = 0;
  if (voteShapeSkip(shape)) {
    flags = CS2.bit_set(flags, 1);
  }
  if (voteShapeGridSkipColumn(shape)) {
    flags = CS2.bit_set(flags, 2);
  }
  if (voteShapeMultiline(shape)) {
    flags = CS2.bit_set(flags, 3);
  }
  return flags;
}

