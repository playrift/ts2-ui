    setShape7(shape);
  }
}

function voteReadShape(question: Int): Int {
  const [shape0] = useState(voteQ0Shape);
  const [shape1] = useState(voteQ1Shape);
  const [shape2] = useState(voteQ2Shape);
  const [shape3] = useState(voteQ3Shape);
  const [shape4] = useState(voteQ4Shape);
  const [shape5] = useState(voteQ5Shape);
  const [shape6] = useState(voteQ6Shape);
  const [shape7] = useState(voteQ7Shape);

  if (question === 1) {
    return shape1;
  } else if (question === 2) {
    return shape2;
  } else if (question === 3) {
    return shape3;
  } else if (question === 4) {
    return shape4;
  } else if (question === 5) {
    return shape5;
  } else if (question === 6) {
    return shape6;
  } else if (question === 7) {
    return shape7;
  }
  return shape0;
}

function voteReadBlob(question: Int): String {
  const [blob0] = useState(voteQ0Blob);
  const [blob1] = useState(voteQ1Blob);
  const [blob2] = useState(voteQ2Blob);
  const [blob3] = useState(voteQ3Blob);
  const [blob4] = useState(voteQ4Blob);
