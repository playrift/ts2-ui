function voteStore(question: Int, shape: Int, answer: Int): void {
  const [, setShape0] = useState(voteQ0Shape);
  const [, setShape1] = useState(voteQ1Shape);
  const [, setShape2] = useState(voteQ2Shape);
  const [, setShape3] = useState(voteQ3Shape);
  const [, setShape4] = useState(voteQ4Shape);
  const [, setShape5] = useState(voteQ5Shape);
  const [, setShape6] = useState(voteQ6Shape);
  const [, setShape7] = useState(voteQ7Shape);
  const [, setAnswer0] = useState(voteQ0Answer);
  const [, setAnswer1] = useState(voteQ1Answer);
  const [, setAnswer2] = useState(voteQ2Answer);
  const [, setAnswer3] = useState(voteQ3Answer);
  const [, setAnswer4] = useState(voteQ4Answer);
  const [, setAnswer5] = useState(voteQ5Answer);
  const [, setAnswer6] = useState(voteQ6Answer);
  const [, setAnswer7] = useState(voteQ7Answer);

  if (question === 0) {
    setShape0(shape);
    setAnswer0(answer);
  } else if (question === 1) {
    setShape1(shape);
    setAnswer1(answer);
  } else if (question === 2) {
    setShape2(shape);
    setAnswer2(answer);
  } else if (question === 3) {
    setShape3(shape);
    setAnswer3(answer);
  } else if (question === 4) {
    setShape4(shape);
    setAnswer4(answer);
  } else if (question === 5) {
    setShape5(shape);
    setAnswer5(answer);
  } else if (question === 6) {
    setShape6(shape);
    setAnswer6(answer);
  } else if (question === 7) {
    setShape7(shape);
    setAnswer7(answer);
  }
}

