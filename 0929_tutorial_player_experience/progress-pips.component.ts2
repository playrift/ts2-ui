import { ExperienceLayout, ExperienceSprites } from './tutorial-player-experience.constants';

const PIP_STEPS = [0, 1, 2];

export function ProgressPips({ done }: { done: Int }): Component {
  return (
    <layer
      x={ExperienceLayout.PIP_X}
      y={ExperienceLayout.PIP_Y}
      w={(ExperienceLayout.PIP_SIZE + ExperienceLayout.PIP_GAP) * 3}
      h={ExperienceLayout.PIP_SIZE}
    >
      {PIP_STEPS.map((step, index) => (
        <sprite
          x={index * (ExperienceLayout.PIP_SIZE + ExperienceLayout.PIP_GAP)}
          y={0}
          w={ExperienceLayout.PIP_SIZE}
          h={ExperienceLayout.PIP_SIZE}
          sprite={index < done ? ExperienceSprites.PIP_ON : ExperienceSprites.PIP_OFF}
        />
      ))}
    </layer>
  );
}
