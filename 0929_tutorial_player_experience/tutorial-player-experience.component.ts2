import { textWidth } from '../lib/lib.engine';
import { SteelborderColor } from '../lib/lib.constants';
import { SteelBorder } from '../lib/steel-border.component';
import { ExperienceButton } from './experience-button.component';
import { ProgressPips } from './progress-pips.component';
import { ExperienceCopy, ExperienceFonts, ExperienceLayout } from './tutorial-player-experience.constants';

export function TutorialPlayerExperience(): Component {
  const labelNew: Int = textWidth(ExperienceCopy.LABEL_NEW, ExperienceLayout.BUTTON_MEASURE_W, ExperienceFonts.LABEL);
  const labelReturning: Int = textWidth(
    ExperienceCopy.LABEL_RETURNING,
    ExperienceLayout.BUTTON_MEASURE_W,
    ExperienceFonts.LABEL,
  );
  const labelExperienced: Int = textWidth(
    ExperienceCopy.LABEL_EXPERIENCED,
    ExperienceLayout.BUTTON_MEASURE_W,
    ExperienceFonts.LABEL,
  );

  const buttonWidth: Int =
    ExperienceLayout.LABEL_X +
    ExperienceLayout.LABEL_TAIL +
    Math.max(labelNew, Math.max(labelReturning, labelExperienced));

  const windowWidth: Int =
    ExperienceLayout.WINDOW_PADDING +
    Math.max(
      ExperienceLayout.TITLE_PADDING +
        textWidth(ExperienceCopy.TITLE, ExperienceLayout.UNBOUNDED, ExperienceFonts.TITLE),
      buttonWidth,
    );

  return (
    <>
      <layer x="center" y="center" w="fill" h="fill" noClickThrough />

      <layer x="center" y={{ center: ExperienceLayout.WINDOW_DY }} w={windowWidth} h={ExperienceLayout.WINDOW_H}>
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorder title={ExperienceCopy.TITLE} titleColor={SteelborderColor.TITLE} flags={1} />
          <ProgressPips done={ExperienceCopy.STEPS_DONE} />
        </layer>

        <layer
          x="center"
          y={ExperienceLayout.CONTENT_Y}
          w={{ fill: ExperienceLayout.CONTENT_INSET_W }}
          h={{ fill: ExperienceLayout.CONTENT_INSET_H }}
        >
          <ExperienceButton
            y={ExperienceLayout.BUTTON_Y_1}
            width={buttonWidth}
            labelWidth={labelNew}
            label={ExperienceCopy.LABEL_NEW}
            subject={ExperienceCopy.SUBJECT_NEW}
          />
          <ExperienceButton
            y={ExperienceLayout.BUTTON_Y_2}
            width={buttonWidth}
            labelWidth={labelReturning}
            label={ExperienceCopy.LABEL_RETURNING}
            subject={ExperienceCopy.SUBJECT_RETURNING}
          />
          <ExperienceButton
            y={ExperienceLayout.BUTTON_Y_3}
            width={buttonWidth}
            labelWidth={labelExperienced}
            label={ExperienceCopy.LABEL_EXPERIENCED}
            subject={ExperienceCopy.SUBJECT_EXPERIENCED}
          />

          <layer x={0} y={0} w={0} h={0} hide />
          <layer x={0} y={0} w={0} h={0} hide />
          <layer x={0} y={0} w={0} h={0} hide />
        </layer>
      </layer>
    </>
  );
}
