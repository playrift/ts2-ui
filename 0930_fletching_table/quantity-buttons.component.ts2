import { useState } from 'ts2';
import { StoneButtonEntrypoint } from '../lib/stone-button-entrypoint.component';
import { StoneButtonPressedEntrypoint } from '../lib/stone-button-pressed-entrypoint.component';
import { FletchColor, FletchFonts, Layout } from './fletching-table.constants';
import { pickCustomQuantity, pickPresetQuantity } from './fletching-table.helpers';

export function PresetButton({
  x,
  label,
  lit,
  preset,
  op,
}: {
  x: Int;
  label: String;
  lit: Int;
  preset: Int;
  op: String;
}): Component {
  const [hot, setHot] = useState(0);

  return (
    <layer
      x={x}
      y="center"
      w={Layout.BUTTON_W}
      h={Layout.BUTTON_H}
      options={[op]}
      onMouseEnter={() => {
        setHot(1);
      }}
      onMouseLeave={() => {
        setHot(0);
      }}
      onOptionSelect={() => {
        pickPresetQuantity(preset);
      }}
    >
      <text
        w="fill"
        h="fill"
        text={label}
        font={FletchFonts.CAPTION}
        color={lit === 1 ? FletchColor.HOVER : FletchColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
      <layer hide={hot === 1} w="fill" h="fill">
        <StoneButtonEntrypoint />
      </layer>
      <layer hide={hot === 0} w="fill" h="fill">
        <StoneButtonPressedEntrypoint />
      </layer>
    </layer>
  );
}

export function CustomButton({ x, lit, defaultOp }: { x: Int; lit: Int; defaultOp: String }): Component {
  const [hot, setHot] = useState(0);

  return (
    <layer
      x={x}
      y="center"
      w={Layout.BUTTON_W}
      h={Layout.BUTTON_H}
      options={[defaultOp, 'Set custom quantity']}
      onMouseEnter={() => {
        setHot(1);
      }}
      onMouseLeave={() => {
        setHot(0);
      }}
      onOptionSelect={() => {
        pickCustomQuantity();
      }}
    >
      <text
        w="fill"
        h="fill"
        text="X"
        font={FletchFonts.CAPTION}
        color={lit === 1 ? FletchColor.HOVER : FletchColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />
      <layer hide={hot === 1} w="fill" h="fill">
        <StoneButtonEntrypoint />
      </layer>
      <layer hide={hot === 0} w="fill" h="fill">
        <StoneButtonPressedEntrypoint />
      </layer>
    </layer>
  );
}
