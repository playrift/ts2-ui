import { createRef, useInterval } from 'ts2';

import { Anchor, overlayRelayout } from '../lib/lib.overlay';
import { BtColor, BtContentType, BtFonts, BtOverlay, BtSprites, Layout } from './sailing-bt-hud.constants';

const timerHost = createRef('0931_sailing_bt_hud_timer_host');

const content = createRef('sailing_bt_hud_content');

export function SailingBtHud(): Component {
  useInterval(() => overlayRelayout(timerHost, content, BtOverlay.DODGE, Anchor.LEFT, Anchor.TOP, 1), timerHost);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer w="fill" h="fill" ref={timerHost}>
        <layer ref={content} x={0} y={Layout.CONTENT_Y} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <layer x={Layout.TRIALS_X} y={0} w="fill" h="fill" contentType={BtContentType.BARRACUDA_TRIALS}>
            <layer x={0} y={0} w="fill" h={Layout.TOP_H}>
              <layer x={Layout.RESET_X} y="center" w={Layout.RESET_BOX} h={Layout.RESET_BOX} noClickThrough>
                <layer x="center" y="center" w="fill" h="fill" />

                <layer x={0} y={0} w="fill" h="fill" options={['*', '*', '*']} />
              </layer>

              <layer x={Layout.TITLE_X} y="center" w={Layout.TITLE_W} h={Layout.TITLE_H} />

              <sprite x={Layout.PARTIAL_GFX_X} y="center" w={Layout.PARTIAL_GFX_BOX} h={Layout.PARTIAL_GFX_BOX} />

              <text
                x={Layout.PARTIAL_TEXT_X}
                y="center"
                w={Layout.PARTIAL_TEXT_BOX}
                h={Layout.PARTIAL_TEXT_BOX}
                font={BtFonts.LARGE}
                color={BtColor.ORANGE}
                align="center"
                valign="middle"
                shadow
              />
            </layer>

            <layer x={0} y={Layout.MIDDLE_Y} w={Layout.MIDDLE_W} h={Layout.MIDDLE_H}>
              <layer x={Layout.EXPAND_X} y="center" w={Layout.EXPAND_BOX} h={Layout.EXPAND_BOX} noClickThrough>
                <layer x="center" y="center" w="fill" h="fill" />
              </layer>

              <layer
                x={Layout.MIDDLE_CONTENT_X}
                y={0}
                w={{ fill: Layout.MIDDLE_CONTENT_INSET_W }}
                h={Layout.MIDDLE_H}
              />
            </layer>

            <layer
              x={Layout.EXPAND_CLICK_X}
              y={Layout.EXPAND_CLICK_Y}
              w={Layout.EXPAND_CLICK_BOX}
              h={Layout.EXPAND_CLICK_BOX}
            />

            <layer x={0} y={Layout.COLUMNS_Y} w={Layout.LEFT_W} h={Layout.COLUMN_H}>
              <sprite
                x={Layout.LEFT_TICK_X}
                y={{ center: Layout.TICK_ABOVE }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
                sprite={BtSprites.OBJECTIVE_PRIMARY}
              />
              <sprite
                x={Layout.LEFT_TICK_X}
                y={{ center: Layout.TICK_BELOW }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
                sprite={BtSprites.OBJECTIVE_SECONDARY}
              />

              <text
                x={{ right: Layout.TIME_INSET_X }}
                y={{ center: Layout.TICK_ABOVE }}
                w={Layout.TIME_W}
                h={Layout.TIME_H}
                font={BtFonts.LARGE}
                color={BtColor.WHITE}
                align="center"
                valign="middle"
                shadow
              />
              <text
                x={{ right: Layout.TIME_INSET_X }}
                y={{ center: Layout.TICK_BELOW }}
                w={Layout.TIME_W}
                h={Layout.TIME_H}
                font={BtFonts.LARGE}
                color={BtColor.ORANGE}
                align="center"
                valign="middle"
                shadow
              />
            </layer>

            <layer x="right" y={Layout.COLUMNS_Y} w={{ fill: Layout.RIGHT_INSET_W }} h={Layout.COLUMN_H}>
              <sprite x={Layout.RANK_X} y="center" w={Layout.RANK_BOX} h={Layout.RANK_BOX} />
              <sprite
                x={Layout.RIGHT_TICK_X}
                y={{ center: Layout.TICK_ABOVE }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
              />
              <sprite
                x={Layout.RIGHT_TICK_X}
                y={{ center: Layout.TICK_BELOW }}
                w={Layout.TICK_BOX}
                h={Layout.TICK_BOX}
              />

              <text
                x={Layout.PROGRESS_X}
                y={{ center: Layout.TICK_ABOVE }}
                w={Layout.PROGRESS_W}
                h={Layout.PROGRESS_H}
                font={BtFonts.SMALL}
                color={BtColor.WHITE}
                valign="middle"
                shadow
              />
              <text
                x={Layout.PROGRESS_X}
                y={{ center: Layout.TICK_BELOW }}
                w={Layout.PROGRESS_W}
                h={Layout.PROGRESS_H}
                font={BtFonts.SMALL}
                color={BtColor.WHITE}
                valign="middle"
                shadow
              />
            </layer>
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
