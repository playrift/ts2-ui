import { useState } from 'ts2';

import { StoneButton } from '../lib/stone-button.component';
import { Frame } from '../lib/frame.component';
import { onMobile } from '../lib/lib.helpers';
import { SailingArt, SailingColors, SailingFonts } from './sailing-bt-selection.constants';

export function RankButtonSkin({ label, locked = 0 }: { label: String; locked?: Int }): Component {
  const [hovered, setHovered] = useState(0);
  const lit: Int = hovered;

  return (
    <layer
      w="fill"
      h="fill"
      onMouseEnter={
        locked === 1
          ? undefined
          : () => {
              if (!onMobile()) {
                setHovered(1);
              }
            }
      }
      onMouseLeave={locked === 1 ? undefined : () => setHovered(0)}
    >
      <sprite
        w="fill"
        h="fill"
        sprite={lit === 1 ? SailingArt.BUTTON_BACKDROP_HOVER : SailingArt.BUTTON_BACKDROP}
        tiling
      />

      {locked === 1 || lit === 1 ? (
        <Frame
          topLeft={921}
          topRight={922}
          bottomLeft={923}
          bottomRight={924}
          left={925}
          top={926}
          right={927}
          bottom={928}
        >
          <ButtonLabel label={label} lit={lit} />
        </Frame>
      ) : (
        <StoneButton>
          <ButtonLabel label={label} lit={lit} />
        </StoneButton>
      )}
    </layer>
  );
}

function ButtonLabel({ label, lit }: { label: String; lit: Int }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={SailingFonts.SMALL}
      color={lit === 1 ? SailingColors.BUTTON_LABEL_HOVER : SailingColors.BUTTON_LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}
