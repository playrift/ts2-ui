import { CurrentRankColumn, RankHitsPane, RankRowsPane, RewardHitsPane, TrialFrame } from './trial-panes.component';
import { Layout } from './sailing-bt-selection.constants';

export function SailingBtSelection(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer x="center" y="center" w={Layout.MAIN_W} h={Layout.MAIN_H}>
        <layer x={0} y={0} w="fill" h="fill">
          <TrialFrame />
        </layer>

        <layer x="center" y={Layout.WELL_TOP} w={{ fill: Layout.WELL_INSET_W }} h={{ fill: Layout.WELL_INSET_H }}>
          <layer x={0} y={0} w={Layout.LEFT_W} h="fill">
            <CurrentRankColumn />
          </layer>

          <layer x="right" y={0} w={{ fill: Layout.RIGHT_INSET_W }} h="fill">
            <RankRowsPane />
          </layer>

          <layer x="right" y={0} w={{ fill: Layout.RIGHT_INSET_W }} h="fill">
            <RankHitsPane />
          </layer>

          <layer x="right" y={0} w={{ fill: Layout.RIGHT_INSET_W }} h="fill">
            <RewardHitsPane />
          </layer>
        </layer>
      </layer>
    </layer>
  );
}
