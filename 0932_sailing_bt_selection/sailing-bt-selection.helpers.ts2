import { useServerState } from 'ts2';

import { chatMessage, playSound } from '../lib/lib.engine';
import { Varbits } from '../lib/game/varbits';
import { SailingSounds } from './sailing-bt-selection.constants';
import { SailingTrial } from './sailing-trials.data';

export function trialSlot(trial: Int): Int {
  if (trial === SailingTrial.TEMPOR_TANTRUM) {
    return 0;
  }
  if (trial === SailingTrial.JUBBLY_JIVE) {
    return 1;
  }
  if (trial === SailingTrial.GWENITH_GLIDE) {
    return 2;
  }
  return -1;
}

export function trialBestTime(trial: Int, rank: Int): Int {
  if (trial === SailingTrial.TEMPOR_TANTRUM) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_PB_SWORDFISH);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_PB_SHARK);
    }
    return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_PB_MARLIN);
  }
  if (trial === SailingTrial.JUBBLY_JIVE) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_PB_SWORDFISH);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_PB_SHARK);
    }
    return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_PB_MARLIN);
  }
  if (trial === SailingTrial.GWENITH_GLIDE) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_PB_SWORDFISH);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_PB_SHARK);
    }
    return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_PB_MARLIN);
  }
  return 0;
}

export function trialBonusClaimed(trial: Int, rank: Int): Int {
  if (trial === SailingTrial.TEMPOR_TANTRUM) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_SWORDFISH_FIRST);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_SHARK_FIRST);
    }
    return useServerState(Varbits.SAILING_BT_TEMPOR_TANTRUM_MARLIN_FIRST);
  }
  if (trial === SailingTrial.JUBBLY_JIVE) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_SWORDFISH_FIRST);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_SHARK_FIRST);
    }
    return useServerState(Varbits.SAILING_BT_JUBBLY_JIVE_MARLIN_FIRST);
  }
  if (trial === SailingTrial.GWENITH_GLIDE) {
    if (rank === 1) {
      return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_SWORDFISH_FIRST);
    }
    if (rank === 2) {
      return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_SHARK_FIRST);
    }
    return useServerState(Varbits.SAILING_BT_GWENITH_GLIDE_MARLIN_FIRST);
  }
  return 0;
}

export function formatDuration(seconds: Int): String {
  const minutes: Int = (seconds / 60) % 60;
  const hours: Int = seconds / 60 / 60;
  const rest: Int = seconds % 60;

  const hoursPart: String = hours > 0 ? `${hours}:` : '';
  const minutesPart: String = minutes < 10 && hours > 0 ? `0${minutes}:` : `${minutes}:`;
  const secondsPart: String = rest < 10 ? `0${rest}` : `${rest}`;

  return `${hoursPart}${minutesPart}${secondsPart}`;
}

export function attemptRank(unlocked: Int, rank: Int): void {
  if (unlocked === 0) {
    playSound(SailingSounds.DENIED);
    if (rank === 3) {
      chatMessage('You cannot attempt the Marlin rank until you have achieved Shark rank.');
      return;
    }
    if (rank === 2) {
      chatMessage('You cannot attempt the Shark rank until you have achieved Swordfish rank.');
      return;
    }
    chatMessage('You cannot attempt this rank until you have achieved the rank before it.');
    return;
  }
  playSound(SailingSounds.SELECT);
}
