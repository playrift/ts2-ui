import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Layout,
  StatsColor,
  StatsFonts,
  StatsLeft,
  StatsModel,
  StatsRight,
  StatsSprites,
} from './sailing-bt-statistics.constants';

export function SailingBtStatistics(): Component {
  return (
    <>
      <model
        x="center"
        y="center"
        w={Layout.TROPHY_BOX}
        h={Layout.TROPHY_BOX}
        model={StatsModel.TROPHY}
        zoom={StatsModel.ZOOM}
        pitch={StatsModel.PITCH}
        yaw={StatsModel.YAW}
        orthogonal
      />

      <layer x="center" y={{ center: Layout.CONTENT_Y }} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
        <sprite
          x={{ right: Layout.RANK_ICON_INSET_X }}
          y={Layout.RANK_ICON_Y}
          w={Layout.RANK_ICON}
          h={Layout.RANK_ICON}
        />

        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_INSET_W }} h={Layout.TITLE_BAND_H}>
          <text
            x="center"
            y="center"
            w={Layout.TITLE_W}
            h={{ fill: Layout.TITLE_INSET_H }}
            text="Barracuda Trial Statistics"
            font={StatsFonts.TITLE}
            color={StatsColor.TEXT}
            align="center"
            valign="middle"
            shadow
          />
        </layer>

        <layer x="center" y={Layout.STATS_Y} w={{ fill: Layout.STATS_INSET_W }} h={Layout.STATS_H}>
          {StatsLeft.map((row) => (
            <text
              x={Layout.ROW_INSET_X}
              y={row.y}
              w={Layout.ROW_W}
              h={Layout.ROW_H}
              text={row.text}
              font={StatsFonts.ROW}
              color={StatsColor.TEXT}
              align="center"
              valign="middle"
              shadow
            />
          ))}

          {StatsRight.map((row) => (
            <text
              x={{ right: Layout.ROW_INSET_X }}
              y={row.y}
              w={Layout.ROW_W}
              h={Layout.ROW_H}
              text={row.text}
              font={StatsFonts.ROW}
              color={StatsColor.TEXT}
              align="center"
              valign="middle"
              shadow
            />
          ))}
        </layer>
      </layer>

      <layer
        x={{ right: Layout.CLOSE_INSET_X }}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_BOX}
        h={Layout.CLOSE_BOX}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_ART_X}
          y={Layout.CLOSE_ART_Y}
          w={Layout.CLOSE_ART_W}
          h={Layout.CLOSE_ART_H}
          sprite={StatsSprites.CLOSE_REST}
          onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, StatsSprites.CLOSE_LIT)}
          onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, StatsSprites.CLOSE_REST)}
        />
      </layer>
    </>
  );
}
