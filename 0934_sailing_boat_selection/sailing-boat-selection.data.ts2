export type SailingBoatType = {
  name: String;
  displayName: String;
  sizeDesc: String;
  playerCapacity: Int;
  crewCapacity: Int;
  retrievalCost: Int;
  sprite: Sprite;
  hullFirst: Int;
  hullCount: Int;
  hotspotFirst: Int;
  hotspotCount: Int;
  brazierFirst: Int;
  brazierCount: Int;
};

export type SailingBoatHull = {
  name: String;
  recoveryCostPercent: Int;
};

export type SailingBoatHotspot = {
  optionFirst: Int;
  optionCount: Int;
};

export type SailingBoatFacility = {
  name: String;
  facilityType: Int;
  subtype: Int;
  sprite: Sprite;
  cargoCapacity: Int;
};

export type SailingBoatBrazier = {
  name: String;
  sprite: Sprite;
};

export type SailingDock = {
  rowId: Int;
  niceName: String;
  inlineName: String;
  sprite: Sprite;
};

export type BoatLocationState = {
  dock: Int;
  sprite: Sprite;
  name: String;
};

