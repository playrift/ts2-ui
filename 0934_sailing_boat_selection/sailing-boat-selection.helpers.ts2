export function boatTeleportFocus(slot: Int): Int {
  if (slot <= 0 || slot > 5) {
    debugMessageAlias(`Invalid boat id input. $boat was: ${slot}.`);
    return 0;
  }
  switch (slot) {
    case 1:
      return useServerState(SelectionVarbits.BOAT_1_TELEPORT_FOCUS);
    case 2:
      return useServerState(SelectionVarbits.BOAT_2_TELEPORT_FOCUS);
    case 3:
      return useServerState(SelectionVarbits.BOAT_3_TELEPORT_FOCUS);
    case 4:
      return useServerState(SelectionVarbits.BOAT_4_TELEPORT_FOCUS);
  }
  return useServerState(SelectionVarbits.BOAT_5_TELEPORT_FOCUS);
}

