export function boatOwned(slot: Int): Int {
  switch (slot) {
    case 1:
      return useServerState(SelectionVarbits.BOAT_1_OWNED);
    case 2:
      return useServerState(SelectionVarbits.BOAT_2_OWNED);
    case 3:
      return useServerState(SelectionVarbits.BOAT_3_OWNED);
    case 4:
      return useServerState(SelectionVarbits.BOAT_4_OWNED);
    case 5:
      return useServerState(SelectionVarbits.BOAT_5_OWNED);
  }
  debugMessageAlias(`Getting boat owned for invalid boat: ${slot}.`);
  return 0;
}

export function highestOwnedSlot(): Int {
  let slot: Int = 5;
  while (slot > 0) {
    if (boatOwned(slot) === 1) {
      return slot;
    }
    slot = slot - 1;
  }
  return 0;
}

