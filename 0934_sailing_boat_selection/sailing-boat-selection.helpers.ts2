export function unlockedSlots(): Int {
  const level: Int = useSkillBase(SelectionSkills.SAILING);
  if (level >= 91) {
    return 5;
  }
  if (level >= 78) {
    return 4;
  }
  if (level >= 50) {
    return 3;
  }
  if (level >= 15) {
    return 2;
  }
  return 1;
}

export function sailingAvailable(): Boolean {
  if (membersWorld() === false) {
    return false;
  }
  if (useServerState(SelectionVarbits.SAILING_INTRO) < 50) {
    return false;
  }
  if (useServerState(SelectionVarbits.RESTRICTED) >= 1) {
    return false;
  }
  return true;
}

export function selectionMode(): BoatSelectionMode | null {
  const type: Int = useServerState(SelectionVarbits.MODE);
  if (type < 1) {
    return null;
  }
  return BoatSelectionModes.at(type - 1);
}

export function panelTitle(): String {
  const mode = selectionMode();
  if (mode === null) {
    return 'Boats';
  }
  return mode.title;
}

export function selectionText(): String {
  const mode = selectionMode();
  if (mode === null) {
    return 'Select';
  }
  return mode.selectionText;
}

export function selectionEnabled(): Boolean {
  const mode = selectionMode();
  if (mode === null) {
    return true;
  }
  return mode.selectionEnabled;
}

export function showsRecentBoat(): Boolean {
  const mode = selectionMode();
  if (mode === null) {
    return true;
  }
  return mode.showRecentBoat;
}

export function showsBoatHealth(): Boolean {
  const mode = selectionMode();
  if (mode === null) {
