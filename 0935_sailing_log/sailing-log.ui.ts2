import { createRef } from 'ts2';
import { LogDropdownOverlay } from './charting-dropdown.component';
import { SailingLog } from './sailing-log.component';
import { sailingLogOpen } from './sailing-log.helpers';

const sailingLogRef = createRef('sailing_log');

export const sailingLogUi = (): UI => (
  <ui ref={sailingLogRef} w="fill" h="fill">
    <layer x={0} y={0} w={0} h={0} onLoad={() => sailingLogOpen()} />
    <SailingLog />
    <LogDropdownOverlay />
    <layer x="center" y="center" w="fill" h="fill" hide />
  </ui>
);
