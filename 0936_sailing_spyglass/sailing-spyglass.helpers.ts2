import { CS2 } from 'ts2';

import { SpyglassZoom } from './sailing-spyglass.constants';

export const spyglassSide = (height: Int): Int => {
  let clamped: Int = height;
  if (clamped < SpyglassZoom.MIN_HEIGHT) {
    clamped = SpyglassZoom.MIN_HEIGHT;
  } else if (clamped > SpyglassZoom.MAX_HEIGHT) {
    clamped = SpyglassZoom.MAX_HEIGHT;
  }
  return clamped;
};

export const spyglassZoom = (side: Int): Int => {
  const excess: Int = CS2.invpow(side - SpyglassZoom.MIN_HEIGHT, SpyglassZoom.ROOT);
  const full: Int = CS2.invpow(SpyglassZoom.MAX_HEIGHT - SpyglassZoom.MIN_HEIGHT, SpyglassZoom.ROOT);
  return SpyglassZoom.NEAR - CS2.interpolate(0, excess, 0, full, SpyglassZoom.SPAN);
};
