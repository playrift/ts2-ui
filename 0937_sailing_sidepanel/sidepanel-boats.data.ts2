export enum SidepanelBoat {
  RAFT = 0,
  SKIFF = 1,
  SLOOP = 2,
  WILL_AND_ANNE = 3,
}

export type SidepanelBoatRow = {
  playerCapacity: Int;
  crewCapacity: Int;
  combinedNavigation: Boolean;
  sailFirst: Int;
  sailCount: Int;
  helmFirst: Int;
  helmCount: Int;
  hullFirst: Int;
  hullCount: Int;
  hotspotFirst: Int;
  hotspotCount: Int;
};

export type SidepanelPart = {
  kind: Int;
  name: String;
  layout: Int;
  statType: Int;
  statLevel: Int;
};

export type SidepanelHotspot = {
  optionFirst: Int;
  optionCount: Int;
};

export type SidepanelLayoutRow = {
  widgetFirst: Int;
  widgetCount: Int;
  canLockIn: Boolean;
  canBeAssigned: Boolean;
  linked: Int;
  priority: Int;
  icon: Sprite;
};

export type SidepanelWidgetRow = {
  kind: Int;
  optext: String;
  sprite: Sprite;
  spriteSize: Int;
  caption: String;
  long: Boolean;
  op2: String;
  op2On: Boolean;
  op3: String;
  op3On: Boolean;
  op4: String;
  op4On: Boolean;
  toggleOn: Boolean;
  toggleOptextFirst: Int;
  toggleOptextCount: Int;
  toggleGraphicFirst: Int;
  toggleGraphicCount: Int;
  toggleCaptionFirst: Int;
  toggleCaptionCount: Int;
  obj: Int;
  amount: Int;
};

export type SidepanelGraphic = {
  sprite: Sprite;
  size: Int;
};

