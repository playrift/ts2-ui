import { useServerState } from 'ts2';
import { Varbits } from '../lib/game/varbits';
import { Varps } from '../lib/game/varps';
import { SidepanelAmmunition } from './sidepanel-ammunition.data';
import {
  SidepanelBoats,
  SidepanelHotspots,
  SidepanelLayouts,
  SidepanelParts,
  SidepanelWidgets,
} from './sidepanel-boats.data';
import { SidepanelCrew } from './sidepanel-crew.data';
import { boatIndex, crewPosition, crewSlot, hotspotOption } from './sidepanel-crew.helpers';

export enum SidepanelLayout {
  SAILS = 0,
  HELM = 1,
  HULL = 2,
  CANNON = 3,
  WIND_CATCHER = 4,
  GALE_CATCHER = 5,
  SALVAGING_HOOK = 6,
  CHUM_STATION = 7,
  TRAWLING_1 = 8,
  TRAWLING_2 = 9,
  TRAWLING_3 = 10,
}

export enum SidepanelWidget {
  SAILS_MAIN = 0,
  SAILS_SLOW = 1,
  SAILS_SPEED = 2,
  HELM_GRAPHIC = 3,
  HELM_TEXT = 4,
  HULL_GRAPHIC = 5,
  HULL_TEXT = 6,
  CANNON_FOLLOW = 7,
  CANNON_CLEAR = 8,
  CANNON_BALL = 9,
  WIND_BUTTON = 10,
  WIND_GRAPHIC_1 = 11,
  WIND_GRAPHIC_2 = 12,
  SALVAGING_GRAPHIC = 13,
  CHUM_GRAPHIC = 14,
  TRAWLING_GRAPHIC = 15,
  TRAWLING_LOWER_1 = 16,
  TRAWLING_RAISE = 17,
  TRAWLING_LOWER_2 = 18,
  TRAWLING_LOWER_3 = 19,
}

export enum FacilitySlotKind {
  HOTSPOT = 0,
  SAIL = 1,
  HELM = 2,
  HULL = 3,
}

export function boardedCombinedNavigation(): Boolean {
  const type: Int = useServerState(Varbits.SAILING_BOARDED_BOAT_TYPE);
  if (type < 0) {
    return false;
  }
  const boat = SidepanelBoats.at(type);
  if (boat === null) {
    return false;
  }
  return boat.combinedNavigation;
}

export function sailsLocked(): Boolean {
  const locked: Int = useServerState(Varbits.SAILING_BOAT_FACILITY_LOCKEDIN);
  return locked === 2 || locked === 3;
}

export function helmLocked(): Boolean {
  const locked: Int = useServerState(Varbits.SAILING_BOAT_FACILITY_LOCKEDIN);
  return locked === 1 || locked === 3;
}

export function facilityCode(kind: Int, hotspot: Int, combined: Boolean): Int {
  switch (kind) {
    case FacilitySlotKind.SAIL:
      return combined ? 4 : 2;
    case FacilitySlotKind.HELM:
      return combined ? 4 : 3;
    case FacilitySlotKind.HULL:
      return 5;
    case FacilitySlotKind.HOTSPOT:
      if (hotspot >= 0 && hotspot <= 12) {
        return 6 + hotspot;
      }
      return 0;
  }
  return 0;
}

export function facilityPlayers(code: Int): Int {
  switch (code) {
    case 2:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_SAILS);
    case 3:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_HELM);
    case 4:
      return (
        useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_SAILS) +
        useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_HELM)
      );
    case 6:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_0);
    case 7:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_1);
    case 8:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_2);
    case 9:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_3);
    case 10:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_4);
    case 11:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_5);
    case 12:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_6);
    case 13:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_7);
    case 14:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_8);
    case 15:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_9);
    case 16:
      return useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_AT_FACILITY_10);
    case 17:
      return useServerState(Varbits.VARBIT_20187);
    case 18:
      return useServerState(Varbits.VARBIT_20188);
  }
  return 0;
}

export function facilityCrew(kind: Int, hotspot: Int, combined: Boolean): Int {
  const code: Int = facilityCode(kind, hotspot, combined);
  let slot: Int = 0;
  while (slot <= 4) {
    if (crewPosition(slot) === code) {
      return crewSlot(slot);
    }
    slot = slot + 1;
  }
  return 0;
}

export function facilityAssignSprite(kind: Int, hotspot: Int, combined: Boolean): Sprite {
  if (facilityPlayers(facilityCode(kind, hotspot, combined)) > 0) {
    return 7103;
  }
  const crewId: Int = facilityCrew(kind, hotspot, combined);
  if (crewId < 1) {
    return 7102;
  }
  const row = SidepanelCrew.at(crewId - 1);
  if (row === null) {
    return 7102;
  }
  return row.sprite;
}

export function facilitySlotLayout(kind: Int, hotspot: Int, value: Int): Int {
  const b: Int = boatIndex();
  if (b < 0) {
    return -1;
  }
  const boat = SidepanelBoats.at(b);
  if (boat === null) {
    return -1;
  }
  let part: Int = -1;
  if (kind === FacilitySlotKind.SAIL) {
    part = value >= 0 && value < boat.sailCount ? boat.sailFirst + value : -1;
  } else if (kind === FacilitySlotKind.HELM) {
    part = value >= 0 && value < boat.helmCount ? boat.helmFirst + value : -1;
  } else if (kind === FacilitySlotKind.HULL) {
    part = value >= 0 && value < boat.hullCount ? boat.hullFirst + value : -1;
  } else if (hotspot >= 0 && hotspot < boat.hotspotCount) {
    const row = SidepanelHotspots.at(boat.hotspotFirst + hotspot);
    if (row !== null) {
      if (value - 1 >= 0 && value - 1 < row.optionCount) {
        part = row.optionFirst + value - 1;
      }
    }
  }
  if (part < 0) {
    return -1;
  }
  const option = SidepanelParts.at(part);
  if (option === null) {
    return -1;
  }
  return option.layout;
}

export function facilitySlotValue(kind: Int, hotspot: Int): Int {
  switch (kind) {
    case FacilitySlotKind.SAIL:
      return useServerState(Varbits.SAILING_SIDEPANEL_FACILITY_SAIL);
    case FacilitySlotKind.HELM:
      return useServerState(Varbits.SAILING_SIDEPANEL_FACILITY_HELM);
    case FacilitySlotKind.HULL:
      return useServerState(Varbits.SAILING_SIDEPANEL_FACILITY_HULL);
  }
  return hotspotOption(hotspot);
}

