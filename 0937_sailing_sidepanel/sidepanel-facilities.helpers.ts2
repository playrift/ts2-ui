function ammunitionTier(hotspot: Int): Int {
  switch (hotspot) {
    case 0:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_0);
    case 1:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_1);
    case 2:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_2);
    case 3:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_3);
    case 4:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_4);
    case 5:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_5);
    case 6:
      return useServerState(Varbits.SAILING_SIDEPANEL_AMMUNITION_TIER_6);
