export function ammunitionObject(id: Int): Int {
  if (id < 1) {
    return -1;
  }
  const row = SidepanelAmmunition.at(id - 1);
  if (row === null) {
    return -1;
  }
  return row.ammunitionObj as Int;
}

function canLockIn(layout: Int): Boolean {
  if (layout < 0) {
    return false;
  }
  const row = SidepanelLayouts.at(layout);
  if (row === null) {
    return false;
  }
  return row.canLockIn;
}

export function widgetState(layout: Int, widget: Int, hotspot: Int, crewAssigned: Boolean): Int {
  const role: Int = useServerState(Varbits.SAILING_SIDEPANEL_PLAYER_ROLE);
  const captain: Boolean = role === 10;
  let state: Int = 1;
  if (hotspot >= 0) {
    if (canLockIn(layout)) {
      const at: Int = useServerState(Varbits.SAILING_FACILITY_HOTSPOT_NUMBER);
      if (at > 0 && at - 1 === hotspot) {
        state = 0;
      }
      if (captain && crewAssigned) {
        state = 0;
      }
    } else if (captain) {
      state = 0;
    }
  }
  switch (layout) {
    case SidepanelLayout.SAILS:
      if (sailsLocked()) {
        state = 0;
      }
      if (captain && crewAssigned) {
        state = 0;
      }
      if (
        widget === SidepanelWidget.SAILS_MAIN &&
        useServerState(Varbits.SAILING_SIDEPANEL_SAIL_BUTTON_TOGGLED) === 1 &&
        state === 0
      ) {
        state = 2;
      }
      break;
    case SidepanelLayout.HELM:
      if (helmLocked()) {
        state = 0;
      }
      if (captain && crewAssigned) {
        state = 0;
      }
      if (
        (widget === SidepanelWidget.HELM_GRAPHIC || widget === SidepanelWidget.HELM_TEXT) &&
        useServerState(Varbits.SAILING_SIDEPANEL_HELM_STATUS) === 0
      ) {
        state = 1;
      }
      break;
    case SidepanelLayout.HULL:
      if (widget === SidepanelWidget.HULL_TEXT && useServerState(Varbits.SAILING_SIDEPANEL_REPAIRKITS) > 0) {
        state = 0;
      }
      break;
    case SidepanelLayout.WIND_CATCHER:
    case SidepanelLayout.GALE_CATCHER:
      if (role === 6) {
        state = 0;
      }
      break;
    case SidepanelLayout.CANNON:
      if (widget === SidepanelWidget.CANNON_CLEAR) {
        if (captain && crewAssigned) {
          state = weaponHasTarget(hotspot) === 1 ? 0 : 2;
        } else {
          state = 1;
        }
      } else if (widget === SidepanelWidget.CANNON_FOLLOW) {
        const mode: Int = weaponTargetMode(hotspot);
        if (mode >= 0 && mode <= 2) {
          state = captain && crewAssigned ? 0 : 1;
        }
      }
      break;
    case SidepanelLayout.CHUM_STATION:
      state = 0;
      break;
  }
  return state;
}

export function widgetToggle(layout: Int, widget: Int, hotspot: Int): Int {
  switch (layout) {
    case SidepanelLayout.SAILS:
      if (
        widget === SidepanelWidget.SAILS_MAIN ||
        widget === SidepanelWidget.SAILS_SLOW ||
        widget === SidepanelWidget.SAILS_SPEED
      ) {
        return useServerState(Varbits.SAILING_SIDEPANEL_BOAT_MOVE_MODE);
      }
      return 0;
    case SidepanelLayout.HELM:
      if (widget === SidepanelWidget.HELM_GRAPHIC || widget === SidepanelWidget.HELM_TEXT) {
        return useServerState(Varbits.SAILING_SIDEPANEL_HELM_STATUS);
      }
      return 0;
    case SidepanelLayout.TRAWLING_1:
    case SidepanelLayout.TRAWLING_2:
    case SidepanelLayout.TRAWLING_3:
      if (hotspot === useServerState(Varbits.SAILING_SIDEPANEL_BOAT_TRAWLING_NET_0_HOTSPOT_ID)) {
        return useServerState(Varbits.SAILING_SIDEPANEL_BOAT_TRAWLING_NET_0_DEPTH);
      }
      if (hotspot === useServerState(Varbits.SAILING_SIDEPANEL_BOAT_TRAWLING_NET_1_HOTSPOT_ID)) {
        return useServerState(Varbits.SAILING_SIDEPANEL_BOAT_TRAWLING_NET_1_DEPTH);
      }
      return 0;
    case SidepanelLayout.WIND_CATCHER:
    case SidepanelLayout.GALE_CATCHER: {
      const charges: Int = useServerState(Varbits.SAILING_SIDEPANEL_BOAT_WIND_CHARGES);
      if (widget === SidepanelWidget.WIND_BUTTON) {
        return charges >= 1 ? 1 : 0;
      }
      if (widget === SidepanelWidget.WIND_GRAPHIC_1) {
        return charges >= 2 ? 1 : 0;
      }
      if (widget === SidepanelWidget.WIND_GRAPHIC_2) {
        return charges >= 3 ? 1 : 0;
      }
      return 0;
    }
    case SidepanelLayout.CANNON:
      if (widget === SidepanelWidget.CANNON_BALL) {
        return ammunitionCount(hotspot);
      }
      if (widget === SidepanelWidget.CANNON_FOLLOW) {
        const mode: Int = weaponTargetMode(hotspot);
        if (mode >= 0 && mode <= 2) {
          return mode;
        }
      }
      return 0;
  }
  return 0;
}

export function widgetFlag(layout: Int, widget: Int): Boolean {
  if (layout === SidepanelLayout.HULL && widget === SidepanelWidget.HULL_TEXT) {
    return useServerState(Varbits.SAILING_SIDEPANEL_REPAIRKITS) > 0;
  }
  if (
    (layout === SidepanelLayout.WIND_CATCHER || layout === SidepanelLayout.GALE_CATCHER) &&
    widget === SidepanelWidget.WIND_BUTTON
  ) {
    return useServerState(Varbits.SAILING_SIDEPANEL_BOAT_WIND_CATCHER_ENABLED) === 1;
  }
  return false;
}

export function widgetAmmo(layout: Int, widget: Int, hotspot: Int): Int {
  if (layout !== SidepanelLayout.CANNON || widget !== SidepanelWidget.CANNON_BALL) {
    return -1;
  }
  const tier: Int = ammunitionTier(hotspot);
  if (tier === 0) {
    return -1;
  }
  return ammunitionObject(tier);
}

export function widgetOpMask(layout: Int, widget: Int, hotspot: Int): Int {
  let mask: Int = 1;
  const row = SidepanelWidgets.at(widget);
  if (row !== null) {
    if (row.kind === 0) {
      if (row.op2On) {
        mask = mask | 2;
      }
      if (row.op3On) {
        mask = mask | 4;
      }
      if (row.op4On) {
        mask = mask | 8;
      }
    }
  }
  if (layout === SidepanelLayout.CANNON && widget === SidepanelWidget.CANNON_FOLLOW) {
    switch (weaponTargetMode(hotspot)) {
      case 0:
        mask = mask & 9;
        break;
      case 1:
        mask = mask & 3;
        break;
      case 2:
        mask = mask & 5;
        break;
    }
  }
  return mask;
}
