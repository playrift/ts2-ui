  switch (hotspot) {
    case 0:
      return useServerState(Varbits.VARBIT_20189);
    case 1:
      return useServerState(Varbits.VARBIT_20190);
    case 2:
      return useServerState(Varbits.VARBIT_20191);
    case 3:
      return useServerState(Varbits.VARBIT_20192);
    case 4:
      return useServerState(Varbits.VARBIT_20193);
    case 5:
      return useServerState(Varbits.VARBIT_20194);
    case 6:
      return useServerState(Varbits.VARBIT_20195);
    case 7:
      return useServerState(Varbits.VARBIT_20196);
    case 8:
      return useServerState(Varbits.VARBIT_20197);
    case 9:
      return useServerState(Varbits.VARBIT_20198);
    case 10:
      return useServerState(Varbits.VARBIT_20199);
    case 11:
      return useServerState(Varbits.VARBIT_20203);
    case 12:
      return useServerState(Varbits.VARBIT_20205);
  }
  return 0;
}

