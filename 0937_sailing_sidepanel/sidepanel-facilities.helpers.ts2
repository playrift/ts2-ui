  switch (hotspot) {
    case 0:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_0_HAS_TARGET);
    case 1:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_1_HAS_TARGET);
    case 2:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_2_HAS_TARGET);
    case 3:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_3_HAS_TARGET);
    case 4:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_4_HAS_TARGET);
    case 5:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_5_HAS_TARGET);
    case 6:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_6_HAS_TARGET);
    case 7:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_7_HAS_TARGET);
    case 8:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_8_HAS_TARGET);
    case 9:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_9_HAS_TARGET);
    case 10:
      return useServerState(Varbits.SAILING_SIDEPANEL_WEAPON_10_HAS_TARGET);
    case 11:
      return useServerState(Varbits.VARBIT_20202);
    case 12:
      return useServerState(Varbits.VARBIT_20204);
  }
  return 0;
}

