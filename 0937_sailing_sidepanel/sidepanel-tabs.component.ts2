import { useServerState, useState } from 'ts2';
import { opsound } from '../lib/lib.helpers';
import { SidepanelColor, SidepanelTab, SidepanelVarbits, TAB_W, TabSprites } from './sailing-sidepanel.constants';
import { sidepanelSelectTab } from './sailing-sidepanel.helpers';
import { SidepanelTabIcons } from './sidepanel-tab-icons.data';

function tabX(tab: Int): Int {
  switch (tab) {
    case SidepanelTab.FACILITIES:
      return 4;
    case SidepanelTab.STATS:
      return 66;
    case SidepanelTab.CREW:
      return 128;
  }
  return -1;
}

export function TabRule(): Component {
  const selected: Int = useServerState(SidepanelVarbits.TAB);
  const transparent: Boolean = useServerState(SidepanelVarbits.SIDE_TRANSPARENCY) === 1;
  const selectedX: Int = tabX(selected);
  const color: Int = transparent ? SidepanelColor.RULE_TRANSPARENT : SidepanelColor.RULE_OPAQUE;
  return (
    <>
      {selectedX >= 0 && (
        <>
          <line x={0} y={{ bottom: 0 }} w={selectedX * 2} h={1} color={color} />
          <line x={selectedX + TAB_W} y={{ bottom: 0 }} w={500} h={1} color={color} />
        </>
      )}
    </>
  );
}

export function TabButton({ tab, label }: { tab: Int; label: String }): Component {
  const selected: Int = useServerState(SidepanelVarbits.TAB);
  const transparent: Boolean = useServerState(SidepanelVarbits.SIDE_TRANSPARENCY) === 1;
  const [hover, setHover] = useState(0);
  const isSelected: Boolean = selected === tab;
  const hot: Boolean = !isSelected && hover === 1;

  let edge: Sprite = TabSprites.IDLE_EDGE;
  let middle: Sprite = TabSprites.IDLE_MIDDLE;
  let underEdge: Sprite = TabSprites.IDLE_UNDER_EDGE;
  let underMiddle: Sprite = TabSprites.IDLE_UNDER_MIDDLE;
  if (isSelected) {
    edge = transparent ? TabSprites.SELECTED_EDGE_TRANSPARENT : TabSprites.SELECTED_EDGE;
    middle = transparent ? TabSprites.SELECTED_MIDDLE_TRANSPARENT : TabSprites.SELECTED_MIDDLE;
    underEdge = -1;
    underMiddle = -1;
  } else if (transparent) {
    edge = hot ? TabSprites.HOVER_EDGE_TRANSPARENT : TabSprites.IDLE_EDGE_TRANSPARENT;
    middle = hot ? TabSprites.HOVER_MIDDLE_TRANSPARENT : TabSprites.IDLE_MIDDLE_TRANSPARENT;
    underEdge = -1;
    underMiddle = -1;
  } else if (hot) {
    underEdge = TabSprites.HOVER_UNDER_EDGE;
    underMiddle = TabSprites.HOVER_UNDER_MIDDLE;
  }

  return (
    <layer
      x={0}
      y={0}
      w="fill"
      h="fill"
      options={[label]}
      onOptionSelect={(event) => {
        if (isSelected) {
          opsound(0, 0);
        } else {
          setHover(0);
          sidepanelSelectTab(event.option, tab);
        }
      }}
      onMouseRepeat={isSelected ? undefined : () => setHover(1)}
      onMouseLeave={isSelected ? undefined : () => setHover(0)}
    >
      <sprite x={0} y={{ bottom: 0 }} w={16} h={21} sprite={underEdge} transparency={200} />
      <sprite x={{ right: 0 }} y={{ bottom: 0 }} w={16} h={21} sprite={underEdge} transparency={200} hflip />
      <sprite x="center" y={{ bottom: 0 }} w={{ fill: 32 }} h={21} sprite={underMiddle} transparency={200} />
      <sprite x={0} y={{ bottom: 0 }} w={20} h={21} sprite={edge} />
      <sprite x={{ right: 0 }} y={{ bottom: 0 }} w={20} h={21} sprite={edge} hflip />
      <sprite x="center" y={{ bottom: 0 }} w={{ fill: 32 }} h={21} sprite={middle} />
      <sprite x="center" y={{ bottom: 0 }} w={20} h={20} sprite={SidepanelTabIcons.at(tab) ?? 7063} />
    </layer>
  );
}
