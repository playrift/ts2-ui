import { CrewColors, CrewFonts, CrewSprites, Layout } from './sailing-crew.constants';

export function ListPaneHeader({ title }: { title: String }): Component {
  return (
    <>
      <sprite x="center" y="top" w="fill" h={Layout.header.h} sprite={CrewSprites.BACKING} tiling transparency={0} />
      <rect x="center" y={0} w="fill" h={Layout.header.boxH} color={CrewColors.BOX_OUTER} />
      <rect x="center" y={1} w={{ fill: 2 }} h={Layout.header.boxH - 2} color={CrewColors.BOX_INNER} />
      <text
        x="center"
        y={Layout.header.textY}
        w="fill"
        h={Layout.header.h - Layout.header.textInsetH}
        text={title}
        font={CrewFonts.BODY}
        color={CrewColors.LABEL}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
