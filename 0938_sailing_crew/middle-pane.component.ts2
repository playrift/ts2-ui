import { useServerState, useUniverse } from 'ts2';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { textLineCount } from '../lib/lib.engine';
import { CrewButton } from './crew-button.component';
import { recruitColumnText, slotColumnText } from './sailing-crew.helpers';
import { CrewColors, CrewFonts, CrewSprites, CrewVarbits, Layout, Text } from './sailing-crew.constants';

const BLURB = 'Select which of your recruits will serve as crew on your boats whenever there is space for them.';

const COMPARISON_LABELS =
  ' <br> <br> <br> <br><col=ffb83f>Helmsmanship</col><br><col=ffb83f>Privateering</col><br><col=ffb83f>Deckhandiness</col>';

export function MiddlePane(): Component {
  const universe = useUniverse();
  const slot: Int = useServerState(CrewVarbits.SELECTED_SLOT);
  const recruit: Int = useServerState(CrewVarbits.SELECTED_CREW);

  const blurbHeight: Int = textLineCount(BLURB, universe.width, CrewFonts.BODY) * Text.LINE_HEIGHT + Text.BLURB_PADDING;

  return (
    <>
      <layer
        x="center"
        y={{ bottom: Layout.comparison.bottom }}
        w="fill"
        h={{ fill: blurbHeight + Layout.comparison.bottom }}
      >
        <sprite x="center" y="center" w="fill" h="fill" sprite={CrewSprites.BACKING} tiling transparency={0} />
        <ThinBoxEntrypoint />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text={COMPARISON_LABELS}
          font={CrewFonts.SMALL}
          color={CrewColors.LABEL}
          shadow
          align="center"
          valign="middle"
          lineHeight={Text.LINE_HEIGHT}
        />
        <text
          x={0}
          y="center"
          w="47%"
          h="fill"
          text={slotColumnText(slot)}
          font={CrewFonts.SMALL}
          color={CrewColors.LABEL}
          shadow
          align="center"
          valign="middle"
          lineHeight={Text.LINE_HEIGHT}
        />
        <text
          x={{ right: 0 }}
          y="center"
          w="47%"
          h="fill"
          text={recruitColumnText(slot, recruit)}
          font={CrewFonts.SMALL}
          color={CrewColors.LABEL}
          shadow
          align="center"
          valign="middle"
          lineHeight={Text.LINE_HEIGHT}
        />
      </layer>

      <layer
        x="center"
        y={{ bottom: Layout.button.assignBottom }}
        w={{ fill: Layout.button.insetW }}
        h={Layout.button.h}
      >
        <CrewButton label={`<col=0dc10d>Assign to crew slot ${slot + 1}</col>`} />
      </layer>

      <layer
        x="center"
        y={{ bottom: Layout.button.clearBottom }}
        w={{ fill: Layout.button.insetW }}
        h={Layout.button.h}
      >
        <CrewButton label={`<col=e5e500>Clear crew slot ${slot + 1}</col>`} />
      </layer>

      <text
        x="center"
        y="top"
        w="fill"
        h={blurbHeight}
        text={BLURB}
        font={CrewFonts.BODY}
        color={CrewColors.LABEL}
        shadow
        align="center"
        valign="middle"
        lineHeight={Text.LINE_HEIGHT}
      />
    </>
  );
}
