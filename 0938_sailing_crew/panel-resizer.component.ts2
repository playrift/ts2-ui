import { useState, useUniverse } from 'ts2';
import { crewPanel } from './sailing-crew.refs';
import { panelCeiling } from './sailing-crew.helpers';
import { PanelSize } from './sailing-crew.constants';

export function PanelResizer(): Component {
  const universe = useUniverse();
  const [, setSeen] = useState(0);

  universe.onResize = () => {
    setSeen(universe.height);
  };

  crewPanel.height = Math.min(universe.height - PanelSize.SLOT_MARGIN, panelCeiling());

  return <layer w={1} h={1} />;
}
