import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { CrewList } from './crew-list.component';
import { ListPaneHeader } from './list-pane-header.component';
import { MiddlePane } from './middle-pane.component';
import { RecruitsList } from './recruits-list.component';
import { CrewColors, CrewFonts, CrewSprites, Layout, Text } from './sailing-crew.constants';
import { crewPanel } from './sailing-crew.refs';

const LEGEND =
  '<col=ffb83f>Helmsmanship:</col> Crew can navigate larger boats.<br><col=ffb83f>Privateering:</col> Crew can fire more powerful cannons and deal more damage.<br><col=ffb83f>Deckhandiness:</col> Crew can operate superior facilities, help more with cargo, and more.';

export function SailingCrew(): Component {
  return (
    <layer static ref={crewPanel} x="center" y="center" w={Layout.panel.w} h={Layout.panel.h}>
      <layer x="center" y="center" w="fill" h="fill">
        <SteelBorderEntrypoint title="Crew Management" />
      </layer>

      <layer
        x="center"
        y={{ bottom: Layout.content.bottom }}
        w={{ fill: Layout.content.insetW }}
        h={{ fill: Layout.content.insetH }}
      >
        <layer w={Layout.column.w} h={{ fill: Layout.column.insetH }}>
          <layer x="center" y="bottom" w="fill" h={{ fill: Layout.header.h }}>
            <CrewList />
            <ThinBoxEntrypoint />
          </layer>
          <ListPaneHeader title="Current Crew" />
        </layer>

        <layer x={{ right: 0 }} w={Layout.column.w} h={{ fill: Layout.column.insetH }}>
          <layer x="center" y="bottom" w="fill" h={{ fill: Layout.header.h }}>
            <RecruitsList />
            <ThinBoxEntrypoint />
          </layer>
          <ListPaneHeader title="All Recruits" />
        </layer>

        <layer x="center" w={{ fill: Layout.middle.insetW }} h={{ fill: Layout.middle.insetH }}>
          <MiddlePane />
        </layer>

        <layer x="center" y={{ bottom: 0 }} w="fill" h={Layout.legend.h}>
          <sprite x="center" y="center" w="fill" h="fill" sprite={CrewSprites.BACKING} tiling transparency={0} />
          <ThinBoxEntrypoint />
          <text
            x="center"
            y="center"
            w={{ fill: Layout.legend.insetW }}
            h="fill"
            text={LEGEND}
            font={CrewFonts.BODY}
            color={CrewColors.LABEL}
            shadow
            align="center"
            valign="middle"
            lineHeight={Text.LINE_HEIGHT}
          />
        </layer>
      </layer>
    </layer>
  );
}
