import { CS2 } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { CrewColors, CrewFonts } from './sailing-crew.constants';

export function StoneButtonFilledDraw({ label, pressed = 0 }: { label: String; pressed?: Int }): Component {
  if (pressed === 1) {
    return (
      <StoneButtonPressedFilled>
        <StoneButtonLabel label={label} />
      </StoneButtonPressedFilled>
    );
  }
  return (
    <StoneButtonFilled>
      <StoneButtonLabel label={label} />
    </StoneButtonFilled>
  );
}

function StoneButtonLabel({ label }: { label: String }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={CrewFonts.BODY}
      color={CrewColors.LABEL}
      align="center"
      valign="middle"
      shadow
    />
  );
}

export function plainLabel(label: String): String {
  return CS2.tags_remove(label);
}
