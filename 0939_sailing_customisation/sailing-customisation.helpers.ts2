import { debugMessageAlias, errorMessage } from '../lib/lib.debug';
import { itemName } from '../lib/lib.engine';
import {
  CustomisationInventories,
  CustomisationItems,
  CustomisationSkills,
  CustomisationVarbits,
  CustomisationVarps,
} from './sailing-customisation.constants';
import {
  BoatPartOptions,
  BoatPartSlices,
  CustomisationBoat,
  CustomisationOption,
  CustomisationOptions,
  CustomisationTabs,
  HotspotFacilityOptions,
  INTRO_CARGO_HOLD,
