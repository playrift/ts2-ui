import { onMounted, onUpdated, useDerived, useOnResize, useSkillBase, useState, useUniverse } from 'ts2';
import { breakpointOf } from '../0654_league_info/league-info.helpers';
import { PortTasks } from '../0942_port_task_info/port-tasks.data';
import {
  PortTaskModel,
  dockIcon,
  isLargeBreakpoint,
  portTaskSlotOf,
  taskBackingBoard,
} from '../0942_port_task_info/port-tasks.helpers';
import { responsiveCurrentBreakpoint } from '../lib/game/varcs';
import { closeInterface, onMobile } from '../lib/lib.helpers';
import { BoardSkills, portTaskBoardTaskCardSlot } from './port-task-board.constants';
import {
  badgeDx,
  badgeDy,
  badgeFont,
  badgeSize,
  badgeSprite,
  boardCardGap,
  boardCardH,
  boardCardW,
  boardCardX,
  boardCardY,
  boardCardsDy,
  boardCloseRight,
  boardCloseTop,
  boardFrameH,
  boardFrameW,
  boardSlotDy,
  boardSlotH,
  boardSlotW,
  boardZoom,
  iconBountyDx,
  iconBountyDy,
  iconX,
  iconY,
  iconZoom,
  portTaskBoardSelect,
  tickDx,
  tickDy,
} from './port-task-board.helpers';
import {
  portTaskBoardShown,
  portTaskBoardTask0,
  portTaskBoardTask1,
  portTaskBoardTask2,
  portTaskBoardTask3,
  portTaskBoardTask4,
  portTaskBoardTask5,
  portTaskBoardTask6,
  portTaskBoardTask7,
} from './port-task-board.state';

export function PortTaskBoard(): Component {
  const root = useUniverse();
  useOnResize(root);
  const breakpoint: Int = breakpointOf(root.width, root.height);
  onMounted(() => publishBreakpoint(breakpoint));
  onUpdated(() => publishBreakpoint(breakpoint));

  const [shown] = useState(portTaskBoardShown);
  const large: Boolean = isLargeBreakpoint(breakpoint);
  const built: Boolean = shown === 1;

  onMounted(() => {
    portTaskBoardTaskCardSlot.props = {
      x: 'center',
      y: built ? { center: boardSlotDy(large) } : 'center',
      w: built ? boardSlotW(large) : 'fill',
      h: built ? boardSlotH(large) : 'fill',
    };
  });
  onUpdated(() => {
    portTaskBoardTaskCardSlot.props = {
      x: 'center',
      y: built ? { center: boardSlotDy(large) } : 'center',
      w: built ? boardSlotW(large) : 'fill',
      h: built ? boardSlotH(large) : 'fill',
    };
  });

  const [t0] = useState(portTaskBoardTask0);
  const [t1] = useState(portTaskBoardTask1);
  const [t2] = useState(portTaskBoardTask2);
  const [t3] = useState(portTaskBoardTask3);
  const [t4] = useState(portTaskBoardTask4);
  const [t5] = useState(portTaskBoardTask5);
  const [t6] = useState(portTaskBoardTask6);
  const [t7] = useState(portTaskBoardTask7);

  const o1: Int = t0 >= 0 ? 1 : 0;
  const o2: Int = o1 + (t1 >= 0 ? 1 : 0);
  const o3: Int = o2 + (t2 >= 0 ? 1 : 0);
  const o4: Int = o3 + (t3 >= 0 ? 1 : 0);
  const o5: Int = o4 + (t4 >= 0 ? 1 : 0);
  const o6: Int = o5 + (t5 >= 0 ? 1 : 0);
  const o7: Int = o6 + (t6 >= 0 ? 1 : 0);

  const sailing: Int = useSkillBase(BoardSkills.SAILING);

  return (
    <>
      <layer x="center" y="center" w={built ? boardFrameW(large) : 495} h={built ? boardFrameH(large) : 305}>
        <layer x="center" y="center" w="fill" h="fill">
          {built && (
            <model
              x="center"
              y={{ center: 2 }}
              w="fill"
              h="fill"
              model={PortTaskModel.BOARD_FRAME}
              pitch={512}
              zoom={boardZoom(large)}
            />
          )}
        </layer>

        <layer
          x="center"
          y={built ? { center: boardCardsDy(large) } : 'center'}
          w={built ? { fill: 12 } : 'fill'}
          h={built ? { fill: 12 } : 'fill'}
        >
          {built && t0 >= 0 && <BoardCard card={0} task={t0} order={0} large={large} sailing={sailing} />}
          {built && t1 >= 0 && <BoardCard card={1} task={t1} order={o1} large={large} sailing={sailing} />}
          {built && t2 >= 0 && <BoardCard card={2} task={t2} order={o2} large={large} sailing={sailing} />}
          {built && t3 >= 0 && <BoardCard card={3} task={t3} order={o3} large={large} sailing={sailing} />}
          {built && t4 >= 0 && <BoardCard card={4} task={t4} order={o4} large={large} sailing={sailing} />}
          {built && t5 >= 0 && <BoardCard card={5} task={t5} order={o5} large={large} sailing={sailing} />}
          {built && t6 >= 0 && <BoardCard card={6} task={t6} order={o6} large={large} sailing={sailing} />}
          {built && t7 >= 0 && <BoardCard card={7} task={t7} order={o7} large={large} sailing={sailing} />}
        </layer>

        <layer
          x={{ right: built ? boardCloseRight(large) : 14 }}
          y={built ? boardCloseTop(large) : 14}
          w={32}
          h={32}
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        >
          <CloseSprite />
        </layer>
      </layer>
    </>
  );
}

function publishBreakpoint(breakpoint: Int): void {
  const [, setBreakpoint] = useState(responsiveCurrentBreakpoint);
  setBreakpoint(breakpoint);
}

function CloseSprite(): Component {
  const [hover, setHover] = useState(0);
  return (
    <sprite
      x={4}
      y={5}
      w={26}
      h={23}
      sprite={hover === 1 ? 536 : 535}
      onMouseEnter={() => {
        if (!onMobile()) {
          setHover(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setHover(0);
        }
      }}
    />
  );
}

function BoardCard({
  card,
  task,
  order,
  large,
  sailing,
}: {
  card: Int;
  task: Int;
  order: Int;
  large: Boolean;
  sailing: Int;
}): Component {
  const row = PortTasks.at(task);
  const accepted: Int = useDerived(() => boardCardAcceptedSlot(task));
  if (row === null) {
    return null;
  }
  const x: Int = boardCardX(order, large);
  const y: Int = boardCardY(order, large);
  const w: Int = boardCardW(large);
  const h: Int = boardCardH(large);
  const zoom: Int = boardZoom(large);
  const size: Int = badgeSize(large);
  const bounty: Boolean = row.taskType === 1;
  const iconDock: Int = bounty ? row.startDock : row.cargoDock;

  return (
    <>
      <model
        x={x}
        y={y}
        w={w}
        h={h}
        model={row.graphic}
        pitch={512}
        zoom={zoom}
        options={['Select']}
        optionSubject={`<col=ff9040>${row.name}</col>`}
        onOptionSelect={() => portTaskBoardSelect(card)}
      />
      <sprite
        x={x + badgeDx(large)}
        y={y + badgeDy(large)}
        w={size}
        h={size}
        sprite={badgeSprite(large, sailing >= row.level)}
      />
      <text
        x={x + badgeDx(large)}
        y={y + badgeDy(large) + 1}
        w={size}
        h={size}
        text={`${row.level}`}
        font={badgeFont(large)}
        color={0xffffff}
        shadow
        align="center"
        valign="middle"
      />
      <model
        x={x + tickDx(large)}
        y={y + tickDy(large)}
        w={size}
        h={size}
        model={PortTaskModel.ACCEPTED}
        pitch={512}
        yaw={100}
        zoom={zoom}
        orthogonal
        hide={accepted === -1}
      />
      <rect x={1} y={1} w={1} h={1} transparency={255} />
      <model
        x={x + iconX(large) + (bounty ? iconBountyDx(large) : 0)}
        y={y + iconY(large) + (bounty ? iconBountyDy(large) : 0)}
        w={1}
        h={1}
        model={dockIcon(iconDock)}
        pitch={512}
        zoom={iconZoom(large)}
      />
    </>
  );
}

export function boardCardAcceptedSlot(task: Int): Int {
  const row = PortTasks.at(task);
  if (row === null) {
    return -1;
  }
  return portTaskSlotOf(row.taskId);
}
