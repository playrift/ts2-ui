import { useState } from 'ts2';
import { portTaskIndex } from '../0942_port_task_info/port-tasks.helpers';
import { TaskBoardLayoutIndex, TaskBoardLayouts } from '../0942_port_task_info/task-board-layouts.data';
import { clientClock, playSound } from '../lib/lib.engine';
import {
  portTaskBoardArmedAt0,
  portTaskBoardArmedAt1,
  portTaskBoardArmedAt2,
  portTaskBoardArmedAt3,
  portTaskBoardArmedAt4,
  portTaskBoardArmedAt5,
  portTaskBoardArmedAt6,
  portTaskBoardArmedAt7,
  portTaskBoardShown,
  portTaskBoardTask0,
  portTaskBoardTask1,
  portTaskBoardTask2,
  portTaskBoardTask3,
  portTaskBoardTask4,
  portTaskBoardTask5,
  portTaskBoardTask6,
  portTaskBoardTask7,
} from './port-task-board.state';

export function portTaskBoardOpen(
  task0: Int,
  task1: Int,
  task2: Int,
  task3: Int,
  task4: Int,
  task5: Int,
  task6: Int,
  task7: Int,
): void {
  const [, set0] = useState(portTaskBoardTask0);
  const [, set1] = useState(portTaskBoardTask1);
  const [, set2] = useState(portTaskBoardTask2);
  const [, set3] = useState(portTaskBoardTask3);
  const [, set4] = useState(portTaskBoardTask4);
  const [, set5] = useState(portTaskBoardTask5);
  const [, set6] = useState(portTaskBoardTask6);
  const [, set7] = useState(portTaskBoardTask7);
  const [, setShown] = useState(portTaskBoardShown);
  set0(portTaskIndex(task0));
  set1(portTaskIndex(task1));
  set2(portTaskIndex(task2));
  set3(portTaskIndex(task3));
  set4(portTaskIndex(task4));
  set5(portTaskIndex(task5));
  set6(portTaskIndex(task6));
  set7(portTaskIndex(task7));
  setShown(1);
}

export function portTaskBoardSelect(card: Int): void {
  const now: Int = clientClock();
  if (now < portTaskBoardArmedAt(card)) {
    return;
  }
  playSound(8415);
  portTaskBoardArm(card, now + 32);
}

function portTaskBoardArmedAt(card: Int): Int {
  const [a0] = useState(portTaskBoardArmedAt0);
  const [a1] = useState(portTaskBoardArmedAt1);
  const [a2] = useState(portTaskBoardArmedAt2);
  const [a3] = useState(portTaskBoardArmedAt3);
  const [a4] = useState(portTaskBoardArmedAt4);
  const [a5] = useState(portTaskBoardArmedAt5);
  const [a6] = useState(portTaskBoardArmedAt6);
  const [a7] = useState(portTaskBoardArmedAt7);
  switch (card) {
    case 0:
      return a0;
    case 1:
      return a1;
    case 2:
      return a2;
    case 3:
      return a3;
    case 4:
      return a4;
    case 5:
      return a5;
    case 6:
      return a6;
    case 7:
      return a7;
  }
  return 0;
}

function portTaskBoardArm(card: Int, until: Int): void {
  const [, s0] = useState(portTaskBoardArmedAt0);
  const [, s1] = useState(portTaskBoardArmedAt1);
  const [, s2] = useState(portTaskBoardArmedAt2);
  const [, s3] = useState(portTaskBoardArmedAt3);
  const [, s4] = useState(portTaskBoardArmedAt4);
  const [, s5] = useState(portTaskBoardArmedAt5);
  const [, s6] = useState(portTaskBoardArmedAt6);
  const [, s7] = useState(portTaskBoardArmedAt7);
  switch (card) {
    case 0:
      s0(until);
      return;
    case 1:
      s1(until);
      return;
    case 2:
      s2(until);
      return;
    case 3:
      s3(until);
      return;
    case 4:
      s4(until);
      return;
    case 5:
      s5(until);
      return;
    case 6:
      s6(until);
      return;
    case 7:
      s7(until);
      return;
  }
}

export function boardFrameW(large: Boolean): Int {
  return large ? 720 : 600;
}

export function boardFrameH(large: Boolean): Int {
  return large ? 470 : 392;
}

export function boardZoom(large: Boolean): Int {
  return large ? 1550 : 1800;
}

export function boardCardsDy(large: Boolean): Int {
  return large ? 7 : 5;
}

export function boardSlotDy(large: Boolean): Int {
  return large ? -16 : -14;
}

export function boardSlotW(large: Boolean): Int {
  return large ? 650 : 540;
}

export function boardSlotH(large: Boolean): Int {
  return large ? 454 : 377;
}

export function boardCloseRight(large: Boolean): Int {
  return large ? 65 : 45;
}

export function boardCloseTop(large: Boolean): Int {
  return large ? 55 : 39;
}

export function boardCardW(large: Boolean): Int {
  return large ? 98 : 85;
}

export function boardCardH(large: Boolean): Int {
  return large ? 140 : 120;
}

export function boardCardGap(large: Boolean): Int {
  return large ? 15 : 14;
}

export function boardCardX(order: Int, large: Boolean): Int {
  const first: Int = TaskBoardLayouts.at(TaskBoardLayoutIndex.BOARD).tasksOnFirstRow;
  const col: Int = order < first ? order : order - first;
  return (large ? 135 : 105) + col * (boardCardW(large) + boardCardGap(large));
}

export function boardCardY(order: Int, large: Boolean): Int {
  const first: Int = TaskBoardLayouts.at(TaskBoardLayoutIndex.BOARD).tasksOnFirstRow;
  const row: Int = order < first ? 0 : 1;
  return (large ? 74 : 57) + row * (boardCardH(large) + boardCardGap(large));
}

export function badgeDx(large: Boolean): Int {
  return large ? -3 : -1;
}

export function badgeDy(large: Boolean): Int {
  return large ? 53 : 49;
}

export function badgeFont(large: Boolean): Font {
  return large ? 496 : 494;
}

export function badgeSprite(large: Boolean, met: Boolean): Sprite {
  if (large) {
    return met ? 7107 : 7108;
  }
  return met ? 7109 : 7110;
}

export function badgeSize(large: Boolean): Int {
  return large ? 37 : 27;
}

export function tickDx(large: Boolean): Int {
  return large ? 30 : 29;
}

export function tickDy(large: Boolean): Int {
  return large ? 28 : 26;
}

export function iconX(large: Boolean): Int {
  return large ? 26 : 22;
}

export function iconY(large: Boolean): Int {
  return large ? 108 : 92;
}

export function iconZoom(large: Boolean): Int {
  return large ? 1450 : 1800;
}

export function iconBountyDx(large: Boolean): Int {
  return large ? 6 : 5;
}

export function iconBountyDy(large: Boolean): Int {
  return large ? 9 : 8;
}
