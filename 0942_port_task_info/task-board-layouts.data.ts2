export type TaskBoardLayout = {
  layoutId: Int;
  tasksOnFirstRow: Int;
  tasksOnSubsequentRows: Int;
};

export const TaskBoardLayouts = listOf<TaskBoardLayout>([
  { layoutId: 0, tasksOnFirstRow: 4, tasksOnSubsequentRows: 4 },
  { layoutId: 1, tasksOnFirstRow: 3, tasksOnSubsequentRows: 2 },
]);

export const enum TaskBoardLayoutIndex {
  BOARD = 0,
  LOG = 1,
}
