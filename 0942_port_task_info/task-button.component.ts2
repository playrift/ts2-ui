import { CS2, useState } from 'ts2';
import { StoneButtonDraw } from '../0705_clans_creation_sidepanel/stone-button.component';
import { onMobile } from '../lib/lib.helpers';
import { portTaskInfoAnswer, portTaskInfoBack } from './port-task-info.helpers';

export const enum TaskButtonAnswer {
  BACK = 0,
  ACCEPT = 1,
}

export function TaskButton({
  label,
  font,
  answer,
  live = 1,
}: {
  label: String;
  font: Font;
  answer: Int;
  live?: Int;
}): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onOptionSelect={
        live === 0
          ? null
          : () => {
              if (answer === TaskButtonAnswer.BACK) {
                portTaskInfoBack();
              } else {
                portTaskInfoAnswer();
              }
            }
      }
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
    >
      <StoneButtonDraw label={label} font={font} pressed={skin} />
    </layer>
  );
}
