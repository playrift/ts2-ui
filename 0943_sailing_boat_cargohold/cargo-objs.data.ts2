const CargoObjRuns = {
  FIRST_LO: 32435,
  FIRST_HI: 32808,
  SECOND_LO: 32924,
  SECOND_HI: 32925,
  THIRD_LO: 32936,
  THIRD_HI: 33001,
};

export function isCargo(item: Item): Boolean {
  if (item >= CargoObjRuns.FIRST_LO && item <= CargoObjRuns.FIRST_HI) {
    return true;
  }
  if (item >= CargoObjRuns.SECOND_LO && item <= CargoObjRuns.SECOND_HI) {
    return true;
  }
  if (item >= CargoObjRuns.THIRD_LO && item <= CargoObjRuns.THIRD_HI) {
    return true;
  }
  return false;
}
