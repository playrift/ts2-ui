export function CargoSlot({
  item,
  count,
  rank,
  margin,
  gap,
  mode,
}: {
  item: Item;
  count: Int;
  rank: Int;
  margin: Int;
  gap: Int;
  mode: Int;
}): Component {
  if (isCargo(item)) {
    return <CargoCrateSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
  }
  if (mode === WithdrawMode.FIVE) {
    return <WithdrawFiveSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
  }
  if (mode === WithdrawMode.TEN) {
    return <WithdrawTenSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
  }
  if (mode === WithdrawMode.X) {
    return <WithdrawXSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
  }
  if (mode === WithdrawMode.ALL) {
    return <WithdrawAllSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
  }
  return <WithdrawOneSlot item={item} count={count} rank={rank} margin={margin} gap={gap} />;
}
