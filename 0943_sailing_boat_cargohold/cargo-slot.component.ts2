import { itemName, playSound } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { isCargo } from './cargo-objs.data';
import { CargoColors, CargoSounds, Grid, Transparency } from './sailing-boat-cargohold.constants';

export const enum WithdrawMode {
  ONE = 0,
  FIVE = 1,
  ALL = 2,
  X = 3,
  TEN = 4,
}

interface SlotProps {
  item: Item;
  count: Int;
  rank: Int;
  margin: Int;
  gap: Int;
}

function CargoCrateSlot({ item, count, rank, margin, gap }: SlotProps): Component {
  return (
    <sprite
      x={margin + (rank % Grid.COLUMNS) * (Grid.W + gap)}
      y={Grid.TOP + (rank / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={CargoColors.SLOT_SHADOW}
      transparency={Transparency.CLEAR}
      options={['Withdraw']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={(event) => {
        if (event.option === 10) {
          return;
        }
        playSound(CargoSounds.SELECT);
        flashFor(event.self, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}

function WithdrawOneSlot({ item, count, rank, margin, gap }: SlotProps): Component {
  return (
    <sprite
      x={margin + (rank % Grid.COLUMNS) * (Grid.W + gap)}
      y={Grid.TOP + (rank / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={CargoColors.SLOT_SHADOW}
      transparency={Transparency.CLEAR}
      options={['Withdraw-1', '', 'Withdraw-5', 'Withdraw-10', 'Withdraw-X', 'Withdraw-All', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={(event) => {
        if (event.option === 10) {
          return;
        }
        playSound(CargoSounds.SELECT);
        flashFor(event.self, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}

