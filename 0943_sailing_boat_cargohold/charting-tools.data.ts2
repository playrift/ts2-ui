export enum ToolGate {
  NONE = 0,
  SPYGLASS = 1,
  CURRENT_DUCK = 2,
  CROWBAR = 3,
  DIVING_GEAR = 4,
}

export interface ChartingTool {
  name: String;
  tool: ItemName;
  tool2: ItemName;
  gate: ToolGate;
}

export const ChartingTools = listOf<ChartingTool>([
  { name: "Captain's log", tool: 31986, tool2: -1, gate: ToolGate.NONE },
  { name: 'Spyglass', tool: 31803, tool2: -1, gate: ToolGate.SPYGLASS },
  { name: 'Current duck', tool: 31805, tool2: -1, gate: ToolGate.CURRENT_DUCK },
  { name: 'Crowbar', tool: 31807, tool2: -1, gate: ToolGate.CROWBAR },
  { name: 'Diving gear', tool: 7534, tool2: 7535, gate: ToolGate.DIVING_GEAR },
]);
