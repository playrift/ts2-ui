import { useState } from 'ts2';
import { StoneButtonFilled } from '../lib/stone-button-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { onMobile } from '../lib/lib.helpers';
import { CargoColors, CargoSprites, DepositButton, Transparency } from './sailing-boat-cargohold.constants';

export function DepositAllButton({
  label,
  icon = -1,
  sprite = -1,
}: {
  label: String;
  icon?: ItemName;
  sprite?: Sprite;
}): Component {
  const [hovered, setHovered] = useState(0);
  const lit: Int = hovered;

  return (
    <layer
      w="fill"
      h="fill"
      options={['Deposit']}
      optionSubject={`<col=ff9040>${label}</col>`}
      onMouseEnter={() => {
        if (!onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => setHovered(0)}
    >
      {lit === 1 ? <StoneButtonPressedFilled /> : <StoneButtonFilled />}
      {icon !== -1 ? (
        <sprite
          x={{ center: DepositButton.icon.dx }}
          y={{ center: DepositButton.icon.dy }}
          w={DepositButton.icon.w}
          h={DepositButton.icon.h}
          item={icon}
          itemCount={1}
          itemCountMode="never"
          outline={1}
          shadowColor={CargoColors.SLOT_SHADOW}
          transparency={Transparency.CLEAR}
        />
      ) : (
        <sprite
          x={{ center: DepositButton.sprite.dx }}
          y={{ center: DepositButton.sprite.dy }}
          w={DepositButton.sprite.w}
          h={DepositButton.sprite.h}
          sprite={sprite}
        />
      )}
      <sprite
        x={DepositButton.arrow.x}
        y={{ bottom: DepositButton.arrow.y }}
        w={DepositButton.arrow.w}
        h={DepositButton.arrow.h}
        sprite={CargoSprites.DEPOSIT_ARROW}
        hflip
      />
    </layer>
  );
}
