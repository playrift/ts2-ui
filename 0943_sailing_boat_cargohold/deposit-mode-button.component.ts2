import { predictServerState, useServerState, useState } from 'ts2';
import { playSound } from '../lib/lib.engine';
import { onMobile, opsound } from '../lib/lib.helpers';
import { StoneButtonFilledDraw, plainLabel } from './stone-button.component';
import { CargoSounds, CargoVarbits } from './sailing-boat-cargohold.constants';

export function DepositModeButton({ label, mode }: { label: String; mode: Int }): Component {
  const selected: Int = useServerState(CargoVarbits.DEPOSIT_MODE);
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  if (selected === mode) {
    return (
      <layer w="fill" h="fill" options={[plainLabel(label)]} onOptionSelect={(event) => opsound(event.option, 2)}>
        <StoneButtonFilledDraw label={`<col=ffffff>${label}</col>`} pressed={1} />
      </layer>
    );
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={[plainLabel(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(CargoSounds.SELECT);
        predictServerState(CargoVarbits.DEPOSIT_MODE, mode);
      }}
    >
      <StoneButtonFilledDraw label={label} pressed={skin} />
    </layer>
  );
}
