import { useServerState } from 'ts2';
import { heldTotal } from './sailing-boat-cargohold.helpers';
import { CargoColors, CargoFonts, CargoVarbits, CargoVarps } from './sailing-boat-cargohold.constants';

export function HeldCount(): Component {
  const holdId: Int = useServerState(CargoVarps.HOLD_INV);
  const stacked: Int = useServerState(CargoVarbits.DRAW_STACKED);
  const held: Int = heldTotal(holdId as Inventory, stacked);

  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={`${held}`}
      font={CargoFonts.SMALL}
      color={CargoColors.LABEL}
      shadow
      align="center"
      valign="top"
    />
  );
}
