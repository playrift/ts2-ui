import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { CargoHoldPane } from './cargo-hold-pane.component';
import { DepositAllButton } from './deposit-all-button.component';
import { DepositModeButton } from './deposit-mode-button.component';
import { HeldCount } from './held-count.component';
import { StackToggle } from './stack-toggle.component';
import { ToolsBar } from './tools-bar.component';
import { WithdrawMode } from './cargo-slot.component';
import {
  CargoColors,
  CargoFonts,
  CargoItems,
  CargoSprites,
  Layout,
  Transparency,
} from './sailing-boat-cargohold.constants';

const WARNING =
  'Items deposited here may be retrieved by <col=ffff00>other crewmates</col>, and are considered to be <col=ffff00>possessions of the Captain</col>.';

const DEPOSIT_MODES = [
  { label: '1', mode: WithdrawMode.ONE },
  { label: '5', mode: WithdrawMode.FIVE },
  { label: '10', mode: WithdrawMode.TEN },
  { label: 'X', mode: WithdrawMode.X },
  { label: 'All', mode: WithdrawMode.ALL },
];

export function SailingBoatCargohold(): Component {
  return (
    <>
      <layer w="fill" h="fill" />

      <layer x={Layout.count.x} y={Layout.count.y} w={Layout.count.w} h={Layout.count.h}>
        <HeldCount />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          font={CargoFonts.SMALL}
          color={CargoColors.LABEL}
          shadow
          align="center"
          valign="bottom"
        />
        <line x="center" y={{ center: -1 }} w={Layout.count.ruleW} color={CargoColors.LABEL} lineWidth={1} />
      </layer>

      <StackToggle x={Layout.toggle.x} y={Layout.toggle.y} w={Layout.toggle.w} h={Layout.toggle.h} />

      <text
        x={Layout.warning.x}
        y={Layout.warning.y}
        w={{ fill: Layout.warning.insetW }}
        h={Layout.warning.h}
        text={WARNING}
        font={CargoFonts.BODY}
        color={CargoColors.WHITE}
        shadow
        align="center"
        valign="middle"
      />

      <layer x={Layout.hold.x} y={Layout.hold.y} w={{ fill: Layout.hold.insetW }} h={{ fill: Layout.hold.insetH }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.hold.dimInset }}
          h={{ fill: Layout.hold.dimInset }}
          fill
          color={CargoColors.WHITE}
          transparency={Transparency.DIM}
        />
        <CargoHoldPane />
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x={{ right: Layout.deposit.right }}
        y={Layout.deposit.y}
        w={Layout.deposit.w}
        h={{ fill: Layout.deposit.insetH }}
      >
        <DepositAllButton x="center" y={0} w="fill" h={Layout.deposit.h} label="Cargo" icon={CargoItems.CARGO_DUMMY} />
        <DepositAllButton
          x="center"
          y={Layout.deposit.gap}
          w="fill"
          h={Layout.deposit.h}
          label="Salvage"
          icon={CargoItems.SALVAGE_DUMMY}
        />
        <DepositAllButton
          x="center"
          y={Layout.deposit.gap * 2}
          w="fill"
          h={Layout.deposit.h}
          label="Inventory"
          sprite={CargoSprites.INVENTORY_ICON}
        />
      </layer>

      <ToolsBar />

      <layer
        x={{ right: Layout.modes.right }}
        y={{ bottom: Layout.modes.bottom }}
        w={Layout.modes.w}
        h={Layout.modes.h}
      >
        {DEPOSIT_MODES.map((button, index) => (
          <layer x={{ center: (index - 2) * Layout.modes.spread }} y="center" w={Layout.modes.buttonW} h="fill">
            <DepositModeButton label={button.label} mode={button.mode} />
          </layer>
        ))}
      </layer>
    </>
  );
}
