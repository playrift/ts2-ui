import { predictServerState, useServerState, useState } from 'ts2';
import { Frame } from '../lib/frame.component';
import { chatMessage, playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { stackingWouldChangeAnything } from './sailing-boat-cargohold.helpers';
import {
  CargoColors,
  CargoFonts,
  CargoSounds,
  CargoSprites,
  CargoVarbits,
  CargoVarps,
  StackToggleLayout,
  StackToggleSprites,
} from './sailing-boat-cargohold.constants';

const NOTHING_TO_STACK = "There isn't any non-stackable items in this cargo hold that can be stacked or unstacked.";

export function StackToggle(): Component {
  const stacked: Int = useServerState(CargoVarbits.DRAW_STACKED);
  const holdId: Int = useServerState(CargoVarps.HOLD_INV);
  const [hovered, setHovered] = useState(0);
  const lit: Int = hovered;

  const worthDoing: Boolean = stackingWouldChangeAnything(holdId as Inventory);

  let label: String = 'Stack items';
  let icon: Sprite = CargoSprites.STACK_ON;
  if (stacked === 1) {
    label = 'Un-stack items';
    icon = CargoSprites.STACK_OFF;
  }

  let labelColor: Int = CargoColors.TOGGLE_LABEL;
  if (lit === 1) {
    labelColor = CargoColors.WHITE;
  }

  return (
    <layer
      w="fill"
      h="fill"
      options={['Toggle']}
      optionSubject="<col=ff9040>Item stacking</col>"
      onMouseEnter={() => {
        if (!onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => setHovered(0)}
      onOptionSelect={() => {
        if (!worthDoing) {
          chatMessage(NOTHING_TO_STACK);
          playSound(CargoSounds.REFUSED);
          return;
        }
        predictServerState(CargoVarbits.DRAW_STACKED, 1 - stacked);
        playSound(CargoSounds.SELECT);
      }}
    >
      {lit === 1 ? <StackToggleSkinPressed /> : <StackToggleSkin />}
      <sprite
        x={StackToggleLayout.icon.x}
        y={StackToggleLayout.label.y}
        w={StackToggleLayout.icon.size}
        h={StackToggleLayout.icon.size}
        sprite={icon}
      />
      <text
        x={StackToggleLayout.label.x}
        y={StackToggleLayout.label.y}
        w={{ fill: StackToggleLayout.label.insetW }}
        h={{ fill: StackToggleLayout.label.insetH }}
        text={label}
        font={CargoFonts.BODY}
        color={labelColor}
        shadow
        align="center"
        valign="middle"
        lineHeight={StackToggleLayout.label.lineHeight}
      />
    </layer>
  );
}

function StackToggleSkin(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={0} y={0} w="fill" h="fill" sprite={StackToggleSprites.BACKDROP} tiling />
      <Frame
        topLeft={913}
        topRight={914}
        bottomLeft={915}
        bottomRight={916}
        left={917}
        top={918}
        right={919}
        bottom={920}
      />
    </layer>
  );
}

function StackToggleSkinPressed(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={0} y={0} w="fill" h="fill" sprite={StackToggleSprites.BACKDROP_DARK} tiling />
      <Frame
        topLeft={921}
        topRight={922}
        bottomLeft={923}
        bottomRight={924}
        left={925}
        top={926}
        right={927}
        bottom={928}
      />
    </layer>
  );
}
