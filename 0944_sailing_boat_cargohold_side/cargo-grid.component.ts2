import { useInventory, useRef, useServerState } from 'ts2';
import { hasBit, itemName, playSound } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import {
  Cargo,
  CargoColors,
  CargoItems,
  CargoSounds,
  CargoVarbits,
  CargoVarps,
  FADE_CYCLES,
  Grid,
  Transparency,
} from './sailing-boat-cargohold-side.constants';

const enum DepositMode {
  ONE = 0,
  FIVE = 1,
  ALL = 2,
  X = 3,
  TEN = 4,
}

function DepositSlotOne({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  const cell = useRef();

  return (
    <sprite
      ref={cell}
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={CargoColors.SLOT_SHADOW}
      transparency={Transparency.CLEAR}
      dragDeadZone={Grid.DRAG_DEAD_ZONE}
      dragDeadTime={Grid.DRAG_DEAD_TIME}
      options={['Deposit-1', '', 'Deposit-5', 'Deposit-10', 'Deposit-X', 'Deposit-All', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
      onOptionSelect={(event) => {
        if (event.option === 10) {
          return;
        }
        playSound(CargoSounds.SELECT);
        flashFor(cell, Transparency.FLASH, Transparency.CLEAR);
      }}
    />
  );
}

