function RefusedSlot({ item, count, slot }: { item: Item; count: Int; slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={item}
      itemCount={count}
      outline={1}
      shadowColor={CargoColors.SLOT_SHADOW}
      transparency={Transparency.REFUSED}
      dragDeadZone={Grid.DRAG_DEAD_ZONE}
      dragDeadTime={Grid.DRAG_DEAD_TIME}
      options={['Deposit', '', '', '', '', '', '', '', '', 'Examine']}
      optionSubject={`<col=ff9040>${itemName(item)}</col>`}
    />
  );
}

function BlankSlot({ slot }: { slot: Int }): Component {
  return (
    <sprite
      x={Grid.ORIGIN_X + (slot % Grid.COLUMNS) * Grid.STRIDE_X}
      y={Grid.ORIGIN_Y + (slot / Grid.COLUMNS) * Grid.STRIDE_Y}
      w={Grid.W}
      h={Grid.H}
      item={CargoItems.BLANK}
      itemCount={1}
      outline={1}
      shadowColor={CargoColors.SLOT_SHADOW}
      transparency={Transparency.EMPTY}
    />
  );
}

function CargoSlot({
  item,
  count,
  slot,
  whitelist,
  mode,
}: {
  item: Item;
  count: Int;
  slot: Int;
  whitelist: Int;
  mode: Int;
}): Component {
  if (item === -1) {
    return <BlankSlot slot={slot} />;
  }
  if (!hasBit(whitelist, slot)) {
    return <RefusedSlot item={item} count={count} slot={slot} />;
  }
  if (mode === DepositMode.FIVE) {
    return <DepositSlotFive item={item} count={count} slot={slot} />;
  }
  if (mode === DepositMode.TEN) {
    return <DepositSlotTen item={item} count={count} slot={slot} />;
  }
  if (mode === DepositMode.X) {
    return <DepositSlotX item={item} count={count} slot={slot} />;
  }
  if (mode === DepositMode.ALL) {
    return <DepositSlotAll item={item} count={count} slot={slot} />;
  }
  return <DepositSlotOne item={item} count={count} slot={slot} />;
}

export function CargoGrid(): Component {
  const bag = useInventory(Cargo.INV);
  const whitelist: Int = useServerState(CargoVarps.WHITELIST);
  const mode: Int = useServerState(CargoVarbits.DEPOSIT_MODE);

  return (
    <layer w="fill" h="fill">
      {bag.map((item, slot) => (
        <CargoSlot item={item} count={bag.count(slot)} slot={slot} whitelist={whitelist} mode={mode} />
      ))}
    </layer>
  );
}
