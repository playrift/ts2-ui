import { useState } from 'ts2';
import { clientClock, playSound } from '../lib/lib.engine';
import { ButtonBackground } from '../0370_poh_options/button-background.component';
import { ButtonBackgroundPressed } from '../0551_raids_storage_side/button-background-pressed.component';
import { CargoColors, CargoFonts, CargoSounds, Overlay, PRESS_CYCLES } from './sailing-boat-cargohold-side.constants';

const DISMISS = 'Dismiss';

export function DismissButton(): Component {
  const [pressedUntil, setPressedUntil] = useState(0);

  if (pressedUntil !== 0) {
    return (
      <layer
        x="center"
        y={{ bottom: Overlay.BUTTON_Y }}
        w={Overlay.BUTTON_W}
        h={Overlay.BUTTON_H}
        options={[DISMISS]}
        onTimer={() => {
          if (clientClock() < pressedUntil) {
            return;
          }
          setPressedUntil(0);
        }}
      >
        <ButtonBackgroundPressed />
        <text
          x="center"
          y="center"
          w="fill"
          h="fill"
          text="---"
          font={CargoFonts.BODY}
          color={CargoColors.WHITE}
          shadow
          align="center"
          valign="middle"
        />
      </layer>
    );
  }

  return (
    <layer
      x="center"
      y={{ bottom: Overlay.BUTTON_Y }}
      w={Overlay.BUTTON_W}
      h={Overlay.BUTTON_H}
      options={[DISMISS]}
      onOptionSelect={(event) => {
        if (event.option !== 1) {
          return;
        }
        playSound(CargoSounds.SELECT);
        setPressedUntil(clientClock() + PRESS_CYCLES);
      }}
    >
      <ButtonBackground />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={DISMISS}
        font={CargoFonts.BODY}
        color={CargoColors.LABEL}
        hover={{ color: CargoColors.WHITE }}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
