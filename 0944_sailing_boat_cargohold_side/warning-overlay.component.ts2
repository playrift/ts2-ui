import { useServerState } from 'ts2';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { DismissButton } from './dismiss-button.component';
import {
  CargoColors,
  CargoFonts,
  CargoSprites,
  CargoVarbits,
  Overlay,
  Transparency,
} from './sailing-boat-cargohold-side.constants';

const WARNING =
  'Items deposited here may be retrieved by <col=ffff00>other crewmates</col>, and are considered to be <col=ffff00>possessions of the Captain</col>.';

export function WarningOverlay(): Component {
  const dismissed: Int = useServerState(CargoVarbits.WARNING_DISMISSED);

  if (dismissed === 1) {
    return null;
  }

  return (
    <layer w="fill" h="fill" noClickThrough>
      <rect
        x="center"
        y="center"
        w={{ fill: Overlay.DIM_OUTER_INSET }}
        h={{ fill: Overlay.DIM_OUTER_INSET }}
        fill
        color={CargoColors.DIM}
        transparency={Transparency.DIM}
      />
      <rect
        x="center"
        y="center"
        w={{ fill: Overlay.DIM_INNER_INSET }}
        h={{ fill: Overlay.DIM_INNER_INSET }}
        fill
        color={CargoColors.DIM}
        transparency={Transparency.DIM}
      />

      <layer x="center" y="center" w={Overlay.BOX_W} h={Overlay.BOX_H}>
        <sprite w="fill" h="fill" sprite={CargoSprites.BACKING} tiling />
        <text
          x="center"
          y={Overlay.TEXT_Y}
          w={{ fill: Overlay.TEXT_INSET_X }}
          h={{ fill: Overlay.TEXT_INSET_Y }}
          text={WARNING}
          font={CargoFonts.BODY}
          color={CargoColors.WHITE}
          shadow
          align="center"
          valign="middle"
        />
        <DismissButton />
        <SteelFrameEntrypoint />
      </layer>
    </layer>
  );
}
