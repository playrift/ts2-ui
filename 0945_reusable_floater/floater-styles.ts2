import {
  FloaterButtonSkin,
  FloaterButtonSkins,
  FloaterButtonStyle,
  FloaterButtonStyles,
  FloaterRow,
  FloaterRows,
  HEADING_STYLE,
  NONE,
} from './reusable-floater.data';

export function setStyle(index: Int): Int {
  const row: FloaterRow | null = FloaterRows.at(index);
  if (row === null) {
    return HEADING_STYLE;
  }
  return row.style;
}

export function setLabel(index: Int): String {
  const row: FloaterRow | null = FloaterRows.at(index);
  if (row === null) {
    return '';
  }
  return row.label;
}

export function setSize(index: Int): Int {
  const row: FloaterRow | null = FloaterRows.at(index);
  if (row === null) {
    return 0;
  }
  return row.height;
}

export function setHidesToggled(index: Int): Boolean {
  const row: FloaterRow | null = FloaterRows.at(index);
  if (row === null) {
    return false;
  }
  return row.hideToggled;
}

export function normalSkin(style: Int): Int {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return NONE;
  }
  return row.normal;
}

export function hoverSkin(style: Int): Int {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return NONE;
  }
  return row.hover;
}

export function pressedSkin(style: Int): Int {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return NONE;
  }
  return row.pressed;
}

export function clickWhenDisabled(style: Int): Boolean {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return false;
  }
  return row.clickWhenDisabled;
}

export function toggledStyle(style: Int): Int {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return NONE;
  }
  return row.toggled;
}

export function styleName(style: Int): String {
  const row: FloaterButtonStyle | null = FloaterButtonStyles.at(style);
  if (row === null) {
    return '';
  }
  return row.name;
}

export function wornStyle(style: Int, toggled: Int): Int {
  const swap: Int = toggledStyle(style);
  if (toggled === 1 && swap !== NONE) {
    return swap;
  }
  return style;
}

export function wornHoverSkin(style: Int, toggled: Int): Int {
  const worn: Int = hoverSkin(wornStyle(style, toggled));
  if (worn !== NONE) {
    return worn;
  }
  return hoverSkin(style);
}

export enum Piece {
  FILL = 0,
  CORNER_TL = 1,
  CORNER_TR = 2,
  CORNER_BL = 3,
  CORNER_BR = 4,
  EDGE_LEFT = 5,
  EDGE_TOP = 6,
  EDGE_RIGHT = 7,
  EDGE_BOTTOM = 8,
  INSET_FILL = 9,
}

export function skinSprite(skin: Int, piece: Int): Sprite {
  const s: FloaterButtonSkin | null = FloaterButtonSkins.at(skin);
  if (s === null) {
    return -1;
  }
  if (piece === Piece.CORNER_TL) {
    return s.cornerTl;
  }
  if (piece === Piece.CORNER_TR) {
    return s.cornerTr;
  }
  if (piece === Piece.CORNER_BL) {
    return s.cornerBl;
  }
  if (piece === Piece.CORNER_BR) {
    return s.cornerBr;
  }
  if (piece === Piece.EDGE_LEFT) {
    return s.edgeLeft;
  }
  if (piece === Piece.EDGE_TOP) {
    return s.edgeTop;
  }
  if (piece === Piece.EDGE_RIGHT) {
    return s.edgeRight;
  }
  if (piece === Piece.EDGE_BOTTOM) {
    return s.edgeBottom;
  }
  if (piece === Piece.INSET_FILL) {
    return s.insetFill;
  }
  return s.fill;
}

export function skinBorder(skin: Int): Int {
  const s: FloaterButtonSkin | null = FloaterButtonSkins.at(skin);
  if (s === null) {
    return 0;
  }
  return s.border;
}

export function skinInset(skin: Int): Int {
  const s: FloaterButtonSkin | null = FloaterButtonSkins.at(skin);
  if (s === null) {
    return 0;
  }
  return s.inset;
}

export function skinTiling(skin: Int): Boolean {
  const s: FloaterButtonSkin | null = FloaterButtonSkins.at(skin);
  if (s === null) {
    return true;
  }
  return s.tiling;
}
