import { FloaterButton, PressFloaterButton, ToggledFloaterButton } from './floater-button.component';
import { HEADING_STYLE, NONE } from './reusable-floater.data';
import { setHidesToggled, setLabel, setSize, setStyle, styleName, toggledStyle } from './floater-styles';
import { CS2 } from 'ts2';

import {
  CODE_HEAD,
  CODE_TAIL,
  COLUMN_CAPTIONS,
  Colour,
  DOLLAR,
  DOLLAR_MARK,
  FloaterFonts,
  Layout,
  PRESS_TOP,
  SET_TOPS,
} from './reusable-floater.constants';
import { replaceAll } from '../0889_nps/colour-tag';

export function ReusableFloater(): Component {
  return (
    <>
      <rect x={0} y={0} w="fill" h="fill" color={Colour.BACKDROP} fill transparency={Colour.BACKDROP_TRANSPARENCY} />
      <text
        x={0}
        y={0}
        w="fill"
        h="fill"
        font={FloaterFonts.TEXT}
        shadow
        color={Colour.WHITE}
        align="center"
        valign="middle"
        text=""
      />
      {COLUMN_CAPTIONS.map((caption, k) => (
        <text
          x={Layout.GAP + Layout.PITCH * k}
          y={Layout.GAP}
          w={Layout.CELL}
          h={Layout.CELL}
          font={FloaterFonts.TEXT}
          shadow
          color={Colour.ORANGE}
          align="left"
          valign="middle"
          text={caption}
        />
      ))}
      {SET_TOPS.map((top, index) => (
        <FloaterSet index={index} y={top} />
      ))}
      <PressFloaterButton x={Layout.GAP} y={PRESS_TOP} w={Layout.PRESS_W} h={Layout.CELL} style={0} />
    </>
  );
}

export function FloaterSet({ index, y }: { index: Int; y: Int }): Component {
  const style: Int = setStyle(index);
  return (
    <>
      {style === HEADING_STYLE ? (
        <FloaterHeading index={index} y={y} />
      ) : (
        <FloaterButtonSet index={index} style={style} y={y} />
      )}
    </>
  );
}

export function FloaterHeading({ index, y }: { index: Int; y: Int }): Component {
  const label: String = setLabel(index);
  return (
    <text
      x={Layout.GAP}
      y={y}
      w={Layout.HEADING_W}
      h={Layout.HEADING_H}
      font={FloaterFonts.TEXT}
      shadow
      color={Colour.ORANGE}
      align="left"
      valign="middle"
      text={`<col=ffffff>${label}</col>`}
    />
  );
}

export function FloaterButtonSet({ index, style, y }: { index: Int; style: Int; y: Int }): Component {
  const label: String = setLabel(index);
  const size: Int = setSize(index);
  const swap: Int = toggledStyle(style);
  const hidesToggled: Boolean = setHidesToggled(index);
  const name: String = styleName(style);
  const code: String = replaceAll(CS2.append(CS2.append(CODE_HEAD, name), CODE_TAIL), DOLLAR_MARK, DOLLAR);
  return (
    <>
      <FloaterButton x={Layout.GAP} y={y} w={size} h={size} style={style} toggled={0} disabled={false} label={label} />
      {swap !== NONE && !hidesToggled && (
        <ToggledFloaterButton x={Layout.GAP + Layout.PITCH} y={y} w={size} h={size} style={style} label={label} />
      )}
      <FloaterButton
        x={Layout.GAP + Layout.PITCH * 2}
        y={y}
        w={size}
        h={size}
        style={style}
        toggled={0}
        disabled={true}
        label={label}
      />
      {swap !== NONE && (
        <FloaterButton
          x={Layout.GAP + Layout.PITCH * 3}
          y={y}
          w={size}
          h={size}
          style={style}
          toggled={1}
          disabled={true}
          label={label}
        />
      )}
      <input
        x={Layout.CODE_X}
        y={y}
        w={Layout.CODE_W}
        h={size}
        lineWrapWidth={Layout.CODE_W}
        font={FloaterFonts.TEXT}
        color={Colour.WHITE}
        shadow
        align="left"
        valign="top"
        selectColor={Colour.SELECT}
        selectBgColor={Colour.SELECT_BG}
        noClickThrough
        text={code}
      />
    </>
  );
}
