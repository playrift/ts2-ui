export const HEADING_STYLE = -1;

export const NONE = -1;

export type FloaterButtonSkin = {
  cornerTl: Sprite;
  edgeTop: Sprite;
  cornerTr: Sprite;
  edgeLeft: Sprite;
  fill: Sprite;
  edgeRight: Sprite;
  cornerBl: Sprite;
  edgeBottom: Sprite;
  cornerBr: Sprite;
  insetFill: Sprite;
  inset: Int;
  border: Int;
  tiling: Boolean;
};

export type FloaterButtonStyle = {
  normal: Int;
  hover: Int;
  pressed: Int;
  clickWhenDisabled: Boolean;
  toggled: Int;
  name: String;
};

export type FloaterRow = {
  style: Int;
  width: Int;
  height: Int;
  label: String;
  hideToggled: Boolean;
};

