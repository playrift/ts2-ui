import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import { PatchyBody } from './patchy-body.component';
import { Layout, PatchyArt } from './patchy.constants';

export function Patchy(): Component {
  return (
    <layer x="center" y="center" w={Layout.ROOT_W} h={Layout.ROOT_H}>
      <model
        x="center"
        y="center"
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={26445}
        zoom={Layout.MODEL_ZOOM}
        pitch={Layout.MODEL_PITCH}
        offsetX={Layout.MODEL_OFFSET_X}
        offsetY={Layout.MODEL_OFFSET_Y}
      />

      <sprite
        x={{ right: Layout.CLOSE_RIGHT }}
        y={Layout.CLOSE_TOP}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={PatchyArt.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapperUnlessMobile(event.component, PatchyArt.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapperUnlessMobile(event.component, PatchyArt.CLOSE)}
      />

      <PatchyBody />
    </layer>
  );
}
