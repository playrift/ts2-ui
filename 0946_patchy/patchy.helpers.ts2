import { textWidth } from '../lib/lib.engine';

export function ellipsize(text: String, maxWidth: Int, font: Font): String {
  let candidate: String = text;
  let fitted: String = text;
  let cut: Int = text.length;
  let done: Int = 0;

  if (cut > 0 && textWidth(text, 512, font) > maxWidth) {
    while (cut > 1 && done === 0) {
      cut = cut - 1;
      candidate = `${candidate.substring(0, cut)}...`;
      if (textWidth(candidate, 512, font) <= maxWidth) {
        fitted = candidate;
        done = 1;
      }
    }
  }

  return fitted;
}
