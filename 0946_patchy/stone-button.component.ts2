import { CS2, useState } from 'ts2';

import { StoneButton } from '../lib/stone-button.component';
import { StoneButtonPressed } from '../lib/stone-button-pressed.component';
import { onMobile } from '../lib/lib.helpers';
import { PatchyColors, PatchyFonts } from './patchy.constants';

export function ConfirmButton({ label }: { label: String }): Component {
  const [pressed, setPressed] = useState(0);
  const skin: Int = pressed;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={() => {
        if (!onMobile()) {
          setPressed(1);
        }
      }}
      onMouseLeave={() => setPressed(0)}
    >
      {skin === 1 ? (
        <StoneButtonPressed>
          <ButtonLabel label={label} />
        </StoneButtonPressed>
      ) : (
        <StoneButton>
          <ButtonLabel label={label} />
        </StoneButton>
      )}
    </layer>
  );
}

function ButtonLabel({ label }: { label: String }): Component {
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={label}
      font={PatchyFonts.BODY}
      color={PatchyColors.HEADING}
      align="center"
      valign="middle"
      shadow
    />
  );
}
