import { Sprites } from '../lib/game/sprites';

export function StonePanelResizable(): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x={16} y={-13} w={{ fill: 32 }} h={32} sprite={Sprites.V2_BORDERS_SLIM_0} tiling />
      <sprite x={16} y={{ bottom: -12 }} w={{ fill: 32 }} h={32} sprite={Sprites.V2_BORDERS_SLIM_2} tiling />
      <sprite x={-13} y={16} w={32} h={{ fill: 32 }} sprite={Sprites.V2_BORDERS_SLIM_1} tiling />
      <sprite x={{ right: -12 }} y={16} w={32} h={{ fill: 32 }} sprite={Sprites.V2_BORDERS_SLIM_3} tiling />
      <sprite x="left" y="top" w={32} h={32} sprite={Sprites.V2_BORDERS_SLIM_4} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={Sprites.V2_BORDERS_SLIM_5} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={Sprites.V2_BORDERS_SLIM_6} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={Sprites.V2_BORDERS_SLIM_7} tiling />
    </layer>
  );
}
