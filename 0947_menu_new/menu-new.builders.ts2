import { useServerState, useState } from 'ts2';

import { chatDefaultStopInput } from '../0608_fossil_mushtrees/chatdefault-input';
import { textWidth } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { Layout, MenuFont, MenuVarbits } from './menu-new.constants';
import {
  menuNewCall,
  menuNewIcon,
  menuNewIconH,
  menuNewIconW,
  menuNewKeys,
  menuNewOpaque,
  menuNewOptions,
  menuNewTitle,
  menuNewTitleW,
} from './menu-new.state';

export function menuNewBuild(keys: Int, icon: Sprite, iconW: Int, iconH: Int, title: String, options: String): void {
  let shortcuts: Int = keys;
  if (onMobile()) {
    shortcuts = 0;
  }
  if (shortcuts === 1) {
    chatDefaultStopInput();
  }

  const [call, setCall] = useState(menuNewCall);
  const [, setKeys] = useState(menuNewKeys);
  const [, setIcon] = useState(menuNewIcon);
  const [, setIconW] = useState(menuNewIconW);
  const [, setIconH] = useState(menuNewIconH);
  const [, setTitle] = useState(menuNewTitle);
  const [, setTitleW] = useState(menuNewTitleW);
  const [, setOptions] = useState(menuNewOptions);
  const [, setOpaque] = useState(menuNewOpaque);
  setKeys(shortcuts);
  setIcon(icon as Int);
  setIconW(iconW);
  setIconH(iconH);
  setTitle(title);
  setTitleW(textWidth(title, Layout.TITLE_MEASURE, MenuFont.TITLE));
  setOptions(options);
  setOpaque(useServerState(MenuVarbits.OPAQUE));
  setCall(call + 1);
}
