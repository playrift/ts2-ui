import { graphicSwapper, onMobile, opsound } from '../lib/lib.helpers';
import { Layout, SkullArt, SkullKeys } from './deadmanskull.constants';

export function CloseButton(): Component {
  if (onMobile()) {
    return (
      <sprite
        x={{ right: Layout.CLOSE_MOBILE_XY }}
        y={Layout.CLOSE_MOBILE_XY}
        w={Layout.CLOSE_MOBILE}
        h={Layout.CLOSE_MOBILE}
        sprite={SkullArt.CLOSE_MOBILE}
        options={['Close', { label: '', hotkey: SkullKeys.ESCAPE }]}
        onOptionSelect={(event) => opsound(event.option, 2)}
      />
    );
  }

  return (
    <sprite
      x={{ right: Layout.CLOSE_X }}
      y={Layout.CLOSE_Y}
      w={Layout.CLOSE_W}
      h={Layout.CLOSE_H}
      sprite={SkullArt.CLOSE}
      options={['Close', { label: '', hotkey: SkullKeys.ESCAPE }]}
      onOptionSelect={(event) => opsound(event.option, 2)}
      onMouseEnter={(event) => graphicSwapper(event.component, SkullArt.CLOSE_LIT)}
      onMouseLeave={(event) => graphicSwapper(event.component, SkullArt.CLOSE)}
    />
  );
}
