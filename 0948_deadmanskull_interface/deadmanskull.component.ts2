import { SteelBorder } from '../lib/steel-border.component';
import { Layout, SkullColor } from './deadmanskull.constants';
import { CloseButton } from './close-button.component';
import { UnlockPane } from './unlock-pane.component';
import { UnlockTabs } from './unlock-tab.component';
import { UnlockTooltip } from './deadmanskull.tooltip';

export function DeadmanSkull(): Component {
  return (
    <>
      <layer x={0} y={0} w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H} noClickThrough>
        <layer x="center" y="center" w="fill" h="fill">
          <SteelBorder title="Deadman Unlocks" titleColor={SkullColor.LABEL} flags={0} />
        </layer>

        <layer x={0} y={0} w="fill" h="fill">
          <CloseButton />
        </layer>

        <layer
          x="center"
          y={Layout.CONTENT_Y}
          w={{ fill: Layout.CONTENT_W_INSET }}
          h={{ fill: Layout.CONTENT_H_INSET }}
        >
          <layer x={0} y={0} w="fill" h={Layout.TABS_H}>
            <UnlockTabs />
          </layer>

          <layer x={0} y={Layout.MAIN_Y} w="fill" h={{ fill: Layout.MAIN_H_INSET }}>
            <layer x={0} y={0} w="fill" h={{ fill: Layout.ITEMS_H_INSET }}>
              <UnlockPane />

              <rect x="center" y="center" w="fill" h="fill" color={SkullColor.LIST_FRAME} />
            </layer>
          </layer>
        </layer>
      </layer>

      <layer x={0} y={0} w={Layout.UNIVERSE_W} h={Layout.UNIVERSE_H} hide />

      <layer x={0} y={0} w="fill" h="fill">
        <UnlockTooltip />
      </layer>
    </>
  );
}
