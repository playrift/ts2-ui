import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { SkullVarbits } from './deadmanskull.constants';

export function unlockActive(sigil: Int, mode: Int): Int {
  if (mode === 2) {
    return unlockAttuned(sigil);
  }
  switch (sigil) {
    case 7:
      return useServerState(Varbits.SIGIL_OF_DEFT_STRIKES_STATE);
    case 9:
      return useServerState(Varbits.SIGIL_OF_ENHANCED_HARVEST_TOGGLE);
    case 18:
      return useServerState(Varbits.SIGIL_OF_THE_POTION_MASTER_STATE);
    case 20:
      return useServerState(Varbits.SIGIL_OF_THE_TREASURE_HUNTER_STATE);
    case 35:
      return useServerState(Varbits.SIGIL_OF_NATURE_STATE);
    case 36:
      return useServerState(Varbits.SIGIL_OF_DEVOTION_TOGGLE);
    case 39:
      return useServerState(Varbits.SIGIL_OF_SLAUGHTER_TOGGLE);
    case 50:
      return useServerState(Varbits.SIGIL_OF_REMOTE_STORAGE_TOGGLE);
    case 54:
      return useServerState(Varbits.SIGIL_OF_RESISTANCE_STATE);
    case 55:
      return useServerState(Varbits.SIGIL_OF_TITANIUM_STATE);
    case 57:
      return useServerState(Varbits.SIGIL_OF_AGILE_FORTUNE_STATE);
    case 58:
      return useServerState(Varbits.SIGIL_OF_THE_INFERNAL_CHEF_STATE);
    case 60:
      return useServerState(Varbits.SIGIL_OF_WOODCRAFT_TOGGLE);
    case 63:
      return useServerState(Varbits.SIGIL_OF_THE_HUNTER_STATE);
    case 64:
      return useServerState(Varbits.SIGIL_OF_THE_ALCHEMANIAC_STATE);
    case 66:
      return useServerState(Varbits.SIGIL_OF_HOARDING_STATE);
    case 68:
      return useServerState(Varbits.SIGIL_OF_THE_AUGMENTED_THRALL_STATE);
    case 69:
      return useServerState(Varbits.SIGIL_OF_THE_FOOD_MASTER_STATE);
    case 70:
      return useServerState(Varbits.SIGIL_OF_THE_WELL_FED_STATE);
    case 71:
      return useServerState(Varbits.SIGIL_OF_FAITH_STATE);
    case 72:
      return useServerState(Varbits.SIGIL_OF_METICULOUSNESS_STATE);
    case 73:
      return useServerState(Varbits.SIGIL_OF_REVOKED_LIMITATION_STATE);
    case 75:
      return useServerState(Varbits.SIGIL_OF_DECEPTION_STATE);
    case 76:
      return useServerState(Varbits.SIGIL_OF_LITHE_STATE);
    case 78:
      return useServerState(Varbits.SIGIL_OF_ONSLAUGHT_STATE);
    case 79:
      return useServerState(Varbits.SIGIL_OF_RESTORATION_STATE);
    case 84:
      return useServerState(Varbits.SIGIL_OF_CONCLUSION_STATE);
    case 85:
      return useServerState(Varbits.SIGIL_OF_AUTOMATION_STATE);
    case 86:
      return useServerState(Varbits.SIGIL_OF_ETERNAL_BELIEF_STATE);
    case 87:
      return useServerState(Varbits.SIGIL_OF_EFFICIENCY_STATE);
    default:
      return 0;
  }
}

export function unlockOwned(sigil: Int, mode: Int): Int {
  if (mode === 2) {
    return unlockAttuned(sigil);
  }
  switch (sigil) {
    case 7:
      return useServerState(Varbits.SIGIL_OF_DEFT_STRIKES_STATE);
    case 9:
      return useServerState(Varbits.SIGIL_OF_ENHANCED_HARVEST_STATE);
    case 18:
      return useServerState(Varbits.SIGIL_OF_THE_POTION_MASTER_STATE);
    case 20:
      return useServerState(Varbits.SIGIL_OF_THE_TREASURE_HUNTER_STATE);
    case 35:
      return useServerState(Varbits.SIGIL_OF_NATURE_STATE);
    case 36:
      return useServerState(Varbits.SIGIL_OF_DEVOTION_STATE);
    case 39:
      return useServerState(Varbits.SIGIL_OF_SLAUGHTER_STATE);
    case 50:
      return useServerState(Varbits.SIGIL_OF_REMOTE_STORAGE_STATE);
    case 54:
      return useServerState(Varbits.SIGIL_OF_RESISTANCE_STATE);
    case 55:
      return useServerState(Varbits.SIGIL_OF_TITANIUM_STATE);
    case 57:
      return useServerState(Varbits.SIGIL_OF_AGILE_FORTUNE_STATE);
    case 58:
      return useServerState(Varbits.SIGIL_OF_THE_INFERNAL_CHEF_STATE);
    case 60:
      return useServerState(Varbits.SIGIL_OF_WOODCRAFT_STATE);
    case 63:
      return useServerState(Varbits.SIGIL_OF_THE_HUNTER_STATE);
    case 64:
      return useServerState(Varbits.SIGIL_OF_THE_ALCHEMANIAC_STATE);
    case 66:
      return useServerState(Varbits.SIGIL_OF_HOARDING_STATE);
    case 68:
      return useServerState(Varbits.SIGIL_OF_THE_AUGMENTED_THRALL_STATE);
    case 69:
      return useServerState(Varbits.SIGIL_OF_THE_FOOD_MASTER_STATE);
    case 70:
      return useServerState(Varbits.SIGIL_OF_THE_WELL_FED_STATE);
    case 71:
      return useServerState(Varbits.SIGIL_OF_FAITH_STATE);
    case 72:
      return useServerState(Varbits.SIGIL_OF_METICULOUSNESS_STATE);
    case 73:
      return useServerState(Varbits.SIGIL_OF_REVOKED_LIMITATION_STATE);
    case 75:
      return useServerState(Varbits.SIGIL_OF_DECEPTION_STATE);
    case 76:
      return useServerState(Varbits.SIGIL_OF_LITHE_STATE);
    case 78:
      return useServerState(Varbits.SIGIL_OF_ONSLAUGHT_STATE);
    case 79:
      return useServerState(Varbits.SIGIL_OF_RESTORATION_STATE);
    case 84:
      return useServerState(Varbits.SIGIL_OF_CONCLUSION_STATE);
    case 85:
      return useServerState(Varbits.SIGIL_OF_AUTOMATION_STATE);
    case 86:
      return useServerState(Varbits.SIGIL_OF_ETERNAL_BELIEF_STATE);
    case 87:
      return useServerState(Varbits.SIGIL_OF_EFFICIENCY_STATE);
    default:
      return 0;
  }
}

function unlockAttuned(sigil: Int): Int {
  const slot0: Int = useServerState(SkullVarbits.SLOT_0);
  const slot1: Int = useServerState(SkullVarbits.SLOT_1);
  const slot2: Int = useServerState(SkullVarbits.SLOT_2);
  if (sigil === slot0 || sigil === slot1 || sigil === slot2) {
    return 1;
  }
  return 0;
}
