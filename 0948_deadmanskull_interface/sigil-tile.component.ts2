import { useServerStateOnce, useState } from 'ts2';

import { clientClock, playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { Grid, SkullColor, SkullFonts } from './deadmanskull.constants';
import { DeadmanUnlocks } from './deadmanskull.data';
import { hideTileTooltip, showTileTooltip } from './deadmanskull.tooltip';
import { unlockActive, unlockOwned } from './deadmanskull.state';
import { Sounds } from '../lib/game/sounds';

const MENU_ACTIVATE = ['Activate'] as const;
const MENU_DEACTIVATE = ['Deactivate'] as const;
const MENU_CLEARED = [] as const;

export function SigilTile({
  sigil,
  x,
  y,
  mode,
  list,
}: {
  sigil: Int;
  x: Int;
  y: Int;
  mode: Int;
  list: Ref;
}): Component {
  const row = DeadmanUnlocks.get(sigil);
  if (row === null) {
    return null;
  }

  const active: Int = useServerStateOnce(() => unlockActive(sigil, mode));
  const owned: Int = useServerStateOnce(() => unlockOwned(sigil, mode));
  const [builtAt] = useState(clientClock());

  const [hovered, setHovered] = useState(0);
  const [opaque, setOpaque] = useState(0);
  const [claimed, setClaimed] = useState(0);

  const label: String = owned === 0 ? `${row.name}<br>${row.points} points` : row.name;

  const lit: Sprite = row.iconActive;
  const dim: Sprite = row.iconInactive;
  const restArt: Sprite = active === 1 ? lit : dim;
  const restColor: Int = active === 1 ? SkullColor.TILE_ACTIVE : SkullColor.TILE_INACTIVE;

  const captionColor: Int = hovered === 1 ? SkullColor.TILE_HOVER : claimed === 1 ? SkullColor.TILE_HOVER : restColor;

  const enter = () => {
    if (clientClock() === builtAt) {
      return;
    }
    setHovered(1);
    setOpaque(1);
    showTileTooltip(sigil, active, x + Grid.CAPTION_DX, y + Grid.CAPTION_DY, Grid.CAPTION_H, list);
  };

  const leave = () => {
    if (clientClock() === builtAt) {
      return;
    }
    setHovered(0);
    hideTileTooltip();
  };

  const claim = (event: Event) => {
    if (event.option !== 1) {
      return;
    }
    playSound(Sounds.INTERFACE_SELECT1);
    setOpaque(1);
    setClaimed(1);
    hideTileTooltip();
  };

  const touch: Boolean = onMobile();

  return (
    <>
      <layer x={0} y={0} w={0} h={0} hide />
      {mode === 1 && touch ? (
        <rect
          x={x + Grid.PLATE_DX}
          y={y + Grid.PLATE_DY}
          w={Grid.PLATE_W}
          h={Grid.PLATE_H}
          fill
          color={SkullColor.PLATE}
          transparency={Grid.PLATE_TRANSPARENCY}
          optionSubject={`<col=ff9040>${row.name}</col>`}
          options={claimed === 1 ? MENU_CLEARED : active === 1 ? MENU_DEACTIVATE : MENU_ACTIVATE}
          onOptionSelect={claimed === 1 ? undefined : claim}
        />
      ) : mode === 1 ? (
        <rect
          x={x + Grid.PLATE_DX}
          y={y + Grid.PLATE_DY}
          w={Grid.PLATE_W}
          h={Grid.PLATE_H}
          fill
          color={SkullColor.PLATE}
          transparency={Grid.PLATE_TRANSPARENCY}
          optionSubject={`<col=ff9040>${row.name}</col>`}
          options={claimed === 1 ? MENU_CLEARED : active === 1 ? MENU_DEACTIVATE : MENU_ACTIVATE}
          onMouseRepeat={claimed === 1 ? undefined : enter}
          onMouseLeave={claimed === 1 ? undefined : leave}
          onOptionSelect={claimed === 1 ? undefined : claim}
        />
      ) : touch ? (
        <rect
          x={x + Grid.PLATE_DX}
          y={y + Grid.PLATE_DY}
          w={Grid.PLATE_W}
          h={Grid.PLATE_H}
          fill
          color={SkullColor.PLATE}
          transparency={Grid.PLATE_TRANSPARENCY}
        />
      ) : (
        <rect
          x={x + Grid.PLATE_DX}
          y={y + Grid.PLATE_DY}
          w={Grid.PLATE_W}
          h={Grid.PLATE_H}
          fill
          color={SkullColor.PLATE}
          transparency={Grid.PLATE_TRANSPARENCY}
          onMouseRepeat={enter}
          onMouseLeave={leave}
        />
      )}
      <sprite
        x={x + Grid.ICON_DX}
        y={y + Grid.ICON_DY}
        w={Grid.ICON}
        h={Grid.ICON}
        sprite={hovered === 1 ? lit : restArt}
        transparency={opaque === 1 ? Grid.ICON_LIT_TRANSPARENCY : Grid.ICON_TRANSPARENCY}
      />
      <text
        x={x + Grid.CAPTION_DX}
        y={y + Grid.CAPTION_DY}
        w={Grid.CAPTION_W}
        h={Grid.CAPTION_H}
        text={label}
        font={SkullFonts.TILE}
        color={captionColor}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
