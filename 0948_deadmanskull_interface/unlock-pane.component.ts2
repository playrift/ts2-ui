import { useRef, useServerState, useUniverse } from 'ts2';

import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { Grid, Layout, SkullArt, SkullColor, SkullFonts, SkullVarbits, TabExtents } from './deadmanskull.constants';
import {
  ATTUNE_COMBAT,
  PERMANENT_COMBAT,
  PERMANENT_SKILLING,
  PERMANENT_UTILITY,
  TOGGLE_SKILLING,
  TOGGLE_UTILITY,
} from './deadmanskull.data';
import { SigilTile } from './sigil-tile.component';

export function UnlockPane(): Component {
  const mode: Int = useServerState(SkullVarbits.TAB);
  const list = useRef();
  const box = useUniverse();

  const extent: Int =
    mode === 0 ? TabExtents.PERMANENT_TOTAL : mode === 1 ? TabExtents.TOGGLE_TOTAL : TabExtents.ATTUNE_TOTAL;

  const paneHeight: Int = box.height - Layout.LIST_H_INSET;

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <layer
        ref={list}
        x={Layout.LIST_X}
        y="center"
        w={{ fill: Layout.LIST_W_INSET }}
        h={{ fill: Layout.LIST_H_INSET }}
        scrollHeight={extent > paneHeight ? extent : 0}
      >
        {mode === 0 && (
          <>
            <CategoryHeading title="Combat Sigils" top={TabExtents.PERMANENT_COMBAT_Y} />
            {PERMANENT_COMBAT.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={0}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.PERMANENT_COMBAT_Y + Grid.HEADING_H}
              />
            ))}
            <CategoryHeading title="Skilling Sigils" top={TabExtents.PERMANENT_SKILLING_Y} />
            {PERMANENT_SKILLING.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={0}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.PERMANENT_SKILLING_Y + Grid.HEADING_H}
              />
            ))}
            <CategoryHeading title="Utility Sigils" top={TabExtents.PERMANENT_UTILITY_Y} />
            {PERMANENT_UTILITY.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={0}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.PERMANENT_UTILITY_Y + Grid.HEADING_H}
              />
            ))}
          </>
        )}

        {mode === 1 && (
          <>
            <CategoryHeading title="Skilling Sigils" top={TabExtents.TOGGLE_SKILLING_Y} />
            {TOGGLE_SKILLING.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={1}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.TOGGLE_SKILLING_Y + Grid.HEADING_H}
              />
            ))}
            <CategoryHeading title="Utility Sigils" top={TabExtents.TOGGLE_UTILITY_Y} />
            {TOGGLE_UTILITY.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={1}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.TOGGLE_UTILITY_Y + Grid.HEADING_H}
              />
            ))}
          </>
        )}

        {mode === 2 && (
          <>
            <CategoryHeading title="Combat Sigils" top={TabExtents.ATTUNE_COMBAT_Y} />
            {ATTUNE_COMBAT.map((sigil, i) => (
              <SigilTile
                sigil={sigil}
                mode={2}
                list={list}
                x={Grid.X_FIRST + (i % Grid.PER_ROW) * Grid.X_PITCH}
                y={(i / Grid.PER_ROW) * Grid.ROW_PITCH + TabExtents.ATTUNE_COMBAT_Y + Grid.HEADING_H}
              />
            ))}
          </>
        )}
      </layer>

      <layer x={{ right: Layout.BAR_X }} y="center" w={Layout.BAR_W} h={{ fill: Layout.BAR_H_INSET }}>
        <ScrollbarVertical
          content={list}
          track={SkullArt.BAR_TRACK}
          capTopSprite={SkullArt.BAR_CAP_TOP}
          thumbSprite={SkullArt.BAR_THUMB}
          capBottomSprite={SkullArt.BAR_CAP_BOTTOM}
          arrowUp={SkullArt.BAR_ARROW_UP}
          arrowDown={SkullArt.BAR_ARROW_DOWN}
        />
      </layer>
    </layer>
  );
}

function CategoryHeading({ title, top }: { title: String; top: Int }): Component {
  return (
    <>
      <line
        x={Grid.RULE_X}
        y={top + Grid.HEADING_RULE_DY}
        w={Grid.RULE_W}
        color={SkullColor.RULE}
        lineWidth={Grid.RULE_WIDTH}
      />
      <text
        x={{ center: Grid.LABEL_X }}
        y={top + Grid.HEADING_RULE_DY + Grid.LABEL_DY}
        w={Grid.LABEL_W}
        h={Grid.LABEL_H}
        text={title}
        font={SkullFonts.LABEL}
        color={SkullColor.LABEL}
        shadow
        align="left"
        valign="top"
        lineHeight={Grid.LABEL_LINE}
      />
    </>
  );
}
