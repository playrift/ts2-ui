import { useState, useUniverse } from 'ts2';

import { SkullArt, SkullColor, SkullFonts, TabPlate } from './deadmanskull.constants';
import { minmax } from './deadmanskull.helpers';
import { skullTab } from './deadmanskull.state';

export function UnlockTabs(): Component {
  const [mode] = useState(skullTab);
  const strip = useUniverse();

  const width: Int = minmax(TabPlate.MIN_W, TabPlate.MAX_W, strip.width / 4 - TabPlate.QUARTER_INSET);

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <TabPlateView title="Permanent" left={0} width={width} selected={mode === 0 ? 1 : 0} />
      <TabPlateView title="Toggle" left={width + TabPlate.GAP} width={width} selected={mode === 1 ? 1 : 0} />
      <TabPlateView title="Attune" left={TabPlate.GAP * 2 + width * 2} width={width} selected={mode === 2 ? 1 : 0} />
    </layer>
  );
}

function TabPlateView({
  title,
  left,
  width,
  selected,
}: {
  title: String;
  left: Int;
  width: Int;
  selected: Int;
}): Component {
  const [hover, setHover] = useState(0);

  let lit: Int = 0;
  if (selected === 1 || hover === 1) {
    lit = 1;
  }

  const cap: Sprite = lit === 1 ? SkullArt.TAB_ON_CAP : SkullArt.TAB_OFF_CAP;
  const band: Sprite = lit === 1 ? SkullArt.TAB_ON_MIDDLE : SkullArt.TAB_OFF_MIDDLE;
  const ink: Int = selected === 1 ? SkullColor.LABEL_SELECTED : SkullColor.LABEL;

  return (
    <layer
      x={left}
      y={0}
      w={width}
      h="fill"
      options={['View']}
      onMouseEnter={selected === 0 ? () => setHover(1) : undefined}
      onMouseLeave={selected === 0 ? () => setHover(0) : undefined}
    >
      <sprite x={0} y="center" w={TabPlate.CAP} h={TabPlate.CAP} sprite={cap} />
      <sprite x="center" y="center" w={{ fill: TabPlate.MIDDLE_W_INSET }} h={TabPlate.CAP} sprite={band} tiling />
      <sprite x="right" y="center" w={TabPlate.CAP} h={TabPlate.CAP} sprite={cap} hflip />
      <text
        x="center"
        y="center"
        w={{ fill: TabPlate.LABEL_W_INSET }}
        h="fill"
        text={title}
        font={SkullFonts.LABEL}
        color={ink}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
