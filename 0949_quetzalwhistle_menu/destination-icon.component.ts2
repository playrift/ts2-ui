import { onMobile } from '../lib/lib.helpers';
import { Layout, Marker, QuetzalSounds } from './quetzalwhistle-menu.constants';
import { soundSynth } from './quetzalwhistle-menu.helpers';

export function DestinationIcon({
  name,
  model,
  dx,
  dy,
  unlocked,
  near,
  back,
  front,
  locked,
  current,
}: {
  name: String;
  model: Model;
  dx: Int;
  dy: Int;
  unlocked: Boolean;
  near: Int;
  back: Ref;
  front: Ref;
  locked: Ref;
  current: Ref;
}): Component {
  return (
    <model
      x={dx}
      y={{ bottom: dy }}
      w={Layout.icon.size}
      h={Layout.icon.size}
      model={model}
      pitch={Layout.icon.pitch}
      zoom={Layout.icon.zoom}
      orthogonal
      noClickThrough
      options={[name]}
      onMouseRepeat={() => {
        back.x = Marker.x + dx;
        back.y = Marker.top - dy;
        front.x = Marker.x + dx;
        front.y = Marker.top - dy;
        front.model = model;
        back.hide = false;
        front.hide = false;
        if (!unlocked) {
          locked.x = Marker.x + dx;
          locked.y = Marker.top - dy;
          locked.hide = false;
        } else {
          locked.hide = true;
        }
        if (near === 1) {
          current.x = Marker.x + dx;
          current.y = Marker.top - dy;
          current.hide = false;
        } else {
          current.hide = true;
        }
      }}
      onMouseEnter={() => {
        if (!onMobile()) {
          soundSynth(QuetzalSounds.HOVER, 1, 0);
        }
      }}
      onMouseLeave={() => {
        back.hide = true;
        front.hide = true;
        current.hide = true;
      }}
      onOptionSelect={() => {
        soundSynth(QuetzalSounds.SELECT, 1, 0);
        back.x = Marker.x + dx;
        back.y = Marker.top - dy;
        front.x = Marker.x + dx;
        front.y = Marker.top - dy;
        locked.x = Marker.x + dx;
        locked.y = Marker.top - dy;
        current.x = Marker.x + dx;
        current.y = Marker.top - dy;
        front.model = model;
        back.hide = false;
        front.hide = false;
        if (!unlocked) {
          locked.hide = false;
        }
        if (near === 1) {
          current.hide = false;
        }
      }}
    />
  );
}
