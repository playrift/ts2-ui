import { CS2 } from 'ts2';
import { hasBit } from '../lib/lib.engine';
import { closeInterface } from '../lib/lib.helpers';
import { QuetzalSounds } from './quetzalwhistle-menu.constants';

export function soundSynth(synth: Int, repeats: Int, delay: Int): void {
  CS2.sound_effect(synth, repeats, delay);
}

export function coordDistance(from: Coord, to: Coord): Int {
  const fromX: Int = from.x;
  const toX: Int = to.x;
  const dx: Int = fromX < toX ? toX - fromX : fromX - toX;
  const fromZ: Int = from.z;
  const toZ: Int = to.z;
  const dz: Int = fromZ < toZ ? toZ - fromZ : fromZ - toZ;
  if (dx > dz) {
    return dx;
  }
  return dz;
}

export function quetzalUnlocked(id: Int, autoUnlocked: Boolean, unlockedBits: Int): Boolean {
  if (autoUnlocked) {
    return true;
  }
  if (id > 30) {
    return false;
  }
  return hasBit(unlockedBits, id);
}

export function closeQuetzalMenu(): void {
  soundSynth(QuetzalSounds.CLOSE, 1, 0);
  closeInterface();
}
