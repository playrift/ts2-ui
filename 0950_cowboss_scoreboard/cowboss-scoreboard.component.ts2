import { closeInterface, graphicSwapperUnlessMobile } from '../lib/lib.helpers';
import {
  Camera,
  Layout,
  ScoreboardArt,
  ScoreboardColor,
  ScoreboardFonts,
  ScoreboardModel,
  VALUE_PLACEHOLDER,
} from './cowboss-scoreboard.constants';

export function CowbossScoreboard(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_W}
        h={Layout.MODEL_H}
        model={ScoreboardModel.BACKDROP}
        zoom={Camera.ZOOM}
      />

      <layer
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      >
        <sprite
          x={Layout.CLOSE_SPRITE_X}
          y={Layout.CLOSE_SPRITE_Y}
          w={Layout.CLOSE_SPRITE_W}
          h={Layout.CLOSE_SPRITE_H}
          sprite={ScoreboardArt.CLOSE}
          onMouseEnter={(event) => {
            graphicSwapperUnlessMobile(event.component, ScoreboardArt.CLOSE_HOVER);
          }}
          onMouseLeave={(event) => {
            graphicSwapperUnlessMobile(event.component, ScoreboardArt.CLOSE);
          }}
        />
      </layer>

      <layer x="center" y={{ center: Layout.PANEL_Y_OFFSET }} w={Layout.PANEL_W} h={Layout.PANEL_H}>
        <layer x="center" y={Layout.TITLE_BAND_Y} w={{ fill: Layout.TITLE_BAND_W_INSET }} h={Layout.TITLE_BAND_H} />

        <layer
          x="center"
          y={{ bottom: Layout.BODY_BAND_BOTTOM }}
          w={{ fill: Layout.BODY_BAND_W_INSET }}
          h={Layout.BODY_BAND_H}
        >
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_1_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Personal Killcount"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_1_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_2_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Personal Deaths"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_2_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_3_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Personal Best Time"
          />
          <text
            x={Layout.COL_LEFT}
            y={Layout.ROW_3_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_1_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Global Killcount"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_1_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_2_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Global Deaths"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_2_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />

          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_3_LABEL}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.HEADING}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text="Global Best Time"
          />
          <text
            x={Layout.COL_RIGHT}
            y={Layout.ROW_3_VALUE}
            w={Layout.LABEL_W}
            h={Layout.LABEL_H}
            font={ScoreboardFonts.VALUE}
            color={ScoreboardColor.LABEL}
            align="center"
            shadow
            text={VALUE_PLACEHOLDER}
          />
        </layer>
      </layer>
    </>
  );
}
