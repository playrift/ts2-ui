import { CS2, useServerState, useSkillBase } from 'ts2';

import { hasBit } from '../lib/lib.engine';
import { MinigameSkills, MinigameVarbits, MinigameVarps } from './minigames.constants';

export function minigameRequirementMet(id: Int, tell: Int): Int {
  switch (id) {
    case 1:
      if (useServerState(MinigameVarbits.BARBASSAULT_TUTORIALS) < 11) {
        if (tell === 1) {
          CS2.message('You need to go through all the minigame tutorials first.');
        }
        return 0;
      }
      break;
    case 2:
      if (useServerState(MinigameVarbits.GIANT_DWARF) < 5) {
        if (tell === 1) {
          CS2.message('You must visit Keldagrim before you can use the Blast Furnace.');
        }
        return 0;
      }
      break;
    case 8:
      if (useSkillBase(MinigameSkills.FISHING) < 15) {
        if (tell === 1) {
          CS2.message('You need to have a Fishing level of 15 to fish on the Trawler.');
        }
        return 0;
      }
      break;
    case 18:
      if (useServerState(MinigameVarbits.RATCATCHERS) < 127) {
        if (tell === 1) {
          CS2.message('You must complete the Ratcatchers quest to use this teleport.');
        }
        return 0;
      }
      break;
    case 20:
      if (useServerState(MinigameVarps.SHADES_OF_MORTTON) < 85) {
        if (tell === 1) {
          CS2.message("You must complete the Shades of Mort'ton quest to use this teleport.");
        }
        return 0;
      }
      break;
    case 28:
      if (useSkillBase(MinigameSkills.COOKING) < 40 || useServerState(MinigameVarps.CABIN_FEVER) < 140) {
        if (tell === 1) {
          CS2.message('You must have completed Cabin Fever and got a Cooking level of 40 to play Trouble Brewing.');
        }
        return 0;
      }
      break;
    case 26:
      if (useServerState(MinigameVarbits.GRICOLLER_FARM) === 0) {
        if (tell === 1) {
          CS2.message("You must have entered Farmer Gricoller's farm before you can use this teleport.");
        }
        return 0;
      }
      break;
    case 11:
      if (useServerState(MinigameVarbits.TEMPLE_OF_THE_EYE) < 130) {
        if (tell === 1) {
          CS2.message('You must complete the Temple of the Eye quest to use this teleport.');
        }
        return 0;
      }
      break;
    case 13:
      if (useServerState(MinigameVarbits.MTA_GUARDIAN) === 0) {
        if (tell === 1) {
          CS2.message('You must speak to the Entrance Guardian in the Mage Training Arena .');
        }
        return 0;
      }
      break;
    case 14:
      if (useSkillBase(MinigameSkills.HERBLORE) < 60 || useServerState(MinigameVarbits.VARLAMORE_VISITED) === 0) {
        if (tell === 1) {
          CS2.message('You must have visited Varlamore and got a Herblore level of 60 to play Mastering Mixology.');
        }
        return 0;
      }
      break;
    case 23:
      if (useServerState(MinigameVarbits.SQIRK_TASK) === 0) {
        if (tell === 1) {
          if (useServerState(MinigameVarbits.SQIRK_CONTACT) < 98) {
            CS2.message("You must speak to Osman about sq'irk fruit.");
          } else {
            CS2.message("You must speak to Selim about sq'irk fruit.");
          }
        }
        return 0;
      }
      break;
  }
  return 1;
}

export function questBossBitWrite(set: Int, low: Int, high: Int, bit: Int): [Int, Int] {
  if (bit < 30) {
    if (set === 1) {
      return [CS2.bit_set(low, bit), high];
    }
    return [CS2.bit_clear(low, bit), high];
  }
  if (bit < 60) {
    if (set === 1) {
      return [low, CS2.bit_set(high, bit - 30)];
    }
    return [low, CS2.bit_clear(high, bit - 30)];
  }
  return [low, high];
}

export function questBossBitRead(low: Int, high: Int, bit: Int): Boolean {
  if (bit < 30) {
    return hasBit(low, bit);
  }
  if (bit < 60) {
    return hasBit(high, bit - 30);
  }
  return false;
}

export function questBossesBeaten(): [Int, Int] {
  let low: Int = 0;
  let high: Int = 0;
  if (useServerState(MinigameVarps.VAMPIRE) >= 3) {
    const [l, h] = questBossBitWrite(1, low, high, 0);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.SUROK_QUEST) >= 150) {
    const [l, h] = questBossBitWrite(1, low, high, 1);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarps.BALLQUEST) >= 7) {
    const [l, h] = questBossBitWrite(1, low, high, 2);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.MDAUGHTER_QUEST_VAR) >= 70) {
    const [l, h] = questBossBitWrite(1, low, high, 3);
