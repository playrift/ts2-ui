  }
  if (useServerState(MinigameVarps.MM_MAIN) >= 9) {
    const [l, h] = questBossBitWrite(1, low, high, 30);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.DREAM_PROG) >= 28) {
    const [l, h] = questBossBitWrite(1, low, high, 31);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.HOSIDIUSQUEST) >= 11) {
    const [l, h] = questBossBitWrite(1, low, high, 32);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.CORSCURS_PROGRESS) >= 60) {
    const [l, h] = questBossBitWrite(1, low, high, 33);
    low = l;
