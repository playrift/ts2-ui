  }
  if (useServerState(MinigameVarbits.SOTE) >= 200) {
    const [l, h] = questBossBitWrite(1, low, high, 36);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.GA) >= 34) {
    const [l, h] = questBossBitWrite(1, low, high, 37);
    low = l;
    high = h;
  }
  return [low, high];
}

export function questBossThresholdMet(low: Int, high: Int): Boolean {
  let found: Int = 0;
  let bit: Int = 0;
  while (bit <= 37) {
    if (questBossBitRead(low, high, bit)) {
      found = found + 1;
      if (found >= 5) {
        return true;
      }
    }
    bit = bit + 1;
  }
  return false;
}

export function minigameExtraRequirementMet(id: Int): Int {
  switch (id) {
    case 16:
      if (useServerState(MinigameVarbits.COMBAT_LEVEL) < 40) {
        return 0;
      }
      break;
    case 15: {
      const [low, high] = questBossesBeaten();
      if (questBossThresholdMet(low, high) === false) {
        return 0;
      }
    }
  }
  return 1;
}

export function minigameAvailable(id: Int): Int {
  let open: Int = minigameRequirementMet(id, 0);
  if (open === 1) {
    open = minigameExtraRequirementMet(id);
  }
  return open;
}

export function minigameRequirement(id: Int): String {
  switch (id) {
    case 1:
      return 'Requires Barbarian Assault tutorial completion';
    case 2:
      return 'Requires partial completion of The Giant Dwarf';
    case 8:
      return 'Requires level 15 Fishing';
    case 18:
      return 'Requires Ratcatchers';
    case 20:
      return "Requires Shades of Mort'ton";
    case 28:
      return 'Requires Cabin Fever and level 40 cooking';
    case 26:
      return "Enter Farmer Gricoller's farm first";
    case 11:
      return 'Requires Temple of the Eye';
    case 13:
      return 'Speak to the Entrance Guardian first';
    case 16:
      return 'Requires combat level 40';
    case 15:
      return 'Required more quest boss completions';
    case 14:
      return 'Requires having visited Varlamore and level 60 Herblore';
    case 23:
      if (useServerState(MinigameVarbits.SQIRK_CONTACT) < 98) {
        return "Speak to Osman about sq'irk fruit.";
      }
      return "Speak to Selim about sq'irk fruit.";
  }
  return '';
}

