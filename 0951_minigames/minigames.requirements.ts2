    high = h;
  }
  if (useServerState(MinigameVarbits.LUNAR_QUEST_MAIN) >= 190) {
    const [l, h] = questBossBitWrite(1, low, high, 4);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarps.DRAGONQUEST) >= 10) {
