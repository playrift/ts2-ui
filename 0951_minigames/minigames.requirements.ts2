    low = l;
    high = h;
  }
  if (useServerState(MinigameVarbits.FAIRY_FARMERS_QUEST) >= 90) {
    const [l, h] = questBossBitWrite(1, low, high, 15);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarps.TREEQUEST) >= 9) {
    const [l, h] = questBossBitWrite(1, low, high, 16);
    low = l;
    high = h;
  }
  if (useServerState(MinigameVarps.TROLL_LOVE) >= 45) {
