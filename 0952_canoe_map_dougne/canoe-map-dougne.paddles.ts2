import { useServerState } from 'ts2';

import { CanoeStops, CanoeType, CanoeVarbits } from './canoe-map-dougne.constants';

export function canoeGetState(stop: Int): Int {
  switch (stop) {
    case CanoeStops.BARBARIAN_VILLAGE:
      return useServerState(CanoeVarbits.STATE_BARBARIAN_VILLAGE);
    case CanoeStops.CHAMPIONS_GUILD:
      return useServerState(CanoeVarbits.STATE_CHAMPIONS_GUILD);
    case CanoeStops.EDGEVILLE:
      return useServerState(CanoeVarbits.STATE_EDGEVILLE);
    case CanoeStops.LUMBRIDGE:
      return useServerState(CanoeVarbits.STATE_LUMBRIDGE);
    case CanoeStops.FEROX_ENCLAVE:
      return useServerState(CanoeVarbits.STATE_FEROX_ENCLAVE);
    case CanoeStops.CASTLE_WARS:
      return useServerState(CanoeVarbits.STATE_CASTLE_WARS);
    case CanoeStops.TREE_GNOME_VILLAGE:
      return useServerState(CanoeVarbits.STATE_TREE_GNOME_VILLAGE);
    case CanoeStops.CLOCKTOWER:
      return useServerState(CanoeVarbits.STATE_CLOCKTOWER);
    case CanoeStops.CHAOS_DRUID_TOWER:
      return useServerState(CanoeVarbits.STATE_CHAOS_DRUID_TOWER);
    case CanoeStops.TREE_GNOME_STRONGHOLD:
      return useServerState(CanoeVarbits.STATE_TREE_GNOME_STRONGHOLD);
  }
  return 0;
}

export function canoePaddleLog(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 1, 1, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 1, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [1, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [1, 1, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 1, 1, 0, 1, 1];
    case CanoeStops.CASTLE_WARS:
      return [1, 0, 1, 1, 1, 1];
    case CanoeStops.TREE_GNOME_VILLAGE:
      return [0, 1, 0, 1, 1, 1];
    case CanoeStops.CLOCKTOWER:
      return [1, 0, 1, 0, 1, 1];
    case CanoeStops.CHAOS_DRUID_TOWER:
      return [1, 1, 0, 1, 0, 1];
    case CanoeStops.TREE_GNOME_STRONGHOLD:
      return [1, 1, 1, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleDugout(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 1, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [1, 0, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 1, 0, 0, 1, 1];
    case CanoeStops.CASTLE_WARS:
      return [1, 0, 0, 1, 1, 1];
    case CanoeStops.TREE_GNOME_VILLAGE:
      return [0, 1, 0, 0, 1, 1];
    case CanoeStops.CLOCKTOWER:
      return [0, 0, 1, 0, 0, 1];
    case CanoeStops.CHAOS_DRUID_TOWER:
      return [1, 0, 0, 1, 0, 1];
    case CanoeStops.TREE_GNOME_STRONGHOLD:
      return [1, 1, 0, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleStableDugout(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 0, 1, 1];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 1, 1];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 1, 1];
    case CanoeStops.EDGEVILLE:
      return [0, 0, 0, 1, 1, 1];
    case CanoeStops.FEROX_ENCLAVE:
      return [1, 0, 0, 0, 1, 1];
    case CanoeStops.CASTLE_WARS:
      return [1, 0, 0, 0, 1, 1];
    case CanoeStops.TREE_GNOME_VILLAGE:
      return [0, 1, 0, 0, 0, 1];
    case CanoeStops.CLOCKTOWER:
      return [0, 0, 1, 0, 0, 1];
    case CanoeStops.CHAOS_DRUID_TOWER:
      return [0, 0, 0, 1, 0, 1];
    case CanoeStops.TREE_GNOME_STRONGHOLD:
      return [1, 0, 0, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoePaddleStableWaka(from: Int): [Int, Int, Int, Int, Int, Int] {
  switch (from) {
    case CanoeStops.LUMBRIDGE:
      return [1, 0, 0, 0, 0, 0];
    case CanoeStops.CHAMPIONS_GUILD:
      return [0, 1, 0, 0, 0, 0];
    case CanoeStops.BARBARIAN_VILLAGE:
      return [0, 0, 1, 0, 0, 0];
    case CanoeStops.EDGEVILLE:
      return [0, 0, 0, 1, 0, 0];
    case CanoeStops.FEROX_ENCLAVE:
      return [0, 0, 0, 0, 0, 1];
    case CanoeStops.CASTLE_WARS:
      return [1, 0, 0, 0, 0, 1];
    case CanoeStops.TREE_GNOME_VILLAGE:
      return [0, 1, 0, 0, 0, 1];
    case CanoeStops.CLOCKTOWER:
      return [0, 0, 1, 0, 0, 1];
    case CanoeStops.CHAOS_DRUID_TOWER:
      return [0, 0, 0, 1, 0, 1];
    case CanoeStops.TREE_GNOME_STRONGHOLD:
      return [0, 0, 0, 0, 1, 1];
  }
  return [1, 1, 1, 1, 1, 1];
}

export function canoeReturnLocations(): [Int, Int, Int, Int, Int, Int] {
  const from: Int = useServerState(CanoeVarbits.START_FROM);
  switch (canoeGetState(from)) {
    case CanoeType.LOG:
      return canoePaddleLog(from);
    case CanoeType.DUGOUT:
      return canoePaddleDugout(from);
    case CanoeType.STABLE_DUGOUT:
      return canoePaddleStableDugout(from);
    case CanoeType.STABLE_WAKA:
      return canoePaddleStableWaka(from);
  }
  return [0, 0, 0, 0, 0, 0];
}

export function canoeStopOffered(stop: Int): Int {
  const [one, two, three, four, five, six] = canoeReturnLocations();
  if (stop === CanoeStops.LUMBRIDGE || stop === CanoeStops.CASTLE_WARS) {
    if (one === 1) {
      return 0;
    }
    return 1;
  }
  if (stop === CanoeStops.CHAMPIONS_GUILD || stop === CanoeStops.TREE_GNOME_VILLAGE) {
    if (two === 1) {
      return 0;
    }
    return 1;
  }
  if (stop === CanoeStops.BARBARIAN_VILLAGE || stop === CanoeStops.CLOCKTOWER) {
    if (three === 1) {
      return 0;
    }
    return 1;
  }
  if (stop === CanoeStops.EDGEVILLE || stop === CanoeStops.CHAOS_DRUID_TOWER) {
    if (four === 1) {
      return 0;
    }
    return 1;
  }
  if (stop === CanoeStops.WILDERNESS_POND || stop === CanoeStops.TREE_GNOME_STRONGHOLD) {
    if (five === 1) {
      return 0;
    }
    return 1;
  }
  if (stop === CanoeStops.FEROX_ENCLAVE) {
    if (six === 1) {
      return 0;
    }
    return 1;
  }
  return 0;
}

export function canoeFlagAt(position: Int): Int {
  const [one, two, three, four, five, six] = canoeReturnLocations();
  switch (position) {
    case 1:
      return one;
    case 2:
      return two;
    case 3:
      return three;
    case 4:
      return four;
    case 5:
      return five;
    case 6:
      return six;
  }
  return 1;
}
