import { useInventory, useUniverse } from 'ts2';

import { itemName } from '../lib/lib.engine';
import { flashFor } from '../lib/lib.components';
import { ButlerInventory, Fade, Grid } from './butlers-bell-collection-display.constants';

export function ButlerLabourGrid(): Component {
  const universe = useUniverse();
  const haul = useInventory(ButlerInventory.HAUL);

  const gap: Int = universe.width / Grid.COLUMNS - Grid.SLOT_W;
  const inset: Int = gap / 2;

  return (
    <layer w="fill" h="fill">
      {haul.map(
        (item, slot) =>
          item !== -1 && (
            <sprite
              x={inset + (slot % Grid.COLUMNS) * (Grid.SLOT_W + gap)}
              y={(slot / Grid.COLUMNS) * (Grid.SLOT_H + gap)}
              w={Grid.SLOT_W}
              h={Grid.SLOT_H}
              item={item}
              itemCount={haul.count(slot)}
              outline={Grid.OUTLINE}
              shadowColor={Grid.SHADOW}
              optionSubject={`<col=ff9040>${itemName(item)}</col>`}
              options={['', '', '', '', '', '', '', '', '', 'Examine']}
              onOptionSelect={(event) => {
                flashFor(event.self, Fade.PRESSED, Fade.REST);
              }}
            />
          ),
      )}
    </layer>
  );
}
