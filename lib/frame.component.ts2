import { CORNER, FrameSprites } from './lib.constants';

export function Frame({
  topLeft,
  topRight,
  bottomLeft,
  bottomRight,
  left,
  top,
  right,
  bottom,
  children,
}: FrameSprites & { children?: Children }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="left" y="top" w={CORNER} h={CORNER} sprite={topLeft} tiling />
      <sprite x="right" y="top" w={CORNER} h={CORNER} sprite={topRight} tiling />
      <sprite x="left" y="bottom" w={CORNER} h={CORNER} sprite={bottomLeft} tiling />
      <sprite x="right" y="bottom" w={CORNER} h={CORNER} sprite={bottomRight} tiling />

      <sprite x="left" y={CORNER} w={CORNER} h={{ fill: CORNER * 2 }} sprite={left} tiling />
      <sprite x={CORNER} y="top" w={{ fill: CORNER * 2 }} h={CORNER} sprite={top} tiling />
      <sprite x="right" y={CORNER} w={CORNER} h={{ fill: CORNER * 2 }} sprite={right} tiling />
      <sprite x={CORNER} y="bottom" w={{ fill: CORNER * 2 }} h={CORNER} sprite={bottom} tiling />

      <layer w="fill" h="fill">
        {children}
      </layer>
    </layer>
  );
}
