  [Relic.TRANSMUTE, 3],
  [Relic.CONNIVING_CLUES, 3],
  [Relic.BUTLERS_BELL, 3],
  [Relic.NATURES_ACCORD, 4],
  [Relic.LARCENIST, 4],
  [Relic.SOUL_HARVEST, 4],
  [Relic.GRIMOIRE, 5],
  [Relic.ETERNAL_SUSTENANCE, 5],
  [Relic.CULLING_SPREE, 5],
  [Relic.FLOW_STATE, 6],
  [Relic.RELOADED, 6],
  [Relic.EXECUTIONER, 7],
  [Relic.MINION, 7],
  [Relic.FLASK_OF_FERVOUR, 7],
