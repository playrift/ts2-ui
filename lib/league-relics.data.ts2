  [3, RelicSelectionTier3],
  [4, RelicSelectionTier4],
  [5, RelicSelectionTier5],
  [6, RelicSelectionTier6],
  [7, RelicSelectionTier7],
]);

export const LeagueRelicTiers = mapOf<Int, Map<Int, Map<Int, Relic>>>([
  [1, RelicTierSelections],
  [2, RelicTierSelections],
