export interface LeagueToggleRow {
  readonly name: String;
  readonly inverted: Boolean;
  readonly bit: Int;
}

export const LeagueToggles = listOf<LeagueToggleRow>([
  { name: 'Endless harvest bank toggle', inverted: false, bit: 0 },
  { name: 'Barbarian Gathering dispose toggle', inverted: false, bit: 1 },
  { name: 'Abundance coin inv toggle', inverted: false, bit: 2 },
  { name: 'Woodsman bank toggle', inverted: false, bit: 3 },
  { name: 'Woodsman burn toggle', inverted: false, bit: 4 },
  { name: 'Transmutation alchemy toggle', inverted: false, bit: 5 },
  { name: 'Transmutation bank toggle', inverted: true, bit: 6 },
  { name: 'Soul Harvest bone toggle', inverted: false, bit: 7 },
]);

export const enum LeagueToggle {
  ENDLESS_HARVEST_BANK = 0,
  BARBARIAN_GATHERING_DISPOSE = 1,
  ABUNDANCE_COIN_INV = 2,
  WOODSMAN_BANK = 3,
  WOODSMAN_BURN = 4,
  TRANSMUTATION_ALCHEMY = 5,
  TRANSMUTATION_BANK = 6,
  SOUL_HARVEST_BONE = 7,
}
