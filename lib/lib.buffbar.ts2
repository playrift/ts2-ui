import { CS2, useState } from 'ts2';

import { buffBarShownCount, buffDisplayRef } from '../0651_buff_bar/buff-bar.constants';

const CELL = 37;

export function buffBarColumns(): Int {
  return CS2.if_width_get(buffDisplayRef) / CELL;
}

export function buffBarRows(): Int {
  return CS2.if_height_get(buffDisplayRef) / CELL;
}

export function buffBarCount(): Int {
  const [shown] = useState(buffBarShownCount);
  return shown;
}
