import { CS2 } from 'ts2';

const CELL = 37;

const BUFF_STRIDE = 11;

export function buffBarColumns(): Int {
  return CS2.if_width_get(componentOf(651, 4)) / CELL;
}

export function buffBarRows(): Int {
  return CS2.if_height_get(componentOf(651, 4)) / CELL;
}

export function buffBarCount(): Int {
  let found: Int = 0;
  let index: Int = 0;
  while (CS2.cc_find(componentOf(651, 4), index)) {
    found = found + 1;
    index = index + BUFF_STRIDE;
  }
  return found;
}
