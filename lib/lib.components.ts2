import { stopTimer } from 'ts2';

import { clientClock } from './lib.engine';

export function setTransparency(target: ComponentId, transparency: Int): void {
  target.transparency = transparency;
}

const FLASH_CYCLES = 10;

export function flashFor(target: ComponentId, flash: Int, restore: Int): void {
  const restoreAt: Int = clientClock() + FLASH_CYCLES;
  target.transparency = flash;
  target.onTimer = () => {
    if (clientClock() < restoreAt) {
      return;
    }
    target.transparency = restore;
    stopTimer(target);
  };
}
