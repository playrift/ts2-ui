import { chatMessage } from './lib.engine';
import { rentalWorld } from '../0134_settings/settings.helpers';

export function debugMessage(text: String): void {
  if (rentalWorld()) {
    chatMessage(`DEBUG - ${text}`);
  }
}

export function debugMessageAlias(text: String): void {
  debugMessage(text);
}

export function errorMessage(text: String): void {
  debugMessage(`ERROR - ${text}`);
}
