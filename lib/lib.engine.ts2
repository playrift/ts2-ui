import { CS2 } from 'ts2';

export function playSound(sound: Int): void {
  CS2.sound_effect(sound, 1, 0);
}

export function scaled(value: Int, ofMax: Int, intoRange: Int): Int {
  return CS2.scale(value, ofMax, intoRange);
}

export function hasBit(flags: Int, position: Int): Boolean {
  return CS2.testbit(flags, position);
}

export function itemName(item: Item): String {
  return CS2.item_name(item);
}

export function textLineCount(text: String, maxWidth: Int, font: Font): Int {
  return CS2.paraheight(text, maxWidth, font);
}

export function textWidth(text: String, maxWidth: Int, font: Font): Int {
  return CS2.parawidth(text, maxWidth, font);
}

export function membersWorld(): Boolean {
  return CS2.map_members();
}

export function clientClock(): Int {
  return CS2.clientclock();
}

export function chatMessage(text: String): void {
  CS2.message(text);
}

export function playerCoord(): Coord {
  return CS2.coord();
}

export function moveCoord(from: Coord, dx: Int, dz: Int, dplane: Int): Coord {
  return CS2.movecoord(from, dx, dplane, dz);
}
