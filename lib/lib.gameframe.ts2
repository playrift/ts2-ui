import { CS2 } from 'ts2';

import { Toplevel } from './lib.constants';
import { FixedSlots } from './game/gameframe-1129.data';
import { StretchSlots } from './game/gameframe-1130.data';
import { PreEocSlots } from './game/gameframe-1131.data';
import { DisplaySlots } from './game/gameframe-1132.data';
import { MobileSlots } from './game/gameframe-1745.data';
import { SpectatorSlots } from './game/gameframe-139.data';

export const enum GameframeSlot {
  VIEWPORT = 10551312,
  SUB_MOUNT = 10551314,
}

export function gameframeSlot(slot: GameframeSlot): ComponentId {
  const top = CS2.if_top_get();
  if (top === Toplevel.MOBILE) return MobileSlots.get(slot);
  if (top === Toplevel.STRETCH) return StretchSlots.get(slot);
  if (top === Toplevel.PRE_EOC) return PreEocSlots.get(slot);
  if (top === Toplevel.FIXED) return FixedSlots.get(slot);
  if (top === Toplevel.DISPLAY) return DisplaySlots.get(slot);
  if (top === Toplevel.SPECTATOR) return SpectatorSlots.get(slot);
  return -1;
}
