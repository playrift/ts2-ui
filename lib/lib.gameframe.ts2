import { CS2 } from 'ts2';

import { controlRef } from '../0601_toplevel_osm/toplevel-osm.constants';
import { universeRef as fixedFrameRef } from '../0548_toplevel/toplevel.constants';
import { gameframeRef as displayFrameRef } from '../0165_toplevel_display/toplevel-display.constants';
import { controlRef as spectatorFrameRef } from '../0080_toplevel_spectator/toplevel-spectator.constants';
import { controlRef as preEocFrameRef } from '../0164_toplevel_pre_eoc/toplevel-pre-eoc.constants';
import { controlRef as stretchFrameRef } from '../0161_toplevel_osrs_stretch/toplevel-osrs-stretch.constants';
import { FixedSlots } from './game/gameframe-1129.data';
import { StretchSlots } from './game/gameframe-1130.data';
import { PreEocSlots } from './game/gameframe-1131.data';
import { DisplaySlots } from './game/gameframe-1132.data';
import { MobileSlots } from './game/gameframe-1745.data';
import { SpectatorSlots } from './game/gameframe-139.data';

export enum GameframeSlot {
  VIEWPORT = 161 * 65536 + 16,
  SUB_MOUNT = 161 * 65536 + 18,

  HPBAR_HUD = 161 * 65536 + 2,
  PVP_ICONS = 161 * 65536 + 3,
  STAT_BOOSTS_HUD = 161 * 65536 + 5,
  BUFF_BAR = 161 * 65536 + 6,
  HELPER_CONTENT = 161 * 65536 + 12,
  MULTIWAY_ICON = 161 * 65536 + 20,
  GRAVESTONE = 161 * 65536 + 21,
  SIDE_MODAL = 161 * 65536 + 74,
  SIDE_CONTAINER = 164 * 65536 + 96,
  SAFE_ZONE = 601 * 65536 + 19,
  SAFE_ZONE_NOCLICK = 601 * 65536 + 2,
  SIDE_RIGHT_TABS = 601 * 65536 + 50,
  CHAT_TOGGLE = 601 * 65536 + 46,
  CHAT_CONTAINER = 161 * 65536 + 96,
}

export function gameframeSlot(slot: GameframeSlot): ComponentId {
  const top = CS2.if_top_get();
  if (top === interfaceOf(controlRef)) return MobileSlots.get(slot) ?? -1;
  if (top === interfaceOf(stretchFrameRef)) return StretchSlots.get(slot) ?? -1;
  if (top === interfaceOf(preEocFrameRef)) return PreEocSlots.get(slot) ?? -1;
  if (top === interfaceOf(fixedFrameRef)) return FixedSlots.get(slot) ?? -1;
  if (top === interfaceOf(displayFrameRef)) return DisplaySlots.get(slot) ?? -1;
  if (top === interfaceOf(spectatorFrameRef)) return SpectatorSlots.get(slot) ?? -1;
  return -1;
}
