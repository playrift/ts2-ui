import { CS2, useServerState } from 'ts2';
import {
  ARROW,
  CAP,
  ClientVarbits,
  Sounds,
  Toplevel,
  ToplevelComponents,
  WarningMessageVarbits,
  WarningSprites,
} from './lib.constants';

export function onMobile(): Boolean {
  if (useServerState(ClientVarbits.SIMULATE_MOBILE) === 1) {
    return true;
  }
  if (CS2.clienttype() === 7) {
    return true;
  }
  return CS2.on_mobile();
}

export function textDevice(desktop: String, mobile: String): String {
  if (onMobile()) {
    return mobile;
  }
  return desktop;
}

export function toplevelComponents(): Int {
  if (CS2.if_top_get() === Toplevel.MOBILE) {
    return ToplevelComponents.MOBILE;
  }
  if (CS2.if_top_get() === Toplevel.STRETCH) {
    return ToplevelComponents.STRETCH;
  }
  if (CS2.if_top_get() === Toplevel.PRE_EOC) {
    return ToplevelComponents.PRE_EOC;
  }
  if (CS2.if_top_get() === Toplevel.FIXED) {
    return ToplevelComponents.FIXED;
  }
  if (CS2.if_top_get() === Toplevel.DISPLAY) {
    return ToplevelComponents.DISPLAY;
  }
  if (CS2.if_top_get() === Toplevel.SPECTATOR) {
    return ToplevelComponents.SPECTATOR;
  }
  return ToplevelComponents.NONE;
}

export function graphicSwapper(component: ComponentId, sprite: Sprite): void {
  component.sprite = sprite;
}

export function graphicSwapperUnlessMobile(component: ComponentId, sprite: Sprite): void {
  if (!onMobile()) {
    component.sprite = sprite;
  }
}

export function graphicPairSwapperUnlessMobile(
  first: ComponentId,
  firstSprite: Sprite,
  second: ComponentId,
  secondSprite: Sprite,
): void {
  if (onMobile()) {
    return;
  }
  first.sprite = firstSprite;
  second.sprite = secondSprite;
}

export function closeInterface(): void {
  CS2.if_close();
}

export function trackScroll(gutter: Ref, thumb: Ref, capTop: Ref, capBottom: Ref, content: Ref): void {
  const range: Int = Math.max(1, content.scrollHeight - content.height);
  const travel: Int = gutter.height - thumb.height;
  const y: Int = ARROW + (travel * content.scrollY) / range;

  thumb.y = y;
  capTop.y = y;
  capBottom.y = y + thumb.height - CAP;
}

export function opsound(bit: Int, mask: Int): void {
  if (CS2.testbit(mask, bit)) {
    CS2.sound_effect(Sounds.CLICK, 1, 0);
  }
}

export function getWarningSetting(messageId: Int): Int {
  switch (messageId) {
    case 1:
      return useServerState(WarningMessageVarbits.MESSAGE_1);
    case 2:
      return useServerState(WarningMessageVarbits.MESSAGE_2);
    case 3:
      return useServerState(WarningMessageVarbits.MESSAGE_3);
    case 4:
      return useServerState(WarningMessageVarbits.MESSAGE_4);
    case 5:
      return useServerState(WarningMessageVarbits.MESSAGE_5);
    case 6:
      return useServerState(WarningMessageVarbits.MESSAGE_6);
    case 7:
      return useServerState(WarningMessageVarbits.MESSAGE_7);
    case 8:
      return useServerState(WarningMessageVarbits.MESSAGE_8);
    case 9:
      return useServerState(WarningMessageVarbits.MESSAGE_9);
    case 10:
      return useServerState(WarningMessageVarbits.MESSAGE_10);
    case 11:
      return useServerState(WarningMessageVarbits.MESSAGE_11);
    case 12:
      return useServerState(WarningMessageVarbits.MESSAGE_12);
    case 13:
      return useServerState(WarningMessageVarbits.MESSAGE_13);
    case 14:
      return useServerState(WarningMessageVarbits.MESSAGE_14);
    case 15:
      return useServerState(WarningMessageVarbits.MESSAGE_15);
    case 16:
      return useServerState(WarningMessageVarbits.MESSAGE_16);
    case 17:
      return useServerState(WarningMessageVarbits.MESSAGE_17);
    case 18:
      return useServerState(WarningMessageVarbits.MESSAGE_18);
    case 19:
      return useServerState(WarningMessageVarbits.MESSAGE_19);
    case 20:
      return useServerState(WarningMessageVarbits.MESSAGE_20);
    case 23:
      return useServerState(WarningMessageVarbits.MESSAGE_23);
    case 24:
      return useServerState(WarningMessageVarbits.MESSAGE_24);
    case 25:
      return useServerState(WarningMessageVarbits.MESSAGE_25);
    case 26:
      return useServerState(WarningMessageVarbits.MESSAGE_26);
  }
  return 0;
}

export function resetWarningToggleIcon(component: ComponentId): void {
  component.sprite = WarningSprites.ICON_1;
}

export function syncWarningToggleIcon(component: ComponentId, messageId: Int): void {
  if (getWarningSetting(messageId) === 7) {
    component.sprite = WarningSprites.ICON_2;
  } else {
    component.sprite = WarningSprites.ICON_1;
  }
}

export function setWarningHoverColor(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function coordInBox(min: Coord, max: Coord, at: Coord): Boolean {
  if (at.x < min.x || at.x > max.x) {
    return false;
  }
  if (at.plane < min.plane || at.plane > max.plane) {
    return false;
  }
  if (at.z < min.z || at.z > max.z) {
    return false;
  }
  return true;
}
