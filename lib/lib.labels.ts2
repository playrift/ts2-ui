import { itemName } from './lib.engine';

export function insertLabel(display: Item, selected: Item): String {
  if (display !== -1) {
    if (selected !== -1) {
      return `Replace <col=ff9040>${itemName(display)}</col> with <col=ff9040>${itemName(selected)}</col>`;
    }
    return `Replace <col=ff9040>${itemName(display)}</col>`;
  }
  if (selected !== -1) {
    return `Insert <col=ff9040>${itemName(selected)}</col>`;
  }
  return 'Insert';
}
