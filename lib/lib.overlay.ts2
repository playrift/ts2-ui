import { CS2, useServerState, useState } from 'ts2';

import { scaled } from './lib.engine';
import { onMobile, toplevelComponents } from './lib.helpers';
import { ToplevelComponents } from './lib.constants';
import { GameframeSlot, gameframeSlot } from './lib.gameframe';
import { buffBarColumns, buffBarRows, buffBarCount } from './lib.buffbar';
import {
  CHAT_LINES,
  ChatLines,
  OverlayInsetBottom,
  OverlayInsetLeft,
  OverlayInsetRight,
  ToplevelPanels,
} from './lib.overlay.data';
import { Varbits } from './game/varbits';
import {
  buffBarDodgerUpdate,
  chatView,
  dodgerHudToDodge,
  dodgerHudToDodgeAlign,
  dodgerTracker,
  osmChatboxDisabled,
  osmChatboxFiltersDisabled,
  osmDeadsides,
  osmSidepanelOnLeft,
  osmTabExpansionDisabled,
  toplevelPanel,
} from './game/varcs';

export enum Anchor {
  LEFT = 0,
  CENTRE = 1,
  RIGHT = 2,
  TOP = 0,
  BOTTOM = 2,
}

const enum SizeMode {
  ABS = 0,
  MINUS = 1,
}

export enum OverlayDodge {
  MOBILE_SIDE_STRIP = 2,
  MOBILE_MINIMAP = 4,
  MOBILE_CHATBOX = 8,
  SAFE_AREA_CLAMPED = 16,
  HPBAR_HUD = 32,
  HELPER_CONTENT = 64,
  XP_DROPS = 128,
  XP_DROPS_IF_ENABLED = 512,
  MOUSEOVER_TEXT = 1024,
  BUFF_BAR = 2048,
  GAMEFRAME_EDGES = 4096,
  SAFE_AREA = 8192,
  CHAT_LINES = 16384,
  STAT_BOOSTS = 32768,
  REGISTER_AS_HUD = 65536,
  DODGE_REGISTERED_HUD = 131072,
  PVP_ICONS = 262144,
  EXTRA_GAP = -2147483648,
}

export function mobileGameframe(layout: Int): Boolean {
  if (layout === ToplevelComponents.MOBILE) {
    return true;
  }
  return false;
}

export function clampDeadSides(): void {
  const [deadSides, setDeadSides] = useState(osmDeadsides);
  if (deadSides < 0 || deadSides > 2200) {
    setDeadSides(250);
  }
}

export function statBoostsShown(): Boolean {
  if (CS2.cc_find(componentOf(708, 6), 0)) {
    return true;
  }
  return false;
}

export function mobileFullscreenOpen(): Int {
  if (!onMobile()) {
    return 0;
  }
  if (CS2.cc_find(componentOf(12, 12), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(192, 24), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(402, 5), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(451, 2), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(465, 26), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(213, 1), 0)) {
    return 1;
  }
  if (CS2.cc_find(componentOf(14, 1), 0)) {
    return 1;
  }
  return 0;
}

export function mobileSidePanelOnLeft(): Int {
  if (!onMobile()) {
    return 0;
  }
  const [onLeft] = useState(osmSidepanelOnLeft);
  if (
    onLeft === 1 &&
    useServerState(Varbits.SETTINGS_OSM_HOTKEYS_OPEN_SIDEPANELS_ON_LEFT) === 1 &&
    mobileFullscreenOpen() === 0
  ) {
    return 1;
  }
  return 0;
}

export function chatboxOpen(): Int {
  if (
    CS2.if_sub_has(componentOf(162, 566)) ||
    CS2.if_sub_has(componentOf(162, 567)) ||
    !CS2.if_hide_get(componentOf(162, 39))
  ) {
    return 0;
  }
  const [view] = useState(chatView);
  if (onMobile()) {
    const [chatDisabled] = useState(osmChatboxDisabled);
    const [filtersDisabled] = useState(osmChatboxFiltersDisabled);
    if (chatDisabled === 1) {
      if (useServerState(Varbits.SETTINGS_MOBILE_SHOW_FILTER_STONES_ENABLED) === 1) {
        return 1;
      }
      return 2;
    } else if (view === 1337) {
      if (filtersDisabled === 1) {
        return 2;
      }
      return 1;
    } else if (view !== 1337 && chatDisabled !== 1) {
      return 0;
    }
  } else if (view !== 1337) {
    return 0;
  }
  return 1;
}

export function mobileSideStripMode(): Int {
  const layout: Int = toplevelComponents();
  if (!mobileGameframe(layout)) {
    return 0;
  }
  const [panel] = useState(toplevelPanel);
  const [expansionDisabled] = useState(osmTabExpansionDisabled);
  const openPanel: ComponentId = ToplevelPanels.at(panel) ?? -1;

  if (
    CS2.if_sub_has(gameframeSlot(GameframeSlot.SIDE_MODAL)) &&
    CS2.if_sub_has(gameframeSlot(GameframeSlot.VIEWPORT))
  ) {
    if (expansionDisabled === 1) {
      return 3;
    }
    return 4;
  }
  if (openPanel !== -1) {
    if (expansionDisabled === 1) {
      return 3;
    }
    return 4;
  }
  if (CS2.if_sub_has(gameframeSlot(GameframeSlot.SIDE_MODAL))) {
    if (expansionDisabled === 1) {
      return 3;
    }
    return 4;
  }
  if (expansionDisabled !== 1) {
    return 2;
  }
  return 1;
}

export function positionMultiwayIcons(multiway: ComponentId, layout: Int): void {
  if (useServerState(Varbits.OSM_MINIMAP_TOGGLE) === 0) {
    CS2.if_position_set(140, 177, Anchor.RIGHT, Anchor.TOP, multiway);
  } else {
    CS2.if_position_set(111, 76, Anchor.RIGHT, Anchor.TOP, multiway);
  }
  const gravestone: ComponentId = gameframeSlot(GameframeSlot.GRAVESTONE);
  if (gravestone !== -1) {
    if (useServerState(Varbits.OSM_MINIMAP_TOGGLE) === 0) {
      CS2.if_position_set(163, 176, Anchor.RIGHT, Anchor.TOP, gravestone);
    } else {
      CS2.if_position_set(109, 99, Anchor.RIGHT, Anchor.TOP, gravestone);
    }
  }
}

export function absoluteY(component: ComponentId): Int {
  if (component === -1) {
    return 0;
  }
  let y: Int = CS2.if_y_get(component);
  let parent: ComponentId = CS2.if_layer_get(component);
  while (parent !== -1) {
    y = y + CS2.if_y_get(parent);
    parent = CS2.if_layer_get(parent);
  }
  return y;
}

export function absoluteX(component: ComponentId): Int {
  if (component === -1) {
    return 0;
  }
  let x: Int = CS2.if_x_get(component);
  let parent: ComponentId = CS2.if_layer_get(component);
  while (parent !== -1) {
    x = x + CS2.if_x_get(parent);
    parent = CS2.if_layer_get(parent);
  }
  return x;
}

export function boxesOverlap(
  first: ComponentId,
  firstDx: Int,
  firstDy: Int,
  second: ComponentId,
  secondDx: Int,
  secondDy: Int,
): Boolean {
  const firstW: Int = CS2.if_width_get(first);
  const firstH: Int = CS2.if_height_get(first);
  const firstX: Int = absoluteX(first) + firstDx;
  const firstY: Int = absoluteY(first) + firstDy;

  const secondW: Int = CS2.if_width_get(second);
  const secondH: Int = CS2.if_height_get(second);
  const secondX: Int = absoluteX(second) + secondDx;
  const secondY: Int = absoluteY(second) + secondDy;

  if (firstX >= secondX && firstX <= secondX + secondW) {
    if (firstY >= secondY && firstY <= secondY + secondH) {
      return true;
    } else if (firstY + firstH >= secondY && firstY + firstH <= secondY + secondH) {
      return true;
    }
  }
  if (firstX + firstW >= secondX && firstX + firstW <= secondX + secondW) {
    if (firstY >= secondY && firstY <= secondY + secondH) {
      return true;
    } else if (firstY + firstH >= secondY && firstY + firstH <= secondY + secondH) {
      return true;
    }
  }
  if (secondX >= firstX && secondX <= firstX + firstW) {
    if (secondY >= firstY && secondY <= firstY + firstH) {
      return true;
    } else if (secondY + secondH >= firstY && secondY + secondH <= firstY + firstH) {
      return true;
    }
  }
  if (secondX + secondW >= firstX && secondX + secondW <= firstX + firstW) {
    if (secondY >= firstY && secondY <= firstY + firstH) {
      return true;
    } else if (secondY + secondH >= firstY && secondY + secondH <= firstY + firstH) {
      return true;
    }
  }
  return false;
}

export function hudDodgedAway(which: Int): Boolean {
  const [tracker] = useState(dodgerTracker);
  if (which === 0) {
    if (
      CS2.testbit(tracker, 0) &&
      enhancedAny() &&
      useServerState(Varbits.HPBAR_HUD_BOSS) === 0 &&
      CS2.if_sub_has(gameframeSlot(GameframeSlot.HPBAR_HUD))
    ) {
      return true;
    }
  }
  if (which === 1) {
    if (CS2.testbit(tracker, 1) && enhancedAny() && CS2.if_sub_has(gameframeSlot(GameframeSlot.HELPER_CONTENT))) {
      return true;
    }
  }
  return false;
}

export function markDodged(dodger: ComponentId, flags: Int): void {
  const [tracker, setTracker] = useState(dodgerTracker);
  let next: Int = tracker;
  if (dodger === componentOf(303, 4)) {
    next = CS2.bit_set(next, 0);
  }
  if (CS2.testbit(flags, 31)) {
    next = CS2.bit_set(next, 1);
  }
  setTracker(next);
}

export function markNotDodged(dodger: ComponentId, flags: Int): void {
  const [tracker, setTracker] = useState(dodgerTracker);
  let next: Int = tracker;
  if (dodger === componentOf(303, 4)) {
    next = CS2.bit_clear(next, 0);
  }
  if (CS2.testbit(flags, 31)) {
    next = CS2.bit_clear(next, 1);
  }
  setTracker(next);
}

export function enhancedAny(): Boolean {
  const simulated: Int = useServerState(Varbits.OSM_SIMULATE);
  const type: Int = CS2.clienttype();
  if (simulated !== 1 && (type === 4 || type === 5 || type === 10)) {
    return true;
  }
  if (simulated === 1 && (type === 4 || type === 5 || type === 10)) {
    return true;
  }
  if (type === 7 || type === 8) {
    return true;
  }
  return false;
}

export function stackBelow(flags: Int, ran: Int, layout: Int, align: Int, content: ComponentId, top: Int): Int {
  if (content === -1) {
    return 0;
  }
  let above: ComponentId = -1;

  if (CS2.testbit(ran, 6)) {
    if (hudDodgedAway(1)) {
      if (align === Anchor.RIGHT) {
        above = gameframeSlot(GameframeSlot.HELPER_CONTENT);
      }
    } else if (align === Anchor.LEFT) {
      above = gameframeSlot(GameframeSlot.HELPER_CONTENT);
    }
  }
  if (above === -1 && CS2.testbit(ran, 5)) {
    if (align === Anchor.LEFT && !hudDodgedAway(0)) {
      above = componentOf(303, 5);
    } else if (align === Anchor.RIGHT && hudDodgedAway(0)) {
      above = componentOf(303, 5);
    }
  }
  if (above === -1 && CS2.testbit(ran, 7)) {
    let dodgeDrops: Int = 0;
    const position: Int = useServerState(Varbits.XPDROPS_POSITION);
    if (align === Anchor.LEFT && position === 2) {
      dodgeDrops = 1;
    } else if (align === Anchor.CENTRE && position === 1) {
      dodgeDrops = 1;
    } else if (align === Anchor.RIGHT && position === 0) {
      dodgeDrops = 1;
    }
    if (useServerState(Varbits.XPDROPS_ENABLED) === 0 && CS2.testbit(flags, 9)) {
      dodgeDrops = 0;
    }
    if (dodgeDrops === 1) {
      above = componentOf(122, 4);
    }
  }

  let extra: Int = 0;
  if (CS2.testbit(flags, 31) && CS2.testbit(ran, 17) && CS2.window_mode_get() === 1) {
    extra = extra + 4;
  }

  if (above === -1) {
    return 0;
  }
  let gap: Int = absoluteY(above) + CS2.if_height_get(above);
  gap = gap - (absoluteY(content) + top);
  gap = gap + 2 + extra;
  return Math.max(0, gap);
}

export function overlayLayout(
  dodger: ComponentId,
  content: ComponentId,
  flags: Int,
  xAnchor: Int,
  yAnchor: Int,
  sideways: Int,
): void {
  let universeW: Int = CS2.if_width_get(dodger);
  let universeH: Int = CS2.if_height_get(dodger);
  const parent: ComponentId = CS2.if_layer_get(dodger);
  if (parent !== -1) {
    universeW = CS2.if_width_get(parent);
    universeH = CS2.if_height_get(parent);
  }

  let left: Int = 0;
  let top: Int = 0;
  let right: Int = 0;
  let bottom: Int = 0;
  let altTop: Int = 0;
  let altBottom: Int = 0;
  let altRight: Int = 0;

  const mobile: Boolean = onMobile();
  if (mobile) {
    top = top + 2;
    altTop = altTop + 2;
  }
  const enhanced: Boolean = enhancedAny();
  const layout: Int = toplevelComponents();
  const align: Int = xAnchor;
  let ran: Int = 0;

  let safeArea: Int = 0;
  if (CS2.testbit(flags, 13)) {
    safeArea = 1;
  } else if (CS2.testbit(flags, 4)) {
    safeArea = 2;
  }

  const safeZone: ComponentId = gameframeSlot(GameframeSlot.SAFE_ZONE);
  if (dodger !== safeZone) {
    CS2.if_position_set(0, 0, align, yAnchor, dodger);
    if (layout !== ToplevelComponents.DISPLAY || flags !== CS2.bit_set(0, 13)) {
      CS2.if_size_set(0, 0, SizeMode.MINUS, SizeMode.MINUS, dodger);
    }
  }

  if (mobile && safeArea > 0 && parent !== -1) {
    const [deadSidesRaw] = useState(osmDeadsides);
    let deadSides: Int = deadSidesRaw;
    if (safeArea === 2) {
      deadSides = Math.min(250, deadSides);
    }
    clampDeadSides();
    const side: Int = scaled(deadSides, 16384, universeW);
    const safeLeft: Int = Math.max(CS2.safearea_minx_get(), side);
    const safeTop: Int = CS2.safearea_miny_get();
    const safeRight: Int = Math.min(CS2.safearea_maxx_get(), universeW - side);
    const safeBottom: Int = CS2.safearea_maxy_get();

    if (dodger === safeZone) {
      const noClick: ComponentId = gameframeSlot(GameframeSlot.SAFE_ZONE_NOCLICK);
      if (noClick !== -1) {
        safeAreaBlocker(noClick, 0, Anchor.CENTRE, Anchor.TOP, 0, safeTop, SizeMode.MINUS, SizeMode.ABS);
        safeAreaBlocker(noClick, 1, Anchor.CENTRE, Anchor.BOTTOM, 0, safeBottom, SizeMode.MINUS, SizeMode.MINUS);
        safeAreaBlocker(noClick, 2, Anchor.LEFT, Anchor.CENTRE, safeLeft, 0, SizeMode.ABS, SizeMode.MINUS);
        safeAreaBlocker(noClick, 3, Anchor.RIGHT, Anchor.CENTRE, safeRight, 0, SizeMode.MINUS, SizeMode.MINUS);
      }
      const multiway: ComponentId = gameframeSlot(GameframeSlot.MULTIWAY_ICON);
      if (multiway !== -1) {
        positionMultiwayIcons(multiway, layout);
      }
      CS2.if_position_set(safeLeft, safeTop, Anchor.LEFT, Anchor.TOP, dodger);
      CS2.if_size_set(
        universeW - Math.max(680, safeRight - safeLeft),
        universeH - (safeBottom - safeTop),
        SizeMode.MINUS,
        SizeMode.MINUS,
        dodger,
      );
      return;
    }
    left = left + safeLeft;
    top = top + safeTop;
    altTop = altTop + safeTop;
    right = universeW - safeRight;
    bottom = universeH - safeBottom;
    altBottom = bottom;
  }

  if (mobile && mobileGameframe(layout)) {
    const strip: ComponentId = gameframeSlot(GameframeSlot.SIDE_RIGHT_TABS);
    const gameframeRight: Int = OverlayInsetRight.get(layout) ?? 0;
    let stripRight: Int = 0;
    let stripAltRight: Int = 0;
    let stripMode: Int = 0;
    let minimapFloor: Int = 0;

    if (CS2.testbit(flags, 1)) {
      stripMode = mobileSideStripMode();
    }
    if (CS2.testbit(flags, 2)) {
      minimapFloor = 1;
    }
    if (stripMode === 2) {
      stripRight = stripRight + Math.max(0, CS2.if_width_get(strip) - gameframeRight);
    } else if (stripMode === 3 || stripMode === 4) {
      if (mobileSidePanelOnLeft() === 1) {
        stripRight = stripRight + Math.max(0, CS2.if_width_get(strip) - gameframeRight);
      } else {
        stripRight =
          stripRight +
          Math.max(
            0,
            CS2.if_width_get(strip) + CS2.if_width_get(gameframeSlot(GameframeSlot.SIDE_CONTAINER)) - gameframeRight,
          );
      }
    } else if (sideways === 1) {
      if (stripMode === 2) {
        stripAltRight = stripAltRight + Math.max(0, CS2.if_width_get(strip) - gameframeRight);
      } else if (stripMode === 3 || stripMode === 4) {
        stripAltRight =
          stripAltRight +
          Math.max(
            0,
            CS2.if_width_get(strip) + CS2.if_width_get(gameframeSlot(GameframeSlot.SIDE_CONTAINER)) - gameframeRight,
          );
      }
    }
    if (minimapFloor === 1) {
      if (useServerState(Varbits.OSM_MINIMAP_TOGGLE) === 0) {
        stripRight = Math.max(stripRight, 181);
      } else {
        stripRight = Math.max(stripRight, 84);
      }
    } else if (sideways === 1) {
      if (useServerState(Varbits.OSM_MINIMAP_TOGGLE) === 0) {
        stripAltRight = Math.max(stripAltRight, 181);
      } else {
        stripAltRight = Math.max(stripAltRight, 84);
      }
    }
    if (CS2.testbit(flags, 3)) {
      const chat: Int = chatboxOpen();
      if (chat === 0) {
        top = top + (165 - 20) + 2;
      } else if (chat === 1) {
        top = top + 30 + 2;
      } else if (chat === 2) {
        top = top + 2;
      }
    }
    right = right + stripRight;
    altRight = altRight + stripAltRight;
  }

  if (CS2.testbit(flags, 12) && parent !== -1 && layout !== ToplevelComponents.NONE) {
    left = left + (OverlayInsetLeft.get(layout) ?? 0);
    right = right + (OverlayInsetRight.get(layout) ?? 0);
    bottom = bottom + (OverlayInsetBottom.get(layout) ?? 0);
    altBottom = altBottom + (OverlayInsetBottom.get(layout) ?? 0);
  }

  if (CS2.testbit(flags, 10) && !mobile && (align === Anchor.LEFT || align === Anchor.CENTRE)) {
    if (!enhanced || useServerState(Varbits.MOUSEOVER_TEXT_ENABLED) === 1) {
      top = top + 23;
    } else {
      top = top + 2;
    }
  }

  if (CS2.testbit(flags, 16) && content !== -1) {
    const [, setHud] = useState(dodgerHudToDodge);
    const [, setHudAlign] = useState(dodgerHudToDodgeAlign);
    setHud(content as Int);
    setHudAlign(align);
  }

  const pvp: ComponentId = gameframeSlot(GameframeSlot.PVP_ICONS);
  if (
    CS2.testbit(flags, 18) &&
    CS2.window_mode_get() === 1 &&
    useServerState(Varbits.ATTACK_STYLE_ENABLED) === 1 &&
    enhanced &&
    content !== -1 &&
    pvp !== -1 &&
    CS2.if_sub_has(pvp)
  ) {
    const plateBottom: Int = CS2.if_height_get(componentOf(90, 44)) + CS2.if_y_get(componentOf(90, 44));
    const overlap: Int = CS2.if_height_get(content) + CS2.if_y_get(content) - plateBottom;
    if (overlap >= 0) {
      bottom = bottom + 80 + overlap;
      altBottom = altBottom + 80 + overlap;
    } else {
      bottom = bottom + 80 - overlap;
      altBottom = altBottom + 80 - overlap;
    }
  }

  const hpbar: ComponentId = gameframeSlot(GameframeSlot.HPBAR_HUD);
  if (
    CS2.testbit(flags, 5) &&
    !CS2.testbit(flags, 16) &&
    hpbar !== -1 &&
    CS2.if_sub_has(hpbar) &&
    !CS2.if_hide_get(componentOf(303, 5))
  ) {
    if (
      enhanced &&
      useServerState(Varbits.HPBAR_HUD_STANDARD_DISABLED) === 0 &&
      useServerState(Varbits.HPBAR_HUD_BOSS) === 0
    ) {
      ran = CS2.bit_set(ran, 5);
      if (!hudDodgedAway(0) && align === Anchor.LEFT) {
        top = top + CS2.if_height_get(componentOf(303, 5)) + 2;
      } else if (hudDodgedAway(0)) {
        if (align === Anchor.RIGHT) {
          top = top + CS2.if_height_get(componentOf(303, 5)) + 2;
        } else {
          altTop = altTop + CS2.if_height_get(componentOf(303, 5));
        }
      }
    } else if (
      useServerState(Varbits.HPBAR_HUD_BOSS) === 1 &&
      ((align === Anchor.CENTRE && !mobile) || (align === Anchor.LEFT && mobile))
    ) {
      top = top + CS2.if_height_get(componentOf(303, 5)) + 2;
    }
  }

  const helper: ComponentId = gameframeSlot(GameframeSlot.HELPER_CONTENT);
  if (CS2.testbit(flags, 6) && !CS2.testbit(flags, 16) && helper !== -1 && CS2.if_sub_has(helper)) {
    ran = CS2.bit_set(ran, 6);
    if (!hudDodgedAway(1)) {
      if (align === Anchor.LEFT) {
        top = top + CS2.if_height_get(helper);
      }
    } else {
      altTop = altTop + CS2.if_height_get(helper);
    }
  }

  if (CS2.testbit(flags, 7) && !CS2.testbit(flags, 16)) {
    ran = CS2.bit_set(ran, 7);
    const position: Int = useServerState(Varbits.XPDROPS_POSITION);
    const progress: Int = useServerState(Varbits.XPDROPS_PROGRESS_TYPE);
    let dodgeDrops: Int = 0;
    if (align === Anchor.LEFT && position === 2) {
      dodgeDrops = 1;
    } else if (align === Anchor.CENTRE && position === 1) {
      dodgeDrops = 1;
    } else if (align === Anchor.RIGHT && position === 0) {
      dodgeDrops = 1;
    }
    if (useServerState(Varbits.XPDROPS_ENABLED) === 0 && CS2.testbit(flags, 9)) {
      dodgeDrops = 0;
    }
    if (dodgeDrops === 1) {
      top = top + 35;
      if (progress !== 0) {
        top = top + 9;
      }
      if (align !== Anchor.CENTRE) {
        left = left + 2;
      }
    } else {
      if (align === Anchor.LEFT && position === 0) {
        let stackAlt: Int = 0;
        if (CS2.testbit(flags, 9)) {
          if (useServerState(Varbits.XPDROPS_ENABLED) === 1) {
            stackAlt = 1;
          }
        } else {
          stackAlt = 1;
        }
        if (stackAlt === 1) {
          altTop = altTop + 35;
          if (progress !== 0) {
            altTop = altTop + 9;
          }
        }
      }
      top = top + 2;
      if (align !== Anchor.CENTRE) {
        left = left + 2;
      }
    }
  }

  if (CS2.testbit(flags, 14)) {
    let lines: Int = 0;
    let index: Int = 0;
    while (index < CHAT_LINES) {
      const line: ComponentId = ChatLines.at(index) ?? -1;
      if (line !== -1 && CS2.cc_find(componentOf(163, 0), index * 4) && CS2.string_length(CS2.cc_text_get()) > 0) {
        lines = lines + CS2.if_height_get(line);
      }
      index = index + 1;
    }
    if (lines > 0) {
      lines = lines + 4;
    }
    if (mobile) {
      top = top + lines;
    } else {
      bottom = bottom + lines;
      altBottom = altBottom + lines;
    }
  }

  const boosts: ComponentId = gameframeSlot(GameframeSlot.STAT_BOOSTS_HUD);
  if (
    CS2.testbit(flags, 15) &&
    enhanced &&
    boosts !== -1 &&
    CS2.if_sub_has(boosts) &&
    !CS2.if_hide_get(componentOf(708, 3)) &&
    statBoostsShown()
  ) {
    if ((!mobile && align === Anchor.LEFT) || (mobile && align === Anchor.RIGHT)) {
      bottom = bottom + 35;
    } else if (align === Anchor.CENTRE) {
      let hits: Boolean = false;
      if (yAnchor === Anchor.BOTTOM) {
        hits = boxesOverlap(content, left, 0 - bottom, componentOf(708, 3), absoluteX(boosts), absoluteY(boosts));
      } else {
        hits = boxesOverlap(content, left, top, componentOf(708, 3), absoluteX(boosts), absoluteY(boosts));
      }
      if (hits) {
        bottom = bottom + 35;
      }
    }
    if (mobile) {
      altBottom = altBottom + 35;
    }
  }

  const buffBar: ComponentId = gameframeSlot(GameframeSlot.BUFF_BAR);
  if (
    CS2.testbit(flags, 11) &&
    buffBar !== -1 &&
    CS2.if_sub_has(buffBar) &&
    !CS2.if_hide_get(buffBar) &&
    content !== -1
  ) {
    const columns: Int = buffBarColumns();
    const rows: Int = buffBarRows();
    if (columns > 0 && rows > 0) {
      const buffs: Int = buffBarCount();
      if (buffs > 0) {
        if (!mobile) {
          if (align === Anchor.LEFT || align === Anchor.CENTRE) {
            if (useServerState(Varbits.BUFF_BAR_LOCATION) === 0) {
              let used: Int = buffs / columns;
              if (buffs % columns > 0) {
                used = used + 1;
              }
              bottom = bottom + 37 * used + 2;
            } else if (buffs >= rows) {
              bottom = bottom + 37 * rows + 2;
            } else {
              bottom = bottom + 37 * buffs + 2;
            }
          }
        } else if (align === Anchor.RIGHT) {
          let used: Int = buffs / rows;
          if (buffs % rows > 0) {
            used = used + 1;
          }
          right = right + 37 * used + 2;
        }
      }
    }
  }

  const [registered] = useState(dodgerHudToDodge);
  const [registeredAlign] = useState(dodgerHudToDodgeAlign);
  const registeredHud: ComponentId = registered as ComponentId;
  if (CS2.testbit(flags, 17) && registered !== -1 && CS2.if_find(registeredHud) && !CS2.if_hide_get(registeredHud)) {
    ran = CS2.bit_set(ran, 17);
    const hudHeight: Int = CS2.if_height_get(registeredHud);
    const hudTop: Int = absoluteY(registeredHud);
    if (registeredAlign === align) {
      top = top + hudHeight + 2;
    } else if (boxesOverlap(content, left, top, registeredHud, 0, 0) && top < hudHeight + hudTop) {
      top = top + (hudHeight + hudTop - top) + 2;
    }
    const mirroredLeft: Int = universeW - CS2.if_width_get(content) - right - 2 * 2;
    if (registeredAlign === Anchor.RIGHT) {
      altTop = altTop + hudHeight + 2;
    } else if (boxesOverlap(content, mirroredLeft, altTop, registeredHud, 0, 0) && altTop < hudHeight + hudTop) {
      altTop = altTop + (hudHeight + hudTop - altTop) + 2;
    }
  }

  if (sideways === 1 && content !== -1 && align !== Anchor.RIGHT) {
    const contentW: Int = CS2.if_width_get(content);
    const contentH: Int = CS2.if_height_get(content);
    top = top + stackBelow(flags, ran, layout, align, content, top);
    altTop = altTop + stackBelow(flags, ran, layout, Anchor.RIGHT, content, altTop);
    if (contentW <= universeW - (left + right) && contentH <= universeH - (top + bottom)) {
      CS2.if_position_set(left, top, Anchor.LEFT, Anchor.TOP, dodger);
      CS2.if_size_set(left + right, top + bottom, SizeMode.MINUS, SizeMode.MINUS, dodger);
      markNotDodged(dodger, flags);
    } else {
      const mirroredLeft: Int = universeW - contentW - right - altRight - 2 * 2;
      CS2.if_position_set(mirroredLeft, altTop + 2, Anchor.LEFT, Anchor.TOP, dodger);
      CS2.if_size_set(mirroredLeft + (right + altRight), altTop + altBottom, SizeMode.MINUS, SizeMode.MINUS, dodger);
      markDodged(dodger, flags);
    }
  } else {
    top = top + stackBelow(flags, ran, layout, align, content, top);
    CS2.if_position_set(left, top, Anchor.LEFT, Anchor.TOP, dodger);
    CS2.if_size_set(left + right, top + bottom, SizeMode.MINUS, SizeMode.MINUS, dodger);
  }
}

function safeAreaBlocker(
  parent: ComponentId,
  index: Int,
  xAnchor: Int,
  yAnchor: Int,
  w: Int,
  h: Int,
  wMode: Int,
  hMode: Int,
): void {
  if (!CS2.cc_find(parent, index)) {
    CS2.cc_create(parent, 4, index, false);
    CS2.cc_no_click_through_set(true);
  }
  CS2.cc_position_set(0, 0, xAnchor, yAnchor);
  CS2.cc_size_set(w, h, wMode, hMode);
}

export function overlayRelayout(
  dodger: ComponentId,
  content: ComponentId,
  flags: Int,
  xAnchor: Int,
  yAnchor: Int,
  sideways: Int,
): void {
  overlayLayout(dodger, content, flags, xAnchor, yAnchor, sideways);
}

export function overlayInit(
  dodger: ComponentId,
  content: ComponentId,
  flags: Int,
  xAnchor: Int,
  yAnchor: Int,
  sideways: Int,
): void {
  if (flags === 0) {
    CS2.if_size_set(0, 0, SizeMode.MINUS, SizeMode.MINUS, dodger);
    return;
  }
  if (CS2.if_layer_get(dodger) !== -1) {
    overlayLayout(dodger, content, flags, xAnchor, yAnchor, sideways);
  }
}
