import { sessionState, useState } from 'ts2';

export const mobileFullscreenMode = sessionState(0);

export function setMobileFullscreen(open: Int): void {
  const [, setMode] = useState(mobileFullscreenMode);
  setMode(open);
}

export const mobileSideModalOpen = sessionState(0);

export function setMobileSideModalOpen(open: Int): void {
  const [, setOpen] = useState(mobileSideModalOpen);
  setOpen(open);
}
