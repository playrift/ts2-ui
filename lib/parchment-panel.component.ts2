import { useRef } from 'ts2';
import { Fonts } from './game/fonts';
import { Sprites } from './game/sprites';
import { ScrollbarVertical } from './scrollbar-vertical.component';

enum Panel {
  WIDTH = 512,
  HEIGHT = 334,
  LIST_W = 348,
  LIST_H = 244,
  INNER_W = 336,
  TITLE_W = 370,
  TITLE_H = 22,
  SCROLLBAR_W = 16,
}

enum PanelColors {
  LABEL = 0xf5e9d5,
}

declare const PanelFonts: {
  readonly HEADING: typeof Fonts.Q8_FULL;
};

declare const PanelArt: {
  readonly CLOSE: typeof Sprites.CLOSE_BUTTONS_4;
  readonly CLOSE_HOVER: typeof Sprites.CLOSE_BUTTONS_5;
  readonly BAR_TRACK: typeof Sprites.SCROLLBAR_PARCHMENT_DRAGGER_V2_3;
  readonly BAR_CAP_TOP: typeof Sprites.SCROLLBAR_PARCHMENT_DRAGGER_V2_0;
  readonly BAR_THUMB: typeof Sprites.SCROLLBAR_PARCHMENT_DRAGGER_V2_1;
  readonly BAR_CAP_BOTTOM: typeof Sprites.SCROLLBAR_PARCHMENT_DRAGGER_V2_2;
  readonly BAR_ARROW_UP: typeof Sprites.SCROLLBAR_PARCHMENT_V2_0;
  readonly BAR_ARROW_DOWN: typeof Sprites.SCROLLBAR_PARCHMENT_V2_1;
};

enum PanelModel {
  SCROLL = 16344,
  ZOOM = 1119,
  PITCH = 490,
  YAW = 513,
}

export function ParchmentPanel({
  title,
  contentHeight,
  children,
}: {
  title: String;
  contentHeight: Int;
  children?: Children;
}): Component {
  const content = useRef();

  return (
    <layer x="center" y="center" w={Panel.WIDTH} h={Panel.HEIGHT}>
      <model
        x={{ center: 9 }}
        y={{ center: -19 }}
        w={24}
        h={23}
        model={PanelModel.SCROLL}
        zoom={PanelModel.ZOOM}
        pitch={PanelModel.PITCH}
        yaw={PanelModel.YAW}
      />

      <sprite
        x={{ right: 8 }}
        y={6}
        w={26}
        h={23}
        sprite={PanelArt.CLOSE}
        hover={{ sprite: PanelArt.CLOSE_HOVER }}
        options={['Close']}
      />

      <text
        x={60}
        y={30}
        w={Panel.TITLE_W}
        h={Panel.TITLE_H}
        text={title}
        align="center"
        valign="middle"
        shadow
        font={PanelFonts.HEADING}
        color={PanelColors.LABEL}
      />

      <layer
        ref={content}
        x={{ center: -19 }}
        y={{ center: 10 }}
        w={Panel.LIST_W}
        h={Panel.LIST_H}
        scrollHeight={contentHeight}
      >
        <layer x="center" y={0} w={Panel.INNER_W} h={contentHeight}>
          {children}
        </layer>
      </layer>

      <layer x={{ right: 84 }} y={55} w={Panel.SCROLLBAR_W} h={Panel.LIST_H}>
        <ScrollbarVertical
          content={content}
          track={PanelArt.BAR_TRACK}
          capTopSprite={PanelArt.BAR_CAP_TOP}
          thumbSprite={PanelArt.BAR_THUMB}
          capBottomSprite={PanelArt.BAR_CAP_BOTTOM}
          arrowUp={PanelArt.BAR_ARROW_UP}
          arrowDown={PanelArt.BAR_ARROW_DOWN}
        />
      </layer>
    </layer>
  );
}
