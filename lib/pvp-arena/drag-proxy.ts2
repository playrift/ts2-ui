import { CS2 } from 'ts2';
import { Row, STACK_SHOWN } from '../../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export function showDragProxy(
  icon: Ref,
  label: Ref,
  item: Item,
  text: String,
  inset: Int,
  mouseX: Int,
  mouseY: Int,
): void {
  if (CS2.item_stackable(item)) {
    icon.props = { item: item, itemCount: STACK_SHOWN, itemCountMode: 'auto' };
  } else {
    icon.props = { item: item, itemCount: 1, itemCountMode: 'never' };
  }
  icon.x = mouseX + Row.PAD;
  icon.y = mouseY + inset;
  icon.hide = false;

  label.width = label.width - Row.LABEL_INSET;
  label.text = text;
  label.x = mouseX + Row.PAD + Row.ITEM_W + 2;
  label.y = mouseY;
  label.hide = false;
}

export function hideDragProxy(icon: Ref, label: Ref): void {
  icon.hide = true;
  label.hide = true;
}
