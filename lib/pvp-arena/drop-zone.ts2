import { Zone } from '../../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export function dropZone(
  target: ComponentId,
  bin: Ref,
  grid: Ref,
  w0: Ref,
  w1: Ref,
  w2: Ref,
  w3: Ref,
  w4: Ref,
  w5: Ref,
  w7: Ref,
  w9: Ref,
  w10: Ref,
  w12: Ref,
  w13: Ref,
): Int {
  if (target === bin) {
    return Zone.BIN;
  }
  if (target === grid) {
    return Zone.INVENTORY;
  }
  if (target === w0) {
    return 0;
  }
  if (target === w1) {
    return 1;
  }
  if (target === w2) {
    return 2;
  }
  if (target === w3) {
    return 3;
  }
  if (target === w4) {
    return 4;
  }
  if (target === w5) {
    return 5;
  }
  if (target === w7) {
    return 7;
  }
  if (target === w9) {
    return 9;
  }
  if (target === w10) {
    return 10;
  }
  if (target === w12) {
    return 12;
  }
  if (target === w13) {
    return 13;
  }
  return Zone.NONE;
}
