import { CS2, useState } from 'ts2';
import { clientClock } from '../lib.engine';
import { onMobile } from '../lib.helpers';
import { BuildSpellbooks } from '../../0421_pvp_arena_stagingarea_shareloadout/pvp-arena-stagingarea-shareloadout.data';
import { closeSpellbook, SpellbookList } from './loadout-chrome.component';
import { openDropdown, sheetClosableAt } from './kit.state';
import {
  DROPDOWN_ROW_H,
  Layout,
  SuppliesSprites,
  Wash,
} from '../../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export function KitSheet({ build }: { build: Int }): Component {
  const [open] = useState(openDropdown);
  const [closableAt] = useState(sheetClosableAt);
  const rowH: Int = onMobile() ? CS2.scale(8, 5, DROPDOWN_ROW_H) : DROPDOWN_ROW_H;
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      hide={open !== build}
      noClickThrough
      onClick={() => {
        if (clientClock() < closableAt) {
          return;
        }
        closeSpellbook();
      }}
    >
      <rect x="center" y="center" w="fill" h="fill" fill transparency={Wash.OVERLAY} />
      <layer
        x="right"
        y={Layout.dropdown.y}
        w={{ fill: Layout.dropdown.inset }}
        h={BuildSpellbooks.length * rowH + 2 + 4}
      >
        <sprite x="center" y="center" w="fill" h="fill" sprite={SuppliesSprites.TRADEBACKING} tiling />
        <SpellbookList build={build} rowH={rowH} />
      </layer>
    </layer>
  );
}
