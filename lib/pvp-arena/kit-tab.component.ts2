import { useRef, useState } from 'ts2';
import { playSound } from '../lib.engine';
import { xpdropsFake6 } from '../game/varcs';
import { closeSeekPrompt } from './loadout-chrome.component';
import {
  Layout,
  SuppliesColor,
  SuppliesFonts,
  SuppliesSounds,
  SuppliesSprites,
} from '../../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export function SuppliesTab({ index, label, active }: { index: Int; label: String; active: Boolean }): Component {
  const endRest: Sprite = active ? SuppliesSprites.TAB_END_ON : SuppliesSprites.TAB_END_OFF;
  const midRest: Sprite = active ? SuppliesSprites.TAB_MID_ON : SuppliesSprites.TAB_MID_OFF;
  const left = useRef();
  const right = useRef();
  const middle = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      onMouseEnter={
        active
          ? undefined
          : () => {
              left.sprite = SuppliesSprites.TAB_END_HOVER;
              right.sprite = SuppliesSprites.TAB_END_HOVER;
              middle.sprite = SuppliesSprites.TAB_MID_HOVER;
            }
      }
      onMouseLeave={
        active
          ? undefined
          : () => {
              left.sprite = SuppliesSprites.TAB_END_OFF;
              right.sprite = SuppliesSprites.TAB_END_OFF;
              middle.sprite = SuppliesSprites.TAB_MID_OFF;
            }
      }
      onClick={
        active
          ? undefined
          : () => {
              playSound(SuppliesSounds.CLICK);
              closeSeekPrompt();
              chooseSuppliesTab(index);
            }
      }
    >
      <sprite ref={left} x="left" y="bottom" w={Layout.tab.endW} h={Layout.tab.endH} sprite={endRest} />
      <sprite ref={right} x="right" y="bottom" w={Layout.tab.endW} h={Layout.tab.endH} sprite={endRest} hflip />
      <sprite
        ref={middle}
        x="center"
        y="bottom"
        w={{ fill: Layout.tab.middleInset }}
        h={Layout.tab.endH}
        sprite={midRest}
        tiling
      />
      <text
        x="center"
        y={{ center: Layout.tab.labelDy }}
        w="fill"
        h="fill"
        font={SuppliesFonts.BODY}
        color={SuppliesColor.LABEL}
        shadow
        align="center"
        valign="middle"
        text={label}
      />
    </layer>
  );
}

export function chooseSuppliesTab(tab: Int): void {
  const [, setTab] = useState(xpdropsFake6);
  setTab(tab);
}
