export function setLoadoutSpellbook(build: Int, menu: Int): void {
  if (build === Build.ZERKER) {
    predictServerState(SuppliesVarbits.LOADOUT_B_SPELLBOOK, menu);
    return;
  }
  if (build === Build.PURE) {
    predictServerState(SuppliesVarbits.LOADOUT_C_SPELLBOOK, menu);
    return;
  }
  predictServerState(SuppliesVarbits.LOADOUT_A_SPELLBOOK, menu);
}

export function itemOf(key: Int): Item {
  return LoadoutItems.at(key) ?? -1;
}

export function spellbookName(build: Int): String {
  return SpellbookNames.get(spellbookCode(build)) ?? SPELLBOOK_NAME_DEFAULT;
}

function spellbookCode(build: Int): Int {
  if (build === Build.ZERKER) {
    return BuildSpellbooks.at(useServerState(SuppliesVarbits.LOADOUT_B_SPELLBOOK)) ?? -1;
  }
  if (build === Build.PURE) {
    return BuildSpellbooks.at(useServerState(SuppliesVarbits.LOADOUT_C_SPELLBOOK)) ?? -1;
  }
  return BuildSpellbooks.at(useServerState(SuppliesVarbits.LOADOUT_A_SPELLBOOK)) ?? -1;
}
