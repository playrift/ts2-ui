export function setLoadoutWorn(build: Int, slot: Int, key: Int): void {
  if (build === Build.ZERKER) {
    if (slot === 0) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_HAT, key);
      return;
    }
    if (slot === 1) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_BACK, key);
      return;
    }
    if (slot === 2) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_FRONT, key);
      return;
    }
    if (slot === 3) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_RHAND, key);
      return;
    }
    if (slot === 4) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_TORSO, key);
      return;
    }
    if (slot === 5) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_LHAND, key);
      return;
    }
    if (slot === 7) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_LEGS, key);
      return;
    }
    if (slot === 9) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_HANDS, key);
      return;
    }
    if (slot === 10) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_FEET, key);
      return;
    }
    if (slot === 12) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_RING, key);
      return;
    }
    if (slot === 13) {
      predictServerState(Varbits.PVPA_LOADOUT_B_WORN_QUIVER, key);
      return;
    }
    return;
  }
  if (build === Build.PURE) {
    if (slot === 0) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_HAT, key);
      return;
    }
    if (slot === 1) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_BACK, key);
      return;
    }
    if (slot === 2) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_FRONT, key);
      return;
    }
    if (slot === 3) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_RHAND, key);
      return;
    }
    if (slot === 4) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_TORSO, key);
      return;
    }
    if (slot === 5) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_LHAND, key);
      return;
    }
    if (slot === 7) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_LEGS, key);
      return;
    }
    if (slot === 9) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_HANDS, key);
      return;
    }
    if (slot === 10) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_FEET, key);
      return;
    }
    if (slot === 12) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_RING, key);
      return;
    }
    if (slot === 13) {
      predictServerState(Varbits.PVPA_LOADOUT_C_WORN_QUIVER, key);
      return;
    }
    return;
  }
  if (slot === 0) {
    predictServerState(Varbits.PVPA_LOADOUT_A_WORN_HAT, key);
    return;
  }
  if (slot === 1) {
    predictServerState(Varbits.PVPA_LOADOUT_A_WORN_BACK, key);
    return;
  }
  if (slot === 2) {
    predictServerState(Varbits.PVPA_LOADOUT_A_WORN_FRONT, key);
    return;
  }
  if (slot === 3) {
    predictServerState(Varbits.PVPA_LOADOUT_A_WORN_RHAND, key);
    return;
  }
  if (slot === 4) {
    predictServerState(Varbits.PVPA_LOADOUT_A_WORN_TORSO, key);
    return;
  }
  if (slot === 5) {
