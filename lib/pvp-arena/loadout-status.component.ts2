import { useState } from 'ts2';
import {
  Copy,
  Layout,
  ShareLoadoutColor,
  ShareLoadoutFonts,
} from '../../0421_pvp_arena_stagingarea_shareloadout/pvp-arena-stagingarea-shareloadout.constants';
import { LoadoutStatus, loadoutStatusCode } from './opponent.state';

export function LoadoutStatusLine(): Component {
  const [code] = useState(loadoutStatusCode);
  let text: String = Copy.STATUS_SAME;
  if (code === LoadoutStatus.STATS) {
    text = Copy.STATUS_STATS;
  } else if (code === LoadoutStatus.TOO_MANY) {
    text = Copy.STATUS_TOO_MANY;
  } else if (code === LoadoutStatus.AMMO) {
    text = Copy.STATUS_AMMO;
  } else if (code === LoadoutStatus.MISMATCH) {
    text = Copy.STATUS_MISMATCH;
  }
  return (
    <text
      x="center"
      y="bottom"
      w="fill"
      h={Layout.status.h}
      text={text}
      font={ShareLoadoutFonts.BODY}
      color={ShareLoadoutColor.TEXT}
      shadow
      align="center"
      valign="bottom"
    />
  );
}
