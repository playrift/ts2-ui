import { useServerState } from 'ts2';
import { ThinBoxOutline } from '../thin-box.component';
import {
  Copy,
  Layout,
  SPELLBOOK_NAME_DEFAULT,
  ShareLoadoutColor,
  ShareLoadoutFonts,
  ShareLoadoutSprites,
  ShareLoadoutVarbits,
  SpellbookNames,
  Wash,
} from '../../0421_pvp_arena_stagingarea_shareloadout/pvp-arena-stagingarea-shareloadout.constants';

export function RunePouchBox(): Component {
  return (
    <>
      <sprite x={0} y="center" w={36} h={36} sprite={ShareLoadoutSprites.PLATE} />
      <sprite
        x={Layout.runePouch.iconX}
        y="center"
        w={Layout.runePouch.iconW}
        h={Layout.runePouch.iconH}
        sprite={ShareLoadoutSprites.RUNE_POUCH}
        transparency={Wash.RUNE_POUCH}
      />
      <text
        x="right"
        y="center"
        w={{ fill: Layout.runePouch.textInset }}
        h="fill"
        text={Copy.NO_RUNE_POUCH}
        font={ShareLoadoutFonts.BODY}
        color={ShareLoadoutColor.DIM}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}

export function SpellbookBox(): Component {
  const spellbook: Int = useServerState(ShareLoadoutVarbits.OPPONENT_SPELLBOOK);

  return (
    <>
      <sprite x="center" y="center" w="fill" h="fill" sprite={ShareLoadoutSprites.BACKING} tiling />
      <ThinBoxOutline />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={SpellbookNames.get(spellbook) ?? SPELLBOOK_NAME_DEFAULT}
        font={ShareLoadoutFonts.BODY}
        color={ShareLoadoutColor.TEXT}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}
