import { SteelBorder } from './steel-border.component';
import { SteelborderColor } from './lib.constants';

export function SteelBorderEntrypoint({ title, children }: { title: String; children?: Children }): Component {
  return (
    <SteelBorder title={title} titleColor={SteelborderColor.TITLE} flags={0}>
      {children}
    </SteelBorder>
  );
}
