import { CS2 } from 'ts2';
import { SteelBorderProps, SteelborderFont, SteelborderSprite } from './lib.constants';
import { closeInterface, onMobile } from './lib.helpers';
import { hasBit } from '../lib/lib.engine';

export function SteelBorder({ title, titleColor, flags, children }: SteelBorderProps): Component {
  const mobile = onMobile();

  return (
    <layer w="fill" h="fill">
      {hasBit(flags, 3) ? (
        <sprite
          x="center"
          y="center"
          w={{ fill: 2 }}
          h={{ fill: 2 }}
          sprite={SteelborderSprite.BACKDROP}
          tiling
          transparency={120}
        />
      ) : (
        <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={SteelborderSprite.BACKDROP} tiling />
      )}

      <text
        x="center"
        y={6}
        w={{ fill: 12 }}
        h={24}
        text={title}
        align="center"
        valign="middle"
        shadow
        color={titleColor}
        font={SteelborderFont.TITLE}
      />

      <sprite x="left" y="top" w={25} h={30} sprite={SteelborderSprite.CORNER_TL} tiling />
      <sprite x="right" y="top" w={25} h={30} sprite={SteelborderSprite.CORNER_TR} tiling />
      <sprite x="left" y="bottom" w={25} h={30} sprite={SteelborderSprite.CORNER_BL} tiling />
      <sprite x="right" y="bottom" w={25} h={30} sprite={SteelborderSprite.CORNER_BR} tiling />

      <sprite x={{ left: -15 }} y="center" w={36} h={{ fill: 60 }} sprite={SteelborderSprite.EDGE_LEFT} tiling />
      <sprite x={{ right: -15 }} y="center" w={36} h={{ fill: 60 }} sprite={SteelborderSprite.EDGE_RIGHT} tiling />
      <sprite x="center" y={{ top: -15 }} w={{ fill: 50 }} h={36} sprite={SteelborderSprite.EDGE_TOP} tiling />
      <sprite x="center" y={{ bottom: -15 }} w={{ fill: 50 }} h={36} sprite={SteelborderSprite.EDGE_BOTTOM} tiling />

      {!hasBit(flags, 2) && (
        <sprite x="center" y={14} w={{ fill: 10 }} h={26} sprite={SteelborderSprite.DIVIDER} tiling />
      )}

      {!hasBit(flags, 0) && (
        <sprite
          x={{ right: mobile ? 1 : 3 }}
          y={mobile ? 1 : 6}
          w={mobile ? 33 : 26}
          h={mobile ? 33 : 23}
          sprite={mobile ? SteelborderSprite.CLOSE_MOBILE : SteelborderSprite.CLOSE_OFF}
          hover={{ sprite: mobile ? SteelborderSprite.CLOSE_MOBILE : SteelborderSprite.CLOSE_HOVER }}
          tiling
          options={['Close']}
          onOptionSelect={() => closeInterface()}
        />
      )}

      {hasBit(flags, 1) && <sprite x="right" y="bottom" w={8} h={8} sprite={SteelborderSprite.RESIZE_HANDLE} tiling />}

      <layer w="fill" h="fill">
        {children}
      </layer>
    </layer>
  );
}
