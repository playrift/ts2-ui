import { closeInterface, onMobile } from './lib.helpers';
import { StoneBorderFont, StoneBorderSprite } from './lib.constants';

export function StoneBorder({ title }: { title: String }): Component {
  const mobile: Boolean = onMobile();

  return (
    <layer w="fill" h="fill">
      <sprite x={1} y={1} w={{ fill: 2 }} h={{ fill: 2 }} sprite={StoneBorderSprite.BACKDROP} tiling />

      <text
        x={6}
        y={6}
        w={{ fill: 12 }}
        h={23}
        text={title}
        font={StoneBorderFont.TITLE}
        color={0xff981f}
        shadow
        align="center"
        valign="middle"
      />

      <sprite x="left" y="top" w={32} h={32} sprite={StoneBorderSprite.TOP_LEFT} tiling />
      <sprite x="right" y="top" w={32} h={32} sprite={StoneBorderSprite.TOP_RIGHT} tiling />
      <sprite x="left" y="bottom" w={32} h={32} sprite={StoneBorderSprite.BOTTOM_LEFT} tiling />
      <sprite x="right" y="bottom" w={32} h={32} sprite={StoneBorderSprite.BOTTOM_RIGHT} tiling />

      <sprite x={32} y={-13} w={{ fill: 64 }} h={32} sprite={StoneBorderSprite.TOP} tiling />
      <sprite x={32} y={{ bottom: -12 }} w={{ fill: 64 }} h={32} sprite={StoneBorderSprite.BOTTOM} tiling />
      <sprite x={-13} y={32} w={32} h={{ fill: 64 }} sprite={StoneBorderSprite.LEFT} tiling />
      <sprite x={{ right: -12 }} y={32} w={32} h={{ fill: 64 }} sprite={StoneBorderSprite.RIGHT} tiling />

      <sprite x={0} y={17} w={32} h={32} sprite={StoneBorderSprite.TITLE_LEFT} tiling />
      <sprite x="right" y={17} w={32} h={32} sprite={StoneBorderSprite.TITLE_RIGHT} tiling />
      <sprite x={11} y={15} w={{ fill: 22 }} h={32} sprite={StoneBorderSprite.TITLE_BAR} tiling />

      <sprite
        x={{ right: mobile ? 2 : 10 }}
        y={mobile ? 2 : 10}
        w={mobile ? 32 : 16}
        h={mobile ? 32 : 16}
        sprite={mobile ? StoneBorderSprite.CLOSE_MOBILE : StoneBorderSprite.CLOSE}
        hover={{ sprite: mobile ? StoneBorderSprite.CLOSE_MOBILE : StoneBorderSprite.CLOSE_HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />
    </layer>
  );
}
