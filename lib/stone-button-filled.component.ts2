import { StoneButton } from './stone-button.component';

export function StoneButtonFilled({ children }: { children?: Children }): Component {
  return (
    <layer w="fill" h="fill">
      <sprite x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} sprite={297} tiling />
      <StoneButton>{children}</StoneButton>
    </layer>
  );
}
