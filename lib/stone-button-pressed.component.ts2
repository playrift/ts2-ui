import { Frame } from './frame.component';

export function StoneButtonPressed({ children }: { children?: Children }): Component {
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={0x30201c} fill transparency={200} />
      <Frame
        topLeft={921}
        topRight={922}
        bottomLeft={923}
        bottomRight={924}
        left={925}
        top={926}
        right={927}
        bottom={928}
      >
        {children}
      </Frame>
    </layer>
  );
}
