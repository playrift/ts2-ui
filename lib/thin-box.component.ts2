enum ThinBoxInk {
  OUTER = 0x0e0e0c,
  INNER = 0x474745,
}

export function ThinBoxOutline(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={ThinBoxInk.OUTER} />
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={ThinBoxInk.INNER} />
    </>
  );
}

export function ThinBox({ children }: { children?: Children }): Component {
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={ThinBoxInk.OUTER} />
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={ThinBoxInk.INNER} />
      <layer w="fill" h="fill">
        {children}
      </layer>
    </layer>
  );
}
