export function ThinBox({ children }: { children?: Children }): Component {
  return (
    <layer w="fill" h="fill">
      <rect x="center" y="center" w="fill" h="fill" color={0x0e0e0c} />
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={0x474745} />
      <layer w="fill" h="fill">
        {children}
      </layer>
    </layer>
  );
}
