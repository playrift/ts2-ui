enum ThinStoneBoxColor {
  OUTER = 0x383023,
  INNER = 0x5a5245,
}

export function ThinStoneBox(): Component {
  return (
    <>
      <rect x="center" y="center" w="fill" h="fill" color={ThinStoneBoxColor.OUTER} />
      <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={ThinStoneBoxColor.INNER} />
    </>
  );
}

export function ThinStoneBoxEntrypoint(): Component {
  return <ThinStoneBox />;
}
